"trash.endlos_scroll_tv.tip.3" = "Entscheide im Voraus, was du schauen willst, statt ziellos herumzuzappen.";
"trash.endlos_scroll_tv.tip.4" = "Setze dir abends eine feste Uhrzeit, zu der alle Bildschirme ausgeschaltet werden.";
"trash.luxus_auto.tip.1" = "Entfolge Luxus-Influencern und Autokanälen auf Social Media.";
"trash.luxus_auto.tip.2" = "Erinnere dich: Die meisten Luxusgüter verlieren schnell an Wert und bringen keine langfristige Zufriedenheit.";
"trash.luxus_auto.tip.3" = "Erstelle ein 30-Tage-Warte-Regel für große Ausgaben – wenn du es nach 30 Tagen noch willst, überdenke es erneut.";
"trash.luxus_auto.tip.4" = "Berechne, wie viele Stunden Arbeit nötig sind, um einen Luxuskauf zu finanzieren.";
"trash.party_pass.tip.1" = "Lösche Party-Gruppen und Event-Apps, die dich ständig zu Feiern einladen.";
"trash.party_pass.tip.2" = "Denke daran, wie du dich am nächsten Morgen fühlst: müde, verkatert und unproduktiv.";
"trash.party_pass.tip.3" = "Plane am Abend bewusst Alternativen: Spieleabend, Kino, Sport mit Freunden.";
"trash.party_pass.tip.4" = "Zähle die verlorenen produktiven Stunden am nächsten Tag nach jeder Party.";
"trash.energy_drink_kiste.tip.1" = "Kaufe keine Energy Drinks auf Vorrat – wenn sie nicht zuhause sind, trinkst du sie nicht.";
"trash.energy_drink_kiste.tip.2" = "Lies die Zutatenliste: Übermäßig viel Zucker und Koffein belasten Herz und Schlaf.";
"trash.energy_drink_kiste.tip.3" = "Ersetze Energy Drinks durch grünen Tee oder Wasser mit Zitrone als Energiequelle.";
"trash.energy_drink_kiste.tip.4" = "Tracke deine Schlafqualität – du wirst sehen, wie sehr Energy Drinks deinen Schlaf zerstören.";
"trash.zigaretten_automat.tip.1" = "Meide Orte, an denen du normalerweise rauchst, und entferne alle Aschenbecher und Feuerzeuge.";
"trash.zigaretten_automat.tip.2" = "Sieh dir Bilder von Raucherorganen an – das ist das, was du deinem Körper antust.";
"trash.zigaretten_automat.tip.3" = "Ersetze den Griff zur Zigarette durch einen Spaziergang, Kaugummi oder tiefes Atmen.";
"trash.zigaretten_automat.tip.4" = "Berechne die jährlichen Kosten deines Rauchens und stell dir vor, was du damit kaufen könntest.";
"trash.online_shopping_app.tip.1" = "Lösche Shopping-Apps und deaktiviere Werbe-E-Mails und Newsletter von Online-Shops.";
"trash.online_shopping_app.tip.2" = "Frage dich bei jedem Kauf: Brauche ich das wirklich oder will ich nur den Dopamin-Kick?";
"trash.online_shopping_app.tip.3" = "Entferne gespeicherte Kreditkarten aus Online-Shops, damit jeder Kauf bewusst sein muss.";
"trash.online_shopping_app.tip.4" = "Lass ungeöffnete Pakete 48 Stunden liegen – wenn du sie dann noch willst, behalte sie.";
"trash.junk_mail_abo.tip.1" = "Setze dir feste App-Limits für TikTok, YouTube Shorts und Handyspiele.";
"trash.junk_mail_abo.tip.2" = "Deinstalliere extrem süchtig machende Spiele oder verstecke sie in einem Ordner.";
"trash.junk_mail_abo.tip.3" = "Lade dein Handy in einem anderen Raum, um endloses Zocken im Bett zu vermeiden.";
"trash.junk_mail_abo.tip.4" = "Ersetze Bildschirmzeit durch physische Hobbys oder das Lesen eines Buches.";
"trash.nacht_snack_box.tip.1" = "Räume alle Snacks aus dem Schlafzimmer und der Küche weg, damit sie nicht sichtbar sind.";
"trash.nacht_snack_box.tip.2" = "Nächtliches Essen stört deinen Schlaf und führt zu Gewichtszunahme – dein Körper braucht nachts Ruhe.";
"trash.nacht_snack_box.tip.3" = "Putze nach dem Abendessen die Zähne – das signalisiert deinem Gehirn: Essen ist vorbei.";
"trash.nacht_snack_box.tip.4" = "Führe ein Snack-Tagebuch: Schreib auf, was du wann isst, und erkenne die Muster.";
"trash.alkohol_flatrate.tip.1" = "Halte keinen Alkohol zuhause und meide Bars, in denen du normalerweise trinkst.";
"trash.alkohol_flatrate.tip.2" = "Schau dir an, was Alkohol mit Leber, Gehirn und Haut macht – auch in kleinen Mengen.";
"trash.alkohol_flatrate.tip.3" = "Bestelle immer zuerst ein alkoholfreies Getränk, wenn du ausgehst.";
"trash.alkohol_flatrate.tip.4" = "Zähle die Kalorien: Ein Bier hat ~250 kcal – rechne hoch, wie viel das pro Woche ist.";
"trash.doomscrolling_handy.tip.1" = "Stelle dein Handy auf Graustufen, um Social-Media-Feeds weniger reizvoll zu machen.";
"trash.doomscrolling_handy.tip.2" = "Lösche Social-Media-Apps vom Handy und nutze sie nur noch am PC.";
"trash.doomscrolling_handy.tip.3" = "Nutze Apps, die dich 10 Sekunden warten lassen, bevor du Instagram öffnest.";
"trash.doomscrolling_handy.tip.4" = "Entfolge negativen Nachrichten und schalte Konten stumm, die Doomscrolling auslösen.";
"trash.binge_streaming.tip.1" = "Deaktiviere die Autoplay-Funktion bei allen Streaming-Diensten.";
"trash.binge_streaming.tip.2" = "Binge-Watching stiehlt dir Stunden, die du nie zurückbekommst – jede Episode kostet dich Lebenszeit.";
"trash.binge_streaming.tip.3" = "Setze dir ein Limit: maximal 1-2 Episoden pro Tag, dann Gerät ausschalten.";
"trash.binge_streaming.tip.4" = "Beobachte, wie leer du dich nach einer 4-Stunden-Session fühlst – das ist kein Genuss, das ist Betäubung.";
"trash.fastfood_lieferdienst.tip.1" = "Lösche alle Lieferdienst-Apps (Lieferando, UberEats etc.) und gespeicherte Zahlungsmethoden.";
"trash.fastfood_lieferdienst.tip.2" = "Die Fotos in den Apps sind Fake – das echte Essen sieht nie so aus und ist ungesund.";
"trash.fastfood_lieferdienst.tip.3" = "Bestelle Zutaten statt fertiges Essen – in 20 Minuten kochst du gesünder und günstiger.";
"trash.fastfood_lieferdienst.tip.4" = "Addiere alle Liefergebühren eines Monats – das Geld hättest du sinnvoller nutzen können.";
"trash.lootbox_zockerabo.tip.1" = "Deinstalliere Spiele mit Lootboxen und Mikrotransaktionen von allen deinen Geräten.";
"trash.lootbox_zockerabo.tip.2" = "Lootboxen sind so designt wie Spielautomaten – sie nutzen deine Psychologie gegen dich aus.";
"trash.lootbox_zockerabo.tip.3" = "Richte eine Ausgabenlimite bei deinem App Store ein und entferne hinterlegte Kreditkarten.";
"trash.lootbox_zockerabo.tip.4" = "Rechne nach: Wie viel echtes Geld hast du schon für virtuelle Items ausgegeben, die du nicht besitzt?";
"trash.luxus_uhr.tip.1" = "Entfolge Luxus-Uhren-Kanälen und -Foren auf Social Media.";
"trash.luxus_uhr.tip.2" = "Eine Uhr für tausende Euro zeigt die gleiche Zeit wie eine für 30 € – es ist reines Status-Denken.";
"trash.luxus_uhr.tip.3" = "Erstelle eine Liste, was du dir mit dem Geld Sinnvolles kaufen könntest.";
"trash.luxus_uhr.tip.4" = "Erinnere dich: Niemanden beeindruckt deine Uhr so sehr, wie du denkst.";
"trash.couch_abo.tip.1" = "Stelle die Fernbedienung weit weg und lege stattdessen Sportschuhe neben die Couch.";
"trash.couch_abo.tip.2" = "Zu viel Sitzen erhöht das Risiko für Herzerkrankungen, Diabetes und Depressionen.";
"trash.couch_abo.tip.3" = "Setze einen Timer, der dich alle 30 Minuten daran erinnert, aufzustehen und dich zu bewegen.";
"trash.couch_abo.tip.4" = "Tracke deine tägliche Bewegung – du wirst schockiert sein, wie wenig es an Couch-Tagen ist.";
"trash.doener_dauerkarte.tip.1" = "Vermeide den Weg an deinem Lieblings-Döner-Laden vorbei – wähle eine andere Route.";
"trash.doener_dauerkarte.tip.2" = "Ein Döner hat oft 700+ Kalorien und viel Fett – denke daran, bevor du bestellst.";
"trash.doener_dauerkarte.tip.3" = "Bereite ein schnelles gesundes Wrap vor (dauert nur 5 Min), bevor der Hunger zuschlägt.";
"trash.doener_dauerkarte.tip.4" = "Fotografiere jedes Mal, wenn du Döner isst, und schau dir die Galerie am Monatsende an.";
"trash.negativitaets_feed.tip.1" = "Schalte alle Nachrichten-Benachrichtigungen aus und folge nur konstruktiven Medien.";
"trash.negativitaets_feed.tip.2" = "Jede negative Nachricht aktiviert deine Amygdala – du trainierst dein Gehirn auf Angst.";
"trash.negativitaets_feed.tip.3" = "Beschränke News-Konsum auf max. 10 Minuten pro Tag zu einer festen Uhrzeit.";
"trash.negativitaets_feed.tip.4" = "Frage dich nach jedem Nachrichtenkonsum: Kann ich etwas daran ändern? Wenn nein, lass es los.";
"trash.schlaf_killer_koffein.tip.1" = "Trinke nach 14 Uhr keinen Kaffee mehr – Koffein wirkt bis zu 8 Stunden in deinem Körper.";
"trash.schlaf_killer_koffein.tip.2" = "Koffein blockiert Adenosin (dein Müdigkeitssignal) – du schläfst weniger tief und erholst dich schlechter.";
"trash.schlaf_killer_koffein.tip.3" = "Ersetze Nachmittagskaffee durch entkoffeinierten Kaffee oder Kräutertee.";
"trash.schlaf_killer_koffein.tip.4" = "Tracke deine Schlafqualität mit und ohne Koffein – der Unterschied wird dich überzeugen.";

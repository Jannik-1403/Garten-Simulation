            "value": "Blooms in mud \u2013 peace despite stress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce5\u306e\u4e2d\u3067\u54b2\u304f \u2013 \u30b9\u30c8\u30ec\u30b9\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u5e73\u548c"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ud759 \uc18d\uc5d0\uc11c \ud53c\uc5b4\ub098\ub294 \uaf43 \u2013 \uc2a4\ud2b8\ub808\uc2a4\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ud3c9\ud654"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeit in de modder \u2013 vrede ondanks stress"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnie w b\u0142ocie \u2013 spok\u00f3j pomimo stresu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce na lama \u2013 paz apesar do stress"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0432\u0435\u0442\u0451\u0442 \u0432 \u0433\u0440\u044f\u0437\u0438 \u2013 \u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0441\u0442\u0440\u0435\u0441\u0441"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7amurda \u00e7i\u00e7ek a\u00e7ar \u2013 strese ra\u011fmen huzur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6ce5\u6cde\u4e2d\u7efd\u653e \u2013 \u538b\u529b\u4e0b\u7684\u5e73\u9759"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce5\u6fd8\u4e2d\u7dbb\u653e\uff0d\u5118\u7ba1\u6709\u58d3\u529b\u4ecd\u4fdd\u6301\u5e73\u975c"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0430\u043a\u0435\u0442 \u0441 \u0432\u0430\u0436\u043d\u044b\u043c\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438."

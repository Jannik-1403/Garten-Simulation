            "value": "\u0938\u092c \u0938\u093e\u092e\u093e\u0928\u094d\u092f\u0964 \u090f\u0915 \u092c\u093e\u0930 \u092a\u093e\u0928\u0940 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All normal. Water once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u6b63\u5e38\u3067\u3059\u3002\u4e00\u5ea6\u6c34\u3084\u308a\u3092\u3057\u307e\u3059\u3002"

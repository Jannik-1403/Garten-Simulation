    "settings.share.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringen Sie andere Leute auch dazu, ihr Bestes aus ihrem Leben zu holen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encourage other people to get the best out of their lives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima a otras personas a sacar lo mejor de sus vidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encouragez d'autres personnes \u00e0 tirer le meilleur parti de leur vie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092d\u0940 \u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0928 \u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u091a\u0940\u091c\u093c \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0947\u0930\u093f\u0924 \u0915\u0930\u0947\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoraggia altre persone a ottenere il meglio dalla loro vita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u306e\u4eba\u304c\u4eba\u751f\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u5968\u52b1\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc774 \uc790\uc2e0\uc758 \uc0b6\uc5d0\uc11c \ucd5c\uc120\uc744 \ub2e4\ud558\ub3c4\ub85d \uaca9\ub824\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moedig andere mensen aan om het beste uit hun leven te halen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zach\u0119caj innych ludzi, aby czerpali z \u017cycia to, co najlepsze"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incentive outras pessoas a tirarem o melhor das suas vidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u043b\u044e\u0434\u0435\u0439 \u0442\u043e\u0436\u0435 \u0432\u044b\u0436\u0438\u043c\u0430\u0442\u044c \u0438\u0437 \u0441\u0432\u043e\u0435\u0439 \u0436\u0438\u0437\u043d\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Di\u011fer insanlar\u0131 hayatlar\u0131ndan en iyi \u015fekilde yararlanmaya te\u015fvik edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9f13\u52b1\u5176\u4ed6\u4eba\u4e5f\u5145\u5206\u5229\u7528\u81ea\u5df1\u7684\u751f\u6d3b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9f13\u52f5\u5176\u4ed6\u4eba\u4e5f\u5145\u5206\u5229\u7528\u81ea\u5df1\u7684\u751f\u6d3b"
          }
        }
      }
    },

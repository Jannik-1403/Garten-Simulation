    "assessment.finance.q13" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast 2.000€ Kreditkartenschulden (12％ Zinsen) und gleichzeitig 2.000€ auf dem Sparbuch (2％ Zinsen). Was tust du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have €2,000 in credit card debt (12％ interest) and at the same time €2,000 in your savings account (2％ interest). What are you doing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes 2.000€ de deuda en tu tarjeta de crédito (12％ de interés) y al mismo tiempo 2.000€ en tu cuenta de ahorros (2％ de interés). ¿Qué estás haciendo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez 2 000 € de dettes de carte de crédit (intérêt 12 ％) et en même temps 2 000 € sur votre compte épargne (intérêt 2 ％). Que fais-tu?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके क्रेडिट कार्ड ऋण में €2,000 (12％ ब्याज) है और साथ ही आपके बचत खाते में €2,000 (2％ ब्याज) है। आप क्या कर रहे हो?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai 2.000 € di debito sulla tua carta di credito (12％ di interesse) e allo stesso tempo 2.000 € sul tuo conto di risparmio (2％ di interesse). Cosa fai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたはクレジット カードの借金 (利息 12％) が 2,000 ユーロあり、同時に普通預金口座にも 2,000 ユーロ (利息 2％) があります。何してるの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신용카드 빚이 €2,000(이자 12％)이고 동시에 저축 계좌에 €2,000(이자 2％)가 있습니다. 뭐하세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U heeft € 2.000,- aan creditcardschuld (12％ rente) en tegelijkertijd € 2.000,- op uw spaarrekening (2％ rente). Wat ben je aan het doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz 2000 euro zadłużenia na karcie kredytowej (12％ odsetek) i jednocześnie 2000 euro na koncie oszczędnościowym (2％ odsetek). Co robisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem 2.000€ em dívidas de cartão de crédito (juros de 12％) e ao mesmo tempo 2.000€ na sua conta poupança (juros de 2％). O que você está fazendo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя 2.000€ долгов по кредитной карте (12％ годовых) и одновременно 2.000€ на сберегательном счете (2％ годовых). Что ты будешь делать?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredi kartı borcunuzda 2.000 € (%12 faiz) ve aynı zamanda tasarruf hesabınızda 2.000 € (%2 faiz) var. Ne yapıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

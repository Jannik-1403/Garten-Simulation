    "assessment.mental.profile.spiegel.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremdgesteuert und gefallenwollend. Dein Ego ist von der Bestätigung anderer abhängig. Ohne Applaus verlierst du sofort die Motivation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlled by others and wanting to please. Your ego depends on the validation of others. Without applause you immediately lose motivation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlado por los demás y con ganas de agradar. Tu ego depende de la validación de los demás. Sin aplausos, inmediatamente pierdes la motivación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlé par les autres et voulant plaire. Votre ego dépend de la validation des autres. Sans applaudissements, vous perdez immédiatement votre motivation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllato dagli altri e desideroso di compiacere. Il tuo ego dipende dalla convalida degli altri. Senza applausi perdi subito la motivazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人に支配され、喜ばせたいと願う。あなたのエゴは他人の承認に依存しています。拍手がないと一気にモチベーションが下がってしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람들에 의해 통제되고 기쁘게 되기를 원합니다. 당신의 자존심은 다른 사람들의 검증에 달려 있습니다. 박수를 보내지 않으면 즉시 의욕을 잃게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerd door anderen en willen behagen. Je ego is afhankelijk van de validatie van anderen. Zonder applaus verlies je meteen de motivatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolowany przez innych i chcący sprawiać przyjemność. Twoje ego zależy od uznania innych. Bez oklasków od razu tracisz motywację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlado por outros e querendo agradar. Seu ego depende da validação dos outros. Sem aplausos você perde imediatamente a motivação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başkaları tarafından kontrol ediliyor ve memnun etmek istiyor. Egonuz başkalarının onayına bağlıdır. Alkışlamadığınız anda motivasyonunuzu kaybedersiniz."
          }
        }
      }
    },

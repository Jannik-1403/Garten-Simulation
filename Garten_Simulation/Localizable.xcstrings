          "stringUnit": {
            "state": "translated",
            "value": "\u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0948, \u0926\u0936\u0915\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0936\u093e\u0932 \u0914\u0930 \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u093e\u0928 \u092c\u0928\u0924\u093e \u0939\u0948"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows slowly, becomes massive and wise over decades"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3086\u3063\u304f\u308a\u3068\u6210\u9577\u3057\u3001\u6570\u5341\u5e74\u304b\u3051\u3066\u5de8\u5927\u304b\u3064\u8ce2\u304f\u306a\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc218\uc2ed \ub144\uc5d0 \uac78\uccd0 \ucc9c\ucc9c\ud788 \uc131\uc7a5\ud558\uace0 \uac70\ub300\ud574\uc9c0\uace0 \ud604\uba85\ud574\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit langzaam, wordt in de loop van tientallen jaren enorm en wijs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015bnie powoli, przez dziesi\u0119ciolecia staje si\u0119 masywny i m\u0105dry"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce devagar, torna-se massivo e s\u00e1bio ao longo de d\u00e9cadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u0442 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u043c \u0438 \u043c\u0443\u0434\u0440\u044b\u043c \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0439"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yava\u015f yava\u015f b\u00fcy\u00fcr, onlarca y\u0131l i\u00e7inde devasa ve bilge hale gelir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f13\u6162\u751f\u957f\uff0c\u6570\u5341\u5e74\u540e\u53d8\u5f97\u7c97\u58ee\u800c\u667a\u6167"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e7e\u5341\u5e74\u5f8c\u6162\u6162\u6210\u9577\uff0c\u8b8a\u5f97\u9f90\u5927\u53c8\u8070\u660e"
          }
        }
      }
    },
    "plant.erdbeerpflanze.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Fr\u00fcchte, gro\u00dfe Belohnung \u2013 Obst & Gem\u00fcse essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small fruits, big reward \u2013 eating fruit & veg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutos peque\u00f1os, gran recompensa \u2013 comer frutas y verduras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits fruits, grande r\u00e9compense \u2013 manger des fruits et l\u00e9gumes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u094b\u091f\u0947 \u092b\u0932, \u092c\u0921\u093c\u093e \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930 \u2013 \u092b\u0932 \u0914\u0930 \u0938\u092c\u094d\u091c\u093f\u092f\u093e\u0901 \u0916\u093e\u090f\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Small fruits, big reward \u2013 eating fruit & veg"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u3055\u306a\u679c\u7269\u3001\u5927\u304d\u306a\u5831\u916c - \u679c\u7269\u3068\u91ce\u83dc\u3092\u98df\u3079\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc791\uc740 \uacfc\uc77c, \ud070 \ubcf4\uc0c1 \u2013 \uacfc\uc77c\uacfc \ucc44\uc18c \uba39\uae30"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein fruit, grote beloning \u2013 het eten van fruit en groenten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u0142e owoce, du\u017ca nagroda \u2013 jedzenie owoc\u00f3w i warzyw"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutos pequenos, grande recompensa \u2013 comer frutas e legumes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0444\u0440\u0443\u043a\u0442\u044b, \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u2013 \u0435\u0441\u0442\u044c \u0444\u0440\u0443\u043a\u0442\u044b \u0438 \u043e\u0432\u043e\u0449\u0438"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00fc\u00e7\u00fck meyveler, b\u00fcy\u00fck \u00f6d\u00fcl \u2013 meyve ve sebze yemek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u679c\u5b9e\uff0c\u5927\u56de\u62a5\u2014\u2014\u591a\u5403\u6c34\u679c\u852c\u83dc"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u6c34\u679c\uff0c\u5927\u56de\u5831\uff0d\u591a\u5403\u6c34\u679c\u548c\u852c\u83dc"
          }
        }
      }
    },

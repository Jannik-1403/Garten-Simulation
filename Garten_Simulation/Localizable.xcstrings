    "trash.lootbox_zockerabo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere In-App-K\u00e4ufe in den Einstellungen deines Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable in-app purchases in your phone's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las compras dentro de la aplicaci\u00f3n en los ajustes de tu tel\u00e9fono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9sactive les achats int\u00e9gr\u00e9s dans les param\u00e8tres de ton t\u00e9l\u00e9phone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0907\u0928-\u0910\u092a \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabilita gli acquisti in-app nelle impostazioni del tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u643a\u5e2f\u306e\u30a2\u30d7\u30ea\u5185\u8cfc\u5165\u3092\u8a2d\u5b9a\u3067\u30aa\u30d5\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud734\ub300\ud3f0 \uc124\uc815\uc5d0\uc11c \uc778\uc571 \uad6c\ub9e4\ub97c \ube44\ud65c\uc131\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel in-app-aankopen uit in de instellingen van je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142\u0105cz zakupy w aplikacji w ustawieniach telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative as compras no aplicativo nas configura\u00e7\u00f5es do seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ayarlar\u0131ndan uygulama i\u00e7i sat\u0131n al\u0131mlar\u0131 devre d\u0131\u015f\u0131 b\u0131rak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u624b\u673a\u8bbe\u7f6e\u4e2d\u7981\u7528\u5e94\u7528\u5185\u8d2d\u4e70\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u624b\u6a5f\u8a2d\u5b9a\u4e2d\u505c\u7528\u61c9\u7528\u7a0b\u5f0f\u5167\u8cfc\u8cb7\u3002"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lootboxen sind psychologisch Gl\u00fccksspiel \u2013 und du verlierst langfristig immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot boxes are psychologically gambling \u2013 and you always lose in the long run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cajas de bot\u00edn son psicol\u00f3gicamente juego de azar: y siempre pierdes a largo plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les loot boxes sont psychologiquement des jeux de hasard \u2013 et tu perds toujours \u00e0 long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0942\u091f\u092c\u0949\u0915\u094d\u0938 \u092e\u0928\u094b\u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u091c\u0941\u0906 \u0939\u0948\u0902 \u2013 \u0914\u0930 \u0906\u092a \u0932\u0902\u092c\u0940 \u0905\u0935\u0927\u093f \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0939\u093e\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le loot box sono psicologicamente gioco d'azzardo \u2013 e a lungo termine perdi sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30eb\u30fc\u30c8\u30dc\u30c3\u30af\u30b9\u306f\u5fc3\u7406\u7684\u306b\u30ae\u30e3\u30f3\u30d6\u30eb\u3067\u3059\u3002\u9577\u671f\u7684\u306b\u306f\u5e38\u306b\u8ca0\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub8e8\ud2b8\ubc15\uc2a4\ub294 \uc2ec\ub9ac\uc801\uc73c\ub85c \ub3c4\ubc15\uc785\ub2c8\ub2e4 \u2013 \uc7a5\uae30\uc801\uc73c\ub85c\ub294 \ud56d\uc0c1 \uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lootboxen zijn psychologisch gezien gokken \u2013 en op de lange termijn verlies je altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lootboxy s\u0105 psychologicznie hazardem \u2013 i d\u0142ugoterminowo zawsze przegrywasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot boxes s\u00e3o psicologicamente um jogo de azar \u2013 e voc\u00ea sempre perde a longo prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u0443\u0442\u0431\u043e\u043a\u0441\u044b \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0430\u0437\u0430\u0440\u0442\u043d\u044b, \u0438 \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0432\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u0435\u0442\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot box'lar psikolojik olarak kumard\u0131r \u2013 ve uzun vadede her zaman kaybedersiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6218\u5229\u54c1\u7bb1\u5728\u5fc3\u7406\u4e0a\u662f\u8d4c\u535a\u2014\u2014\u4ece\u957f\u8fdc\u6765\u770b\u4f60\u603b\u662f\u4f1a\u8f93\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6230\u5229\u54c1\u7bb1\u5728\u5fc3\u7406\u4e0a\u662f\u8ced\u535a\u2014\u2014\u5f9e\u9577\u9060\u4f86\u770b\u4f60\u7e3d\u662f\u6703\u8f38\u3002"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze dir ein monatliches Gaming-Budget \u2013 und halte es schriftlich fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set yourself a monthly gaming budget \u2013 and put it in writing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece un presupuesto mensual para juegos y ponlo por escrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe-toi un budget mensuel de jeu \u2013 et mets-le par \u00e9crit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u090f\u0915 \u092e\u093e\u0938\u093f\u0915 \u0917\u0947\u092e\u093f\u0902\u0917 \u092c\u091c\u091f \u0924\u092f \u0915\u0930\u0947\u0902 \u2013 \u0914\u0930 \u0907\u0938\u0947 \u0932\u093f\u0916\u093f\u0924 \u0930\u0942\u092a \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisci un budget mensile per il gaming \u2013 e mettilo per iscritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6708\u3005\u306e\u30b2\u30fc\u30e0\u306e\u4e88\u7b97\u3092\u6c7a\u3081\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u3092\u66f8\u9762\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6d4\ubcc4 \uac8c\uc784 \uc608\uc0b0\uc744 \uc124\uc815\ud558\uc138\uc694 \u2013 \uadf8\ub9ac\uace0 \uc11c\uba74\uc73c\ub85c \uae30\ub85d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een maandelijks gamingbudget in \u2013 en leg dit schriftelijk vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustal miesi\u0119czny bud\u017cet na gaming \u2013 i zapisz go na pi\u015bmie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um or\u00e7amento mensal para jogos \u2013 e coloque por escrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439 \u0438\u0433\u0440\u043e\u0432\u043e\u0439 \u0431\u044e\u0434\u0436\u0435\u0442 \u0438 \u0437\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0435\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayl\u0131k oyun b\u00fct\u00e7esi belirle \u2013 ve bunu yaz\u0131l\u0131 olarak kaydet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u5b9a\u6bcf\u6708\u6e38\u620f\u9884\u7b97 - \u5e76\u5c06\u5176\u5199\u4e0b\u6765\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a\u6bcf\u6708\u904a\u6232\u9810\u7b97 - \u4e26\u5c07\u5176\u5beb\u4e0b\u4f86\u3002"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne aus: Was hast du dieses Jahr f\u00fcr In-App-K\u00e4ufe ausgegeben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate: how much have you spent on in-app purchases this year?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula: \u00bfcu\u00e1nto has gastado en compras dentro de la aplicaci\u00f3n este a\u00f1o?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule : combien as-tu d\u00e9pens\u00e9 en achats int\u00e9gr\u00e9s cette ann\u00e9e ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0923\u0928\u093e \u0915\u0930\u094b: \u0907\u0938 \u0938\u093e\u0932 \u0906\u092a\u0928\u0947 \u0907\u0928-\u090f\u092a \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u092a\u0930 \u0915\u093f\u0924\u0928\u093e \u0916\u0930\u094d\u091a \u0915\u093f\u092f\u093e?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola: quanto hai speso in acquisti in-app quest'anno?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a08\u7b97\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u4eca\u5e74\u306e\u30a2\u30d7\u30ea\u5185\u8cfc\u5165\u306b\u3044\u304f\u3089\u4f7f\u3044\u307e\u3057\u305f\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacc4\uc0b0\ud574 \ubcf4\uc138\uc694: \uc62c\ud574 \uc778\uc571 \uad6c\ub9e4\uc5d0 \uc5bc\ub9c8\ub97c \uc37c\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken: hoeveel heb je dit jaar uitgegeven aan in-app-aankopen?"

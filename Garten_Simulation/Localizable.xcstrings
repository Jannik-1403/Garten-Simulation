    "body.tracking.status.cutting.muscleloss.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewichtsverlust zu aggressiv. Du verbrennst wertvolle Muskeln. Kalorien um 200 kcal erhöhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight loss is too aggressive. You are burning valuable muscle. Increase calories by 200 kcal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de peso es demasiado agresiva. Estás quemando músculo valioso. Aumenta las calorías en 200 kcal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perte de poids trop agressive. Vous brûlez des muscles précieux. Augmentez les calories de 200 kcal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़न घटाना बहुत आक्रामक है। आप बहुमूल्य मांसपेशियों को जला देते हैं। कैलोरी 200 किलो कैलोरी बढ़ाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdita di peso troppo aggressiva. Bruci muscoli preziosi. Aumenta le calorie di 200 kcal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "減量が積極的すぎる。貴重な筋肉を燃やしてしまいます。カロリーが200kcal増加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 감량이 너무 공격적입니다. 당신은 귀중한 근육을 태운다. 칼로리를 200kcal 늘립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewichtsverlies te agressief. Je verbrandt waardevolle spieren. Verhoog het aantal calorieën met 200 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrata wagi jest zbyt agresywna. Spalasz cenne mięśnie. Zwiększ kalorie o 200 kcal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perda de peso muito agressiva. Você está perdendo músculos. Aumente as calorias em 200 kcal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perda de peso muito agressiva. Você queima músculos valiosos. Aumente as calorias em 200 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похудение слишком агрессивное. Вы сжигаете ценные мышцы. Увеличьте калорийность на 200 ккал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo kaybı çok agresif. Değerli kasları yakarsınız. Kalorileri 200 kcal artırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减肥太激进了。你会燃烧宝贵的肌肉。增加卡路里200大卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減肥太激進了。你會燃燒寶貴的肌肉。增加卡路里200大卡。"
          }
        }
      }
    },

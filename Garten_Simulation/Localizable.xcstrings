    "onboarding_tutorial_4_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Gewohnheiten geben dir kurzfristige Boni, aber nutze sie weise!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad Habits give you short-term bonuses, but use them wisely!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las decoraciones te dan bonos a corto plazo, \u00a1pero \u00fasalas con sabidur\u00eda!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les d\u00e9corations te donnent des bonus \u00e0 court terme, mais utilise-les avec sagesse !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0941\u0930\u0940 \u0906\u0926\u0924\u0947\u0902 \u0906\u092a\u0915\u094b \u0905\u0932\u094d\u092a\u0915\u093e\u0932\u093f\u0915 \u092c\u094b\u0928\u0938 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0909\u0928\u0915\u093e \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u093e\u0928\u0940 \u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le decorazioni ti danno bonus a breve termine, ma usale con saggezza!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u88c5\u98fe\u306f\u77ed\u671f\u7684\u306a\u30dc\u30fc\u30ca\u30b9\u3092\u4e0e\u3048\u307e\u3059\u304c\u3001\u8ce2\u304f\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a5\uc2dd\uc740 \ub2e8\uae30\uc801\uc778 \ubcf4\ub108\uc2a4\ub97c \uc8fc\uc9c0\ub9cc \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoraties geven je kortetermijnbonussen, maar gebruik ze verstandig!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekoracje daj\u0105 kr\u00f3tkotrwa\u0142e premie, ale u\u017cywaj ich m\u0105drze!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As decora\u00e7\u00f5es d\u00e3o-te b\u00f3nus a curto prazo, mas usa-as com sabedoria!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043b\u043e\u0445\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0434\u0430\u044e\u0442 \u0442\u0435\u0431\u0435 \u043a\u0440\u0430\u0442\u043a\u043e\u0441\u0440\u043e\u0447\u043d\u044b\u0435 \u0431\u043e\u043d\u0443\u0441\u044b, \u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0438\u0445 \u0441 \u0443\u043c\u043e\u043c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekorasyonlar size k\u0131sa vadeli bonuslar verir, ancak bunlar\u0131 ak\u0131ll\u0131ca kullan\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u574f\u4e60\u60ef\u4f1a\u7ed9\u4f60\u77ed\u671f\u5956\u52b1\uff0c\u4f46\u8bf7\u660e\u667a\u4f7f\u7528\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58de\u7fd2\u6163\u6703\u70ba\u4f60\u5e36\u4f86\u77ed\u671f\u7684\u597d\u8655\uff0c\u4f46\u8981\u660e\u667a\u5730\u4f7f\u7528\u5b83\u5011\uff01"
          }
        }
      }
    },

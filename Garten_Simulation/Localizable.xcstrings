        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把家里所有的能量饮料拿走——如果没有，就不要喝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把家裡所有的能量飲料拿走——如果沒有，就不要喝。"
          }
        }
      }
    },

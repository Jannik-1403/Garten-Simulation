    "verlauf.custom_plant.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcr selbst erstellte Gewohnheiten gibt es keinen Pfad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no path for custom habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay camino para h\u00e1bitos personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de chemin pour les habitudes personnalis\u00e9es."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u092f\u0902 \u092c\u0928\u093e\u0908 \u0917\u0908 \u0906\u0926\u0924\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0930\u093e\u0938\u094d\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'\u00e8 alcun percorso per le abitudini personalizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ab\u30b9\u30bf\u30e0\u7fd2\u6163\u306b\u306f\u9053\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2b5\uad00\uc801\uc778 \uc2b5\uad00\uc5d0\ub294 \uae38\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen pad voor aangepaste gewoonten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma \u015bcie\u017cki do niestandardowych nawyk\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o h\u00e1 caminho para h\u00e1bitos personalizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0443\u0442\u0438 \u0434\u043b\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0445 \u0432\u0430\u043c\u0438 \u0441\u0430\u043c\u0438\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6zel al\u0131\u015fkanl\u0131klara giden bir yol yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u529e\u6cd5\u57f9\u517b\u81ea\u5df1\u517b\u6210\u7684\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u8fa6\u6cd5\u57f9\u990a\u81ea\u5df1\u990a\u6210\u7684\u7fd2\u6163\u3002"
          }
        }
      }
    },
    "verlauf.empty.subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gie\u00dfe deine Pflanze, um die Historie zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plant to see the history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tu planta para ver el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrosez votre plante pour voir l'historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0924\u093f\u0939\u093e\u0938 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092a\u094c\u0927\u0947 \u0915\u094b \u092a\u093e\u0928\u0940 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffia la tua pianta per vedere la cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u306b\u6c34\u3092\u3042\u3052\u3066\u6b74\u53f2\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ed\uc0ac\ub97c \ubcf4\ub824\uba74 \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je plant water om de geschiedenis te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewaj ro\u015blin\u0119, aby zobaczy\u0107 histori\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue sua planta para ver o hist\u00f3rico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u0435\u0439\u0442\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438\u0441\u0442\u043e\u0440\u0438\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihi g\u00f6rmek i\u00e7in bitkinizi sulay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ed9\u4f60\u7684\u690d\u7269\u6d47\u6c34\u4ee5\u4e86\u89e3\u5386\u53f2\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d66\u4f60\u7684\u690d\u7269\u6f86\u6c34\u4ee5\u4e86\u89e3\u6b77\u53f2\u3002"
          }
        }
      }
    },

            "value": "%@ sente la tua mancanza!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306b\u4f1a\u3044\u305f\u3044\u3067\u3059!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\ub2d8\uc774 \uadf8\ub9ac\uc6cc\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mist je!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ t\u0119skni za tob\u0105!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem saudades tuas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u0441\u043a\u0443\u0447\u0430\u0435\u0442 \u043f\u043e \u0442\u0435\u0431\u0435!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seni \u00f6zl\u00fcyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u60f3\u4f60\u4e86\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u60f3\u5ff5\u4f60\uff01"
          }
        }
      }
    },
    "notification.wait.2.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit rennt! Erledige deine Gewohnheit (%d Stunden vergangen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time is flying! Complete your habit (%d hours passed)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1El tiempo vuela! Completa tu h\u00e1bito (han pasado %d horas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps file ! Compl\u00e8te ton habitude (%d heures \u00e9coul\u00e9es)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092e\u092f \u092d\u093e\u0917\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948! \u0905\u092a\u0928\u0940 \u0906\u0926\u0924 \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902 (%d\u0918\u0902\u091f\u0947 \u092c\u0940\u0924 \u0917\u090f)\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo vola! Completa la tua abitudine (%d ore passate)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6642\u9593\u306f\u3042\u3063\u3068\u3044\u3046\u9593\u306b\u904e\u304e\u307e\u3059\uff01\u7fd2\u6163\u3092\u5b8c\u4e86\u3057\u3066\u304f\u3060\u3055\u3044 (%d \u6642\u9593\u304c\u7d4c\u904e\u3057\u307e\u3057\u305f)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uac04\uc774 \ud750\ub974\uace0 \uc788\uc2b5\ub2c8\ub2e4! \uc2b5\uad00\uc744 \uc644\ub8cc\ud558\uc138\uc694(%d\uc2dc\uac04 \uacbd\uacfc)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijd vliegt! Voltooi je gewoonte (%d uur verstreken)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas leci! Uzupe\u0142nij sw\u00f3j nawyk (min\u0119\u0142o %d godzin)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo voa! Completa o teu h\u00e1bito (%d horas passadas)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0440\u0435\u043c\u044f \u043b\u0435\u0442\u0438\u0442! \u0412\u044b\u043f\u043e\u043b\u043d\u0438 \u0441\u0432\u043e\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 (\u043f\u0440\u043e\u0448\u043b\u043e%d\u0447\u0430\u0441\u043e\u0432)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman u\u00e7uyor! Al\u0131\u015fkanl\u0131\u011f\u0131n\u0131z\u0131 tamamlay\u0131n (%d saat ge\u00e7ti)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65f6\u95f4\u4e0d\u591a\u4e86\uff01\u5b8c\u6210\u4f60\u7684\u4e60\u60ef\uff08\u5df2\u8fc7\u53bb %d \u5c0f\u65f6\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6642\u9593\u5728\u6d41\u901d\uff01\u5b8c\u6210\u4f60\u7684\u7fd2\u6163\uff08%d\u5c0f\u6642\u904e\u53bb\u4e86\uff09\u3002"
          }
        }
      }
    },
    "notification.wait.2.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo? Zeit f\u00fcr %@!"
          }
        },
        "en": {

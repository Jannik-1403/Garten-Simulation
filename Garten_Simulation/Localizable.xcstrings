        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0915\u0926\u092e \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"

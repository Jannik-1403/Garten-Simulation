    "fitness.gratitude.detail.good": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse, du hast dir heute schon Zeit für dein Journal genommen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great, you have already taken time for your journal today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Genial, ya te has tomado tiempo para tu diario hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super, tu as déjà pris du temps pour ton journal aujourd'hui !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत बढ़िया, आपने आज पहले ही अपनी जर्नल के लिए समय निकाल लिया है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fantastico, hai già dedicato del tempo al tuo diario oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素晴らしい、今日すでに日記の時間を作りましたね！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘하셨어요, 오늘 이미 일기 쓸 시간을 내셨군요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig, je hebt vandaag al tijd genomen voor je dagboek!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świetnie, że znalazłeś dzisiaj czas na swój dziennik!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo, já tiraste tempo para o teu diário hoje!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo, você já tirou um tempo para o seu diário hoje!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично, сегодня вы уже уделили время своему журналу!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika, bugün günlüğün için zaten zaman ayırdın!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了，你今天已经花时间写日记了！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了，你今天已經花時間寫日記了！"
          }
        }
      }
    },
    "fitness.gratitude.detail.not_done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute noch kein Journal geschrieben. Halte kurz inne und reflektiere deinen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't written a journal today. Pause for a moment and reflect on your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has escrito un diario hoy. Haz una pausa y reflexiona sobre tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as pas encore écrit dans ton journal aujourd'hui. Fais une pause et réfléchis à ta journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने आज अभी तक जर्नल नहीं लिखी है। थोड़ा रुकें और अपने दिन पर विचार करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora scritto un diario oggi. Fai una pausa e rifletti sulla tua giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ日記を書いていませんね。少し立ち止まって一日を振り返ってみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아직 일기를 쓰지 않았네요. 잠시 멈추고 하루를 되돌아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt vandaag nog geen dagboek geschreven. Pauzeer even en reflecteer op je dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze dzisiaj nie pisałeś w dzienniku. Zrób przerwę i pomyśl o swoim dniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não escreveste no diário hoje. Faz uma pausa e reflete sobre o teu dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não escreveu um diário hoje. Faça uma pausa e reflita sobre o seu dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня вы еще не заполняли журнал. Сделайте паузу и поразмышляйте о своем дне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün henüz günlük yazmadın. Biraz durakla ve gününü değerlendir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天还没有写日记。停下来反思一下你的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天還沒有寫日記。停下來反思一下你的一天。"
          }
        }
      }
    },
    "fitness.gratitude.detail.yesterday.high": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern hast du dich exzellent gefühlt, mach heute weiter so!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday you felt excellent, keep it up today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer te sentiste excelente, ¡sigue así hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier tu te sentais très bien, continue comme ça aujourd'hui !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल आपने बहुत अच्छा महसूस किया था, आज भी इसे जारी रखें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieri ti sei sentito eccellente, continua così oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日は素晴らしい気分でしたね、今日もその調子で！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제는 기분이 최고였어요, 오늘도 이대로 쭉 가요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gisteren voelde je je uitstekend, ga zo door vandaag!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj czułeś się wyśmienicie, trzymaj tak dalej dzisiaj!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem sentiste-te excelente, continua assim hoje!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem você se sentiu excelente, continue assim hoje!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера вы чувствовали себя отлично, продолжайте в том же духе сегодня!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün kendini harika hissettin, bugün de aynen devam!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你感觉极好，今天继续保持！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你感覺極好，今天繼續保持！"
          }
        }
      }
    },
    "fitness.gratitude.detail.yesterday.improve": {
      "extractionState": "manual",

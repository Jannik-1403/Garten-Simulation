    "plant.lotus.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deine innere Ruhe und Balance durch tägliche Meditation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your inner peace and balance through daily meditation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu paz interior y equilibrio a través de la meditación diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez votre paix intérieure et votre équilibre grâce à la méditation quotidienne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनिक ध्यान के माध्यम से अपनी आंतरिक शांति और संतुलन खोजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova la tua pace interiore e il tuo equilibrio attraverso la meditazione quotidiana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の瞑想を通じて、内なる平和とバランスを見つけましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일의 명상을 통해 내면의 평화와 균형을 찾으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je innerlijke rust en balans door dagelijkse meditatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź wewnętrzny spokój i równowagę poprzez codzienne medytacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre sua paz interior e equilíbrio através da meditação diária."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre sua paz interior e equilíbrio através da meditação diária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найди свой внутренний покой и баланс через ежедневную медитацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük meditasyonla iç huzurunuzu ve dengenizi bulun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过每日冥想找到内心的平静与平衡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過日常冥想找到內心的平靜與平衡。"
          }
        }
      }
    },

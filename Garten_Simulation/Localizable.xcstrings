    "prog_coldshower_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das kalte Wasser heute bewusst über den Nacken und zwischen die Schulterblätter laufen (aktiviert braunes Fettgewebe)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, consciously let the cold water run over the neck and between the shoulder blades (activates brown fatty tissue)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, conscientemente, deja correr el agua fría por el cuello y entre los omóplatos (activa el tejido adiposo marrón)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, laissez consciemment couler l’eau froide sur le cou et entre les omoplates (active les tissus adipeux bruns)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज, जानबूझकर ठंडे पानी को गर्दन के ऊपर और कंधे के ब्लेड के बीच बहने दें (भूरे वसायुक्त ऊतक को सक्रिय करता है)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi fate scorrere consapevolmente l'acqua fredda sul collo e tra le scapole (attiva il tessuto adiposo bruno)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は意識的に首と肩甲骨の間に冷水を流してみましょう（褐色脂肪組織を活性化します）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 의식적으로 찬물을 목과 견갑골 사이로 흐르게 하세요(갈색 지방 조직 활성화)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat vandaag bewust het koude water over de nek en tussen de schouderbladen lopen (activeert bruin vetweefsel)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj świadomie pozwól zimnej wodzie spłynąć po szyi i pomiędzy łopatkami (aktywuje brązową tkankę tłuszczową)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, deixe conscientemente a água fria correr pelo pescoço e entre as omoplatas (ativa o tecido adiposo marrom)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, deixe conscientemente a água fria correr pelo pescoço e entre as omoplatas (ativa o tecido adiposo marrom)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня сознательно позвольте холодной воде течь по шее и между лопатками (активирует бурую жировую ткань)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün bilinçli olarak soğuk suyun boynunuza ve kürek kemiklerinizin arasına akmasına izin verin (kahverengi yağ dokusunu harekete geçirir)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，有意识地让冷水流过颈部和肩胛骨之间（激活棕色脂肪组织）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，有意識地讓冷水流過頸部和肩胛骨之間（激活棕色脂肪組織）。"
          }
        }
      }
    },

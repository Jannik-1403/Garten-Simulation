    "prog_running_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sehr lockerer Lauf, um die Beine nach dem Wochenende durchzubewegen. Du solltest dabei entspannt durch die Nase atmen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A very easy run to get your legs moving after the weekend. You should be able to breathe relaxed through your nose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carrera muy fácil para poner las piernas en movimiento después del fin de semana. Debería poder respirar relajado por la nariz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une course très facile pour bouger les jambes après le week-end. Vous devriez pouvoir respirer détendu par le nez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताहांत के बाद अपने पैरों को हिलाने-डुलाने के लिए एक बहुत ही आसान दौड़। आपको अपनी नाक से आराम से सांस लेने में सक्षम होना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una corsa molto facile per rimettere in movimento le gambe dopo il fine settimana. Dovresti essere in grado di respirare rilassato attraverso il naso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末の後に脚を動かすのにとても簡単なランニングです。鼻からリラックスして呼吸できるはずです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말 이후에 다리를 움직일 수 있는 매우 쉬운 달리기입니다. 코를 통해 편안하게 숨을 쉴 수 있어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een heel gemakkelijke run om je benen in beweging te krijgen na het weekend. U moet ontspannen door uw neus kunnen ademen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bardzo łatwy bieg, żeby rozruszać nogi po weekendzie. Powinieneś móc swobodnie oddychać przez nos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma corrida muito fácil para movimentar as pernas depois do fim de semana. Você deve ser capaz de respirar relaxado pelo nariz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma corrida muito fácil para movimentar as pernas depois do fim de semana. Você deve ser capaz de respirar relaxado pelo nariz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень легкая пробежка, чтобы заставить ноги двигаться после выходных. Вы должны иметь возможность спокойно дышать через нос."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonundan sonra bacaklarınızı hareket ettirmek için çok kolay bir koşu. Burnunuzdan rahat bir şekilde nefes alabilmelisiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周末后让你的双腿活动起来的非常简单的跑步。您应该能够通过鼻子轻松呼吸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週末後讓你的雙腿活動起來的非常簡單的跑步。您應該能夠透過鼻子輕鬆呼吸。"
          }
        }
      }
    },

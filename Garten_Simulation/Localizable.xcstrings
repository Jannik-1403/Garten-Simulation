          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zauważasz, że spędzasz na telefonie komórkowym 4 godziny dziennie. Postanawiasz to zmienić. Twoje podejście?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você percebe que está no celular 4 horas por dia. Você decide mudar isso. Sua abordagem?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты замечаешь, что проводишь 4 часа в день с телефоном. Ты решаешь это изменить. Каков твой подход?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

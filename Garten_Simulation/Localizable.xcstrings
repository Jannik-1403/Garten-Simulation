    "prog_nutrition_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzehre mindestens eine Portion komplett roh, um alle hitzeempfindlichen Vitamine zu bewahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat at least one serving completely raw to preserve all of the heat-sensitive vitamins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consuma al menos una porción completamente cruda para conservar todas las vitaminas sensibles al calor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangez au moins une portion entièrement crue pour préserver toutes les vitamines sensibles à la chaleur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्मी के प्रति संवेदनशील सभी विटामिनों को सुरक्षित रखने के लिए कम से कम एक बार पूरी तरह से कच्चा खाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangia almeno una porzione completamente cruda per preservare tutte le vitamine sensibili al calore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱に弱いビタミンをすべて保存するために、少なくとも 1 回分は完全に生で食べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열에 민감한 비타민을 모두 보존하려면 적어도 한 번은 완전히 생으로 섭취하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eet ten minste één portie volledig rauw om alle warmtegevoelige vitamines te behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjedz przynajmniej jedną porcję całkowicie na surowo, aby zachować wszystkie witaminy wrażliwe na ciepło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coma pelo menos uma porção completamente crua para preservar todas as vitaminas sensíveis ao calor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coma pelo menos uma porção completamente crua para preservar todas as vitaminas sensíveis ao calor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съешьте хотя бы одну порцию полностью сырой, чтобы сохранить все термочувствительные витамины."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isıya duyarlı vitaminlerin tümünü korumak için en az bir porsiyon tamamen çiğ yiyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少吃一份完全生吃，以保留所有热敏维生素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少吃一份完全生吃，以保留所有熱敏維生素。"
          }
        }
      }
    },

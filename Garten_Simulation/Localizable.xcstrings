    "trash.endlos_scroll_tv.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Fernseher ab und nutze die Zeit für dich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the TV and use the time for yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga el televisor y aprovecha el tiempo para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éteins la télévision et prends du temps pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spegni la TV e usa il tempo per te stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレビを消して、自分のために時間を使いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV를 끄고 자신을 위한 시간을 가지세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de tv uit en neem tijd voor jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz telewizor i wykorzystaj ten czas dla siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue a TV e use o tempo para si mesmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizyonu kapatın ve zamanı kendinize ayırın."
          }
        }
      }
    },
    "trash.endlos_scroll_tv.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Zuviel Fernsehen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },

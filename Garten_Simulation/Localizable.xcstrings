    "Dein früherer Spielstand ist ein unveränderter Rückblick. Er beeinflusst neue Gewohnheiten und Statistiken nicht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein früherer Spielstand ist ein unveränderter Rückblick. Er beeinflusst neue Gewohnheiten und Statistiken nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous game state is an archive. It does not affect new habits and statistics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estado de juego anterior es un registro inalterado. No afecta a nuevos hábitos ni estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ancien état de jeu est un historique inchangé. Il n'influence pas les nouvelles habitudes ni les statistiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पिछली प्रगति एक अपरिवर्तित समीक्षा है। यह नई आदतों और आंकड़ों को प्रभावित नहीं करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo stato di gioco precedente è una cronologia invariata. Non influisce sulle nuove abitudini o statistiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のゲームデータは履歴として保存され、新しい習慣や統計には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 게임 진행 상태는 변경되지 않는 기록입니다. 새로운 습관과 통계에는 영향을 주지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vorige voortgang is een ongewijzigd overzicht. Het heeft geen invloed op nieuwe gewoonten en statistieken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój poprzedni stan gry to niezmieniony przegląd. Nie wpływa na nowe nawyki i statystyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu progresso anterior é um registo inalterado. Não influencia novos hábitos nem estatísticas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu progresso anterior é um registro inalterado. Não afeta novos hábitos nem estatísticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш прошлый игровой прогресс сохранен как история. Он не влияет на новые привычки и статистику."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki oyun durumunuz değişmeyen bir kayıttır. Yeni alışkanlıkları ve istatistikleri etkilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你以前的进度属于存档回顾，不会影响新的习惯和统计数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您先前的進度屬於記錄回顧，不會影響新的習慣和統計資料。"
          }
        }
      }
    },

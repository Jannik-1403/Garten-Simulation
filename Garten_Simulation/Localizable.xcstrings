    "plant.seerose.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4chst im Wasser, ruhig und stark \u2013 Schwimmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows in water, calm and strong \u2013 Swimming"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece en el agua, tranquilo y fuerte \u2013 Nataci\u00f3n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse dans l'eau, calme et fort \u2013 Natation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u093e\u0928\u0940 \u092e\u0947\u0902 \u092c\u0922\u093c\u0924\u093e \u0939\u0948, \u0936\u093e\u0902\u0924 \u0914\u0930 \u092e\u091c\u092c\u0942\u0924 \u2013 \u0924\u0948\u0930\u0928\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows in water, calm and strong \u2013 Swimming"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c34\u306e\u4e2d\u3067\u80b2\u3061\u3001\u7a4f\u3084\u304b\u3067\u529b\u5f37\u3044 - \u6cf3\u3050"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb3c\uc18d\uc5d0\uc11c \uc790\ub77c\uba70 \uc870\uc6a9\ud558\uace0 \uac15\ud568 \u2013 \uc218\uc601"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit in water, kalm en sterk \u2013 Zwemmend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015bnie w wodzie, spokojny i silny \u2013 P\u0142ywa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce na \u00e1gua, calmo e forte \u2013 Nata\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u0442 \u0432 \u0432\u043e\u0434\u0435, \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0438 \u0441\u0438\u043b\u044c\u043d\u043e \u2013 \u043f\u043b\u0430\u0432\u0430\u043d\u0438\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suda b\u00fcy\u00fcr, sakin ve g\u00fc\u00e7l\u00fcd\u00fcr \u2013 Y\u00fczme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6c34\u4e2d\u751f\u957f\uff0c\u5b81\u9759\u800c\u575a\u97e7 \u2013 \u6e38\u6cf3"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u9577\u5728\u6c34\u4e2d\uff0c\u5e73\u975c\u800c\u5805\u5f37\u2014\u2014\u6e38\u6cf3"
          }
        }
      }
    },

    "assessment.finance.q3" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist der 25. des Monats. Weißt du, wie viel Geld du noch auf dem Konto hast – ohne nachzuschauen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's the 25th of the month. Do you know how much money you have left in your account without looking?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el día 25 del mes. ¿Sabes cuánto dinero te queda en tu cuenta sin mirar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes le 25 du mois. Savez-vous combien d’argent il vous reste sur votre compte sans regarder ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह महीने की 25 तारीख है. क्या आप जानते हैं कि बिना देखे आपके खाते में कितने पैसे बचे हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È il 25 del mese. Sai quanti soldi ti sono rimasti sul tuo conto senza guardare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月は25日です。見なくても口座にいくら残っているか知っていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매월 25일이에요. 보지도 않고 계좌에 돈이 얼마나 남았는지 아시나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is de 25e van de maand. Weet jij zonder te kijken hoeveel geld er nog op je rekening staat?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest 25 dzień miesiąca. Czy wiesz, ile pieniędzy zostało Ci na koncie bez sprawdzania?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É dia 25 do mês. Você sabe quanto dinheiro resta na sua conta sem olhar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня 25-е число месяца. Знаешь ли ты, сколько денег у тебя ещё на счёте — не глядя?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayın 25'i. Bakmadan hesabınızda ne kadar para kaldığını biliyor musunuz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天是这个月的25号。你知道你账户里还有多少钱吗——不看也能知道吗？"
          }
        },

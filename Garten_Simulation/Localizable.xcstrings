            "value": "Energéticos criam uma energia falsa que arruína seu sono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Energéticos criam uma energia falsa que arruína seu sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Энергетические напитки создают фальшивую энергию, которая портит ваш сон."
          }
        },
        "tr": {

    "screentime.preprompt.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf die Bildschirmzeit, damit Zalimo Habits ablenkende Apps blockieren kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to Screen Time so Zalimo Habits can block distracting apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita el acceso a Screen Time para que Zalimo Habits pueda bloquear aplicaciones que distraen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à Screen Time afin que Zalimo Habits puisse bloquer les applications distrayantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन टाइम तक पहुंच की अनुमति दें ताकि ग्रोवी ध्यान भटकाने वाले ऐप्स को ब्लॉक कर सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso a Screen Time in modo che Zalimo Habits possa bloccare le app che distraggono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits が邪魔なアプリをブロックできるように、スクリーン タイムへのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits가 방해가 되는 앱을 차단할 수 있도록 스크린 타임에 대한 액세스를 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot Schermtijd zodat Zalimo Habits afleidende apps kan blokkeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Czasu przed ekranem, aby Zalimo Habits mógł blokować rozpraszające aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Tempo de Uso para que Zalimo Habits possa bloquear aplicativos que distraem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Tempo de Uso para que Zalimo Habits possa bloquear aplicativos que distraem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к экранному времени, чтобы Грови мог блокировать отвлекающие приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits'nin dikkat dağıtıcı uygulamaları engelleyebilmesi için Ekran Süresi'ne erişime izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问屏幕使用时间，以便 Zalimo Habits 可以阻止分心的应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許訪問螢幕使用時間，以便 Zalimo Habits 可以阻止分心的應用程式。"
          }
        }
      }
    },

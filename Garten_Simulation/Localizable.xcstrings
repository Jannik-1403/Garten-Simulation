    "prog_running_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lauf in ambitioniertem, aber haltbarem Tempo (Zone 3). Es sollte anstrengend, aber kontrolliert sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A run at an ambitious but sustainable pace (Zone 3). It should be strenuous but controlled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carrera a un ritmo ambicioso pero sostenible (Zona 3). Debe ser extenuante pero controlado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une course au rythme ambitieux mais durable (Zone 3). Cela devrait être intense mais contrôlé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्वाकांक्षी लेकिन टिकाऊ गति से दौड़ (जोन 3)। यह ज़ोरदार लेकिन नियंत्रित होना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una corsa a un ritmo ambizioso ma sostenibile (Zona 3). Dovrebbe essere faticoso ma controllato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "野心的だが持続可能なペースでのランニング (ゾーン 3)。激しいですが、コントロールする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야심차지만 지속 가능한 속도로 실행합니다(영역 3). 힘들지만 통제되어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een run in een ambitieus maar duurzaam tempo (Zone 3). Het moet inspannend maar gecontroleerd zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieg w ambitnym, ale zrównoważonym tempie (Strefa 3). Powinien być intensywny, ale kontrolowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma corrida a um ritmo ambicioso mas sustentável (Zona 3). Deve ser extenuante, mas controlado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma corrida a um ritmo ambicioso mas sustentável (Zona 3). Deve ser extenuante, mas controlado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бег в амбициозном, но устойчивом темпе (Зона 3). Это должно быть напряженно, но контролируемо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İddialı ama sürdürülebilir bir tempoda koşu (Bölge 3). Yorucu ama kontrollü olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以雄心勃勃但可持续的速度跑步（3区）。它应该是费力但受控制的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以雄心勃勃但可持續的速度跑步（3區）。它應該是費力但受控制的。"
          }
        }
      }
    },

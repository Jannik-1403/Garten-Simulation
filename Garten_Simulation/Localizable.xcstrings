          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 0 \u0436\u0438\u0437\u043d\u044f\u0445 \u0432\u0441\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u044b"

    "assessment.health.profile.ignorant.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Körper sendet Signale. Lerne sie zu lesen und handle, bevor der Crash kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body sends signals. Learn to read them and act before the crash comes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuerpo envía señales. Aprenda a leerlos y actuar antes de que llegue el colapso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre corps envoie des signaux. Apprenez à les lire et à agir avant que le crash ne survienne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका शरीर संकेत भेजता है। दुर्घटना आने से पहले उन्हें पढ़ना और कार्य करना सीखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo corpo invia segnali. Impara a leggerli e ad agire prima che arrivi lo schianto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの体は信号を送ります。クラッシュが起こる前に、それらを読んで行動する方法を学びましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 몸은 신호를 보냅니다. 충돌이 발생하기 전에 이를 읽고 행동하는 방법을 배우십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lichaam zendt signalen uit. Leer ze te lezen en te handelen voordat de crash komt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje ciało wysyła sygnały. Naucz się je czytać i działaj, zanim nadejdzie katastrofa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu corpo envia sinais. Aprenda a lê-los e a agir antes que o acidente aconteça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твое тело посылает сигналы. Научись их читать и действуй, прежде чем наступит крах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vücudunuz sinyaller gönderir. Bunları okumayı ve kaza gelmeden önce harekete geçmeyi öğrenin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的身体在发出信号。学会解读它们，并在崩溃来临之前采取行动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的身體會發出訊號。學會閱讀它們並在崩潰發生之前採取行動。"
          }
        }
      }
    },
    "assessment.health.profile.ignorant.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm Schmerzmittel nicht direkt beim ersten Ziehen – trinke stattdessen 500ml Wasser und warte 10 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't take painkillers right away when you first puff - instead, drink 500ml of water and wait 10 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tome analgésicos inmediatamente después de la primera inhalación; en su lugar, beba 500 ml de agua y espere 10 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prenez pas d'analgésiques dès la première bouffée. Buvez plutôt 500 ml d'eau et attendez 10 minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप पहली बार कश लें तो तुरंत दर्द निवारक दवाएं न लें - इसके बजाय, 500 मिलीलीटर पानी पिएं और 10 मिनट तक प्रतीक्षा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non prendere antidolorifici subito al primo tiro, bevi invece 500 ml di acqua e attendi 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に吸ったときにすぐに鎮痛剤を服用せず、500ml の水を飲んで 10 分間待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 흡입할 때 바로 진통제를 복용하지 말고, 대신 물 500ml를 마시고 10분 정도 기다리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem niet meteen pijnstillers als u voor het eerst puft, maar drink in plaats daarvan 500 ml water en wacht 10 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie bierz środków przeciwbólowych od razu po pierwszym zaciągnięciu – zamiast tego wypij 500ml wody i odczekaj 10 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tome analgésicos imediatamente na primeira inalação - em vez disso, beba 500ml de água e espere 10 minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не принимайте обезболивающее при первых признаках боли – вместо этого выпейте 500 мл воды и подождите 10 минут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk nefesinizi çekerken hemen ağrı kesici almayın; bunun yerine 500 ml su içip 10 dakika bekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要在第一次疼痛时直接服用止痛药——改为先喝500毫升水，然后等待10分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一次吸時不要立即服用止痛藥，而是喝 500 毫升水並等待 10 分鐘。"
          }
        }
      }
    },
    "assessment.health.profile.ignorant.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbringe jeden Tag exakt 2 Minuten in einer tiefen Hocke (Deep Squat), um deine Gelenke zu schmieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spend exactly 2 minutes in a deep squat every day to lubricate your joints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pase exactamente 2 minutos en sentadilla profunda todos los días para lubricar sus articulaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez exactement 2 minutes en squat profond chaque jour pour lubrifier vos articulations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने जोड़ों को चिकनाई देने के लिए हर दिन ठीक 2 मिनट गहरी स्क्वाट में बिताएं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascorri esattamente 2 minuti ogni giorno in uno squat profondo per lubrificare le articolazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日ちょうど 2 分間、深いスクワットをして関節を潤してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관절에 윤활유를 공급하기 위해 매일 정확히 2분 동안 딥 스쿼트를 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breng elke dag precies 2 minuten door in een diepe squat om je gewrichten te smeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codziennie poświęć dokładnie 2 minuty na głębokie przysiady, aby nasmarować stawy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe exatamente 2 minutos em um agachamento profundo todos os dias para lubrificar as articulações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводите каждый день ровно 2 минуты в глубоком приседе (Deep Squat), чтобы смазывать ваши суставы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklemlerinizi yağlamak için her gün tam olarak 2 dakikanızı derin çömelmeye ayırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天花确切的2分钟时间做深蹲，以润滑你的关节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天花 2 分鐘深蹲來潤滑關節。"
          }
        }
      }
    },
    "assessment.health.profile.ignorant.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ignorierst Alarmsignale deines Körpers. Wir fügen eine extrem kleine präventive Wartung hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You ignore your body’s alarm signals. We add extremely small preventive maintenance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoras las señales de alarma de tu cuerpo. Agregamos un mantenimiento preventivo extremadamente pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ignorez les signaux d’alarme de votre corps. Nous ajoutons une maintenance préventive extrêmement minime."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपने शरीर के अलार्म संकेतों को अनदेखा करते हैं। हम अत्यंत छोटा निवारक रखरखाव जोड़ते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignori i segnali di allarme del tuo corpo. Aggiungiamo una manutenzione preventiva estremamente ridotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身体の警報信号を無視します。ごく小規模な予防保守を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 신체의 경보 신호를 무시합니다. 우리는 매우 작은 예방 유지 보수를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je negeert de alarmsignalen van je lichaam. Wij voegen extreem klein preventief onderhoud toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorujesz sygnały alarmowe swojego ciała. Do tego dodajemy niezwykle drobne prace konserwacyjne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ignora os sinais de alarme do seu corpo. Adicionamos manutenções preventivas extremamente pequenas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты игнорируешь сигналы тревоги своего тела. Мы добавляем крайне небольшое превентивное обслуживание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vücudunuzun alarm sinyallerini görmezden geliyorsunuz. Son derece küçük önleyici bakımlar ekliyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你忽视了自己身体的警示信号。我们增加了一次极小的预防性维护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你忽視了身體發出的警報信號。我們增加了極小的預防性維護。"
          }
        }
      }
    },

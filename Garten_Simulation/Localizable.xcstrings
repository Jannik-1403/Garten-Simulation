    "dopamine_story_sol_sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt schnellen Kicks baust du echte Gewohnheiten auf. Im Schnitt dauert es 66 Tage, bis sie automatisch ablaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of quick hits, you build real habits. It takes an average of 66 days for them to become automatic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de picos rápidos, construyes hábitos reales. Tardan una media de 66 días en volverse automáticos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de pics rapides, tu construis de vraies habitudes. Il faut en moyenne 66 jours pour qu'elles deviennent automatiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ किक के बजाय, आप असली आदतें बनाते हैं। इन्हें स्वचालित होने में औसतन 66 दिन लगते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di picchi veloci, costruisci vere abitudini. Ci vogliono in media 66 giorni perché diventino automatiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手軽な刺激の代わりに、本物の習慣を築きます。自動的にできるようになるまで平均66日かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 쾌감 대신 진정한 습관을 만듭니다. 습관이 자동으로 자리 잡는 데 평균 66일이 걸립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In plaats van snelle kicks bouw je echte gewoontes op. Gemiddeld duurt het 66 dagen voordat ze automatisch gaan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо быстрых наград вы строите настоящие привычки. В среднем требуется 66 дней, чтобы они стали автоматическими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı ödüller yerine gerçek alışkanlıklar edinirsiniz. Bunların otomatik hale gelmesi ortalama 66 gün sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再追求快速刺激，而是养成真正的习惯。平均需要66天，习惯才会自然形成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再追求快速刺激，而是養成真正的習慣。平均需要66天，習慣才會自然形成。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt schnellen Kicks baust du echte Gewohnheiten auf. Im Schnitt dauert es 66 Tage, bis sie automatisch ablaufen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt schnellen Kicks baust du echte Gewohnheiten auf. Im Schnitt dauert es 66 Tage, bis sie automatisch ablaufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt schnellen Kicks baust du echte Gewohnheiten auf. Im Schnitt dauert es 66 Tage, bis sie automatisch ablaufen."
          }
        }
      }
    },

    "progression_cooking_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche heute mit mindestens 3 frischen Gem\u00fcsesorten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook today with at least 3 fresh types of vegetables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina hoy con al menos 3 tipos de verduras frescas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisine aujourd'hui avec au moins 3 types de l\u00e9gumes frais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0915\u092e \u0938\u0947 \u0915\u092e 3 \u0924\u093e\u091c\u0947 \u0938\u092c\u094d\u091c\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0916\u093e\u0928\u093e \u092c\u0928\u093e\u0913\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina oggi con almeno 3 tipi di verdure fresche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u5c11\u306a\u304f\u3068\u30823\u7a2e\u985e\u306e\u65b0\u9bae\u306a\u91ce\u83dc\u3092\u4f7f\u3063\u3066\u6599\u7406\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \uc801\uc5b4\ub3c4 3\uac00\uc9c0 \uc885\ub958\uc758 \uc2e0\uc120\ud55c \uc57c\ucc44\ub85c \uc694\ub9ac\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook vandaag met minimaal 3 verse soorten groenten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotuj dzisiaj z co najmniej 3 rodzajami \u015bwie\u017cych warzyw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinha hoje com pelo menos 3 tipos de legumes frescos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u0442\u043e\u0432\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0441 3 \u0441\u0432\u0435\u0436\u0438\u043c\u0438 \u043e\u0432\u043e\u0449\u0430\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn en az 3 \u00e7e\u015fit taze sebze ile yemek pi\u015firin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u7528\u81f3\u5c113\u79cd\u65b0\u9c9c\u852c\u83dc\u70f9\u996a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u81f3\u5c11\u7528 3 \u7a2e\u65b0\u9bae\u852c\u83dc\u505a\u98ef\u3002"
          }
        }
      }
    },
    "progression_cooking_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche heute eine einfache, gesunde Mahlzeit selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook a simple, healthy meal yourself today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina t\u00fa mismo una comida sencilla y saludable hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisine toi-m\u00eame un repas simple et sain aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u090f\u0915 \u0938\u0930\u0932, \u0938\u094d\u0935\u0938\u094d\u0925 \u092d\u094b\u091c\u0928 \u0916\u0941\u0926 \u092c\u0928\u093e\u0913\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina da te un pasto semplice e sano oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u7c21\u5358\u3067\u5065\u5eb7\u7684\u306a\u98df\u4e8b\u3092\u81ea\u5206\u3067\u4f5c\u308a\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \uac04\ub2e8\ud558\uace0 \uac74\uac15\ud55c \uc2dd\uc0ac\ub97c \uc9c1\uc811 \uc694\ub9ac\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook vandaag nog zelf een eenvoudige, gezonde maaltijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju\u017c dzi\u015b samodzielnie ugotuj prosty, zdrowy posi\u0142ek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinha uma refei\u00e7\u00e3o simples e saud\u00e1vel tu mesmo hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u0440\u043e\u0441\u0442\u0443\u044e, \u0437\u0434\u043e\u0440\u043e\u0432\u0443\u044e \u0435\u0434\u0443 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn kendiniz basit ve sa\u011fl\u0131kl\u0131 bir yemek pi\u015firin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u81ea\u5df1\u505a\u4e00\u987f\u7b80\u5355\u5065\u5eb7\u7684\u996d\u83dc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u5f9e\u982d\u958b\u59cb\u505a\u4e00\u9813\u7c21\u55ae\u3001\u5065\u5eb7\u7684\u9910\u9ede\u3002"
          }
        }
      }
    },
    "progression_cooking_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein Meisterkoch deiner Gesundheit. Genie\u00dfe dein Essen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a master chef of your health. Enjoy your food!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un chef maestro de tu salud. \u00a1Disfruta tu comida!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un chef cuisinier de ta sant\u00e9. Profite de ton repas !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u0940 \u0938\u0947\u0939\u0924 \u0915\u0947 \u092e\u093e\u0938\u094d\u091f\u0930 \u0936\u0947\u092b \u0939\u0948\u0902\u0964 \u0905\u092a\u0928\u0947 \u0916\u093e\u0928\u0947 \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei uno chef maestro della tua salute. Goditi il tuo cibo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u5065\u5eb7\u306e\u30de\u30b9\u30bf\u30fc\u30b7\u30a7\u30d5\u3067\u3059\u3002\u304a\u98df\u4e8b\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uac74\uac15\uc758 \ub9c8\uc2a4\ud130 \uc170\ud504\uc785\ub2c8\ub2e4. \uc74c\uc2dd\uc744 \uc990\uaca8\ubcf4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U bent een meesterkok als het gaat om uw gezondheid. Geniet van je eten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b mistrzem swojego zdrowia. Ciesz si\u0119 jedzeniem!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9s um chef mestre da tua sa\u00fade. Desfruta da tua comida!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043c\u0430\u0441\u0442\u0435\u0440-\u043a\u0443\u043b\u0438\u043d\u0430\u0440 \u0441\u0432\u043e\u0435\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f. \u041d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0439\u0441\u044f \u0441\u0432\u043e\u0435\u0439 \u0435\u0434\u043e\u0439!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz sa\u011fl\u0131\u011f\u0131n\u0131z\u0131n usta \u015fefisiniz. Yeme\u011finizin tad\u0131n\u0131 \u00e7\u0131kar\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u662f\u5065\u5eb7\u70f9\u996a\u5927\u5e08\u3002\u4eab\u53d7\u4f60\u7684\u7f8e\u98df\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u662f\u60a8\u5065\u5eb7\u7684\u5927\u5eda\u3002\u4eab\u53d7\u4f60\u7684\u98df\u7269\u5427\uff01"
          }
        }
      }
    },
    "progression_cooking_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereite alle Mahlzeiten des Tages komplett selbst und zuckerfrei zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare all meals of the day completely yourself and sugar-free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara todas las comidas del d\u00eda completamente t\u00fa mismo y sin az\u00facar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9pare tous les repas de la journ\u00e9e enti\u00e8rement toi-m\u00eame et sans sucre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u093f\u0928 \u0915\u0947 \u0938\u092d\u0940 \u092d\u094b\u091c\u0928 \u0916\u0941\u0926 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0914\u0930 \u092c\u093f\u0928\u093e \u091a\u0940\u0928\u0940 \u0915\u0947 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara tutti i pasti della giornata completamente da solo e senza zucchero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u306e\u65e5\u306e\u98df\u4e8b\u306f\u3059\u3079\u3066\u7802\u7cd6\u3092\u542b\u307e\u305a\u306b\u5b8c\u5168\u306b\u81ea\u5206\u3067\u6e96\u5099\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud558\ub8e8\uc758 \ubaa8\ub4e0 \uc2dd\uc0ac\ub97c \uc124\ud0d5 \uc5c6\uc774 \uc9c1\uc811 \uc900\ube44\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereid alle maaltijden van de dag volledig zelf en suikervrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuj wszystkie posi\u0142ki dnia ca\u0142kowicie samodzielnie i bez cukru."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara todas as refei\u00e7\u00f5es do dia completamente tu mesmo e sem a\u00e7\u00facar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u0442\u043e\u0432\u044c \u0432\u0441\u0435 \u0431\u043b\u044e\u0434\u0430 \u0434\u043d\u044f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0438 \u0431\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcn\u00fcn t\u00fcm \u00f6\u011f\u00fcnlerini tamamen kendiniz ve \u015fekersiz haz\u0131rlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u6240\u6709\u9910\u70b9\u90fd\u81ea\u5df1\u505a\uff0c\u5e76\u4e14\u4e0d\u52a0\u7cd6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u5168\u5f9e\u982d\u958b\u59cb\u6e96\u5099\u7576\u5929\u7684\u6240\u6709\u81b3\u98df\uff0c\u4e26\u4e14\u4e0d\u542b\u7cd6\u3002"
          }
        }
      }
    },

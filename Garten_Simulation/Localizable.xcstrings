    "prog_water_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt nach dem Aufstehen hat dein Körper über Nacht dehydriert. Trinke ein großes Glas (ca. 400-500ml) Wasser direkt nach dem Wachwerden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immediately after getting up, your body has become dehydrated overnight. Drink a large glass (approx. 400-500ml) of water immediately after waking up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente después de levantarte, tu cuerpo se ha deshidratado durante la noche. Beba un vaso grande (aprox. 400-500 ml) de agua inmediatamente después de despertarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Immédiatement après vous être levé, votre corps s’est déshydraté pendant la nuit. Buvez un grand verre (environ 400 à 500 ml) d'eau immédiatement après le réveil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठने के तुरंत बाद, आपका शरीर रात भर में निर्जलित हो गया है। जागने के तुरंत बाद एक बड़ा गिलास (लगभग 400-500 मिली) पानी पियें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito dopo esserti alzato, il tuo corpo si è disidratato durante la notte. Bere un bicchiere abbondante (circa 400-500 ml) di acqua subito dopo il risveglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床直後の身体は一晩で脱水状態になっています。起きたらすぐにコップ一杯（約400～500ml）の水を飲みましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나자마자 밤새 몸이 탈수 상태가 됩니다. 잠에서 깬 후 즉시 큰 잔(약 400-500ml)의 물을 마십니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct na het opstaan ​​is uw lichaam gedurende de nacht uitgedroogd. Drink direct na het ontwaken een groot glas (ca. 400-500 ml) water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaraz po przebudzeniu organizm przez noc uległ odwodnieniu. Zaraz po przebudzeniu wypij dużą szklankę wody (ok. 400-500ml)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imediatamente após se levantar, seu corpo ficou desidratado durante a noite. Beba um copo grande (aprox. 400-500ml) de água imediatamente após acordar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imediatamente após se levantar, seu corpo ficou desidratado durante a noite. Beba um copo grande (aprox. 400-500ml) de água imediatamente após acordar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу после пробуждения ваше тело за ночь обезвоживается. Выпейте большой стакан (около 400–500 мл) воды сразу после пробуждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyandıktan hemen sonra vücudunuz gece boyunca susuz kalır. Uyandıktan hemen sonra büyük bir bardak (yaklaşık 400-500 ml) su için."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚起床，身体一夜之间就脱水了。起床后立即喝一大杯（约400-500毫升）水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛起床，身體一夕之間就脫水了。起床後立即喝一大杯（約400-500毫升）水。"
          }
        }
      }
    },

    "weed.detail.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh nein! Um dieses Unkraut zu entfernen, musst du heute %d Gewohnheiten abschlie\u00dfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh no! Complete %d habits today to remove this weed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Oh no! Completa %d h\u00e1bitos hoy para eliminar estas malas hierbas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh non ! Compl\u00e8te %d habitudes aujourd'hui pour retirer ces mauvaises herbes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0913\u0939 \u0928\u0939\u0940\u0902! \u0907\u0938 \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0915\u094b \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0906\u091c%d\u0906\u0926\u0924\u0947\u0902 \u092a\u0942\u0930\u0940 \u0915\u0930\u0928\u0940 \u0939\u094b\u0902\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh no! Completa %d abitudini oggi per rimuovere queste erbacce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u306a\u3093\u3066\u3053\u3063\u305f\uff01\u3053\u306e\u96d1\u8349\u3092\u9664\u53bb\u3059\u308b\u306b\u306f\u3001\u4eca\u65e5 %d \u500b\u306e\u7fd2\u6163\u3092\u5b8c\u4e86\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc548 \ub3fc! \uc774 \uc7a1\ucd08\ub97c \uc81c\uac70\ud558\ub824\uba74 \uc624\ub298 %d\uac1c\uc758 \uc2b5\uad00\uc744 \uc644\ub8cc\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "O nee! Voltooi vandaag nog %d gewoonten om dit onkruid te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O nie! Uko\u0144cz dzisiaj %d nawyk\u00f3w, aby usun\u0105\u0107 tego chwasta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh n\u00e3o! Completa %d h\u00e1bitos hoje para remover estas ervas daninhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e, \u043d\u0435\u0442! \u0427\u0442\u043e\u0431\u044b \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u0438 \u0441\u043e\u0440\u043d\u044f\u043a\u0438, \u0432\u0430\u043c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438%d\u0441\u0435\u0433\u043e\u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ah hay\u0131r! Bu otu ortadan kald\u0131rmak i\u00e7in bug\u00fcn %d al\u0131\u015fkanl\u0131\u011f\u0131 tamamlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54e6\u4e0d\uff01\u8981\u6e05\u9664\u8fd9\u4e9b\u6742\u8349\uff0c\u60a8\u4eca\u5929\u5fc5\u987b\u5b8c\u6210%d\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54e6\u4e0d\uff01\u8981\u6e05\u9664\u9019\u4e9b\u96dc\u8349\uff0c\u60a8\u4eca\u5929\u5fc5\u9808\u5b8c\u6210%d\u7fd2\u6163\u3002"
          }
        }
      }
    },

        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczy si\u0119 ka\u017cdy krok."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada passo conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u044b\u0439 \u0448\u0430\u0433 \u0438\u043c\u0435\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ad\u0131m \u00f6nemlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u4e00\u6b65\u90fd\u7b97\u6570\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u4e00\u6b65\u90fd\u5f88\u91cd\u8981\u3002"
          }
        }
      }
    },
    "progression_mot_4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig, was in dir steckt!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show what you're made of!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Demuestra de qu\u00e9 est\u00e1s hecho!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre de quoi tu es capable !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u093f\u0916\u093e\u0913, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0905\u0902\u0926\u0930 \u0915\u094d\u092f\u093e \u0939\u0948!"

    "assessment.mental.profile.unerschuetterlicher.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deinen Kurs. Du bist auf dem richtigen Weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay your course. You are on the right path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu rumbo. Estás en el camino correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre cap. Vous êtes sur la bonne voie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la tua rotta. Sei sulla strada giusta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コースを維持してください。あなたは正しい道を歩んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 길을 유지하십시오. 당신은 올바른 길을 가고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf op koers. Je bent op de goede weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj swój kurs. Jesteś na dobrej drodze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu curso. Você está no caminho certo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotanızda kalın. Doğru yoldasın."
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.break": {

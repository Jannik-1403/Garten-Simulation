    "habit.complete_confirm.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du 100% erreichst, kann der Fortschritt für heute nicht mehr geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you reach 100%, today's progress cannot be changed anymore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que alcances el 100%, el progreso de hoy no se podrá cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois que vous atteignez 100 %, les progrès d'aujourd'hui ne peuvent plus être modifiés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "100% तक पहुँचने के बाद, आज की प्रगति को बदला नहीं जा सकेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta raggiunto il 100%, i progressi di oggi non possono più essere modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100%に達すると、今日の進捗は変更できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100%에 도달하면 오늘의 진행 상황을 더 이상 변경할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je 100% bereikt, kan de voortgang van vandaag niet meer worden gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy osiągniesz 100%, dzisiejszy postęp nie będzie mógł już zostać zmieniony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que você atingir 100%, o progresso de hoje não poderá mais ser alterado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que você atingir 100%, o progresso de hoje não poderá mais ser alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только вы достигнете 100%, прогресс на сегодня больше нельзя будет изменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100'e ulaştığınızda, bugünkü ilerleme artık değiştirilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦达到100%，今天的进度将无法再更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦達到100%，今天的進度將無法再更改。"
          }
        }
      }
    },

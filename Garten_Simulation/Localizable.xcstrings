        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不见了——老实说，我不知道具体是为了什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它消失了——老實說我不知道為什麼。"
          }
        }
      }
    },
    "assessment.finance.q1.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {

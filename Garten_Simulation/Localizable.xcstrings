    "pfad_schwierigkeit_experte_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ultimative Herausforderung. Zeige deine Disziplin und meistere anspruchsvolle Aufgaben!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ultimate challenge. Show your discipline and master demanding tasks!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desaf\u00edo definitivo. \u00a1Muestra tu disciplina y domina tareas exigentes!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le d\u00e9fi ultime. Fais preuve de discipline et ma\u00eetrise des t\u00e2ches exigeantes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0902\u0924\u093f\u092e \u091a\u0941\u0928\u094c\u0924\u0940. \u0905\u092a\u0928\u093e \u0905\u0928\u0941\u0936\u093e\u0938\u0928 \u0926\u093f\u0916\u093e\u090f\u0902 \u0914\u0930 \u091a\u0941\u0928\u094c\u0924\u0940\u092a\u0942\u0930\u094d\u0923 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u092e\u0939\u093e\u0930\u0924 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sfida definitiva. Mostra la tua disciplina e supera compiti impegnativi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a76\u6975\u306e\u6311\u6226\u3002\u898f\u5f8b\u3092\u793a\u3057\u3066\u3001\u8981\u6c42\u306e\u53b3\u3057\u3044\u30bf\u30b9\u30af\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad81\uadf9\uc801\uc778 \ub3c4\uc804. \ub2f9\uc2e0\uc758 \uaddc\uc728\uc744 \ubcf4\uc5ec\uc8fc\uace0 \uae4c\ub2e4\ub85c\uc6b4 \uc791\uc5c5\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ultieme uitdaging. Toon je discipline en beheers veeleisende taken!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostateczne wyzwanie. Poka\u017c swoj\u0105 dyscyplin\u0119 i opanuj wymagaj\u0105ce zadania!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O desafio definitivo. Mostra a tua disciplina e domina tarefas exigentes!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u0439 \u0432\u044b\u0437\u043e\u0432. \u041f\u043e\u043a\u0430\u0436\u0438 \u0441\u0432\u043e\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443 \u0438 \u0441\u043f\u0440\u0430\u0432\u044c\u0441\u044f \u0441 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihai zorluk. Disiplininizi g\u00f6sterin ve zorlu g\u00f6revlerde ustala\u015f\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ec8\u6781\u6311\u6218\u3002\u5c55\u73b0\u4f60\u7684\u7eaa\u5f8b\u6027\uff0c\u638c\u63e1\u9ad8\u96be\u5ea6\u4efb\u52a1\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d42\u6975\u6311\u6230\u3002\u5c55\u73fe\u4f60\u7684\u7d00\u5f8b\u4e26\u5b8c\u6210\u5177\u6709\u6311\u6230\u6027\u7684\u4efb\u52d9\uff01"
          }
        }
      }
    },

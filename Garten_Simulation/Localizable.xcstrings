    "pfad_mental_day_14_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Wochen Achtsamkeit. Du wirkst gelassener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two weeks of mindfulness. You seem more composed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos semanas de atención plena. Pareces más sereno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux semaines de pleine conscience. Tu sembles plus serein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due settimane di consapevolezza. Sembri più sereno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2週間のマインドフルネス。あなたはもっと落ち着いているようです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주간의 마음챙김. 당신은 좀 더 차분해 보이는데요."

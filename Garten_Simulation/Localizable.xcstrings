    "assessment.mental.profile.glaeserner.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stärke deine Resilienz durch kleine Rückschläge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strengthen your resilience through small setbacks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortalece tu resiliencia a través de pequeños contratiempos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renforcez votre résilience face à de petits revers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटी-छोटी असफलताओं के बावजूद अपने लचीलेपन को मजबूत करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rafforza la tua resilienza attraverso piccoli intoppi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな挫折を通じて回復力を強化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 좌절을 통해 회복력을 강화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versterk je veerkracht bij kleine tegenslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wzmacniaj swoją odporność poprzez drobne niepowodzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortaleça sua resiliência através de pequenos contratempos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укрепляй свою устойчивость через маленькие неудачи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük aksiliklerle dayanıklılığınızı güçlendirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过小的挫折增强你的韧性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過小挫折來增強你的韌性。"
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies morgens in den ersten 10 Minuten nach dem Aufwachen keine Nachrichten. Schütze diese 1％ des Tages."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't read the news for the first 10 minutes after you wake up in the morning. Protect that 1％ of the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No leas las noticias durante los primeros 10 minutos después de despertarte por la mañana. Protege ese 1％ del día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne lisez pas les informations pendant les 10 premières minutes après votre réveil le matin. Protégez ce 1％ de la journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुबह उठने के बाद पहले 10 मिनट तक समाचार न पढ़ें। दिन के उस 1％ को सुरक्षित रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non leggere le notizie per i primi 10 minuti dopo esserti svegliato al mattino. Proteggi quell'1％ della giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝起きてから最初の10分間はニュースを読まないでください。一日の 1％ を守りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침에 일어나서 처음 10분 동안은 뉴스를 읽지 마세요. 하루의 1％를 보호하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees het nieuws de eerste tien minuten nadat u 's ochtends wakker wordt niet. Bescherm die 1％ van de dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie czytaj wiadomości przez pierwsze 10 minut po przebudzeniu się rano. Chroń ten 1％ dnia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não leia as notícias nos primeiros 10 minutos depois de acordar pela manhã. Proteja esse 1％ do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не читай новости утром в первые 10 минут после пробуждения. Защищай этот 1％ дня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabah uyandıktan sonraki ilk 10 dakika haber okumayın. Günün ％1’ini koruyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早上醒来的前10分钟不要看新闻。保护这一天的1％。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早上起床後的前 10 分鐘不要閱讀新聞。保護一天中的那 1％。"
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende jede Dusche mit exakt 15 Sekunden kaltem Wasser. Dieser Mini-Stress härtet dein Nervensystem messbar ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End each shower with exactly 15 seconds of cold water. This mini-stress measurably toughens your nervous system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza cada ducha con exactamente 15 segundos de agua fría. Este mini estrés fortalece considerablemente su sistema nervioso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez chaque douche avec exactement 15 secondes d’eau froide. Ce mini-stress renforce de manière mesurable votre système nerveux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक स्नान को ठीक 15 सेकंड के लिए ठंडे पानी से समाप्त करें। यह छोटा-सा तनाव आपके तंत्रिका तंत्र को काफी हद तक सख्त कर देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina ogni doccia con esattamente 15 secondi di acqua fredda. Questo mini-stress rafforza in modo misurabile il tuo sistema nervoso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各シャワーをちょうど 15 秒間冷水で終了します。この小さなストレスは、神経系を明らかに強化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정확히 15초 동안 찬물로 샤워를 마칩니다. 이 작은 스트레스는 신경계를 상당히 강화시킵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beëindig elke douche met precies 15 seconden koud water. Deze mini-stress versterkt je zenuwstelsel meetbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ każdy prysznic dokładnie 15 sekundami zimnej wody. Ten mini-stres wymiernie wzmacnia Twój układ nerwowy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine cada banho com exatamente 15 segundos de água fria. Esse mini-estresse fortalece de forma mensurável o sistema nervoso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заканчивай каждый душ ровно 15 секундами холодной воды. Этот мини-стресс ощутимо закаляет твою нервную систему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her duşu tam olarak 15 saniye soğuk suyla sonlandırın. Bu mini stres sinir sisteminizi ölçülebilir şekilde güçlendirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次淋浴都以准确15秒的冷水结束。这种小压力显著强化你的神经系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次淋浴結束時用冷水正好 15 秒。這種微小的壓力可以顯著增強你的神經系統。"
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald Druck entsteht, fängst du an zu bröckeln. Du musst deinen Körper und Geist an extrem kleine Dosen von Stress gewöhnen, um Resilienz aufzubauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as pressure arises, you start to crumble. You must accustom your body and mind to extremely small doses of stress to build resilience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan pronto como surge la presión, empiezas a desmoronarte. Debe acostumbrar su cuerpo y su mente a dosis extremadamente pequeñas de estrés para desarrollar su resiliencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que la pression monte, vous commencez à vous effondrer. Vous devez habituer votre corps et votre esprit à des doses de stress extrêmement faibles pour renforcer votre résilience."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दबाव पड़ते ही आप बिखरने लगते हैं। लचीलापन बनाने के लिए आपको अपने शरीर और दिमाग को तनाव की बेहद छोटी खुराक का आदी बनाना होगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non appena aumenta la pressione, inizi a sgretolarti. Devi abituare il tuo corpo e la tua mente a dosi estremamente piccole di stress per sviluppare la resilienza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレッシャーがかかるとすぐに崩れ始めます。回復力を高めるには、極度に少量のストレスに体と心を慣れさせる必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압력이 가해지면 무너지기 시작합니다. 회복력을 키우려면 몸과 마음이 극도로 적은 양의 스트레스에 익숙해져야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra er druk ontstaat, begin je af te brokkelen. Je moet je lichaam en geest wennen aan extreem kleine doses stress om veerkracht op te bouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy tylko pojawi się ciśnienie, zaczniesz się kruszyć. Aby zbudować odporność, musisz przyzwyczaić swoje ciało i umysł do wyjątkowo małych dawek stresu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim que surge a pressão, você começa a desmoronar. Você deve acostumar seu corpo e mente a doses extremamente pequenas de estresse para construir resiliência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как только появляется давление, ты начинаешь рассыпаться. Тебе нужно приучать свое тело и разум к экстремально маленьким дозам стресса, чтобы развивать устойчивость."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baskı oluştuğu anda parçalanmaya başlarsınız. Dayanıklılık geliştirmek için vücudunuzu ve zihninizi son derece küçük dozlarda strese alıştırmanız gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦产生压力，你就开始崩溃。你必须让你的身体和精神习惯于极小剂量的压力，以建立韧性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦壓力出現，你就開始崩潰。您必須讓自己的身體和思想適應極小劑量的壓力，以增強恢復能力。"
          }
        }
      }
    },

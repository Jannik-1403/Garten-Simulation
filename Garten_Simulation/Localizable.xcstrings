          "stringUnit": {
            "state": "translated",
            "value": "दैनिक लक्ष्य पूरा होते ही आदत पूरी मानी जाती है (100 %)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando raggiungi l’obiettivo giornaliero, l’abitudine risulta completata (100 %)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の目標に達すると、習慣は完了（100 %）になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 목표에 도달하면 습관이 완료(100 %)로 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereik je je dagdoel, dan geldt de gewoonte als voltooid (100 %)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po osiągnięciu celu dziennego nawyk uznaje się za wykonany (100 %)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao atingires o objetivo diário, o hábito conta como concluído (100 %)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao atingir a meta diária, o hábito conta como concluído (100 %)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты достигаешь цели на день, привычка считается выполненной (100 %)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük hedefe ulaştığında alışkanlık tamamlanmış sayılır (%100)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到每日目标后，该习惯即视为完成（100 %）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到每日目標後，該習慣即視為完成（100 %）。"
          }
        }
      }
    },
    "tracking.settings.days.example": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fällig am %@. An allen anderen Tagen hast du frei – dein Streak läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due on %@. You are free on all other days – your streak continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence el %@. Tienes libre los demás días – tu racha continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À faire le %@. Vous êtes libre tous les autres jours – votre série continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को देय। आप अन्य सभी दिनों में स्वतंत्र हैं - आपका स्ट्रीक जारी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scade il %@. Sei libero tutti gli altri giorni – la tua serie continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が期限です。他のすべての日はお休みです - 連続記録は継続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 마감입니다. 다른 날은 쉬는 날입니다 - 연속 기록은 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervalt op %@. Je bent vrij op alle andere dagen - je reeks gaat door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Termin: %@. We wszystkie inne dni masz wolne – twoja passa trwa nadal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence em %@. Você está livre em todos os outros dias – sua sequência continua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence em %@. Você está livre em todos os outros dias – sua sequência continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнить %@. Во все остальные дни вы свободны – ваша серия продолжается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tarih: %@. Diğer tüm günler boşsunuz – seriniz devam ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期日：%@。您在所有其他日子都空闲——您的连胜记录继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期日：%@。您在所有其他日子都空閒——您的連勝記錄繼續。"
          }
        }
      }
    },
    "tracking.settings.days.example.daily": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Tag fällig – ein verpasster Tag beendet deinen Streak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Due every day – a missed day ends your streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence todos los días – un día perdido termina tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À faire tous les jours – un jour manqué met fin à votre série."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन देय – एक छूटा हुआ दिन आपके स्ट्रीक को समाप्त कर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scade ogni giorno – un giorno perso termina la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日が期限です – 1 日休むと連続記録が終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 마감 – 하루를 놓치면 연속 기록이 종료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke dag vervallen – een gemiste dag beëindigt je reeks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Należy wykonać codziennie – opuszczony dzień kończy twoją passę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence todos os dias – um dia perdido termina sua sequência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence todos os dias – um dia perdido termina sua sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнять каждый день – пропущенный день прерывает вашу серию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün yapılması gerekiyor - kaçırılan bir gün serinizi sonlandırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天到期——错过一天就会结束您的连胜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天到期——錯過一天就會結束您的連勝。"
          }
        }
      }
    },
    "tracking.settings.days.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An freien Tagen wird die Gewohnheit ausgeblendet und dein Streak bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days off, the habit is hidden and your streak stays intact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los días libres, el hábito se oculta y tu racha se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours de repos, l’habitude est masquée et ta série est conservée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छुट्टी के दिनों में आदत छिपी रहती है और आपकी स्ट्रीक बनी रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei giorni liberi l’abitudine viene nascosta e la tua serie resta intatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休みの日は習慣が非表示になり、ストリークは途切れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬는 날에는 습관이 숨겨지고 연속 기록이 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op vrije dagen wordt de gewoonte verborgen en blijft je reeks behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dni wolne nawyk jest ukryty, a Twoja seria zostaje zachowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos dias de folga, o hábito fica oculto e a tua sequência mantém-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos dias de folga, o hábito fica oculto e sua sequência é mantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В свободные дни привычка скрыта, а твоя серия сохраняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin günlerinde alışkanlık gizlenir ve serin korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在休息日，该习惯会被隐藏，你的连续记录不会中断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在休息日，該習慣會被隱藏，你的連續紀錄不會中斷。"
          }
        }
      }
    },

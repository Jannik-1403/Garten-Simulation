          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo inizio! Continua a costruire la tua serie di %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u305f\u306a\u30b9\u30bf\u30fc\u30c8\uff01 %d \u306e\u9023\u7d9a\u8a18\u9332\u3092\u7bc9\u304d\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c8\ub85c\uc6b4 \uc2dc\uc791! %d \uc5f0\uc18d \uc5f0\uc18d \uae30\ub85d\uc744 \uacc4\uc18d \uc313\uc544\ubcf4\uc138\uc694."

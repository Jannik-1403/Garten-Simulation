    "notification.morning.1.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit f\u00fcr Gewohnheiten! Dein h\u00f6chster Streak ist %d. Lass uns weiter wachsen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for habits! Your highest streak is %d. Let's keep growing!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Hora de los h\u00e1bitos! Tu mejor racha es %d. \u00a1Sigamos creciendo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure des habitudes ! Ta meilleure s\u00e9rie est %d. Continuons \u00e0 grandir !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0926\u0924\u094b\u0902 \u0915\u093e \u0938\u092e\u092f! \u0906\u092a\u0915\u0940 \u0909\u091a\u094d\u091a\u0924\u092e \u0938\u094d\u091f\u094d\u0930\u0940\u0915%d\u0939\u0948\u0964 \u0906\u0907\u090f \u092c\u0922\u093c\u0924\u0947 \u0930\u0939\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c8 l'ora delle abitudini! La tua serie migliore \u00e8 %d. Continuiamo a crescere!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7fd2\u6163\u306e\u6642\u9593\u3067\u3059\uff01\u3042\u306a\u305f\u306e\u6700\u9ad8\u9023\u7d9a\u8a18\u9332\u306f %d \u3067\u3059\u3002\u3053\u308c\u304b\u3089\u3082\u6210\u9577\u3057\u3066\u3044\u304d\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2b5\uad00\uc774 \ud544\uc694\ud55c \uc2dc\uac04! \uac00\uc7a5 \ub192\uc740 \uc5f0\uc18d \uae30\ub85d\uc740 %d\uc785\ub2c8\ub2e4. \uacc4\uc18d \uc131\uc7a5\ud558\uc790!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd voor gewoontes! Je hoogste reeks is %d. Laten we blijven groeien!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas na nawyki! Twoja najwy\u017csza passa to %d. Rozwijajmy si\u0119 dalej!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora dos h\u00e1bitos! O teu melhor streak \u00e9 %d. Vamos continuar a crescer!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a! \u0422\u0432\u043e\u044f \u0441\u0430\u043c\u0430\u044f \u0434\u043b\u0438\u043d\u043d\u0430\u044f \u0441\u0435\u0440\u0438\u044f \u2013%d. \u0414\u0430\u0432\u0430\u0439 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0440\u0430\u0441\u0442\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Al\u0131\u015fkanl\u0131k zaman\u0131! En y\u00fcksek seriniz %d. B\u00fcy\u00fcmeye devam edelim!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u662f\u65f6\u5019\u517b\u6210\u4e60\u60ef\u4e86\uff01\u4f60\u7684\u6700\u9ad8\u8fde\u51fb\u662f %d\u3002\u8ba9\u6211\u4eec\u7ee7\u7eed\u6210\u957f\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u662f\u6642\u5019\u990a\u6210\u7fd2\u6163\u4e86\uff01\u60a8\u7684\u6700\u9ad8\u7d00\u9304\u662f%d\u3002\u8b93\u6211\u5011\u7e7c\u7e8c\u6210\u9577\u5427\uff01"
          }
        }
      }
    },

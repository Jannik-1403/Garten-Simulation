    "backup_export_hint" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deinen Fortschritt als .gartensave Datei. Du kannst sie auf anderen Geräten importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your progress as a .gartensave file. You can import it on other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu progreso como archivo .gartensave. Puedes importarlo en otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde ta progression dans un fichier .gartensave. Tu peux l'importer sur d'autres appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी प्रगति को .gartensave फ़ाइल के रूप में सहेजें। आप उन्हें अन्य डिवाइस पर आयात कर सकते हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your progress as a .gartensave file. You can import it on other devices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況を .gartensave ファイルとして保存します。他のデバイスにインポートできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 상황을 .gartensave 파일로 저장하세요. 다른 장치로 가져올 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla uw voortgang op als een .gartensave-bestand. U kunt het op andere apparaten importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz swoje postępy jako plik .gartensave. Możesz zaimportować go na inne urządzenia."

    "body.tracking.need_more_data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen mehr Daten. Trage dein Gewicht regelmäßig ein, um hier deinen biologisch korrekten Wochentrend (Ø zu Ø) zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need more data. Log your weight regularly to see your biologically accurate weekly trend here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos más datos. Registra tu peso regularmente para ver tu tendencia semanal biológicamente precisa aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin de plus de données. Entrez régulièrement votre poids pour voir votre tendance hebdomadaire biologiquement correcte (Ø à Ø)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें और डेटा चाहिए. अपनी जैविक रूप से सही साप्ताहिक प्रवृत्ति (Ø से Ø) देखने के लिए नियमित रूप से अपना वजन दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo bisogno di più dati. Inserisci regolarmente il tuo peso per vedere il tuo andamento settimanale biologicamente corretto (da Ø a Ø)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに多くのデータが必要です。定期的に体重を入力して、生物学的に正しい週ごとの傾向 (Ø から Ø) を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 많은 데이터가 필요합니다. 체중을 정기적으로 입력하여 생물학적으로 정확한 주간 추세(Ø~Ø)를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben meer gegevens nodig. Voer regelmatig uw gewicht in om uw biologisch correcte wekelijkse trend (Ø tot Ø) te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebujemy więcej danych. Regularnie wprowadzaj swoją wagę, aby zobaczyć biologicznie prawidłowy tygodniowy trend (od Ø do Ø)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos de mais dados. Insira seu peso regularmente para ver sua tendência semanal biologicamente correta (Ø a Ø)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos de mais dados. Insira seu peso regularmente para ver sua tendência semanal biologicamente correta (Ø a Ø)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам нужно больше данных. Регулярно вводите свой вес, чтобы увидеть биологически правильный недельный тренд (от Ø до Ø)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla veriye ihtiyacımız var. Biyolojik olarak doğru haftalık eğiliminizi (Ø ila Ø) görmek için kilonuzu düzenli olarak girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要更多数据。定期输入您的体重，以查看您的生物学正确的每周趋势（Ø 到 Ø）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們需要更多數據。定期輸入您的體重，以查看您的生物學正確的每週趨勢（Ø 到 Ø）。"
          }
        }
      }
    },

    "pfad_produktiv_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite heute 25 Minuten ohne Ablenkung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work for 25 minutes without distraction today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja hoy 25 minutos sin distracciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaille 25 minutes sans distraction aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u092c\u093f\u0928\u093e \u0927\u094d\u092f\u093e\u0928 \u092d\u091f\u0915\u093e\u090f 25 \u092e\u093f\u0928\u091f \u0924\u0915 \u0915\u093e\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora per 25 minuti senza distrazioni oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u6c17\u3092\u6563\u3089\u3055\u305a\u306b 25 \u5206\u9593\u4ed5\u4e8b\u3092\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \ubc29\ud574\ubc1b\uc9c0 \uc54a\uace0 25\ubd84 \ub3d9\uc548 \uc77c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk vandaag 25 minuten zonder afleiding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuj dzisiaj przez 25 minut bez rozpraszania uwagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha 25 minutos sem distra\u00e7\u00e3o hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0431\u043e\u0442\u0430\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f 25 \u043c\u0438\u043d\u0443\u0442 \u0431\u0435\u0437 \u043e\u0442\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn dikkatiniz da\u011f\u0131lmadan 25 dakika \u00e7al\u0131\u015f\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u4e13\u6ce8\u5de5\u4f5c25\u5206\u949f\uff0c\u4e0d\u53d7\u5e72\u6270\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u5fc3\u7121\u65c1\u9a16\u5730\u5de5\u4f5c 25 \u5206\u9418\u3002"
          }
        }
      }
    },

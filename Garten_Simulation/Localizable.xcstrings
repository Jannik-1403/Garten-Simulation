    "assessment.mental.profile.spiegel.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entkopple deinen Wert von der Meinung anderer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decouple your value from the opinions of others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desacopla tu valor de las opiniones de los dem\u00e1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9couplez votre valeur des opinions des autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092e\u0942\u0932\u094d\u092f \u0915\u094b \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u0940 \u0930\u093e\u092f \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disaccoppia il tuo valore dalle opinioni degli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u4fa1\u5024\u3092\u4ed6\u4eba\u306e\u610f\u898b\u304b\u3089\u5207\u308a\u96e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uac00\uce58\ub97c \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \uc758\uacac\uacfc \ubd84\ub9ac\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontkoppel uw waarde van de mening van anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddziel swoj\u0105 warto\u015b\u0107 od opinii innych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe o seu valor das opini\u00f5es dos outros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0434\u0435\u043b\u0438 \u0441\u0432\u043e\u044e \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043e\u0442 \u043c\u043d\u0435\u043d\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "De\u011ferinizi ba\u015fkalar\u0131n\u0131n g\u00f6r\u00fc\u015flerinden ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u4f60\u7684\u4ef7\u503c\u4e0e\u4ed6\u4eba\u7684\u610f\u89c1\u5206\u5f00\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u4f60\u7684\u50f9\u503c\u8207\u4ed6\u4eba\u7684\u610f\u898b\u812b\u9264\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.spiegel.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Poste ein Bild auf Social Media ohne jeglichen Filter oder Bearbeitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post a picture on social media without any filter or editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publica una imagen en las redes sociales sin ning\u00fan filtro ni edici\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiez une photo sur les r\u00e9seaux sociaux sans aucun filtre ni modification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u092f\u093e \u0938\u0902\u092a\u093e\u0926\u0928 \u0915\u0947 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u092a\u0930 \u090f\u0915 \u0924\u0938\u094d\u0935\u0940\u0930 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblica una foto sui social media senza alcun filtro o modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a3\u30eb\u30bf\u30fc\u3084\u7de8\u96c6\u3092\u305b\u305a\u306b\u5199\u771f\u3092\u30bd\u30fc\u30b7\u30e3\u30eb \u30e1\u30c7\u30a3\u30a2\u306b\u6295\u7a3f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud544\ud130\ub098 \ud3b8\uc9d1 \uc5c6\uc774 \uc18c\uc15c \ubbf8\ub514\uc5b4\uc5d0 \uc0ac\uc9c4\uc744 \uac8c\uc2dc\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats een foto op sociale media zonder enige filter of bewerking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opublikuj zdj\u0119cie w mediach spo\u0142eczno\u015bciowych bez \u017cadnych filtr\u00f3w i edycji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Poste uma foto nas redes sociais sem nenhum filtro ou edi\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0439 \u0444\u043e\u0442\u043e \u0432 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0442\u044f\u0445 \u0431\u0435\u0437 \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432 \u0438\u043b\u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir filtre veya d\u00fczenleme yapmadan bir resmi sosyal medyada yay\u0131nlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u53d1\u5e03\u4e00\u5f20\u6ca1\u6709\u4efb\u4f55\u6ee4\u955c\u6216\u7f16\u8f91\u7684\u56fe\u7247\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u793e\u7fa4\u5a92\u9ad4\u4e0a\u767c\u5e03\u5716\u7247\uff0c\u7121\u9700\u4efb\u4f55\u904e\u6ffe\u6216\u7de8\u8f2f\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.spiegel.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sage jeden Tag zu einer winzigen, absolut unwichtigen Anfrage 'Nein', nur um die Ablehnung zu \u00fcben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say \"no\" to a tiny, absolutely unimportant request every day just to practice rejection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di \"no\" a una peque\u00f1a petici\u00f3n, absolutamente sin importancia, todos los d\u00edas s\u00f3lo para practicar el rechazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites \u00ab\u00a0non\u00a0\u00bb chaque jour \u00e0 une petite demande absolument sans importance, juste pour vous entra\u00eener au rejet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0915\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0930 \u0926\u093f\u0928 \u090f\u0915 \u091b\u094b\u091f\u0947, \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092e\u0939\u0924\u094d\u0935\u0939\u0940\u0928 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u094b \"\u0928\u0939\u0940\u0902\" \u0915\u0939\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' \"no\" ogni giorno a una piccola richiesta assolutamente insignificante solo per esercitarti nel rifiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65ad\u308b\u7df4\u7fd2\u3092\u3059\u308b\u305f\u3081\u306b\u3001\u5c0f\u3055\u306a\u3001\u307e\u3063\u305f\u304f\u91cd\u8981\u3067\u306f\u306a\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u306b\u306f\u6bce\u65e5\u300c\u30ce\u30fc\u300d\u3068\u8a00\u3044\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac70\uc808\uc744 \uc5f0\uc2b5\ud558\uae30 \uc704\ud574 \ub9e4\uc77c \uc0ac\uc18c\ud558\uace0 \uc804\ud600 \uc911\uc694\ud558\uc9c0 \uc54a\uc740 \uc694\uccad\uc5d0 \"\uc544\ub2c8\uc624\"\ub77c\uace0 \ub9d0\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg elke dag 'nee' tegen een klein, absoluut onbelangrijk verzoek, alleen maar om afwijzing te oefenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codziennie m\u00f3w \u201enie\u201d drobnej, absolutnie nieistotnej pro\u015bbie, aby po\u0107wiczy\u0107 odmow\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga \u201cn\u00e3o\u201d a um pedido min\u00fasculo e absolutamente sem import\u00e2ncia todos os dias apenas para praticar a rejei\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0433\u043e\u0432\u043e\u0440\u0438 \u00ab\u043d\u0435\u0442\u00bb \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439, \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043d\u0435\u0432\u0430\u0436\u043d\u043e\u0439 \u043f\u0440\u043e\u0441\u044c\u0431\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043f\u0440\u0430\u043a\u0442\u0438\u043a\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u043e\u0442\u043a\u0430\u0437\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131rf reddetme al\u0131\u015ft\u0131rmas\u0131 yapmak i\u00e7in her g\u00fcn k\u00fc\u00e7\u00fck, kesinlikle \u00f6nemsiz bir iste\u011fe \"hay\u0131r\" deyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u5bf9\u4e00\u4e2a\u5fae\u5c0f\u3001\u7edd\u5bf9\u4e0d\u91cd\u8981\u7684\u8bf7\u6c42\u8bf4\u201c\u4e0d\u8981\u201d\uff0c\u53ea\u662f\u4e3a\u4e86\u7ec3\u4e60\u62d2\u7edd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u5c0d\u4e00\u500b\u5fae\u5c0f\u7684\u3001\u7d55\u5c0d\u4e0d\u91cd\u8981\u7684\u8acb\u6c42\u8aaa\u201c\u4e0d\u201d\uff0c\u53ea\u662f\u70ba\u4e86\u7df4\u7fd2\u62d2\u7d55\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.spiegel.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Selbstwert ist fremdgesteuert. Um Unabh\u00e4ngigkeit aufzubauen, musst du den 'Muskel der Ablehnung' in hom\u00f6opathischen Dosen trainieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your self-worth is externally controlled. To build independence, you need to train the 'rejection muscle' in homeopathic doses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu autoestima est\u00e1 controlada externamente. Para desarrollar la independencia, es necesario entrenar el \"m\u00fasculo del rechazo\" en dosis homeop\u00e1ticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre estime de soi est contr\u00f4l\u00e9e de l\u2019ext\u00e9rieur. Pour d\u00e9velopper votre ind\u00e9pendance, vous devez entra\u00eener le \u00ab muscle du rejet \u00bb \u00e0 des doses hom\u00e9opathiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0906\u0924\u094d\u092e-\u0938\u092e\u094d\u092e\u093e\u0928 \u092c\u093e\u0939\u0930\u0940 \u0930\u0942\u092a \u0938\u0947 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b \u0939\u094b\u092e\u094d\u092f\u094b\u092a\u0948\u0925\u093f\u0915 \u0916\u0941\u0930\u093e\u0915 \u092e\u0947\u0902 '\u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u0940' \u0915\u094b \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua autostima \u00e8 controllata dall\u2019esterno. Per costruire l'indipendenza, \u00e8 necessario allenare il \"muscolo del rigetto\" in dosi omeopatiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u81ea\u5c0a\u5fc3\u306f\u5916\u90e8\u304b\u3089\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3055\u308c\u307e\u3059\u3002\u81ea\u7acb\u5fc3\u3092\u7bc9\u304f\u306b\u306f\u3001\u30db\u30e1\u30aa\u30d1\u30b7\u30fc\u306e\u7528\u91cf\u3067\u300c\u62d2\u7d76\u7b4b\u300d\u3092\u935b\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc790\uc874\uac10\uc740 \uc678\ubd80\uc801\uc73c\ub85c \ud1b5\uc81c\ub429\ub2c8\ub2e4. \ub3c5\ub9bd\uc131\uc744 \ud0a4\uc6b0\ub824\uba74 \ub3d9\uc885\uc694\ubc95 \ubcf5\uc6a9\ub7c9\uc73c\ub85c '\uac70\ubd80 \uadfc\uc721'\uc744 \ud6c8\ub828\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigenwaarde wordt extern gecontroleerd. Om onafhankelijkheid op te bouwen, moet je de \u2018afstotingsspier\u2019 trainen in homeopathische doses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja samoocena jest kontrolowana z zewn\u0105trz. Aby zbudowa\u0107 niezale\u017cno\u015b\u0107, trzeba \u0107wiczy\u0107 \u201emi\u0119sie\u0144 odrzucaj\u0105cy\u201d w dawkach homeopatycznych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua autoestima \u00e9 controlada externamente. Para construir independ\u00eancia, \u00e9 preciso treinar o \u201cm\u00fasculo da rejei\u00e7\u00e3o\u201d em doses homeop\u00e1ticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u044f \u0441\u0430\u043c\u043e\u043e\u0446\u0435\u043d\u043a\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u0437\u0432\u043d\u0435. \u0427\u0442\u043e\u0431\u044b \u043e\u0431\u0440\u0435\u0441\u0442\u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u044c, \u0442\u0435\u0431\u0435 \u043d\u0443\u0436\u043d\u043e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c '\u043c\u044b\u0448\u0446\u0443 \u043e\u0442\u043a\u0430\u0437\u0430' \u0432 \u0433\u043e\u043c\u0435\u043e\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0434\u043e\u0437\u0430\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinize verdi\u011finiz de\u011fer d\u0131\u015far\u0131dan kontrol edilir. Ba\u011f\u0131ms\u0131zl\u0131\u011f\u0131 in\u015fa etmek i\u00e7in 'reddetme kas\u0131n\u0131' homeopatik dozlarda \u00e7al\u0131\u015ft\u0131rman\u0131z gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u81ea\u6211\u4ef7\u503c\u662f\u88ab\u4ed6\u4eba\u63a7\u5236\u7684\u3002\u4e3a\u4e86\u5efa\u7acb\u72ec\u7acb\u6027\uff0c\u4f60\u5fc5\u987b\u4ee5\u5fae\u91cf\u7684\u65b9\u5f0f\u953b\u70bc\u201c\u62d2\u7edd\u7684\u808c\u8089\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u81ea\u6211\u50f9\u503c\u662f\u7531\u5916\u5728\u63a7\u5236\u7684\u3002\u70ba\u4e86\u5efa\u7acb\u7368\u7acb\u6027\uff0c\u60a8\u9700\u8981\u4ee5\u9806\u52e2\u7642\u6cd5\u5291\u91cf\u8a13\u7df4\u300c\u62d2\u7d55\u808c\u8089\u300d\u3002"
          }
        }
      }
    },

            "value": "Kuchnia i zlew"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinha e pia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinha e pia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кухня и раковина"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutfak ve lavabo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "厨房和水槽"
          }

    "settings.reset.final.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ist dann unwiderruflich weg. Die App startet danach komplett neu mit dem Onboarding."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything will be gone forever. The app will restart from the onboarding."
          }
        },
        "es": {

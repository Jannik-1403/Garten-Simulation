    "plant.weinrebe.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein klarer Kopf und mehr Energie durch den Verzicht auf Alkohol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clear head and more energy by avoiding alcohol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente clara y más energía evitando el alcohol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esprit clair et plus d'énergie en évitant l'alcool."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शराब का त्याग करके स्पष्ट सोच और अधिक ऊर्जा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente chiara e più energia evitando l'alcol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルコールを避けることで、頭がすっきりし、エネルギーが増します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "술을 피함으로써 맑은 머리와 더 많은 에너지를 얻으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een helder hoofd en meer energie door alcohol te vermijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasny umysł i więcej energii dzięki unikaniu alkoholu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mente clara e mais energia evitando o álcool."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mente clara e mais energia evitando o álcool."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ясная голова и больше энергии благодаря отказу от алкоголя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkol almayarak berrak bir zihin ve daha fazla enerji elde edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "戒酒带来清醒的头脑和更多的精力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免飲酒，頭腦清醒，精力充沛。"
          }
        }
      }
    },
    "plant.weizenfeld.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele kleine Ähren = große Ernte – Deep Work"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many small ears = big harvest – Deep Work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchas espigas = gran cosecha – Trabajo profundo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de petits épis = grande récolte – Travail profond"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई छोटे बालियाँ = बड़ी फसल – डीप वर्क"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tante piccole spighe di grano = grande raccolto – lavoro profondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たくさんの小さな穂 = 大きな収穫 – Deep Work"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 작은 귀 = 큰 수확 – Deep Work"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel kleine oren = grote oogst – Diep werk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele małych kłosów = duże zbiory – Głęboka praca"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas espigas pequenas = grande colheita – Trabalho profundo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas espigas pequenas = grande colheita – Trabalho profundo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Много маленьких колосьев = большой урожай – Deep Work"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok sayıda küçük kulak = büyük hasat – Derin Çalışma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许多小麦穗 = 丰收 – 深度工作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "許多小穗=大收穫-深耕"
          }
        }
      }
    },

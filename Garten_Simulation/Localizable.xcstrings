    "prog_screentime_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dir deine Wochenstatistik an. Wo hast du die meiste Zeit verbrannt? Wo lief es besser?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at your weekly statistics. Where did you spend most of your time burning? Where did things go better?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira tus estadísticas semanales. ¿Dónde pasaste la mayor parte de tu tiempo ardiendo? ¿Dónde fueron mejor las cosas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez vos statistiques hebdomadaires. Où avez-vous passé le plus clair de votre temps à brûler ? Où les choses se sont-elles mieux passées ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने साप्ताहिक आँकड़े देखें। आपने अपना अधिकांश समय जलने में कहाँ बिताया? कहां चीजें बेहतर हुईं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda le tue statistiche settimanali. Dove hai passato la maggior parte del tuo tempo a bruciare? Dove sono andate meglio le cose?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週の統計を見てください。燃焼に最も多くの時間を費やしたのはどこですか?どこがうまくいきましたか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 통계를 살펴보세요. 주로 어디에서 시간을 보내셨나요? 어디가 좋아졌나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar je wekelijkse statistieken. Waar bracht u het grootste deel van uw tijd door met branden? Waar ging het beter?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spójrz na swoje cotygodniowe statystyki. Gdzie spędziłeś najwięcej czasu, paląc? Gdzie poszło lepiej?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja suas estatísticas semanais. Onde você passou a maior parte do tempo queimando? Onde as coisas correram melhor?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja suas estatísticas semanais. Onde você passou a maior parte do tempo queimando? Onde as coisas correram melhor?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите на свою еженедельную статистику. Где вы проводили большую часть времени, сжигая? Где дела пошли лучше?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık istatistiklerinize bakın. Zamanınızın çoğunu nerede yanarak geçirdiniz? İşler nerede daha iyi gitti?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你每周的统计数据。你大部分时间都花在哪里燃烧？哪里事情变得更好了？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你每週的統計數據。你大部分時間都花在哪裡燃燒？哪裡事情變得更好了？"
          }
        }
      }
    },

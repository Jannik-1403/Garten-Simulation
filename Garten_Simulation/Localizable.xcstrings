    "support.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe dein Anliegen so genau wie m\u00f6glich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your request as precisely as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe dein Anliegen so genau wie m\u00f6glich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9cris ta demande aussi pr\u00e9cis\u00e9ment que possible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 Anliegen \u0915\u094b \u092f\u0925\u093e\u0938\u0902\u092d\u0935 \u0938\u091f\u0940\u0915 \u0930\u0942\u092a \u0938\u0947 \u092c\u0924\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your request as precisely as possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u3067\u304d\u308b\u3060\u3051\u6b63\u78ba\u306b\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadc0\ud558\uc758 \uc694\uccad\uc744 \uac00\ub2a5\ud55c \ud55c \uc815\ud655\ud558\uac8c \uc124\uba85\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf uw verzoek zo nauwkeurig mogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz swoj\u0105 pro\u015bb\u0119 mo\u017cliwie najdok\u0142adniej."

    "item.zauberstab.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und lässt Unkraut wie von Geisterhand verschwinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and makes weeds disappear as if by magic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa de inmediato y hace desaparecer las malas hierbas como por arte de magia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\\'active immédiatement et fait disparaître les mauvaises herbes comme par enchantement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत सक्रिय हो जाता है और खर-पतवार को जादू की तरह गायब कर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si attiva immediatamente e fa sparire le erbacce come per magia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに活性化して、まるで魔法のように雑草を消し去ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 활성화되어 마법처럼 잡초를 사라지게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt direct actief en laat onkruid als bij toverslag verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast staje się aktywny i sprawia, że ​​chwasty znikają jak za dotknięciem czarodziejskiej różdżki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e faz as ervas daninhas desaparecer como por magia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e faz as ervas daninhas desaparecer como por magia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Становится активным сразу и заставляет сорняки исчезать, как рукой сняло."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve yabani otların sanki sihirli bir değnekmiş gibi yok olmasını sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，让杂草像被魔法般消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即變得活躍，使雜草神奇地消失。"
          }
        }
      }
    },
    "item.zeitkapsel.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Friert eine Pflanze ein – kein Verfall für 3 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freezes a plant – no decay for 3 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela una planta – sin deterioro durante 3 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gèle une plante – pas de dégradation pendant 3 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पौधे को जमा देता है - 3 दिनों तक कोई क्षय नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela una pianta: nessuna decomposizione per 3 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物を凍結します – 3日間腐敗しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물을 얼리면 3일 동안 부패하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevriest een plant – geen verval gedurende 3 dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamraża roślinę – brak rozkładu przez 3 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela uma planta – sem degradação durante 3 dias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela uma planta – sem degradação durante 3 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если растение замерзает – запрет на увядание на 3 дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkiyi dondurur – 3 gün boyunca çürüme olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结一株植物 – 3天内不会枯萎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "冷凍植物 - 3 天內不腐爛。"
          }
        }
      }
    },

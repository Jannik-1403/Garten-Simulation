        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque paraste de usar a aplica\u00e7\u00e3o?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0442\u044b \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c?"

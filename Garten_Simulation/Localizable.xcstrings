      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere deine Bildschirmzeit für mehr Achtsamkeit im Alltag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce your screen time for more mindfulness in everyday life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce tu tiempo de pantalla para más atención plena en la vida diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez votre temps d'écran pour plus de pleine conscience au quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने रोजमर्रा के जीवन में अधिक सचेतनता के लिए अपना स्क्रीन समय कम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci il tempo trascorso davanti allo schermo per una maggiore consapevolezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を見ている時間を減らして、日常生活でのマインドフルネスを高めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상 생활의 마음챙김을 위해 화면 시간을 줄이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder je schermtijd voor meer mindfulness in het dagelijks leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz czas spędzany przed ekranem, by zyskać więcej uważności w życiu codziennym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza seu tempo de tela para mais atenção plena no dia a dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza seu tempo de tela para mais atenção plena no dia a dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сократи время, проведённое перед экраном, для большей осознанности в повседневной жизни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük yaşamda daha fazla farkındalık için ekran sürenizi azaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少屏幕时间，在日常生活中更加专注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少看螢幕的時間，讓日常生活更專注。"
          }
        }
      }
    },
    "plant.apfelbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 1 = Kern, Level 10 = voller Baum. Klassisch gesund"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 1 = seed, Level 10 = full tree. Classic health"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel 1 = semilla, Nivel 10 = árbol completo. Salud clásica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau 1 = graine, Niveau 10 = arbre entier. Santé classique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्तर 1 = कोर, स्तर 10 = पूर्ण वृक्ष। शास्त्रीय रूप से स्वस्थ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livello 1 = nucleo, livello 10 = albero completo. Classicamente sano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベル 1 = シード、レベル 10 = 完全なツリー。古典的な健康"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨 1 = 시드, 레벨 10 = 전체 트리. 클래식 건강"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau 1 = zaad, Niveau 10 = volledige boom. Klassieke gezondheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom 1 = nasiono, Poziom 10 = pełne drzewo. Klasyczne zdrowie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível 1 = semente, Nível 10 = árvore completa. Saúde clássica"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nível 1 = semente, Nível 10 = árvore completa. Saúde clássica"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень 1 = ядро, уровень 10 = полное дерево. Классически здорово"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seviye 1 = tohum, Seviye 10 = tam ağaç. Klasik sağlık"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等级 1 = 种子，等级 10 = 完整树木。经典健康"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等級 1 = 核心，等級 10 = 完整樹。 Classically healthy"
          }
        }
      }
    },

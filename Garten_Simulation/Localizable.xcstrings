          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I was dominated by other people and never lived my own life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaba dominada por otras personas y nunca viví mi propia vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'étais dominé par les autres et je n'ai jamais vécu ma propre vie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुझ पर अन्य लोगों का प्रभुत्व था और मैंने कभी अपना जीवन नहीं जिया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stato dominato da altre persone e non ho mai vissuto la mia vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は他人に支配され、自分の人生を生きたことはありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 다른 사람들에 의해 지배당했고 결코 내 자신의 삶을 살아본 적이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik werd gedomineerd door andere mensen en leefde nooit mijn eigen leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byłam zdominowana przez innych ludzi i nigdy nie żyłam własnym życiem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fui dominado por outras pessoas e nunca vivi minha própria vida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меня доминировали другие люди, и я никогда не жил своей собственной жизнью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başkalarının egemenliği altındaydım ve hiçbir zaman kendi hayatımı yaşamadım."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我被其他人支配，从未过自己的生活。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我被別人支配，從來沒有過自己的生活。"
          }
        }
      }
    },

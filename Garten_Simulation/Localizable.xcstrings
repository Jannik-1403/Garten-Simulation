    "fitness.sleep.detail.critical": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als 6 Stunden Schlaf beeinträchtigen Konzentration und Erholung. Heute früher ins Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleeping less than 6 hours affects concentration and recovery. To bed earlier today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir menos de 6 horas afecta la concentración y la recuperación. A dormir más temprano hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir moins de 6 heures affecte la concentration et la récupération. Au lit plus tôt dans la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 घंटे से कम सोने से एकाग्रता और रिकवरी पर असर पड़ता है। आज जल्दी सो जाना."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormire meno di 6 ore influisce sulla concentrazione e sul recupero. A letto presto oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠時間が6時間未満だと集中力や回復力に影響します。今日は早めに寝ましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleeping less than 6 hours affects concentration and recovery. 오늘은 일찍 자야지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder dan 6 uur slapen beïnvloedt de concentratie en het herstel. Vandaag eerder naar bed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen krótszy niż 6 godzin wpływa na koncentrację i regenerację. Dzisiaj spać wcześniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir menos de 6 horas afeta a concentração e a recuperação. Para dormir mais cedo hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir menos de 6 horas afeta a concentração e a recuperação. Para dormir mais cedo hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон менее 6 часов влияет на концентрацию и восстановление. Ложиться сегодня пораньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "6 saatten az uyumak konsantrasyonu ve toparlanmayı etkiler. Bugün erken yatmak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠少于 6 小时会影响注意力和恢复。今天早点睡觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠少於 6 小時會影響注意力和恢復。今天早點睡。"
          }
        }
      }
    },

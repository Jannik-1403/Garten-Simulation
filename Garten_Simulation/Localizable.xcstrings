    "notification.streak.3.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist schon %d Tage dabei! Lass es nicht umsonst gewesen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been at it for %d days! Don't let it be for nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Llevas %d d\u00edas en esto! No dejes que sea en vano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7a fait d\u00e9j\u00e0 %d jours ! Ne laisse pas \u00e7a \u00eatre pour rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0935\u0939\u093e\u0902%d\u0926\u093f\u0928\u094b\u0902 \u0938\u0947 \u0939\u0948\u0902! \u0907\u0938\u0947 \u0935\u094d\u092f\u0930\u094d\u0925 \u0928 \u091c\u093e\u0928\u0947 \u0926\u0947\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei gi\u00e0 a %d giorni! Non far s\u00ec che sia tutto inutile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d \u65e5\u9593\u7d9a\u3051\u3066\u3044\u307e\u3059!\u7121\u99c4\u306b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d\uc77c \ub3d9\uc548 \uc774 \uc77c\uc744 \ud558\uc168\uc2b5\ub2c8\ub2e4! \ud5db\ub41c \uc77c\uc774 \ub418\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent al %d dagen bezig! Laat het niet voor niets zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajmujesz si\u0119 tym od %d dni! Nie pozw\u00f3l, \u017ceby to posz\u0142o na marne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 est\u00e1s nisto h\u00e1 %d dias! N\u00e3o deixes que seja em v\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0443\u0436\u0435%d\u0434\u043d\u0435\u0439 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0448\u044c! \u041d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0439 \u044d\u0442\u043e\u043c\u0443 \u0431\u044b\u0442\u044c \u043d\u0430\u043f\u0440\u0430\u0441\u043d\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d g\u00fcnd\u00fcr bu i\u015ftesin! Bo\u015funa olmas\u0131na izin vermeyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u575a\u6301\u4e86 %d \u5929\uff01\u522b\u8ba9\u5b83\u767d\u8d39\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7d93\u5728\u90a3\u88e1\u5f85\u4e86%d\u5929\u4e86\uff01\u4e0d\u8981\u8b93\u5b83\u767d\u8cbb\u3002"
          }
        }
      }
    },

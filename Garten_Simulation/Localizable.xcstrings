    "onboarding_ziel_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist dein wichtigstes Ziel f\u00fcr diesen Garten?"

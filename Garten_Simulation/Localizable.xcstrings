    "plant.bambus_schilf.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflektiere deine Gedanken und halte wichtige Erlebnisse fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflect on your thoughts and capture important experiences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflexiona sobre tus pensamientos y captura experiencias importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9fl\u00e9chissez \u00e0 vos pens\u00e9es et capturez des exp\u00e9riences importantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0905\u0928\u0941\u092d\u0935 \u0930\u093f\u0915\u093e\u0930\u094d\u0921 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifletti sui tuoi pensieri e cattura esperienze importanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u8003\u3048\u3092\u632f\u308a\u8fd4\u308a\u3001\u91cd\u8981\u306a\u7d4c\u9a13\u3092\u8a18\u9332\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uac01\uc744 \ub418\ub3cc\uc544\ubcf4\uace0 \uc911\uc694\ud55c \uacbd\ud5d8\uc744 \uae30\ub85d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflecteer op je gedachten en leg belangrijke ervaringen vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastan\u00f3w si\u0119 nad swoimi my\u015blami i uchwy\u0107 wa\u017cne do\u015bwiadczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflita sobre seus pensamentos e capture experi\u00eancias importantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u043c\u044b\u0448\u043b\u044f\u0439 \u043e \u0441\u0432\u043e\u0438\u0445 \u043c\u044b\u0441\u043b\u044f\u0445 \u0438 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0439 \u0432\u0430\u0436\u043d\u044b\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fc\u015f\u00fcncelerinizi yans\u0131t\u0131n ve \u00f6nemli deneyimlerinizi kaydedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53cd\u601d\u4f60\u7684\u601d\u60f3\uff0c\u8bb0\u5f55\u91cd\u8981\u7684\u7ecf\u5386\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53cd\u601d\u4f60\u7684\u60f3\u6cd5\u4e26\u8a18\u9304\u91cd\u8981\u7684\u7d93\u9a57\u3002"
          }
        }
      }
    },
    "plant.bambus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4chst schnell, extrem stabil und schwer zu brechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows fast, extremely stable and hard to break"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece r\u00e1pido, extremadamente estable y dif\u00edcil de romper"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse vite, extr\u00eamement stable et difficile \u00e0 briser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0947\u091c\u0940 \u0938\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0948, \u092c\u0947\u0939\u0926 \u0938\u094d\u0925\u093f\u0930 \u0914\u0930 \u0924\u094b\u0921\u093c\u0928\u093e \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0939\u094b\u0924\u093e \u0939\u0948"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows fast, extremely stable and hard to break"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6210\u9577\u304c\u65e9\u304f\u3001\u975e\u5e38\u306b\u5b89\u5b9a\u3057\u3066\u304a\u308a\u3001\u58ca\u308c\u306b\u304f\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube60\ub974\uac8c \uc131\uc7a5\ud558\uace0 \ub9e4\uc6b0 \uc548\uc815\uc801\uc774\uba70 \uae68\uc9c0\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit snel, extreem stabiel en moeilijk te breken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015bnie szybko, niezwykle stabilnie i trudno z\u0142ama\u0107"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce r\u00e1pido, extremamente est\u00e1vel e dif\u00edcil de quebrar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u0442 \u0431\u044b\u0441\u0442\u0440\u043e, \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0439 \u0438 \u0442\u0440\u0443\u0434\u043d\u043e \u043b\u043e\u043c\u0430\u0435\u0442\u0441\u044f"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u0131zl\u0131 b\u00fcy\u00fcr, son derece sa\u011flamd\u0131r ve k\u0131r\u0131lmas\u0131 zordur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u957f\u8fc5\u901f\uff0c\u6781\u5176\u7a33\u5b9a\u4e14\u4e0d\u6613\u6298\u65ad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u9577\u901f\u5ea6\u5feb\uff0c\u6975\u5ea6\u7a69\u5b9a\uff0c\u4e0d\u6613\u65b7\u88c2"
          }
        }
      }
    },

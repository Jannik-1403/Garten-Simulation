        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡是商店！按一下“下一步”觀看。"
          }
        }
      }
    },
    "tour_streak_header_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Streak erhöht sich, wenn du jeden Tag alle deine Pflanzen einmal gießt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your streak increases when you water all your plants once every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha aumenta cuando riegas todas tus plantas una vez al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre séquence augmente lorsque vous arrosez toutes vos plantes une fois par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप हर दिन अपनी सभी पौधों को एक बार पानी देते हैं तो आपकी स्ट्रीक बढ़ जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua serie aumenta quando annaffi tutte le tue piante una volta al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日すべての植物に一度水をやると連続記録が増加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 모든 식물에 한 번씩 물을 주면 연속 기록이 증가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je streak neemt toe wanneer je al je planten één keer per dag water geeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja passa rośnie, gdy codziennie raz podlewasz wszystkie swoje rośliny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência aumenta quando você rega todas as suas plantas uma vez por dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência aumenta quando você rega todas as suas plantas uma vez por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша результативность увеличится, если вы будете поливать все растения один раз в день."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün tüm bitkilerinizi bir kez suladığınızda seriniz artar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您每天给所有植物浇水一次，您的连续浇水次数将会增加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您每天給所有植物澆水一次，您的連續澆水次數將會增加。"
          }
        }
      }
    },

          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik trek het gewicht omhoog met een absoluut vreselijke vorm om er sterk uit te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podciągam ciężary w absolutnie okropnej formie, żeby wyglądać na silnego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu levanto o peso de uma forma absolutamente terrível para parecer forte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я поднимаю вес с абсолютно ужасной техникой, чтобы выглядеть сильным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

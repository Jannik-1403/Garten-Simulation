    "assessment.mental.q2" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist extrem erschöpft und hast dir den Abend für dich geblockt. Ein entfernter Bekannter fragt, ob du ihm bei einem banalen Problem hilfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are extremely exhausted and have blocked out the evening for yourself. A distant acquaintance asks if you can help him with a trivial problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás extremadamente agotado y has bloqueado la noche para ti. Un conocido lejano te pregunta si puedes ayudarlo con un problema trivial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes extrêmement épuisé et avez réservé la soirée pour vous-même. Une connaissance lointaine vous demande si vous pouvez l'aider à résoudre un problème insignifiant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बेहद थके हुए हैं और आपने शाम को अपने लिए रोक लिया है। एक दूर का परिचित पूछता है कि क्या आप उसकी एक छोटी सी समस्या में मदद कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei estremamente esausto e hai bloccato la serata per te stesso. Un lontano conoscente ti chiede se puoi aiutarlo con un problema banale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは極度に疲れきっていて、夜を自分のために費やしてしまいました。遠方の知人から、些細な問題で助けてもらえないかと頼まれました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 극도로 지쳐서 저녁 시간을 스스로 막았습니다. 먼 지인이 사소한 문제를 도와줄 수 있는지 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent extreem uitgeput en hebt de avond voor jezelf geblokkeerd. Een verre kennis vraagt ​​of je hem kunt helpen met een triviaal probleem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś skrajnie wyczerpany i masz zarezerwowany wieczór dla siebie. Daleki znajomy pyta, czy możesz mu pomóc w trywialnym problemie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está extremamente exausto e bloqueou a noite para si mesmo. Um conhecido distante pergunta se você pode ajudá-lo com um problema trivial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты крайне уставший и забронировал вечер для себя. Дальний знакомый спрашивает, поможешь ли ты ему с банальной проблемой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son derece yorgunsunuz ve akşamı kendinize ayırdınız. Uzak bir tanıdık ona önemsiz bir sorunda yardım edip edemeyeceğinizi soruyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你极度疲惫，并为自己留出了晚上。一位不太熟悉的熟人问你，是否能帮他解决一个琐碎的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已經非常疲憊了，並且已經為自己安排了一個晚上。一位遠方的熟人問你是否可以幫他解決一個小問題。"
          }
        }
      }
    },
    "assessment.mental.q2.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {

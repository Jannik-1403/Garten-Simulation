    "plant.kaktus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dcberlebt extremste Bedingungen \u2013 Kalt duschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Survives extreme conditions \u2013 Cold showers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive condiciones extremas \u2013 Duchas fr\u00edas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survit dans des conditions extr\u00eames \u2013 Douches froides"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0924\u094d\u092f\u0902\u0924 \u0915\u0920\u093f\u0928 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u091c\u0940\u0935\u093f\u0924 \u0930\u0939\u0947\u0902 \u2013 \u0920\u0902\u0921\u0947 \u092a\u093e\u0928\u0940 \u0938\u0947 \u0928\u0939\u093e\u0928\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Survives extreme conditions \u2013 Cold showers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6975\u7aef\u306a\u6761\u4ef6 \u2013 \u51b7\u6c34\u30b7\u30e3\u30ef\u30fc\u306b\u3082\u8010\u3048\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf9\ud55c \uc0c1\ud669\uc5d0\uc11c\ub3c4 \uc0dd\uc874 \u2013 \ucc2c\ubb3c \uc0e4\uc6cc"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overleeft extreme omstandigheden \u2013 Koude douches"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytrzymuje ekstremalne warunki \u2013 zimne prysznice"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive em condi\u00e7\u00f5es extremas \u2013 Duches frios"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0436\u0438\u0432\u0430\u0435\u0442 \u0432 \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u2013 \u0445\u043e\u043b\u043e\u0434\u043d\u044b\u0439 \u0434\u0443\u0448"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u015f\u0131r\u0131 ko\u015fullarda hayatta kal\u0131r \u2013 So\u011fuk du\u015flar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6781\u7aef\u6761\u4ef6\u4e0b\u751f\u5b58 \u2013 \u51b7\u6c34\u6dcb\u6d74"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6700\u6975\u7aef\u7684\u689d\u4ef6\u4e0b\u751f\u5b58\uff0d\u6d17\u51b7\u6c34\u6fa1"
          }
        }
      }
    },

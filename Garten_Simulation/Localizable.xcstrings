    "prog_gratitude_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Rückschlag aus der Vergangenheit hat dich am Ende stärker gemacht? Finde den Silberstreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What setback from the past made you stronger in the end? Find the silver lining."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué revés del pasado te hizo más fuerte al final? Encuentra el lado positivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel revers du passé vous a finalement rendu plus fort ? Trouvez le côté positif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अतीत के किस झटके ने आपको अंततः मजबूत बनाया? उम्मीद की किरण खोजें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale battuta d'arresto del passato ti ha reso più forte alla fine? Trova il lato positivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去のどんな挫折が最終的にあなたを強くしてくれましたか？希望の光を見つけてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거의 어떤 좌절이 결국 당신을 더 강하게 만들었나요? 은색 안감을 찾으십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke tegenslag uit het verleden heeft jou uiteindelijk sterker gemaakt? Vind de zilveren rand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakie niepowodzenia z przeszłości sprawiły, że ostatecznie stałeś się silniejszy? Znajdź srebrną podszewkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Que revés do passado o tornou mais forte no final? Encontre o forro de prata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que revés do passado o tornou mais forte no final? Encontre o forro de prata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая неудача из прошлого в конечном итоге сделала вас сильнее? Найдите положительную сторону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişteki hangi aksilik sonunda sizi daha da güçlendirdi? Gümüş astarı bulun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去的哪些挫折让你最终变得更加坚强？找到一线希望。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去的哪些挫折讓你最後變得更強大？找到一線希望。"
          }
        }
      }
    },
    "prog_gratitude_d5_t1": {
      "extractionState": "manual",
      "localizations": {
        "de": {

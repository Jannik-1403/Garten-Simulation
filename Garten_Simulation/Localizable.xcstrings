    "prog_water_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke 30 Minuten vor jedem großen Essen ein Glas Wasser. Das hilft der Verdauung und dem Sättigungsgefühl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink a glass of water 30 minutes before every big meal. This helps digestion and the feeling of satiety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba un vaso de agua 30 minutos antes de cada comida importante. Esto ayuda a la digestión y a la sensación de saciedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez un verre d'eau 30 minutes avant chaque gros repas. Cela facilite la digestion et la sensation de satiété."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक बड़े भोजन से 30 मिनट पहले एक गिलास पानी पियें। यह पाचन और तृप्ति की भावना में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi un bicchiere d'acqua 30 minuti prima di ogni pasto abbondante. Questo aiuta la digestione e il senso di sazietà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たくさんの食事の 30 分前に、コップ一杯の水を飲みましょう。これにより、消化が促進され、満腹感が得られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 식사 30분 전에 물 한 잔을 마십니다. 이는 소화와 포만감을 돕는다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink een glas water 30 minuten voor elke grote maaltijd. Dit bevordert de spijsvertering en het gevoel van verzadiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypij szklankę wody 30 minut przed każdym dużym posiłkiem. Wspomaga to trawienie i uczucie sytości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba um copo de água 30 minutos antes de cada grande refeição. Isso ajuda na digestão e na sensação de saciedade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba um copo de água 30 minutos antes de cada grande refeição. Isso ajuda na digestão e na sensação de saciedade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выпивайте стакан воды за 30 минут до каждого обильного приема пищи. Это помогает пищеварению и ощущению сытости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her büyük yemekten 30 dakika önce bir bardak su için. Bu sindirime ve tokluk hissine yardımcı olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每顿大餐前 30 分钟喝一杯水。这有助于消化和饱腹感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每頓大餐前 30 分鐘喝一杯水。這有助於消化和飽腹感。"
          }
        }
      }
    },

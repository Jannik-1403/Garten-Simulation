    "prog_running_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute arbeiten wir an der Lauftechnik und Rumpfstabilität, um Verletzungen vorzubeugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today we will work on running technique and core stability to prevent injuries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy trabajaremos la técnica de carrera y la estabilidad del core para prevenir lesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, nous allons travailler sur la technique de course et la stabilité du tronc pour éviter les blessures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज हम चोटों से बचने के लिए दौड़ने की तकनीक और कोर स्थिरता पर काम करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi lavoreremo sulla tecnica di corsa e sulla stabilità del core per prevenire gli infortuni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は怪我を防ぐためにランニング技術と体幹の安定性に取り組みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 부상을 예방하기 위한 달리기 기술과 코어 안정성에 대해 알아보겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag gaan we werken aan looptechniek en core-stabiliteit om blessures te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj będziemy pracować nad techniką biegu i stabilnością tułowia, aby zapobiec kontuzjom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje trabalharemos a técnica de corrida e a estabilidade do core para prevenir lesões."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje trabalharemos a técnica de corrida e a estabilidade do core para prevenir lesões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня мы будем работать над техникой бега и стабильностью корпуса, чтобы предотвратить травмы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün yaralanmaları önlemek için koşu tekniği ve core stabilitesi üzerinde çalışacağız."
          }

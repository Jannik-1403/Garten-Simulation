    "pfad_mental_phase_einstieg_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Auszeiten für den Geist. Lerne bewusstes Atmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

    "assessment.finance.q1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst eine unerwartete Rückzahlung von 800€ (Steuer, Kaution, Versicherung). Was passiert in den nächsten 48 Stunden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get an unexpected refund of €800 (tax, deposit, insurance). What happens in the next 48 hours?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtienes un reembolso inesperado de 800 € (impuestos, depósito, seguro). ¿Qué pasará en las próximas 48 horas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous bénéficiez d'un remboursement inattendu de 800 € (taxes, caution, assurance). Que se passe-t-il dans les prochaines 48 heures ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un rimborso inaspettato di 800€ (tasse, deposito, assicurazione). Cosa succede nelle prossime 48 ore?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期せぬ 800 ユーロ (税金、デポジット、保険) の払い戻しを受けます。次の 48 時間で何が起こるでしょうか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상치 못한 €800(세금, 보증금, 보험)를 환불받습니다. 앞으로 48시간 동안 무슨 일이 일어날까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt onverwacht € 800,- terug (belasting, borg, verzekering). Wat gebeurt er de komende 48 uur?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymujesz nieoczekiwany zwrot pieniędzy w wysokości 800 € (podatek, kaucja, ubezpieczenie). Co stanie się w ciągu najbliższych 48 godzin?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você recebe um reembolso inesperado de € 800 (impostos, depósito, seguro). O que acontece nas próximas 48 horas?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenmedik bir şekilde 800€ tutarında geri ödeme alırsınız (vergi, depozito, sigorta). Önümüzdeki 48 saat içinde ne olacak?"
          }
        }
      }
    },
    "assessment.finance.q1.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist weg – ich weiß ehrlich gesagt nicht genau, wofür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's gone - I'm honestly not sure why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha desaparecido; sinceramente, no estoy seguro de por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est parti - honnêtement, je ne sais pas pourquoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è più, onestamente non sono sicuro del perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それは消えました - 正直に言うと、理由はわかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사라졌습니다. 솔직히 왜 그런지 잘 모르겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is weg - ik weet eerlijk gezegd niet zeker waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknęło – szczerze mówiąc, nie jestem pewien dlaczego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabou - honestamente, não sei por quê."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitti; açıkçası neden olduğundan emin değilim."
          }
        }
      }
    },
    "assessment.finance.q1.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kaufe mir erstmal etwas, das ich schon lange wollte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First I'll buy something that I've wanted for a long time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero compraré algo que quiero desde hace mucho tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais d’abord acheter quelque chose que je veux depuis longtemps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per prima cosa comprerò qualcosa che desidero da molto tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずはずっと欲しかったものを買おうと思います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 오랫동안 갖고 싶었던 것을 사겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst koop ik iets wat ik al heel lang wil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw kupię coś, o czym marzyłem od dawna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro vou comprar algo que desejo há muito tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelikle uzun zamandır istediğim bir şeyi satın alacağım."
          }
        }
      }
    },
    "assessment.finance.q1.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht direkt auf mein Sparkonto oder in eine geplante Ausgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes directly into my savings account or a planned expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va directamente a mi cuenta de ahorros o a un gasto planificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il va directement sur mon compte épargne ou sur une dépense planifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va direttamente nel mio conto di risparmio o in una spesa pianificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それは私の普通預金口座または計画された支出に直接入金されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 저축계좌나 계획된 비용으로 바로 들어갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gaat rechtstreeks naar mijn spaarrekening of een geplande uitgave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafia bezpośrednio na moje konto oszczędnościowe lub na planowany wydatek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai diretamente para minha conta poupança ou para uma despesa planejada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan tasarruf hesabıma veya planlanmış bir gidere gidiyor."
          }
        }
      }
    },
    "assessment.finance.q1.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich überlege eine Woche lang, tue aber am Ende nichts damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I think about it for a week but end up doing nothing with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo pienso durante una semana pero termino sin hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'y pense pendant une semaine mais je finis par ne rien faire avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci penso per una settimana ma finisco per non farci niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1週間くらい考えたけど結局何もしない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일 동안 고민했지만 결국 아무것도 하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik denk er een week over na, maar doe er uiteindelijk niets mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Myślę o tym przez tydzień, ale ostatecznie nic z tym nie robię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Penso nisso por uma semana, mas acabo não fazendo nada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hafta boyunca bunu düşünüyorum ama sonunda hiçbir şey yapmıyorum."
          }
        }
      }
    },
    "assessment.finance.q2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Freund schwärmt von einer Investment-App. Du hast 500€ übrig. Was tust du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your friend is raving about an investment app. You have €500 left. What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu amigo está entusiasmado con una aplicación de inversión. Te quedan 500€. ¿Qué estás haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ami raffole d’une application d’investissement. Il vous reste 500 €. Que fais-tu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo amico è entusiasta di un'app di investimento. Ti restano 500€. Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの友人は投資アプリを絶賛しています。まだ 500 ユーロ残っています。何してるの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구가 투자 앱에 대해 열광하고 있습니다. 500유로가 남았습니다. 뭐하세요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vriend is enthousiast over een beleggingsapp. Je hebt nog € 500,- over. Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój znajomy zachwyca się aplikacją inwestycyjną. Zostało Ci 500 €. Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu amigo está entusiasmado com um aplicativo de investimento. Você ainda tem 500€. O que você está fazendo?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşınız bir yatırım uygulaması hakkında övgüler yağdırıyor. 500€'nuz kaldı. Ne yapıyorsun?"
          }
        }
      }
    },
    "assessment.finance.q2.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lade sie sofort runter und probiere es direkt aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll download it straight away and try it out straight away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo descargaré de inmediato y lo probaré de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais le télécharger immédiatement et l'essayer immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scaricherò subito e lo proverò subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早速ダウンロードして、早速試してみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 다운받아서 바로 사용해보겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik download hem meteen en probeer hem meteen uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaraz go pobiorę i wypróbuję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou baixá-lo imediatamente e testá-lo imediatamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen indirip deneyeceğim."
          }
        }
      }
    },
    "assessment.finance.q2.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich google die App, lese 3 Reviews und entscheide dann."
          }

    "prog_wakeup_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snoozen fragmentiert den Schlaf und macht dich müder. Wenn der Wecker klingelt, stehen die Füße in 5 Sekunden auf dem Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snoozing fragments sleep and makes you more tired. When the alarm goes off, your feet will be on the floor in 5 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir fragmenta el sueño y te cansa más. Cuando suene la alarma, tus pies estarán en el suelo en 5 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sieste fragmente le sommeil et vous rend plus fatigué. Lorsque l'alarme se déclenche, vos pieds seront au sol dans 5 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झपकी लेने से नींद के टुकड़े टुकड़े हो जाते हैं और आप अधिक थक जाते हैं। जब अलार्म बजता है, तो 5 सेकंड में आपके पैर फर्श पर होंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il posticipo interrompe il sonno e ti rende più stanco. Quando suona l'allarme, i tuoi piedi saranno a terra in 5 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スヌーズ断片は眠ってしまい、さらに疲れやすくなります。アラームが鳴ると、5秒以内に足が床に着きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 알림 조각은 잠을 자고 더 피곤하게 만듭니다. 알람이 울리면 5초 안에 발이 바닥에 닿게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snoozen verstoort de slaap en maakt je vermoeider. Als het alarm afgaat, staan ​​je voeten binnen 5 seconden op de grond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drzemanie fragmentów usypia i powoduje większe zmęczenie. Gdy włączy się alarm, za 5 sekund Twoje stopy znajdą się na podłodze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochilar fragmenta o sono e deixa você mais cansado. Quando o alarme tocar, seus pés estarão no chão em 5 segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochilar fragmenta o sono e deixa você mais cansado. Quando o alarme tocar, seus pés estarão no chão em 5 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дремлющие фрагменты засыпают и делают вас более утомленным. Когда сработает будильник, ваши ноги окажутся на полу через 5 секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ertelenen parçalar uyutur ve sizi daha çok yorar. Alarm çaldığında ayaklarınız 5 saniye içinde yerde olacaktır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打瞌睡会让你更累。当闹钟响起时，您的脚将在 5 秒内落地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打瞌睡會讓你更累。當鬧鐘響起時，您的腳將在 5 秒內落地。"
          }
        }
      }
    },

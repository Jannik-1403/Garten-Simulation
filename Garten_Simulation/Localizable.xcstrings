    "prog_running_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der wichtigste Lauf der Woche für die Grundlagenausdauer. Das Tempo ist absolut zweitrangig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most important run of the week for basic endurance. The pace is absolutely secondary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carrera más importante de la semana para la resistencia básica. El ritmo es absolutamente secundario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La course la plus importante de la semaine pour l'endurance de base. Le rythme est absolument secondaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुनियादी सहनशक्ति के लिए सप्ताह की सबसे महत्वपूर्ण दौड़। गति बिल्कुल गौण है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La corsa più importante della settimana per la resistenza di base. Il ritmo è assolutamente secondario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎持久力を高めるために今週最も重要なランニング。ペースはまったく二の次です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 지구력을 위한 이번 주의 가장 중요한 달리기입니다. 속도는 절대적으로 부차적입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De belangrijkste loop van de week voor basisuithoudingsvermogen. Het tempo is absoluut secundair."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najważniejszy bieg w tygodniu dla podstawowej wytrzymałości. Tempo jest absolutnie drugorzędne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A corrida mais importante da semana para resistência básica. O ritmo é absolutamente secundário."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A corrida mais importante da semana para resistência básica. O ritmo é absolutamente secundário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый важный забег недели для базовой выносливости. Темп абсолютно вторичен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel dayanıklılık için haftanın en önemli koşusu. Hız kesinlikle ikinci plandadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周最重要的基本耐力跑步。速度绝对是次要的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週最重要的基本耐力跑。速度絕對是次要的。"
          }
        }
      }
    },

    "prog_selfcare_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe eine Stunde vor dem Schlafengehen offline. Kein Social Media, keine Nachrichten. Nur ein Buch oder Stille."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go offline an hour before bed. No social media, no news. Just a book or silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconéctate una hora antes de acostarte. Sin redes sociales, sin noticias. Sólo un libro o el silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous une heure avant de vous coucher. Pas de réseaux sociaux, pas de nouvelles. Juste un livre ou un silence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से एक घंटा पहले ऑफ़लाइन हो जाएँ। कोई सोशल मीडिया नहीं, कोई खबर नहीं. बस एक किताब या खामोशी."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai offline un'ora prima di andare a letto. Niente social, niente notizie. Basta un libro o il silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝1時間前にオフラインにしてください。ソーシャルメディアもニュースもありません。ただの本か沈黙か。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자리에 들기 한 시간 전에는 오프라인 상태로 전환하세요. 소셜 미디어도 없고, 뉴스도 없습니다. 그냥 책이나 침묵."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga een uur voor het slapengaan offline. Geen sociale media, geen nieuws. Gewoon een boek of stilte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do trybu offline na godzinę przed snem. Żadnych mediów społecznościowych, żadnych wiadomości. Tylko książka lub cisza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique off-line uma hora antes de dormir. Sem redes sociais, sem notícias. Apenas um livro ou silêncio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique off-line uma hora antes de dormir. Sem redes sociais, sem notícias. Apenas um livro ou silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите из сети за час до сна. Никаких социальных сетей, никаких новостей. Просто книга или тишина."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan bir saat önce çevrimdışı olun. Sosyal medya yok, haber yok. Sadece bir kitap ya da sessizlik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前一小时离线。没有社交媒体，就没有新闻。只是一本书或沉默。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前一小時離線。沒有社群媒體，就沒有新聞。只是一本書或沉默。"
          }
        }
      }
    },

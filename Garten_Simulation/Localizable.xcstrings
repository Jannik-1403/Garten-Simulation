        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소중한 인맥을 만들고 네트워크를 구축하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg waardevolle contacten en bouw je netwerk op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawiązuj cenne kontakty i buduj swoją sieć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça contatos valiosos e construa sua rede."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

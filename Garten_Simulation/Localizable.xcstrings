    "retention.abschluss.sub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f6chtest du mit einem neuen Garten weitermachen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like to start fresh with a new garden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfTe gustar\u00eda empezar de nuevo con un jard\u00edn nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu continuer avec un nouveau jardin ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0924\u0941\u092e \u090f\u0915 \u0928\u090f \u092c\u0917\u0940\u091a\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like to start fresh with a new garden?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u3057\u3044\u304a\u5ead\u3067\u5fc3\u6a5f\u4e00\u8ee2\u59cb\u3081\u3066\u307f\u307e\u305b\u3093\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c8\ub85c\uc6b4 \uc815\uc6d0\uc73c\ub85c \uc0c8\ub86d\uac8c \uc2dc\uc791\ud558\uace0 \uc2f6\uc73c\uc2e0\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u fris beginnen met een nieuwe tuin?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcesz zacz\u0105\u0107 od nowa z nowym ogrodem?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres continuar com un novo jardim?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0441 \u043d\u043e\u0432\u044b\u043c \u0441\u0430\u0434\u043e\u043c?"
          }
        },
        "tr": {
          "stringUnit": {

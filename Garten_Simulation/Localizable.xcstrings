    "assessment.fitness.q1" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Wecker klingelt um 5:30 Uhr für das geplante Workout. Es ist draußen eiskalt, dunkel und regnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your alarm goes off at 5:30 a.m. for your planned workout. It's freezing cold, dark and raining outside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su alarma suena a las 5:30 a. m. para su entrenamiento planificado. Afuera hace mucho frío, está oscuro y llueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre alarme sonne à 5h30 pour votre entraînement prévu. Il fait un froid glacial, il fait sombre et il pleut dehors."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नियोजित वर्कआउट के लिए आपका अलार्म सुबह 5:30 बजे बज जाता है। बाहर जमा देने वाली ठंड, अंधेरा और बारिश हो रही है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sveglia suona alle 5:30 per l'allenamento pianificato. Fuori fa un freddo gelido, è buio e piove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画したワークアウトのために、午前 5 時 30 分にアラームが鳴ります。外は凍えるほど寒く、暗く、雨が降っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획된 운동을 위해 오전 5시 30분에 알람이 울립니다. 밖에는 춥고 어둡고 비가 내리고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wekker gaat om 05.30 uur af voor je geplande training. Buiten is het ijskoud, donker en regent het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój budzik włączy się o 5:30 w związku z zaplanowanym treningiem. Na zewnątrz jest przeraźliwie zimno, ciemno i pada deszcz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu alarme dispara às 5h30 para o treino planejado. Está muito frio, escuro e chovendo lá fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой будильник звонит в 5:30 утра для запланированной тренировки. На улице ледяной холод, темно и идет дождь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planladığınız antrenman için alarmınız sabah 5:30'da çalıyor. Dışarısı dondurucu soğuk, karanlık ve yağmur yağıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的闹钟在5:30响起，为计划的锻炼时间做准备。外面寒冷刺骨、黑暗并下着雨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的鬧鐘會在凌晨 5:30 響起，進行您計劃的鍛鍊。外面下著雨，天氣寒冷、黑暗。"
          }
        }
      }
    },
    "assessment.fitness.q1.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich drücke auf Snooze. Schlaf ist schließlich auch wichtig für die Regeneration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hit snooze. After all, sleep is also important for regeneration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presioné el botón de repetición. Al fin y al cabo, el sueño también es importante para la regeneración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai appuyé sur snooze. Après tout, le sommeil est également important pour la régénération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने झपकी मार दी। आख़िरकार, पुनर्जनन के लिए नींद भी ज़रूरी है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho premuto il tasto snooze. Dopotutto, anche il sonno è importante per la rigenerazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は居眠りをしました。結局のところ、睡眠は再生にも重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 다시 알림을 눌렀다. 결국 재생에는 수면도 중요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik drukte op snooze. Slaap is immers ook belangrijk voor regeneratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączyłem drzemkę. W końcu sen jest również ważny dla regeneracji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apertei a soneca. Afinal, o sono também é importante para a regeneração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я нажимаю на отложенный сигнал будильника. Сон, в конце концов, также важен для восстановления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ertele tuşuna bastım. Sonuçta uyku yenilenme için de önemlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我按下贪睡键。毕竟睡眠对恢复也很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我打瞌睡。畢竟，睡眠對於再生也很重要。"
          }
        }
      }
    },
    "assessment.fitness.q1.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bleibe liegen und nehme mir fest vor, das Workout heute Abend nachzuholen (was ich dann nicht tue)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stay in bed and make up my mind to catch up on the workout this evening (which I don't do)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me quedo en la cama y decido ponerme al día con el ejercicio de esta noche (cosa que no hago)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reste au lit et décide de rattraper mon retard sur l'entraînement de ce soir (ce que je ne fais pas)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं बिस्तर पर रहता हूं और आज शाम को कसरत करने का मन बनाता हूं (जो मैं नहीं करता)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resto a letto e decido di recuperare l'allenamento stasera (cosa che non faccio)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私はベッドにいて、今夜のトレーニングに追いつくことを決心します（実際にはしません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 침대에 누워서 오늘 저녁에 운동을 따라잡기로 마음먹었다(나는 그렇게 하지 않는다)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik blijf in bed liggen en neem me voor om vanavond de training in te halen (wat ik niet doe)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leżę w łóżku i postanawiam nadrobić zaległości w treningu dzisiejszego wieczoru (czego nie robię)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu fico na cama e decido colocar o treino em dia esta noite (o que não faço)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я остаюсь лежать и твердо намереваюсь наверстать тренировку сегодня вечером (чего я потом не делаю)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatakta kalıyorum ve bu akşamki antrenmana yetişmeye karar veriyorum (ki bunu yapmıyorum)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我躺下，并且下定决心今晚要补做锻炼（但我最终没有做）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我躺在床上，下定決心要趕上今晚的運動（我沒有這樣做）。"
          }
        }
      }
    },
    "assessment.fitness.q1.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich stehe auf, mache aber nur ein kurzes, halbes Workout zu Hause im Warmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I get up, but only do a short, half-workout at home in the warmth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me levanto, pero solo hago un breve medio entrenamiento en casa, al calor del calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je me lève, mais je ne fais qu'un court demi-entraînement à la maison, au chaud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं उठता हूं, लेकिन घर पर गर्मी में केवल एक छोटी, आधी कसरत ही करता हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi alzo, ma faccio solo un breve allenamento a casa al caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は起きますが、暖かい家の中で短時間の半分のトレーニングをするだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 일어나지만 따뜻한 집에서 짧은 반만 운동한다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik sta op, maar doe thuis alleen een korte, halve training in de warmte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstaję, ale robię tylko krótki, półtreningowy trening w domu, w upale."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu me levanto, mas só faço um pequeno treino em casa, no calor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я встаю, но делаю только короткую, половинчатую тренировку дома, в тепле."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalkıyorum ama evde sıcakta sadece kısa, yarım egzersiz yapıyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我起床了，但只在家里温暖的地方做一个简短的半身锻炼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我起床，但只在溫暖的家中進行了短暫的半運動。"
          }
        }
      }
    },
    "assessment.fitness.q1.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich fluche, stehe auf, friere und ziehe das geplante Workout zu 100％ durch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I curse, get up, freeze and do the planned workout 100％."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maldigo, me levanto, me congelo y hago el entrenamiento planificado al 100％."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je maudis, je me lève, je me fige et je fais l'entraînement prévu à 100 ％."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं शाप देता हूं, उठता हूं, जम जाता हूं और नियोजित कसरत 100％ करता हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impreco, mi alzo, mi blocco e faccio l'allenamento pianificato al 100％."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は悪態をつき、起き上がり、固まり、計画したトレーニングを100％実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "욕하고, 일어나고, 얼어붙고, 계획한 운동을 100％ 한다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik vloek, sta op, bevries en doe de geplande training 100％."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeklinam, wstaję, zamarzam i realizuję zaplanowany trening na 100％."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaldiçoo, levanto, congelo e faço 100％ o treino planejado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ругаюсь, встаю, мёрзну и выполняю запланированную тренировку на 100％."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

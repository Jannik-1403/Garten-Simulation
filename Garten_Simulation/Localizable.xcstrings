    "trash.zigaretten_automat.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass kein Feuerzeug im Haus \u2013 jeder Z\u00fcndungsmoment kostet Willenskraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't keep a lighter in the house \u2013 every ignition moment costs willpower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardes un encendedor en casa: cada momento de encendido cuesta fuerza de voluntad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laisse pas de briquet dans la maison \u2013 chaque moment d'allumage co\u00fbte de la volont\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0918\u0930 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0932\u093e\u0907\u091f\u0930 \u092e\u0924 \u091b\u094b\u0921\u093c\u094b \u2013 \u0939\u0930 \u0905\u0930\u093e\u091c\u0915\u0924\u093e \u0915\u093e \u0915\u094d\u0937\u0923 \u0907\u091a\u094d\u091b\u093e\u0936\u0915\u094d\u0924\u093f \u0915\u0940 \u0932\u093e\u0917\u0924 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tenere un accendino in casa \u2013 ogni momento di accensione costa forza di volont\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bb6\u306b\u30e9\u30a4\u30bf\u30fc\u3092\u7f6e\u304b\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u706b\u3092\u3064\u3051\u308b\u77ac\u9593\u306b\u610f\u5fd7\u306e\u529b\u304c\u6d88\u8017\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9d1\uc5d0 \ub77c\uc774\ud130\ub97c \ub450\uc9c0 \ub9c8\uc138\uc694 \u2013 \ubd88\uc744 \ubd99\uc774\ub294 \uc21c\uac04\ub9c8\ub2e4 \uc758\uc9c0\ub825\uc774 \uc18c\ubaa8\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat geen aansteker in huis \u2013 elk ontstekkingsmoment kost wilskracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie trzymaj zapalniczki w domu \u2013 ka\u017cdy moment zapalenia kosztuje si\u0142\u0119 woli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o deixe isqueiro em casa \u2013 cada momento de acender custa for\u00e7a de vontade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0437\u0430\u0436\u0438\u0433\u0430\u043b\u043a\u0443 \u0432 \u0434\u043e\u043c\u0435 \u2013 \u043a\u0430\u0436\u0434\u043e\u0435 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u0438\u0435 \u0437\u0430\u0436\u0438\u0433\u0430\u043d\u0438\u044f \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u0438\u043b\u044b \u0432\u043e\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde \u00e7akmak bulundurma \u2013 her ate\u015fleme an\u0131 irade g\u00fcc\u00fc harcar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u628a\u6253\u706b\u673a\u7559\u5728\u5bb6\u91cc\u2014\u2014\u6bcf\u4e00\u6b21\u70b9\u706b\u90fd\u9700\u8981\u610f\u5fd7\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u628a\u6253\u706b\u6a5f\u7559\u5728\u5bb6\u88e1\u2014\u2014\u6bcf\u4e00\u6b21\u9ede\u706b\u90fd\u9700\u8981\u610f\u5fd7\u529b\u3002"
          }
        }
      }
    },
    "trash.zigaretten_automat.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisiere gesunde Lungen \u2013 h\u00e4nge ein Foto auf deinen K\u00fchlschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize healthy lungs \u2013 hang a photo on your fridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiza pulmones sanos: cuelga una foto en tu frigor\u00edfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualise des poumons sains \u2013 accroche une photo sur ton r\u00e9frig\u00e9rateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u0938\u094d\u0925 \u092b\u0947\u092b\u0921\u093c\u094b\u0902 \u0915\u0940 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u0947\u0902 \u2013 \u0905\u092a\u0928\u0947 \u092b\u094d\u0930\u093f\u091c \u092a\u0930 \u090f\u0915 \u092b\u094b\u091f\u094b \u0932\u0917\u093e\u090f\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza polmoni sani \u2013 appendi una foto sul tuo frigorifero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5065\u5eb7\u306a\u80ba\u3092\u30a4\u30e1\u30fc\u30b8\u3057\u307e\u3057\u3087\u3046\u3002\u51b7\u8535\u5eab\u306b\u5199\u771f\u3092\u8cbc\u3063\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac74\uac15\ud55c \ud3d0\ub97c \uc2dc\uac01\ud654\ud558\uc138\uc694 \u2013 \ub0c9\uc7a5\uace0\uc5d0 \uc0ac\uc9c4\uc744 \ubd99\uc5ec\ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiseer gezonde longen \u2013 hang een foto op je koelkast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizualizuj zdrowe p\u0142uca \u2013 powie\u015b zdj\u0119cie na lod\u00f3wce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize pulm\u00f5es saud\u00e1veis \u2013 coloque uma foto na sua geladeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0435 \u043b\u0435\u0433\u043a\u0438\u0435 \u2013 \u043f\u043e\u0432\u0435\u0441\u044c\u0442\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e \u043d\u0430 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa\u011fl\u0131kl\u0131 akci\u011ferleri hayal et \u2013 buzdolab\u0131na bir foto\u011fraf as."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60f3\u8c61\u5065\u5eb7\u7684\u80ba\u90e8\u2014\u2014\u5728\u51b0\u7bb1\u4e0a\u8d34\u4e00\u5f20\u7167\u7247\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60f3\u50cf\u5065\u5eb7\u7684\u80ba\u90e8\uff0d\u5728\u51b0\u7bb1\u4e0a\u8cbc\u4e00\u5f35\u7167\u7247\u3002"
          }
        }
      }
    },
    "trash.zigaretten_automat.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze die Rauch-Pause durch 5 Minuten Spaziergang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the smoke break with 5 minutes of walking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el descanso para fumar por 5 minutos de caminata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace la pause fumeur par 5 minutes de marche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0927\u0942\u092e\u094d\u0930\u092a\u093e\u0928 \u0915\u093e \u092c\u094d\u0930\u0947\u0915 5 \u092e\u093f\u0928\u091f \u0915\u0940 \u0938\u0948\u0930 \u0938\u0947 \u092c\u0926\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci la pausa sigaretta con 5 minuti di camminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30d0\u30b3\u4f11\u61a9\u306e\u4ee3\u308f\u308a\u306b5\u5206\u9593\u6b69\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud761\uc5f0 \ud734\uc2dd\uc744 5\ubd84 \uac77\uae30\ub85c \ub300\uccb4\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de rookpauze door 5 minuten wandelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zast\u0105p przerw\u0119 na papierosa 5 minutami chodzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua o intervalo para fumar por 5 minutos de caminhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u043f\u0435\u0440\u0435\u043a\u0443\u0440 \u043d\u0430 5-\u043c\u0438\u043d\u0443\u0442\u043d\u0443\u044e \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigara molas\u0131n\u0131 5 dakika y\u00fcr\u00fcy\u00fc\u015fle de\u011fi\u015ftir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u6b65\u884c 5 \u5206\u949f\u4ee3\u66ff\u62bd\u70df\u4f11\u606f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u6b65\u884c 5 \u5206\u9418\u4ee3\u66ff\u62bd\u7159\u4f11\u606f\u3002"
          }
        }
      }
    },
    "trash.zigaretten_automat.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne den monatlichen Rauch-Betrag um: Was k\u00f6nntest du stattdessen kaufen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate your monthly smoking cost: what could you buy instead?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula el coste mensual de fumar: \u00bfqu\u00e9 podr\u00edas comprar en su lugar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule ton co\u00fbt mensuel de tabac : qu'est-ce que tu pourrais acheter \u00e0 la place ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u093e\u0938\u093f\u0915 \u0927\u0942\u092e\u094d\u0930\u092a\u093e\u0928 \u0915\u0940 \u0930\u093e\u0936\u093f \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0947\u0902: \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u0906\u092a \u0915\u094d\u092f\u093e \u0916\u0930\u0940\u0926 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola il costo mensile del fumo: cosa potresti comprare invece?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6708\u3005\u306e\u55ab\u7159\u8cbb\u7528\u3092\u8a08\u7b97\u3057\u307e\u3057\u3087\u3046\u3002\u4ee3\u308f\u308a\u306b\u4f55\u3092\u8cb7\u3048\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6d4\ubcc4 \ud761\uc5f0 \ube44\uc6a9\uc744 \uacc4\uc0b0\ud558\uc138\uc694: \ub300\uc2e0 \ubb34\uc5c7\uc744 \uc0b4 \uc218 \uc788\uc744\uae4c\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken het maandelijkse rookbedrag: wat zou je in plaats daarvan kunnen kopen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblicz miesi\u0119czny koszt palenia: co m\u00f3g\u0142by\u015b zamiast tego kupi\u0107?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule o custo mensal de fumar: o que voc\u00ea poderia comprar em vez disso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0435\u0434\u0438\u0442\u0435 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0432\u044b\u043a\u0443\u0440\u0438\u0432\u0430\u0435\u043c\u043e\u0433\u043e \u0434\u044b\u043c\u0430: \u0447\u0442\u043e \u0432\u044b \u043c\u043e\u0433\u043b\u0438 \u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayl\u0131k sigara maliyetini hesapla: bunun yerine ne alabilirdin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6362\u7b97\u6bcf\u6708\u5438\u70df\u91cf\uff1a\u4f60\u53ef\u4ee5\u4e70\u4ec0\u4e48\u6765\u4ee3\u66ff\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63db\u7b97\u6bcf\u6708\u5438\u83f8\u91cf\uff1a\u4f60\u53ef\u4ee5\u8cb7\u4ec0\u9ebc\u4f86\u4ee3\u66ff\uff1f"
          }
        }
      }
    },
    "trash.zigaretten_automat.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Rauchen)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Atem\u00fcbungen)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Rauchen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Atem\u00fcbungen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Rauchen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Atem\u00fcbungen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Rauchen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Atem\u00fcbungen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u092c\u0941\u0930\u0940 \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u0927\u0942\u092e\u094d\u0930\u092a\u093e\u0928)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0938\u093e\u0902\u0938 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0905\u092d\u094d\u092f\u093e\u0938)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0938\u0930\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0918\u091f\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Rauchen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Atem\u00fcbungen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Rauchen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Atem\u00fcbungen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },

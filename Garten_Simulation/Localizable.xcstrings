    "prog_meditation_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der absolute Basic-Anker. Beobachte deinen Atem an der Nasenspitze oder im Bauchraum. Wenn du abschweifst, kehre sanft zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The absolute basic anchor. Observe your breathing at the tip of your nose or in your abdomen. When you wander, return gently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancla básica absoluta. Observe su respiración en la punta de la nariz o en el abdomen. Cuando deambules, regresa suavemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancre de base absolue. Observez votre respiration au bout de votre nez ou dans votre abdomen. Lorsque vous vous promenez, revenez doucement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल बुनियादी एंकर. अपनी नाक की नोक पर या अपने पेट में अपनी श्वास का निरीक्षण करें। जब तुम भटको तो धीरे से लौट आओ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancora di base assoluta. Osserva il tuo respiro sulla punta del naso o nell'addome. Quando vaghi, ritorna dolcemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絶対的な基本アンカー。鼻の先や腹部での呼吸を観察してください。さまよったらそっと戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절대적인 기본 앵커. 코 끝이나 복부의 호흡을 관찰하십시오. 방황할 때는 부드럽게 돌아오십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het absolute basisanker. Observeer uw ademhaling op het puntje van uw neus of in uw buik. Als je ronddwaalt, keer dan zachtjes terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutnie podstawowa kotwica. Obserwuj swój oddech na czubku nosa lub w jamie brzusznej. Kiedy będziesz wędrować, wróć delikatnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A âncora básica absoluta. Observe sua respiração na ponta do nariz ou no abdômen. Quando você vagar, retorne suavemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A âncora básica absoluta. Observe sua respiração na ponta do nariz ou no abdômen. Quando você vagar, retorne suavemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Абсолютный базовый якорь. Наблюдайте за своим дыханием на кончике носа или в животе. Когда вы блуждаете, возвращайтесь осторожно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutlak temel çapa. Nefesinizi burnunuzun ucunda veya karnınızda gözlemleyin. Gezinirken yavaşça geri dönün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝对的基础锚。观察鼻尖或腹部的呼吸。当你徘徊时，轻轻归来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕對的基礎錨。觀察鼻尖或腹部的呼吸。當你徘徊時，輕輕歸來。"
          }
        }
      }
    },

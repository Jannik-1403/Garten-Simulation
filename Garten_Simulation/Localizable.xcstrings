            "state": "translated",
            "value": "No, put phone away"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No, guardarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non, le ranger"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0939\u0940\u0902, \u0905\u092a\u0928\u093e \u0938\u0947\u0932 \u092b\u093c\u094b\u0928 \u0926\u0942\u0930 \u0930\u0916\u0947\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No, mettilo via"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3044\u3044\u3048\u3001\u7f6e\u304d\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\ub2c8\uc694, \uce58\uc6cc\ub461\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee, leg weg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie, od\u0142o\u017c\u0119"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o, guardar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442, \u043e\u0442\u043b\u043e\u0436\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay\u0131r, uza\u011fa koy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\uff0c\u628a\u624b\u673a\u653e\u4e0b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u884c\uff0c\u628a\u624b\u6a5f\u6536\u8d77\u4f86"
          }
        }
      }
    },
    "alert.strict_mode.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirst du dein Handy in der Zeit benutzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will you use your phone during this time?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfUsar\u00e1s tu tel\u00e9fono en este tiempo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas-tu utiliser ton t\u00e9l\u00e9phone pendant ce temps ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0907\u0938 \u0926\u094c\u0930\u093e\u0928 \u0905\u092a\u0928\u0947 \u0938\u0947\u0932 \u092b\u093c\u094b\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0917\u0947?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Userai il telefono in questo periodo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u6642\u9593\u4e2d\u306b\u643a\u5e2f\u96fb\u8a71\u3092\u4f7f\u7528\u3057\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc2dc\uac04 \ub3d9\uc548 \ud734\ub300\ud3f0\uc744 \uc0ac\uc6a9\ud558\uc2e4 \uac74\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga je je telefoon gebruiken in deze tijd?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy b\u0119dziesz u\u017cywa\u0107 telefonu w tym czasie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vais usar o telem\u00f3vel durante este tempo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0441\u0432\u043e\u0438\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u043c \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu s\u00fcre zarf\u0131nda telefonunuzu kullanacak m\u0131s\u0131n\u0131z?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4f1a\u5728\u90a3\u6bb5\u65f6\u95f4\u4f7f\u7528\u4f60\u7684\u624b\u673a\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u6bb5\u6642\u9593\u4f60\u6703\u4f7f\u7528\u624b\u6a5f\u55ce\uff1f"
          }
        }
      }
    },
    "alert.strict_mode.yes": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, ich lerne damit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, I study with it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00ed, lo necesito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, j'en ai besoin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u093e\u0901, \u092e\u0948\u0902 \u0907\u0938\u0915\u0947 \u0938\u093e\u0925 \u0938\u0940\u0916 \u0930\u0939\u093e \u0939\u0942\u0901"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00ec, mi serve"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u306f\u3044\u3001\u5fc5\u8981\u3067\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub124, \uc0ac\uc6a9\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, ik gebruik het"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, potrzebuj\u0119"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, preciso dele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0430, \u044f \u0443\u0447\u0443\u0441\u044c \u0441 \u044d\u0442\u0438\u043c"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet, onunla \u00e7al\u0131\u015f\u0131yorum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u662f\u7684\uff0c\u6211\u6b63\u5728\u7528\u5b83\u5b66\u4e60"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u662f\u7684\uff0c\u6211\u6b63\u5728\u5b78\u7fd2\u5b83"
          }
        }
      }
    },

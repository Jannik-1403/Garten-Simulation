    "prog_meditation_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dir vor, wie mit jedem Einatmen helles Licht in dich strömt und mit dem Ausatmen dunkler Rauch (Stress) entweicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine bright light flowing into you with every inhale and dark smoke (stress) escaping with every exhale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine una luz brillante que fluye hacia usted con cada inhalación y un humo oscuro (estrés) que se escapa con cada exhalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginez une lumière vive entrant en vous à chaque inspiration et une fumée sombre (stress) s'échappant à chaque expiration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल्पना करें कि हर साँस के साथ चमकदार रोशनी आपके अंदर प्रवाहित हो रही है और हर साँस छोड़ते समय गहरा धुआँ (तनाव) बाहर निकल रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina che una luce intensa fluisca dentro di te ad ogni inspirazione e che il fumo scuro (stress) fuoriesca ad ogni espirazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸い込むたびに明るい光が体内に流れ込み、吐き出すたびに暗い煙（ストレス）が逃げていくのを想像してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨을 들이쉴 때마다 밝은 빛이 들어오고 숨을 내쉴 때마다 어두운 연기(스트레스)가 빠져나가는 것을 상상해 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor dat er bij elke inademing helder licht naar je toe stroomt en bij elke uitademing donkere rook (stress) ontsnapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyobraź sobie jasne światło wpływające do ciebie przy każdym wdechu i ciemny dym (stres) wydobywający się z każdym wydechem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine uma luz brilhante fluindo para dentro de você a cada inspiração e uma fumaça escura (estresse) escapando a cada expiração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine uma luz brilhante fluindo para dentro de você a cada inspiração e uma fumaça escura (estresse) escapando a cada expiração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте себе яркий свет, входящий в вас с каждым вдохом, и темный дым (стресс), вырывающийся наружу с каждым выдохом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her nefes alışınızda parlak ışığın içinize aktığını ve her nefes verişinizde karanlık dumanın (stres) kaçtığını hayal edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想象一下，每次吸气时，明亮的光线都会流入您体内，而每次呼气时，黑烟（压力）都会逸出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想像一下，每次吸氣時，明亮的光線都會流入您體內，而每次呼氣時，黑煙（壓力）都會逸出。"
          }
        }
      }
    },

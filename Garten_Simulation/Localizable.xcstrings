    "paywall.feature.coin_bonus.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdiene bei jedem Gießen und Erledigen von Aufgaben 25％ mehr Münzen, um deinen Garten schneller wachsen zu lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earn 25％ more coins with every watering and completed task to grow your garden faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gana un 25％ más de monedas con cada riego y tarea completada para hacer crecer tu jardín más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagne 25％ de pièces en plus à chaque arrosage et tâche complétée pour faire grandir ton jardin plus vite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने बगीचे को तेजी से विकसित करने के लिए हर बार पानी देने और कार्य पूरा करने पर 25％ अधिक सिक्के अर्जित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guadagna il 25％ in più di monete con ogni annaffiatura e attività completata per far crescere il tuo giardino più velocemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "庭をより速く育てるために、水やりやタスク完了のたびに25％多くのコインを獲得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정원을 더 빨리 키우기 위해 물을 줄 때나 작업을 완료할 때마다 25％ 더 많은 코인을 획득하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdien 25％ meer munten bij elke waterbeurt en voltooide taak om je tuin sneller te laten groeien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarabiaj o 25％ więcej monet za każde podlewanie i wykonane zadanie, aby szybciej rozwijać swój ogród."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganhe 25％ mais moedas a cada rega e tarefa concluída para cultivar seu jardim mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарабатывайте на 25％ больше монет за каждый полив и выполнение заданий, чтобы ваш сад рос быстрее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahçenizi daha hızlı büyütmek için her sulamada ve tamamlanan görevde ％25 daha fazla jeton kazanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次浇水和完成任务时，可额外获得25％的硬币，让您的花园更快成长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva o seguinte problema matemático para cancelar sua sessão de foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реши следующую математическую задачу, чтобы прервать свою сессию фокуса."

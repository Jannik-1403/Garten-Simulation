    "onboarding_tutorial_4_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Gewohnheiten geben dir kurzfristige Boni, aber nutze sie weise!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad Habits give you short-term bonuses, but use them wisely!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las decoraciones te dan bonos a corto plazo, ¡pero úsalas con sabiduría!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décorations te donnent des bonus à court terme, mais utilise-les avec sagesse !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुरी आदतें आपको अल्पकालिक बोनस देती हैं, लेकिन उनका बुद्धिमानी से उपयोग करें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le decorazioni ti danno bonus a breve termine, ma usale con saggezza!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "装飾は短期的なボーナスを与えますが、賢く使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장식은 단기적인 보너스를 주지만 현명하게 사용하세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoraties geven je kortetermijnbonussen, maar gebruik ze verstandig!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekoracje dają krótkotrwałe premie, ale używaj ich mądrze!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As decorações dão-te bónus a curto prazo, mas usa-as com sabedoria!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As decorações dão-te bónus a curto prazo, mas usa-as com sabedoria!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плохие привычки дают тебе краткосрочные бонусы, но используй их с умом!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekorasyonlar size kısa vadeli bonuslar verir, ancak bunları akıllıca kullanın!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坏习惯会给你短期奖励，但请明智使用！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壞習慣會為你帶來短期的好處，但要明智地使用它們！"
          }
        }
      }
    },

    "assessment.fitness.profile.maschine.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Disziplin ist aus Eisen. Du kontrollierst deinen Körper, nicht umgekehrt. Egal ob es regnet, du müde bist oder die Muskeln brennen – du ziehst durch und dominierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your discipline is made of iron. You control your body, not the other way around. No matter whether it's raining, you're tired or your muscles are burning - you pull through and dominate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu disciplina está hecha de hierro. Tú controlas tu cuerpo, no al revés. No importa si está lloviendo, estás cansado o te arden los músculos: saldrás adelante y dominarás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre discipline est faite de fer. C'est vous qui contrôlez votre corps, et non l'inverse. Qu'il pleuve, que vous soyez fatigué ou que vos muscles brûlent, vous vous en sortez et dominez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua disciplina è fatta di ferro. Sei tu che controlli il tuo corpo, non viceversa. Non importa se piove, sei stanco o ti bruciano i muscoli: ce la fai e domini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの規律は鉄でできています。自分の体をコントロールするのは自分自身であり、その逆ではありません。雨が降っていようが、疲れていようが、筋肉が燃えていようが、あなたはやり遂げて支配します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 규율은 철로 만들어졌습니다. 당신은 당신의 몸을 통제하지만 그 반대는 아닙니다. 비가 오든, 피곤하든, 근육이 불타든 상관없이, 당신은 이겨내고 지배할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw discipline is van ijzer. Jij hebt controle over je lichaam, en niet andersom. Het maakt niet uit of het regent, je moe bent of je spieren branden - jij trekt door en domineert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja dyscyplina jest z żelaza. To ty kontrolujesz swoje ciało, a nie odwrotnie. Nieważne, czy pada deszcz, jesteś zmęczony, czy twoje mięśnie płoną – dajesz radę i dominujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua disciplina é feita de ferro. Você controla seu corpo, e não o contrário. Não importa se está chovendo, se você está cansado ou se seus músculos estão queimando - você supera e domina."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disiplininiz demirden yapılmıştır. Vücudunuzu siz kontrol ediyorsunuz, tersi değil. İster yağmur yağsın, ister yorgun olun, ister kaslarınız yanıyor olsun, üstesinden gelir ve hakim olursunuz."
          }
        }
      }
    },

    "plant.basilikum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein aber intensiv im Geschmack – Bewusstes Essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small but intense in flavor – Mindful eating"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeña pero intensa en sabor – Alimentación consciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit mais intense en saveur – Alimentation consciente"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा लेकिन स्वाद में तीव्र - सचेत भोजन"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccolo ma intenso nel gusto – alimentazione consapevole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいながらも濃厚な味わい – 意識して食べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작지만 강렬한 맛 – 마음챙김 식사"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein maar intens van smaak – Mindful eten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Małe, ale intensywne w smaku – Uważne jedzenie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno mas intenso em sabor – Alimentação consciente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno mas intenso em sabor – Alimentação consciente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленький, но интенсивный по вкусу – осознанное питание"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük ama tadı yoğun – Dikkatli yeme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小巧但味道浓郁 – 专注饮食"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雖小但味道濃鬱——有意識的飲食"
          }
        }
      }
    },

        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제나 태양을 향한다 - 얼리버드 에너지"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait zich altijd naar de zon – Early bird-energie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze zwraca się ku słońcu – Energia wczesnego ptaka"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre voltado para o sol – Energia de madrugador"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman güneşe döner – Erkenci kuş enerjisi"
          }
        }
      }
    },

    "smart.weekly.desc.consistent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beeindruckend! Du zeigst nicht nur starkes Volumen, sondern hältst deine Leistung auch über die Tage extrem stabil. Es gibt kaum Schwankungen in deiner Routine – du hast dein System gemeistert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressive! You not only show strong volume, but also keep your performance extremely stable over the days. There are hardly any fluctuations in your routine - you have mastered your system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Impresionante! No sólo muestra un gran volumen, sino que también mantiene su rendimiento extremadamente estable a lo largo de los días. Apenas hay fluctuaciones en su rutina: usted domina su sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressionnant! Non seulement vous affichez un fort volume, mais vous gardez également vos performances extrêmement stables au fil des jours. Il n’y a pratiquement aucune fluctuation dans votre routine – vous maîtrisez votre système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रभावशाली! आप न केवल मजबूत वॉल्यूम दिखाते हैं, बल्कि आप दिनों-दिन अपना प्रदर्शन भी बेहद स्थिर रखते हैं। आपकी दिनचर्या में शायद ही कोई उतार-चढ़ाव हो - आपने अपने सिस्टम पर महारत हासिल कर ली है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressionante! Non solo mostri un volume elevato, ma mantieni anche le tue prestazioni estremamente stabili nel corso dei giorni. Non ci sono quasi fluttuazioni nella tua routine: hai padroneggiato il tuo sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印象的な！強力な音量を発揮するだけでなく、何日間もパフォーマンスを非常に安定させます。あなたのルーチンにはほとんど変動がありません。あなたは自分のシステムをマスターしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인상적인! 강력한 볼륨을 보여줄 뿐만 아니라 며칠 동안 매우 안정적인 성능을 유지합니다. 귀하의 루틴에는 변동이 거의 없습니다. 귀하는 시스템을 마스터했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indrukwekkend! Je laat niet alleen een sterk volume zien, maar je houdt ook je prestaties extreem stabiel over de dagen. Er zijn nauwelijks schommelingen in uw routine – u heeft uw systeem onder de knie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imponujący! Nie tylko wykazujesz dużą głośność, ale także utrzymujesz swoją wydajność na wyjątkowo stabilnym poziomie przez cały dzień. W Twojej rutynie nie ma prawie żadnych wahań – opanowałeś swój system."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressionante! Você não apenas mostra um volume forte, mas também mantém seu desempenho extremamente estável ao longo dos dias. Quase não há flutuações em sua rotina – você dominou seu sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressionante! Você não apenas mostra um volume forte, mas também mantém seu desempenho extremamente estável ao longo dos dias. Quase não há flutuações em sua rotina – você dominou seu sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Впечатляющий! Вы не только демонстрируете высокие объемы, но и сохраняете свои результаты чрезвычайно стабильными в течение нескольких дней. В вашем распорядке дня практически нет колебаний – вы освоили свою систему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkileyici! Not only do you show strong volume, but you also keep your performance extremely stable over the days. There are hardly any fluctuations in your routine – you have mastered your system."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感人的！您不仅表现出强劲的成交量，而且在这些天里您的表现也保持极其稳定。你的日常生活几乎没有任何波动——你已经掌握了你的系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感人的！您不僅表現出強勁的成交量，而且在這些天裡您的表現也保持極其穩定。你的日常生活幾乎沒有任何波動——你已經掌握了你的系統。"
          }
        }
      }
    },
    "smart.weekly.desc.fluctuating": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Rhythmus war diese Woche sehr instabil. An manchen Tagen warst du extrem produktiv, an anderen ist alles eingebrochen. Versuche nächste Woche nicht alles auf einmal zu wollen, sondern lieber jeden Tag ein kleines bisschen zu machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rhythm was very unstable this week. Some days you were extremely productive, on others everything collapsed. Try not to want everything at once next week, but rather do a little bit every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ritmo ha sido muy inestable esta semana. Algunos días eras extremadamente productivo, otros días todo colapsaba. La próxima semana intenta no querer hacer todo a la vez, sino hacer un poquito cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rythme a été très instable cette semaine. Certains jours, vous étiez extrêmement productif, d’autres jours, tout s’effondrait. La semaine prochaine, essayez de ne pas vouloir tout faire en même temps, mais plutôt d’en faire un petit peu chaque jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सप्ताह आपकी लय बहुत अस्थिर रही है। कुछ दिन आप अत्यधिक उत्पादक थे, अन्य दिनों में सब कुछ ध्वस्त हो गया। अगले सप्ताह, कोशिश करें कि सब कुछ एक ही बार में न करें, बल्कि हर दिन थोड़ा-थोड़ा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ritmo è stato molto instabile questa settimana. Alcuni giorni eri estremamente produttivo, altri giorni tutto è crollato. La prossima settimana, cerca di non voler fare tutto in una volta, ma piuttosto di fare qualcosa ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週のあなたのリズムは非常に不安定です。非常に生産的だった日もあれば、すべてが崩壊した日もありました。来週は、一度にすべてを実行するのではなく、毎日少しずつ実行してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 당신의 리듬이 매우 불안정했습니다. 어떤 날은 생산성이 매우 높았지만 어떤 날은 모든 것이 무너졌습니다. 다음 주에는 모든 것을 한꺼번에 하려고 하지 말고 매일 조금씩 하도록 노력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ritme is deze week erg onstabiel. Sommige dagen was je extreem productief, andere dagen stortte alles in. Probeer volgende week niet alles in één keer te willen doen, maar liever elke dag een klein beetje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój rytm był w tym tygodniu bardzo niestabilny. W niektóre dni byłeś niezwykle produktywny, a w inne wszystko się zawalało. W następnym tygodniu staraj się nie chcieć robić wszystkiego na raz, ale raczej robić po trochu każdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ritmo tem estado muito instável esta semana. Alguns dias você foi extremamente produtivo, outros dias tudo desabou. Na próxima semana, tente não querer fazer tudo de uma vez, mas sim fazer um pouquinho todos os dias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ritmo tem estado muito instável esta semana. Alguns dias você foi extremamente produtivo, outros dias tudo desabou. Na próxima semana, tente não querer fazer tudo de uma vez, mas sim fazer um pouquinho todos os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой неделе ваш ритм был очень нестабильным. В некоторые дни вы были чрезвычайно продуктивны, в другие дни все рушилось. На следующей неделе постарайтесь не хотеть делать все сразу, а делайте каждый день понемногу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta ritminiz çok istikrarsız. Bazı günler son derece üretkendin, bazı günler ise her şey çöktü. Gelecek hafta, her şeyi bir anda yapmak istememeye çalışın, bunun yerine her gün biraz yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这周你的节奏很不稳定。有时候你的工作效率极高，但有时候一切都崩溃了。下周，尽量不要一次性做所有事情，而是每天做一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這週你的節奏很不穩定。有時候你的工作效率極高，但有時候一切都崩潰了。下週，盡量不要一次做所有事情，而是每天做一點。"
          }
        }
      }
    },
    "smart.weekly.desc.insufficient": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle in dieser Woche noch etwas mehr Fokuszeit oder hake Gewohnheiten ab, um eine echte Analyse deines Rhythmus zu erhalten. Jeder Tag zählt!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect a bit more focus time or complete habits this week to get a real analysis of your rhythm. Every day counts!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedique más tiempo a concentrarse o marque hábitos esta semana para obtener un análisis real de su ritmo. ¡Cada día cuenta!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérez un peu plus de temps de concentration ou cochez vos habitudes cette semaine pour obtenir une véritable analyse de votre rythme. Chaque jour compte !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लय का वास्तविक विश्लेषण प्राप्त करने के लिए इस सप्ताह कुछ और फोकस समय एकत्रित करें या आदतों की जाँच करें। हर दिन मायने रखता है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccogli un po' più di tempo per concentrarti o controlla le tue abitudini questa settimana per ottenere un'analisi reale del tuo ritmo. Ogni giorno conta!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週はもう少し集中時間を確保するか、習慣をチェックして自分のリズムを実際に分析してください。毎日が大切です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에는 집중 시간을 더 많이 확보하거나 습관을 확인하여 리듬을 실제로 분석해 보세요. 매일이 중요합니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel deze week wat meer focustijd of vink gewoontes af om een ​​echte analyse van je ritme te krijgen. Elke dag telt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poświęć trochę więcej czasu na skupienie lub sprawdź nawyki w tym tygodniu, aby uzyskać rzeczywistą analizę swojego rytmu. Liczy się każdy dzień!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúna mais tempo para se concentrar ou marque hábitos esta semana para obter uma análise real do seu ritmo. Cada dia conta!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúna mais tempo para se concentrar ou marque hábitos esta semana para obter uma análise real do seu ritmo. Cada dia conta!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите больше времени на концентрацию или отметьте привычки на этой неделе, чтобы получить реальный анализ своего ритма. Каждый день имеет значение!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritiminizin gerçek bir analizini elde etmek için bu hafta biraz daha odaklanma zamanı toplayın veya alışkanlıklarınızı kontrol edin. Her gün önemlidir!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周收集更多的专注时间或检查习惯，以真正分析您的节奏。每一天都很重要！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週收集更多的專注時間或檢查習慣，以真正分析您的節奏。每一天都很重要！"
          }
        }
      }
    },
    "smart.weekly.desc.stable_low": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die absolute Menge an erledigten Aufgaben ist zwar noch gering, aber deine Beständigkeit ist hervorragend. Du vermeidest extreme Schwankungen, was der perfekte Nährboden für langfristige Routinen ist. Baue nächste Woche sanft darauf auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The absolute amount of completed tasks is still low, but your consistency is excellent. You avoid extreme fluctuations, which is the perfect breeding ground for long-term routines. Build gently on it next week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cantidad absoluta de tareas completadas es aún pequeña, pero su consistencia es excelente. Evitas fluctuaciones extremas, lo que es el caldo de cultivo perfecto para rutinas de larga duración. Continúe con esto suavemente la próxima semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre absolu de tâches accomplies est encore faible, mais votre cohérence est excellente. Vous évitez les fluctuations extrêmes, ce qui constitue un terrain idéal pour les routines à long terme. Construisez là-dessus en douceur la semaine prochaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण किए गए कार्यों की कुल संख्या अभी भी कम है, लेकिन आपकी निरंतरता उत्कृष्ट है। आप अत्यधिक उतार-चढ़ाव से बचते हैं, जो दीर्घकालिक दिनचर्या के लिए आदर्श प्रजनन भूमि है। अगले सप्ताह इस पर धीरे से काम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quantità assoluta di attività completate è ancora piccola, ma la coerenza è eccellente. Eviti fluttuazioni estreme, che sono il terreno fertile perfetto per routine a lungo termine. Costruiscilo delicatamente la prossima settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したタスクの絶対量はまだ少ないですが、一貫性は優れています。長期的なルーチンの完璧な温床となる極端な変動を避けます。来週はこれをゆっくりと積み上げていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 작업의 절대적인 양은 여전히 ​​적지만 일관성은 뛰어납니다. 장기적인 루틴을 위한 완벽한 온상인 극단적인 변동을 피할 수 있습니다. 다음 주에 이것을 부드럽게 구축하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het absolute aantal voltooide taken is nog steeds klein, maar uw consistentie is uitstekend. Je vermijdt extreme schommelingen, wat de perfecte voedingsbodem is voor langdurige routines. Bouw hier volgende week voorzichtig op voort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całkowita liczba wykonanych zadań jest wciąż niewielka, ale Twoja konsekwentność jest doskonała. Unikasz ekstremalnych wahań, co jest idealną pożywką dla długotrwałych rutyn. Opieraj się na tym delikatnie w następnym tygodniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A quantidade absoluta de tarefas concluídas ainda é pequena, mas sua consistência é excelente. Você evita flutuações extremas, que são o terreno fértil perfeito para rotinas de longo prazo. Desenvolva isso suavemente na próxima semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A quantidade absoluta de tarefas concluídas ainda é pequena, mas sua consistência é excelente. Você evita flutuações extremas, que são o terreno fértil perfeito para rotinas de longo prazo. Desenvolva isso suavemente na próxima semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Абсолютное количество выполненных задач пока невелико, но ваша последовательность отличная. Вы избегаете резких колебаний, что является идеальной питательной средой для долгосрочного распорядка дня. Аккуратно развивайте это на следующей неделе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan görevlerin mutlak miktarı hala azdır ancak tutarlılığınız mükemmeldir. Uzun vadeli rutinler için mükemmel bir üreme alanı olan aşırı dalgalanmalardan kaçınırsınız. Gelecek hafta bunu yavaşça geliştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的任务的绝对量仍然很小，但你的一致性非常好。你可以避免极端的波动，这是长期惯例的完美滋生地。下周在此基础上温和地继续下去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的任務的絕對量仍然很小，但你的一致性非常好。你可以避免極端的波動，這是長期慣例的完美溫床。下週在此基礎上溫和地繼續下去。"
          }
        }
      }
    },
    "smart.weekly.tip.early_bird": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hakst '%@' oft erst spät ab (gegen %d Uhr). Wenn du wirklich früh aufstehen willst, lege dein Handy abends in einen anderen Raum und stelle den Wecker 30 Minuten früher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You often complete '%@' late (around %d o'clock). If you really want to wake up early, put your phone in another room in the evening and set the alarm 30 minutes earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A menudo marca '%@' tarde (alrededor de %d en punto). Si realmente quieres levantarte temprano, coloca tu teléfono en otra habitación por la noche y programa la alarma 30 minutos antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous cochez souvent '%@' en retard (vers %d heures). Si vous souhaitez vraiment vous lever tôt, placez votre téléphone dans une autre pièce le soir et réglez votre alarme 30 minutes plus tôt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अक्सर '%@' को देर से (लगभग %d बजे) चेक करते हैं। यदि आप वास्तव में जल्दी उठना चाहते हैं, तो शाम को अपना फोन दूसरे कमरे में रख दें और अपना अलार्म 30 मिनट पहले सेट कर लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesso spunti '%@' tardi (intorno alle %d). Se proprio vuoi alzarti presto, la sera metti il ​​telefono in un'altra stanza e imposta la sveglia 30 minuti prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' を遅く (%d 時頃) チェックオフすることがよくあります。どうしても早起きしたい場合は、夕方に携帯電話を別の部屋に置き、目覚ましを 30 分前にセットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 종종 '%@'을 늦게(약 %d시) 확인합니다. 정말 일찍 일어나고 싶다면 저녁에 휴대폰을 다른 방에 두고 알람을 30분 일찍 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U vinkt '%@' vaak laat af (rond %d uur). Als je echt vroeg op wilt staan, leg je telefoon dan ‘s avonds in een andere kamer en zet je wekker een half uur eerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Często zaznaczasz „%@” późno (około godziny %d). Jeśli naprawdę chcesz wstać wcześnie, odłóż telefon wieczorem do innego pokoju i ustaw budzik 30 minut wcześniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você costuma marcar '%@' tarde (por volta de %d horas). Se você realmente quiser acordar cedo, coloque o telefone em outro cômodo à noite e ajuste o alarme 30 minutos antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você costuma marcar '%@' tarde (por volta de %d horas). Se você realmente quiser acordar cedo, coloque o telefone em outro cômodo à noite e ajuste o alarme 30 minutos antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы часто отключаете «%@» поздно (около %d часов). Если вам очень хочется встать пораньше, вечером отнесите телефон в другую комнату и поставьте будильник на 30 минут раньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' işaretini sıklıkla geç (saat %d civarında) işaretlersiniz. Eğer gerçekten erken kalkmak istiyorsanız akşam telefonunuzu başka bir odaya koyun ve alarmınızı 30 dakika öncesine kurun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您经常较晚（大约 %2$d 点）检查“%1$@”。如果你真的想早起，晚上把手机放在另一个房间，并将闹钟提前 30 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您經常較晚（約 %2$d 點）檢查“%1$@”。如果你真的想早起，晚上把手機放在另一個房間，並將鬧鐘提前 30 分鐘。"
          }
        }
      }
    },
    "smart.weekly.tip.fallback_good": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Routine ist sehr stabil! Halte diese Konsistenz aufrecht, indem du deine Gewohnheiten weiterhin an feste Zeiten koppelst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your routine is very stable! Maintain this consistency by continuing to tie your habits to fixed times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tu rutina es muy estable! Mantén esta coherencia continuando vinculando tus hábitos a horarios fijos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine est très stable ! Maintenez cette cohérence en continuant à lier vos habitudes à des horaires fixes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी दिनचर्या बहुत स्थिर है! अपनी आदतों को निश्चित समय से जोड़कर इस निरंतरता को बनाए रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua routine è molto stabile! Mantieni questa coerenza continuando a legare le tue abitudini a tempi prestabiliti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのルーティンはとても安定しています！習慣を一定の時間に関連付け続けることで、この一貫性を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 루틴은 매우 안정적입니다! 습관을 고정된 시간에 계속 연결하여 이러한 일관성을 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je routine is zeer stabiel! Behoud deze consistentie door je gewoontes te blijven koppelen aan vaste tijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rutyna jest bardzo stabilna! Utrzymuj tę spójność, nadal łącząc swoje nawyki z ustalonymi godzinami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua rotina é muito estável! Mantenha essa consistência continuando a vincular seus hábitos a horários fixos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua rotina é muito estável! Mantenha essa consistência continuando a vincular seus hábitos a horários fixos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша рутина очень стабильна! Поддерживайте эту последовательность, продолжая привязывать свои привычки к фиксированному времени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutininiz çok istikrarlı! Alışkanlıklarınızı sabit zamanlara bağlamaya devam ederek bu tutarlılığı koruyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的作息很稳定！通过继续将你的习惯与固定时间联系起来来保持这种一致性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的作息很穩定！透過持續將你的習慣與固定時間連結起來來保持這種一致性。"
          }
        }
      }
    },
    "smart.weekly.tip.fallback_low": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle nächste Woche mehr Fokus-Sessions und hake Gewohnheiten ab, um präzise Tipps zu deinem Rhythmus zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect more focus sessions and check off habits next week to get precise tips on your rhythm."

    "assessment.growth.profile.macher.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist gut aufgestellt und setzt klug und diszipliniert um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are well positioned and implement smart and disciplined."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás bien posicionado y lo implementas de manera inteligente y disciplinada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes bien positionné et mettez en œuvre de manière intelligente et disciplinée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei ben posizionato e implementi in modo intelligente e disciplinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは適切な立場にあり、賢明かつ規律正しく行動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 좋은 위치에 있으며 현명하고 규율있게 실행합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent goed gepositioneerd en implementeert slim en gedisciplineerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś na dobrej pozycji, wdrażasz mądrze i zdyscyplinowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está bem posicionado e implementa de forma inteligente e disciplinada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi konumlandırılmışsınız ve akıllı ve disiplinli bir şekilde uyguluyorsunuz."
          }
        }
      }
    },

    "plant.zitronenbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe hydriert und halte Körper und Geist erfrischt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay hydrated and keep your body and mind refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente hidratado y mantén tu cuerpo y mente refrescados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez hydraté et gardez votre corps et votre esprit rafraîchis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाइड्रेटेड रहें और शरीर और मन को ताजगी बनाए रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani idratato e mantieni il tuo corpo e la tua mente rinfrescati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水分を補給し、心身をリフレッシュさせましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수분을 유지하고 몸과 마음을 상쾌하게 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf gehydrateerd en houd je lichaam en geest verfrist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostań nawodniony i utrzymaj ciało i umysł odświeżone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se hidratado e mantenha seu corpo e mente revigorados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se hidratado e mantenha seu corpo e mente revigorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставайся гидратированным и держи тело и разум свежими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su için ve bedeninizi ve zihninizi taze tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持水分充足，让身心保持清爽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持水分並保持身心清爽。"
          }
        }
      }
    },
    "plant.zuckerrohr.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zucker = das Feld bleibt sauber – Zuckerfrei + Sport"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sugar = the field stays clean – Sugar-free + Sports"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin azúcar = el campo queda limpio – Sin azúcar + deporte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sucre = le champ reste propre – Sans sucre + Sport"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई शक्कर नहीं = खेत साफ रहता है – बिना शक्कर + ورزش"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente zucchero = il campo resta pulito – senza zucchero + sport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "砂糖不使用 = フィールドはきれいなまま – 砂糖不使用 + スポーツ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설탕 없음 = 현장이 깨끗하게 유지됨 - 무설탕 + 스포츠"
          }

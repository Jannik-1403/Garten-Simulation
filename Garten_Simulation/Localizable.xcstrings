        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc815\uc6d0\uc758 \uc8fc\uc694 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?"

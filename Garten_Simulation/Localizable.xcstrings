    "onboarding_notification_mock_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen können Hinweise, Töne und Symbolzähler sein. Diese können in den Einstellungen konfiguriert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications may include alerts, sounds, and icon badges. These can be configured in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones pueden incluir alertas, sonidos y globos. Estos se pueden configurar en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications peuvent inclure des alertes, des sons et des pastilles d'icône. Vous pouvez les configurer dans les Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं में अलर्ट, ध्वनियां और आइकन बैज शामिल हो सकते हैं। इन्हें सेटिंग्स में कॉन्फ़िगर किया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche possono includere avvisi, suoni e badge icona. Puoi configurarli in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知には、警告、サウンド、アイコンバッジが含まれる場合があります。これらは「設定」で構成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에는 경고, 사운드 및 아이콘 배지가 포함될 수 있습니다. 설정에서 구성할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen kunnen waarschuwingen, geluiden en badges bevatten. Deze kunnen worden geconfigureerd in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia mogą zawierać alerty, dźwięki i plakietki. Możesz to skonfigurować w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações podem incluir alertas, sons e avisos nos ícones. Estes podem ser configurados em Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações podem incluir alertas, sons e avisos nos ícones. Estes podem ser configurados em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления могут включать предупреждения, звуки и наклейки на значках. Их можно настроить в Настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler; uyarılar, sesler ve simge işaretleri içerebilir. Bunlar Ayarlar'dan yapılandırılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知可能包括提醒、声音和图标标记。这些可以在“设置”中配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知可能包含提示、聲音和圖像標記。這些可在「設定」中設定。"
          }
        }
      }
    },

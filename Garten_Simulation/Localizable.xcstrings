    "paywall.feature.health.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde deine Bewegung mit deinem Fokus. Dein K\u00f6rper und dein Geist wachsen synchron."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your movement with your focus. Your body and mind grow in sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu movimiento con tu enfoque. Tu cuerpo y mente crecen en sincron\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte ton mouvement \u00e0 ta concentration. Ton corps et ton esprit grandissent en synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0906\u0902\u0926\u094b\u0932\u0928 \u0915\u094b \u0905\u092a\u0928\u0947 \u092b\u094b\u0915\u0938 \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0914\u0930 \u0906\u092a\u0915\u093e \u0926\u093f\u092e\u093e\u0917 \u090f\u0915 \u0938\u093e\u0925 \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il tuo movimento alla tua concentrazione. Corpo e mente crescono in sintonia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u904b\u52d5\u3068\u96c6\u4e2d\u529b\u3092\u7d50\u3073\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u5fc3\u3068\u4f53\u304c\u540c\u8abf\u3057\u3066\u6210\u9577\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6c0\uc9c1\uc784\uacfc \uc9d1\uc911\ub825\uc744 \uc5f0\uacb0\ud558\uc138\uc694. \ubab8\uacfc \ub9c8\uc74c\uc774 \ub3d9\uae30\ud654\ub418\uc5b4 \uc131\uc7a5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind je beweging met je focus. Je lichaam en geest groeien synchroon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po\u0142\u0105cz sw\u00f3j ruch z koncentracj\u0105. Twoje cia\u0142o i umys\u0142 rosn\u0105 w synchronizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu movimento com seu foco. Seu corpo e mente crescem em sincronia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0435\u0434\u0438\u043d\u044f\u0439 \u0441\u0432\u043e\u0451 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0441 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e. \u0422\u0432\u043e\u0451 \u0442\u0435\u043b\u043e \u0438 \u0443\u043c \u0440\u0430\u0441\u0442\u0443\u0442 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketini odaklanmanla birle\u015ftir. Bedenin ve zihnin senkronize bir \u015fekilde b\u00fcy\u00fcr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u60a8\u7684\u8fd0\u52a8\u4e0e\u4e13\u6ce8\u529b\u7ed3\u5408\u3002\u60a8\u7684\u8eab\u5fc3\u540c\u6b65\u6210\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u4f60\u7684\u52d5\u4f5c\u8207\u4f60\u7684\u6ce8\u610f\u529b\u9023\u7d50\u8d77\u4f86\u3002\u4f60\u7684\u8eab\u9ad4\u548c\u4f60\u7684\u601d\u60f3\u540c\u6b65\u6210\u9577\u3002"
          }
        }
      }
    },

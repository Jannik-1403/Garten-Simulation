    "trash.doener_dauerkarte.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänge deinen liebsten gesunden Snack gut sichtbar in der Küche auf."
          }
        },
        "en": {

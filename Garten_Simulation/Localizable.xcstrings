    "tour_4_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel schaltest du frei, wenn du eine Pflanze auf das Diamond-Level upgradest. Du erhältst dann einen speziellen Spieltitel von dieser Pflanze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You unlock titles when you upgrade a plant to the Diamond level. You will then receive a special game title from that plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueas títulos cuando mejoras una planta al nivel Diamante. Luego recibirás un título de juego especial de esa planta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous débloquez des titres lorsque vous améliorez une plante au niveau Diamant. Vous recevrez alors un titre de jeu spécial de cette plante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप शीर्षक को तभी अनलॉक कर सकते हैं जब आप किसी पौधे को डायमंड-लेवल पर अपग्रेड करते हैं। इसके बाद आपको उस पौधे से विशेष खेल शीर्षक प्राप्त होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocchi i titoli quando potenzi una pianta al livello Diamante. Riceverai quindi uno speciale titolo di gioco da quella pianta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物をダイヤモンドレベルにアップグレードするとタイトルがアンロックされます。その後、その植物から特別なゲームタイトルを受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물을 다이아몬드 레벨로 업그레이드하면 타이틀이 잠금 해제됩니다. 그런 다음 해당 식물에서 특별한 게임 타이틀을 받게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ontgrendelt titels wanneer je een plant upgradet naar het Diamond-niveau. Je ontvangt dan een speciale speltitel van die plant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowujesz tytuły, gdy ulepszasz roślinę do poziomu Diamentowego. Otrzymasz wtedy specjalny tytuł gry z tej rośliny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você desbloqueia títulos ao atualizar uma planta para o nível Diamante. Você então receberá um título de jogo especial dessa planta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você desbloqueia títulos ao atualizar uma planta para o nível Diamante. Você então receberá um título de jogo especial dessa planta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы открываете титулы, когда повышаете растение до уровня Diamond. После этого вы получите специальное игровое название от этого завода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkiyi Elmas seviyesine yükselttiğinizde unvanların kilidini açarsınız. Daha sonra o bitkiden özel bir oyun unvanı alacaksınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您将植物升级到钻石级别时，您可以解锁头衔。然后，您将从该工厂收到一个特殊的游戏名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您將植物升級到鑽石等級時，您可以解鎖頭銜。然後，您將從該工廠收到一個特殊的遊戲名稱。"
          }
        }
      }
    },

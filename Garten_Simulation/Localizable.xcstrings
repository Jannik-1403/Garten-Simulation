    "tour_plant_streak_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du den aktuellen Streak und die XP dieser spezifischen Pflanze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see the current streak and XP of this specific plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes ver la racha actual y los XP de esta planta en específico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, vous pouvez voir la séquence actuelle et l'XP de cette plante spécifique."
          }
        },
        "it": {

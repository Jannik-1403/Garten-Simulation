        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위대한 일의 시작. 당신의 개인적인 목표가 기다리고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het begin van iets groots. Jouw persoonlijke doel wacht op je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Początek czegoś wielkiego. Twój osobisty cel czeka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de algo grande. O teu objetivo pessoal espera por ti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika bir şeyin başlangıcı. Kişisel hedefiniz sizi bekliyor."
          }
        }
      }
    },
    "pfad_fehlt_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel erreicht! Du hast bewiesen was in dir steckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal reached! You have proven what you are made of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Meta alcanzada! Has demostrado de qué estás hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif atteint ! Tu as prouvé de quoi tu es capable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiettivo raggiunto! Hai dimostrato di che pasta sei fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標達成！あなたは自分が何でできているかを証明しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 달성! 당신은 당신이 무엇으로 만들어졌는지 증명했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doel bereikt! Je hebt bewezen waar je van gemaakt bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel osiągnięty! Udowodniłeś, na co cię stać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo alcançado! Provaste do que és capaz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefe ulaşıldı! Neyden yaratıldığınızı kanıtladınız."
          }
        }
      }
    },
    "pfad_fehlt_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib dran an deinem Ziel. Du bist fast da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay focused on your goal. You are almost there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente enfocado en tu meta. Casi estás ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste concentré sur ton objectif. Tu y es presque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani concentrato sul tuo obiettivo. Ci sei quasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標に集中してください。もうすぐそこです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표에 계속 집중하세요. 거의 다 왔습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf gefocust op je doel. Je bent er bijna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoncentruj się na swoim celu. Już prawie jesteś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-te focado no teu objetivo. Estás quase lá."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinize odaklanın. Neredeyse oradasın."
          }
        }
      }
    },
    "pfad_fit_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {

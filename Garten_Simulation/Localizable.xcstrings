            "value": "레몬 물로 대체하세요 – 전날 저녁에 미리 준비하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang het door water + citroen – zet het al 's avonds klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp go wodą + cytryną – przygotuj go już wieczorem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua por água + limão – prepare já na noite anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua por água + limão – prepare já na noite anterior."
          }
        },
        "ru": {

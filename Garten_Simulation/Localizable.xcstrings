    "assessment.finance.q10" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Krypto/Aktien für 1.000€ gekauft. Es ist nur noch 200€ wert und das Projekt ist offensichtlich gescheitert. Was machst du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You bought crypto/stocks for €1,000. It is only worth €200 and the project has obviously failed. What are you doing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compraste criptomonedas/acciones por 1.000 €. Sólo vale 200€ y el proyecto evidentemente ha fracasado. ¿Qué estás haciendo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez acheté des crypto/actions pour 1 000 €. Cela ne vaut que 200 € et le projet a visiblement échoué. Que fais-tu?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने €1,000 में क्रिप्टो/स्टॉक खरीदे। इसकी कीमत केवल €200 है और परियोजना स्पष्ट रूप से विफल रही है। आप क्या कर रहे हो?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai acquistato criptovalute/azioni per € 1.000. Vale solo 200 euro e il progetto è ovviamente fallito. Cosa fai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは仮想通貨/株式を 1,000 ユーロで購入しました。たった 200 ユーロの価値しかなく、このプロジェクトは明らかに失敗しました。何してるの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하는 암호화폐/주식을 €1,000에 구매했습니다. 가격은 €200에 불과하며 이 프로젝트는 분명히 실패했습니다. 뭐하세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt crypto/aandelen gekocht voor € 1.000. Het kost slechts €200,- en het project is duidelijk mislukt. Wat ben je aan het doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kupiłeś kryptowaluty/akcje za 1000 €. Jest wart tylko 200 euro i projekt najwyraźniej się nie powiódł. Co robisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você comprou criptomoedas/ações por € 1.000. Vale apenas 200€ e o projecto falhou obviamente. O que você está fazendo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты купил криптовалюту/акции на 1000€. Сейчас они стоят только 200€, и проект очевидно провалился. Что ты будешь делать?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.000 € karşılığında kripto/hisse satın aldınız. Sadece 200€ değerinde ve proje açıkça başarısız oldu. Ne yapıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你花了1000欧元买了加密货币/股票。现在只值200欧元，而且这个项目显然失败了。你会怎么做？"
          }

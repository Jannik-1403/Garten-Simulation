    "fitness.sleep.detail.warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas weniger als empfohlen. Versuche heute früher schlafen zu gehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little less than recommended. Try to go to sleep earlier today."
          }
        },
        "es": {

    "plant.palme.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht in der W\u00e4rme, braucht weite Horizonte \u2013 Abenteuer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stands in the heat, needs wide horizons \u2013 Adventure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguanta el calor, necesita amplios horizontes \u2013 Aventura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9siste \u00e0 la chaleur, a besoin de vastes horizons \u2013 Aventure"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0930\u094d\u092e\u0940 \u092e\u0947\u0902 \u0916\u0921\u093c\u093e \u0930\u0939\u0924\u093e \u0939\u0948, \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0915\u094d\u0937\u093f\u0924\u093f\u091c \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948 \u2013 \u0938\u093e\u0939\u0938\u093f\u0915"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stands in the heat, needs wide horizons \u2013 Adventure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6691\u3055\u306e\u4e2d\u306b\u7acb\u3064\u306b\u306f\u5e83\u3044\u8996\u91ce\u304c\u5fc5\u8981 \u2013 \u5192\u967a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub354\uc704 \uc18d\uc5d0\uc11c\ub3c4 \ub113\uc740 \uc2dc\uc57c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4 - \ubaa8\ud5d8"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat in de hitte, heeft een brede horizon nodig \u2013 Avontuur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoi w upale, potrzebuje szerokich horyzont\u00f3w \u2013 Przygoda"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suporta o calor, precisa de horizontes vastos \u2013 Aventura"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u043e\u0438\u0442 \u043d\u0430 \u0441\u043e\u043b\u043d\u0446\u0435, \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u0448\u0438\u0440\u043e\u043a\u0438\u0445 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u0445 \u2013 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131cakta duruyor, geni\u015f ufuklara ihtiya\u00e7 duyuyor \u2013 Macera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u957f\u5728\u6e29\u6696\u4e4b\u5730\uff0c\u9700\u8981\u5e7f\u9614\u7684\u89c6\u91ce \u2013 \u5192\u9669"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ad9\u5728\u6eab\u6696\u4e2d\uff0c\u9700\u8981\u5ee3\u95ca\u7684\u8996\u91ce\uff0d\u5192\u96aa"
          }
        }
      }
    },

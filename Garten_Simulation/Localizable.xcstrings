        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The muscles need a break. A brisk walk or a stretching session is enough today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músculos necesitan un descanso. Hoy basta con una caminata rápida o una sesión de estiramientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les muscles ont besoin d'une pause. Une marche rapide ou une séance d’étirements suffisent aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मांसपेशियों को ब्रेक की जरूरत होती है. आज तेज़ सैर या स्ट्रेचिंग सेशन ही काफी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I muscoli hanno bisogno di una pausa. Oggi è sufficiente una camminata veloce o una seduta di stretching."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉には休憩が必要です。今日は早歩きやストレッチをするだけで十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근육에는 휴식이 필요합니다. 오늘은 빠르게 산책하거나 스트레칭을 하는 것으로 충분합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spieren hebben een pauze nodig. Een stevige wandeling of een stretchsessie zijn vandaag voldoende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mięśnie potrzebują przerwy. Dziś wystarczy szybki spacer lub sesja rozciągająca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os músculos precisam de uma pausa. Uma caminhada rápida ou uma sessão de alongamento são suficientes hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os músculos precisam de uma pausa. Uma caminhada rápida ou uma sessão de alongamento são suficientes hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышцам нужен отдых. Сегодня достаточно быстрой прогулки или тренировки на растяжку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasların dinlenmeye ihtiyacı var. Bugün tempolu bir yürüyüş veya esneme seansı yeterlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肌肉需要休息。今天快走或伸展运动就足够了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "肌肉需要休息。今天快走或伸展運動就夠了。"
          }
        }
      }
    },

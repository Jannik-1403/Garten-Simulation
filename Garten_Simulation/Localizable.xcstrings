    "tour_coins_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du deine Münzen. Klicke darauf, wenn du bei Bedarf weitere kaufen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see your coins. Click on them if you want to buy more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes ver tus monedas. Haz clic en ellas si quieres comprar más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici vos pièces. Cliquez dessus si vous souhaitez en acheter plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco le tue monete. Cliccaci sopra se vuoi acquistarne altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにコインがあります。さらに購入したい場合はクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 코인이 있습니다. 더 구매하고 싶다면 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zie je je munten. Klik erop als je er meer wilt kopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto twoje monety. Kliknij na nie, jeśli chcesz kupić więcej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui estão suas moedas. Clique nelas se quiser comprar mais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

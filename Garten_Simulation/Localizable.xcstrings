          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u044b\u0433\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u0438 \u0441\u043e\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043e\u043f\u044b\u0442"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

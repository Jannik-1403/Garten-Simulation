    "plant.feigenbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht Pausen um zu tragen \u2013 Intervallfasten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs breaks to bear fruit \u2013 Intermittent fasting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita descansos para dar frutos \u2013 Ayuno intermitente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A besoin de pauses pour donner des fruits \u2013 Je\u00fbne intermittent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u094d\u0930\u0947\u0915 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948 \u2013 \u0905\u0902\u0924\u0930\u093e\u0932 \u0909\u092a\u0935\u093e\u0938"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs breaks to bear fruit \u2013 Intermittent fasting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9f\u3092\u7d50\u3076\u306b\u306f\u4f11\u61a9\u304c\u5fc5\u8981 \u2013 \u65ad\u7d9a\u7684\u306a\u65ad\u98df"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5f4\ub9e4\ub97c \ub9fa\uc73c\ub824\uba74 \ud734\uc2dd\uc774 \ud544\uc694\ud558\ub2e4 \u2013 \uac04\ud5d0\uc801 \ub2e8\uc2dd"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft pauzes nodig om vrucht te dragen \u2013 Intermitterend vasten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebuje przerw, aby przynie\u015b\u0107 owoce \u2013 post przerywany"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de pausas para dar frutos \u2013 Jejum intermitente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0443\u0436\u043d\u044b \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u044b, \u0447\u0442\u043e\u0431\u044b \u043d\u043e\u0441\u0438\u0442\u044c \u2013 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044c\u043d\u043e\u0435 \u0433\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meyve vermek i\u00e7in molalara ihtiya\u00e7 var \u2013 Aral\u0131kl\u0131 oru\u00e7"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u4f11\u606f\u624d\u80fd\u7ed3\u679c \u2013 \u95f4\u6b47\u6027\u7981\u98df"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u4f11\u606f\u4f86\u652f\u6490\uff0d\u9593\u6b47\u6027\u65b7\u98df"
          }
        }
      }
    },

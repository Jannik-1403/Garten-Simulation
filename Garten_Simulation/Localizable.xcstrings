    "body.tracking.unrealistic_desc_adaptive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dein Ziel zu erreichen, musst du ca. %1$.2f %2$@ pro Woche %3$@. Das ist zu schnell. Versuche, den Zeitraum auf mindestens %4$d Wochen anzupassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reach your goal, you need approx. %1$.2f %2$@ per week to %3$@. This is too fast. Try to extend the timeframe to at least %4$d weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para alcanzar tu objetivo, necesitas aprox. %1$.2f %2$@ por semana para %3$@. Esto es demasiado rápido. Intenta extender el plazo a al menos %4$d semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour atteindre votre objectif, vous avez besoin d'environ %1$.2f %2$@ par semaine pour %3$@. C'est trop rapide. Essayez de prolonger le délai à au moins %4$d semaines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लक्ष्य तक पहुँचने के लिए आपको लगभग %1$.2f %2$@ प्रति सप्ताह %3$@ खर्च करना होगा। यह बहुत तेज़ है. अवधि को कम से कम %4$d सप्ताह तक समायोजित करने का प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per raggiungere il tuo obiettivo devi spendere circa %1$.2f %2$@ a settimana %3$@. E' troppo veloce. Prova a modificare il periodo ad almeno %4$d settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標を達成するには、1 週間あたり約 %1$.2f %2$@ %3$@ を費やす必要があります。それは速すぎます。期間を少なくとも %4$d 週間に調整してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 달성하려면 주 %3$@당 약 %1$.2f %2$@을 지출해야 합니다. 너무 빠르네요. 기간을 최소 %4$d주로 조정해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om uw doel te bereiken moet u ongeveer %1$.2f %2$@ per week %3$@ uitgeven. Dat is te snel. Probeer de periode aan te passen naar minimaal %4$d weken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby osiągnąć swój cel, musisz wydać około %1$.2f %2$@ tygodniowo %3$@. To za szybko. Spróbuj dostosować ten okres do co najmniej %4$d tygodni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para atingir sua meta, você precisa gastar aproximadamente %1$.2f %2$@ por semana %3$@. Isso é muito rápido. Tente ajustar o período para pelo menos %4$d semanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para atingir sua meta, você precisa gastar aproximadamente %1$.2f %2$@ por semana %3$@. Isso é muito rápido. Tente ajustar o período para pelo menos %4$d semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы достичь цели, вам нужно примерно %1$.2f %2$@ в неделю, чтобы %3$@. Это слишком быстро. Попробуйте увеличить срок как минимум до %4$d недель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinize ulaşmak için haftada yaklaşık %1$.2f %2$@ %3$@ harcamanız gerekir. Bu çok hızlı. Dönemi en az %4$d haftaya ayarlamaya çalışın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了实现您的目标，您需要每周花费大约 %1$.2f %2$@ %3$@。这太快了。尝试将时间段调整为至少 %4$d 周。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了實現您的目標，您需要每週花費約 %1$.2f %2$@ %3$@。這太快了。嘗試將時間段調整為至少 %4$d 週。"
          }
        }
      }
    },

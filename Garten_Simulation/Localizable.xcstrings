        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0a\u91cd\uff0d\u4f60\u5df2\u7d93\u9054\u5230\u4f60\u7684\u76ee\u6a19\u4e86\uff01"
          }
        }
      }
    },
    "retention.frage2.nichtMehrNoetig.sub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht gibt es neue Gewohnheiten die du aufbauen m\u00f6chtest?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maybe there are new habits you'd like to build?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQuiz\u00e1s hay nuevos h\u00e1bitos que te gustar\u00eda construir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut-\u00eatre y a-t-il de nouvelles habitudes que tu voudrais d\u00e9velopper ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092f\u0926 \u0915\u0941\u091b \u0928\u0908 \u0906\u0926\u0924\u0947\u0902 \u0939\u0948\u0902 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0906\u092a \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maybe there are new habits you'd like to build?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3082\u3057\u304b\u3057\u305f\u3089\u3001\u8eab\u306b\u4ed8\u3051\u305f\u3044\u65b0\u3057\u3044\u7fd2\u6163\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\uca4c\uba74 \ub2f9\uc2e0\uc774 \ub9cc\ub4e4\uace0 \uc2f6\uc740 \uc0c8\ub85c\uc6b4 \uc2b5\uad00\uc774 \uc788\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Misschien zijn er nieuwe gewoonten die je graag zou willen ontwikkelen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mo\u017ce s\u0105 jakie\u015b nowe nawyki, kt\u00f3re chcia\u0142by\u015b wypracowa\u0107?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez haja novos h\u00e1bitos que gostasses de desenvolver?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0435\u0441\u0442\u044c \u043d\u043e\u0432\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u044b \u0445\u043e\u0442\u0435\u043b \u0431\u044b \u0432\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belki olu\u015fturmak istedi\u011fin yeni al\u0131\u015fkanl\u0131klar vard\u0131r?"
          }
        },
        "zh-Hans": {

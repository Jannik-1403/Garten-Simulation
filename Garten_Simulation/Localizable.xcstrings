    "onboarding_zeit_erklaerung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst täglich eine Erinnerung zu dieser Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will receive a daily reminder at this time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un recordatorio diario a esta hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recevras un rappel quotidien à cette heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको इस समय का दैनिक अनुस्मारक प्राप्त होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai un promemoria quotidiano di questo orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時点で毎日リマインダーが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이때 매일 알림을 받게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U ontvangt op dit moment dagelijks een herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O tej porze będziesz otrzymywać codzienne przypomnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Receberás um lembrete diário a esta hora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receberás um lembrete diário a esta hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты получаешь напоминание в это время каждый день."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda günlük bir hatırlatma alacaksınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你每天都会在这个时间收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您將收到有關該時間的每日提醒。"
          }
        }
      }
    },

    "plant.efeu.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe flexibel und beuge Verspannungen durch t\u00e4gliches Dehnen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay flexible and prevent tension through daily stretching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente flexible y previene la tensi\u00f3n mediante estiramientos diarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez flexible et pr\u00e9venez les tensions gr\u00e2ce \u00e0 des \u00e9tirements quotidiens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u091a\u0940\u0932\u093e \u092c\u0928\u0947 \u0930\u0939\u0947\u0902 \u0914\u0930 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0938\u094d\u091f\u094d\u0930\u0947\u091a\u093f\u0902\u0917 \u0915\u0930\u0915\u0947 \u0924\u0928\u093e\u0935 \u0915\u094b \u0930\u094b\u0915\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani flessibile e previeni le tensioni attraverso lo stretching quotidiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u306e\u30b9\u30c8\u30ec\u30c3\u30c1\u3067\u67d4\u8edf\u6027\u3092\u4fdd\u3061\u3001\u7dca\u5f35\u3092\u9632\u304e\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c\uc758 \uc2a4\ud2b8\ub808\uce6d\uc744 \ud1b5\ud574 \uc720\uc5f0\uc131\uc744 \uc720\uc9c0\ud558\uace0 \uae34\uc7a5\uc744 \uc608\ubc29\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf flexibel en voorkom spanningen door dagelijks te strekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozosta\u0144 elastyczny i zapobiegaj napi\u0119ciom dzi\u0119ki codziennemu rozci\u0105ganiu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se flex\u00edvel e evite tens\u00f5es atrav\u00e9s de alongamentos di\u00e1rios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0433\u0438\u0431\u043a\u0438\u043c \u0438 \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0439 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0440\u0430\u0441\u0442\u044f\u0436\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnek kal\u0131n ve g\u00fcnl\u00fck esneme hareketleriyle gerginli\u011fi \u00f6nleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u7075\u6d3b\uff0c\u901a\u8fc7\u6bcf\u65e5\u62c9\u4f38\u9884\u9632\u7d27\u5f20\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u9032\u884c\u4f38\u5c55\u904b\u52d5\uff0c\u4fdd\u6301\u9748\u6d3b\u6027\u4e26\u9632\u6b62\u7dca\u5f35\u3002"
          }
        }
      }
    },
    "plant.eiche.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4chst langsam, wird \u00fcber Jahrzehnte massiv und weise"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows slowly, becomes massive and wise over decades"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece lento, se vuelve masivo y sabio con las d\u00e9cadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse lentement, devient massif et sage au fil des d\u00e9cennies"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u092c\u0922\u093c\u0924\u093e \u0939\u0948, \u0926\u0936\u0915\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0936\u093e\u0932 \u0914\u0930 \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u093e\u0928 \u092c\u0928\u0924\u093e \u0939\u0948"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows slowly, becomes massive and wise over decades"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3086\u3063\u304f\u308a\u3068\u6210\u9577\u3057\u3001\u6570\u5341\u5e74\u304b\u3051\u3066\u5de8\u5927\u304b\u3064\u8ce2\u304f\u306a\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc218\uc2ed \ub144\uc5d0 \uac78\uccd0 \ucc9c\ucc9c\ud788 \uc131\uc7a5\ud558\uace0 \uac70\ub300\ud574\uc9c0\uace0 \ud604\uba85\ud574\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit langzaam, wordt in de loop van tientallen jaren enorm en wijs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015bnie powoli, przez dziesi\u0119ciolecia staje si\u0119 masywny i m\u0105dry"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce devagar, torna-se massivo e s\u00e1bio ao longo de d\u00e9cadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u0442 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043c\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u043c \u0438 \u043c\u0443\u0434\u0440\u044b\u043c \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u0438\u0439"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yava\u015f yava\u015f b\u00fcy\u00fcr, onlarca y\u0131l i\u00e7inde devasa ve bilge hale gelir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f13\u6162\u751f\u957f\uff0c\u6570\u5341\u5e74\u540e\u53d8\u5f97\u7c97\u58ee\u800c\u667a\u6167"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e7e\u5341\u5e74\u5f8c\u6162\u6162\u6210\u9577\uff0c\u8b8a\u5f97\u9f90\u5927\u53c8\u8070\u660e"
          }
        }
      }
    },

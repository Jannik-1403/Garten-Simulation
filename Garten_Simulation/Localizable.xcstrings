    "assessment.growth.profile.aufgeber.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir fehlt die Disziplin, wenn es hart wird. Baue Durchhaltevermögen auf, indem du Dinge zu Ende bringst, auch wenn die Motivation weg ist."
          }

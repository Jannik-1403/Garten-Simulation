    "prog_deepwork_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume vor dem Arbeiten physisch deinen Tisch auf. Visuelle Unordnung frisst unbewusst kognitive Kapazität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Physically clear your table before working. Visual clutter subconsciously eats up cognitive capacity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia físicamente tu mesa antes de trabajar. El desorden visual devora inconscientemente la capacidad cognitiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débarrassez physiquement votre table avant de travailler. Le désordre visuel ronge inconsciemment les capacités cognitives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम करने से पहले अपनी टेबल को भौतिक रूप से साफ़ करें। दृश्य अव्यवस्था अवचेतन रूप से संज्ञानात्मक क्षमता को नष्ट कर देती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota fisicamente il tavolo prima di lavorare. Il disordine visivo divora inconsciamente la capacità cognitiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業する前にテーブルを物理的に片づけてください。視覚的な混乱は無意識のうちに認知能力を消耗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업하기 전에 테이블을 물리적으로 치우십시오. 시각적 혼란은 무의식적으로 인지 능력을 소모합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim uw tafel fysiek af voordat u gaat werken. Visuele rommel vreet onbewust cognitieve capaciteit op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed pracą oczyść fizycznie swój stół. Wizualny bałagan podświadomie zżera zdolności poznawcze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe fisicamente sua mesa antes de trabalhar. A desordem visual subconscientemente consome a capacidade cognitiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe fisicamente sua mesa antes de trabalhar. A desordem visual subconscientemente consome a capacidade cognitiva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Физически очистите свой стол перед работой. Визуальный беспорядок подсознательно съедает когнитивные способности."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışmadan önce masanızı fiziksel olarak temizleyin. Görsel karmaşa bilinçaltında bilişsel kapasiteyi tüketir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作前先清理一下桌子。视觉混乱会下意识地消耗认知能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作前先清理一下桌子。視覺混亂會下意識地消耗認知能力。"
          }
        }
      }
    },

        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u091a\u0947\u0924\u0928\u0924\u093e \u0915\u093e \u090f\u0915 \u0938\u092a\u094d\u0924\u093e\u0939"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana di consapevolezza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u9031\u9593\u306e\u30de\u30a4\u30f3\u30c9\u30d5\u30eb\u30cd\u30b9"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc8fc\uc77c\uc758 \ub9c8\uc74c\ucc59\uae40"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u00e9n week mindfulness"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tydzie\u0144 uwa\u017cno\u015bci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semana de consci\u00eancia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0434\u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044f \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0441\u0442\u0438"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Hafta Fark\u0131ndal\u0131k"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u5468\u6b63\u5ff5"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u9031\u7684\u6b63\u5ff5"
          }
        }
      }
    },
    "pfad_mental_day_14_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Wochen Achtsamkeit. Du wirkst gelassener."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two weeks of mindfulness. You seem more composed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos semanas de atenci\u00f3n plena. Pareces m\u00e1s sereno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux semaines de pleine conscience. Tu sembles plus serein."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0940 \u0938\u091a\u0947\u0924\u0928\u0924\u093e\u0964 \u0906\u092a \u0905\u0927\u093f\u0915 \u0906\u0930\u093e\u092e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due settimane di consapevolezza. Sembri pi\u00f9 sereno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2\u9031\u9593\u306e\u30de\u30a4\u30f3\u30c9\u30d5\u30eb\u30cd\u30b9\u3002\u3042\u306a\u305f\u306f\u3082\u3063\u3068\u843d\u3061\u7740\u3044\u3066\u3044\u308b\u3088\u3046\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2\uc8fc\uac04\uc758 \ub9c8\uc74c\ucc59\uae40. \ub2f9\uc2e0\uc740 \uc880 \ub354 \ucc28\ubd84\ud574 \ubcf4\uc774\ub294\ub370\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee weken mindfulness. Je lijkt meer beheerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa tygodnie uwa\u017cno\u015bci. Wydajesz si\u0119 bardziej opanowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas semanas de consci\u00eancia. Pareces mais calmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0432\u0435 \u043d\u0435\u0434\u0435\u043b\u0438 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0441\u0442\u0438. \u0422\u044b \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0448\u044c \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ki haftal\u0131k fark\u0131ndal\u0131k. Daha sakin g\u00f6r\u00fcn\u00fcyorsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e24\u5468\u6b63\u5ff5\u3002\u4f60\u770b\u8d77\u6765\u66f4\u4ece\u5bb9\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5169\u9031\u7684\u6b63\u5ff5\u3002\u4f60\u770b\u8d77\u4f86\u66f4\u653e\u9b06\u4e86\u3002"
          }
        }
      }
    },

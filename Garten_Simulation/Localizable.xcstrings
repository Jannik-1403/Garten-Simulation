    "plant.apfelbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nähre deinen Körper mit gesunden, selbstgekochten Mahlzeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourish your body with healthy, home-cooked meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutre tu cuerpo con comidas caseras y saludables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourrissez votre corps avec des repas sains faits maison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वस्थ, घर पर बने भोजन से अपने शरीर को पोषण दें।"
          }
        },
        "it": {
          "stringUnit": {

    "prog_nutrition_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche heute drei verschiedene Farben auf deinem Teller oder über den Tag verteilt zu essen (z.B. rot, grün, orange)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try eating three different colors on your plate today or throughout the day (e.g. red, green, orange)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intente comer tres colores diferentes en su plato hoy o durante el día (por ejemplo, rojo, verde, naranja)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de manger trois couleurs différentes dans votre assiette aujourd'hui ou tout au long de la journée (par exemple rouge, vert, orange)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज या दिन भर में अपनी थाली में तीन अलग-अलग रंग खाने का प्रयास करें (जैसे लाल, हरा, नारंगी)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a mangiare tre colori diversi nel piatto oggi o durante la giornata (ad esempio rosso, verde, arancione)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日または一日を通して、お皿に 3 つの異なる色 (赤、緑、オレンジなど) を入れて食べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 또는 하루 종일 접시에 세 가지 다른 색상(예: 빨간색, 녹색, 주황색)을 먹어 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer vandaag of gedurende de dag drie verschillende kleuren op je bord te eten (bijvoorbeeld rood, groen, oranje)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj zjeść dzisiaj lub w ciągu dnia na talerzu trzy różne kolory (np. czerwony, zielony, pomarańczowy)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente comer três cores diferentes no seu prato hoje ou ao longo do dia (por exemplo, vermelho, verde, laranja)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente comer três cores diferentes no seu prato hoje ou ao longo do dia (por exemplo, vermelho, verde, laranja)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте есть на тарелке три разных цвета сегодня или в течение дня (например, красный, зеленый, оранжевый)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün veya gün boyunca tabağınızda üç farklı renk yemeyi deneyin (örneğin kırmızı, yeşil, turuncu)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天或全天尝试吃盘子里的三种不同颜色（例如红色、绿色、橙色）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天或整天嘗試吃盤子裡的三種不同顏色（例如紅色、綠色、橙色）。"
          }
        }
      }
    },

    "trash.fastfood_lieferdienst.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche Lieferdienst-Apps von deinem Startbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove delivery service apps from your home screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las apps de reparto de tu pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les applications de livraison de ton écran d'accueil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने होम स्क्रीन से डिलीवरी ऐप्स हटाएं।"
          }
        },
        "it": {
          "stringUnit": {

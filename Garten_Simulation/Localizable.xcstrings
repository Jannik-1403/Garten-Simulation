        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skończyłeś dzisiaj o %@ minut wcześniej niż wczoraj. Trzymaj tak dalej!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você terminou %@ minutos mais cedo hoje do que ontem. Continue!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün dünden %@ dakika daha erken bitirdiniz. Devam edin!"
          }
        }
      }
    },

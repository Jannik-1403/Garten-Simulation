    "prog_sleep_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Kopf rattert: Lege dir Zettel und Stift ans Bett. Schreibe alle Gedanken und To-Dos für morgen auf, damit der Kopf leer ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your head is pounding: put a piece of paper and pen on your bed. Write down all your thoughts and to-dos for tomorrow so that your mind is clear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te duele la cabeza: coloca un papel y un bolígrafo sobre tu cama. Escribe todos tus pensamientos y tareas pendientes para mañana para que tu mente esté clara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre tête vous fait mal: posez un morceau de papier et un stylo sur votre lit. Notez toutes vos pensées et choses à faire pour demain afin que votre esprit soit clair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपका सिर तेज़ हो रहा है: अपने बिस्तर पर कागज का एक टुकड़ा और कलम रखें। कल के लिए अपने सभी विचार और कार्य लिख लें ताकि आपका मन साफ़ रहे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ti martella la testa: metti un pezzo di carta e una penna sul letto. Scrivi tutti i tuoi pensieri e le cose da fare per domani in modo che la tua mente sia chiara."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭がドキドキする場合は、紙とペンをベッドの上に置きます。思考をクリアにするために、明日の考えややるべきことをすべて書き留めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리가 어지러우면 종이와 펜을 침대 위에 올려두세요. 마음이 맑아지도록 내일 할 일과 생각을 모두 적어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je hoofd bonkt: leg een stuk papier en een pen op je bed. Schrijf al je gedachten en taken voor morgen op, zodat je geest helder is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli boli Cię głowa: połóż kartkę papieru i długopis na łóżku. Zapisz wszystkie swoje myśli i zadania na jutro, aby mieć jasny umysł."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sua cabeça está latejando: coloque um pedaço de papel e uma caneta na cama. Anote todos os seus pensamentos e tarefas para amanhã para que sua mente fique clara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sua cabeça está latejando: coloque um pedaço de papel e uma caneta na cama. Anote todos os seus pensamentos e tarefas para amanhã para que sua mente fique clara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас болит голова: положите на кровать лист бумаги и ручку. Запишите все свои мысли и дела на завтра, чтобы ваш разум был ясен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğer başınız zonkluyorsa: yatağınızın üzerine bir parça kağıt ve kalem koyun. Zihninizin açık olması için yarın için tüm düşüncelerinizi ve yapılacaklarınızı yazın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的头很晕：在床上放一张纸和笔。写下你所有的想法和明天的待办事项，以便你的头脑清晰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的頭很暈：在床上放一張紙和筆。寫下你所有的想法和明天的待辦事項，以便你的頭腦清晰。"
          }
        }
      }
    },

    "tour_plant_streak_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du den aktuellen Streak und die XP dieser spezifischen Pflanze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see the current streak and XP of this specific plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqu\u00ed puedes ver la racha actual y los XP de esta planta en espec\u00edfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, vous pouvez voir la s\u00e9quence actuelle et l'XP de cette plante sp\u00e9cifique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939\u093e\u0901 \u0906\u092a \u0907\u0938 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u094c\u0927\u0947 \u0915\u0940 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0914\u0930 \u090f\u0915\u094d\u0938\u092a\u0940 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi vedere la serie attuale e l'XP di questa pianta specifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u3053\u3067\u3001\u3053\u306e\u7279\u5b9a\u306e\u690d\u7269\u306e\u73fe\u5728\u306e\u9023\u7d9a\u8a18\u9332\u3068XP\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ec\uae30\uc5d0\uc11c \uc774 \ud2b9\uc815 \uc2dd\ubb3c\uc758 \ud604\uc7ac \uc5f0\uc18d \uae30\ub85d\uacfc XP\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zie je de huidige streak en XP van deze specifieke plant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj mo\u017cesz zobaczy\u0107 obecn\u0105 pass\u0119 i XP tej konkretnej ro\u015bliny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui voc\u00ea pode ver a sequ\u00eancia atual e o XP desta planta espec\u00edfica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0434\u0435\u0441\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0443\u044e \u0441\u0435\u0440\u0438\u044e \u0438 \u043e\u043f\u044b\u0442 \u044d\u0442\u043e\u0433\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bu belirli bitkinin mevcut serisini ve XP'sini g\u00f6rebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8fd9\u91cc\u60a8\u53ef\u4ee5\u770b\u5230\u8be5\u7279\u5b9a\u690d\u7269\u7684\u5f53\u524d\u8fde\u80dc\u548c XP\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9019\u88e1\u60a8\u53ef\u4ee5\u770b\u5230\u8a72\u7279\u5b9a\u690d\u7269\u7684\u7576\u524d\u9023\u52dd\u548c XP\u3002"
          }
        }
      }
    },

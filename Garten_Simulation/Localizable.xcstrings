    "pfad_produktiv_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deinen Rhythmus. Eine fokussierte Einheit heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your rhythm. One focused session today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu ritmo. Una sesi\u00f3n enfocada hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve ton rythme. Une session concentr\u00e9e aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0932\u092f \u0916\u094b\u091c\u0947\u0902. \u0906\u091c \u090f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0938\u0924\u094d\u0930."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova il tuo ritmo. Una sessione focalizzata oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u30ea\u30ba\u30e0\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u4eca\u65e5\u306f\u96c6\u4e2d\u7684\u306a\u30bb\u30c3\u30b7\u30e7\u30f3\u304c 1 \u3064\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \ub9ac\ub4ec\uc744 \ucc3e\uc544\ubcf4\uc138\uc694. \uc624\ub298\uc740 \uc9d1\uc911 \uc138\uc158\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind jouw ritme. E\u00e9n gerichte sessie vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajd\u017a sw\u00f3j rytm. Dzisiaj jedna skupiona sesja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra o teu ritmo. Uma sess\u00e3o focada hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0439\u0434\u0438 \u0441\u0432\u043e\u0439 \u0440\u0438\u0442\u043c. \u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0435 \u0437\u0430\u043d\u044f\u0442\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritiminizi bulun. Bug\u00fcn odaklanm\u0131\u015f bir oturum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u5230\u4f60\u7684\u8282\u594f\u3002\u4eca\u5929\u8fdb\u884c\u4e00\u6b21\u4e13\u6ce8\u7ec3\u4e60\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u5230\u4f60\u7684\u7bc0\u594f\u3002\u4eca\u5929\u7684\u6703\u8b70\u662f\u96c6\u4e2d\u8a0e\u8ad6\u3002"
          }
        }
      }
    },
    "pfad_produktiv_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale Effizienz. Du beherrscht deinen Tag perfekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum efficiency. You master your day perfectly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e1xima eficiencia. Dominas tu d\u00eda perfectamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efficacit\u00e9 maximale. Tu ma\u00eetrises parfaitement ta journ\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0927\u093f\u0915\u0924\u092e \u0926\u0915\u094d\u0937\u0924\u093e. \u0906\u092a \u0905\u092a\u0928\u0947 \u0926\u093f\u0928 \u0915\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massima efficienza. Padroneggi perfettamente la tua giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u5927\u306e\u52b9\u7387\u3002\u3042\u306a\u305f\u306f\u4e00\u65e5\u3092\u5b8c\u74a7\u306b\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd5c\ub300\uc758 \ud6a8\uc728\uc131. \ub2f9\uc2e0\uc740 \ud558\ub8e8\ub97c \uc644\ubcbd\ud558\uac8c \ub9c8\uc2a4\ud130\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale effici\u00ebntie. Je beheerst je dag perfect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalna wydajno\u015b\u0107. Doskonale opanowa\u0142e\u015b sw\u00f3j dzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Efici\u00eancia m\u00e1xima. Dominas o teu dia perfeitamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c. \u0422\u044b \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0448\u044c \u0441\u0432\u043e\u0438\u043c \u0434\u043d\u0435\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum verimlilik. G\u00fcn\u00fcn\u00fcz\u00fc m\u00fckemmel bir \u015fekilde y\u00f6netiyorsunuz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u9ad8\u6548\u7387\u3002\u4f60\u5b8c\u7f8e\u638c\u63a7\u81ea\u5df1\u7684\u4e00\u5929\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u5927\u6548\u7387\u3002\u60a8\u53ef\u4ee5\u5b8c\u7f8e\u5730\u638c\u63a7\u81ea\u5df1\u7684\u4e00\u5929\u3002"
          }
        }
      }
    },
    "pfad_produktiv_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meistere deine Zeit. Fokus wird zur Gewohnheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master your time. Focus becomes a habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Domina tu tiempo. El enfoque se convierte en un h\u00e1bito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u00eetrise ton temps. La concentration devient une habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u092e\u0939\u093e\u0930\u0924 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0947\u0902. \u092b\u094b\u0915\u0938 \u090f\u0915 \u0906\u0926\u0924 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Padroneggia il tuo tempo. Il focus diventa un'abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6642\u9593\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002\u96c6\u4e2d\u529b\u304c\u7fd2\u6163\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uac04\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. \uc9d1\uc911\uc740 \uc2b5\uad00\uc774 \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheers uw tijd. Focus wordt een gewoonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opanuj sw\u00f3j czas. Koncentracja staje si\u0119 nawykiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Domina o teu tempo. O foco torna-se um h\u00e1bito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0432\u043b\u0430\u0434\u0435\u0439 \u0441\u0432\u043e\u0438\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c. \u0424\u043e\u043a\u0443\u0441 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman\u0131n\u0131za hakim olun. Odaklanmak bir al\u0131\u015fkanl\u0131k haline gelir."
          }
        },
        "zh-Hans": {

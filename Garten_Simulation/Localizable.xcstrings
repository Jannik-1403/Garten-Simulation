    },
    "assessment.fitness.q10" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist eine Woche im Urlaub oder auf einem Schul-Ausflug. Es gibt kein Gym und du hast keine Ausrüstung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are on vacation or on a school trip for a week. There is no gym and you have no equipment."
          }

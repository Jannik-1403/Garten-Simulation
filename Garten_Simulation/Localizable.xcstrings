    "assessment.mental.q3" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Wahl: Ein Job mit 4.000€ netto, bei dem du dich jeden Tag zu Tode langweilst, oder ein Job mit 2.500€ netto, der dich täglich an deine intellektuellen Grenzen bringt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have the choice: a job with €4,000 net that will bore you to death every day, or a job with €2,500 net that pushes you to your intellectual limits every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la opción: un trabajo con 4.000 € netos que te aburrirá cada día, o un trabajo con 2.500 € netos que te llevará cada día al límite intelectual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez le choix : un boulot à 4 000 € net qui vous ennuiera à mourir chaque jour, ou un boulot à 2 500 € net qui vous pousse chaque jour dans vos limites intellectuelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास विकल्प है: €4,000 नेट वाली नौकरी जो आपको हर दिन मौत के मुंह में धकेल देगी, या €2,500 नेट वाली नौकरी जो आपको हर दिन आपकी बौद्धिक सीमा तक धकेल देगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai la scelta: un lavoro da 4.000 euro netti che ti annoierà a morte ogni giorno, o un lavoro da 2.500 euro netti che ti spinge ogni giorno ai tuoi limiti intellettuali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたには選択肢があります。毎日死ぬほど退屈な純額4,000ユーロの仕事か、毎日知的限界まで追い込まれる純額2,500ユーロの仕事です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 선택할 수 있습니다: 매일 당신을 죽게 만드는 €4,000의 순익을 가진 직업, 또는 매일 당신의 지적 한계까지 밀어붙이는 €2,500의 순익을 가진 직업."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de keuze: een baan van € 4.000 netto die je elke dag doodverveelt, of een baan van € 2.500 netto die je elke dag tot het uiterste drijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz wybór: pracę za 4000 euro netto, która każdego dnia zanudzi Cię na śmierć, albo pracę za 2500 euro netto, która każdego dnia popycha Cię do granic możliwości intelektualnych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem a escolha: um emprego com 4.000 euros líquidos que o deixará entediado todos os dias, ou um trabalho com 2.500 euros líquidos que o levará ao seu limite intelectual todos os dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя есть выбор: работа с чистой зарплатой 4000 €, на которой ты каждый день умираешь от скуки, или работа с чистой зарплатой 2500 €, которая ежедневно ставит тебя перед интеллектуальными вызовами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçeneğiniz var: net 4.000 Euro'luk sizi her gün canınızı sıkacak bir iş ya da net 2.500 Euro'luk sizi her gün entelektüel sınırlarınızı zorlayan bir iş."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有选择：一份净收入4000欧元的工作，每天无聊得要死，或者一份净收入2500欧元的工作，每天都让你发挥智力极限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以選擇：淨收入為 4,000 歐元的工作，每天都會讓你厭煩得要死；或一份淨收入為 2,500 歐元的工作，每天都會把你逼到智力極限。"
          }
        }
      }
    },

    "item.duenger_blitz.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdoppelt XP f\u00fcr die n\u00e4chsten 3 Erledigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doubles XP for the next 3 completions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplica la XP de las pr\u00f3ximas 3 completaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double les XP des 3 prochaines r\u00e9alisations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0917\u0932\u0947 \u0924\u0940\u0928 \u092a\u0942\u0930\u094d\u0923\u0924\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0921\u092c\u0932 \u090f\u0915\u094d\u0938\u092a\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raddoppia gli XP per i prossimi 3 completamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b21\u306e 3 \u56de\u306e\u5b8c\u4e86\u3067 XP \u304c 2 \u500d\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c 3\ubc88 \uc644\ub8cc \uc2dc XP\uac00 \ub450 \ubc30\ub85c \ub298\uc5b4\ub0a9\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdubbelt XP voor de volgende 3 voltooiingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podwaja PD za kolejne 3 uko\u0144czenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplica o XP das pr\u00f3ximas 3 conclus\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442 XP \u0437\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 3 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki 3 tamamlamada XP'yi ikiye katlar."
          }
        },
        "zh-Hans": {

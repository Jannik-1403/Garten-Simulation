        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ドライデー」を試してみましょう。週に固定したアルコールなしの日を計画しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'건조한 날'을 시도해 보세요: 주당 고정된 금주일을 계획하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer 'Dry Days': plan vaste alcoholvrije dagen per week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj 'Dry Days': zaplanuj stałe bezalkoholowe dni w tygodniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente 'Dry Days': planeje dias sem álcool fixos por semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente 'Dry Days': planeje dias sem álcool fixos por semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте «сухие дни»: каждую неделю планируйте специальные дни без алкоголя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Kuru Günler' dene: haftada belirli alkol içilmeyecek günler planla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试“禁酒日”：每周计划专门的禁酒日。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試試「禁酒日」：每週規劃專門的禁酒日。"
          }
        }
      }
    },

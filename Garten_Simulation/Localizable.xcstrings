    "prog_selfcare_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach heute etwas, das absolut keinen produktiven Zweck hat, dir aber als Kind Freude bereitet hat (Malen, Gaming, Legos, in die Badewanne gehen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do something today that has absolutely no productive purpose but brought you joy as a child (painting, gaming, Legos, going in the bathtub)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz algo hoy que no tenga ningún propósito productivo pero que te haya traído alegría cuando eras niño (pintar, jugar, Legos, ir a la bañera)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites quelque chose aujourd'hui qui n'a absolument aucun but productif mais qui vous a apporté de la joie en tant qu'enfant (peinture, jeux, Legos, aller dans la baignoire)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कुछ ऐसा करें जिसका कोई उत्पादक उद्देश्य नहीं है लेकिन जो आपको एक बच्चे के रूप में खुशी देता है (पेंटिंग, गेमिंग, लेगो, बाथटब में जाना)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai qualcosa oggi che non ha assolutamente alcuno scopo produttivo ma che ti ha dato gioia da bambino (dipingere, giocare, i Lego, andare nella vasca da bagno)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は、生産的な目的はまったくなくても、子どもの頃に楽しかった何かをしてみましょう (絵を描く、ゲーム、レゴ、お風呂に入るなど)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 전혀 생산적인 목적은 없지만 어렸을 때 즐거움을 가져다 준 일(그림 그리기, 게임, 레고, 욕조에 들어가기)을 해보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe vandaag iets dat absoluut geen productief doel heeft, maar je als kind vreugde bracht (schilderen, gamen, Lego, in bad gaan)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób dzisiaj coś, co nie ma absolutnie żadnego produktywnego celu, ale przyniosło ci radość w dzieciństwie (malowanie, granie, klocki Lego, kąpiel w wannie)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça hoje algo que não tenha absolutamente nenhum propósito produtivo, mas que lhe trouxe alegria quando criança (pintura, jogos, Legos, ir à banheira)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça hoje algo que não tenha absolutamente nenhum propósito produtivo, mas que lhe trouxe alegria quando criança (pintura, jogos, Legos, ir à banheira)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте сегодня что-нибудь, что не имеет никакой продуктивной цели, но приносило вам радость в детстве (рисование, игры, Лего, принятие ванны)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kesinlikle üretken bir amacı olmayan ama çocukken size keyif veren bir şey yapın (resim yapmak, oyun oynamak, Legolar, küvete girmek)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天做一些绝对没有任何生产目的但能给你带来童年快乐的事情（绘画、游戏、乐高积木、泡在浴缸里）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天做一些絕對沒有任何生產目的但能帶給你童年快樂的事（繪畫、遊戲、樂高積木、泡在浴缸裡）。"
          }
        }
      }
    },

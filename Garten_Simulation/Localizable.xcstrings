    "plant.passionsblume.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blüht bei innerer Beherrschung – NoFap"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blooms with inner control – Self-discipline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Florece con control interior – Autodisciplina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleurit avec la maîtrise intérieure – Autodiscipline"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आंतरिक नियंत्रण में खिलता है – नोफैप"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiorisce con controllo interno - NoFap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内なるコントロールで開花 – 自己規律"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내면의 통제로 꽃을 피우다 - 자기 훈련"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeit met innerlijke controle – Zelfdiscipline"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnie z wewnętrzną kontrolą – Samodyscypliną"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce com controlo interior – Autodisciplina"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce com controlo interior – Autodisciplina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расцветает при внутреннем самообладании – NoFap"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İç kontrolle çiçek açar – Öz disiplin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在内心自律下绽放 – 禁欲"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綻放內在的控制力 – NoFap"
          }
        }
      }
    },

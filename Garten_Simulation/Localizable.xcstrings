        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzyma\u0142e\u015b nowe monety do sklepu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea recebeu novas moedas para a loja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043d\u043e\u0432\u044b\u0435 \u043c\u043e\u043d\u0435\u0442\u044b \u0434\u043b\u044f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430."

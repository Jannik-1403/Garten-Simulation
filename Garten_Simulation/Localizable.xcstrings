        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj serwisy streamingowe tylko na laptopie – nie na telewizorze w łóżku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use serviços de streaming apenas no laptop – não na TV na cama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use serviços de streaming apenas no laptop – não na TV na cama."
          }
        },
        "ru": {

    "wonder_water.rescue.body_format": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pflanze \"%@\" ist am Sterben. Willst du das Wunderwasser einsetzen, um sie zu retten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plant \"%@\" is dying. Do you want to use Wonder Water to save it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu planta \"%@\" se está muriendo. ¿Quieres usar el Agua Milagrosa para salvarla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta plante \"%@\" est en train de mourir. Veux-tu utiliser l'Eau Miraculeuse pour la sauver ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua pianta \"%@\" sta morendo. Vuoi usare l'Acqua Miracolosa per salvarla?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの植物「%@」は枯れつつあります。ワンダーウォーターを使って貯めてみませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 식물 \"%@\"이(가) 죽어가고 있습니다. Wonder Water를 사용하여 저장하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plant \"%@\" is stervende. Wil je Wonder Water gebruiken om het te redden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja roślina „%@” umiera. Czy chcesz użyć Wonder Water, aby ją uratować?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua planta \"%@\" está a morrer. Queres usar a Água Milagrosa para a salvar?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiniz \"%@\" ölüyor. Kaydetmek için Wonder Water'ı kullanmak ister misiniz?"
          }
        }
      }
    },

    "prog_sleep_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe heute auf die Minute genau zu deiner vorgenommenen Zeit ins Bett. Konsistenz richtet den circadianen Rhythmus aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to bed at your scheduled time today, to the minute. Consistency aligns circadian rhythms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate hoy a la hora prevista, al minuto. La coherencia alinea los ritmos circadianos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couchez-vous à l'heure prévue aujourd'hui, à la minute près. La cohérence aligne les rythmes circadiens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज अपने निर्धारित समय पर, मिनट तक बिस्तर पर जाएँ। संगति सर्कैडियन लय को संरेखित करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a letto all'orario programmato oggi, al minuto. La coerenza allinea i ritmi circadiani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は決められた時間に、分単位で就寝してください。一貫性は概日リズムを整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 예정된 시간, 순간까지 잠자리에 드세요. 일관성은 일주기 리듬을 정렬합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga vandaag op het geplande tijdstip naar bed, tot op de minuut nauwkeurig. Consistentie brengt circadiane ritmes op één lijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idź dzisiaj spać o zaplanowanej godzinie, co do minuty. Spójność wyrównuje rytmy dobowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá para a cama no horário programado hoje, minuto a minuto. A consistência alinha os ritmos circadianos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá para a cama no horário programado hoje, minuto a minuto. A consistência alinha os ritmos circadianos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ложитесь спать сегодня в назначенное время, с точностью до минуты. Последовательность выравнивает циркадные ритмы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün planladığınız saatte, dakikasına kadar yatın. Tutarlılık sirkadiyen ritimleri hizalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天按照预定时间上床睡觉，精确到分钟。一致性可以调整昼夜节律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天按照預定時間上床睡覺，精確到分鐘。一致性可以調整晝夜節律。"
          }
        }
      }
    },
    "prog_sleep_d1_t1": {
      "extractionState": "manual",
      "localizations": {

    "plant.minzpflanze.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge für eine frische und gesunde Zahnroutine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure a fresh and healthy dental routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegura una rutina dental fresca y saludable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous d'avoir une routine dentaire fraîche et saine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि दांतों की दिनचर्या ताज़ा और स्वस्थ हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati una routine dentale fresca e sana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮で健康的な歯科ルーチンを確保しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상쾌하고 건강한 치아 루틴을 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg voor een frisse en gezonde tandheelkundige routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj o świeżą i zdrową rutynę dentystyczną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanta uma rotina odontológica fresca e saudável."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanta uma rotina odontológica fresca e saudável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заботьтесь о свежей и здоровой зубной гигиене."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taze ve sağlıklı bir diş rutini sağlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持清新健康的牙齿日常。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持新鮮健康的牙科習慣。"
          }
        }
      }
    },
    "plant.olivenbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebt 1000 Jahre – Beständigkeit pur – Mediterraner Lifestyle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lives 1,000 years – pure persistence – Mediterranean lifestyle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1.000 años – pura persistencia – Estilo de vida mediterráneo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vit 1 000 ans – pure constance – Mode de vie méditerranéen"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 साल जियो – शुद्ध स्थायित्व – भूमध्यसागरीय जीवनशैली"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1000 anni – pura durabilità – stile di vita mediterraneo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "千年生きる – 純粋な永続性 – 地中海のライフスタイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000년 수명 – 순수한 끈기 – 지중해식 라이프스타일"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeft 1000 jaar – pure doorzettingsvermogen – Mediterrane levensstijl"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żyje 1000 lat – czysta wytrwałość – śródziemnomorski styl życia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1.000 anos – pura persistência – Estilo de vida mediterrâneo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1.000 anos – pura persistência – Estilo de vida mediterrâneo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живите 1000 лет – чистая постоянность – средиземноморский образ жизни"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 yıl yaşar – saf dayanıklılık – Akdeniz yaşam tarzı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寿命千年 – 纯粹的持久 – 地中海生活方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壽命 1000 年 – 純粹的耐用性 – 地中海生活方式"
          }
        }
      }
    },

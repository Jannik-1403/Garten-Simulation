    "assessment.health.profile.optimierer.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein System läuft sauber. Halte die Standards und skaliere weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your system is running clean. Maintain the standards and keep scaling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su sistema está funcionando limpio. Mantener los estándares y seguir escalando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre système fonctionne proprement. Maintenir les normes et continuer à évoluer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका सिस्टम साफ़ चल रहा है. मानकों को बनाए रखें और स्केलिंग करते रहें।"

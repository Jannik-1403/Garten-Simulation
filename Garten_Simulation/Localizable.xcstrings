    "item.gluecks_segen.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Segen, der 24h lang das Wachstum aller Pflanzen verdoppelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blessing that doubles the growth of all plants for 24h."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bendición que duplica el crecimiento de todas las plantas durante 24h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une bénédiction qui double la croissance de toutes les plantes pendant 24h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A blessing that doubles the growth of all plants for 24h."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間すべての植物の成長を2倍にする祝福。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24시간 동안 모든 식물의 성장이 두 배로 늘어나는 축복입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zegen die de groei van alle planten 24 uur lang verdubbelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błogosławieństwo podwajające wzrost wszystkich roślin na 24h."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bênção que duplica o crescimento de todas as plantas durante 24h."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saat boyunca tüm bitkilerin büyümesini ikiye katlayan bir nimet."
          }
        }
      }
    },

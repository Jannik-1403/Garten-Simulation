    "onboarding_notification_bubble_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich erinnere dich ans Gießen, damit es zur Gewohnheit wird!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll remind you to water so it becomes a habit!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te recordaré regar para que se convierta en un hábito!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je te rappellerai d'arroser pour que cela devienne une habitude !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं आपको पानी देने की याद दिलाऊंगा ताकि यह एक आदत बन जाए!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ricorderò di innaffiare così diventerà un'abitudine!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣になるように水やりをリマインドするね！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관이 되도록 물주기를 상기시켜 줄게!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik herinner je eraan om water te geven, zodat het een gewoonte wordt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Będę Ci przypominać o podlewaniu, żeby to stało się nawykiem!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou lembrar você de regar para que se torne um hábito!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou lembrar você de regar para que se torne um hábito!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я буду напоминать тебе поливать, чтобы это стало привычкой!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulamayı hatırlatacağım, böylece alışkanlık haline gelecek!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我会提醒你浇水，让它成为一种习惯！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我會提醒你澆水，讓它成為一種習慣！"
          }
        }
      }
    },

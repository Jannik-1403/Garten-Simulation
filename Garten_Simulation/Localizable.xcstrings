    "schwierigkeit.untertitel": {
      "comment": "A subheading explaining the purpose of the \"Schwierigkeitswahl\"-screen.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie hart du für deine Belohnungen arbeiten möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how hard you want to work for your rewards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija qué tan duro quiere trabajar para obtener sus recompensas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez à quel point vous souhaitez travailler dur pour obtenir vos récompenses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि आप अपने पुरस्कारों के लिए कितनी मेहनत करना चाहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quanto vuoi lavorare per ottenere i tuoi premi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報酬を得るためにどれだけ頑張りたいかを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보상을 위해 얼마나 열심히 일하고 싶은지 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe hard u wilt werken voor uw beloningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak ciężko chcesz pracować na swoje nagrody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o quanto você deseja trabalhar por suas recompensas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o quanto você deseja trabalhar por suas recompensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, насколько усердно вы хотите работать, чтобы получить вознаграждение."

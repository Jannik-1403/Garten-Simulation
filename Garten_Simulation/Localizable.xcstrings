    "prog_nutrition_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze einen üblichen ungesunden Snack durch einen Apfel, Beeren oder Gemüsesticks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace a usual unhealthy snack with an apple, berries, or vegetable sticks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplace un refrigerio poco saludable habitual con una manzana, bayas o palitos de verduras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez une collation malsaine habituelle par une pomme, des baies ou des bâtonnets de légumes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य अस्वास्थ्यकर नाश्ते को सेब, जामुन या सब्जी की छड़ियों से बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci il solito spuntino malsano con una mela, dei frutti di bosco o dei bastoncini di verdure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもの不健康なスナックをリンゴ、ベリー、野菜スティックなどに置き換えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 건강에 해로운 간식을 사과, 딸기 또는 야채 스틱으로 바꾸십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang een gebruikelijk ongezond tussendoortje door een appel, bessen of groentesticks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp zwykłą niezdrową przekąskę jabłkiem, jagodami lub paluszkami warzywnymi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua um lanche pouco saudável por uma maçã, frutas vermelhas ou palitos de vegetais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua um lanche pouco saudável por uma maçã, frutas vermelhas ou palitos de vegetais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените привычный неполезный перекус яблоком, ягодами или овощными палочками."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki gibi sağlıksız atıştırmalıkları elma, çilek veya sebze çubuklarıyla değiştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用苹果、浆果或蔬菜棒代替常见的不健康零食。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用蘋果、莓果或蔬菜棒取代常見的不健康零食。"
          }
        }
      }
    },

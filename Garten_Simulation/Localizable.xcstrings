    "weekly_report.feedback.desc.stable_low": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Woche zwar weniger Gewohnheiten erledigt, aber du warst jeden Tag gleichbleibend aktiv. Das ist das Fundament für echte Routine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You completed fewer habits this week, but you were consistently active every day. This is the foundation for a real routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que haya completado menos hábitos esta semana, pero estuvo constantemente activo todos los días. Ésta es la base de la verdadera rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez peut-être pris moins d’habitudes cette semaine, mais vous avez été constamment actif chaque jour. C’est la base d’une vraie routine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है कि आपने इस सप्ताह कम आदतें पूरी की हों, लेकिन आप हर दिन लगातार सक्रिय रहे। यही वास्तविक दिनचर्या का आधार है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti aver completato meno abitudini questa settimana, ma sei stato costantemente attivo ogni giorno. Questa è la base per una vera routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週完了した習慣は少なくなったかもしれませんが、毎日一貫して活動的でした。これが本当のルーチンの基礎です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 완료한 습관의 수는 줄어들었지만 매일 꾸준하게 활동하셨습니다. 이것이 실제 루틴의 기초입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze week misschien minder gewoontes volbracht, maar je was elke dag consequent actief. Dit is de basis voor echte routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Być może w tym tygodniu zrealizowałeś mniej nawyków, ale każdego dnia byłeś niezmiennie aktywny. To podstawa prawdziwej rutyny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ter completado menos hábitos esta semana, mas esteve consistentemente ativo todos os dias. Esta é a base para uma verdadeira rotina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ter completado menos hábitos esta semana, mas esteve consistentemente ativo todos os dias. Esta é a base para uma verdadeira rotina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, на этой неделе у вас появилось меньше привычек, но вы были стабильно активны каждый день. Это основа настоящей рутины."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta daha az alışkanlığı tamamlamış olabilirsiniz ancak her gün sürekli olarak aktiftiniz. Bu gerçek rutinin temelidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周您完成的习惯可能较少，但您每天都保持活跃。这是真正日常工作的基础。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週您完成的習慣可能較少，但您每天都保持活躍。這是真正日常工作的基礎。"
          }
        }
      }
    },

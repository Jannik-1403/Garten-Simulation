            "value": "Bereit f\u00fcrs Training? Hol dir das beste Equipment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for training? Get the best equipment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfListo para entrenar? Consigue el mejor equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00eat pour l'entra\u00eenement ? Obtenez le meilleur \u00e9quipement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto per l'allenamento? Ottieni la migliore attrezzatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306e\u6e96\u5099\u306f\u3067\u304d\u307e\u3057\u305f\u304b\uff1f\u6700\u9ad8\u306e\u6a5f\u5668\u3092\u624b\u306b\u5165\u308c\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud6c8\ub828 \uc900\ube44\uac00 \ub418\uc168\uc2b5\ub2c8\uae4c? \ucd5c\uace0\uc758 \uc7a5\ube44\ub97c \uad6c\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar voor de training? Haal de beste apparatuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowy na trening? Zdob\u0105d\u017a najlepszy sprz\u0119t."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto para treinar? Obtenha o melhor equipamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmana haz\u0131r m\u0131s\u0131n\u0131z? En iyi ekipman\u0131 edinin."
          }
        }
      }
    },

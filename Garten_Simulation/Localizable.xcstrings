    "weed_popup_body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unkraut blockiert deine Pflanzen \u2013 nur %@ XP pro Gie\u00dfen. Erledige %d Gewohnheiten f\u00fcr das aktuelle Unkraut \u2013 oder zahle Coins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeds block your plants \u2013 only %@ XP per watering. Complete %d habits for the current weed \u2013 or pay coins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las malas hierbas bloquean tus plantas \u2013 solo %@ de XP por riego. Completa %d h\u00e1bitos para la actual \u2013 o paga monedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises herbes bloquent tes plantes \u2013 seulement %@ d'XP par arrosage. Accomplis %d habitudes pour celle en cours \u2013 ou paye des pi\u00e8ces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0947\u0935\u091c\u0939 \u0918\u093e\u0938 \u0906\u092a\u0915\u0940 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u0930\u094b\u0915 \u0930\u0939\u0940 \u0939\u0948 \u2013 \u0915\u0947\u0935\u0932%@XP \u092a\u094d\u0930\u0924\u093f \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u0947 \u092a\u0930\u0964 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092c\u0947\u0935\u091c\u0939 \u0918\u093e\u0938 \u0915\u0947 \u0932\u093f\u090f%d\u0906\u0926\u0924\u0947\u0902 \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902 \u2013 \u092f\u093e \u0938\u093f\u0915\u094d\u0915\u0947 \u091a\u0941\u0915\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le erbacce bloccano le tue piante \u2013 solo %@ XP per annaffiatura. Completa %d abitudini per quella attuale \u2013 o paga monete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96d1\u8349\u304c\u690d\u7269\u306e\u90aa\u9b54\u3092\u3057\u307e\u3059 - \u6c34\u3084\u308a\u3042\u305f\u308a\u306e XP \u306f\u308f\u305a\u304b %@ \u3067\u3059\u3002\u73fe\u5728\u306e\u5927\u9ebb\u306e %d \u500b\u306e\u7fd2\u6163\u3092\u5b8c\u4e86\u3059\u308b\u304b\u3001\u30b3\u30a4\u30f3\u3092\u652f\u6255\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a1\ucd08\uac00 \uc2dd\ubb3c\uc744 \ub9c9\uc2b5\ub2c8\ub2e4. \ubb3c\uc744 \ubfcc\ub9b4 \ub54c\ub9c8\ub2e4 %@ XP\ub9cc \uc81c\uacf5\ub429\ub2c8\ub2e4. \ud604\uc7ac \uc7a1\ucd08\uc5d0 \ub300\ud574 %d\uac1c\uc758 \uc2b5\uad00\uc744 \uc644\ub8cc\ud558\uac70\ub098 \ucf54\uc778\uc744 \uc9c0\ubd88\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onkruid blokkeert je planten \u2013 slechts %@ XP per gietbeurt. Voltooi %d gewoonten voor de huidige wiet \u2013 of betaal munten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwasty blokuj\u0105 Twoje ro\u015bliny \u2013 tylko %@ XP na podlewanie. Uko\u0144cz %d nawyk\u00f3w dla bie\u017c\u0105cego zio\u0142a \u2013 lub zap\u0142a\u0107 monetami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas bloqueiam as tuas plantas \u2013 s\u00f3 %@ de XP por rega. Completa %d h\u00e1bitos para a atual \u2013 ou paga moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0440\u043d\u044f\u043a\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0442 \u0432\u0430\u0448\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u2014 \u0432\u0441\u0435\u0433\u043e%@XP \u0437\u0430 \u043f\u043e\u043b\u0438\u0432. \u0412\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438%d\u0434\u043b\u044f \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u0442\u0440\u0430\u0432\u043a\u0438 \u2014 \u0438\u043b\u0438 \u0437\u0430\u043f\u043b\u0430\u0442\u0438\u0442\u0435 \u043c\u043e\u043d\u0435\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabani otlar bitkilerinizi engeller; sulama ba\u015f\u0131na yaln\u0131zca %@ XP. Mevcut ot i\u00e7in %d al\u0131\u015fkanl\u0131\u011f\u0131 tamamlay\u0131n veya jeton \u00f6deyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6742\u8349\u4f1a\u5835\u585e\u60a8\u7684\u690d\u7269 - \u6bcf\u6b21\u6d47\u6c34\u53ea\u9700\u4f7f\u7528%@XP\u3002\u5b8c\u6210\u5f53\u524d\u6742\u8349\u7684%d\u4e60\u60ef - \u6216\u652f\u4ed8\u786c\u5e01\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96dc\u8349\u6703\u5835\u585e\u60a8\u7684\u690d\u7269 - \u6bcf\u6b21\u6f86\u6c34\u53ea\u9700\u4f7f\u7528%@XP\u3002\u5b8c\u6210\u7576\u524d\u96dc\u8349\u7684%d\u7fd2\u6163 - \u6216\u652f\u4ed8\u786c\u5e63\u3002"
          }
        }
      }
    },

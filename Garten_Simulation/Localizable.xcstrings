    "paywall.feature.weekly_report.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lerne dich selbst besser kennen. Entdecke, wann du am produktivsten bist und feiere deinen Fortschritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get to know yourself better. Discover when you're most productive and celebrate your progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conócete mejor. Descubre cuándo eres más productivo y celebra tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprends à mieux te connaître. Découvre quand tu es le plus productif et célèbre tes progrès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने आप को बेहतर तरीके से जानें. जानें कि आप कब सर्वाधिक उत्पादक होते हैं और अपनी प्रगति का जश्न मनाएं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impara a conoscerti meglio. Scopri quando sei più produttivo e festeggia i tuoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分自身をよりよく知りましょう。いつ最も生産的かを発見し、進歩を祝いましょう。"
          }
        },

    "screenTime.limit.confirm.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald das Limit festgelegt ist, kannst du es heute nicht mehr erhöhen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the limit is set, you cannot increase it today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez establecido el límite, ¡no puedes aumentarlo hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la limite fixée, vous ne pouvez plus l’augmenter aujourd’hui !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार सीमा निर्धारित हो जाने के बाद, आप इसे आज नहीं बढ़ा सकते!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta fissato il limite, non puoi aumentarlo oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度制限を設定すると、今日からそれを増やすことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도가 설정되면 오늘은 한도를 늘릴 수 없습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de limiet eenmaal is ingesteld, kunt u deze vandaag niet meer verhogen!"
          }

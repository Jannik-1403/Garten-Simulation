    "pfad_abschluss_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unglaublich! Du hast 90 Tage am St\u00fcck gemeistert. Hier ist deine wohlverdiente Belohnung:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incredible! You mastered 90 days in a row. Here is your well-deserved reward:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Incre\u00edble! Has dominado 90 d\u00edas seguidos. Aqu\u00ed tienes tu bien merecida recompensa:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incroyable ! Tu as ma\u00eetris\u00e9 90 jours d'affil\u00e9e. Voici ta r\u00e9compense bien m\u00e9rit\u00e9e :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f! \u0906\u092a\u0928\u0947 \u0932\u0917\u093e\u0924\u093e\u0930 90 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u092e\u0939\u093e\u0930\u0924 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930 \u0932\u0940 \u0939\u0948\u0964 \u092f\u0939\u093e\u0901 \u0906\u092a\u0915\u093e \u0938\u0941\u092f\u094b\u0917\u094d\u092f \u0907\u0928\u093e\u092e \u0939\u0948:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incredibile! Hai dominato 90 giorni di fila. Ecco la tua meritata ricompensa:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fe1\u3058\u3089\u308c\u306a\u3044\uff01 You mastered 90 days in a row.\u3053\u308c\u304c\u5f53\u7136\u306e\u5831\u916c\u3067\u3059:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubbff\uc744 \uc218 \uc5c6\ub294! 90\uc77c \uc5f0\uc18d\uc73c\ub85c \ub9c8\uc2a4\ud130\ud558\uc168\uc2b5\ub2c8\ub2e4. \uc5ec\uae30 \ub2f9\uc2e0\uc774 \ubc1b\uc744 \ub9cc\ud55c \ubcf4\uc0c1\uc774 \uc788\uc2b5\ub2c8\ub2e4:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongelooflijk! Je hebt het 90 dagen achter elkaar onder de knie. Hier is uw welverdiende beloning:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niesamowity! Osi\u0105ga\u0142e\u015b mistrzostwo przez 90 dni z rz\u0119du. Oto Twoja zas\u0142u\u017cona nagroda:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incr\u00edvel! Dominaste 90 dias seguidos. Aqui tens a tua merecida recompensa:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e! \u0422\u044b \u043f\u0440\u043e\u0434\u0435\u0440\u0436\u0430\u043b\u0441\u044f 90 \u0434\u043d\u0435\u0439 \u043f\u043e\u0434\u0440\u044f\u0434. \u0412\u043e\u0442 \u0442\u0432\u043e\u044f \u0437\u0430\u0441\u043b\u0443\u0436\u0435\u043d\u043d\u0430\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u0430:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130nan\u0131lmaz! Art arda 90 g\u00fcn ustala\u015ft\u0131n\u0131z. \u0130\u015fte hak etti\u011finiz \u00f6d\u00fcl\u00fcn\u00fcz:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u592a\u68d2\u4e86\uff01\u60a8\u5df2\u8fde\u7eed\u575a\u630190\u5929\u3002\u8fd9\u662f\u60a8\u5e94\u5f97\u7684\u5956\u52b1\uff1a"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6975\u597d\u7684\uff01\u4f60\u5df2\u7d93\u9023\u7e8c90\u5929\u638c\u63e1\u4e86\u3002\u9019\u662f\u60a8\u61c9\u5f97\u7684\u734e\u52f5\uff1a"
          }
        }
      }
    },

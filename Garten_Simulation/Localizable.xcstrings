    "plant.minzpflanze.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frisch, klar, t\u00e4glich \u2013 Z\u00e4hneputzen & Hygiene"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh, clear, daily \u2013 Toothbrushing & Hygiene"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresca, clara, diaria \u2013 Higiene dental y personal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra\u00eeche, claire, quotidienne \u2013 Hygi\u00e8ne dentaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u093e\u091c\u0917\u0940, \u0938\u093e\u092b\u093c, \u0930\u094b\u091c\u093e\u0928\u093e \u2013 \u092c\u094d\u0930\u0936 \u0915\u0930\u0928\u093e \u0914\u0930 \u0938\u094d\u0935\u091a\u094d\u091b\u0924\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh, clear, daily \u2013 Toothbrushing & Hygiene"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30ec\u30c3\u30b7\u30e5\u3001\u30af\u30ea\u30a2\u3001\u6bce\u65e5 - \u6b6f\u78e8\u304d\u3068\u885b\u751f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e0\uc120\ud558\uace0 \ub9d1\uc73c\uba70 \ub9e4\uc77c \u2013 \uce6b\uc194\uc9c8 \ubc0f \uc704\uc0dd"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fris, helder, dagelijks \u2013 Tandenpoetsen & Hygi\u00ebne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015awie\u017ce, przejrzyste, codzienne \u2013 szczotkowanie z\u0119b\u00f3w i higiena"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresca, clara, di\u00e1ria \u2013 Higiene dent\u00e1ria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0432\u0435\u0436\u043e, \u0447\u0438\u0441\u0442\u043e, \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u2013 \u0447\u0438\u0441\u0442\u043a\u0430 \u0437\u0443\u0431\u043e\u0432 \u0438 \u0433\u0438\u0433\u0438\u0435\u043d\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taze, berrak, g\u00fcnl\u00fck \u2013 Di\u015f F\u0131r\u00e7alama ve Hijyen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e05\u65b0\uff0c\u6d01\u51c0\uff0c\u6bcf\u65e5 \u2013 \u5237\u7259\u4e0e\u536b\u751f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u9bae\u3001\u6e05\u6670\u3001\u65e5\u5e38\u2014\u2014\u5237\u7259\u548c\u885b\u751f"
          }
        }
      }
    },

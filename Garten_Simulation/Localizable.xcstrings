    "trash.binge_streaming.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien-Marathon-Abende lassen dich tagelang unproduktiv und leer fühlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Series marathon evenings leave you feeling unproductive and empty for days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de maratón de series te dejan sintiéndote improductivo y vacío durante días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soirées marathon de séries te laissent improductif et vide pendant des jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीरीज मैराथन की शामें तुम्हें कई दिनों तक गैर-उत्पादक और खाली महसूस करवा देती हैं।"

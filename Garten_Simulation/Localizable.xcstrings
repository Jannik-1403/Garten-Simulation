    "progression_noalcohol_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke weiterhin Wasser oder Tee statt alkoholischen Getränken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue drinking water or tea instead of alcoholic beverages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue bebiendo agua o té en lugar de bebidas alcohólicas."
          }

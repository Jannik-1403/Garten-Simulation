    "settings.display.mode.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob der Name der Pflanze ohne die verknüpfte Gewohnheit im Garten angezeigt werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the name of the plant should be displayed in the garden without the linked habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres que el nombre de la planta se muestre en el jardín sin el hábito vinculado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si le nom de la plante doit être affiché dans le jardin sans l'habitude liée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि क्या पौधे का नाम बगीचे में बिना जुड़ी आदत के प्रदर्शित किया जाना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se il nome della pianta debba essere visualizzato nel giardino senza l'abitudine associata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連する習慣なしで植物の名前を庭に表示するかどうかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 습관 없이 식물의 이름을 정원에 표시할지 여부를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of de naam van de plant in de tuin moet worden weergegeven zonder de gekoppelde gewoonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy nazwa rośliny ma być wyświetlana w ogrodzie bez powiązanego nawyku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se o nome da planta deve ser exibido no jardim sem o hábito vinculado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se o nome da planta deve ser exibido no jardim sem o hábito vinculado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, должно ли имя растения отображаться в саду без связанной привычки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı alışkanlık olmadan bitkinin adının bahçede gösterilip gösterilmeyeceğini seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择是否在没有关联习惯的情况下在花园中显示植物的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇是否在沒有關聯習慣的情況下在花園中顯示植物的名稱。"
          }
        }
      }
    },

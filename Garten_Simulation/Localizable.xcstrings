    "trash.energy_drink_kiste.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle die leeren Dosen eines Monats auf – der Preis und die Koffeinmenge überraschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count the empty cans from a month – the price and caffeine amount will surprise you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta las latas vacías de un mes: el precio y la cantidad de cafeína te sorprenderán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte les canettes vides d'un mois – le prix et la quantité de caféine te surprendront."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक महीने के खाली डिब्बों की गिनती करें – कीमत और कैफीन की मात्रा आश्चर्यचकित कर देगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta le lattine vuote di un mese – il prezzo e la quantità di caffeina ti sorprenderanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ヶ月分の空き缶を数えてみましょう。その価格とカフェイン量に驚くはずです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달 동안의 빈 캔을 세어보세요 – 가격과 카페인 양이 놀라울 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel de lege blikjes van een maand op – de prijs en hoeveelheid cafeïne zullen je verbazen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Policz puste puszki z miesiąca – cena i ilość kofeiny cię zaskoczą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte as latas vazias de um mês – o preço e a quantidade de cafeína vão te surpreender."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte as latas vazias de um mês – o preço e a quantidade de cafeína vão te surpreender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитайте пустые банки за месяц – цена и количество кофеина вас удивят."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aylık boş kutuları say – fiyat ve kafein miktarı seni şaşırtacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数一数一个月内的空罐——咖啡因的价格和含量会让你大吃一惊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數一數一個月內的空罐——咖啡因的價格和含量會讓你大吃一驚。"
          }
        }
      }
    },
    "trash.energy_drink_kiste.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Energy Drinks)**\n1. Unsichtbar machen: Entferne die Auslöser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue Hürden ein (z.B. Apps löschen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausführung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Wasser trinken)**\n1. Offensichtlich machen: Platziere den Auslöser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die Hürden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Energy drinks)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Drinking water)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Deshazte de un mal hábito (bebidas energéticas)**\n1. Hazte invisible: elimina los factores desencadenantes de tu campo de visión.\n2. Hazte poco atractivo: sé consciente de las consecuencias negativas.\n3. Hazlo difícil: establece obstáculos (por ejemplo, eliminar aplicaciones, desconectarte).\n4. Hacerlo insatisfactorio: Adjuntar la ejecución a una pena.\n\n**Establece un buen hábito (beber agua)**\n1. Hazlo obvio: coloca el gatillo claramente visible.\n2. Hazlo atractivo: Asócialo con algo que te guste.\n3. Hazlo simple: reduce los obstáculos al mínimo (por ejemplo, solo 2 minutos).\n4. Hazlo satisfactorio: Prémiate inmediatamente después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Se débarrasser de la mauvaise habitude (Boissons énergisantes)**\n1. La rendre invisible : Retire les déclencheurs de ton champ de vision.\n2. La rendre peu attirante : Prends conscience des conséquences négatives.\n3. La rendre difficile : Ajoute des obstacles (par ex. supprime des applis, débranche la prise).\n4. La rendre insatisfaisante : Associe l'action à une sanction.\n\n**Mettre en place la bonne habitude (Boire de l'eau)**\n1. La rendre évidente : Place le déclencheur bien en vue.\n2. La rendre attirante : Associe-la à quelque chose que tu aimes.\n3. La rendre facile : Réduis les obstacles au minimum (par ex. seulement 2 minutes).\n4. La rendre satisfaisante : Récompense-toi juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**खराब आदत से छुटकारा पाएं (Energy Drinks)**\n1. अदृश्य बनाएं: अपने नज़र के सामने ट्रिगर्स हटा दें।\n2. अप्रिय बनाएं: नकारात्मक परिणामों को जानें।\n3. मुश्किल बनाएं: बाधाएँ डालें (जैसे, ऐप्स हटाएँ, प्लग निकालें)।\n4. असंतोषजनक बनाएं: कार्य को किसी सजा के साथ जोड़ें।\n\n**अच्छी आदत स्थापित करें (पानी पीना)**\n1. स्पष्ट बनाएं: ट्रिगर को आसानी से दिखाई देने वाली जगह पर रखें।\n2. आकर्षक बनाएं: इसे किसी ऐसी चीज़ के साथ जोड़ें जिसे आप पसंद करते हैं।\n3. आसान बनाएं: बाधाओं को न्यूनतम पर लाएँ (जैसे, केवल 2 मिनट)।\n4. संतोषजनक बनाएं: तुरंत बाद खुद को इनाम दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina la cattiva abitudine (Energy drink)**\n1. Rendila invisibile: Rimuovi i trigger dal tuo campo visivo.\n2. Rendila poco attraente: Prendi consapevolezza delle conseguenze negative.\n3. Rendila difficile: Aggiungi ostacoli (es. elimina le app, stacca la spina).\n4. Rendila insoddisfacente: Collega l'azione a una punizione.\n\n**Stabilisci la buona abitudine (Bere acqua)**\n1. Rendila evidente: Posiziona il trigger ben visibile.\n2. Rendila attraente: Associala a qualcosa che ti piace.\n3. Rendila facile: Riduci gli ostacoli al minimo (es. solo 2 minuti).\n4. Rendila soddisfacente: Premiati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**悪い習慣を取り除く (エナジードリンク)**\n1. 目に見えないようにする: トリガーを視界から取り除きます。\n2. 自分自身を魅力的でなくする: マイナスの結果に注意してください。\n3. 難しくする: ハードルを設定します (例: アプリを削除する、プラグを抜く)。\n4. 満足できないものにする: 処刑にペナルティを付けます。\n\n**良い習慣を身につける（水を飲む）**\n1. わかりやすいようにする: トリガーをはっきりと見えるように配置します。\n2. 魅力的にする: 好きなものと関連付けます。\n3. シンプルにする: ハードルを最小限に抑えます (例: わずか 2 分)。\n4. 満足のいくものにする: 終わったらすぐに自分にご褒美をあげましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**나쁜 습관 버리기(에너지 드링크)**\n1. 보이지 않게 만들기: 시야에서 트리거를 제거합니다.\n2. 자신을 매력적이지 않게 만드세요. 부정적인 결과를 염두에 두세요.\n3. 어렵게 만들기: 장애물을 설정합니다(예: 앱 삭제, 플러그 뽑기).\n4. 불만족스럽게 만들기: 처형에 벌금을 부과합니다.\n\n**좋은 습관을 들이세요(물 마시기)**\n1. 명확하게 만드십시오: 트리거를 명확하게 보이도록 배치하십시오.\n2. 매력적으로 만드십시오: 당신이 좋아하는 것과 연관시키십시오.\n3. 단순하게 만드세요. 장애물을 최소한으로 줄이세요(예: 단 2분).\n4. 만족스러운 일을 하십시오: 직후에 자신에게 보상하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slechte gewoonte afleren (Energiedrankjes)**\n1. Onzichtbaar maken: Verwijder de triggers uit je blikveld.\n2. Onaantrekkelijk maken: Word je bewust van de negatieve gevolgen.\n3. Moeilijk maken: Bouw obstakels in (bijv. apps verwijderen, stekker eruit trekken).\n4. Onbevredigend maken: Koppel de handeling aan een straf.\n\n**Goede gewoonte opbouwen (Water drinken)**\n1. Duidelijk maken: Plaats de trigger goed zichtbaar.\n2. Aantrekkelijk maken: Koppel het aan iets wat je leuk vindt.\n3. Makkelijk maken: Beperk de obstakels tot een minimum (bijv. slechts 2 minuten).\n4. Bevredigend maken: Beloon jezelf direct daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pozbądź się złego nawyku (napoje energetyczne)**\n1. Uczyń niewidzialnym: Usuń wyzwalacze z pola widzenia.\n2. Stań się nieatrakcyjny: bądź świadomy negatywnych konsekwencji.\n3. Utrudnij to: ustaw przeszkody (np. usuń aplikacje, odłącz).\n4. Spraw, aby było to niezadowalające: Połącz egzekucję z karą.\n\n**Wypracuj dobry nawyk (pij wodę)**\n1. Spraw, aby było to oczywiste: umieść spust w dobrze widocznym miejscu.\n2. Spraw, aby było atrakcyjne: skojarz to z czymś, co lubisz.\n3. Uprość sprawę: ogranicz przeszkody do minimum (np. tylko 2 minuty).\n4. Spraw, aby było to satysfakcjonujące: natychmiast po tym nagradzaj siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Livra-te do mau hábito (Bebidas energéticas)**\n1. Torná-lo invisível: Remove os gatilhos do teu campo de visão.\n2. Torná-lo pouco atrativo: Consciencializa-te das consequências negativas.\n3. Torná-lo difícil: Cria obstáculos (por ex. elimina apps, desliga a ficha).\n4. Torná-lo insatisfatório: Associa a ação a uma penalização.\n\n**Estabelece o bom hábito (Beber água)**\n1. Torná-lo evidente: Coloca o gatilho bem visível.\n2. Torná-lo atrativo: Associa-o a algo de que gostas.\n3. Torná-lo fácil: Reduz os obstáculos ao mínimo (por ex. apenas 2 minutos).\n4. Torná-lo satisfatório: Recompensa-te logo a seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimine o mau hábito (Energéticos)**\n1. Torne-o invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-o pouco atraente: Conscientize-se das consequências negativas.\n3. Torne-o difícil: Crie obstáculos (ex.: exclua apps, desligue a tomada).\n4. Torne-o insatisfatório: Associe a ação a uma punição.\n\n**Estabeleça o bom hábito (Beber água)**\n1. Torne-o evidente: Coloque o gatilho bem visível.\n2. Torne-o atraente: Associe-o a algo que você gosta.\n3. Torne-o fácil: Reduza os obstáculos ao mínimo (ex.: apenas 2 minutos).\n4. Torne-o satisfatório: Recompense-se logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Избавьтесь от вредной привычки (энергетические напитки)**\n1. Сделайте невидимыми: уберите триггеры из поля зрения. \n2. Сделайте себя непривлекательным. Помните о негативных последствиях. \n3. Усложните задачу: установите препятствия (например, удалите приложения, отключите их от сети). \n4. Сделайте его неудовлетворительным: прикрепите исполнение к наказанию. \n\n**Выработайте хорошую привычку (пить воду)**\n1. Сделайте это очевидным: разместите триггер на видном месте. \n2. Сделайте это привлекательным. Свяжите это с чем-то, что вам нравится. \n3. Сделайте это просто: сократите препятствия до минимума (например, всего 2 минуты). \n4. Сделайте это приятным: вознаградите себя сразу после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kötü Bir Alışkanlıktan Kurtulun (Enerji İçecekleri)**\n1. Görünmez kılın: Tetikleyicileri görüş alanınızdan kaldırın.\n2. Kendinizi çekici olmaktan çıkarın: Olumsuz sonuçların farkında olun.\n3. Zorlaştırın: Engeller koyun (ör. uygulamaları silin, fişi çekin).\n4. Yetersiz hale getirin: İnfazı cezaya ekleyin.\n\n**İyi bir alışkanlık edinin (su içmek)**\n1. Açıkça belirtin: Tetiği açıkça görülebilecek şekilde yerleştirin.\n2. Çekici hale getirin: Onu sevdiğiniz bir şeyle ilişkilendirin.\n3. Basitleştirin: Engelleri en aza indirin (örneğin sadece 2 dakika).\n4. Tatmin edici hale getirin: Hemen ardından kendinizi ödüllendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉坏习惯（能量饮料）**\n1. 隐形：将触发因素移出视野。\n2. 让自己变得没有吸引力：意识到负面后果。\n3. 让它变得困难：设置障碍（例如删除应用程序、拔掉插头）。\n4. 使其不令人满意：附加刑罚执行。\n\n**建立良好的习惯（喝水）**\n1. 使其显而易见：将触发器放置在清晰可见的位置。\n2. 让它有吸引力：将它与你喜欢的东西联系起来。\n3. 让它变得简单：将障碍减少到最低限度（例如只需 2 分钟）。\n4. 让它令人满意：事后立即奖励自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉壞習慣（能量飲料）**\n1. 隱形：將觸發因素移出視野。\n2. 讓自己變得沒有吸引力：意識到負面後果。\n3. 讓它變得困難：設定障礙（例如刪除應用程式、拔掉插頭）。\n4. 使其不令人滿意：附加刑罰執行。\n\n**建立良好的習慣（喝水）**\n1. 使其顯而易見：將觸發器放置在清晰可見的位置。\n2. 讓它有吸引力：將它與你喜歡的東西連結起來。\n3. 讓它變得簡單：將障礙減少到最低限度（例如只需 2 分鐘）。\n4. 讓它令人滿意：事後立即獎勵自己。"
          }
        }
      }
    },
    "trash.fast_food_abo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzichte auf Fast-Food, koche selbst und ernähre dich gesünder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip fast food, cook for yourself and eat healthier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la comida rápida, cocina tú mismo y come más sano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite le fast-food, cuisine toi-même et mange plus sainement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फास्ट फूड से परहेज़ करें, खुद खाना पकाएँ और अधिक स्वस्थ रूप से भोजन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita il fast food, cucina da solo e mangia più sano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファーストフードを避け、自分で料理して健康的に食べましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스트푸드를 피하고 직접 요리하여 더 건강하게 식사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd fastfood, kook voor jezelf en eet gezonder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrezygnuj z fast foodów, gotuj sam i jedz zdrowiej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite fast food, cozinhe para si mesmo e coma de forma mais saudável."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite fast food, cozinhe para si mesmo e coma de forma mais saudável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте фаст-фуда, готовьте сами и питайтесь здоровой пищей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food'dan kaçının, kendiniz pişirin ve daha sağlıklı beslenin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免快餐，自己做饭，吃得更健康。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免快餐，自己做飯，吃得更健康。"
          }
        }
      }
    },
    "trash.fast_food_abo.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Fast Food) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (la comida rápida) te cuesta energía, tiempo y dinero a largo plazo. Le impide alcanzar su máximo potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Fast-food) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (फास्ट फूड) आपको लंबे समय में ऊर्जा, समय और पैसा से महरूम करती है। यह आपको अपनी पूरी क्षमता को प्रयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Fast food) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（ファストフード）は、長期的にはエネルギー、時間、お金を消費します。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(패스트푸드)은 장기적으로 에너지, 시간, 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (Fastfood) kost je op lange termijn energie, tijd en geld. Het weerhoudt je ervan je volledige potentieel te benutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (fast foody) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (fast food) custa energia, tempo e dinheiro a longo prazo. Isso o impede de atingir todo o seu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Fast food) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (фаст-фуд) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (fast food) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（快餐）会消耗你的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，這種習慣（快餐）會消耗你的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "Ton jardin est en s\u00e9curit\u00e9 aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0917\u0940\u091a\u093e \u0906\u091c \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is safe today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u3082\u3042\u306a\u305f\u306e\u5ead\u306f\u5b89\u5168\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298 \ub2f9\uc2e0\uc758 \uc815\uc6d0\uc740 \uc548\uc804\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw tuin is vandaag veilig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j ogr\u00f3d jest dzi\u015b bezpieczny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu jardim est\u00e1 seguro hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u0441\u0430\u0434 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7eniz bug\u00fcn g\u00fcvende."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u4f60\u7684\u82b1\u56ed\u5f88\u5b89\u5168\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u4f60\u7684\u82b1\u5712\u5f88\u5b89\u5168\u3002"
          }
        }
      }
    },
    "spin.result.unkraut.titel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh nein! Unkraut entdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh no! Weed detected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Oh no! Malas hierbas detectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh non ! Mauvaise herbe d\u00e9tect\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0913\u0939 \u0928\u0939\u0940\u0902! \u091c\u0902\u0917\u0932\u0940 \u0918\u093e\u0938 \u092a\u093e\u0908 \u0917\u0908\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh no! Weed detected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u306a\u3093\u3066\u3053\u3063\u305f\uff01\u96d1\u8349\u304c\u691c\u51fa\u3055\u308c\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc548 \ub3fc! \uc704\ub4dc\uac00 \uac10\uc9c0\ub418\uc5c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "O nee! Onkruid gedetecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O nie! Wykryto chwasty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh n\u00e3o! Erva daninha detetada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e \u043d\u0435\u0442! \u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d \u0441\u043e\u0440\u043d\u044f\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ah hay\u0131r! Ot tespit edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54e6\u4e0d\uff01\u53d1\u73b0\u4e86\u6742\u8349\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54e6\u4e0d\uff01\u767c\u73fe\u4e86\u96dc\u8349\u3002"
          }
        }
      }
    },
    "spin.result.unkraut.untertitel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Garten w\u00e4chst Unkraut. Entferne es schnell!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A weed is growing in your garden. Remove it quickly!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mala hierba crece en tu jard\u00edn. \u00a1Elim\u00ednala r\u00e1pido!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mauvaise herbe pousse dans ton jardin. Enl\u00e8ve-la vite !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092c\u0917\u0940\u091a\u0947 \u092e\u0947\u0902 \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0909\u0917 \u0930\u0939\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u091c\u0932\u094d\u0926\u0940 \u0939\u091f\u093e \u0926\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce un\\'erbaccia nel tuo giardino. Rimuovila in fretta!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u306b\u96d1\u8349\u304c\u751f\u3048\u3066\u3044\u307e\u3059\u3002\u65e9\u304f\u53d6\u308a\u9664\u3044\u3066\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc5d0 \uc7a1\ucd08\uac00 \uc790\ub77c\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ube68\ub9ac \uc81c\uac70\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er groeit onkruid in uw tuin. Verwijder het snel!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Twoim ogrodzie ro\u015bnie chwast. Usu\u0144 to szybko!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma erva daninha est\u00e1 a crescer no teu jardim. Remove-a rapidamente!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0442\u0432\u043e\u0435\u043c \u0441\u0430\u0434\u0443 \u0440\u0430\u0441\u0442\u0443\u0442 \u0441\u043e\u0440\u043d\u044f\u043a\u0438. \u0423\u0434\u0430\u043b\u0438 \u0438\u0445 \u0431\u044b\u0441\u0442\u0440\u043e!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7enizde bir yabani ot b\u00fcy\u00fcyor. \u00c7abuk kald\u0131r\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u82b1\u56ed\u91cc\u6742\u8349\u4e1b\u751f\u3002\u5feb\u70b9\u53bb\u6389\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u82b1\u5712\u88e1\u96dc\u8349\u53e2\u751f\u3002\u5feb\u9ede\u53bb\u6389\u5427\uff01"
          }
        }
      }
    },

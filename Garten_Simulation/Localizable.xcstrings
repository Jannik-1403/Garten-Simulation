    "pfad_mental_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Auszeiten f\u00fcr den Geist. Lerne bewusstes Atmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short breaks for the mind. Learn conscious breathing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peque\u00f1os descansos para la mente. Aprende a respirar conscientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courtes pauses pour l'esprit. Apprends la respiration consciente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u093f\u092e\u093e\u0917 \u0915\u0947 \u0932\u093f\u090f \u0925\u094b\u0921\u093c\u093e \u092c\u094d\u0930\u0947\u0915. \u0938\u091a\u0947\u0924\u0928 \u0936\u094d\u0935\u093e\u0938 \u0932\u0947\u0928\u093e \u0938\u0940\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brevi pause per la mente. Impara la respirazione consapevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc3\u306e\u77ed\u3044\u4f11\u61a9\u3002\u610f\u8b58\u7684\u306a\u547c\u5438\u6cd5\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc74c\uc744 \uc704\ud55c \uc9e7\uc740 \ud734\uc2dd. \uc758\uc2dd\uc801\uc778 \ud638\ud761\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte pauzes voor de geest. Leer bewust ademen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kr\u00f3tkie przerwy dla umys\u0142u. Naucz si\u0119 \u015bwiadomego oddychania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Curta pausa para a mente. Aprende a respira\u00e7\u00e3o consciente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u0430\u0443\u0437\u044b \u0434\u043b\u044f \u0440\u0430\u0437\u0443\u043c\u0430. \u0423\u0447\u0438\u0441\u044c \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u043c\u0443 \u0434\u044b\u0445\u0430\u043d\u0438\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihin i\u00e7in k\u0131sa molalar. Bilin\u00e7li nefes almay\u0131 \u00f6\u011frenin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ed9\u5fc3\u7075\u7684\u5c0f\u61a9\u3002\u5b66\u4e60\u6709\u610f\u8bc6\u5730\u547c\u5438\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cbe\u795e\u4e0a\u7684\u5c0f\u4f11\u606f\u3002\u5b78\u7fd2\u6709\u610f\u8b58\u7684\u547c\u5438\u3002"
          }
        }
      }
    },
    "pfad_mental_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe Gelassenheit. Du bist eins mit dir selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep serenity. You are at one with yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Serenidad profunda. Eres uno contigo mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9r\u00e9nit\u00e9 profonde. Tu ne fais qu'un avec toi-m\u00eame."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0939\u0930\u0940 \u0936\u093e\u0902\u0924\u093f. \u0906\u092a \u0938\u094d\u0935\u092f\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profonda serenit\u00e0. Sei in armonia con te stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6df1\u3044\u9759\u3051\u3055\u3002\u3042\u306a\u305f\u306f\u81ea\u5206\u81ea\u8eab\u3068\u4e00\u3064\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae4a\uc740 \ud3c9\uc628\ud568. \ub2f9\uc2e0\uc740 \uc790\uc2e0\uacfc \ud558\ub098\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diepe sereniteit. Je bent \u00e9\u00e9n met jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u0142\u0119boki spok\u00f3j. Jeste\u015b jedno\u015bci\u0105 ze sob\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serenidade profunda. Est\u00e1s em harmonia contigo mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043b\u0443\u0431\u043e\u043a\u043e\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u0441\u0442\u0432\u0438\u0435. \u0422\u044b \u0435\u0434\u0438\u043d\u043e \u0441 \u0441\u0430\u043c\u0438\u043c \u0441\u043e\u0431\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derin huzur. Sen kendinle birsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6df1\u5ea6\u5b81\u9759\u3002\u4f60\u4e0e\u81ea\u5df1\u5408\u4e00\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6df1\u6c89\u7684\u5e73\u975c\u3002\u4f60\u8207\u4f60\u81ea\u5df1\u5408\u4e00\u3002"
          }
        }
      }
    },
    "pfad_mental_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innere St\u00e4rke kultivieren. Frieden findest du in dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultivate inner strength. You find peace within yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva la fuerza interior. Encuentras la paz dentro de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultive ta force int\u00e9rieure. Tu trouves la paix en toi-m\u00eame."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0902\u0924\u0930\u093f\u0915 \u0936\u0915\u094d\u0924\u093f \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0947\u0902. \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u092d\u0940\u0924\u0930 \u0936\u093e\u0902\u0924\u093f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coltiva la forza interiore. Trovi la pace dentro di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5185\u306a\u308b\u5f37\u3055\u3092\u990a\u3044\u307e\u3057\u3087\u3046\u3002\u3042\u306a\u305f\u306f\u81ea\u5206\u81ea\u8eab\u306e\u4e2d\u306b\u5e73\u548c\u3092\u898b\u51fa\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\uba74\uc758 \ud798\uc744 \ud0a4\uc6b0\uc138\uc694. \ub2f9\uc2e0\uc740 \uc790\uc2e0 \uc548\uc5d0\uc11c \ud3c9\ud654\ub97c \ucc3e\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiveer innerlijke kracht. Je vindt rust in jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Piel\u0119gnuj wewn\u0119trzn\u0105 si\u0142\u0119. Odnajdujesz spok\u00f3j w sobie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva a for\u00e7a interior. Encontras a paz dentro de ti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0441\u0438\u043b\u0443. \u041c\u0438\u0440 \u0442\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0448\u044c \u0432 \u0441\u0435\u0431\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u00e7sel g\u00fcc\u00fc geli\u015ftirin. Huzuru kendi i\u00e7inde bulursun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f9\u517b\u5185\u5728\u529b\u91cf\u3002\u4f60\u4f1a\u5728\u81ea\u5df1\u5185\u5fc3\u627e\u5230\u5e73\u9759\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f9\u990a\u5167\u5728\u529b\u91cf\u3002\u4f60\u6703\u5728\u81ea\u5df1\u5167\u5fc3\u627e\u5230\u5e73\u975c\u3002"
          }
        }
      }
    },
    "pfad_morgen_verfuegbar": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgen verf\u00fcgbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available tomorrow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible ma\u00f1ana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible demain"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0932 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile domani"
          }
        },

    "prog_saving_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib heute keinen einzigen Cent aus (Fixkosten ausgenommen). Kein Coffee-to-go, kein Bäcker, kein Online-Shopping."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't spend a single cent today (excluding fixed costs). No coffee-to-go, no bakery, no online shopping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No gastes ni un solo centavo hoy (excluidos los costos fijos). No hay café para llevar, ni panadería, ni compras en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne dépensez pas un seul centime aujourd'hui (hors frais fixes). Pas de café à emporter, pas de boulangerie, pas d'achats en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज एक पैसा भी खर्च न करें (निश्चित लागतों को छोड़कर)। न कॉफ़ी-टू-गो, न बेकरी, न ऑनलाइन शॉपिंग।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non spendere un solo centesimo oggi (esclusi i costi fissi). Niente caffè da asporto, niente panetteria, niente acquisti online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は一銭も使わないでください（固定費を除く）。持ち帰り用のコーヒー、ベーカリー、オンライン ショッピングはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 단 한 푼도 쓰지 마세요(고정비 제외). 테이크아웃 커피도 없고, 베이커리도 없고, 온라인 쇼핑도 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef vandaag geen cent uit (exclusief vaste kosten). Geen koffie-to-go, geen bakker, geen online shoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wydawaj dziś ani centa (z wyłączeniem kosztów stałych). Żadnej kawy na wynos, żadnej piekarni, żadnych zakupów online."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não gaste um único centavo hoje (excluindo custos fixos). Sem café para viagem, sem padaria, sem compras online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não gaste um único centavo hoje (excluindo custos fixos). Sem café para viagem, sem padaria, sem compras online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не потратьте сегодня ни цента (исключая фиксированные расходы). Никакого кофе с собой, никакой выпечки, никаких покупок в Интернете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün tek bir kuruş bile harcamayın (sabit maliyetler hariç). Kahve yok, fırın yok, internetten alışveriş yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不要花一分钱（不包括固定成本）。没有外带咖啡，没有面包店，没有网上购物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不要花一分錢（不包括固定成本）。沒有外帶咖啡，沒有麵包店，沒有網路購物。"
          }
        }
      }
    },

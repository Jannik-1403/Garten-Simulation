    "trash.nacht_snack_box.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Küche ab 21 Uhr – stelle ein Schild an den Kühlschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the kitchen at 9pm – put a sign on the fridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la cocina a las 21:00: pon un cartel en el frigorífico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme la cuisine à 21h – mets une pancarte sur le réfrigérateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रात 9 बजे से रसोई बंद कर दो – फ्रिज पर एक नोट लगा दो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la cucina alle 21 – metti un cartello sul frigorifero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "21時にキッチンを閉めましょう。冷蔵庫にサインを貼っておきましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤 9시에 주방을 닫으세요 – 냉장고에 표시를 붙여두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de keuken om 21 uur – hang een bordje aan de koelkast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij kuchnię o 21 – powieś tabliczkę na lodówce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche a cozinha às 21h – coloque uma placa na geladeira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche a cozinha às 21h – coloque uma placa na geladeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывайте кухню после 9 вечера. - повесить табличку на холодильник."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutfağı 21:00'de kapat – buzdolabına bir işaret koy."
          }
        },
        "zh-Hans": {

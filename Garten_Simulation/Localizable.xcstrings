    "trash.fastfood_lieferdienst.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6sche Lieferdienst-Apps von deinem Startbildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove delivery service apps from your home screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las apps de reparto de tu pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les applications de livraison de ton \u00e9cran d'accueil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0947 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi le app di consegna dalla schermata principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u914d\u9001\u30b5\u30fc\u30d3\u30b9\u30a2\u30d7\u30ea\u3092\u30db\u30fc\u30e0\u753b\u9762\u304b\u3089\u524a\u9664\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc30\ub2ec \uc11c\ube44\uc2a4 \uc571\uc744 \ud648 \ud654\uba74\uc5d0\uc11c \uc81c\uac70\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder bezorgservice-apps van je beginscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usu\u0144 aplikacje dostaw ze swojego ekranu g\u0142\u00f3wnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova os apps de delivery da sua tela inicial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u043b\u0443\u0436\u0431\u044b \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0441 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teslimat uygulamalar\u0131n\u0131 ana ekran\u0131ndan kald\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u4e3b\u5c4f\u5e55\u5220\u9664\u9001\u8d27\u670d\u52a1\u5e94\u7528\u7a0b\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u4e3b\u756b\u9762\u522a\u9664\u9001\u8ca8\u670d\u52d9\u61c9\u7528\u7a0b\u5f0f\u3002"
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestelltes Essen kommt oft kalt und teuer an \u2013 und f\u00fchlt sich nie so gut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordered food often arrives cold and expensive \u2013 and never feels as good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comida pedida suele llegar fr\u00eda y cara, y nunca sabe tan bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nourriture command\u00e9e arrive souvent froide et ch\u00e8re \u2013 et ne semble jamais aussi bonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0911\u0930\u094d\u0921\u0930 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0916\u093e\u0928\u093e \u0905\u0915\u094d\u0938\u0930 \u0920\u0902\u0921\u093e \u0914\u0930 \u092e\u0939\u0902\u0917\u093e \u0906\u0924\u093e \u0939\u0948 \u2013 \u0914\u0930 \u0915\u092d\u0940 \u092d\u0940 \u0905\u091a\u094d\u091b\u093e \u092e\u0939\u0938\u0942\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930\u093e\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cibo ordinato arriva spesso freddo e caro \u2013 e non sembra mai cos\u00ec buono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u6587\u3057\u305f\u98df\u4e8b\u306f\u51b7\u3081\u3066\u3044\u3066\u9ad8\u4fa1\u306a\u3053\u3068\u304c\u591a\u304f\u3001\u601d\u3063\u305f\u307b\u3069\u304a\u3044\u3057\u304f\u306a\u3044\u3053\u3068\u304c\u591a\u3044\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\ubb38\ud55c \uc74c\uc2dd\uc740 \uc885\uc885 \ucc28\uac11\uace0 \ube44\uc2f8\uac8c \uc624\uba70 \u2013 \uacb0\ucf54 \uae30\ub300\ub9cc\ud07c \uc88b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besteld eten komt vaak koud en duur aan \u2013 en voelt nooit zo goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamawiane jedzenie cz\u0119sto przyje\u017cd\u017ca zimne i drogie \u2013 i nigdy nie smakuje tak dobrze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comida pedida frequentemente chega fria e cara \u2013 e nunca \u00e9 t\u00e3o boa quanto parece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043a\u0430\u0437\u0430\u043d\u043d\u0430\u044f \u0435\u0434\u0430 \u0447\u0430\u0441\u0442\u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0439 \u0438 \u0434\u043e\u0440\u043e\u0433\u043e\u0439 \u2013 \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u0432\u0430\u0435\u0442 \u0442\u0430\u043a\u043e\u0439 \u0432\u043a\u0443\u0441\u043d\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sipari\u015f edilen yemek genellikle so\u011fuk ve pahal\u0131 gelir \u2013 ve asla bekledi\u011fin kadar iyi olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u7684\u98df\u7269\u901a\u5e38\u90fd\u662f\u51b7\u7684\u800c\u4e14\u4ef7\u683c\u6602\u8d35\u2014\u2014\u800c\u4e14\u611f\u89c9\u4ece\u6765\u6ca1\u6709\u90a3\u4e48\u597d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u7684\u98df\u7269\u901a\u5e38\u90fd\u662f\u51b7\u7684\u800c\u4e14\u50f9\u683c\u6602\u8cb4\u2014\u2014\u800c\u4e14\u611f\u89ba\u5f9e\u4f86\u6c92\u6709\u90a3\u9ebc\u597d\u3002"
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche Mahlzeiten vor (Meal-Prep) f\u00fcr die kommende Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook meals in advance (meal prep) for the coming week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina comidas con antelaci\u00f3n (meal prep) para la semana que viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9pare des repas \u00e0 l'avance (meal prep) pour la semaine \u00e0 venir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0917\u093e\u092e\u0940 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u092d\u094b\u091c\u0928 (\u092e\u0940\u0932-\u092a\u094d\u0930\u0947\u092a) \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara i pasti in anticipo (meal prep) per la settimana successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6765\u9031\u306e\u305f\u3081\u306b\u4e8b\u524d\u306b\u98df\u4e8b\u3092\u6e96\u5099\u3057\u3066\u304a\u304d\u307e\u3057\u3087\u3046\uff08\u30df\u30fc\u30eb\u30d7\u30ec\u30c3\u30d7\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c \uc8fc\ub97c \uc704\ud574 \ubbf8\ub9ac \uc2dd\uc0ac\ub97c \uc900\ube44\ud558\uc138\uc694(\ubc00 \ud504\ub819)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook maaltijden van tevoren (maaltijdvoorbereiding) voor de komende week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuj posi\u0142ki z wyprzedzeniem (meal prep) na nadchodz\u0105cy tydzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare refei\u00e7\u00f5es com anteced\u00eancia (meal prep) para a semana que vem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0435\u0434\u044b (\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0435\u0434\u044b) \u043d\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u043d\u0435\u0434\u0435\u043b\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6n\u00fcm\u00fczdeki hafta i\u00e7in \u00f6nceden yemek haz\u0131rla (meal prep)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u4e0b\u5468\u9884\u5148\u505a\u996d\uff08\u81b3\u98df\u51c6\u5907\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u4e0b\u9031\u9810\u5148\u505a\u98ef\uff08\u81b3\u98df\u6e96\u5099\uff09\u3002"
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche: Was kostet eine Bestellung vs. selbst kochen \u2013 pro Monat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare: what does an order cost vs. cooking yourself \u2013 per month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara: \u00bfcu\u00e1nto cuesta un pedido frente a cocinar t\u00fa mismo al mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare : combien co\u00fbte une commande par rapport \u00e0 cuisiner soi-m\u00eame \u2013 par mois ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0932\u0928\u093e \u0915\u0930\u0947\u0902: \u090f\u0915 \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0932\u093e\u0917\u0924 \u092c\u0928\u093e\u092e \u0916\u0941\u0926 \u0916\u093e\u0928\u093e \u092a\u0915\u093e\u0928\u0947 \u0915\u0940 \u2013 \u092a\u094d\u0930\u0924\u093f \u092e\u093e\u0939?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta: quanto costa un ordine rispetto a cucinare da soli \u2013 al mese?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bd4\u8f03\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u6708\u3054\u3068\u306b\u6ce8\u6587\u3068\u81ea\u708a\u306e\u30b3\u30b9\u30c8\u306f\u3069\u308c\u304f\u3089\u3044\u9055\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube44\uad50\ud574 \ubcf4\uc138\uc694: \uc6d4\ubcc4 \uc8fc\ubb38 \ube44\uc6a9 \ub300 \uc9c1\uc811 \uc694\ub9ac \ube44\uc6a9\uc740?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk: wat kost een bestelling versus zelf koken \u2013 per maand?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Por\u00f3wnaj: ile kosztuje zam\u00f3wienie w por\u00f3wnaniu z samodzielnym gotowaniem \u2013 miesi\u0119cznie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare: o que custa um pedido vs. cozinhar voc\u00ea mesmo \u2013 por m\u00eas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435: \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u0438\u0442 \u0437\u0430\u043a\u0430\u0437 \u0438 \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0432 \u043c\u0435\u0441\u044f\u0446?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar\u015f\u0131la\u015ft\u0131r: ayl\u0131k sipari\u015f maliyeti ile kendi yemek pi\u015firme maliyeti nedir?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bd4\u8f83\uff1a\u6bcf\u6708\u70b9\u9910\u4e0e\u81ea\u5df1\u505a\u996d\u7684\u8d39\u7528\u662f\u591a\u5c11\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bd4\u8f03\uff1a\u6bcf\u6708\u9ede\u9910\u8207\u81ea\u5df1\u716e\u98ef\u7684\u8cbb\u7528\u662f\u591a\u5c11\uff1f"
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Lieferdienst bestellen)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Meal Prep)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Lieferdienst bestellen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meal Prep)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Lieferdienst bestellen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meal Prep)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Lieferdienst bestellen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meal Prep)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u093e (\u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0938\u0947\u0935\u093e \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915 \u0930\u0939\u0947\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0915\u094b \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928 \u0915\u094b \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u092e\u0940\u0932 \u092a\u094d\u0930\u0947\u092a)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0938\u0930\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Lieferdienst bestellen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meal Prep)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Lieferdienst bestellen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meal Prep)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {

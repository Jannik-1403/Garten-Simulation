          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間自動で雑草を除去してくれる魔法の杖。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 동안 자동으로 잡초를 제거해 주는 마술 지팡이입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een toverstaf die 3 dagen lang automatisch onkruid verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magiczna różdżka, która automatycznie usuwa chwasty na 3 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

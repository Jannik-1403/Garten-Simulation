    "body.tracking.status.cutting.stagnation.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gewichtsverlust stagniert. Senke deine Kalorien um 200 kcal oder erhöhe Cardio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weight loss is stagnating. Reduce your calories by 200 kcal or increase cardio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pérdida de peso está estancada. Reduce tus calorías en 200 kcal o aumenta el cardio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre perte de poids stagne. Réduisez vos calories de 200 calories ou augmentez votre cardio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वज़न कम होना रुक रहा है। अपनी कैलोरी 200 कैलोरी कम करें या कार्डियो बढ़ाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua perdita di peso è stagnante. Riduci le calorie di 200 calorie o aumenta l'attività cardio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重の減少が停滞しています。カロリーを 200 カロリー減らすか、有酸素運動を増やします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 감량이 정체되고 있습니다. 칼로리를 200칼로리 낮추거나 유산소 운동량을 늘리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gewichtsverlies stagneert. Verlaag uw calorieën met 200 calorieën of verhoog uw cardio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja utrata wagi jest w stagnacji. Obniż kalorie o 200 kalorii lub zwiększ intensywność ćwiczeń cardio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perda de peso estagnada. Reduza 200 kcal ou aumente o cardio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua perda de peso está estagnada. Reduza suas calorias em 200 calorias ou aumente o cardio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша потеря веса застопорилась. Уменьшите калорийность на 200 калорий или увеличьте кардио."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo kaybınız durağanlaşıyor. Kalorilerinizi 200 kalori kadar azaltın veya kardiyoyu artırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的减肥停滞不前。减少 200 卡路里的卡路里或增加有氧运动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的減肥停滯不前。減少 200 卡路里的卡路里或增加有氧運動。"
          }
        }
      }
    },

            "state": "translated",
            "value": "Buy plant in shop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar planta en la tienda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheter la plante dans la boutique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0915\u093e\u0928 \u0938\u0947 \u092a\u094c\u0927\u093e \u0916\u0930\u0940\u0926\u0947\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra la pianta nel negozio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e7\u30c3\u30d7\u3067\u690d\u7269\u3092\u8cfc\u5165\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\uc810\uc5d0\uc11c \uc2dd\ubb3c \uad6c\uc785"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koop plant in winkel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kup ro\u015blin\u0119 w sklepie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar planta na loja"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0443\u043f\u0438\u0442\u044c \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u011fazadan bitki sat\u0131n al"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5546\u5e97\u8d2d\u4e70\u690d\u7269"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5546\u5e97\u8cfc\u8cb7\u690d\u7269"
          }
        }
      }
    },
    "pfad_gesund_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke heute 2 Liter Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink 2 liters of water today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe hoy 2 litros de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bois 2 litres d'eau aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c 2 \u0932\u0940\u091f\u0930 \u092a\u093e\u0928\u0940 \u092a\u093f\u092f\u0947\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi 2 litri d'acqua oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u6c34\u30922\u30ea\u30c3\u30c8\u30eb\u98f2\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \ubb3c 2\ub9ac\ud130\ub97c \ub9c8\uc154\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink vandaag 2 liter water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypij dzisiaj 2 litry wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe 2 litros de \u00e1gua hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u043f\u0435\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f 2 \u043b\u0438\u0442\u0440\u0430 \u0432\u043e\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn 2 litre su i\u00e7."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u559d2\u5347\u6c34\u3002"
          }
        },
        "zh-Hant": {

    "assessment.health.profile.optimierer.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein System läuft sauber. Halte die Standards und skaliere weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your system is running clean. Maintain the standards and keep scaling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sistema está funcionando limpio. Mantener los estándares y seguir escalando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre système fonctionne proprement. Maintenir les normes et continuer à évoluer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo sistema funziona in modo pulito. Mantieni gli standard e continua a crescere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは正常に動作しています。標準を維持し、規模を拡大し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 깨끗하게 실행되고 있습니다. 표준을 유지하고 계속해서 확장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw systeem werkt schoon. Handhaaf de normen en blijf opschalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój system działa czysto. Utrzymuj standardy i kontynuuj skalowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu sistema está funcionando limpo. Mantenha os padrões e continue aumentando."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisteminiz temiz çalışıyor. Standartları koruyun ve ölçeklendirmeye devam edin."
          }
        }
      }
    },
    "assessment.health.profile.optimierer.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein System läuft perfekt. Es gibt aktuell keine gesundheitsgefährdenden Gewohnheiten, die du abbauen müsstest."

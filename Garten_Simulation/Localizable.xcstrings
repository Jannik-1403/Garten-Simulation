    "stats.coach.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichgewicht: Versuche, alle Lebensbereiche gleichmäßig zu pflegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance: Try to nurture all life areas equally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio: Intenta cultivar todas las áreas de la vida por igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibre : Essaie de cultiver tous les aspects de ta vie de manière égale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio: Cerca di coltivare tutte le aree della vita in modo uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バランス：すべての生活領域を平等に育むように努めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균형: 모든 삶의 영역을 동등하게 육성하려고 노력하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans: Probeer alle levensgebieden in gelijke mate te koesteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Równowaga: Staraj się jednakowo pielęgnować wszystkie obszary życia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilíbrio: Tenta cultivar todas as áreas da vida igualmente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denge: Yaşamın tüm alanlarını eşit şekilde beslemeye çalışın."
          }
        }
      }
    },
    "stats.coach.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontinuität: Tägliche kleine Schritte führen zu großem Erfolg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency: Daily small steps lead to great success."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistencia: Los pequeños pasos diarios llevan a un gran éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régularité : De petits pas quotidiens mènent à un grand succès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costanza: Piccoli passi quotidiani portano a un grande successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一貫性: 毎日の小さな一歩が大きな成功につながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관성: 매일의 작은 발걸음이 큰 성공을 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistentie: Dagelijkse kleine stapjes leiden tot groot succes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsekwencja: codzienne małe kroki prowadzą do wielkiego sukcesu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistência: Pequenos passos diários levam a um grande sucesso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlılık: Günlük küçük adımlar büyük başarıya yol açar."
          }
        }
      }
    },
    "stats.coach.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtsamkeit: Höre auf deine Bedürfnisse und passe deine Ziele an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness: Listen to your needs and adjust your goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención plena: Escucha tus necesidades y ajusta tus metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pleine conscience : Écoute tes besoins et ajuste tes objectifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consapevolezza: Ascolta i tuoi bisogni e adatta i tuoi obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マインドフルネス: 自分のニーズに耳を傾け、目標を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음챙김: 귀하의 필요 사항을 듣고 목표를 조정하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness: Luister naar uw behoeften en pas uw doelen aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uważność: słuchaj swoich potrzeb i dostosowuj swoje cele."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente alerta: Ouve as tuas necessidades e ajusta os teus objetivos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farkındalık: İhtiyaçlarınızı dinleyin ve hedeflerinizi ayarlayın."
          }
        }
      }
    },
    "stats.coach.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt: Feiere jeden Meilenstein, egal wie klein er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress: Celebrate every milestone, no matter how small."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso: Celebra cada hito, no importa lo pequeño que sea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progrès : Célèbre chaque étape, aussi petite soit-elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso: Festeggia ogni traguardo, non importa quanto piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進歩: どんなに小さくても、すべてのマイルストーンを祝います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황: 아무리 작더라도 모든 이정표를 축하하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooruitgang: Vier elke mijlpaal, hoe klein ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postęp: świętuj każdy kamień milowy, bez względu na to, jak mały."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso: Celebra cada marco, não importa quão pequeno seja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme: Ne kadar küçük olursa olsun her dönüm noktasını kutlayın."
          }
        }
      }
    },

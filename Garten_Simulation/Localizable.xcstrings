        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw systeem werkt schoon. Handhaaf de normen en blijf opschalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój system działa czysto. Utrzymuj standardy i kontynuuj skalowanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu sistema está funcionando limpo. Mantenha os padrões e continue aumentando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя система работает чисто. Сохраняй стандарты и продолжай масштабироваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisteminiz temiz çalışıyor. Standartları koruyun ve ölçeklendirmeye devam edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的系统运行良好。保持标准并继续扩展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

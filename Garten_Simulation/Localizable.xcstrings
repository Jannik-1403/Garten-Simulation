    "body.tracking.status.bulking.deficit.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verbrennst mehr, als du isst. Kalorien sofort um 300 kcal hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are burning more than you eat. Increase calories by 300 kcal immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás quemando más de lo que comes. Aumenta las calorías en 300 kcal inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous brûlez plus que vous ne mangez. Les calories ont immédiatement augmenté de 300 kcal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप खाने से ज्यादा जलाते हैं। कैलोरी तुरंत 300 किलो कैलोरी बढ़ गई।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruci più di quanto mangi. Le calorie sono immediatamente aumentate di 300 kcal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食べる量よりも多くの量を燃やします。カロリーはすぐに300kcal増加しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹는 것보다 타는 것이 더 많습니다. 칼로리가 즉시 300kcal 증가했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verbrandt meer dan je eet. De calorieën namen onmiddellijk toe met 300 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalasz więcej niż jesz. Kalorie natychmiast wzrosły o 300 kcal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você queima mais do que come. Aumente as calorias em 300 kcal agora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você queima mais do que come. As calorias aumentaram imediatamente em 300 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сжигаете больше, чем едите. Калорийность сразу увеличилась на 300 ккал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yediğinden fazlasını yakarsın. Kaloriler hemen 300 kcal arttı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你燃烧的东西比你吃的东西还多。卡路里立刻增加了300大卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你燃燒的東西比你吃的東西還多。卡路里立刻增加了300大卡。"
          }
        }
      }
    },

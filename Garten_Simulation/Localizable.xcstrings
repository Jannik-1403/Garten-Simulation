    "tracking.mode.slider.example": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: Regler auf 60% → die Gewohnheit ist zu 60% erledigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Slider at 60% → habit is 60% completed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: Deslizador al 60% → el hábito está 60% completado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : Curseur à 60 % → l'habitude est terminée à 60 %."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण: स्लाइडर 60% पर → आदत 60% पूर्ण हो गई है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio: Cursore al 60% → l'abitudine è completata al 60%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: スライダーが 60% → 習慣が 60% 完了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 슬라이더를 60%로 설정 → 습관이 60% 완료되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld: Schuifregelaar op 60% → de gewoonte is voor 60% voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykład: Suwak na 60% → nawyk jest w 60% wykonany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplo: Controle deslizante em 60% → o hábito está 60% concluído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplo: Controle deslizante em 60% → o hábito está 60% concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: Ползунок на 60% → привычка выполнена на 60%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnek: Kaydırıcı %60'ta → alışkanlığın %60'ı tamamlandı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例：滑块处于 60% → 习惯已完成 60%。"

    "prog_deepwork_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Deep Work Slot am Wochenende nicht für Arbeit, sondern um dir ungestört eine neue, komplexe Fähigkeit anzueignen (Buch, Kurs)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't use the Deep Work slot on the weekend for work, but rather to acquire a new, complex skill (book, course) undisturbed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No utilices el espacio Deep Work el fin de semana para trabajar, sino para adquirir una habilidad nueva y compleja (libro, curso) sin ser molestado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilisez pas le créneau Deep Work le week-end pour travailler, mais plutôt pour acquérir une nouvelle compétence complexe (livre, cours) sans être dérangé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताहांत में काम के लिए डीप वर्क स्लॉट का उपयोग न करें, बल्कि बिना किसी बाधा के एक नया, जटिल कौशल (पुस्तक, पाठ्यक्रम) प्राप्त करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non utilizzare lo slot Deep Work nel fine settimana per lavorare, ma piuttosto per acquisire indisturbati una nuova, complessa abilità (libro, corso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末のディープ ワーク スロットを仕事に使用するのではなく、新しい複雑なスキル (書籍、コース) を邪魔されることなく取得するために使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말에 Deep Work 슬롯을 업무용으로 사용하지 말고, 방해받지 않고 새롭고 복잡한 기술(책, 강좌)을 습득하기 위해 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het Deep Work-slot in het weekend niet voor werk, maar juist om ongestoord een nieuwe, complexe vaardigheid (boek, cursus) te verwerven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykorzystuj slotu Deep Work w weekend do pracy, ale raczej do niezakłóconego zdobywania nowej, złożonej umiejętności (książki, kursu)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use o espaço Deep Work no fim de semana para trabalhar, mas sim para adquirir uma habilidade nova e complexa (livro, curso) sem ser perturbada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use o espaço Deep Work no fim de semana para trabalhar, mas sim para adquirir uma habilidade nova e complexa (livro, curso) sem ser perturbada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте слот Deep Work на выходных не для работы, а для спокойного приобретения нового, сложного навыка (книги, курса)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonları Deep Work slotunu iş için kullanmayın; bunun yerine yeni, karmaşık bir beceriyi (kitap, kurs) rahatsız edilmeden kazanmak için kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要在周末使用“深度工作”时段来工作，而是要不受干扰地获取新的、复杂的技能（书籍、课程）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要在週末使用「深度工作」時段來工作，而是要不受干擾地獲取新的、複雜的技能（書籍、課程）。"
          }
        }
      }
    },

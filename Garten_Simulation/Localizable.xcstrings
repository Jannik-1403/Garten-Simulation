    "trigger.own_trigger_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen eigenen Grund f\u00fcr diesen R\u00fcckfall ein."
          }
        },
        "en": {

    "calorie.calc.desc.missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es fehlen Körperdaten, um deinen genauen Kalorienbedarf zu berechnen. Bitte ergänze sie unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no body data to calculate your exact calorie needs. Please complete them below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No existen datos corporales para calcular sus necesidades calóricas exactas. Por favor complételos a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’existe aucune donnée corporelle permettant de calculer exactement vos besoins caloriques. Veuillez les compléter ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सटीक कैलोरी आवश्यकताओं की गणना करने के लिए कोई शारीरिक डेटा नहीं है। कृपया उन्हें नीचे पूरा करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono dati corporei per calcolare il tuo esatto fabbisogno calorico. Si prega di completarli di seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確なカロリー必要量を計算するための身体データはありません。以下に記入してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 칼로리 요구량을 계산할 수 있는 신체 데이터는 없습니다. 아래 사항을 완료해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen lichaamsgegevens om uw exacte caloriebehoefte te berekenen. Vul ze hieronder in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma danych dotyczących organizmu, które pozwalałyby obliczyć dokładne zapotrzebowanie kaloryczne. Wypełnij je poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam dados corporais para calcular sua necessidade exata de calorias. Por favor, adicione-os abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há dados corporais para calcular suas necessidades calóricas exatas. Preencha-os abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не существует данных о организме, позволяющих рассчитать точную потребность в калориях. Пожалуйста, заполните их ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam kalori ihtiyacınızı hesaplamak için vücut verisi yoktur. Lütfen bunları aşağıda tamamlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有身体数据可以计算您确切的卡路里需求。请完成下面的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有身體數據可以計算您確切的卡路里需求。請完成下面的內容。"
          }
        }
      }
    },
    "calorie.calc.desc.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wert (TDEE) wird basierend auf der Mifflin-St. Jeor Formel und deinen Körperdaten berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This value (TDEE) is calculated based on the Mifflin-St. Jeor formula and your body data are calculated."
          }
        },

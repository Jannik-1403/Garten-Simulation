    "plant.walnussbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Harte Schale, wertvoller Kern – Weiterbildung & Kurse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard shell, valuable core – Further education & Courses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cáscara dura, núcleo valioso – Formación continua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coque dure, noyau précieux – Formation continue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कठोर खोल, मूल्यवान अंदर – प्रशिक्षण और पाठ्यक्रम"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guscio duro, nucleo prezioso: formazione continua e corsi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードシェル、貴重なコア – さらなる教育とコース"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단단한 껍질, 귀중한 핵심 – 추가 교육 및 과정"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Harde schaal, waardevolle kern – Bijscholing & Cursussen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twarda skorupa, cenny rdzeń – dalsza edukacja i kursy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Casca dura, núcleo valioso – Formação contínua"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Casca dura, núcleo valioso – Formação contínua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твёрдая оболочка, ценное ядро – повышение квалификации и курсы"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert kabuk, değerli çekirdek – İleri Eğitim ve Kurslar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坚硬的外壳，珍贵的内核 – 进修与课程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "堅硬的外殼，寶貴的核心—進一步的訓練和課程"
          }
        }
      }
    },

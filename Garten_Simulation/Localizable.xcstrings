    "plant.create.insufficient_seeds": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend Samen! Du brauchst mindestens 10 Samen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough seeds! You need at least 10 seeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No hay suficientes semillas! Necesitas al menos 10 semillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de graines! Il vous faut au moins 10 graines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्याप्त बीज नहीं! आपको कम से कम 10 बीज चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai abbastanza semi! Ti servono almeno 10 semi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種が足りません！少なくとも10個の種が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "씨앗이 부족합니다! 최소 10개의 씨앗이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg zaden! Je hebt minstens 10 zaden nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało nasion! Potrzebujesz co najmniej 10 nasion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sementes insuficientes! Você precisa de pelo menos 10 sementes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sementes insuficientes! Você precisa de pelo menos 10 sementes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно семян! Тебе нужно как минимум 10 семян."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli tohum yok! En az 10 tohuma ihtiyacınız var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种子不足！你至少需要10颗种子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "種子不夠！你至少需要 10 顆種子。"
          }
        }
      }
    },

    "pfad_fit_day_60_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "60 Tage. Fitness ist nun ein fester Teil deines Lebens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 days. Fitness is now a fixed part of your life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "60 d\u00edas. El fitness es ahora una parte fija de tu vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "60 jours. Le fitness fait maintenant partie int\u00e9grante de ta vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "60 \u0926\u093f\u0928. \u092b\u093f\u091f\u0928\u0947\u0938 \u0905\u092c \u0906\u092a\u0915\u0947 \u091c\u0940\u0935\u0928 \u0915\u093e \u0905\u092d\u093f\u0928\u094d\u0928 \u0905\u0902\u0917 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "60 giorni. Il fitness \u00e8 ormai una parte fissa della tua vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60\u65e5\u3002\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u306f\u4eca\u3084\u3042\u306a\u305f\u306e\u751f\u6d3b\u306e\u4e00\u90e8\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60\uc77c \ud53c\ud2b8\ub2c8\uc2a4\ub294 \uc774\uc81c \uc0b6\uc758 \uace0\uc815\ub41c \ubd80\ubd84\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "60 dagen. Fitness is nu een vast onderdeel van uw leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "60 dni. Fitness jest teraz sta\u0142\u0105 cz\u0119\u015bci\u0105 Twojego \u017cycia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "60 dias. O fitness \u00e9 agora uma parte fixa da tua vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "60 \u0434\u043d\u0435\u0439. \u0424\u0438\u0442\u043d\u0435\u0441 \u0442\u0435\u043f\u0435\u0440\u044c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u043e\u0442\u044a\u0435\u043c\u043b\u0435\u043c\u043e\u0439 \u0447\u0430\u0441\u0442\u044c\u044e \u0432\u0430\u0448\u0435\u0439 \u0436\u0438\u0437\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "60 g\u00fcn. Fitness art\u0131k hayat\u0131n\u0131z\u0131n sabit bir par\u00e7as\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "60\u5929\u3002\u5065\u8eab\u73b0\u5728\u5df2\u6210\u4e3a\u4f60\u751f\u6d3b\u4e2d\u4e0d\u53ef\u6216\u7f3a\u7684\u4e00\u90e8\u5206\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "60 \u5929\u3002\u5065\u8eab\u73fe\u5728\u5df2\u6210\u70ba\u60a8\u751f\u6d3b\u4e2d\u4e0d\u53ef\u6216\u7f3a\u7684\u4e00\u90e8\u5206\u3002"
          }
        }
      }
    },

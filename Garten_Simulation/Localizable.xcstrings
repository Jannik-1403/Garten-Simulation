    "math_challenge.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse die folgende Matheaufgabe, um deine Fokus-Session abzubrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve the following math problem to cancel your focus session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve el siguiente problema de matemáticas para cancelar tu sesión de enfoque."
          }

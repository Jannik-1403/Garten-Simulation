    "pfad_produktiv_day_14_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 Tage produktives Arbeiten. Du hast deinen Rhythmus gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 days of productive work. You have found your rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14 d\u00edas de trabajo productivo. Has encontrado tu ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 jours de travail productif. Tu as trouv\u00e9 ton rythme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 \u0926\u093f\u0928 \u0915\u093e \u0909\u0924\u094d\u092a\u093e\u0926\u0915 \u0915\u093e\u0930\u094d\u092f\u0964 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u0932\u092f \u092e\u093f\u0932 \u0917\u092f\u0940 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "14 giorni di lavoro produttivo. Hai trovato il tuo ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14 \u65e5\u9593\u306e\u751f\u7523\u7684\u306a\u4f5c\u696d\u3002\u3042\u306a\u305f\u306f\u81ea\u5206\u306e\u30ea\u30ba\u30e0\u3092\u898b\u3064\u3051\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14\uc77c\uac04\uc758 \uc0dd\uc0b0\uc801\uc778 \uc791\uc5c5. \ub2f9\uc2e0\uc740 \ub2f9\uc2e0\uc758 \ub9ac\ub4ec\uc744 \ucc3e\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dagen productief werk. Je hebt je ritme gevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dni produktywnej pracy. Znalaz\u0142e\u015b sw\u00f3j rytm."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dias de trabalho produtivo. Encontraste o teu ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14 \u0434\u043d\u0435\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b. \u0422\u044b \u043d\u0430\u0448\u0451\u043b \u0441\u0432\u043e\u0439 \u0440\u0438\u0442\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 g\u00fcn verimli \u00e7al\u0131\u015fma. Ritmini buldun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "14\u5929\u9ad8\u6548\u5de5\u4f5c\u3002\u4f60\u5df2\u7ecf\u627e\u5230\u4e86\u81ea\u5df1\u7684\u8282\u594f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

    "plant.bambus.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue durch regelm\u00e4\u00dfiges Training St\u00e4rke und Widerstandskraft auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build strength and resilience through regular training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla fuerza y resistencia mediante el entrenamiento regular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9veloppez votre force et votre r\u00e9silience gr\u00e2ce \u00e0 un entra\u00eenement r\u00e9gulier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u092f\u092e\u093f\u0924 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0924\u093e\u0915\u0924 \u0914\u0930 \u0932\u091a\u0940\u0932\u093e\u092a\u0928 \u092c\u0928\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci forza e resilienza attraverso un allenamento regolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9a\u671f\u7684\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3067\u5f37\u3055\u3068\u56de\u5fa9\u529b\u3092\u7bc9\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uaddc\uce59\uc801\uc778 \ud6c8\ub828\uc744 \ud1b5\ud574 \uadfc\ub825\uacfc \ud68c\ubcf5\ub825\uc744 \uae30\ub974\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw kracht en veerkracht op door regelmatige training."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj si\u0142\u0119 i odporno\u015b\u0107 poprzez regularny trening."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa for\u00e7a e resili\u00eancia atrav\u00e9s de treinos regulares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439 \u0441\u0438\u043b\u0443 \u0438 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043e\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fczenli e\u011fitimle g\u00fc\u00e7 ve dayan\u0131kl\u0131l\u0131k olu\u015fturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u5b9a\u671f\u953b\u70bc\u589e\u5f3a\u529b\u91cf\u548c\u62b5\u6297\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u5b9a\u671f\u8a13\u7df4\u589e\u5f37\u529b\u91cf\u548c\u6062\u5fa9\u529b\u3002"
          }
        }
      }
    },
    "plant.basilikum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein aber intensiv im Geschmack \u2013 Bewusstes Essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small but intense in flavor \u2013 Mindful eating"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peque\u00f1a pero intensa en sabor \u2013 Alimentaci\u00f3n consciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit mais intense en saveur \u2013 Alimentation consciente"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u094b\u091f\u093e \u0932\u0947\u0915\u093f\u0928 \u0938\u094d\u0935\u093e\u0926 \u092e\u0947\u0902 \u0924\u0940\u0935\u094d\u0930 - \u0938\u091a\u0947\u0924 \u092d\u094b\u091c\u0928"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Small but intense in flavor \u2013 Mindful eating"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u3055\u3044\u306a\u304c\u3089\u3082\u6fc3\u539a\u306a\u5473\u308f\u3044 \u2013 \u610f\u8b58\u3057\u3066\u98df\u3079\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc791\uc9c0\ub9cc \uac15\ub82c\ud55c \ub9db \u2013 \ub9c8\uc74c\ucc59\uae40 \uc2dd\uc0ac"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein maar intens van smaak \u2013 Mindful eten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u0142e, ale intensywne w smaku \u2013 Uwa\u017cne jedzenie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno mas intenso em sabor \u2013 Alimenta\u00e7\u00e3o consciente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439, \u043d\u043e \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u044b\u0439 \u043f\u043e \u0432\u043a\u0443\u0441\u0443 \u2013 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00fc\u00e7\u00fck ama tad\u0131 yo\u011fun \u2013 Dikkatli yeme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u5de7\u4f46\u5473\u9053\u6d53\u90c1 \u2013 \u4e13\u6ce8\u996e\u98df"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96d6\u5c0f\u4f46\u5473\u9053\u6fc3\u9b31\u2014\u2014\u6709\u610f\u8b58\u7684\u98f2\u98df"
          }
        }
      }
    },

    "trash.doomscrolling_handy.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade das Handy nachts in einem anderen Zimmer \u2013 nicht im Schlafzimmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge your phone at night in another room \u2013 not in the bedroom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el tel\u00e9fono por la noche en otra habitaci\u00f3n, no en el dormitorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge ton t\u00e9l\u00e9phone la nuit dans une autre pi\u00e8ce \u2013 pas dans la chambre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u094b\u0928 \u0915\u094b \u0930\u093e\u0924 \u092e\u0947\u0902 \u0926\u0942\u0938\u0930\u0947 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u091a\u093e\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u2013 \u092c\u0947\u0921\u0930\u0942\u092e \u092e\u0947\u0902 \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica il telefono di notte in un'altra stanza \u2013 non in camera da letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u591c\u306f\u5225\u306e\u90e8\u5c4b\u3067\u643a\u5e2f\u3092\u5145\u96fb\u3057\u307e\u3057\u3087\u3046\u3002\u5bdd\u5ba4\u3067\u306f\u5145\u96fb\u3057\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc24\uc5d0\ub294 \ub2e4\ub978 \ubc29\uc5d0\uc11c \ucda9\uc804\ud558\uc138\uc694 \u2013 \uce68\uc2e4\uc5d0\uc11c\ub294 \uc548 \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad de telefoon 's nachts op in een andere kamer \u2013 niet in de slaapkamer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0141aduj telefon w nocy w innym pokoju \u2013 nie w sypialni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue o celular \u00e0 noite em outro quarto \u2013 n\u00e3o no quarto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u043e\u0447\u044c\u044e \u0437\u0430\u0440\u044f\u0436\u0430\u0439\u0442\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435, \u0430 \u043d\u0435 \u0432 \u0441\u043f\u0430\u043b\u044c\u043d\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu gece ba\u015fka bir odada \u015farj et \u2013 yatak odas\u0131nda de\u011fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u5728\u53e6\u4e00\u4e2a\u623f\u95f4\uff08\u800c\u4e0d\u662f\u5367\u5ba4\uff09\u7ed9\u624b\u673a\u5145\u7535\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u5728\u53e6\u4e00\u500b\u623f\u9593\uff08\u800c\u4e0d\u662f\u81e5\u5ba4\uff09\u70ba\u624b\u6a5f\u5145\u96fb\u3002"
          }
        }
      }
    },
    "trash.doomscrolling_handy.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doomscrolling aktiviert dein Angstzentrum \u2013 du wirst danach schlechter schlafen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doomscrolling activates your anxiety center \u2013 you'll sleep worse afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El doomscrolling activa tu centro de ansiedad: dormir\u00e1s peor despu\u00e9s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le doomscrolling active ton centre d'anxi\u00e9t\u00e9 \u2013 tu dormiras moins bien apr\u00e8s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u0942\u092e\u0938\u094d\u0915\u094d\u0930\u094b\u0932\u093f\u0902\u0917 \u0906\u092a\u0915\u0947 \u0921\u0930 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u094b \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0906\u092a\u0915\u0940 \u0928\u0940\u0902\u0926 \u0916\u0930\u093e\u092c \u0939\u094b\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il doomscrolling attiva il tuo centro dell'ansia \u2013 dormirai peggio dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c9\u30a5\u30fc\u30e0\u30b9\u30af\u30ed\u30fc\u30eb\u306f\u4e0d\u5b89\u30bb\u30f3\u30bf\u30fc\u3092\u6d3b\u6027\u5316\u3055\u305b\u307e\u3059\u3002\u305d\u306e\u5f8c\u306e\u7720\u308a\u304c\u6d45\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub460\uc2a4\ud06c\ub864\ub9c1\uc740 \ubd88\uc548 \uc911\ucd94\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4 \u2013 \uadf8 \ud6c4\uc5d0\ub294 \ub354 \ub098\uc058\uac8c \uc7a0\ub4e4 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doomscrolling activeert je angscentrum \u2013 daarna slaap je slechter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doomscrolling aktywuje twoje centrum l\u0119ku \u2013 potem b\u0119dziesz spa\u0142 gorzej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Doomscrolling ativa seu centro de ansiedade \u2013 voc\u00ea vai dormir pior depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0443\u043c\u0441\u043a\u0440\u043e\u043b\u043b\u0438\u043d\u0433 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0432\u0430\u0448 \u0446\u0435\u043d\u0442\u0440 \u0441\u0442\u0440\u0430\u0445\u0430 \u2014 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0432\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0445\u0443\u0436\u0435 \u0441\u043f\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doomscrolling kayg\u0131 merkezini harekete ge\u00e7irir \u2013 sonras\u0131nda daha k\u00f6t\u00fc uyursun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672b\u65e5\u5377\u8f74\u4f1a\u6fc0\u6d3b\u4f60\u7684\u6050\u60e7\u4e2d\u5fc3\u2014\u2014\u4e4b\u540e\u4f60\u4f1a\u7761\u5f97\u66f4\u7cdf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672b\u65e5\u6372\u8ef8\u6703\u555f\u52d5\u4f60\u7684\u6050\u61fc\u4e2d\u5fc3\uff0d\u4e4b\u5f8c\u4f60\u6703\u7761\u5f97\u66f4\u7cdf\u3002"
          }
        }
      }
    },
    "trash.doomscrolling_handy.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze 'Fokus-Modus' auf dem Handy in definierten Zeitfenstern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 'Focus Mode' on your phone during defined time windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el 'Modo de enfoque' en el tel\u00e9fono durante intervalos de tiempo definidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le 'Mode Concentration' sur le t\u00e9l\u00e9phone pendant des cr\u00e9neaux d\u00e9finis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u092f \u0938\u0940\u092e\u093e \u092e\u0947\u0902 \u092e\u094b\u092c\u093e\u0907\u0932 \u092a\u0930 '\u092b\u094b\u0915\u0938-\u092e\u094b\u0921' \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la 'Modalit\u00e0 Focus' sul telefono durante finestre temporali definite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c7a\u3081\u3089\u308c\u305f\u6642\u9593\u5e2f\u306b\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u306e\u300c\u96c6\u4e2d\u30e2\u30fc\u30c9\u300d\u3092\u5229\u7528\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\ud574\uc9c4 \uc2dc\uac04\ub300\uc5d0 \ud734\ub300\ud3f0\uc758 '\uc9d1\uc911 \ubaa8\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de 'Focusmodus' op de telefoon in bepaalde tijdvensters."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystaj z 'Trybu skupienia' na telefonie w okre\u015blonych przedzia\u0142ach czasowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o 'Modo Foco' no celular em janelas de tempo definidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0420\u0435\u0436\u0438\u043c \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u043e\u0432\u043a\u0438\u00bb \u043d\u0430 \u0441\u0432\u043e\u0435\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043e\u043a\u043d\u0430\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli zaman dilimlerinde telefonda 'Odak Modu'nu kullan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u89c4\u5b9a\u7684\u65f6\u95f4\u8303\u56f4\u5185\u4f7f\u7528\u624b\u673a\u4e0a\u7684\u201c\u4e13\u6ce8\u6a21\u5f0f\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u898f\u5b9a\u7684\u6642\u9593\u7bc4\u570d\u5167\u4f7f\u7528\u624b\u6a5f\u4e0a\u7684\u300c\u5c08\u6ce8\u6a21\u5f0f\u300d\u3002"
          }
        }
      }
    },
    "trash.doomscrolling_handy.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe auf, was du beim letzten Scroll wirklich N\u00fctzliches gelernt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down what you actually learned that was useful during your last scroll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota qu\u00e9 aprendiste de verdad \u00fatil en tu \u00faltimo scroll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9cris ce que tu as vraiment appris d'utile lors de ta derni\u00e8re session de d\u00e9filement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093f\u0916\u094b \u0915\u093f \u0906\u092a\u0928\u0947 \u0906\u0916\u093f\u0930\u0940 \u092c\u093e\u0930 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0909\u092a\u092f\u094b\u0917\u0940 \u0938\u0940\u0916\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa hai imparato di veramente utile durante l'ultimo scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u5f8c\u306b\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u305f\u3068\u304d\u306b\u672c\u5f53\u306b\u6709\u76ca\u306a\u3053\u3068\u3092\u4f55\u3092\u5b66\u3093\u3060\u304b\u66f8\u304d\u7559\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc2a4\ud06c\ub864\ud560 \ub54c \uc2e4\uc81c\ub85c \uc720\uc6a9\ud55c \uac83\uc744 \ubc30\uc6e0\ub294\uc9c0 \uc801\uc5b4\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf op wat je bij het laatste scrollen echt nuttigs hebt geleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz, czego naprawd\u0119 u\u017cytecznego nauczy\u0142e\u015b si\u0119 podczas ostatniego scrollowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o que voc\u00ea realmente aprendeu de \u00fatil no \u00faltimo scroll."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0442\u043e, \u0447\u0442\u043e \u0432\u044b \u0443\u0437\u043d\u0430\u043b\u0438, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043b\u0435\u0437\u043d\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u043f\u0440\u043e\u043a\u0440\u0443\u0442\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kayd\u0131rman\u0131zda ger\u00e7ekten faydal\u0131 ne \u00f6\u011frendi\u011finizi yaz\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5199\u4e0b\u60a8\u5728\u4e0a\u4e00\u6b21\u6eda\u52a8\u4e2d\u5b66\u5230\u7684\u771f\u6b63\u6709\u7528\u7684\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5beb\u4e0b\u60a8\u5728\u4e0a\u4e00\u6b21\u6efe\u52d5\u4e2d\u5b78\u5230\u7684\u771f\u6b63\u6709\u7528\u7684\u5167\u5bb9\u3002"
          }
        }
      }
    },
    "trash.doomscrolling_handy.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Doomscrolling)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Meditieren)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u093e (\u0921\u0942\u092e\u0938\u094d\u0915\u094d\u0930\u0949\u0932\u093f\u0902\u0917)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0926\u0943\u0937\u094d\u091f\u093f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u094b \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0947\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0926\u0902\u0921 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0927\u094d\u092f\u093e\u0928 \u0915\u0930\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0932\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0418\u0437\u0431\u0430\u0432\u044c\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0440\u0435\u0434\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (Doomscrolling)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438: \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u044b \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445. \n3. \u0423\u0441\u043b\u043e\u0436\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0443: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043e\u0442 \u0441\u0435\u0442\u0438). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0435\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e. \n\n**\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 (\u043c\u0435\u0434\u0438\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c: \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u044d\u0442\u043e \u0441 \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \n3. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e: \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c: \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0441\u0435\u0431\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Doomscrolling)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Meditieren)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u574f\u4e60\u60ef\uff08\u672b\u65e5\u6eda\u52a8\uff09**\n1. \u9690\u5f62\uff1a\u5c06\u89e6\u53d1\u56e0\u7d20\u79fb\u51fa\u89c6\u91ce\u3002\n2. \u8ba9\u81ea\u5df1\u53d8\u5f97\u6ca1\u6709\u5438\u5f15\u529b\uff1a\u610f\u8bc6\u5230\u8d1f\u9762\u540e\u679c\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u56f0\u96be\uff1a\u8bbe\u7f6e\u969c\u788d\uff08\u4f8b\u5982\u5220\u9664\u5e94\u7528\u7a0b\u5e8f\u3001\u62d4\u6389\u63d2\u5934\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6ee1\u610f\uff1a\u9644\u52a0\u5211\u7f5a\u6267\u884c\u3002\n\n**\u5efa\u7acb\u4e00\u4e2a\u597d\u4e60\u60ef\uff08\u51a5\u60f3\uff09**\n1. \u4f7f\u5176\u663e\u800c\u6613\u89c1\uff1a\u5c06\u89e6\u53d1\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u89c1\u7684\u4f4d\u7f6e\u3002\n2. \u8ba9\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c06\u5b83\u4e0e\u4f60\u559c\u6b22\u7684\u4e1c\u897f\u8054\u7cfb\u8d77\u6765\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u7b80\u5355\uff1a\u5c06\u969c\u788d\u51cf\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u949f\uff09\u3002\n4. \u8ba9\u5b83\u4ee4\u4eba\u6ee1\u610f\uff1a\u4e8b\u540e\u7acb\u5373\u5956\u52b1\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u58de\u7fd2\u6163\uff08\u672b\u65e5\u6efe\u52d5\uff09**\n1. \u96b1\u5f62\uff1a\u5c07\u89f8\u767c\u56e0\u7d20\u79fb\u51fa\u8996\u91ce\u3002\n2. \u8b93\u81ea\u5df1\u8b8a\u5f97\u6c92\u6709\u5438\u5f15\u529b\uff1a\u610f\u8b58\u5230\u8ca0\u9762\u5f8c\u679c\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u56f0\u96e3\uff1a\u8a2d\u5b9a\u969c\u7919\uff08\u4f8b\u5982\u522a\u9664\u61c9\u7528\u7a0b\u5f0f\u3001\u62d4\u6389\u63d2\u982d\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6eff\u610f\uff1a\u9644\u52a0\u5211\u7f70\u57f7\u884c\u3002\n\n**\u5efa\u7acb\u4e00\u500b\u597d\u7fd2\u6163\uff08\u51a5\u60f3\uff09**\n1. \u4f7f\u5176\u986f\u800c\u6613\u898b\uff1a\u5c07\u89f8\u767c\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u898b\u7684\u4f4d\u7f6e\u3002\n2. \u8b93\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c07\u5b83\u8207\u4f60\u559c\u6b61\u7684\u6771\u897f\u9023\u7d50\u8d77\u4f86\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u7c21\u55ae\uff1a\u5c07\u969c\u7919\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u9418\uff09\u3002\n4. \u8b93\u5b83\u4ee4\u4eba\u6eff\u610f\uff1a\u4e8b\u5f8c\u7acb\u5373\u734e\u52f5\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Fernseher ab und nutze die Zeit f\u00fcr dich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the TV and use the time for yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga el televisor y aprovecha el tiempo para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9teins la t\u00e9l\u00e9vision et prends du temps pour toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0940\u0935\u0940 \u092c\u0902\u0926 \u0915\u0930\u094b \u0914\u0930 \u0938\u092e\u092f \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spegni la TV e usa il tempo per te stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c6\u30ec\u30d3\u3092\u6d88\u3057\u3066\u3001\u81ea\u5206\u306e\u305f\u3081\u306b\u6642\u9593\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV\ub97c \ub044\uace0 \uc790\uc2e0\uc744 \uc704\ud55c \uc2dc\uac04\uc744 \uac00\uc9c0\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de tv uit en neem tijd voor jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142\u0105cz telewizor i wykorzystaj ten czas dla siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue a TV e use o tempo para si mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440 \u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0441\u0435\u0431\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Televizyonu kapat\u0131n ve zaman\u0131 kendinize ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5173\u6389\u7535\u89c6\uff0c\u628a\u65f6\u95f4\u7559\u7ed9\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95dc\u6389\u96fb\u8996\uff0c\u628a\u6642\u9593\u7559\u7d66\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Zuviel Fernsehen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u091f\u0947\u0932\u0940\u0935\u093f\u091c\u0928 \u0926\u0947\u0916\u0928\u093e) \u0906\u092a\u0915\u094b \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932 \u092e\u0947\u0902 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zuviel Fernsehen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u770b\u592a\u591a\u7535\u89c6\uff09\u4f1a\u6d88\u8017\u4f60\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u770b\u592a\u591a\u96fb\u8996\uff09\u6703\u6d88\u8017\u4f60\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.name": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuviel fern gesehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watched too much TV"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto demasiada televisi\u00f3n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A trop regard\u00e9 la t\u00e9l\u00e9"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0939\u0941\u0924 \u091f\u0940\u0935\u0940 \u0926\u0947\u0916\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardato troppa TV"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c6\u30ec\u30d3\u3092\u898b\u3059\u304e\u305f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV\ub97c \ub108\ubb34 \ub9ce\uc774 \ubd24\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel tv gekeken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogl\u0105da\u0142 za du\u017co telewizji"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visto muita televis\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043c\u043e\u0442\u0440\u0435\u043b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7ok fazla televizyon izledi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7535\u89c6\u770b\u4e86\u592a\u591a"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96fb\u8996\u770b\u4e86\u592a\u591a"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht zwitschernde Freunde an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attracts chirping friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrae a los amigos que cantan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attire les amis qui chantent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0939\u0915\u0924\u0947 \u0939\u0941\u090f \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {

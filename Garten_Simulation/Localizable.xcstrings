    "assessment.growth.profile.fakeWorker.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00f6r auf, deinen Arbeitsplatz aufzur\u00e4umen, bevor du beginnst. Setz dich ran und starte unperfekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop cleaning up your workspace before you start. Sit down and start imperfectly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de limpiar tu espacio de trabajo antes de comenzar. Si\u00e9ntate y empieza imperfectamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez de nettoyer votre espace de travail avant de commencer. Asseyez-vous et d\u00e9marrez imparfaitement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u0938\u092b\u093c\u093e\u0908 \u0915\u0930\u0928\u093e \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0902\u0964 \u092c\u0948\u0920 \u091c\u093e\u0913 \u0914\u0930 \u0905\u092a\u0942\u0930\u094d\u0923 \u0922\u0902\u0917 \u0938\u0947 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di pulire il tuo spazio di lavoro prima di iniziare. Siediti e inizia in modo imperfetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u59cb\u3081\u308b\u524d\u306b\u30ef\u30fc\u30af\u30b9\u30da\u30fc\u30b9\u306e\u30af\u30ea\u30fc\u30f3\u30a2\u30c3\u30d7\u3092\u3084\u3081\u3066\u304f\u3060\u3055\u3044\u3002\u5ea7\u3063\u3066\u4e0d\u5b8c\u5168\u306b\u30b9\u30bf\u30fc\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \uc791\uc5c5 \uacf5\uac04 \uccad\uc18c\ub97c \uc911\uc9c0\ud558\uc2ed\uc2dc\uc624. \uc549\uc544\uc11c \ubd88\uc644\uc804\ud558\uac8c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met het opruimen van uw werkruimte voordat u begint. Ga zitten en begin onvolmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesta\u0144 sprz\u0105ta\u0107 swoje miejsce pracy, zanim zaczniesz. Usi\u0105d\u017a i zacznij niedoskonale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare de limpar seu espa\u00e7o de trabalho antes de come\u00e7ar. Sente-se e comece de maneira imperfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u044c \u0443\u0431\u0438\u0440\u0430\u0442\u044c \u0441\u0432\u043e\u0451 \u0440\u0430\u0431\u043e\u0447\u0435\u0435 \u043c\u0435\u0441\u0442\u043e, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043d\u0430\u0447\u043d\u0451\u0448\u044c. \u0421\u0430\u0434\u0438\u0441\u044c \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u0439 \u043d\u0435\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015flamadan \u00f6nce \u00e7al\u0131\u015fma alan\u0131n\u0131z\u0131 temizlemeyi b\u0131rak\u0131n. Oturun ve kusurlu bir \u015fekilde ba\u015flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5f00\u59cb\u4e4b\u524d\uff0c\u4e0d\u8981\u6574\u7406\u4f60\u7684\u5de5\u4f5c\u573a\u6240\u3002\u5750\u4e0b\u6765\u5e76\u4e0d\u5b8c\u7f8e\u5730\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u958b\u59cb\u4e4b\u524d\u505c\u6b62\u6e05\u7406\u5de5\u4f5c\u7a7a\u9593\u3002\u5750\u4e0b\u4f86\uff0c\u958b\u59cb\u4e0d\u5b8c\u7f8e\u7684\u4e8b\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.fakeWorker.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite die ersten 10 Minuten am Schreibtisch komplett ohne Internetverbindung an der wichtigsten Aufgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work on the most important task for the first 10 minutes at your desk without an internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja en la tarea m\u00e1s importante durante los primeros 10 minutos en tu escritorio sin conexi\u00f3n a Internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez sur la t\u00e2che la plus importante pendant les 10 premi\u00e8res minutes \u00e0 votre bureau sans connexion Internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093f\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u0947 \u0905\u092a\u0928\u0947 \u0921\u0947\u0938\u094d\u0915 \u092a\u0930 \u092a\u0939\u0932\u0947 10 \u092e\u093f\u0928\u091f \u0924\u0915 \u0938\u092c\u0938\u0947 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0915\u093e\u0930\u094d\u092f \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora sull'attivit\u00e0 pi\u00f9 importante per i primi 10 minuti alla tua scrivania senza connessione Internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u521d\u306e 10 \u5206\u9593\u306f\u3001\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u306a\u3057\u3067\u30c7\u30b9\u30af\u3067\u6700\u3082\u91cd\u8981\u306a\u30bf\u30b9\u30af\u306b\u53d6\u308a\u7d44\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc778\ud130\ub137 \uc5f0\uacb0 \uc5c6\uc774 \ucc45\uc0c1\uc5d0\uc11c \ucc98\uc74c 10\ubd84 \ub3d9\uc548 \uac00\uc7a5 \uc911\uc694\ud55c \uc791\uc5c5\uc744 \uc218\ud589\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk de eerste 10 minuten aan je bureau aan de belangrijkste taak zonder internetverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuj nad najwa\u017cniejszym zadaniem przez pierwsze 10 minut przy biurku bez po\u0142\u0105czenia z Internetem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhe na tarefa mais importante durante os primeiros 10 minutos em sua mesa, sem conex\u00e3o com a Internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0431\u043e\u0442\u0430\u0439 \u043f\u0435\u0440\u0432\u044b\u0435 10 \u043c\u0438\u043d\u0443\u0442 \u0437\u0430 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u043c \u0441\u0442\u043e\u043b\u043e\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0431\u0435\u0437 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u043d\u0430\u0434 \u0441\u0430\u043c\u043e\u0439 \u0432\u0430\u0436\u043d\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0435\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lk 10 dakika boyunca internet ba\u011flant\u0131s\u0131 olmadan masan\u0131zda en \u00f6nemli g\u00f6rev \u00fczerinde \u00e7al\u0131\u015f\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6700\u91cd\u8981\u7684\u4efb\u52a1\u4e0a\uff0c\u5728\u684c\u524d\u5b8c\u5168\u4e0d\u8fde\u63a5\u4e92\u8054\u7f51\u5de5\u4f5c\u524d\u5341\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6c92\u6709\u7db2\u8def\u9023\u7dda\u7684\u60c5\u6cc1\u4e0b\uff0c\u5728\u8fa6\u516c\u684c\u524d\u7684\u524d 10 \u5206\u9418\u5167\u5b8c\u6210\u6700\u91cd\u8981\u7684\u4efb\u52d9\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.fakeWorker.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist 'besch\u00e4ftigt', aber nie produktiv. Wir durchbrechen den Pseudoflei\u00df durch radikale 1\uff05-Restriktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are 'busy' but never productive. We break through the pseudo-industriousness with radical 1\uff05 restrictions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s \"ocupado\" pero nunca eres productivo. Rompemos la pseudo laboriosidad con restricciones radicales del 1\uff05."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates \u00ab occup\u00e9 \u00bb mais jamais productif. Nous brisons le pseudo-industriel avec des restrictions radicales de 1\uff05."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a '\u0935\u094d\u092f\u0938\u094d\u0924' \u0939\u0948\u0902 \u0932\u0947\u0915\u093f\u0928 \u0915\u092d\u0940 \u0909\u0924\u094d\u092a\u093e\u0926\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0939\u092e \u0915\u091f\u094d\u091f\u0930\u092a\u0902\u0925\u0940 1\uff05 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u091b\u0926\u094d\u092e-\u0909\u0926\u094d\u092f\u094b\u0917\u0936\u0940\u0932\u0924\u093e \u0915\u094b \u0924\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei \"occupato\" ma mai produttivo. Superiamo la pseudo-operosit\u00e0 con restrizioni radicali dell\u20191\uff05."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u300c\u5fd9\u3057\u3044\u300d\u306e\u306b\u3001\u6c7a\u3057\u3066\u751f\u7523\u7684\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u904e\u6fc0\u306a\uff11\uff05\u898f\u5236\u3067\u64ec\u4f3c\u52e4\u52c9\u3092\u6253\u3061\u7834\u308b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 '\ubc14\uc058\uc9c0\ub9cc' \uacb0\ucf54 \uc0dd\uc0b0\uc801\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uacfc\uaca9\ud55c 1\uff05 \uc81c\ud55c\uc73c\ub85c \uc720\uc0ac\uadfc\uba74\uc744 \ub3cc\ud30c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent \u2018druk\u2019 maar nooit productief. We doorbreken de pseudo-ijverigheid met radicale beperkingen van 1\uff05."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b \u201ezaj\u0119ty\u201d, ale nigdy produktywny. Prze\u0142amujemy pseudoprzedsi\u0119biorczo\u015b\u0107 radykalnym 1\uff05 ograniczeniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 'ocupado', mas nunca produtivo. Rompemos a pseudo-industriosidade com restri\u00e7\u00f5es radicais de 1\uff05."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b '\u0437\u0430\u043d\u044f\u0442', \u043d\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u0435\u043d. \u041c\u044b \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u043c \u0438\u043b\u043b\u044e\u0437\u0438\u044e \u0443\u0441\u0435\u0440\u0434\u0438\u044f \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 1\uff05-\u043d\u044b\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Me\u015fguls\u00fcn' ama asla \u00fcretken de\u011filsin. Sahte \u00e7al\u0131\u015fkanl\u0131\u011f\u0131 \uff051'lik radikal k\u0131s\u0131tlamalarla a\u015f\u0131yoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u603b\u662f\u201c\u5fd9\u788c\u201d\uff0c\u4f46\u4ece\u672a\u9ad8\u6548\u3002\u6211\u4eec\u901a\u8fc7\u6fc0\u8fdb\u76841\uff05\u9650\u5236\u6253\u7834\u4f2a\u52e4\u594b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5f88\u201c\u5fd9\u201d\uff0c\u4f46\u5f9e\u4f86\u6c92\u6709\u751f\u7522\u529b\u3002\u6211\u5011\u7a81\u7834\u4e86\u6fc0\u9032\u76841\uff05\u9650\u5236\u7684\u507d\u52e4\u596e\u3002"
          }
        }
      }
    },

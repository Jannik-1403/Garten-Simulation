    "onboarding_tutorial_3_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiene Coins und kaufe neue Pflanzen & Gegenst\u00e4nde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn coins and buy new plants & items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana monedas y compra nuevas plantas y objetos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne des pi\u00e8ces et ach\u00e8te de nouvelles plantes et objets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0915\u094d\u0915\u0947 \u0915\u092e\u093e\u090f\u0901 \u0914\u0930 \u0928\u090f \u092a\u094c\u0927\u0947 \u0914\u0930 \u0935\u0938\u094d\u0924\u0941\u090f\u0901 \u0916\u0930\u0940\u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn coins and buy new plants & items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u3001\u65b0\u3057\u3044\u690d\u7269\u3084\u30a2\u30a4\u30c6\u30e0\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf54\uc778\uc744 \ud68d\ub4dd\ud558\uace0 \uc0c8\ub85c\uc6b4 \uc2dd\ubb3c\uacfc \uc544\uc774\ud15c\uc744 \uad6c\uc785\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien munten en koop nieuwe planten en items."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarabiaj monety i kupuj nowe ro\u015bliny i przedmioty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganha moedas e compra novas plantas e itens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439 \u043c\u043e\u043d\u0435\u0442\u044b \u0438 \u043f\u043e\u043a\u0443\u043f\u0430\u0439 \u043d\u043e\u0432\u044b\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para kazan\u0131n ve yeni bitkiler ve e\u015fyalar sat\u0131n al\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d5a\u53d6\u91d1\u5e01\u5e76\u8d2d\u4e70\u65b0\u7684\u690d\u7269\u548c\u7269\u54c1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cfa\u53d6\u91d1\u5e63\u4e26\u8cfc\u8cb7\u65b0\u690d\u7269\u548c\u7269\u54c1\u3002"
          }
        }
      }
    },

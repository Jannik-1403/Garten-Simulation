      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzichte auf Fast-Food, koche selbst und ern\u00e4hre dich ges\u00fcnder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip fast food, cook for yourself and eat healthier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la comida r\u00e1pida, cocina t\u00fa mismo y come m\u00e1s sano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9vite le fast-food, cuisine toi-m\u00eame et mange plus sainement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921 \u0938\u0947 \u092a\u0930\u0939\u0947\u091c\u093c \u0915\u0930\u0947\u0902, \u0916\u0941\u0926 \u0916\u093e\u0928\u093e \u092a\u0915\u093e\u090f\u0901 \u0914\u0930 \u0905\u0927\u093f\u0915 \u0938\u094d\u0935\u0938\u094d\u0925 \u0930\u0942\u092a \u0938\u0947 \u092d\u094b\u091c\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita il fast food, cucina da solo e mangia pi\u00f9 sano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30fc\u30b9\u30c8\u30d5\u30fc\u30c9\u3092\u907f\u3051\u3001\u81ea\u5206\u3067\u6599\u7406\u3057\u3066\u5065\u5eb7\u7684\u306b\u98df\u3079\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud328\uc2a4\ud2b8\ud478\ub4dc\ub97c \ud53c\ud558\uace0 \uc9c1\uc811 \uc694\ub9ac\ud558\uc5ec \ub354 \uac74\uac15\ud558\uac8c \uc2dd\uc0ac\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd fastfood, kook voor jezelf en eet gezonder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrezygnuj z fast food\u00f3w, gotuj sam i jedz zdrowiej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite fast food, cozinhe para si mesmo e coma de forma mais saud\u00e1vel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u0444\u0430\u0441\u0442-\u0444\u0443\u0434\u0430, \u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u0441\u0430\u043c\u0438 \u0438 \u043f\u0438\u0442\u0430\u0439\u0442\u0435\u0441\u044c \u0437\u0434\u043e\u0440\u043e\u0432\u043e\u0439 \u043f\u0438\u0449\u0435\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food'dan ka\u00e7\u0131n\u0131n, kendiniz pi\u015firin ve daha sa\u011fl\u0131kl\u0131 beslenin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u5feb\u9910\uff0c\u81ea\u5df1\u505a\u996d\uff0c\u5403\u5f97\u66f4\u5065\u5eb7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u5feb\u9910\uff0c\u81ea\u5df1\u505a\u98ef\uff0c\u5403\u5f97\u66f4\u5065\u5eb7\u3002"
          }
        }
      }
    },
    "trash.fast_food_abo.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Fast Food) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921) \u0906\u092a\u0915\u094b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0938\u0947 \u092e\u0939\u0930\u0942\u092e \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u094b \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u0444\u0430\u0441\u0442-\u0444\u0443\u0434) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u5feb\u9910\uff09\u4f1a\u6d88\u8017\u4f60\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u5feb\u9910\uff09\u6703\u6d88\u8017\u4f60\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },

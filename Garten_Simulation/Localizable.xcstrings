    "prog_stretching_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel ist die Verlängerung der hinteren Kette. Wichtig: Nicht über den Schmerzpunkt hinausgehen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goal is to lengthen the posterior chain. Important: Don't go beyond the pain point!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo es alargar la cadena posterior. Importante: ¡No vayas más allá del punto doloroso!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le but est d'allonger la chaîne postérieure. Important : n'allez pas au-delà du point douloureux !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य पश्च श्रृंखला को लंबा करना है। महत्वपूर्ण: दर्द बिंदु से आगे न बढ़ें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'obiettivo è allungare la catena posteriore. Importante: non andare oltre il punto dolente!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標は、後鎖を長くすることです。重要: 問題点を超えないようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표는 후방 사슬을 늘리는 것입니다. 중요: 문제점을 넘어서지 마십시오!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het doel is om de achterste keten te verlengen. Belangrijk: Ga niet verder dan het pijnpunt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celem jest wydłużenie tylnego łańcucha. Ważne: nie wykraczaj poza punkt bólu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O objetivo é alongar a cadeia posterior. Importante: não vá além do ponto problemático!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O objetivo é alongar a cadeia posterior. Importante: não vá além do ponto problemático!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель состоит в том, чтобы удлинить заднюю цепь. Важно: Не выходите за пределы болевой точки!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaç arka zinciri uzatmaktır. Önemli: Ağrı noktasının ötesine geçmeyin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标是延长后链。重要提示：不要超越痛点！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標是延長後鏈。重要提示：不要超越痛點！"
          }
        }
      }
    },

    "plant.pfirsichbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht sanfte Pflege, keine Gewalt \u2013 Stressreduktion"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs gentle care, no violence \u2013 Stress reduction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita cuidado suave \u2013 Reducci\u00f3n del estr\u00e9s"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A besoin de soins doux \u2013 R\u00e9duction du stress"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0930\u092e \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948, \u0939\u093f\u0902\u0938\u093e \u0928\u0939\u0940\u0902 \u2013 \u0924\u0928\u093e\u0935 \u0915\u092e \u0915\u0930\u0928\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs gentle care, no violence \u2013 Stress reduction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u512a\u3057\u3044\u30b1\u30a2\u304c\u5fc5\u8981\u3067\u3059\u304c\u3001\u66b4\u529b\u306f\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093 \u2013 \u30b9\u30c8\u30ec\u30b9\u306e\u8efd\u6e1b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3ed\ub825\uc774 \uc544\ub2cc \ubd80\ub4dc\ub7ec\uc6b4 \ubcf4\uc0b4\ud54c\uc774 \ud544\uc694\ud568 \u2013 \uc2a4\ud2b8\ub808\uc2a4 \uac10\uc18c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft zachte zorg nodig, geen geweld \u2013 Stressvermindering"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga delikatnej opieki, bez przemocy \u2013 Redukcja stresu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de cuidados suaves \u2013 Redu\u00e7\u00e3o do stress"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u043c\u044f\u0433\u043a\u043e\u043c \u0443\u0445\u043e\u0434\u0435, \u0431\u0435\u0437 \u043d\u0430\u0441\u0438\u043b\u0438\u044f \u2013 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0435\u0441\u0441\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik bak\u0131ma ihtiya\u00e7 var, \u015fiddet yok \u2013 Stres azaltma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u6e29\u67d4\u5475\u62a4\uff0c\u800c\u975e\u66b4\u529b \u2013 \u51cf\u538b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u6eab\u67d4\u7684\u8b77\u7406\uff0c\u800c\u4e0d\u662f\u66b4\u529b\uff0d\u6e1b\u8f15\u58d3\u529b"
          }
        }
      }
    },

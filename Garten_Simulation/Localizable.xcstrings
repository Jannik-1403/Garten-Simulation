    "weekly_report.tip.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Plane kleine, feste Fokus-Blöcke (z.B. 25 Minuten) ein, anstatt zu versuchen, stundenlang durchzuarbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Schedule small, fixed focus blocks (e.g. 25 minutes) instead of trying to work for hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Planifica bloques de enfoque pequeños y fijos (p.ej. 25 minutos) en lugar de intentar trabajar durante horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseil : Planifie de petits blocs de concentration fixes (p.ex. 25 minutes) plutôt que d'essayer de travailler pendant des heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाव: छोटे, निश्चित फोकस-ब्लॉक्स (जैसे 25 मिनट) योजना बनाएं, बजाय इसके कि घंटों तक लगातार काम करने की कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consiglio: Pianifica piccoli blocchi di concentrazione fissi (ad es. 25 minuti) invece di cercare di lavorare per ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：何時間も作業しようとするのではなく、小さな固定の集中ブロック（例：25分）を計画しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 몇 시간 동안 작업하려 하지 말고 작은 고정 집중 블록(예: 25분)을 계획하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Plan kleine, vaste focusblokken (bijv. 25 minuten) in plaats van te proberen urenlang te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka: Zaplanuj małe, stałe bloki skupienia (np. 25 minut) zamiast próbować pracować przez wiele godzin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: Planeje blocos de foco pequenos e fixos (ex: 25 minutos) em vez de tentar trabalhar por horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: планируйте небольшие фиксированные блоки внимания (например, 25 минут) вместо того, чтобы пытаться работать часами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: Saatler boyunca çalışmaya çalışmak yerine küçük, sabit odak blokları (ör. 25 dakika) planla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：计划小的、固定的焦点（例如 25 分钟），而不是尝试工作几个小时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示：規劃小的、固定的焦點（例如 25 分鐘），而不是嘗試工作幾個小時。"
          }
        }
      }
    },
    "weekly_report.tip.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Versuche, das Handy während deiner Sessions außer Sichtweite zu legen – das reduziert Ablenkungen enorm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Try keeping your phone out of sight during sessions – it massively reduces distractions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: Intenta mantener el teléfono fuera de tu vista durante las sesiones, eso reduce enormemente las distracciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseil : Essaie de garder ton téléphone hors de ta vue pendant tes sessions – cela réduit énormément les distractions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझाव: अपनी सत्रों के दौरान मोबाइल फोन को नज़र से दूर रखने की कोशिश करें – इससे ध्यान भटकने में काफी कमी आती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consiglio: Prova a tenere il telefono fuori dalla vista durante le sessioni – riduce enormemente le distrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：セッション中はスマホを視界の外に置くようにしましょう。これで気が散ることが大幅に減ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 세션 동안 스마트폰을 보이지 않는 곳에 두어 집중력 분산을 크게 줄이세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Probeer je telefoon tijdens sessies buiten het zicht te houden – dat vermindert afleidingen enorm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka: Staraj się trzymać telefon poza zasięgiem wzroku podczas sesji – to znacznie zmniejsza rozproszenia."
          }
        },
        "pt" : {
          "stringUnit" : {

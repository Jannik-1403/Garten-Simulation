          "stringUnit": {
            "state": "translated",
            "value": "हर बार पानी देने के साथ आप एक्सपी इकट्ठा करते हैं। आपके पौधे कांसे से हीरे तक बढ़ते हैं!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ogni irrigazione raccogli XP. Le tue piante crescono dal bronzo al diamante!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりをするたびにXPが集まります。あなたの植物はブロンズからダイヤモンドまで成長します!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물을 줄 때마다 XP를 수집합니다. 당신의 식물은 브론즈에서 다이아몬드로 성장합니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met elke bewatering verzamel je XP. Jouw planten groeien van Brons naar Diamant!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z każdym podlaniem zbierasz XP. Twoje rośliny rosną od brązu do diamentu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com cada rega, recolhes XP. As tuas plantas crescem de Bronze a Diamante!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com cada rega, recolhes XP. As tuas plantas crescem de Bronze a Diamante!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С каждым поливом вы зарабатываете XP. Ваши растения растут от бронзы до алмаза!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sulamada XP toplarsınız. Bitkileriniz Bronz'dan Elmas'a kadar büyüyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次浇水你都会收集经验值。你的植物会从青铜级成长到钻石级！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次澆水你都會收集經驗值。你的植物從青銅成長為鑽石！"
          }
        }
      }
    },

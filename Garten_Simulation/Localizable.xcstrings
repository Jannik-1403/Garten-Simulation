    "trash.alkohol_flatrate.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hauch von Kunst und Zeitlosigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A touch of art and timelessness."
          }
        },
        "es": {
          "stringUnit": {

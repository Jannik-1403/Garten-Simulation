    "assessment.health.profile.erschoepfer.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Regeneration ist mangelhaft. Anstatt direkt 8 Stunden Schlaf zu erzwingen, etablieren wir eine 1%-Reibung vor dem Schlafengehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your regeneration is inadequate. Instead of directly forcing 8 hours of sleep, we establish a 1% rub before bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regeneración es inadecuada. En lugar de forzar directamente 8 horas de sueño, establecemos una frotación del 1% antes de acostarnos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre régénération est insuffisante. Au lieu de forcer directement 8 heures de sommeil, on établit un frottement à 1% avant de se coucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पुनर्जनन अपर्याप्त है. सीधे तौर पर 8 घंटे की नींद के लिए बाध्य करने के बजाय, हम सोने से पहले 1% रगड़ना स्थापित करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua rigenerazione è inadeguata. Invece di forzare direttamente 8 ore di sonno, stabiliamo un massaggio dell’1% prima di andare a letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの再生能力は不十分です。 8時間の睡眠を直接強制するのではなく、就寝前に1%のマッサージを確立します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 재생은 불충분합니다. 직접적으로 8시간의 수면을 강요하는 대신, 잠자리에 들기 전 1%의 문지름을 설정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw wedergeboorte is ontoereikend. In plaats van direct 8 uur slaap af te dwingen, wrijven we voor het slapengaan een massage van 1% in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja regeneracja jest niewystarczająca. Zamiast bezpośrednio wymuszać 8 godzin snu, ustalamy 1% nacieranie przed snem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua regeneração é inadequada. Em vez de forçar diretamente 8 horas de sono, estabelecemos uma massagem de 1% antes de dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua regeneração é inadequada. Em vez de forçar diretamente 8 horas de sono, estabelecemos uma massagem de 1% antes de dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твое восстановление недостаточно. Вместо того чтобы заставлять себя спать прямо 8 часов, мы вводим 1%-ное сопротивление перед сном."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilenmeniz yetersiz. Doğrudan 8 saatlik uykuyu zorlamak yerine yatmadan önce %1'lik bir ovma oluşturuyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的恢复能力不足。与其强迫自己直接睡足8小时，我们不如在睡前建立1%的摩擦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的再生能力不夠。我們沒有直接強制睡眠 8 小時，而是在睡前進行 1% 的按摩。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.health.profile.optimierer.break": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwing dich nicht zu 100% Perfektion an einem Reisetag – akzeptiere 80% als ausreichend, um Stresshormone niedrig zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't force yourself to be 100% perfect on a travel day - accept 80% as enough to keep stress hormones low."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te fuerces a ser 100 % perfecto en un día de viaje; acepta el 80 % como suficiente para mantener bajas las hormonas del estrés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous forcez pas à être parfait à 100 % lors d’une journée de voyage – acceptez 80 % comme suffisant pour maintenir les hormones de stress à un niveau bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्रा के दिन अपने आप को 100% परफेक्ट होने के लिए मजबूर न करें - तनाव हार्मोन को कम रखने के लिए 80% को पर्याप्त मानें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non forzarti a essere perfetto al 100% durante una giornata di viaggio: accetta l'80% come sufficiente per mantenere bassi gli ormoni dello stress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行当日に 100% 完璧になろうと無理をする必要はありません。ストレス ホルモンを抑えるには 80% で十分だと受け入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 당일 자신에게 100% 완벽하다고 강요하지 마십시오. 스트레스 호르몬을 낮게 유지하기에 충분한 80%를 받아들이십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forceer jezelf niet om 100% perfect te zijn op een reisdag; accepteer 80% als voldoende om de stresshormonen laag te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zmuszaj się do bycia w 100% perfekcyjnym w dniu podróży – zaakceptuj 80% jako wystarczające, aby utrzymać niski poziom hormonów stresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se force a ser 100% perfeito em um dia de viagem – aceite 80% como suficiente para manter baixos os hormônios do estresse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se force a ser 100% perfeito em um dia de viagem – aceite 80% como suficiente para manter baixos os hormônios do estresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не заставляй себя быть на 100% совершенным в день путешествия — принимай 80% как достаточные, чтобы держать уровень стрессовых гормонов низким."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyahat gününde kendinizi %100 mükemmel olmaya zorlamayın; %80'in stres hormonlarını düşük tutmaya yeteceğini kabul edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要强迫自己在旅行日追求100%的完美——接受80%就足够，以保持压力激素的低水平。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要強迫自己在旅行當天做到 100% 完美 - 接受 80% 就足以保持較低的壓力荷爾蒙。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.health.profile.optimierer.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper ist bestens eingestellt. Um die letzten 1% Biohacking herauszuholen, musst du Details perfektionieren und Verbissenheit abbauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is perfectly adjusted. To get the last 1% of biohacking out, you have to perfect details and reduce stubbornness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo está perfectamente ajustado. Para sacar el último 1% del biohacking, hay que perfeccionar los detalles y reducir la terquedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps est parfaitement ajusté. Pour éliminer le dernier 1% de biohacking, il faut perfectionner les détails et réduire l’entêtement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका शरीर पूरी तरह से समायोजित है। बायोहैकिंग के अंतिम 1% को बाहर निकालने के लिए, आपको विवरण सही करना होगा और जिद कम करनी होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo è perfettamente adattato. Per ottenere l'ultimo 1% di biohacking, devi perfezionare i dettagli e ridurre la testardaggine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの体は完璧に調整されています。バイオハッキングの最後の 1% を引き出すには、細部を完璧にし、頑固さを軽減する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 몸은 완벽하게 조정되었습니다. 바이오해킹의 마지막 1%를 없애려면 세부 사항을 완벽하게 하고 고집을 줄여야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lichaam is perfect aangepast. Om de laatste 1% van het biohacking eruit te halen, moet je de details perfectioneren en de koppigheid verminderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ciało jest doskonale dostosowane. Aby wydobyć ostatni 1% biohackingu, musisz dopracować szczegóły i zmniejszyć upór."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo está perfeitamente ajustado. Para obter o último 1% do biohacking, você precisa aperfeiçoar os detalhes e reduzir a teimosia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo está perfeitamente ajustado. Para obter o último 1% do biohacking, você precisa aperfeiçoar os detalhes e reduzir a teimosia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твое тело настроено наилучшим образом. Чтобы выжать последние 1% биохакинга, тебе нужно совершенствовать детали и избавляться от упертости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuz mükemmel bir şekilde ayarlanmıştır. Biyolojik hacklemenin son %1'ini ortadan kaldırmak için ayrıntıları mükemmelleştirmeniz ve inatçılığı azaltmanız gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的身体状态最佳。为了挖掘最后1%的生物黑客潜力，你必须完善细节并减少执着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的身體已經完美調整。為了解決最後 1% 的生物駭客攻擊，你必須完善細節並減少固執。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.health.profile.vergifter.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du füllst den falschen Kraftstoff ein. Keine radikale Diät – wir verändern nur die Umgebung um 1%, um die Gewohnheit zu brechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're putting the wrong fuel in. Not a radical diet - we just change the environment by 1% to break the habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás poniendo el combustible equivocado. No es una dieta radical: simplemente cambiamos el medio ambiente en un 1% para romper con el hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous mettez le mauvais carburant. Pas un régime radical - nous modifions simplement l'environnement de 1 % pour rompre avec cette habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप गलत ईंधन डाल रहे हैं। कोई कट्टरपंथी आहार नहीं - हम आदत को तोड़ने के लिए पर्यावरण को सिर्फ 1% बदलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai inserendo il carburante sbagliato. Non è una dieta radicale: cambiamo semplicemente l'ambiente dell'1% per rompere l'abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違った燃料を入れています。過激なダイエットではありません。習慣を断ち切るために環境を 1% 変えるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 연료를 넣고 있는 것입니다. 급진적인 다이어트는 아닙니다. 습관을 깨기 위해 환경을 1%만 바꾸는 것뿐입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stopt er de verkeerde brandstof in. Geen radicaal dieet; we veranderen alleen de omgeving met 1% om de gewoonte te doorbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankujesz złe paliwo. Nie jest to radykalna dieta – po prostu zmieniamy środowisko o 1%, aby przełamać nawyk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está colocando o combustível errado. Não é uma dieta radical - apenas mudamos o ambiente em 1% para quebrar o hábito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está colocando o combustível errado. Não é uma dieta radical - apenas mudamos o ambiente em 1% para quebrar o hábito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты заливаешь неправильное топливо. Никаких радикальных диет — мы просто меняем окружение на 1%, чтобы сломать привычку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış yakıt koyuyorsunuz. Radikal bir diyet değil; sadece alışkanlığı kırmak için çevreyi %1 oranında değiştiriyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你加错燃料了。不是激进的节食——我们只是把环境改变1%，以打破习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你添加了錯誤的燃料。不是激進的飲食——我們只是改變 1% 的環境來改掉這個習慣。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.health.q1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist 14:30 Uhr. Du sitzt am Schreibtisch und fällst in ein massives Müdigkeitsloch. Dein Gehirn arbeitet nur noch auf 20%. Was tust du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's 2:30 p.m. You sit at your desk and fall into a massive hole of fatigue. Your brain only works at 20%. What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son las 14:30. Te sientas en tu escritorio y caes en un enorme agujero de fatiga. Tu cerebro sólo funciona al 20%. ¿Qué estás haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est 14h30. Vous êtes assis à votre bureau et tombez dans un énorme trou de fatigue. Votre cerveau ne fonctionne qu'à 20 %. Que fais-tu?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोपहर के 2:30 बजे हैं. आप अपने डेस्क पर बैठते हैं और थकान के भारी गड्ढे में गिर जाते हैं। आपका दिमाग केवल 20% ही काम करता है। आप क्या कर रहे हो?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono le 14:30 Ti siedi alla scrivania e cadi in un enorme buco di stanchezza. Il tuo cervello funziona solo al 20%. Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "午後2時30分です。机に座っていると、大きな疲労の穴に陥ってしまいます。脳は20%しか機能しません。何してるの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오후 2시 30분이에요. 당신은 책상에 앉아 엄청난 피로의 구멍에 빠진다. 당신의 두뇌는 20%로만 작동합니다. 뭐하세요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is 14.30 uur. Je zit aan je bureau en valt in een enorm gat van vermoeidheid. Je hersenen werken maar voor 20%. Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest 14:30. Siedzisz przy biurku i wpadasz w ogromną dziurę zmęczenia. Twój mózg pracuje tylko na 20%. Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São 14h30. Você se senta em sua mesa e cai em um enorme buraco de fadiga. Seu cérebro só funciona a 20%. O que você está fazendo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São 14h30. Você se senta em sua mesa e cai em um enorme buraco de fadiga. Seu cérebro só funciona a 20%. O que você está fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас 14:30. Ты сидишь за письменным столом и погружаешься в сильную усталость. Твой мозг работает только на 20%. Что ты делаешь?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat 14.30. Masanıza oturuyorsunuz ve büyük bir yorgunluk çukuruna düşüyorsunuz. Beyniniz yalnızca %20 oranında çalışır. Ne yapıyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在是14:30。你坐在书桌前，陷入了巨大的疲倦漩涡中。你的大脑只运行在20%的状态。你会怎么做？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在是下午 2:30。你坐在辦公桌前，陷入了巨大的疲勞。你的大腦只工作了 20%。你在幹什麼？"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.health.q11.d": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin viel draußen, schaue aber auch beim Gehen zu 90% auf mein Smartphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I spend a lot of time outside, but I also look at my smartphone 90% of the time when I walk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso mucho tiempo al aire libre, pero también miro mi teléfono inteligente el 90% del tiempo cuando camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je passe beaucoup de temps dehors, mais je regarde aussi mon smartphone 90 % du temps lorsque je marche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं बहुत सारा समय बाहर बिताता हूं, लेकिन जब मैं चलता हूं तो 90% समय अपने स्मार्टफोन पर भी देखता हूं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascorro molto tempo fuori, ma guardo anche il mio smartphone il 90% delle volte quando cammino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は外で過ごす時間が多いですが、歩いているときも9割はスマホを見ています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저는 밖에서 많은 시간을 보내지만, 걸을 때에도 90%의 시간을 스마트폰을 봅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik breng veel tijd buiten door, maar kijk ook 90% van de tijd op mijn smartphone als ik loop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dużo czasu spędzam na świeżym powietrzu, ale podczas spaceru przez 90% czasu patrzę też na smartfon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo muito tempo fora de casa, mas também olho para o meu smartphone 90% do tempo quando caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo muito tempo fora de casa, mas também olho para o meu smartphone 90% do tempo quando caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

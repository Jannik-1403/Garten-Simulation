    "body.tracking.status.bulking.stagnation.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Treibstoff. Erhöhe deine täglichen Kalorien ab morgen um 200 kcal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough fuel. Increase your daily calories by 200 kcal starting tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta de combustible. Aumenta tus calorías diarias en 200 kcal a partir de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop peu de carburant. Dès demain, augmentez vos calories quotidiennes de 200 kcal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत कम ईंधन. कल से, अपनी दैनिक कैलोरी 200 किलो कैलोरी बढ़ाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo poco carburante. Da domani aumenta le tue calorie giornaliere di 200 kcal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "燃料が少なすぎます。明日から1日の摂取カロリーを200kcal増やしてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연료가 너무 적습니다. 내일부터 일일 칼로리를 200kcal 늘려보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig brandstof. Verhoog vanaf morgen uw dagelijkse calorieën met 200 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało paliwa. Od jutra zwiększ dzienną liczbę kalorii o 200 kcal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco combustível. Aumente 200 kcal nas calorias diárias a partir de amanhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito pouco combustível. A partir de amanhã, aumente suas calorias diárias em 200 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком мало топлива. С завтрашнего дня увеличьте ежедневную калорийность на 200 ккал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok az yakıt. Yarından itibaren günlük kalorilerinizi 200 kcal artırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "燃油太少了。从明天开始，将每日卡路里摄入量增加 200 kcal。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燃油太少了。從明天開始，將每日卡路里攝取量增加 200 kcal。"
          }
        }
      }
    },

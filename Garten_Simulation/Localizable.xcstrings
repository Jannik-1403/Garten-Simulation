          "stringUnit" : {
            "state" : "translated",
            "value" : "我立即拒絕。沒有風險就沒有回報。"
          }
        }
      }
    },
    "assessment.finance.q12.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {

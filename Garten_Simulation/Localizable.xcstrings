    "trash.zigaretten_automat.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spendet Schatten an hei\u00dfen Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provides shade on hot days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciona sombra en d\u00edas calurosos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournit de l'ombre les jours chauds."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0930\u094d\u092e \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u091b\u093e\u092f\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provides shade on hot days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6691\u3044\u65e5\u306b\u65e5\u9670\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub354\uc6b4 \ub0a0\uc5d0\ub294 \uadf8\ub298\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biedt schaduw op warme dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daje cie\u0144 w upalne dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornece sombra nos dias quentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u043d\u044c \u0432 \u0436\u0430\u0440\u043a\u0438\u0435 \u0434\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131cak g\u00fcnlerde g\u00f6lge sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u708e\u70ed\u7684\u65e5\u5b50\u91cc\u63d0\u4f9b\u9634\u51c9\u3002"
          }
        },
        "zh-Hant": {

    "plant.ginkgo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältester Baum der Welt – unvergesslich – Gedächtnisübungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest tree in the world – unforgettable – Memory exercises"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árbol más antiguo del mundo – Ejercicios de memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbre le plus ancien du monde – inoubliable – Exercices de mémoire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया का सबसे पुराना पेड़ – अविस्मरणीय – स्मृति अभ्यास"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'albero più antico del mondo – indimenticabile – esercizi di memoria"
          }
        },
        "ja": {

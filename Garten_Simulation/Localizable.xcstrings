        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0915\u094d\u0937\u093e! \u0907\u0938 \u0924\u0930\u0939 \u0906\u092a \u0905\u092a\u0928\u0940 \u0906\u0926\u0924\u0947\u0902 \u092c\u0928\u093e\u090f \u0930\u0916\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Great! This is how you nurture your habits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d20\u6674\u3089\u3057\u3044\uff01\u3053\u3046\u3084\u3063\u3066\u7fd2\u6163\u3092\u80b2\u3093\u3067\u3044\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5c4\uccad\ub09c! \uc774\uac83\uc774 \uc2b5\uad00\uc744 \ud0a4\uc6b0\ub294 \ubc29\ubc95\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig! Zo onderhoud je je gewoontes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015awietnie! W ten spos\u00f3b piel\u0119gnujesz swoje nawyki."

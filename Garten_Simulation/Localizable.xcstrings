        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Ich hasse dieses Gefühl, wann ist das endlich vorbei?'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'I hate this feeling, when will this finally be over?'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Odio este sentimiento, ¿cuándo terminará esto finalmente?'"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Je déteste ce sentiment, quand est-ce que ça sera enfin fini ?\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'मुझे इस भावना से नफरत है, यह आखिरकार कब खत्म होगा?'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Odio questa sensazione, quando finirà finalmente tutto questo?'"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「この気持ちは嫌だ、いつになったら終わるんだろう？」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'이 느낌이 싫다. 언제쯤 끝나지?'"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Ik haat dit gevoel, wanneer is dit eindelijk voorbij?'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nienawidzę tego uczucia. Kiedy to w końcu się skończy?”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Eu odeio esse sentimento, quando isso finalmente acabará?'"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Я ненавижу это чувство, когда же это наконец закончится?'"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Bu duygudan nefret ediyorum, bu nihayet ne zaman bitecek?'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我讨厌这种感觉，这到底什么时候才结束？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我討厭這種感覺，什麼時候才能結束？”"
          }
        }
      }
    },
    "assessment.fitness.q12.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Noch zwei Wiederholungen, dann habe ich es überstanden.'"

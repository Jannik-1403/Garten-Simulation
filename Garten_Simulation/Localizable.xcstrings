    "prog_cleaning_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde heute 3 Dinge in deiner Wohnung, die du nicht mehr brauchst. Wegwerfen, spenden oder verkaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find 3 things in your apartment today that you no longer need. Throw away, donate or sell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra hoy 3 cosas en tu apartamento que ya no necesitas. Tirar, donar o vender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez aujourd’hui 3 choses dans votre appartement dont vous n’avez plus besoin. Jetez, donnez ou vendez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज ही अपने अपार्टमेंट में 3 चीज़ें ढूंढें जिनकी अब आपको आवश्यकता नहीं है। फेंक दो, दान करो या बेच दो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova oggi nel tuo appartamento 3 cose che non ti servono più. Butta via, dona o vendi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐアパートにある不要なものを 3 つ見つけてください。捨てるか、寄付するか、売るか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 당신의 아파트에서 더 이상 필요하지 않은 물건 3가지를 찾아보세요. 버리거나 기부하거나 판매하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek vandaag nog 3 dingen in je appartement die je niet meer nodig hebt. Gooi weg, doneer of verkoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dziś w swoim mieszkaniu 3 rzeczy, których już nie potrzebujesz. Wyrzuć, podaruj lub sprzedaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre hoje três coisas em seu apartamento que você não precisa mais. Jogue fora, doe ou venda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre hoje três coisas em seu apartamento que você não precisa mais. Jogue fora, doe ou venda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите сегодня в своей квартире 3 вещи, которые вам больше не нужны. Выбросьте, подарите или продайте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün dairenizde artık ihtiyacınız olmayan 3 şeyi bulun. Atın, bağışlayın veya satın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天在您的公寓中找到 3 件您不再需要的东西。扔掉、捐赠或出售。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天在您的公寓中找到 3 件您不再需要的東西。丟掉、捐贈或出售。"
          }
        }
      }
    },

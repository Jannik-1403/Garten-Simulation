    "pflanze.wiederbeleben.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Pflanze war %d Tage nicht gegossen. Nach der Wiederbelebung erh\u00e4ltst du f\u00fcr 3 Tage weniger XP und M\u00fcnzen beim Gie\u00dfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plant hasn't been watered for %d days. After revival, you'll earn less XP and coins for 3 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta no ha sido regada durante %d d\u00edas. Tras revivirla, ganar\u00e1s menos XP y monedas durante 3 d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette plante n'a pas \u00e9t\u00e9 arros\u00e9e depuis %d jours. Apr\u00e8s la r\u00e9animation, tu gagneras moins de XP et de pi\u00e8ces pendant 3 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u094c\u0927\u0947 \u0915\u094b%d\u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u092a\u093e\u0928\u0940 \u0928\u0939\u0940\u0902 \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u092a\u0941\u0928\u0930\u094d\u091c\u0940\u0935\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0906\u092a\u0915\u094b 3 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0915\u093e\u0938\u094d\u091f\u093f\u0902\u0917 \u0938\u0947 \u0915\u092e XP \u0914\u0930 \u0938\u093f\u0915\u094d\u0915\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0902\u0917\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This plant hasn't been watered for %d days. After revival, you'll earn less XP and coins for 3 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u690d\u7269\u306f %d \u65e5\u9593\u6c34\u3084\u308a\u3092\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u5fa9\u6d3b\u5f8c\u30013 \u65e5\u9593\u7372\u5f97\u3067\u304d\u308b XP \u3068\u30b3\u30a4\u30f3\u304c\u5c11\u306a\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc2dd\ubb3c\uc5d0 %d\uc77c \ub3d9\uc548 \ubb3c\uc744 \uc8fc\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ubd80\ud65c \ud6c4\uc5d0\ub294 3\uc77c \ub3d9\uc548 \ub354 \uc801\uc740 XP\uc640 \ucf54\uc778\uc744 \ud68d\ub4dd\ud558\uac8c \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze plant heeft al %d dagen geen water gekregen. Na de heropleving verdien je gedurende 3 dagen minder XP en munten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ro\u015blina nie by\u0142a podlewana przez %d dni. Po odrodzeniu b\u0119dziesz zdobywa\u0142 mniej PD i monet przez 3 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta n\u00e3o foi regada durante %d dias. Ap\u00f3s a revivifica\u00e7\u00e3o, ganhar\u00e1s menos XP e moedas durante 3 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u043d\u0435 \u043f\u043e\u043b\u0438\u0432\u0430\u043b\u0438%d\u0434\u043d\u0435\u0439. \u041f\u043e\u0441\u043b\u0435 \u043e\u0436\u0438\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u0437\u0430 \u043f\u043e\u043b\u0438\u0432 \u043d\u0430 3 \u0434\u043d\u044f \u043c\u0435\u043d\u044c\u0448\u0435 \u043e\u043f\u044b\u0442\u0430 \u0438 \u043c\u043e\u043d\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bitki %d g\u00fcnd\u00fcr sulanm\u0131yor. Dirili\u015ften sonra 3 g\u00fcn boyunca daha az XP ve jeton kazanacaks\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u682a\u690d\u7269\u5df2 %d \u5929\u672a\u6d47\u6c34\u3002\u590d\u6d3b\u540e\uff0c\u60a8\u5728\u6d47\u6c34\u65f6\u83b7\u5f97\u7684\u7ecf\u9a8c\u503c\u548c\u91d1\u5e01\u5c06\u57283\u5929\u5185\u51cf\u5c11\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a72\u690d\u7269\u5df2\u7d93%d\u5929\u6c92\u6709\u6f86\u6c34\u3002\u5fa9\u6d3b\u5f8c\uff0c\u60a8\u5c07\u5728 3 \u5929\u5167\u7372\u5f97\u66f4\u5c11\u7684 XP \u548c\u9444\u9020\u91d1\u5e63\u3002"
          }
        }
      }
    },

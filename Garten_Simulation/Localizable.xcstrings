    "tour_todo_intro_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle tägliche To-Dos und hake sie ab, um XP zu sammeln!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create daily to-dos and check them off to earn XP!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Crea tareas diarias y márcalas para ganar XP!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des tâches quotidiennes et cochez-les pour gagner de l'XP !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनिक कार्य बनाएं और XP कमाने के लिए उन्हें जांचें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea compiti giornalieri e spuntali per guadagnare XP!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日のタスクを作成し、チェックしてXPを獲得しましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 할 일을 만들고 완료하여 XP를 얻으세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak dagelijkse taken en vink ze af om XP te verdienen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz codzienne zadania i odhaczaj je, aby zdobywać XP!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie tarefas diárias e marque-as para ganhar XP!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie tarefas diárias e marque-as para ganhar XP!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте ежедневные задачи и отмечайте их, чтобы зарабатывать XP!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük görevler oluşturun ve XP kazanmak için onları işaretleyin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建日常待办事项并勾选它们以赚取经验值！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創建日常待辦事項並勾選它們以賺取經驗值！"
          }
        }
      }
    },

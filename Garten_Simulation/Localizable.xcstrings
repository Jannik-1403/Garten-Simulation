    "plant.wildgras.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessere deine Ausdauer und laufe zu neuen H\u00f6chstleistungen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve your endurance and run to new peak performances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu resistencia y corre hacia nuevos r\u00e9cords."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Am\u00e9liorez votre endurance et courez vers de nouveaux sommets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0938\u0939\u0928\u0936\u0915\u094d\u0924\u093f \u092c\u0922\u093c\u093e\u090f\u0901 \u0914\u0930 \u0928\u090f \u0938\u0930\u094d\u0935\u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0924\u0915 \u0926\u094c\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliora la tua resistenza e corri verso nuove vette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6301\u4e45\u529b\u3092\u5411\u4e0a\u3055\u305b\u3001\u65b0\u305f\u306a\u6700\u9ad8\u8a18\u9332\u306b\u5411\u304b\u3063\u3066\u8d70\u308a\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uad6c\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc0c8\ub85c\uc6b4 \ucd5c\uace0 \uae30\ub85d\uc744 \ud5a5\ud574 \ub2ec\ub9ac\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbeter je uithoudingsvermogen en ren naar nieuwe hoogtes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw swoj\u0105 wytrzyma\u0142o\u015b\u0107 i biegaj po nowe rekordy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhore sua resist\u00eancia e corra para novos recordes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043b\u0443\u0447\u0448\u0430\u0439 \u0441\u0432\u043e\u044e \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0438 \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0439 \u043d\u043e\u0432\u044b\u0445 \u0432\u044b\u0441\u043e\u0442 \u0432 \u0431\u0435\u0433\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayan\u0131kl\u0131l\u0131\u011f\u0131n\u0131z\u0131 art\u0131r\u0131n ve yeni zirvelere ko\u015fun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u5347\u4f60\u7684\u8010\u529b\uff0c\u8dd1\u51fa\u65b0\u9ad8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u9ad8\u4f60\u7684\u8010\u529b\u4e26\u9054\u5230\u65b0\u7684\u9ad8\u5ea6\u3002"
          }
        }
      }
    },
    "plant.zitronenbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauer macht stark \u2013 Vitamin C & Immunsystem"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sour makes power \u2013 Vitamin C & Immune system"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo \u00e1cido da poder \u2013 Vitamina C e inmunidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acidit\u00e9 rend fort \u2013 Vitamine C & Syst\u00e8me immunitaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u091f\u094d\u091f\u093e \u0936\u0915\u094d\u0924\u093f \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948 \u2013 \u0935\u093f\u091f\u093e\u092e\u093f\u0928 C \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0923\u093e\u0932\u0940"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sour makes power \u2013 Vitamin C & Immune system"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9178\u5473\u306f\u529b\u3092\u751f\u3080 \u2013 \u30d3\u30bf\u30df\u30f3C\u3068\u514d\u75ab\u30b7\u30b9\u30c6\u30e0"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e0\ub9db\uc774 \ud798\uc744 \ub9cc\ub4e0\ub2e4 - \ube44\ud0c0\ubbfcC & \uba74\uc5ed\uccb4\uacc4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuur maakt kracht \u2013 Vitamine C & immuunsysteem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa\u015bny daje moc \u2013 witamina C i uk\u0142ad odporno\u015bciowy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O azedo d\u00e1 for\u00e7a \u2013 Vitamina C & Sistema imunit\u00e1rio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0438\u0441\u043b\u043e\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u2013 \u0432\u0438\u0442\u0430\u043c\u0438\u043d C \u0438 \u0438\u043c\u043c\u0443\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek\u015fi g\u00fc\u00e7 verir \u2013 C Vitamini ve Ba\u011f\u0131\u015f\u0131kl\u0131k sistemi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9178\u80fd\u5f3a\u8eab\u2014\u2014\u7ef4\u751f\u7d20C\u4e0e\u514d\u75ab\u7cfb\u7edf"
          }
        },
        "zh-Hant": {

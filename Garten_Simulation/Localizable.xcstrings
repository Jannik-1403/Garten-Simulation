    "assessment.fitness.profile.maschine.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Respekt. Behalte diesen unaufhaltsamen Fokus bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect. Maintain that unstoppable focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeto. Mantenga ese enfoque imparable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect. Maintenez cette concentration imparable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0926\u0930 \u0915\u0930\u0928\u093e\u0964 \u0909\u0938 \u0905\u091c\u0947\u092f \u092b\u094b\u0915\u0938 \u0915\u094b \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispetto. Mantieni quella concentrazione inarrestabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0a\u656c\u3002\u6b62\u307e\u3089\u306a\u3044\u96c6\u4e2d\u529b\u3092\u7dad\u6301\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc874\uacbd. \uba48\ucd9c \uc218 \uc5c6\ub294 \uc9d1\uc911\ub825\uc744 \uc720\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect. Houd die onstuitbare focus vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek. Utrzymuj to niepowstrzymane skupienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeito. Mantenha esse foco impar\u00e1vel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0432\u0430\u0436\u0435\u043d\u0438\u0435. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0439 \u044d\u0442\u0443 \u043d\u0435\u0443\u043c\u043e\u043b\u0438\u043c\u0443\u044e \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayg\u0131. Durdurulamaz oda\u011f\u0131n\u0131z\u0131 koruyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0a\u91cd\u3002\u4fdd\u6301\u8fd9\u79cd\u4e0d\u53ef\u963b\u6321\u7684\u4e13\u6ce8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0a\u91cd\u3002\u4fdd\u6301\u4e0d\u53ef\u963b\u64cb\u7684\u5c08\u6ce8\u529b\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.maschine.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoriere leichte Schmerzen im Gelenk nicht mehr \u2013 ersetze die \u00dcbung am selben Tag durch eine schonendere Variante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop ignoring slight pain in the joint - replace the exercise with a gentler version on the same day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje de ignorar el dolor leve en la articulaci\u00f3n; reemplace el ejercicio con una versi\u00f3n m\u00e1s suave el mismo d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez d'ignorer les l\u00e9g\u00e8res douleurs articulaires - remplacez l'exercice par une version plus douce le m\u00eame jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u094b\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u0939\u0932\u094d\u0915\u0947 \u0926\u0930\u094d\u0926 \u0915\u094b \u0928\u091c\u0930\u0905\u0902\u0926\u093e\u091c \u0915\u0930\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 - \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u094b \u0909\u0938\u0940 \u0926\u093f\u0928 \u0939\u0932\u094d\u0915\u0947 \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0938\u0947 \u092c\u0926\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di ignorare il leggero dolore all'articolazione: sostituisci l'esercizio con una versione pi\u00f9 delicata lo stesso giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95a2\u7bc0\u306e\u308f\u305a\u304b\u306a\u75db\u307f\u3092\u7121\u8996\u3059\u308b\u306e\u3092\u3084\u3081\u3066\u3001\u305d\u306e\u65e5\u306e\u3046\u3061\u306b\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u3092\u3088\u308a\u7a4f\u3084\u304b\u306a\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u7f6e\u304d\u63db\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad00\uc808\uc758 \uc57d\uac04\uc758 \ud1b5\uc99d\uc744 \ubb34\uc2dc\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uac19\uc740 \ub0a0 \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uc6b4\ub3d9\uc73c\ub85c \uc6b4\ub3d9\uc744 \ub300\uccb4\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met het negeren van lichte pijn in het gewricht - vervang de oefening dezelfde dag door een zachtere versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesta\u0144 ignorowa\u0107 lekki b\u00f3l stawu \u2013 zamie\u0144 \u0107wiczenie na \u0142agodniejsz\u0105 wersj\u0119 tego samego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare de ignorar uma leve dor nas articula\u00e7\u00f5es - substitua o exerc\u00edcio por uma vers\u00e3o mais suave no mesmo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0443\u0439\u0442\u0435 \u043b\u0451\u0433\u043a\u0443\u044e \u0431\u043e\u043b\u044c \u0432 \u0441\u0443\u0441\u0442\u0430\u0432\u0435 \u2013 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435 \u0432 \u0442\u043e\u0442 \u0436\u0435 \u0434\u0435\u043d\u044c \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0449\u0430\u0434\u044f\u0449\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemdeki hafif a\u011fr\u0131y\u0131 g\u00f6rmezden gelmeyi b\u0131rak\u0131n - ayn\u0131 g\u00fcn egzersizi daha hafif bir versiyonla de\u011fi\u015ftirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u518d\u5ffd\u89c6\u5173\u8282\u7684\u8f7b\u5fae\u75bc\u75db\u2014\u2014\u5f53\u5929\u7528\u4e00\u79cd\u66f4\u6e29\u548c\u7684\u65b9\u5f0f\u66ff\u4ee3\u8be5\u7ec3\u4e60\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5ffd\u8996\u95dc\u7bc0\u7684\u8f15\u5fae\u75bc\u75db\uff0d\u5728\u7576\u5929\u4ee5\u8f03\u6eab\u548c\u7684\u65b9\u5f0f\u4ee3\u66ff\u7df4\u7fd2\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.maschine.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integriere exakt 3 Minuten spezifisches Dehnen f\u00fcr deine schw\u00e4chste Muskelgruppe nach dem Training."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorporate exactly 3 minutes of specific stretching for your weakest muscle group after your workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora exactamente 3 minutos de estiramientos espec\u00edficos para tu grupo muscular m\u00e1s d\u00e9bil despu\u00e9s de tu entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorporez exactement 3 minutes d\u2019\u00e9tirements sp\u00e9cifiques \u00e0 votre groupe musculaire le plus faible apr\u00e8s votre entra\u00eenement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0915\u0947 \u092c\u093e\u0926 \u0905\u092a\u0928\u0947 \u0938\u092c\u0938\u0947 \u0915\u092e\u091c\u094b\u0930 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u0940 \u0938\u092e\u0942\u0939 \u0915\u0947 \u0932\u093f\u090f \u0920\u0940\u0915 3 \u092e\u093f\u0928\u091f \u0915\u0940 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0938\u094d\u091f\u094d\u0930\u0947\u091a\u093f\u0902\u0917 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora esattamente 3 minuti di stretching specifico per il gruppo muscolare pi\u00f9 debole dopo l'allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u5f8c\u306b\u306f\u3001\u6700\u3082\u5f31\u3044\u7b4b\u8089\u7fa4\u306b\u7279\u5316\u3057\u305f\u30b9\u30c8\u30ec\u30c3\u30c1\u3092 3 \u5206\u9593\u3060\u3051\u53d6\u308a\u5165\u308c\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b4\ub3d9 \ud6c4 \uac00\uc7a5 \uc57d\ud55c \uadfc\uc721 \uadf8\ub8f9\uc744 \uc704\ud55c \ud2b9\uc815 \uc2a4\ud2b8\ub808\uce6d\uc744 \uc815\ud655\ud788 3\ubd84 \ub3d9\uc548 \ud3ec\ud568\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat u na uw training precies 3 minuten specifiek rekt voor uw zwakste spiergroep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po treningu wykonaj dok\u0142adnie 3 minuty specjalnego rozci\u0105gania najs\u0142abszej grupy mi\u0119\u015bni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpore exatamente 3 minutos de alongamento espec\u00edfico para o grupo muscular mais fraco ap\u00f3s o treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u0443\u0439 \u0442\u043e\u0447\u043d\u043e 3 \u043c\u0438\u043d\u0443\u0442\u044b \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0440\u0430\u0441\u0442\u044f\u0436\u043a\u0438 \u0434\u043b\u044f \u0442\u0432\u043e\u0435\u0439 \u0441\u0430\u043c\u043e\u0439 \u0441\u043b\u0430\u0431\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u043c\u044b\u0448\u0446 \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman\u0131n\u0131zdan sonra en zay\u0131f kas grubunuz i\u00e7in tam olarak 3 dakikal\u0131k \u00f6zel esneme hareketleri yap\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8bad\u7ec3\u540e\uff0c\u4e3a\u4f60\u6700\u5f31\u7684\u808c\u8089\u7fa4\u7cbe\u786e\u5730\u8fdb\u884c3\u5206\u949f\u7684\u7279\u5b9a\u62c9\u4f38\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u904b\u52d5\u5f8c\uff0c\u91dd\u5c0d\u6700\u5f31\u7684\u808c\u8089\u7fa4\u9032\u884c 3 \u5206\u9418\u7684\u7279\u5b9a\u4f38\u5c55\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.maschine.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme H\u00e4rte und Disziplin. Deine 1\uff05 Verbesserung liegt im Verhindern von Verletzungs-Ausf\u00e4llen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme hardship and discipline. Your 1\uff05 improvement is in preventing injury absences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dificultad extrema y disciplina. Su mejora del 1\uff05 es en la prevenci\u00f3n de ausencias por lesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Difficult\u00e9s et discipline extr\u00eames. Votre am\u00e9lioration de 1\u00a0\uff05 consiste \u00e0 pr\u00e9venir les absences pour cause de blessure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0915\u0920\u093f\u0928\u093e\u0908 \u0914\u0930 \u0905\u0928\u0941\u0936\u093e\u0938\u0928. \u0906\u092a\u0915\u093e 1\uff05 \u0938\u0941\u0927\u093e\u0930 \u091a\u094b\u091f \u0915\u0940 \u0905\u0928\u0941\u092a\u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u092e\u0947\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrema difficolt\u00e0 e disciplina. Il tuo miglioramento dell'1\uff05 riguarda la prevenzione delle assenze per infortunio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6975\u5ea6\u306e\u82e6\u96e3\u3068\u898f\u5f8b\u3002 1\uff05 \u306e\u6539\u5584\u306f\u602a\u6211\u306b\u3088\u308b\u6b20\u52e4\u306e\u9632\u6b62\u306b\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf9\ub3c4\uc758 \uace0\ub09c\uacfc \uaddc\uc728. 1\uff05\uc758 \uac1c\uc120\uc740 \ubd80\uc0c1 \uacb0\uadfc\uc744 \uc608\ubc29\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme ontberingen en discipline. Uw verbetering van 1\uff05 ligt in het voorkomen van verzuim door blessures."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstremalne trudno\u015bci i dyscyplina. Tw\u00f3j 1\uff05 poprawy polega na zapobieganiu absencji spowodowanej kontuzjami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrema dificuldade e disciplina. Sua melhoria de 1\uff05 est\u00e1 na preven\u00e7\u00e3o de aus\u00eancias por les\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u0433\u043e\u0441\u0442\u044c \u0438 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430. \u0422\u0432\u043e\u0451 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 1\uff05 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0442\u0440\u0430\u0432\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u015f\u0131r\u0131 zorluk ve disiplin. \uff051'lik ilerlemeniz sakatl\u0131klar\u0131n \u00f6nlenmesindedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6781\u7aef\u7684\u4e25\u683c\u548c\u7eaa\u5f8b\u3002\u4f60\u90a31\uff05\u7684\u63d0\u5347\u5728\u4e8e\u9632\u6b62\u4f24\u75c5\u7f3a\u52e4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6975\u5ea6\u7684\u8271\u82e6\u548c\u7d00\u5f8b\u3002\u4f60\u7684 1\uff05 \u9032\u6b65\u662f\u70ba\u4e86\u9632\u6b62\u56e0\u50b7\u7f3a\u5e2d\u3002"
          }
        }
      }
    },

      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, gerne!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, please!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Sí, por favor!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui s'il vous plait!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ, खुशी से!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, per favore!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、お願いします！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네, 제발요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, alsjeblieft!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, proszę!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, por favor!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, por favor!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, пожалуйста!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evet lütfen!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，很高兴！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，很高興！"
          }
        }
      }
    },
    "tour_routine_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bündele mehrere Gewohnheiten zu einer Routine und starte sie gemeinsam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle multiple habits into a routine and start them together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa varios hábitos en una rutina e inícielos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez plusieurs habitudes dans une routine et lancez-les ensemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई आदतों को एक दिनचर्या में बाँधो और उन्हें एक साथ शुरू करो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa più abitudini in una routine e avviale insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の習慣をルーティンにまとめて、一緒に開始しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 습관을 루틴으로 묶어 함께 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundel meerdere gewoonten in een routine en start ze samen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz kilka nawyków w rutynę i zacznij je razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa vários hábitos numa rotina e inicia-os juntos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa vários hábitos numa rotina e inicia-os juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объедините несколько привычек в рутину и начните выполнять их вместе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla alışkanlığı bir rutine toplayın ve birlikte başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将几个习惯捆绑成一个日常习惯，然后一起开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將幾個習慣捆綁成一個日常習慣，然後一起開始。"
          }
        }
      }
    },

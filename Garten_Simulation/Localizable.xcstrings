    "prog_water_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, mindestens%@ deines Wasserbedarfs vor 14 Uhr zu decken. Das verhindert abendliches Trinken und nächtliche Klobesuche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to get at least%@ of your water needs before 2 p.m. This prevents drinking in the evening and going to the toilet at night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intente cubrir al menos el%@ de sus necesidades de agua antes de las 2 p. m. Esto evita beber por la noche e ir al baño por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'obtenir au moins%@ de vos besoins en eau avant 14 heures. Cela évite de boire le soir et d'aller aux toilettes la nuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पानी की ज़रूरत का कम से कम%@ दोपहर 2 बजे से पहले पूरा करने का प्रयास करें। यह शाम को शराब पीने और रात में शौचालय जाने से रोकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca di soddisfare almeno il%@ del tuo fabbisogno idrico prima delle 14:00. Ciò impedisce di bere la sera e di andare in bagno di notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "午後2時までに必要な水分の少なくとも%@を摂取するようにしてください。これにより、夕方の飲酒や夜間のトイレに行くことがなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오후 2시 이전에 필요한 물의 최소%@를 확보하도록 노력하십시오. 이렇게 하면 저녁에 술을 마시고 밤에 화장실에 가는 것을 방지할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer vóór 14.00 uur minimaal%@ van uw waterbehoefte binnen te krijgen. Dit voorkomt dat je 's avonds drinkt en 's nachts naar het toilet gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staraj się zaspokoić co najmniej%@ swojego zapotrzebowania na wodę przed godziną 14:00. Zapobiega to piciu wieczorem i chodzeniu do toalety w nocy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente obter pelo menos%@ de suas necessidades de água antes das 14h. Isso evita beber à noite e ir ao banheiro à noite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente obter pelo menos%@ de suas necessidades de água antes das 14h. Isso evita beber à noite e ir ao banheiro à noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постарайтесь восполнить хотя бы%@ необходимой воды до 14:00. Это предотвращает употребление алкоголя вечером и посещение туалета ночью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ihtiyacınızın en az%@'ını saat 14.00'ten önce almaya çalışın. Bu da akşam içki içmeyi ve gece tuvalete gitmeyi engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽量在下午 2 点之前满足至少%@ 的用水需求。这样可以防止晚上喝酒和晚上上厕所。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "盡量在下午 2 點前滿足至少%@ 的用水需求。這樣可以防止晚上喝酒和晚上上廁所。"
          }
        }
      }
    },

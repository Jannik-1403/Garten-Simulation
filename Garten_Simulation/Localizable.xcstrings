    "assessment.mental.profile.unerschuetterlicher.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deinen Kurs. Du bist auf dem richtigen Weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay your course. You are on the right path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9n tu rumbo. Est\u00e1s en el camino correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre cap. Vous \u00eates sur la bonne voie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u092a\u0930 \u0930\u0939\u094b. \u0906\u092a \u0938\u0939\u0940 \u0930\u093e\u0938\u094d\u0924\u0947 \u092a\u0930 \u0939\u0948\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la tua rotta. Sei sulla strada giusta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30fc\u30b9\u3092\u7dad\u6301\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3042\u306a\u305f\u306f\u6b63\u3057\u3044\u9053\u3092\u6b69\u3093\u3067\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uae38\uc744 \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \ub2f9\uc2e0\uc740 \uc62c\ubc14\ub978 \uae38\uc744 \uac00\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf op koers. Je bent op de goede weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj sw\u00f3j kurs. Jeste\u015b na dobrej drodze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu curso. Voc\u00ea est\u00e1 no caminho certo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u0440\u0436\u0438 \u043a\u0443\u0440\u0441. \u0422\u044b \u0438\u0434\u0451\u0448\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u043c \u043f\u0443\u0442\u0451\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotan\u0131zda kal\u0131n. Do\u011fru yoldas\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u575a\u6301\u4f60\u7684\u822a\u5411\u3002\u4f60\u6b63\u5728\u6b63\u786e\u7684\u9053\u8def\u4e0a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5805\u6301\u4f60\u7684\u8def\u7dda\u3002\u4f60\u8d70\u5728\u6b63\u78ba\u7684\u9053\u8def\u4e0a\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide es, in Diskussionen immer das letzte Wort haben zu wollen \u2013 \u00fcberlass den 1\uff05 Raum dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid always wanting to have the last word in discussions - leave the 1\uff05 space to the other person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite querer siempre tener la \u00faltima palabra en las discusiones: deje el 1\uff05 de espacio a la otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9vitez de toujours vouloir avoir le dernier mot dans les discussions - laissez l'espace de 1\uff05 \u00e0 l'autre personne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0930\u094d\u091a\u093e\u0913\u0902 \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0905\u0902\u0924\u093f\u092e \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u0928\u0947 \u0915\u0940 \u091a\u093e\u0939\u0924 \u0938\u0947 \u092c\u091a\u0947\u0902 - 1\uff05 \u0938\u094d\u0925\u093e\u0928 \u0926\u0942\u0938\u0930\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita di voler avere sempre l'ultima parola nelle discussioni: lascia lo spazio dell'1\uff05 all'altra persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b70\u8ad6\u306e\u4e2d\u3067\u5e38\u306b\u6700\u5f8c\u306e\u8a00\u8449\u3092\u8a00\u3044\u305f\u3044\u3068\u601d\u3046\u306e\u306f\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u30021\uff05 \u306e\u30b9\u30da\u30fc\u30b9\u306f\u4ed6\u306e\u4eba\u306b\u4efb\u305b\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud1a0\ub860\uc5d0\uc11c \ud56d\uc0c1 \ub9c8\uc9c0\ub9c9 \ub9d0\uc744 \ud558\uace0 \uc2f6\uc5b4\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. 1\uff05\uc758 \uacf5\uac04\uc744 \ub2e4\ub978 \uc0ac\ub78c\uc5d0\uac8c \ub0a8\uaca8\ub450\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd altijd het laatste woord te willen hebben in discussies; laat de ruimte van 1\uff05 aan de ander over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj ch\u0119ci posiadania zawsze ostatniego s\u0142owa w dyskusjach \u2013 zostaw 1\uff05 miejsca drugiej osobie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite sempre querer ter a \u00faltima palavra nas discuss\u00f5es \u2013 deixe o espa\u00e7o de 1\uff05 para a outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0431\u0435\u0433\u0430\u0439 \u0441\u0442\u0440\u0435\u043c\u043b\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043c\u0435\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f\u0445 \u2013 \u043e\u0441\u0442\u0430\u0432\u044c 1\uff05 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tart\u0131\u015fmalarda her zaman son s\u00f6z\u00fc s\u00f6ylemekten ka\u00e7\u0131n\u0131n; \uff051'lik alan\u0131 di\u011fer ki\u015fiye b\u0131rak\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u5728\u8ba8\u8bba\u4e2d\u603b\u662f\u60f3\u8981\u8bf4\u6700\u540e\u4e00\u53e5\u8bdd\u2014\u2014\u628a1\uff05\u7684\u7a7a\u95f4\u7559\u7ed9\u5bf9\u65b9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u7e3d\u662f\u60f3\u5728\u8a0e\u8ad6\u4e2d\u64c1\u6709\u6700\u5f8c\u767c\u8a00\u6b0a\u2014\u2014\u628a 1\uff05 \u7684\u7a7a\u9593\u7559\u7d66\u5c0d\u65b9\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir t\u00e4glich 2 Minuten Zeit, um den Erfolg eines anderen ehrlich zu loben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take 2 minutes a day to honestly praise someone else's success."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3mate 2 minutos al d\u00eda para elogiar honestamente el \u00e9xito de otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez 2 minutes par jour pour f\u00e9liciter honn\u00eatement le succ\u00e8s de quelqu'un d'autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u0914\u0930 \u0915\u0940 \u0938\u092b\u0932\u0924\u093e \u0915\u0940 \u0908\u092e\u093e\u0928\u0926\u093e\u0930\u0940 \u0938\u0947 \u092a\u094d\u0930\u0936\u0902\u0938\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f\u0926\u093f\u0928 2 \u092e\u093f\u0928\u091f \u0915\u093e \u0938\u092e\u092f \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi 2 minuti al giorno per lodare onestamente il successo di qualcun altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u65e5 2 \u5206\u9593\u3001\u4ed6\u4eba\u306e\u6210\u529f\u3092\u6b63\u76f4\u306b\u8912\u3081\u3066\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud558\ub8e8 2\ubd84\uc529 \ub2e4\ub978 \uc0ac\ub78c\uc758 \uc131\uacf5\uc744 \uc194\uc9c1\ud558\uac8c \uce6d\ucc2c\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem twee minuten per dag de tijd om eerlijk het succes van iemand anders te prijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po\u015bwi\u0119\u0107 2 minuty dziennie, aby szczerze pochwali\u0107 sukces innej osoby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve 2 minutos por dia para elogiar honestamente o sucesso de outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0434\u0435\u043b\u044f\u0439 \u0441\u0435\u0431\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c 2 \u043c\u0438\u043d\u0443\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u043f\u043e\u0445\u0432\u0430\u043b\u0438\u0442\u044c \u0443\u0441\u043f\u0435\u0445 \u0434\u0440\u0443\u0433\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015fka birinin ba\u015far\u0131s\u0131n\u0131 d\u00fcr\u00fcst\u00e7e \u00f6vmek i\u00e7in g\u00fcnde 2 dakikan\u0131z\u0131 ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u82b1\u4e24\u5206\u949f\u65f6\u95f4\uff0c\u771f\u8bda\u5730\u8d5e\u7f8e\u522b\u4eba\u7684\u6210\u5c31\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u82b1 2 \u5206\u9418\u771f\u8aa0\u5730\u8b9a\u7f8e\u5225\u4eba\u7684\u6210\u529f\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist extrem mental stark. Um die letzten 1\uff05 herauszuholen, musst du sicherstellen, dass du nicht arrogant oder abgestumpft wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are extremely mentally strong. To get that last 1\uff05, you need to make sure you don't become arrogant or jaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres extremadamente fuerte mentalmente. Para obtener ese \u00faltimo 1\uff05, debes asegurarte de no volverte arrogante ni hastiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates extr\u00eamement fort mentalement. Pour obtenir ce dernier 1\uff05, vous devez vous assurer de ne pas devenir arrogant ou blas\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092e\u093e\u0928\u0938\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u092c\u0947\u0939\u0926 \u092e\u091c\u092c\u0942\u0924 \u0939\u0948\u0902. \u0909\u0938 \u0905\u0902\u0924\u093f\u092e 1\uff05 \u0915\u094b \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b \u092f\u0939 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u0915\u093f \u0906\u092a \u0905\u0939\u0902\u0915\u093e\u0930\u0940 \u092f\u093e \u0925\u0915\u0947 \u0939\u0941\u090f \u0928 \u092c\u0928\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei estremamente forte mentalmente. Per ottenere quell'ultimo 1\uff05, devi assicurarti di non diventare arrogante o stanco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u975e\u5e38\u306b\u7cbe\u795e\u7684\u306b\u5f37\u3044\u3067\u3059\u3002\u6700\u5f8c\u306e 1\uff05 \u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u50b2\u6162\u306b\u306a\u3063\u305f\u308a\u3001\u3046\u3093\u3056\u308a\u3057\u305f\u308a\u3057\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc815\uc2e0\uc801\uc73c\ub85c \ub9e4\uc6b0 \uac15\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9 1\uff05\ub97c \uc5bb\uc73c\ub824\uba74 \uad50\ub9cc\ud558\uac70\ub098 \uc9c0\uce58\uc9c0 \uc54a\ub3c4\ub85d \ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent mentaal enorm sterk. Om die laatste 1\uff05 te krijgen, moet je ervoor zorgen dat je niet arrogant of afgemat wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b niezwykle silny psychicznie. Aby zdoby\u0107 ten ostatni 1\uff05, musisz uwa\u017ca\u0107, aby nie sta\u0107 si\u0119 aroganckim ani zblazowanym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea \u00e9 extremamente forte mentalmente. Para obter o \u00faltimo 1\uff05, voc\u00ea precisa ter certeza de n\u00e3o se tornar arrogante ou cansado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u0439. \u0427\u0442\u043e\u0431\u044b \u0432\u044b\u0436\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 1\uff05, \u0442\u044b \u0434\u043e\u043b\u0436\u0435\u043d \u0443\u0431\u0435\u0434\u0438\u0442\u044c\u0441\u044f, \u0447\u0442\u043e \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0448\u044c \u0432\u044b\u0441\u043e\u043a\u043e\u043c\u0435\u0440\u043d\u044b\u043c \u0438\u043b\u0438 \u0447\u0435\u0440\u0441\u0442\u0432\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihinsel olarak son derece g\u00fc\u00e7l\u00fcs\u00fcn\u00fcz. Son \uff051'i elde etmek i\u00e7in kibirli veya bitkin olmad\u0131\u011f\u0131n\u0131zdan emin olmal\u0131s\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7cbe\u795e\u975e\u5e38\u5f3a\u5927\u3002\u4e3a\u4e86\u6316\u6398\u6700\u540e\u76841\uff05\uff0c\u4f60\u5fc5\u987b\u786e\u4fdd\u81ea\u5df1\u4e0d\u53d8\u5f97\u50b2\u6162\u6216\u9ebb\u6728\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u5fc3\u7406\u7d20\u8cea\u975e\u5e38\u5f37\u5927\u3002\u70ba\u4e86\u7372\u5f97\u6700\u5f8c 1\uff05\uff0c\u60a8\u9700\u8981\u78ba\u4fdd\u81ea\u5df1\u4e0d\u6703\u8b8a\u5f97\u50b2\u6162\u6216\u53ad\u5026\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.title": {

    "plant.aloe_vera.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere deine Bildschirmzeit f\u00fcr mehr Achtsamkeit im Alltag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce your screen time for more mindfulness in everyday life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce tu tiempo de pantalla para m\u00e1s atenci\u00f3n plena en la vida diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9duisez votre temps d'\u00e9cran pour plus de pleine conscience au quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0930\u094b\u091c\u092e\u0930\u094d\u0930\u093e \u0915\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0905\u0927\u093f\u0915 \u0938\u091a\u0947\u0924\u0928\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u092e\u092f \u0915\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci il tempo trascorso davanti allo schermo per una maggiore consapevolezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u753b\u9762\u3092\u898b\u3066\u3044\u308b\u6642\u9593\u3092\u6e1b\u3089\u3057\u3066\u3001\u65e5\u5e38\u751f\u6d3b\u3067\u306e\u30de\u30a4\u30f3\u30c9\u30d5\u30eb\u30cd\u30b9\u3092\u9ad8\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc0c1 \uc0dd\ud65c\uc758 \ub9c8\uc74c\ucc59\uae40\uc744 \uc704\ud574 \ud654\uba74 \uc2dc\uac04\uc744 \uc904\uc774\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder je schermtijd voor meer mindfulness in het dagelijks leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz czas sp\u0119dzany przed ekranem, by zyska\u0107 wi\u0119cej uwa\u017cno\u015bci w \u017cyciu codziennym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza seu tempo de tela para mais aten\u00e7\u00e3o plena no dia a dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u043a\u0440\u0430\u0442\u0438 \u0432\u0440\u0435\u043c\u044f, \u043f\u0440\u043e\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u0435 \u043f\u0435\u0440\u0435\u0434 \u044d\u043a\u0440\u0430\u043d\u043e\u043c, \u0434\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0432 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck ya\u015famda daha fazla fark\u0131ndal\u0131k i\u00e7in ekran s\u00fcrenizi azalt\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51cf\u5c11\u5c4f\u5e55\u65f6\u95f4\uff0c\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\u66f4\u52a0\u4e13\u6ce8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e1b\u5c11\u770b\u87a2\u5e55\u7684\u6642\u9593\uff0c\u8b93\u65e5\u5e38\u751f\u6d3b\u66f4\u5c08\u6ce8\u3002"
          }
        }
      }
    },
    "plant.apfelbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 1 = Kern, Level 10 = voller Baum. Klassisch gesund"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 1 = seed, Level 10 = full tree. Classic health"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel 1 = semilla, Nivel 10 = \u00e1rbol completo. Salud cl\u00e1sica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau 1 = graine, Niveau 10 = arbre entier. Sant\u00e9 classique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0924\u0930 1 = \u0915\u094b\u0930, \u0938\u094d\u0924\u0930 10 = \u092a\u0942\u0930\u094d\u0923 \u0935\u0943\u0915\u094d\u0937\u0964 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0935\u0938\u094d\u0925"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 1 = seed, Level 10 = full tree. Classic health"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ec\u30d9\u30eb 1 = \u30b7\u30fc\u30c9\u3001\u30ec\u30d9\u30eb 10 = \u5b8c\u5168\u306a\u30c4\u30ea\u30fc\u3002\u53e4\u5178\u7684\u306a\u5065\u5eb7"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub808\ubca8 1 = \uc2dc\ub4dc, \ub808\ubca8 10 = \uc804\uccb4 \ud2b8\ub9ac. \ud074\ub798\uc2dd \uac74\uac15"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau 1 = zaad, Niveau 10 = volledige boom. Klassieke gezondheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom 1 = nasiono, Poziom 10 = pe\u0142ne drzewo. Klasyczne zdrowie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00edvel 1 = semente, N\u00edvel 10 = \u00e1rvore completa. Sa\u00fade cl\u00e1ssica"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0440\u043e\u0432\u0435\u043d\u044c 1 = \u044f\u0434\u0440\u043e, \u0443\u0440\u043e\u0432\u0435\u043d\u044c 10 = \u043f\u043e\u043b\u043d\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e. \u041a\u043b\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u043e"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seviye 1 = tohum, Seviye 10 = tam a\u011fa\u00e7. Klasik sa\u011fl\u0131k"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b49\u7ea7 1 = \u79cd\u5b50\uff0c\u7b49\u7ea7 10 = \u5b8c\u6574\u6811\u6728\u3002\u7ecf\u5178\u5065\u5eb7"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b49\u7d1a 1 = \u6838\u5fc3\uff0c\u7b49\u7d1a 10 = \u5b8c\u6574\u6a39\u3002 Classically healthy"
          }
        }
      }
    },

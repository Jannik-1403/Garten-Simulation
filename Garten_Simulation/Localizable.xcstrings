    "math_challenge.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willst du wirklich abbrechen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to cancel?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfDe verdad quieres cancelar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment annuler ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0938\u091a\u092e\u0941\u091a \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero annullare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5f53\u306b\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\ub9d0 \ucde8\uc18c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je wilt annuleren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz anulowa\u0107?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseja realmente cancelar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger\u00e7ekten iptal etmek istiyor musunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u786e\u5b9a\u8981\u53d6\u6d88\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u771f\u7684\u8981\u53d6\u6d88\u55ce\uff1f"
          }
        }
      }
    },

    "trash.zigaretten_automat.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne den monatlichen Rauch-Betrag um: Was könntest du stattdessen kaufen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate your monthly smoking cost: what could you buy instead?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula el coste mensual de fumar: ¿qué podrías comprar en su lugar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule ton coût mensuel de tabac: qu'est-ce que tu pourrais acheter à la place ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक धूम्रपान की राशि की गणना करें: इसके बजाय आप क्या खरीद सकते हैं?"

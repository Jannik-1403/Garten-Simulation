    "prog_selfcare_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfcare bedeutet Grenzen zu setzen. Sage heute bewusst 'Nein' zu einer Anfrage, einem Gefallen oder einer Aufgabe, die dich auslaugt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-care means setting boundaries. Today, consciously say 'no' to a request, a favor or a task that drains you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuidado personal significa establecer límites. Hoy, di 'no' conscientemente a una petición, un favor o una tarea que te agota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre soin de soi signifie fixer des limites. Aujourd’hui, dites consciemment « non » à une demande, une faveur ou une tâche qui vous épuise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आत्म-देखभाल का अर्थ है सीमाएँ निर्धारित करना। आज, किसी अनुरोध, एहसान या किसी ऐसे काम के लिए, जो आपको परेशान कर रहा हो, सचेत होकर 'नहीं' कहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendersi cura di sé significa stabilire dei limiti. Oggi di' consapevolmente \"no\" a una richiesta, a un favore o a un compito che ti stanca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セルフケアとは、境界線を設けることを意味します。今日は、体力を消耗するような要求、お願い、仕事には意識的に「ノー」と言ってみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자기 관리는 경계를 설정하는 것을 의미합니다. 오늘, 당신을 지치게 하는 요청, 호의, 업무에 의식적으로 '아니요'라고 말하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfzorg betekent grenzen stellen. Zeg vandaag bewust ‘nee’ tegen een verzoek, een gunst of een taak die je uitput."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dbanie o siebie oznacza wyznaczanie granic. Dziś świadomie powiedz „nie” prośbie, przysłudze lub zadaniu, które Cię wyczerpuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocuidado significa estabelecer limites. Hoje, diga “não” conscientemente a um pedido, um favor ou uma tarefa que o esgota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocuidado significa estabelecer limites. Hoje, diga “não” conscientemente a um pedido, um favor ou uma tarefa que o esgota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забота о себе означает установление границ. Сегодня сознательно скажите «нет» просьбе, услуге или задаче, которая вас истощает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bakım, sınırları belirlemek anlamına gelir. Bugün, sizi tüketen bir isteğe, bir iyiliğe ya da göreve bilinçli olarak 'hayır' deyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自我保健意味着设定界限。今天，有意识地对让你精疲力竭的请求、帮忙或任务说“不”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自我保健意味著設定界線。今天，有意識地對讓你精疲力竭的請求、幫忙或任務說「不」。"
          }
        }
      }
    },

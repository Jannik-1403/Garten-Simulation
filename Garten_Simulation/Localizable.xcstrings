    "trash.fastfood_lieferdienst.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feurige Beleuchtung f\u00fcr die Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiery lighting for the night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluminaci\u00f3n ardiente para la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9clairage ardent pour la nuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093e\u0924 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917 \u091c\u0948\u0938\u0940 \u0930\u094b\u0936\u0928\u0940\u0964"

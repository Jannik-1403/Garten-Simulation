    "prog_stretching_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fokus auf den Psoas und die Hüftbeuger, perfekt um das viele Sitzen auszugleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A focus on the psoas and hip flexors, perfect for balancing out all that sitting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enfoque en el psoas y los flexores de la cadera, perfecto para equilibrar todo el tiempo sentado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un focus sur le psoas et les fléchisseurs de hanches, parfait pour équilibrer toute cette position assise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोज़ और हिप फ्लेक्सर्स पर ध्यान, बैठने की सभी गतिविधियों को संतुलित करने के लिए बिल्कुल सही।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un focus sullo psoas e sui flessori dell'anca, perfetti per bilanciare tutta quella seduta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大腰筋と股関節屈筋に焦点を当て、座っているすべてのバランスを整えるのに最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요근과 고관절 굴근에 초점을 맞춰 앉은 자세의 균형을 맞추는 데 적합합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een focus op de psoas en heupbuigers, perfect om al dat zitten in evenwicht te brengen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupienie się na mięśniach lędźwiowych i zginaczach bioder, idealne do zrównoważenia całego siedzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco no psoas e flexores do quadril, perfeito para equilibrar toda aquela sessão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco no psoas e flexores do quadril, perfeito para equilibrar toda aquela sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцент на поясничных мышцах и сгибателях бедра, что идеально подходит для балансировки во время сидения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bu oturmaları dengelemek için mükemmel olan psoas ve kalça fleksörlerine odaklanma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重点关注腰肌和髋屈肌，非常适合平衡坐姿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重點關注腰肌和髖屈肌，非常適合平衡坐姿。"
          }
        }
      }
    },

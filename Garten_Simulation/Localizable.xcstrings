    "settings.health.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Apple Health, um Schritte, Schlaf und weitere Gesundheitsdaten für deine Gewohnheiten zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health to use steps, sleep and other health data for your habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Apple Health para sincronizar tus pasos y sueño, impulsando el progreso en tu jardín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Apple Health pour synchroniser vos pas et votre sommeil, favorisant ainsi la progression de votre jardin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कदम और नींद को सिंक करने और अपने बगीचे में प्रगति को बढ़ावा देने के लिए Apple Health को कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti Apple Health per sincronizzare i tuoi passi e il sonno, favorendo i progressi nel tuo giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthを連携して歩数と睡眠を同期し、庭の成長を促進しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health를 연결하여 걸음 수와 수면을 동기화하고 정원의 성장을 촉진하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind Apple Health om je stappen en slaap te synchroniseren en zo de voortgang in je tuin te stimuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz Apple Health, aby zsynchronizować swoje kroki i sen, co przyspieszy postępy w Twoim ogrodzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Apple Health para sincronizar seus passos e sono, impulsionando o progresso do seu jardim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Apple Health para sincronizar seus passos e sono, impulsionando o progresso do seu jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Apple Health, чтобы синхронизировать шаги и сон, ускоряя прогресс в вашем саду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımlarınızı ve uykunuzu senkronize ederek bahçenizdeki gelişimi desteklemek için Apple Health'i bağlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple Health 同步您的步数和睡眠，从而推动花园的进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Apple Health 同步您的步數和睡眠，從而推動花園的進度。"
          }
        }
      }
    },
    "settings.health.instruction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil > Datenschutz > Apps > Zalimo Habits, um alles zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile > Privacy > Apps > Zalimo Habits to enable everything."
          }

    "prog_running_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus auf Geschwindigkeit und Herz-Kreislauf-Belastung. Kurze, harte Intervalle gefolgt von Geh-Pausen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on speed and cardiovascular strain. Short, hard intervals followed by walking breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concéntrese en la velocidad y la tensión cardiovascular. Intervalos cortos y duros seguidos de descansos para caminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez-vous sur la vitesse et la tension cardiovasculaire. Intervalles courts et durs suivis de pauses de marche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गति और हृदय संबंधी तनाव पर ध्यान दें। छोटे, कठिन अंतराल के बाद वॉकिंग ब्रेक।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrarsi sulla velocità e sullo sforzo cardiovascolare. Intervalli brevi e faticosi seguiti da pause di camminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピードと心臓血管の負担に重点を置きます。短くてハードなインターバルの後にウォーキング休憩が続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도와 심혈관 부담에 집중하세요. 짧고 힘든 간격에 이어 걷기 휴식이 이어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus op snelheid en cardiovasculaire belasting. Korte, zware intervallen gevolgd door wandelpauzes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoncentruj się na szybkości i obciążeniu układu krążenia. Krótkie, ciężkie interwały, po których następują przerwy na spacer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se na velocidade e no esforço cardiovascular. Intervalos curtos e intensos seguidos de pausas para caminhada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se na velocidade e no esforço cardiovascular. Intervalos curtos e intensos seguidos de pausas para caminhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сосредоточьтесь на скорости и нагрузке на сердечно-сосудистую систему. Короткие, тяжелые интервалы, за которыми следуют перерывы на ходьбу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hıza ve kardiyovasküler zorlanmaya odaklanın. Kısa, zorlu aralıklar ve ardından yürüyüş molaları."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注速度和心血管压力。短暂而艰苦的间歇期之后是步行休息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關注速度和心血管壓力。短而艱苦的間隔，然後是步行休息。"
          }
        }
      }
    },

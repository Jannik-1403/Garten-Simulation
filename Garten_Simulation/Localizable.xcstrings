    "reward_coins_subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast neue Coins f\u00fcr den Shop erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You received new coins for the shop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has recibido nuevas monedas para la tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as re\u00e7u de nouvelles pi\u00e8ces pour la boutique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0926\u0941\u0915\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0928\u090f \u0938\u093f\u0915\u094d\u0915\u0947 \u092e\u093f\u0932\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ricevuto nuove monete per il negozio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e7\u30c3\u30d7\u7528\u306b\u65b0\u3057\u3044\u30b3\u30a4\u30f3\u3092\u53d7\u3051\u53d6\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\uc810\uc5d0 \uc0ac\uc6a9\ud560 \uc0c8 \ucf54\uc778\uc744 \ubc1b\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nieuwe munten voor de winkel ontvangen."

    "pfad_fehlt_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erster Tag deines pers\u00f6nlichen Ziels."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First day of your personal goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer d\u00eda de tu objetivo personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premier jour de ton objectif personnel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0932\u0915\u094d\u0937\u094d\u092f \u0915\u093e \u092a\u0939\u0932\u093e \u0926\u093f\u0928."

    "onboarding_tutorial_interactive_weed_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unkraut macht deinen Garten schwächer und du verdienst weniger XP! Vermeide es, indem du nicht zu viele Schlechte Gewohnheiten kaufst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeds make your garden weaker and you earn less XP! Avoid them by not buying too many bad habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Las malas hierbas debilitan tu jardín y ganas menos XP! Evítalas no comprando demasiadas decoraciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises herbes affaiblissent ton jardin et tu gagnes moins d'XP ! Évite-les en n'achetant pas trop de décorations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरपतवार आपके बगीचे को कमज़ोर बनाते हैं और आप कम XP कमाते हैं! बहुत अधिक बुरी आदतें न पालकर इससे बचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le erbacce indeboliscono il tuo giardino e guadagni meno XP! Evitale non comprando troppe decorazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雑草が生えると庭が弱くなり、獲得できる XP も減ります。装飾品を買いすぎないように注意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잡초는 정원을 약화시키고 XP를 적게 얻습니다! 장식을 너무 많이 구입하지 않음으로써 이러한 현상을 피하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onkruid maakt je tuin zwakker en je verdient minder XP! Vermijd ze door niet te veel decoraties te kopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwasty osłabiają Twój ogród i zarabiasz mniej XP! Unikaj ich, nie kupując zbyt wielu dekoracji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas enfraquecem o teu jardim e ganhas menos XP! Evita-as não comprando demasiadas decorações."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas enfraquecem o teu jardim e ganhas menos XP! Evita-as não comprando demasiadas decorações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сорняки ослабляют ваш сад, и вы получаете меньше опыта! Избегайте этого, не покупая слишком много плохих привычек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabani otlar bahçenizi zayıflatır ve daha az XP kazanırsınız! Çok fazla dekorasyon satın almayarak bunlardan kaçının."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "杂草会使你的花园变弱，你获得的经验值也会减少！避免购买太多坏习惯来防止杂草。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雜草會讓你的花園變得脆弱，你獲得的經驗值也會減少！不要購買太多壞習慣來避免這種情況。"
          }
        }
      }
    },
    "onboarding_tutorial_interactive_weed_warning": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Gewohnheiten locken langfristig Unkraut an. Je mehr Deko, desto höher die Gefahr im Glücksrad!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad Habits attract weeds in the long run. The more deco, the higher the danger in the wheel!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las decoraciones atraen malas hierbas a largo plazo. ¡A más decoración, mayor peligro en la ruleta!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décorations attirent les mauvaises herbes à long terme. Plus il y a de déco, plus le danger est grand dans la roue !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुरी आदतें लंबे समय तक नकारात्मक प्रभाव डालती हैं। जितनी अधिक सजावट, भाग्य के चक्र में खतरा उतना अधिक!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le decorazioni attraggono le erbacce a lungo termine. Più decorazioni ci sono, maggiore è il pericolo nella ruota!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "装飾は長期的には雑草を引き寄せます。デコが多ければ多いほど、ホイールの危険性が高くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장식은 장기적으로 잡초를 유인합니다. 데코가 많을수록 휠의 위험이 높아집니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoraties trekken op den duur onkruid aan. Hoe meer decoratie, hoe groter het gevaar in het rad!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekoracje na dłuższą metę przyciągają chwasty. Im więcej deco, tym większe niebezpieczeństwo w kole!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As decorações atraem ervas daninhas a longo prazo. Quanto mais decoração, maior o perigo na roleta!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As decorações atraem ervas daninhas a longo prazo. Quanto mais decoração, maior o perigo na roleta!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плохие привычки в долгосрочной перспективе привлекают сорняки. Чем больше декора, тем выше риск на колесе фортуны!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekorasyonlar uzun vadede yabani otları çeker. Deko ne kadar fazla olursa, tekerlekteki tehlike de o kadar yüksek olur!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坏习惯会长期吸引杂草。装饰品越多，幸运轮盘的风险就越高！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，壞習慣會吸引雜草。装饰品越多，命运之轮的危险性就越高！"
          }
        }
      }
    },

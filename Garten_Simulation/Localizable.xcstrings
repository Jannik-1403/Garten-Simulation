    "settings.restore.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben Sie bereits Käufe getätigt? Hier können Sie diese auf diesem Gerät wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you already made purchases? You can restore them on this device here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya realizaste compras? Puedes restaurarlas en este dispositivo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "As-tu déjà effectué des achats ? Tu peux les restaurer sur cet appareil ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपने पहले ही खरीदारी की है? आप इन्हें इस डिवाइस पर पुनर्स्थापित कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già effettuato acquisti? Qui puoi ripristinarli su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう購入しましたか?ここでこのデバイスにそれらを復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 구매하셨나요? 여기에서 이 기기에 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft u al aankopen gedaan? Je kunt ze hier op dit apparaat herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy dokonaliście już zakupów? Tutaj możesz je przywrócić na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já efetuaste compras? Podes restaurá-las neste dispositivo aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já efetuaste compras? Podes restaurá-las neste dispositivo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже совершали покупки? Здесь вы можете восстановить их на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten alışveriş yaptınız mı? Bunları bu cihaza buradan geri yükleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已经购买了吗？您可以在此处将它们恢复到该设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已經購買了嗎？您可以在此處將它們恢復到該設備。"
          }
        }
      }
    },
    "settings.restore.success_message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine alten Daten wurden wiederhergestellt. Die App wird nun beendet. Bitte starte sie neu, um die Änderungen zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old data has been restored. The app will now close. Please restart to see the changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos antiguos han sido restaurados. La aplicación ahora se cerrará. Reinicie para ver los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos anciennes données ont été restaurées. L'application va maintenant se fermer. Veuillez redémarrer pour voir les modifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पुराना डेटा पुनर्स्थापित कर दिया गया है. अब ऐप बंद हो जाएगा. कृपया परिवर्तन देखने के लिए पुनः आरंभ करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi vecchi dati sono stati ripristinati. L'app verrà ora chiusa. Riavvia per vedere le modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いデータが復元されました。アプリは終了します。変更を確認するには再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 데이터가 복원되었습니다. 이제 앱이 닫힙니다. 변경사항을 보려면 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw oude gegevens zijn hersteld. De app wordt nu afgesloten. Start opnieuw op om de wijzigingen te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje stare dane zostały przywrócone. Aplikacja zostanie teraz zamknięta. Uruchom ponownie, aby zobaczyć zmiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados antigos foram restaurados. O aplicativo será fechado agora. Reinicie para ver as alterações."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados antigos foram restaurados. O aplicativo será fechado agora. Reinicie para ver as alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши старые данные восстановлены. Приложение закроется. Пожалуйста, перезапустите, чтобы увидеть изменения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski verileriniz geri yüklendi. Uygulama şimdi kapanacak. Değişiklikleri görmek için lütfen yeniden başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的旧数据已恢复。该应用程序现在将关闭。请重新启动以查看更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的舊資料已恢復。該應用程式現在將關閉。請重新啟動以查看變更。"
          }
        }
      }
    },

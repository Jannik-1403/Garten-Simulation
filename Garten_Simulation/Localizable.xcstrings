    "prog_strength_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolviere ein EMOM - %lld Minuten.\nZiele auf saubere Wiederholungen ohne Schwung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete an EMOM - %lld minutes.\nAim for clean reps without swinging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un EMOM - %lld minutos.\nApunta a repeticiones limpias y sin impulso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez un EMOM - %lld minutes.\nVisez des répétitions propres et sans élan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ईएमओएम पूरा करें - %lld मिनट।\nगति के बिना स्वच्छ प्रतिनिधियों का लक्ष्य रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un EMOM - %lld minuti.\nPunta a ripetizioni pulite senza slancio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOMを完了してください - %lld 分間。\n反動を使わず、きれいなフォームで繰り返すことを目指してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM 완료 - %lld 분.\n반동 없이 깔끔한 반복을 목표로 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi een EMOM - %lld minuten.\nRicht op nette herhalingen zonder momentum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończ EMOM - %lld minut.\nSkup się na czystych powtórzeniach bez pędu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua um EMOM - %lld minutos.\nConcentre-se em repetições limpas sem impulso."
          }
        },
        "pt-BR": {

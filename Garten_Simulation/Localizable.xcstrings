    "prog_cooking_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Rapsöl oder Sonnenblumenöl zum Braten. Nutze Olivenöl, Butter, Ghee oder Kokosöl. Füge Nüsse/Avocado hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid rapeseed oil or sunflower oil for frying. Use olive oil, butter, ghee or coconut oil. Add nuts/avocado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite el aceite de colza o de girasol para freír. Utilice aceite de oliva, mantequilla, ghee o aceite de coco. Agrega nueces/aguacate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez l'huile de colza ou l'huile de tournesol pour la friture. Utilisez de l'huile d'olive, du beurre, du ghee ou de l'huile de noix de coco. Ajouter les noix/avocat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तलने के लिए रेपसीड तेल या सूरजमुखी तेल से बचें। जैतून का तेल, मक्खन, घी या नारियल तेल का प्रयोग करें। मेवे/एवोकाडो डालें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitare l'olio di colza o l'olio di girasole per friggere. Usa olio d'oliva, burro, burro chiarificato o olio di cocco. Aggiungi noci/avocado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "揚げ物には菜種油やひまわり油は避けてください。オリーブオイル、バター、ギー、またはココナッツオイルを使用してください。ナッツ/アボカドを加えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튀김에는 유채기름이나 해바라기유를 사용하지 마세요. 올리브 오일, 버터, 버터 기름 또는 코코넛 오일을 사용하십시오. 견과류/아보카도를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd koolzaadolie of zonnebloemolie om te frituren. Gebruik olijfolie, boter, ghee of kokosolie. Noten/avocado toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do smażenia unikaj oleju rzepakowego i słonecznikowego. Używaj oliwy z oliwek, masła, ghee lub oleju kokosowego. Dodać orzechy/awokado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite óleo de colza ou óleo de girassol para fritar. Use azeite, manteiga, ghee ou óleo de coco. Adicione nozes/abacate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite óleo de colza ou óleo de girassol para fritar. Use azeite, manteiga, ghee ou óleo de coco. Adicione nozes/abacate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте использования рапсового или подсолнечного масла для жарки. Используйте оливковое, сливочное, топленое или кокосовое масло. Добавьте орехи/авокадо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kızartma için kolza yağı veya ayçiçek yağından kaçının. Zeytinyağı, tereyağı, sade yağ veya hindistancevizi yağı kullanın. Fındık/avokado ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免使用菜籽油或葵花籽油进行煎炸。使用橄榄油、黄油、酥油或椰子油。添加坚果/鳄梨。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免使用菜籽油或葵花籽油煎炸。使用橄欖油、奶油、酥油或椰子油。添加堅果/酪梨。"
          }
        }
      }
    },

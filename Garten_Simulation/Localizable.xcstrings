    "trash.binge_streaming.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt Serien-Marathon: Werde aktiv und nutze deine Freizeit sinnvoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of a series marathon: Get active and use your free time wisely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de un maratón de series: Ponte activo y usa tu tiempo libre sabiamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu d'un marathon de séries : Deviens actif et utilise ton temps libre à bon escient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di una maratona di serie: Diventa attivo e usa il tuo tempo libero saggiamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シリーズマラソンの代わりに：活動的になり、自由時間を賢く活用しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시리즈 마라톤 대신: 적극적으로 자유 시간을 현명하게 활용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In plaats van een seriemarathon: Word actief en besteed je vrije tijd verstandig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast maratonu seriali: Bądź aktywny i mądrze wykorzystuj wolny czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de uma maratona de séries: Seja ativo e use o seu tempo livre com sabedoria."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizi maratonu yerine: Aktif olun ve boş zamanınızı akıllıca kullanın."
          }
        }
      }
    },

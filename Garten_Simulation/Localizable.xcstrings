    "onboarding_screentime_bubble_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit ich dir helfen kann, fokussiert zu bleiben, brauche ich Zugriff auf die Bildschirmzeit!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To help you stay focused, I need access to your Screen Time!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Para ayudarte a mantenerte enfocado, necesito acceso a tu Tiempo de Pantalla!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour t'aider à rester concentré, j'ai besoin d'accéder au Temps d'écran !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको केंद्रित रहने में मदद करने के लिए, मुझे स्क्रीन टाइम तक पहुंच चाहिए!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aiutarti a rimanere concentrato, ho bisogno di accedere al Tempo di Utilizzo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中を保つために、スクリーンタイムへのアクセスが必要です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중을 유지할 수 있도록 스크린 타임에 접근해야 해!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je te helpen gefocust te blijven, heb ik toegang tot Schermtijd nodig!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby pomóc Ci się skupić, potrzebuję dostępu do Czasu przed ekranem!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ajudar você a manter o foco, preciso de acesso ao Tempo de Uso!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ajudar você a manter o foco, preciso de acesso ao Tempo de Uso!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы помочь тебе оставаться сосредоточенным, мне нужен доступ к Экранному времени!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanmana yardımcı olmak için Ekran Süresi'ne erişmem gerekiyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了帮助你保持专注，我需要访问屏幕使用时间！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了幫助你保持專注，我需要存取螢幕使用時間！"
          }
        }
      }
    },

        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30db\u30fc\u30e0\u753b\u9762\u304b\u3089\u76f4\u63a5\u690d\u7269\u306b\u6c34\u3092\u3084\u308a\u307e\u3059\u3002"

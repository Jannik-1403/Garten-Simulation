          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste dag van je persoonlijke doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy dzie\u0144 Twojego osobistego celu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro dia do teu objetivo pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u0442\u0432\u043e\u0435\u0439 \u043b\u0438\u0447\u043d\u043e\u0439 \u0446\u0435\u043b\u0438."

    "prog_noalcohol_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine ganze Woche geschafft. Wie fühlst du dich physisch und mental im Vergleich zu vor der Challenge?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've done a whole week. How do you feel physically and mentally compared to before the challenge?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has hecho una semana entera. ¿Cómo te sientes física y mentalmente en comparación con antes del desafío?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez fait une semaine entière. Comment vous sentez-vous physiquement et mentalement par rapport à avant le défi ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने पूरा एक सप्ताह कर लिया है. चुनौती से पहले की तुलना में आप शारीरिक और मानसिक रूप से कैसा महसूस करते हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai fatto un'intera settimana. Come ti senti fisicamente e mentalmente rispetto a prima della sfida?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸一週間やり遂げましたね。挑戦前と比べて肉体的にも精神的にもどうですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일 내내 수고하셨습니다. 챌린지 전과 비교하면 신체적, 정신적으로 어떤 느낌인가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt een hele week gedaan. Hoe voel je je fysiek en mentaal vergeleken met vóór de uitdaging?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepracowałeś cały tydzień. Jak się czujesz fizycznie i psychicznie w porównaniu do sytuacji sprzed wyzwania?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fez uma semana inteira. Como você se sente física e mentalmente em comparação com antes do desafio?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fez uma semana inteira. Como você se sente física e mentalmente em comparação com antes do desafio?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты отработал целую неделю. Как вы себя чувствуете физически и морально по сравнению с тем, что было до соревнования?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün bir haftayı tamamladın. Mücadele öncesine kıyasla fiziksel ve zihinsel olarak nasıl hissediyorsunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经做了整整一个星期了。与挑战之前相比，您的身体和精神感觉如何？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經做了整整一個星期了。與挑戰之前相比，您的身體和精神感覺如何？"
          }
        }
      }
    },

    "assessment.health.profile.vergifter.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandle deinen Körper wie eine Hochleistungsmaschine. Müll rein — Müll raus. Fang mit einer Flasche Wasser an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat your body like a high-performance machine. Garbage in - garbage out. Start with a bottle of water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trate su cuerpo como una máquina de alto rendimiento. Basura entra, basura sale. Comience con una botella de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitez votre corps comme une machine performante. Déchets à l'intérieur - déchets à l'extérieur. Commencez par une bouteille d'eau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratta il tuo corpo come una macchina ad alte prestazioni. Immondizia in entrata, immondizia in uscita. Inizia con una bottiglia d'acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の体を高性能マシンのように扱ってください。ゴミの流入 - ゴミの流出。まずは水の入ったボトルから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 몸을 고성능 기계처럼 다루십시오. 쓰레기 투입 - 쓰레기 배출. 물 한 병으로 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandel je lichaam als een krachtige machine. Vuilnis erin, afval eruit. Begin met een fles water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traktuj swoje ciało jak wydajną maszynę. Śmieci na wejściu - śmieci na zewnątrz. Zacznij od butelki wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trate seu corpo como uma máquina de alto desempenho. Entra lixo - sai lixo. Comece com uma garrafa de água."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuza yüksek performanslı bir makine gibi davranın. Çöp girişi - çöp çıkışı. Bir şişe su ile başlayın."
          }
        }
      }
    },
    "assessment.health.profile.vergifter.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe den Konsum von toxischen Lebensmitteln und übermäßigem Zucker/Alkohol. Vermeide es, deinen Körper als Mülleimer zu behandeln."
          }
        },
        "en": {

    "assessment.health.profile.ignorant.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ignorierst die Warnsignale, bis das System komplett crasht. Schmerzen, Erschöpfung, Fehlernährung — du weißt es, aber du reagierst nicht. Das ist keine Stärke, das ist Selbstzerstörung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You ignore the warning signals until the system crashes completely. Pain, exhaustion, malnutrition - you know it, but you don't react. That's not strength, that's self-destruction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoras las señales de advertencia hasta que el sistema falla por completo. Dolor, cansancio, desnutrición... lo sabes, pero no reaccionas. Eso no es fuerza, eso es autodestrucción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ignorez les signaux d’avertissement jusqu’à ce que le système tombe complètement en panne. Douleur, épuisement, malnutrition, vous le savez, mais vous ne réagissez pas. Ce n'est pas de la force, c'est de l'autodestruction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignori i segnali di avviso finché il sistema non si blocca completamente. Dolore, stanchezza, malnutrizione: lo sai, ma non reagisci. Questa non è forza, è autodistruzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが完全にクラッシュするまで、警告信号を無視します。痛み、疲労、栄養失調 - それはわかっていますが、反応しません。それは強さではなく、自己破壊です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 완전히 충돌할 때까지 경고 신호를 무시합니다. 고통, 피로, 영양실조 - 당신은 그것을 알고 있지만 반응하지 않습니다. 그것은 힘이 아니라 자기파멸이다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je negeert de waarschuwingssignalen totdat het systeem volledig crasht. Pijn, uitputting, ondervoeding: je weet het, maar je reageert niet. Dat is geen kracht, dat is zelfvernietiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorujesz sygnały ostrzegawcze, dopóki system nie ulegnie całkowitej awarii. Ból, zmęczenie, niedożywienie – wiesz o tym, ale nie reagujesz. To nie siła, to samozniszczenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ignora os sinais de alerta até que o sistema trave completamente. Dor, exaustão, desnutrição – você sabe disso, mas não reage. Isso não é força, isso é autodestruição."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem tamamen çökene kadar uyarı sinyallerini görmezden gelirsiniz. Acı, bitkinlik, yetersiz beslenme; bunu biliyorsunuz ama tepki vermiyorsunuz. Bu güç değil, bu kendi kendini yok etmektir."
          }
        }
      }
    },

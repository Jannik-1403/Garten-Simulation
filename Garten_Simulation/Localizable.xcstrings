    "prog_cleaning_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume alles vom Boden auf, was dort nicht hingehört (Kleidung, Schuhe, Taschen). Der Raum wirkt sofort größer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the floor of anything that doesn't belong there (clothes, shoes, bags). The room immediately appears larger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia el suelo de todo lo que no pertenezca allí (ropa, zapatos, bolsos). La habitación inmediatamente parece más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débarrassez le sol de tout ce qui n'y appartient pas (vêtements, chaussures, sacs). La pièce paraît immédiatement plus grande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी किसी भी चीज़ का फर्श साफ़ करें जो वहां नहीं है (कपड़े, जूते, बैग)। कमरा तुरंत बड़ा दिखने लगता है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulisci il pavimento da tutto ciò che non ci appartiene (vestiti, scarpe, borse). La stanza appare subito più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこに属さないもの（服、靴、バッグ）を床から片付けます。部屋がすぐに広く見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥에 속하지 않는 물건(옷, 신발, 가방)을 모두 치우세요. 방이 즉시 더 넓어 보입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de vloer schoon van alles wat daar niet thuishoort (kleding, schoenen, tassen). De kamer lijkt meteen groter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczyść podłogę ze wszystkiego, co tam nie pasuje (ubrania, buty, torby). Pokój od razu wydaje się większy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe o chão de tudo que não pertence a ele (roupas, sapatos, bolsas). A sala imediatamente parece maior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe o chão de tudo que não pertence a ele (roupas, sapatos, bolsas). A sala imediatamente parece maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите пол от всего лишнего (одежды, обуви, сумок). Комната сразу кажется больше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zemini oraya ait olmayan her şeyden temizleyin (kıyafetler, ayakkabılar, çantalar). Oda hemen daha büyük görünüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除地板上任何不属于那里的东西（衣服、鞋子、包）。房间立刻显得更大了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除地板上任何不屬於那裡的東西（衣服、鞋子、包包）。房間立刻顯得更大了。"
          }
        }
      }
    },

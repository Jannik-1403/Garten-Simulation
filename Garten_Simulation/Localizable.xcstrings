    "tour_6_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte verschiedene Erfolge frei, während du deine Gewohnheiten meisterst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock various achievements as you master your habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea varios logros a medida que dominas tus hábitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez diverses réalisations à mesure que vous maîtrisez vos habitudes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca vari obiettivi man mano che acquisisci padronanza delle tue abitudini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣をマスターするにつれて、さまざまな実績をアンロックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 마스터하면서 다양한 성과를 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel verschillende prestaties terwijl u uw gewoonten onder de knie krijgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj różne osiągnięcia, opanowując swoje nawyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie várias conquistas à medida que domina seus hábitos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıklarınızda ustalaştıkça çeşitli başarıların kilidini açın."
          }
        }
      }
    },

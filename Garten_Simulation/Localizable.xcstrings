    "progression_teeth_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Putze deine Zähne 2x täglich für 2 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brush your teeth twice a day for 2 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cepíllate los dientes 2 veces al día durante 2 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brosse-toi les dents 2 fois par jour pendant 2 minutes."
          }
        },

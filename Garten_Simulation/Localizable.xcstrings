    "plant.mandelbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Investition zahlt sich erst sp\u00e4ter aus \u2013 Sparen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Investment pays off later \u2013 Saving"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inversi\u00f3n rinde despu\u00e9s \u2013 Ahorro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'investissement paie plus tard \u2013 \u00c9pargne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u0935\u0947\u0936 \u0915\u093e \u0932\u093e\u092d \u092c\u093e\u0926 \u092e\u0947\u0902 \u0939\u0940 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u2013 \u092c\u091a\u0924"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Investment pays off later \u2013 Saving"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6295\u8cc7\u306f\u5f8c\u3067\u5831\u308f\u308c\u307e\u3059 \u2013 \u7bc0\u7d04"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud22c\uc790\ub294 \ub098\uc911\uc5d0 \uc131\uacfc\ub97c \ub0c5\ub2c8\ub2e4 \u2013 \uc808\uc57d"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Investeren loont later \u2013 Besparen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inwestycja zwraca si\u0119 p\u00f3\u017aniej \u2013 Oszcz\u0119dno\u015b\u0107"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O investimento compensa mais tarde \u2013 Poupar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438 \u043e\u043a\u0443\u043f\u0430\u044e\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0437\u0436\u0435 \u2013 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u044f"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yat\u0131r\u0131m sonradan kar\u015f\u0131l\u0131\u011f\u0131n\u0131 verir \u2013 Tasarruf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6295\u8d44\u56de\u62a5\u9700\u65f6\u65e5 \u2013 \u50a8\u84c4"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6295\u8cc7\u4e8b\u5f8c\u624d\u6703\u5f97\u5230\u56de\u5831\u2014\u2014\u5132\u84c4"
          }
        }
      }
    },

            "value": "Primo giorno del tuo obiettivo personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u500b\u4eba\u7684\u306a\u76ee\u6a19\u306e\u521d\u65e5\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

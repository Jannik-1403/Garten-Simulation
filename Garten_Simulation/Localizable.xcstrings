    "plant.lavendel.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigt und entspannt den Geist – besserer Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calms and relaxes the mind – better sleep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calma y relaja la mente – mejor sueño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme et détend l'esprit – meilleur sommeil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calms and relaxes the mind – better sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心を落ち着かせてリラックスさせ、より良い睡眠をもたらします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음을 진정시키고 이완시킵니다 – 더 나은 잠"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalmeert en ontspant de geest – betere slaap"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspokaja i relaksuje umysł – lepszy sen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acalma e relaxa a mente – melhor sono"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihni sakinleştirir ve rahatlatır – daha iyi uyku"
          }
        }
      }
    },

        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi vücudun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的身体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的身體"
          }
        }
      }
    },
    "prog_gratitude_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt es einen Baum, das Wetter oder einen schönen Raum, der dir heute Ruhe geschenkt hat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is there a tree, the weather or a beautiful room that gave you peace today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Hay un árbol, el clima o una hermosa habitación que te dio paz hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y a-t-il un arbre, la météo ou une belle pièce qui vous a apporté la paix aujourd'hui ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या कोई पेड़, मौसम या कोई खूबसूरत कमरा है जिसने आज आपको शांति दी?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un albero, il tempo o una bella stanza che ti ha dato pace oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、あなたに安らぎを与えてくれた木、天気、または美しい部屋はありますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 당신에게 평화를 준 나무, 날씨, 아름다운 방이 있나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is er een boom, het weer of een mooie kamer die jou vandaag rust gaf?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy jest drzewo, pogoda lub piękny pokój, który dał Ci dziś spokój?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem alguma árvore, o clima ou um quarto lindo que te deu paz hoje?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem alguma árvore, o clima ou um quarto lindo que te deu paz hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть ли дерево, погода или красивая комната, которая подарила вам сегодня покой?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün sana huzur veren bir ağaç, hava ya da güzel bir oda var mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有没有一棵树、天气或一个漂亮的房间给你带来平静？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有沒有一棵樹、天氣或一個漂亮的房間帶給你平靜？"
          }
        }
      }
    },

    "assessment.health.profile.vergifter.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandle deinen K\u00f6rper wie eine Hochleistungsmaschine. M\u00fcll rein \u2014 M\u00fcll raus. Fang mit einer Flasche Wasser an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat your body like a high-performance machine. Garbage in - garbage out. Start with a bottle of water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trate su cuerpo como una m\u00e1quina de alto rendimiento. Basura entra, basura sale. Comience con una botella de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitez votre corps comme une machine performante. D\u00e9chets \u00e0 l'int\u00e9rieur - d\u00e9chets \u00e0 l'ext\u00e9rieur. Commencez par une bouteille d'eau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u090f\u0915 \u0909\u091a\u094d\u091a-\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092e\u0936\u0940\u0928 \u0915\u0940 \u0924\u0930\u0939 \u0938\u092e\u091d\u0947\u0902\u0964 \u0915\u091a\u0930\u093e \u0906\u092f\u093e \u0915\u091a\u0930\u093e \u0917\u092f\u093e\u0964 \u092a\u093e\u0928\u0940 \u0915\u0940 \u090f\u0915 \u092c\u094b\u0924\u0932 \u0938\u0947 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratta il tuo corpo come una macchina ad alte prestazioni. Immondizia in entrata, immondizia in uscita. Inizia con una bottiglia d'acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u4f53\u3092\u9ad8\u6027\u80fd\u30de\u30b7\u30f3\u306e\u3088\u3046\u306b\u6271\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b4\u30df\u306e\u6d41\u5165 - \u30b4\u30df\u306e\u6d41\u51fa\u3002\u307e\u305a\u306f\u6c34\u306e\u5165\u3063\u305f\u30dc\u30c8\u30eb\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \ubab8\uc744 \uace0\uc131\ub2a5 \uae30\uacc4\ucc98\ub7fc \ub2e4\ub8e8\uc2ed\uc2dc\uc624. \uc4f0\ub808\uae30 \ud22c\uc785 - \uc4f0\ub808\uae30 \ubc30\ucd9c. \ubb3c \ud55c \ubcd1\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandel je lichaam als een krachtige machine. Vuilnis erin, afval eruit. Begin met een fles water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traktuj swoje cia\u0142o jak wydajn\u0105 maszyn\u0119. \u015amieci na wej\u015bciu - \u015bmieci na zewn\u0105trz. Zacznij od butelki wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trate seu corpo como uma m\u00e1quina de alto desempenho. Entra lixo - sai lixo. Comece com uma garrafa de \u00e1gua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0440\u0430\u0449\u0430\u0439\u0441\u044f \u0441\u043e \u0441\u0432\u043e\u0438\u043c \u0442\u0435\u043b\u043e\u043c \u043a\u0430\u043a \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u043c. \u041c\u0443\u0441\u043e\u0440 \u0432\u043d\u0443\u0442\u0440\u044c \u2014 \u043c\u0443\u0441\u043e\u0440 \u043d\u0430\u0440\u0443\u0436\u0443. \u041d\u0430\u0447\u043d\u0438 \u0441 \u0431\u0443\u0442\u044b\u043b\u043a\u0438 \u0432\u043e\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuza y\u00fcksek performansl\u0131 bir makine gibi davran\u0131n. \u00c7\u00f6p giri\u015fi - \u00e7\u00f6p \u00e7\u0131k\u0131\u015f\u0131. Bir \u015fi\u015fe su ile ba\u015flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u628a\u4f60\u7684\u8eab\u4f53\u5f53\u4f5c\u4e00\u53f0\u9ad8\u6027\u80fd\u673a\u5668\u6765\u5bf9\u5f85\u3002\u8f93\u5165\u5783\u573e\u2014\u2014\u8f93\u51fa\u5783\u573e\u3002\u4ece\u4e00\u74f6\u6c34\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50cf\u5c0d\u5f85\u4e00\u53f0\u9ad8\u6027\u80fd\u6a5f\u5668\u4e00\u6a23\u5c0d\u5f85\u60a8\u7684\u8eab\u9ad4\u3002\u5783\u573e\u9032-\u5783\u573e\u51fa\u3002\u5f9e\u4e00\u74f6\u6c34\u958b\u59cb\u3002"
          }
        }
      }
    },
    "assessment.health.profile.vergifter.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagere ungesunde Snacks nicht mehr in Augenh\u00f6he, sondern im hintersten Fach ganz oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop storing unhealthy snacks at eye level and instead store them at the top in the back compartment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje de almacenar bocadillos no saludables a la altura de los ojos y gu\u00e1rdelos en la parte superior del compartimento trasero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez de ranger les collations malsaines \u00e0 la hauteur des yeux et rangez-les plut\u00f4t en haut dans le compartiment arri\u00e8re."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f\u0915\u0930 \u0938\u094d\u0928\u0948\u0915\u094d\u0938 \u0915\u094b \u0906\u0902\u0916\u094b\u0902 \u0915\u0947 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0930\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0940\u091b\u0947 \u0915\u0947 \u0921\u093f\u092c\u094d\u092c\u0947 \u092e\u0947\u0902 \u0936\u0940\u0930\u094d\u0937 \u092a\u0930 \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di conservare gli snack malsani all'altezza degli occhi e conservali invece in alto, nello scomparto posteriore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u5065\u5eb7\u306a\u30b9\u30ca\u30c3\u30af\u3092\u76ee\u306e\u9ad8\u3055\u306b\u4fdd\u7ba1\u3059\u308b\u306e\u3092\u3084\u3081\u3001\u5f8c\u308d\u306e\u30b3\u30f3\u30d1\u30fc\u30c8\u30e1\u30f3\u30c8\u306e\u4e0a\u90e8\u306b\u4fdd\u7ba1\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac74\uac15\uc5d0 \ud574\ub85c\uc6b4 \uac04\uc2dd\uc744 \ub208\ub192\uc774\uc5d0 \ubcf4\uad00\ud558\uc9c0 \ub9d0\uace0 \ub300\uc2e0 \ub4a4\ucabd \uc218\ub0a9\uce78 \uc0c1\ub2e8\uc5d0 \ubcf4\uad00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar ongezonde tussendoortjes niet langer op ooghoogte, maar bewaar ze bovenaan in het achtervak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesta\u0144 przechowywa\u0107 niezdrowe przek\u0105ski na wysoko\u015bci oczu i zamiast tego przechowuj je na g\u00f3rze, w tylnej komorze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare de armazenar lanches n\u00e3o saud\u00e1veis \u200b\u200bna altura dos olhos e, em vez disso, guarde-os na parte superior, no compartimento traseiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0445\u0440\u0430\u043d\u0438 \u043d\u0435\u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0435 \u0437\u0430\u043a\u0443\u0441\u043a\u0438 \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0433\u043b\u0430\u0437, \u0430 \u0432 \u0441\u0430\u043c\u043e\u043c \u0432\u0435\u0440\u0445\u043d\u0435\u043c \u0437\u0430\u0434\u043d\u0435\u043c \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa\u011fl\u0131ks\u0131z at\u0131\u015ft\u0131rmal\u0131klar\u0131 g\u00f6z hizas\u0131nda saklamay\u0131 b\u0131rak\u0131n ve bunun yerine \u00fcstteki arka b\u00f6lmede saklay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u518d\u628a\u4e0d\u5065\u5eb7\u7684\u96f6\u98df\u653e\u5728\u89c6\u7ebf\u5e73\u9f50\u7684\u4f4d\u7f6e\uff0c\u800c\u8981\u653e\u5728\u6700\u91cc\u9762\u7684\u6700\u4e0a\u5c42\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5c07\u4e0d\u5065\u5eb7\u7684\u96f6\u98df\u5b58\u653e\u5728\u8207\u8996\u7dda\u9f4a\u5e73\u7684\u4f4d\u7f6e\uff0c\u800c\u61c9\u5c07\u5176\u5b58\u653e\u5728\u5f8c\u90e8\u9694\u5c64\u7684\u9802\u90e8\u3002"
          }
        }
      }
    },
    "assessment.health.profile.vergifter.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausche t\u00e4glich nur einen einzigen zuckerhaltigen Snack gegen eine Handvoll N\u00fcsse oder einen Apfel aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap just one sugary snack each day for a handful of nuts or an apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie solo un refrigerio azucarado cada d\u00eda por un pu\u00f1ado de nueces o una manzana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez une seule collation sucr\u00e9e chaque jour par une poign\u00e9e de noix ou une pomme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0926\u093f\u0928 \u0915\u0947\u0935\u0932 \u090f\u0915 \u092e\u0940\u0920\u0947 \u0928\u093e\u0936\u094d\u0924\u0947 \u0915\u0940 \u091c\u0917\u0939 \u092e\u0941\u091f\u094d\u0920\u0940 \u092d\u0930 \u092e\u0947\u0935\u0947 \u092f\u093e \u090f\u0915 \u0938\u0947\u092c \u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scambia solo uno spuntino zuccherato ogni giorno con una manciata di noci o una mela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u3001\u7518\u3044\u30b9\u30ca\u30c3\u30af\u3092 1 \u3064\u3060\u3051\u3001\u4e00\u63e1\u308a\u306e\u30ca\u30c3\u30c4\u307e\u305f\u306f\u30ea\u30f3\u30b4\u3068\u4ea4\u63db\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \ud55c \uc90c\uc758 \uacac\uacfc\ub958\ub098 \uc0ac\uacfc\ub85c \ub2ec\ucf64\ud55c \uac04\uc2dd\uc744 \ubc14\uafb8\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verruil elke dag slechts \u00e9\u00e9n suikerrijke snack voor een handvol noten of een appel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamie\u0144 tylko jedn\u0105 s\u0142odk\u0105 przek\u0105sk\u0119 ka\u017cdego dnia na gar\u015b\u0107 orzech\u00f3w lub jab\u0142ka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque apenas um lanche a\u00e7ucarado por dia por um punhado de nozes ou uma ma\u00e7\u00e3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0435\u043d\u044f\u0439\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0432\u0441\u0435\u0433\u043e \u043e\u0434\u0438\u043d \u0441\u043b\u0430\u0434\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u043a\u0443\u0441 \u043d\u0430 \u0433\u043e\u0440\u0441\u0442\u044c \u043e\u0440\u0435\u0445\u043e\u0432 \u0438\u043b\u0438 \u043e\u0434\u043d\u043e \u044f\u0431\u043b\u043e\u043a\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her g\u00fcn sadece bir \u015fekerli at\u0131\u015ft\u0131rmal\u0131\u011f\u0131 bir avu\u00e7 f\u0131nd\u0131k veya bir elma ile de\u011fi\u015ftirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u53ea\u628a\u4e00\u4efd\u542b\u7cd6\u96f6\u98df\u6362\u6210\u4e00\u628a\u575a\u679c\u6216\u4e00\u4e2a\u82f9\u679c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u53ea\u5403\u4e00\u4efd\u542b\u7cd6\u96f6\u98df\uff0c\u63db\u6210\u4e00\u628a\u5805\u679c\u6216\u4e00\u500b\u860b\u679c\u3002"
          }
        }
      }
    },
    "assessment.health.profile.vergifter.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du f\u00fcllst den falschen Kraftstoff ein. Keine radikale Di\u00e4t \u2013 wir ver\u00e4ndern nur die Umgebung um 1\uff05, um die Gewohnheit zu brechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're putting the wrong fuel in. Not a radical diet - we just change the environment by 1\uff05 to break the habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s poniendo el combustible equivocado. No es una dieta radical: simplemente cambiamos el medio ambiente en un 1\uff05 para romper con el h\u00e1bito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous mettez le mauvais carburant. Pas un r\u00e9gime radical - nous modifions simplement l'environnement de 1 \uff05 pour rompre avec cette habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0917\u0932\u0924 \u0908\u0902\u0927\u0928 \u0921\u093e\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0915\u094b\u0908 \u0915\u091f\u094d\u091f\u0930\u092a\u0902\u0925\u0940 \u0906\u0939\u093e\u0930 \u0928\u0939\u0940\u0902 - \u0939\u092e \u0906\u0926\u0924 \u0915\u094b \u0924\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923 \u0915\u094b \u0938\u093f\u0930\u094d\u092b 1\uff05 \u092c\u0926\u0932\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai inserendo il carburante sbagliato. Non \u00e8 una dieta radicale: cambiamo semplicemente l'ambiente dell'1\uff05 per rompere l'abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9593\u9055\u3063\u305f\u71c3\u6599\u3092\u5165\u308c\u3066\u3044\u307e\u3059\u3002\u904e\u6fc0\u306a\u30c0\u30a4\u30a8\u30c3\u30c8\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u7fd2\u6163\u3092\u65ad\u3061\u5207\u308b\u305f\u3081\u306b\u74b0\u5883\u3092 1\uff05 \u5909\u3048\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc798\ubabb\ub41c \uc5f0\ub8cc\ub97c \ub123\uace0 \uc788\ub294 \uac83\uc785\ub2c8\ub2e4. \uae09\uc9c4\uc801\uc778 \ub2e4\uc774\uc5b4\ud2b8\ub294 \uc544\ub2d9\ub2c8\ub2e4. \uc2b5\uad00\uc744 \uae68\uae30 \uc704\ud574 \ud658\uacbd\uc744 1\uff05\ub9cc \ubc14\uafb8\ub294 \uac83\ubfd0\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stopt er de verkeerde brandstof in. Geen radicaal dieet; we veranderen alleen de omgeving met 1\uff05 om de gewoonte te doorbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankujesz z\u0142e paliwo. Nie jest to radykalna dieta \u2013 po prostu zmieniamy \u015brodowisko o 1\uff05, aby prze\u0142ama\u0107 nawyk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 colocando o combust\u00edvel errado. N\u00e3o \u00e9 uma dieta radical - apenas mudamos o ambiente em 1\uff05 para quebrar o h\u00e1bito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0437\u0430\u043b\u0438\u0432\u0430\u0435\u0448\u044c \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0435 \u0442\u043e\u043f\u043b\u0438\u0432\u043e. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0438\u0435\u0442 \u2014 \u043c\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0435\u043d\u044f\u0435\u043c \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 1\uff05, \u0447\u0442\u043e\u0431\u044b \u0441\u043b\u043e\u043c\u0430\u0442\u044c \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanl\u0131\u015f yak\u0131t koyuyorsunuz. Radikal bir diyet de\u011fil; sadece al\u0131\u015fkanl\u0131\u011f\u0131 k\u0131rmak i\u00e7in \u00e7evreyi \uff051 oran\u0131nda de\u011fi\u015ftiriyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u52a0\u9519\u71c3\u6599\u4e86\u3002\u4e0d\u662f\u6fc0\u8fdb\u7684\u8282\u98df\u2014\u2014\u6211\u4eec\u53ea\u662f\u628a\u73af\u5883\u6539\u53d81\uff05\uff0c\u4ee5\u6253\u7834\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6dfb\u52a0\u4e86\u932f\u8aa4\u7684\u71c3\u6599\u3002\u4e0d\u662f\u6fc0\u9032\u7684\u98f2\u98df\u2014\u2014\u6211\u5011\u53ea\u662f\u6539\u8b8a 1\uff05 \u7684\u74b0\u5883\u4f86\u6539\u6389\u9019\u500b\u7fd2\u6163\u3002"
          }
        }
      }
    },

    "trash.doener_dauerkarte.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knirscht so schön beim Drüberlaufen."

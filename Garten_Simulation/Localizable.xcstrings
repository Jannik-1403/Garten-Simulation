          "stringUnit": {
            "state": "translated",
            "value": "Gisteren zei je dat je dit vandaag beter wilde doen: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj powiedziałeś, że chcesz zrobić to lepiej dzisiaj: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem disseste que querias fazer isto melhor hoje: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem você disse que queria fazer isso melhor hoje: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера вы сказали, что хотите сделать это лучше сегодня: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün bugün bunu daha iyi yapmak istediğini söyledin: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你说今天想把这做得更好：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你說今天想把這做得更好：%@"
          }
        }
      }
    },
    "fitness.gratitude.detail.yesterday.low": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestern hast du dich nicht so gut gefühlt. Probier heute dich besser zu fühlen oder gestalte deinen Tag so, dass du dich besser fühlst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday you didn't feel so good. Try to feel better today or shape your day so you feel better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer no te sentiste muy bien. Intenta sentirte mejor hoy o diseña tu día para sentirte mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier, tu ne te sentais pas très bien. Essaie de te sentir mieux aujourd'hui ou organise ta journée pour te sentir mieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल आपको अच्छा नहीं लग रहा था। आज बेहतर महसूस करने की कोशिश करें या अपने दिन की योजना ऐसे बनाएं कि आपको बेहतर महसूस हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieri non ti sei sentito molto bene. Prova a sentirti meglio oggi o organizza la tua giornata per sentirti meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日はあまり気分が良くありませんでしたね。今日はもっと気分を良くするか、気分が良くなるように一日を計画してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어제는 기분이 별로 좋지 않았네요. 오늘은 기분이 좋아지도록 노력하거나 기분이 좋아지도록 하루를 계획해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gisteren voelde je je niet zo goed. Probeer je vandaag beter te voelen of deel je dag zo in dat je je beter voelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj nie czułeś się najlepiej. Spróbuj dzisiaj poczuć się lepiej lub zaplanuj swój dzień tak, aby poczuć się lepiej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem não te sentiste muito bem. Tenta sentir-te melhor hoje ou organiza o teu dia para te sentires melhor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontem você não se sentiu muito bem. Tente se sentir melhor hoje ou organize seu dia para se sentir melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера вы чувствовали себя не очень хорошо. Постарайтесь сегодня почувствовать себя лучше или спланируйте свой день так, чтобы почувствовать себя лучше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün kendini pek iyi hissetmedin. Bugün kendini daha iyi hissetmeye çalış veya gününü kendini daha iyi hissedecek şekilde planla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你感觉不太好。今天试着感觉好点，或者安排你的一天让自己感觉更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天你感覺不太好。今天試著感覺好點，或者安排你的一天讓自己感覺更好。"
          }
        }
      }
    },
    "fitness.gratitude.detail.yesterday.medium": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze dein Journal, um deinen Tag zu reflektieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your journal to reflect on your day."
          }
        },
        "es": {

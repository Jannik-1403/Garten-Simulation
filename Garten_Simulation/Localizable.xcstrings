    "prog_stretching_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe Bewegung in deine Mobility-Routine. Keine statischen Holds, sondern dynamische Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring movement into your mobility routine. No static holds, but dynamic changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora el movimiento a tu rutina de movilidad. No hay retenciones estáticas, sino cambios dinámicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduisez du mouvement dans votre routine de mobilité. Pas de maintien statique, mais des changements dynamiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिशीलता को अपनी गतिशीलता दिनचर्या में शामिल करें। कोई स्थिर धारण नहीं, बल्कि गतिशील परिवर्तन।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il movimento nella tua routine di mobilità. Nessuna presa statica, ma cambiamenti dinamici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動習慣に動きを取り入れましょう。静的な保持はなく、動的に変化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 루틴에 움직임을 추가하세요. 정적 보류는 없지만 동적 변경이 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng beweging in uw mobiliteitsroutine. Geen statische houvast, maar dynamische veranderingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź ruch do swojej codziennej rutyny. Żadnych statycznych zatrzymań, ale dynamiczne zmiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga movimento para sua rotina de mobilidade. Não há retenções estáticas, mas mudanças dinâmicas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga movimento para sua rotina de mobilidade. Não há retenções estáticas, mas mudanças dinâmicas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внесите движение в свою рутину передвижения. Никаких статических удерживаний, а только динамические изменения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketlilik rutininize hareket katın. Statik tutma yok, ancak dinamik değişiklikler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将运动融入您的日常活动中。没有静态的保持，而是动态的变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將運動融入您的日常活動中。沒有靜態的保持，而是動態的變化。"
          }
        }
      }
    },

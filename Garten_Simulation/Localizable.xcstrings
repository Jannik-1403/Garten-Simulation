    "settings.export.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie alle Ihre Daten exportieren? Sie erhalten eine Datei mit allen Ihren Pflanzen und Fortschritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to export all your data? You will receive a file with all your plants and progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres exportar todos tus datos? Recibirás un archivo con todas tus plantas y progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu exporter toutes tes données ? Tu recevras un fichier avec toutes tes plantes et progressions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप अपनी सभी डेटा निर्यात करना चाहेंगे? आपको अपनी सभी पौधों और प्रगति के साथ एक फ़ाइल प्राप्त होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi esportare tutti i tuoi dati? Riceverai un file con tutte le tue piante e i progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータをエクスポートしますか?すべての植物と進捗状況が記載されたファイルを受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터를 내보내시겠습니까? 모든 식물과 진행 상황이 포함된 파일을 받게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u al uw gegevens exporteren? U ontvangt een bestand met al uw planten en de voortgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz wyeksportować wszystkie swoje dane? Otrzymasz plik ze wszystkimi swoimi roślinami i postępami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres exportar todos os teus dados? Receberás um ficheiro com todas as tuas plantas e progresso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres exportar todos os teus dados? Receberás um ficheiro com todas as tuas plantas e progresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите экспортировать все ваши данные? Вы получите файл со всеми вашими растениями и достижениями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm verilerinizi dışa aktarmak istiyor musunuz? Tüm bitkilerinizi ve ilerlemenizi içeren bir dosya alacaksınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想导出所有数据吗？您将收到一份包含所有植物和进度的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您想匯出所有數據嗎？您將收到一份包含所有植物和進度的文件。"
          }
        }
      }
    },

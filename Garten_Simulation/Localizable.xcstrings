    "pfad_fit_day_90_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "90 Tage. Du hast das Unm\u00f6gliche m\u00f6glich gemacht. Du bist ein Meister."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "90 days. You have made the impossible possible. You are a master."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "90 d\u00edas. Has hecho posible lo imposible. Eres un maestro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "90 jours. Tu as rendu l'impossible possible. Tu es un ma\u00eetre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "90 \u0926\u093f\u0928. \u0906\u092a\u0928\u0947 \u0905\u0938\u0902\u092d\u0935 \u0915\u094b \u0938\u0902\u092d\u0935 \u092c\u0928\u093e \u0926\u093f\u092f\u093e. \u0906\u092a \u090f\u0915 \u092e\u093e\u0938\u094d\u091f\u0930 \u0939\u0948\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "90 giorni. Hai reso possibile l'impossibile. Sei un maestro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90\u65e5\u3002\u3042\u306a\u305f\u306f\u4e0d\u53ef\u80fd\u3092\u53ef\u80fd\u306b\u3057\u307e\u3057\u305f\u3002\u3042\u306a\u305f\u306f\u30de\u30b9\u30bf\u30fc\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "90\uc77c. \ubd88\uac00\ub2a5\uc744 \uac00\ub2a5\ud558\uac8c \ub9cc\ub4dc\uc168\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub9c8\uc2a4\ud130\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "90 dagen. Je hebt het onmogelijke mogelijk gemaakt. Je bent een meester."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "90 dni. Sprawi\u0142e\u015b, \u017ce niemo\u017cliwe sta\u0142o si\u0119 mo\u017cliwe. Jeste\u015b mistrzem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "90 dias. Fizeste o imposs\u00edvel poss\u00edvel. \u00c9s um mestre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "90 \u0434\u043d\u0435\u0439. \u0422\u044b \u0441\u0434\u0435\u043b\u0430\u043b \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c. \u0422\u044b \u043c\u0430\u0441\u0442\u0435\u0440."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "90 g\u00fcn. \u0130mkans\u0131z\u0131 m\u00fcmk\u00fcn k\u0131ld\u0131n\u0131z. Sen bir ustas\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "90\u5929\u3002\u4f60\u5df2\u5c06\u4e0d\u53ef\u80fd\u53d8\u4e3a\u53ef\u80fd\u3002\u4f60\u662f\u4e00\u4f4d\u5927\u5e08\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "90 \u5929\u3002\u4f60\u8b93\u4e0d\u53ef\u80fd\u6210\u70ba\u53ef\u80fd\u3002\u4f60\u662f\u4e00\u4f4d\u5927\u5e2b\u3002"
          }
        }
      }
    },
    "pfad_fit_day_90_title": {

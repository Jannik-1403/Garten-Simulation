        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u0907\u0938 \u0938\u092a\u094d\u0924\u093e\u0939 \u092c\u0939\u0941\u0924 \u0932\u0917\u093e\u0924\u093e\u0930 \u0930\u0939\u0947\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0927\u094d\u092f\u093e\u0928 \u0938\u092e\u092f \u0938\u094d\u0925\u093f\u0930 \u0930\u0939\u093e\u0964 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0926\u093f\u0928%@\u0925\u093e\u0964"

    "assessment.mental.q9" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand beschuldigt dich einer Sache, die du definitiv NICHT getan hast. Es gibt keine Beweise gegen dich, aber auch keine für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone accuses you of something you definitely did NOT do. There is no evidence against you, but there is no evidence for you either."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien te acusa de algo que definitivamente NO hiciste. No hay pruebas en su contra, pero tampoco las hay a su favor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un vous accuse de quelque chose que vous n’avez certainement PAS fait. Il n’y a aucune preuve contre vous, mais il n’y a aucune preuve pour vous non plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई आप पर किसी ऐसी चीज़ का आरोप लगाता है जो आपने निश्चित रूप से नहीं किया है। आपके ख़िलाफ़ कोई सबूत नहीं है, लेकिन आपके लिए भी कोई सबूत नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno ti accusa di qualcosa che sicuramente NON hai fatto. Non ci sono prove contro di te, ma non ce ne sono nemmeno a tuo carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが絶対にやっていないことで誰かがあなたを非難します。あなたに不利な証拠はありませんが、あなたにも証拠はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가가 당신이 확실히 하지 않은 일에 대해 당신을 비난합니다. 당신에 대한 증거는 없지만 당신에 대한 증거도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand beschuldigt je van iets dat je beslist NIET hebt gedaan. Er is geen bewijs tegen u, maar er is ook geen bewijs voor u."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś oskarża Cię o coś, czego na pewno NIE zrobiłeś. Nie ma dowodów przeciwko tobie, ale nie ma też dowodów dla ciebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém acusa você de algo que você definitivamente NÃO fez. Não há provas contra você, mas também não há provas a seu favor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то обвиняет тебя в том, чего ты определённо НЕ делал. Нет доказательств против тебя, но и нет доказательств в твою пользу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birisi sizi kesinlikle yapmadığınız bir şeyle suçluyor. Aleyhinize bir delil yok ama sizin aleyhinize de bir delil yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人指控你做了一件你绝对没有做过的事情。没有对你不利的证据，但也没有对你有利的证据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人指責你做了一些你絕對沒有做過的事情。沒有對你不利的證據，但也沒有對你有利的證據。"
          }
        }
      }
    },

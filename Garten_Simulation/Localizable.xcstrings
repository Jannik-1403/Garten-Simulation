        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuw begin! Blijf je streak van %d opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy pocz\u0105tek! Kontynuuj swoj\u0105 pass\u0119 %d."

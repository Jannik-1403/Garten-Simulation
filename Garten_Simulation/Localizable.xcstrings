    "pfad_fit_day_45_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "45 Tage Fitness. Dein K\u00f6rper hat sich bereits ver\u00e4ndert. Bleib stark!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "45 days of fitness. Your body has already changed. Stay strong!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "45 d\u00edas de fitness. Tu cuerpo ya ha cambiado. \u00a1Mantente fuerte!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "45 jours de fitness. Ton corps a d\u00e9j\u00e0 chang\u00e9. Reste fort !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "45 \u0926\u093f\u0928 \u0915\u0940 \u092b\u093f\u091f\u0928\u0947\u0938\u0964 \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u092c\u0926\u0932 \u091a\u0941\u0915\u093e \u0939\u0948. \u0939\u093f\u092e\u094d\u092e\u0924 \u092c\u0928\u093e\u092f\u0947\u0902 \u0930\u0916\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "45 giorni di fitness. Il tuo corpo \u00e8 gi\u00e0 cambiato. Rimani forte!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "45\u65e5\u9593\u306e\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u3059\u3067\u306b\u5909\u5316\u3057\u3066\u3044\u307e\u3059\u3002\u5f37\u304f\u3042\u308a\u306a\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "45\uc77c\uac04\uc758 \ud53c\ud2b8\ub2c8\uc2a4. \ub2f9\uc2e0\uc758 \ubab8\uc740 \uc774\ubbf8 \ubcc0\ud588\uc2b5\ub2c8\ub2e4. \ud798\ub0b4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "45 dagen fitness. Je lichaam is al veranderd. Blijf sterk!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "45 dni fitness. Twoje cia\u0142o ju\u017c si\u0119 zmieni\u0142o. B\u0105d\u017a silny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "45 dias de fitness. O teu corpo j\u00e1 mudou. Mant\u00e9m-te forte!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "45 \u0434\u043d\u0435\u0439 \u0444\u0438\u0442\u043d\u0435\u0441\u0430. \u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0443\u0436\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c. \u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u044b\u043c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "45 g\u00fcnl\u00fck fitness. V\u00fccudunuz zaten de\u011fi\u015fti. G\u00fc\u00e7l\u00fc kal!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "45\u5929\u5065\u8eab\u3002\u4f60\u7684\u8eab\u4f53\u5df2\u7ecf\u6539\u53d8\u3002\u4fdd\u6301\u5f3a\u5927\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {

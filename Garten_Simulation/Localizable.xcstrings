    "settings.health.instruction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil > Datenschutz > Apps > Grovy, um alles zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile > Privacy > Apps > Grovy to enable everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil > Privacidad > Apps > Grovy para activar todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil > Confidentialit\u00e9 > Apps > Grovy pour tout activer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 > \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e > \u0910\u092a\u094d\u0938 > \u0917\u094d\u0930\u094b\u0935\u0940, \u0938\u092c \u0915\u0941\u091b \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo > Privacy > App > Grovy per attivare tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb > \u30d7\u30e9\u30a4\u30d0\u30b7\u30fc > \u30a2\u30d7\u30ea > Grovy \u3067\u3059\u3079\u3066\u3092\u6709\u52b9\u306b\u3059\u308b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\ud544 > \uac1c\uc778\uc815\ubcf4 \ubcf4\ud638 > \uc571 > Grovy \uc5d0\uc11c \ubaa8\ub450 \ud65c\uc131\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiel > Privacy > Apps > Grovy om alles in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil > Prywatno\u015b\u0107 > Aplikacje > Grovy, aby w\u0142\u0105czy\u0107 wszystko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil > Privacidade > Apps > Grovy para ativar tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0444\u0438\u043b\u044c > \u041a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c > \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f > Grovy, \u0447\u0442\u043e\u0431\u044b \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0441\u0451."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil > Gizlilik > Uygulamalar > Grovy ile her \u015feyi etkinle\u015ftirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u914d\u7f6e\u6587\u4ef6 > \u9690\u79c1 > \u5e94\u7528\u7a0b\u5e8f > Grovy \u4ee5\u542f\u7528\u4e00\u5207\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a\u6a94 > \u96b1\u79c1\u6b0a > \u61c9\u7528\u7a0b\u5f0f > Grovy \u4ee5\u555f\u7528\u4e00\u5207\u3002"
          }
        }
      }
    },

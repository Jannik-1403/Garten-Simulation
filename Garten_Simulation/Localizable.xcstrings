            "value": "\u041d\u0443\u0436\u043d\u044b \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u044b, \u0447\u0442\u043e\u0431\u044b \u043d\u043e\u0441\u0438\u0442\u044c \u2013 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u044c\u043d\u043e\u0435 \u0433\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meyve vermek i\u00e7in molalara ihtiya\u00e7 var \u2013 Aral\u0131kl\u0131 oru\u00e7"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u4f11\u606f\u624d\u80fd\u7ed3\u679c \u2013 \u95f4\u6b47\u6027\u7981\u98df"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u4f11\u606f\u4f86\u652f\u6490\uff0d\u9593\u6b47\u6027\u65b7\u98df"
          }
        }
      }
    },
    "plant.ginkgo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ltester Baum der Welt \u2013 unvergesslich \u2013 Ged\u00e4chtnis\u00fcbungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest tree in the world \u2013 unforgettable \u2013 Memory exercises"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El \u00e1rbol m\u00e1s antiguo del mundo \u2013 Ejercicios de memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbre le plus ancien du monde \u2013 inoubliable \u2013 Exercices de m\u00e9moire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u093e \u092a\u0947\u0921\u093c \u2013 \u0905\u0935\u093f\u0938\u094d\u092e\u0930\u0923\u0940\u092f \u2013 \u0938\u094d\u092e\u0943\u0924\u093f \u0905\u092d\u094d\u092f\u093e\u0938"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest tree in the world \u2013 unforgettable \u2013 Memory exercises"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e16\u754c\u6700\u53e4\u306e\u6728 \u2013 \u5fd8\u308c\u3089\u308c\u306a\u3044 \u2013 \u8a18\u61b6\u529b\u306e\u7df4\u7fd2"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc138\uacc4\uc5d0\uc11c \uac00\uc7a5 \uc624\ub798\ub41c \ub098\ubb34 \u2013 \uc78a\ud600\uc9c0\uc9c0 \uc54a\ub294 \u2013 \uae30\uc5b5\ub825 \uc6b4\ub3d9"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudste boom ter wereld \u2013 onvergetelijk \u2013 Geheugenoefeningen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najstarsze drzewo \u015bwiata \u2013 niezapomniane \u2013 \u0106wiczenia pami\u0119ci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A \u00e1rvore mais antiga do mundo \u2013 inesquec\u00edvel \u2013 Exerc\u00edcios de mem\u00f3ria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0430\u043c\u043e\u0435 \u0441\u0442\u0430\u0440\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e \u0432 \u043c\u0438\u0440\u0435 \u2013 \u043d\u0435\u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c\u043e \u2013 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u0430\u043c\u044f\u0442\u0438"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fcnyan\u0131n en ya\u015fl\u0131 a\u011fac\u0131 \u2013 unutulmaz \u2013 Haf\u0131za egzersizleri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e16\u754c\u4e0a\u6700\u53e4\u8001\u7684\u6811 \u2013 \u4ee4\u4eba\u96be\u5fd8 \u2013 \u8bb0\u5fc6\u7ec3\u4e60"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e16\u754c\u4e0a\u6700\u53e4\u8001\u7684\u6a39\u2014\u2014\u4ee4\u4eba\u96e3\u5fd8\u2014\u2014\u8a18\u61b6\u7df4\u7fd2"
          }
        }
      }
    },

    "prog_gratitude_d2_t2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einer Person eventuell sogar 'Danke' gesagt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maybe even said 'thank you' to someone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal vez incluso le dije \"gracias\" a alguien"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut-être même dit \"merci\" à quelqu'un"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद किसी को 'धन्यवाद' भी कहा हो"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Magari ha anche detto \"grazie\" a qualcuno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もしかしたら誰かに「ありがとう」と言ったかもしれない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어쩌면 누군가에게 '고마워요'라고 말했을 수도 있어요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Misschien zelfs 'dankjewel' tegen iemand gezegd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może nawet powiedziałeś komuś „dziękuję”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez até tenha dito 'obrigado' a alguém"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez até tenha dito 'obrigado' a alguém"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может быть, даже сказал кому-то «спасибо»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belki birine 'teşekkür ederim' bile demiş olabilirim"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "甚至可能对某人说“谢谢”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "甚至可能對某人說“謝謝”"
          }
        }
      }
    },

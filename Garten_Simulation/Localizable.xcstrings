    "onboarding_screentime_mock_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du „Zalimo Habits“ Zugriff auf die Bildschirmzeit gewährst, kann die App u. a. deine Aktivitätsdaten sehen, Inhalte beschränken und die Nutzung von Apps und Websites limitieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Providing “Zalimo Habits” access to Screen Time may allow it to see your activity data, restrict content, and limit the usage of apps and websites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al proporcionar acceso a “Zalimo Habits” a Tiempo de uso, la aplicación puede ver tus datos de actividad, restringir contenido y limitar el uso de aplicaciones y sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser « Zalimo Habits » à accéder à Temps d’écran peut permettre à l'application de consulter vos données d'activité, restreindre le contenu et limiter l'utilisation d'applications et de sites web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप को ध्यान केंद्रित करने में मदद करने के लिए आपके स्क्रीन टाइम डेटा का उपयोग करने की अनुमति देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentendo a “Zalimo Habits” l'accesso a Tempo di utilizzo, l'app potrebbe visualizzare i tuoi dati di attività, applicare restrizioni ai contenuti e limitare l'uso di app e siti web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、アプリはスクリーンタイムのデータを使用して、集中をサポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 스크린 타임 데이터를 사용하여 집중할 수 있도록 도와줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je “Zalimo Habits” toegang tot Schermtijd geeft, kan de app uw activiteitsgegevens bekijken, inhoud beperken en het gebruik van apps en websites beperken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala to aplikacji wykorzystać dane Czasu przed ekranem, aby pomóc Ci w koncentracji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornecer acesso de “Zalimo Habits” ao Tempo de Uso pode permitir que o app veja os seus dados de atividade, restrinja conteúdo e limite o uso de apps e sites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornecer acesso de “Zalimo Habits” ao Tempo de Uso pode permitir que o app veja os seus dados de atividade, restrinja conteúdo e limite o uso de apps e sites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это позволяет приложению использовать ваши данные Экранного времени, чтобы помочь вам сосредоточиться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, uygulamanın konsantre olmanıza yardımcı olmak için Ekran Süresi verilerinizi kullanmasına olanak tanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这允许应用使用您的屏幕使用时间数据来帮助您集中注意力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這允許應用程式使用您的螢幕使用時間資料來幫助您集中注意力。"
          }
        }
      }
    },

    "plant.ginkgo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältester Baum der Welt – unvergesslich – Gedächtnisübungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest tree in the world – unforgettable – Memory exercises"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árbol más antiguo del mundo – Ejercicios de memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbre le plus ancien du monde – inoubliable – Exercices de mémoire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldest tree in the world – unforgettable – Memory exercises"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界最古の木 – 忘れられない – 記憶力の練習"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세계에서 가장 오래된 나무 – 잊혀지지 않는 – 기억력 운동"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudste boom ter wereld – onvergetelijk – Geheugenoefeningen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najstarsze drzewo świata – niezapomniane – Ćwiczenia pamięci"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A árvore mais antiga do mundo – inesquecível – Exercícios de memória"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın en yaşlı ağacı – unutulmaz – Hafıza egzersizleri"
          }
        }
      }
    },

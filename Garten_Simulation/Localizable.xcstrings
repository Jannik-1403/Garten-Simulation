    "prog_sleep_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iss deine letzte große Mahlzeit mindestens 3 Stunden vor dem Schlafengehen. Die Verdauung hindert dich am Tiefschlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat your last big meal at least 3 hours before bed. Digestion prevents you from deep sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realice su última comida abundante al menos 3 horas antes de acostarse. La digestión te impide dormir profundamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangez votre dernier gros repas au moins 3 heures avant de vous coucher. La digestion vous empêche de dormir profondément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना आखिरी बड़ा भोजन सोने से कम से कम 3 घंटे पहले खाएं। पाचन क्रिया आपको गहरी नींद आने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consuma il tuo ultimo pasto abbondante almeno 3 ore prima di andare a letto. La digestione ti impedisce di dormire profondamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の食事は少なくとも就寝 3 時間前までに済ませてください。消化は深い眠りを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자리에 들기 최소 3시간 전에 마지막 식사를 하세요. 소화는 깊은 잠을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eet uw laatste grote maaltijd minimaal 3 uur voor het slapengaan. Spijsvertering verhindert een diepe slaap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni duży posiłek zjedz co najmniej 3 godziny przed snem. Trawienie uniemożliwia głęboki sen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça sua última grande refeição pelo menos 3 horas antes de dormir. A digestão impede você de dormir profundamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça sua última grande refeição pelo menos 3 horas antes de dormir. A digestão impede você de dormir profundamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний раз обильный прием пищи ешьте не позднее, чем за 3 часа до сна. Пищеварение мешает глубокому сну."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son büyük yemeğinizi yatmadan en az 3 saat önce yiyin. Sindirim derin uykuya dalmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少在睡前 3 小时吃最后一顿大餐。消化会妨碍你进入深度睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少在睡前 3 小時吃最後一頓大餐。消化會妨礙你進入深度睡眠。"
          }
        }
      }
    },

    "Bestehende individuelle Wochenpläne kannst du in den erweiterten Details bearbeiten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestehende individuelle Wochenpläne kannst du in den erweiterten Details bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing custom weekly plans can be edited in the advanced details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes semanales personalizados existentes se pueden editar en los detalles avanzados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plannings hebdomadaires personnalisés existants peuvent être modifiés dans les détails avancés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा कस्टम साप्ताहिक योजनाओं को विस्तृत सेटिंग्स में संपादित किया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I piani settimanali personalizzati esistenti possono essere modificati nei dettagli avanzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のカスタム週間スケジュールは詳細設定で編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 맞춤 주간 계획은 고급 세부 정보에서 수정할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande aangepaste weekplannen kun je bewerken in de geavanceerde details."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istniejące niestandardowe plany tygodniowe można edytować w szczegółach zaawansowanych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes editar os planos semanais personalizados nos detalhes avançados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode editar planos semanais personalizados nos detalhes avançados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие индивидуальные планы на неделю можно изменить в расширенных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut özel haftalık planları gelişmiş ayrıntılarda düzenleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在高级详情中编辑现有的自定义周计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在進階詳細資料中編輯現有的自訂週計劃。"
          }
        }
      }
    },
    "Bitte öffne Zalimo, um deine Daten zu aktualisieren.": {

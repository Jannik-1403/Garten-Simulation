    "inventory.item.desc.growth_boost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschleunigt das Wachstum deiner Pflanzen um 50\uff05 f\u00fcr die n\u00e4chsten 24 Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accelerates the growth of your plants by 50\uff05 for the next 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelera el crecimiento de tus plantas en un 50\uff05 durante las pr\u00f3ximas 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acc\u00e9l\u00e8re la croissance de vos plantes de 50\uff05 pendant les prochaines 24 heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0917\u0932\u0947 24 \u0918\u0902\u091f\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u092a\u094c\u0927\u094b\u0902 \u0915\u0940 \u0935\u0943\u0926\u094d\u0927\u093f 50\uff05 \u0924\u0915 \u0924\u0947\u091c \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accelera la crescita delle tue piante del 50\uff05 per le prossime 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b21\u306e24\u6642\u9593\u3001\u690d\u7269\u306e\u6210\u9577\u309250\uff05\u52a0\u901f\u3055\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c 24\uc2dc\uac04 \ub3d9\uc548 \uc2dd\ubb3c\uc758 \uc131\uc7a5\uc744 50\uff05 \uac00\uc18d\ud654\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versnelt de groei van je planten met 50\uff05 voor de komende 24 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyspiesza wzrost twoich ro\u015blin o 50\uff05 przez nast\u0119pne 24 godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelera o crescimento de suas plantas em 50\uff05 pelas pr\u00f3ximas 24 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u043a\u043e\u0440\u044f\u0435\u0442 \u0440\u043e\u0441\u0442 \u0432\u0430\u0448\u0438\u0445 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0439 \u043d\u0430 50\uff05 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 24 \u0447\u0430\u0441\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6n\u00fcm\u00fczdeki 24 saat boyunca bitkilerinizin b\u00fcy\u00fcmesini \uff0550 h\u0131zland\u0131r\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u63a5\u4e0b\u6765\u768424\u5c0f\u65f6\u5185\uff0c\u5c06\u4f60\u7684\u690d\u7269\u751f\u957f\u901f\u5ea6\u52a0\u5feb50\uff05\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u63a5\u4e0b\u4f86\u7684 24 \u5c0f\u6642\u5167\u5c07\u690d\u7269\u7684\u751f\u9577\u901f\u5ea6\u52a0\u5feb 50\uff05\u3002"
          }
        }
      }
    },

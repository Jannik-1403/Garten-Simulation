    "plant.create.insufficient_seeds": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gen\u00fcgend Samen! Du brauchst mindestens 10 Samen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough seeds! You need at least 10 seeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1No hay suficientes semillas! Necesitas al menos 10 semillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de graines! Il vous faut au moins 10 graines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u092c\u0940\u091c \u0928\u0939\u0940\u0902! \u0906\u092a\u0915\u094b \u0915\u092e \u0938\u0947 \u0915\u092e 10 \u092c\u0940\u091c \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai abbastanza semi! Ti servono almeno 10 semi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a2e\u304c\u8db3\u308a\u307e\u305b\u3093\uff01\u5c11\u306a\u304f\u3068\u308210\u500b\u306e\u7a2e\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc528\uc557\uc774 \ubd80\uc871\ud569\ub2c8\ub2e4! \ucd5c\uc18c 10\uac1c\uc758 \uc528\uc557\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg zaden! Je hebt minstens 10 zaden nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ma\u0142o nasion! Potrzebujesz co najmniej 10 nasion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sementes insuficientes! Voc\u00ea precisa de pelo menos 10 sementes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u0435\u043c\u044f\u043d! \u0422\u0435\u0431\u0435 \u043d\u0443\u0436\u043d\u043e \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c 10 \u0441\u0435\u043c\u044f\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli tohum yok! En az 10 tohuma ihtiyac\u0131n\u0131z var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79cd\u5b50\u4e0d\u8db3\uff01\u4f60\u81f3\u5c11\u9700\u898110\u9897\u79cd\u5b50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a2e\u5b50\u4e0d\u5920\uff01\u4f60\u81f3\u5c11\u9700\u8981 10 \u9846\u7a2e\u5b50\u3002"
          }
        }
      }
    },

            "value": "Ton jardin t'attend"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u092c\u0917\u0940\u091a\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino ti aspetta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u304c\u5f85\u3063\u3066\u3044\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc815\uc6d0\uc774 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tuin wacht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j ogr\u00f3d czeka"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu jardim espera por ti"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u0441\u0430\u0434 \u0436\u0434\u0451\u0442"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7eniz sizi bekliyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u82b1\u56ed\u5728\u7b49\u4f60"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u82b1\u5712\u6b63\u5728\u7b49\u5f85"
          }
        }
      }
    },
    "notification.evening.2.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht auf deine Pflanzen! %d %@ braucht heute noch Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget your plants! %d %@ still needs water today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1No olvides tus plantas! %d %@ todav\u00eda necesita agua hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oublie pas tes plantes ! %d %@ a encore besoin d'eau aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092a\u094c\u0927\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092e\u0924 \u092d\u0942\u0932\u0928\u093e!%d%@\u0915\u094b \u0906\u091c \u092d\u0940 \u092a\u093e\u0928\u0940 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare le tue piante! %d %@ ha ancora bisogno d'acqua oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u3082\u5fd8\u308c\u305a\u306b\uff01 %d %@ \u306f\u4eca\u65e5\u3082\u6c34\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc2dd\ubb3c\uc744 \uc78a\uc9c0 \ub9c8\uc138\uc694! %d %@ \uc624\ub298\ub3c4 \uc5ec\uc804\ud788 \ubb3c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet je planten niet! %d %@ heeft vandaag nog steeds water nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapomnij o swoich ro\u015blinach! %d %@ nadal dzisiaj potrzebuje wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o te esque\u00e7as das tuas plantas! %d %@ ainda precisa de \u00e1gua hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c \u043f\u0440\u043e \u0441\u0432\u043e\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f!%d%@\u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0435\u0449\u0451 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u043b\u0438\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkilerinizi unutmay\u0131n! %d %@ bug\u00fcn h\u00e2l\u00e2 suya ihtiya\u00e7 duyuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u522b\u5fd8\u4e86\u4f60\u7684\u690d\u7269\uff01%d %@ \u4eca\u5929\u8fd8\u9700\u8981\u6d47\u6c34\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5fd8\u8a18\u4f60\u7684\u690d\u7269\uff01%d%@\u4eca\u5929\u4ecd\u7136\u9700\u8981\u6c34\u3002"
          }
        }
      }
    },

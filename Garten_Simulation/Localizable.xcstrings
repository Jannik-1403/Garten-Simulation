    "prog_noalcohol_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol zerstört den REM-Schlaf. Achte heute Nacht bewusst auf deine Traumphasen und wie erholt du aufwachst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol destroys REM sleep. Tonight, pay conscious attention to your dream phases and how refreshed you wake up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alcohol destruye el sueño REM. Esta noche, presta atención consciente a las fases de tus sueños y a lo renovado que te despiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alcool détruit le sommeil paradoxal. Ce soir, portez une attention consciente à vos phases de rêve et à la fraîcheur avec laquelle vous vous réveillez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शराब REM नींद को नष्ट कर देती है। आज रात, अपने सपने के चरणों पर सचेत ध्यान दें और आप कितने तरोताजा होकर उठते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alcol distrugge il sonno REM. Stasera, presta attenzione consapevole alle fasi dei tuoi sogni e a quanto riposato ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルコールはレム睡眠を破壊します。今夜、夢の段階と目覚めの爽快さに意識的に注意を払ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알코올은 REM 수면을 파괴합니다. 오늘 밤, 꿈의 단계와 깨어났을 때 얼마나 상쾌한지 의식적으로 주의를 기울이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol vernietigt de REM-slaap. Let vanavond bewust op je droomfasen en hoe uitgerust je wakker wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol niszczy fazę REM. Dziś wieczorem zwracaj świadomą uwagę na fazy snu i na to, jak wypoczęty się budzisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O álcool destrói o sono REM. Esta noite, preste atenção consciente às fases do seu sonho e ao quão revigorado você acorda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O álcool destrói o sono REM. Esta noite, preste atenção consciente às fases do seu sonho e ao quão revigorado você acorda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol destroys REM sleep. Сегодня вечером обратите сознательное внимание на фазы своего сна и на то, насколько отдохнувшим вы просыпаетесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkol REM uykusunu yok eder. Bu gece rüya aşamalarınıza ve ne kadar dinç uyandığınıza bilinçli olarak dikkat edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酒精会破坏快速眼动睡眠。今晚，有意识地注意你的梦境以及你醒来时的精神状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "酒精會破壞快速動眼睡眠。今晚，有意識地註意你的夢境以及你醒來時的精神狀態。"
          }
        }
      }
    },

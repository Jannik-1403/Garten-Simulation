    "prog_water_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dir deine gesamte Tagesration morgens sichtbar an den Arbeitsplatz oder in die Küche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your entire daily ration visibly at work or in the kitchen in the morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca toda tu ración diaria de forma visible en el trabajo o en la cocina por la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez l'intégralité de votre ration quotidienne visiblement au travail ou dans la cuisine le matin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पूरा दैनिक राशन सुबह कार्यस्थल पर या रसोई में स्पष्ट रूप से रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti tutta la tua razione giornaliera in modo visibile al lavoro o in cucina al mattino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝、毎日の食料をすべて職場またはキッチンに目に見えるように置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 직장이나 주방에 하루 배급량 전체를 눈에 띄게 배치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet uw gehele dagrantsoen 's ochtends zichtbaar neer op het werk of in de keuken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść całą dzienną porcję żywności w widocznym miejscu w pracy lub w kuchni rano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque toda a sua ração diária de forma visível no trabalho ou na cozinha pela manhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque toda a sua ração diária de forma visível no trabalho ou na cozinha pela manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утром разместите весь свой дневной рацион на видном месте на работе или на кухне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük rasyonunuzun tamamını sabahları işyerinde veya mutfağa görünür şekilde koyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您每日的全部配给量放在工作场所或早上厨房的明显位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將您每日的全部配給量放在工作場所或早上廚房的明顯位置。"
          }
        }
      }
    },

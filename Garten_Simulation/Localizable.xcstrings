          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделяй себе каждый день 2 минуты, чтобы искренне похвалить успех другого."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

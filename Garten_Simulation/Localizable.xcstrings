            "value": "Makine"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsistenz ist alles. Trainiere heute, auch wenn du absolut keine Lust hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency is everything. Train today, even if you absolutely don't feel like it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coherencia lo es todo. Entrena hoy, incluso si no te apetece en absoluto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cohérence est primordiale. Entraînez-vous aujourd’hui, même si vous n’en avez absolument pas envie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La coerenza è tutto. Allenati oggi, anche se non ne hai assolutamente voglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一貫性がすべてです。たとえ気分が乗らなくても、今日はトレーニングしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관성이 전부입니다. 전혀 기분이 좋지 않더라도 오늘 훈련하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistentie is alles. Train vandaag nog, ook als je absoluut geen zin hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spójność jest wszystkim. Trenuj już dziś, nawet jeśli zupełnie nie masz na to ochoty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistência é tudo. Treine hoje, mesmo que você não tenha vontade alguma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlılık her şeydir. Canınız hiç istemese bile bugün antrenman yapın."
          }
        }
      }
    },

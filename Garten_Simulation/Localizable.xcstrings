    "assessment.finance.pitfall.reserves": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf, Geld für Konsum auszugeben, bevor du nicht mindestens 10% deines Einkommens gespart hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop spending on consumption before saving at least 10% of your income."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de gastar en consumo antes de ahorrar al menos el 10% de tus ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête de dépenser avant d'avoir épargné au moins 10% de tes revenus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी आय का कम से कम 10% बचाने से पहले उपभोग पर खर्च करना बंद करो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di spendere in consumi prima di aver risparmiato almeno il 10% delle entrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入の少なくとも10%を貯蓄する前に消費に使うのをやめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입의 최소 10%를 저축하기 전에 소비에 쓰는 것을 중단하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met consumptie-uitgaven voordat je minimaal 10% van je inkomen hebt gespaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestań wydawać na konsumpcję, zanim nie zaoszczędzisz przynajmniej 10% swojego dochodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para de gastar em consumo antes de poupar pelo menos 10% do teu rendimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para de gastar em consumo antes de poupar pelo menos 10% do teu rendimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекрати тратить на потребление, пока не сохранишь хотя бы 10% своего дохода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelirinizin en az %10'unu biriktirmeden tüketim harcaması yapmayı bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在储蓄至少10%的收入之前，停止在消费上花钱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在儲蓄至少10%的收入之前，停止在消費上花錢。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.finance.profile.impulsiver.break": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe nie hungrig oder extrem gestresst einkaufen – das 1% extra Stress führt zu 50% mehr Ausgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never go shopping hungry or extremely stressed - that 1% extra stress leads to 50% more spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vayas de compras con hambre o muy estresado: ese 1 % de estrés adicional genera un 50 % más de gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne faites jamais vos courses le ventre vide ou extrêmement stressé: 1 % de stress supplémentaire entraîne 50 % de dépenses en plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी भी भूखे पेट या अत्यधिक तनाव में खरीदारी करने न जाएं - 1% अतिरिक्त तनाव 50% अधिक खर्च का कारण बनता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non andare mai a fare shopping affamato o estremamente stressato: quell'1% di stress in più porta a una spesa maggiore del 50%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空腹や極度のストレスを抱えた状態で買い物に行くのは絶対にやめてください。1% の余分なストレスが 50% の支出増加につながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배고프거나 극심한 스트레스를 받으며 쇼핑하지 마세요. 1%의 추가 스트레스로 인해 50% 더 많은 지출이 발생합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga nooit hongerig of extreem gestresst winkelen: 1% extra stress leidt tot 50% meer bestedingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie chodź na zakupy głodny ani bardzo zestresowany – 1% dodatkowego stresu prowadzi do 50% większych wydatków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vá às compras com fome ou extremamente estressado – esse 1% de estresse extra leva a 50% mais gastos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vá às compras com fome ou extremamente estressado – esse 1% de estresse extra leva a 50% mais gastos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не ходите за покупками голодным или в состоянии крайнего стресса – 1% дополнительного стресса приводит к 50% большим расходам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla aç veya aşırı stresli bir şekilde alışverişe gitmeyin; %1 ekstra stres %50 daha fazla harcamaya yol açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿在饥饿或极度压力下购物——额外1%的压力会导致50%的额外支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠不要餓著肚子或壓力過大去購物 - 1% 的額外壓力會導致 50% 的額外支出。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.finance.profile.impulsiver.build": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche deine Kreditkartendaten aus der Auto-Fill-Funktion deines Browsers. Die 10 Sekunden, um die Karte zu holen, stoppen 80% deiner Impulskäufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your credit card information from your browser's autofill feature. The 10 seconds to get the card stops 80% of your impulse purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine la información de su tarjeta de crédito de la función de autocompletar de su navegador. Los 10 segundos para conseguir la tarjeta frenan el 80% de tus compras impulsivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les informations de votre carte de crédit de la fonction de saisie automatique de votre navigateur. Les 10 secondes pour obtenir la carte stoppent 80% de vos achats impulsifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ब्राउज़र की ऑटोफ़िल सुविधा से अपने क्रेडिट कार्ड की जानकारी हटाएँ। कार्ड प्राप्त करने के 10 सेकंड में आपकी 80% खरीदारी रुक जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i dati della tua carta di credito dalla funzione di compilazione automatica del browser. I 10 secondi per ottenere la carta bloccano l'80% dei tuoi acquisti d'impulso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザの自動入力機能からクレジット カード情報を削除します。カードを取得するまでの 10 秒で、衝動買いの 80% が阻止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저의 자동완성 기능에서 신용카드 정보를 삭제하세요. 카드를 받는 데 10초가 걸리면 충동 구매의 80%가 중단됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder uw creditcardgegevens uit de functie voor automatisch aanvullen van uw browser. De 10 seconden om de kaart te krijgen, stopt 80% van uw impulsaankopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń informacje o karcie kredytowej z funkcji automatycznego uzupełniania w przeglądarce. 10 sekund na otrzymanie karty zatrzymuje 80% zakupów impulsywnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua as informações do seu cartão de crédito do recurso de preenchimento automático do seu navegador. Os 10 segundos para obter o cartão interrompem 80% de suas compras por impulso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua as informações do seu cartão de crédito do recurso de preenchimento automático do seu navegador. Os 10 segundos para obter o cartão interrompem 80% de suas compras por impulso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите данные своей кредитной карты из функции автозаполнения вашего браузера. Те 10 секунд, чтобы достать карту, останавливают 80% ваших импульсивных покупок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcınızın otomatik doldurma özelliğinden kredi kartı bilgilerinizi silin. Kartı almak için 10 saniye, anlık alışverişlerinizin %80'ini durdurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你浏览器的自动填写功能中删除你的信用卡信息。花10秒钟去拿信用卡可以阻止你80%的冲动购物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從瀏覽器的自動填入功能中刪除您的信用卡資訊。辦卡的 10 秒可以阻止您 80% 的衝動購買。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.finance.profile.kontrolleur.build": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisiere 1% mehr deines Einkommens direkt per Dauerauftrag auf ein Anlagekonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automate 1% more of your income directly into an investment account via standing order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatice un 1% más de sus ingresos directamente en una cuenta de inversión mediante orden permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisez 1 % de plus de vos revenus directement sur un compte d'investissement via un ordre permanent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थायी आदेश के माध्यम से अपनी आय का 1% अधिक सीधे निवेश खाते में स्वचालित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatizza l'1% in più del tuo reddito direttamente su un conto di investimento tramite ordine permanente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入の 1% を追加して、スタンディング注文を通じて直接投資口座に自動入金します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 주문을 통해 수입의 1% 이상을 직접 투자 계좌로 자동화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiseer 1% meer van uw inkomsten rechtstreeks naar een beleggingsrekening via een doorlopende opdracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zautomatyzuj 1% więcej swoich dochodów bezpośrednio na rachunku inwestycyjnym za pomocą zlecenia stałego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatize 1% a mais de sua receita diretamente em uma conta de investimento por meio de ordem permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatize 1% a mais de sua receita diretamente em uma conta de investimento por meio de ordem permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматизируй 1% своего дохода напрямую через постоянное поручение на инвестиционный счет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelirinizin %1 daha fazlasını sabit emir yoluyla doğrudan bir yatırım hesabına aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你收入的1%通过自动转账直接存入投资账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過定期訂單自動將 1% 的收入直接存入投資帳戶。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.finance.q12": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand bietet dir ein brandneues Investment an, das dir 'garantiert 15% Rendite pro Jahr ohne Risiko' bringt. Deine Reaktion?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone offers you a brand new investment that gives you a 'guaranteed 15% return per year with no risk'. Your reaction?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien le ofrece una nueva inversión que le ofrece un \"rendimiento garantizado del 15% anual sin riesgo\". ¿Tu reacción?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un vous propose un tout nouvel investissement qui vous offre un « rendement garanti de 15 % par an sans risque ». Votre réaction ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आपको बिल्कुल नए निवेश की पेशकश करता है जो आपको 'बिना किसी जोखिम के प्रति वर्ष 15% रिटर्न की गारंटी' देता है। आपकी प्रतिक्रिया?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ti offre un investimento nuovo di zecca che ti dà un \"rendimento garantito del 15% annuo senza rischi\". La tua reazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたに「リスクなしで年間 15% のリターンを保証」するまったく新しい投資を提案します。あなたの反応は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 당신에게 '위험 없이 연간 15% 수익 보장'을 제공하는 새로운 투자를 제안합니다. 당신의 반응은?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand biedt u een gloednieuwe investering aan die u een 'gegarandeerd rendement van 15% per jaar zonder risico' oplevert. Jouw reactie?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś oferuje Ci zupełnie nową inwestycję, która zapewni Ci „gwarantowany zwrot w wysokości 15% rocznie bez ryzyka”. Twoja reakcja?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém lhe oferece um investimento totalmente novo que lhe dá um “retorno garantido de 15% ao ano, sem risco”. Sua reação?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém lhe oferece um investimento totalmente novo que lhe dá um “retorno garantido de 15% ao ano, sem risco”. Sua reação?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то предлагает тебе совершенно новое инвестирование, которое 'гарантированно приносит 15% годовых без риска'. Какова твоя реакция?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi size 'hiçbir risk olmadan yılda %15 garantili getiri' sağlayacak yepyeni bir yatırım teklif ediyor. Tepkiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人向你提供一个全新的投资，‘保证每年无风险收益15%’。你的反应是什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人向您提供一項全新的投資，「保證每年 15% 的回報，無風險」。你的反應？"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.finance.q13": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast 2.000€ Kreditkartenschulden (12% Zinsen) und gleichzeitig 2.000€ auf dem Sparbuch (2% Zinsen). Was tust du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have €2,000 in credit card debt (12% interest) and at the same time €2,000 in your savings account (2% interest). What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes 2.000€ de deuda en tu tarjeta de crédito (12% de interés) y al mismo tiempo 2.000€ en tu cuenta de ahorros (2% de interés). ¿Qué estás haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez 2 000 € de dettes de carte de crédit (intérêt 12 %) et en même temps 2 000 € sur votre compte épargne (intérêt 2 %). Que fais-tu?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके क्रेडिट कार्ड ऋण में €2,000 (12% ब्याज) है और साथ ही आपके बचत खाते में €2,000 (2% ब्याज) है। आप क्या कर रहे हो?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai 2.000 € di debito sulla tua carta di credito (12% di interesse) e allo stesso tempo 2.000 € sul tuo conto di risparmio (2% di interesse). Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはクレジット カードの借金 (利息 12%) が 2,000 ユーロあり、同時に普通預金口座にも 2,000 ユーロ (利息 2%) があります。何してるの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신용카드 빚이 €2,000(이자 12%)이고 동시에 저축 계좌에 €2,000(이자 2%)가 있습니다. 뭐하세요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft € 2.000,- aan creditcardschuld (12% rente) en tegelijkertijd € 2.000,- op uw spaarrekening (2% rente). Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz 2000 euro zadłużenia na karcie kredytowej (12% odsetek) i jednocześnie 2000 euro na koncie oszczędnościowym (2% odsetek). Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem 2.000€ em dívidas de cartão de crédito (juros de 12%) e ao mesmo tempo 2.000€ na sua conta poupança (juros de 2%). O que você está fazendo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem 2.000€ em dívidas de cartão de crédito (juros de 12%) e ao mesmo tempo 2.000€ na sua conta poupança (juros de 2%). O que você está fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебя 2.000€ долгов по кредитной карте (12% годовых) и одновременно 2.000€ на сберегательном счете (2% годовых). Что ты будешь делать?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi kartı borcunuzda 2.000 € (%12 faiz) ve aynı zamanda tasarruf hesabınızda 2.000 € (%2 faiz) var. Ne yapıyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有2000欧元的信用卡债务（利息12%），同时在储蓄账户上有2000欧元（利息2%）。你会怎么做？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的信用卡債務為 2,000 歐元（利息為 12%），同時您的儲蓄帳戶中有 2,000 歐元（利息為 2%）。你在幹什麼？"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.fitness.profile.ausreden_sucher.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verwaltest Ausreden. Durch 1% Vorbereitung am Vorabend eliminierst du die Option, abzusagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You manage excuses. By preparing 1% the night before, you eliminate the option of canceling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú manejas las excusas. Al preparar el 1% la noche anterior, eliminas la opción de cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gérez les excuses. En préparant 1% la veille, vous éliminez la possibilité d’annuler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बहाने बनाते हैं. एक रात पहले 1% तैयारी करके, आप रद्द करने का विकल्प समाप्त कर देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le scuse. Preparando l'1% la sera prima, elimini la possibilità di annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは言い訳を管理します。前日の夜に1%を準備しておけば、キャンセルの選択肢がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 변명을 관리합니다. 전날 밤 1%를 준비하면 취소할 가능성이 없어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beheert excuses. Door de avond ervoor 1% voor te bereiden, elimineert u de mogelijkheid om te annuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzasz wymówkami. Przygotowując 1% dzień wcześniej, eliminujesz możliwość rezygnacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você gerencia desculpas. Ao preparar 1% na noite anterior, você elimina a opção de cancelamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você gerencia desculpas. Ao preparar 1% na noite anterior, você elimina a opção de cancelamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты управляешь оправданиями. Всего 1% подготовки накануне устраняет возможность отмены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahaneleri yönetiyorsun. %1'i bir gece önceden hazırlayarak iptal seçeneğini ortadan kaldırırsınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在管理借口。通过前一晚 1% 的准备，你可以消除取消的选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你管理藉口。透過前一天晚上準備 1%，您就無需取消預訂。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.fitness.profile.maschine.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme Härte und Disziplin. Deine 1% Verbesserung liegt im Verhindern von Verletzungs-Ausfällen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme hardship and discipline. Your 1% improvement is in preventing injury absences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dificultad extrema y disciplina. Su mejora del 1% es en la prevención de ausencias por lesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Difficultés et discipline extrêmes. Votre amélioration de 1 % consiste à prévenir les absences pour cause de blessure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अत्यधिक कठिनाई और अनुशासन. आपका 1% सुधार चोट की अनुपस्थिति को रोकने में है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrema difficoltà e disciplina. Il tuo miglioramento dell'1% riguarda la prevenzione delle assenze per infortunio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "極度の苦難と規律。 1% の改善は怪我による欠勤の防止にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "극도의 고난과 규율. 1%의 개선은 부상 결근을 예방하는 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme ontberingen en discipline. Uw verbetering van 1% ligt in het voorkomen van verzuim door blessures."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstremalne trudności i dyscyplina. Twój 1% poprawy polega na zapobieganiu absencji spowodowanej kontuzjami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrema dificuldade e disciplina. Sua melhoria de 1% está na prevenção de ausências por lesão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrema dificuldade e disciplina. Sua melhoria de 1% está na prevenção de ausências por lesão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экстремальная строгость и дисциплина. Твоё улучшение на 1% заключается в предотвращении травм."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşırı zorluk ve disiplin. %1'lik ilerlemeniz sakatlıkların önlenmesindedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极端的严格和纪律。你那1%的提升在于防止伤病缺勤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "極度的艱苦和紀律。你的 1% 進步是為了防止因傷缺席。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.fitness.profile.schoenwetter_sportler.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konsistenz. Die 1%-Methode beseitigt die Ausreden vor dem Sport, nicht den Sport selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No consistency. The 1% method eliminates the excuses before exercise, not the exercise itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin coherencia. El método del 1% elimina las excusas antes del ejercicio, no el ejercicio en sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune cohérence. La méthode 1% élimine les excuses avant l’exercice, pas l’exercice lui-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई स्थिरता नहीं. 1% विधि व्यायाम से पहले के बहानों को ख़त्म करती है, व्यायाम को नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna coerenza. Il metodo dell’1% elimina le scuse prima dell’esercizio, non l’esercizio stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一貫性がない。 1% メソッドは、運動そのものではなく、運動前の言い訳を排除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관성이 없습니다. 1% 방법은 운동 자체가 아닌 운동 전 핑계를 없애줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen consistentie. De 1%-methode elimineert de excuses vóór het sporten, niet de oefening zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak konsekwencji. Metoda 1% eliminuje wymówki przed ćwiczeniami, a nie same ćwiczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem consistência. O método de 1% elimina as desculpas antes do exercício, e não o exercício em si."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem consistência. O método de 1% elimina as desculpas antes do exercício, e não o exercício em si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет последовательности. Метод 1% устраняет оправдания перед тренировкой, а не саму тренировку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlılık yok. %1 yöntemi egzersizin kendisini değil, egzersiz öncesi mazeretleri ortadan kaldırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有一致性。1% 方法消除了锻炼前的借口，而不是锻炼本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有一致性。 1%方法消除的是運動前的藉口，而不是運動本身。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.fitness.q1.d": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fluche, stehe auf, friere und ziehe das geplante Workout zu 100% durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I curse, get up, freeze and do the planned workout 100%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maldigo, me levanto, me congelo y hago el entrenamiento planificado al 100%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je maudis, je me lève, je me fige et je fais l'entraînement prévu à 100 %."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं शाप देता हूं, उठता हूं, जम जाता हूं और नियोजित कसरत 100% करता हूं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impreco, mi alzo, mi blocco e faccio l'allenamento pianificato al 100%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は悪態をつき、起き上がり、固まり、計画したトレーニングを100%実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "욕하고, 일어나고, 얼어붙고, 계획한 운동을 100% 한다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik vloek, sta op, bevries en doe de geplande training 100%."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeklinam, wstaję, zamarzam i realizuję zaplanowany trening na 100%."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaldiçoo, levanto, congelo e faço 100% o treino planejado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaldiçoo, levanto, congelo e faço 100% o treino planejado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я ругаюсь, встаю, мёрзну и выполняю запланированную тренировку на 100%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanet ediyorum, kalkıyorum, donuyorum ve planladığım antrenmanı %100 yapıyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我咒骂，起身，感到寒冷，并且百分之百完成计划中的锻炼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我咒罵著，站起來，一動也不動，100% 完成計畫的鍛鍊。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.fitness.q5.c": {
      "localizations": {
        "de": {
          "stringUnit": {

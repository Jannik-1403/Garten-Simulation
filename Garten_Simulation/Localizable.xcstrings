    "prog_coldshower_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe nicht erst warm auf. Gehe direkt ins eiskalte Wasser. Die ultimative mentale Hürde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't turn the heat up first. Go straight into the ice cold water. The ultimate mental hurdle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No subas la temperatura primero. Ve directamente al agua helada. El último obstáculo mental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'augmentez pas le feu en premier. Allez directement dans l’eau glacée. L'ultime obstacle mental."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे पहले आंच तेज़ न करें. सीधे बर्फ के ठंडे पानी में चले जाओ। परम मानसिक बाधा."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non alzare prima il riscaldamento. Vai direttamente nell'acqua ghiacciata. L'ultimo ostacolo mentale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に温度を上げないでください。そのまま氷水に入れてください。究極の精神的ハードル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 불을 켜지 마세요. 바로 얼음물에 들어갑니다. 궁극적인 정신적 장애물."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de verwarming niet eerst hoger. Ga meteen het ijskoude water in. De ultieme mentale hindernis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zwiększaj najpierw ogrzewania. Idź prosto do lodowatej wody. Największa przeszkoda mentalna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não aumente o aquecimento primeiro. Vá direto para a água gelada. O último obstáculo mental."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não aumente o aquecimento primeiro. Vá direto para a água gelada. O último obstáculo mental."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не включайте сначала огонь. Идите прямо в ледяную воду. Высшее умственное препятствие."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk önce ısıyı açmayın. Direkt buz gibi suya girin. Nihai zihinsel engel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先不要把暖气调高。直接进入冰冷的水中。最终的心理障碍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先不要把暖氣調高。直接進入冰冷的水中。最終的心理障礙。"
          }
        }
      }
    },
    "prog_coldshower_d7_t1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne vorher heiß zu duschen ins Kalte gegangen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Went into the cold without taking a hot shower first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entré al frío sin tomar una ducha caliente primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis allé dans le froid sans prendre de douche chaude au préalable"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले गर्म स्नान किए बिना ठंड में चला गया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono andato al freddo senza prima fare una doccia calda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に熱いシャワーを浴びずに寒い中に入った"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨거운 물로 먼저 샤워도 하지 않고 추위 속으로 들어갔다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kou ingegaan zonder eerst een warme douche te hebben genomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poszedłem na zimno, nie biorąc najpierw gorącego prysznica"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fui para o frio sem tomar banho quente primeiro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fui para o frio sem tomar banho quente primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышел на мороз, не приняв предварительно горячий душ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce sıcak duş almadan soğuğa girdim"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有先洗热水澡就进入寒冷状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有先洗熱水澡就進入寒冷狀態"
          }
        }
      }

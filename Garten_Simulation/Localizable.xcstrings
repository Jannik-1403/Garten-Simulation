    "body.tracking.easy_desc_adaptive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dein Ziel zu erreichen, musst du ca. %1$.2f %2$@ pro Woche %3$@. Das ist sehr entspannt, du könntest es theoretisch auch in %4$d Wochen schaffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reach your goal, you need approx. %1$.2f %2$@ per week to %3$@. This is very relaxed, you could theoretically achieve it in %4$d weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para alcanzar tu objetivo, necesitas aprox. %1$.2f %2$@ por semana para %3$@. Esto es muy relajado, teóricamente podrías lograrlo en %4$d semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour atteindre votre objectif, vous avez besoin d'environ %1$.2f %2$@ par semaine pour %3$@. C'est très détendu, vous pourriez théoriquement l'atteindre en %4$d semaines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लक्ष्य तक पहुँचने के लिए आपको लगभग %1$.2f %2$@ प्रति सप्ताह %3$@ खर्च करना होगा। यह बहुत आरामदायक है, सैद्धांतिक रूप से आप इसे %4$d सप्ताहों में कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per raggiungere il tuo obiettivo devi spendere circa %1$.2f %2$@ a settimana %3$@. È molto rilassante, teoricamente potresti farlo in %4$d settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標を達成するには、1 週間あたり約 %1$.2f %2$@ %3$@ を費やす必要があります。とてもリラックスできます。理論的には %4$d 週間で完了できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 달성하려면 주 %3$@당 약 %1$.2f %2$@을 지출해야 합니다. 매우 편안합니다. 이론적으로는 %4$d주 안에 완료할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om uw doel te bereiken moet u ongeveer %1$.2f %2$@ per week %3$@ uitgeven. Het is heel ontspannend, je zou het theoretisch in %4$d weken kunnen doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby osiągnąć swój cel, musisz wydać około %1$.2f %2$@ tygodniowo %3$@. To bardzo relaksujące, teoretycznie można to zrobić w %4$d tygodni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para atingir sua meta, você precisa gastar aproximadamente %1$.2f %2$@ por semana %3$@. É muito relaxante, teoricamente você poderia fazer isso em %4$d semanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para atingir sua meta, você precisa gastar aproximadamente %1$.2f %2$@ por semana %3$@. É muito relaxante, teoricamente você poderia fazer isso em %4$d semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы достичь цели, вам нужно примерно %1$.2f %2$@ в неделю, чтобы %3$@. Это очень расслабленный темп, теоретически вы могли бы достичь этого за %4$d недель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinize ulaşmak için haftada yaklaşık %1$.2f %2$@ %3$@ harcamanız gerekir. Çok rahatlatıcı, teorik olarak bunu %4$d haftada yapabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了实现您的目标，您需要每周花费大约 %1$.2f %2$@ %3$@。这非常放松，理论上您可以在 %4$d 周内完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為達到目標，您每週需要 %1$.2f %2$@ %3$@。這非常輕鬆，理論上您也可以在 %4$d 週內實現。"
          }
        }
      }
    },

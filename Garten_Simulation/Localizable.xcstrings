    "assessment.health.q15.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich betrachte meinen Körper als Maschine. Er muss reibungslos funktionieren, damit ich meine Ziele zerstören kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I view my body as a machine. It needs to function smoothly so I can destroy my targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veo mi cuerpo como una máquina. Tiene que funcionar sin problemas para poder destruir mis objetivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je considère mon corps comme une machine. Il doit fonctionner correctement pour que je puisse détruire mes cibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं अपने शरीर को एक मशीन के रूप में देखता हूं। इसे सुचारू रूप से कार्य करने की आवश्यकता है ताकि मैं अपने लक्ष्यों को नष्ट कर सकूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considero il mio corpo come una macchina. Deve funzionare senza intoppi così posso distruggere i miei obiettivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は自分の体を機械として見ています。ターゲットを破壊できるように、スムーズに機能する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 내 몸을 기계로 본다. 목표물을 파괴하려면 원활하게 작동해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik zie mijn lichaam als een machine. Het moet soepel functioneren, zodat ik mijn doelen kan vernietigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postrzegam swoje ciało jako maszynę. Musi działać sprawnie, żebym mógł niszczyć cele."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vejo meu corpo como uma máquina. Ele precisa funcionar sem problemas para que eu possa destruir meus alvos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я рассматриваю своё тело как машину. Оно должно работать без сбоев, чтобы я мог уничтожать свои цели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vücudumu bir makine gibi görüyorum. Hedeflerimi yok edebilmem için sorunsuz çalışması gerekiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我把我的身体看作一台机器。它必须顺利运作，这样我才能摧毁我的目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

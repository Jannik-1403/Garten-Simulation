    "paywall.feature.focus_sounds.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend den Alltag aus. Wissenschaftlich fundierte Klänge bringen dein Gehirn sofort in den Flow-State."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune out the everyday. Scientifically backed sounds instantly bring your brain into a flow state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconéctate del día a día. Sonidos respaldados por la ciencia llevan tu cerebro al instante al estado de flow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais abstraction du quotidien. Des sons scientifiquement prouvés plongent ton cerveau dans un état de flow."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोजमर्रा की जिंदगी को अवरुद्ध करें। वैज्ञानिक रूप से आधारित ध्वनियाँ आपके मस्तिष्क को तुरंत प्रवाह की स्थिति में ला देती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludi la quotidianità. Suoni scientificamente provati portano il tuo cervello direttamente nel flow state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日常を遮断しましょう。科学的に裏付けられた音が、脳を即座にフロー状態に導きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상을 차단하세요. 과학적으로 입증된 소리가 당신의 뇌를 즉시 플로우 상태로 이끕니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de dagelijkse drukte buiten. Wetenschappelijk onderbouwde geluiden brengen je brein direct in een flowstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłącz się od codzienności. Dźwięki oparte na nauce natychmiast wprowadzają twój mózg w stan flow."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue-se do cotidiano. Sons com base científica trazem seu cérebro instantaneamente para o estado de flow."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue-se do cotidiano. Sons com base científica trazem seu cérebro instantaneamente para o estado de flow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отгородись от повседневной жизни. Научно обоснованные звуки мгновенно погружают твой мозг в состояние потока."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündelik hayatı dışarıda bırak. Bilimsel olarak desteklenen sesler beynini anında akış durumuna getirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摆脱日常喧嚣。科学的声音能立即让您的大脑进入心流状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖日常生活。基於科學的聲音立即讓您的大腦進入流動狀態。"
          }
        }
      }
    },

    "backup_fehler_format": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden. Bitte stelle sicher, dass es sich um eine g\u00fcltige .gartensave-Datei handelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read. Please make sure it is a valid .gartensave file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no pudo leerse. Aseg\u00farate de que sea un archivo .gartensave v\u00e1lido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu \u00eatre lu. Assure-toi qu'il s'agit d'un fichier .gartensave valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093c\u093e\u0907\u0932 \u092a\u0922\u093c\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0940. \u0915\u0943\u092a\u092f\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u092f\u0939 \u090f\u0915 \u0935\u0948\u0927 .gartensave \u092b\u093c\u093e\u0907\u0932 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read. Please make sure it is a valid .gartensave file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30a4\u30eb\u3092\u8aad\u307f\u53d6\u308c\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u6709\u52b9\u306a .gartensave \u30d5\u30a1\u30a4\u30eb\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud30c\uc77c\uc744 \uc77d\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc720\ud6a8\ud55c .gartensave \ud30c\uc77c\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kon niet worden gelezen. Zorg ervoor dat het een geldig .gartensave-bestand is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna odczyta\u0107 pliku. Upewnij si\u0119, \u017ce jest to prawid\u0142owy plik .gartensave."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro n\u00e3o p\u00f4de ser lido. Certifica-te de que \u00e9 um ficheiro .gartensave v\u00e1lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u044d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0444\u0430\u0439\u043b .gartensave."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya okunamad\u0131. L\u00fctfen ge\u00e7erli bir .gartensave dosyas\u0131 oldu\u011fundan emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u8bfb\u53d6\u6587\u4ef6\u3002\u8bf7\u786e\u4fdd\u8fd9\u662f\u4e00\u4e2a\u6709\u6548\u7684 .gartensave \u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {

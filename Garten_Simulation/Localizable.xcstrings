          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj picie wody lub herbaty zamiast napojów alkoholowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a beber água ou chá em vez de bebidas alcoólicas."
          }

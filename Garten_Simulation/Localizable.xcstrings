    "dopamine_story_s3_sub": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast anderthalb Monate nur am Handy. Bei 16- bis 29-Jährigen sind es mit 216 Minuten sogar rund 55 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost a month and a half just on the phone. For 16 to 29-year-olds, it's even around 55 days with 216 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi un mes y medio solo en el teléfono. Para los de 16 a 29 años, son incluso unos 55 días con 216 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près d'un mois et demi uniquement sur le téléphone. Chez les 16-29 ans, c'est même environ 55 jours avec 216 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग डेढ़ महीने सिर्फ फोन पर। 16 से 29 साल के बच्चों के लिए, यह 216 मिनट के साथ लगभग 55 दिन है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi un mese e mezzo solo al telefono. Per la fascia 16-29 anni, sono addirittura circa 55 giorni con 216 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホだけで約1ヶ月半。16〜29歳では216分で約55日にもなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트폰에서만 약 한 달 반. 16-29세의 경우 216분으로 약 55일에 달합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna anderhalve maand alleen op de telefoon. Bij 16- tot 29-jarigen is dat zelfs zo'n 55 dagen met 216 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie półtora miesiąca tylko na telefonie. Wśród 16-29 latków to z 216 minutami nawet około 55 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase um mês e meio apenas no telemóvel. Para jovens de 16 a 29 anos, são mesmo cerca de 55 dias com 216 minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase um mês e meio apenas no celular. Para jovens de 16 a 29 anos, são cerca de 55 dias com 216 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти полтора месяца только на телефоне. У 16-29-летних это 216 минут, что составляет около 55 дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece telefonda neredeyse bir buçuk ay. 16-29 yaş arası için 216 dakika ile bu yaklaşık 55 gün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几乎有一个半月时间仅仅花在手机上。对于 16 至 29 岁的年轻人来说，每天 216 分钟甚至相当于 55 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾乎有一個半月時間僅僅花在手機上。對於 16 至 29 歲的年輕人來說，每天 216 分鐘甚至相當於 55 天。"
          }
        }
      }
    },

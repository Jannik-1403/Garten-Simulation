    "intent.export_summary.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert eine Zusammenfassung des heutigen Fortschritts für externe Tools wie KI-Coaches."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports a summary of today's progress for external tools like AI coaches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta un resumen del progreso de hoy para herramientas externas como entrenadores de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte un résumé des progrès d'aujourd'hui pour des outils externes comme les coachs IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta un riepilogo dei progressi odierni per strumenti esterni come i coach IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIコーチなどの外部ツール用に本日の進捗概要をエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 코치와 같은 외부 도구를 위해 오늘의 진행 상황 요약을 내보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteert een samenvatting van de voortgang van vandaag voor externe tools zoals AI-coaches."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuje podsumowanie dzisiejszych postępów dla zewnętrznych narzędzi, takich jak trenerzy AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta um resumo do progresso de hoje para ferramentas externas, como treinadores de IA."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka koçları gibi harici araçlar için bugünün ilerleme özetini dışa aktarır."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई कोच जैसे बाहरी उपकरणों के लिए आज की प्रगति का सारांश निर्यात करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta um resumo do progresso de hoje para ferramentas externas, como coaches de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортирует сводку сегодняшнего прогресса для внешних инструментов, таких как ИИ-коучи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出今日进度的摘要，供 AI 教练等外部工具使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

    "notification.body.generic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht: %@ wartet auf dich!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget: %@ is waiting for you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No olvides: ¡%@ te espera!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oubliez pas : %@ vous attend !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "याद रखें: %@ आपका इंतजार कर रहा है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare: %@ ti sta aspettando!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "忘れないでください：%@があなたを待っています！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잊지 마세요: %@이(가) 당신을 기다리고 있습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet niet: %@ wacht op je!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapomnij: %@ czeka na Ciebie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não esqueças: %@ está à tua espera!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não esqueça: %@ está esperando por você!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забудьте: %@ ждет вас!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unutma: %@ seni bekliyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别忘了：%@在等你！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別忘了：%@在等你！"
          }
        }

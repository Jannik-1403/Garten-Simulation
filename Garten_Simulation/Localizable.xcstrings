    "igel_name_confirm_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f6chtest du deinen Igel wirklich in '%@' umbenennen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to rename your hedgehog to '%@'?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfRealmente quieres renombrar a tu erizo a '%@'?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu vraiment renommer ton h\u00e9risson en '%@' ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0905\u092a\u0928\u0947 \u0939\u0947\u091c\u0939\u094b\u0917 \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0915\u0930 '%@' \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero rinominare il tuo riccio in '%@'?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5f53\u306b\u30cf\u30ea\u30cd\u30ba\u30df\u306e\u540d\u524d\u3092\"%@\"\u306b\u5909\u66f4\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\ub9d0\ub85c \uace0\uc2b4\ub3c4\uce58 \uc774\ub984\uc744 '%@'(\uc73c)\ub85c \ubc14\uafb8\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je je egel echt hernoemen naar '%@'?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz zmieni\u0107 nazw\u0119 swojego je\u017ca na \u201e%@\u201d?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres mesmo renomear o teu ouri\u00e7o para '%@'?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u0440\u0430\u0432\u0434\u0430 \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0435\u0433\u043e \u0435\u0436\u0438\u043a\u0430 \u0432 '%@'?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirpinizi ger\u00e7ekten '%@' olarak yeniden adland\u0131rmak istiyor musunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u786e\u5b9a\u8981\u5c06\u4f60\u7684\u523a\u732c\u91cd\u547d\u540d\u4e3a\u201c%@\u201d\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u78ba\u5b9a\u8981\u5c07\u523a\u875f\u91cd\u547d\u540d\u70ba\u201c%@\u201d\u55ce\uff1f"
          }
        }
      }
    },

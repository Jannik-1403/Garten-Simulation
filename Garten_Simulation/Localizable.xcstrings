    "prog_meditation_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne deine Wahrnehmung. Fixiere dich nicht auf den Atem, sondern lausche den Geräuschen im Raum, ohne sie zu bewerten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your perception. Don't fixate on the breath, but listen to the sounds in the room without judging them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tu percepción. No te obsesiones con la respiración, escucha los sonidos de la habitación sin juzgarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez votre perception. Ne vous concentrez pas sur la respiration, mais écoutez les sons de la pièce sans les juger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी धारणा खोलें. सांसों पर ध्यान केंद्रित न करें, बल्कि कमरे में होने वाली आवाज़ों को परखे बिना सुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la tua percezione. Non fissarti sul respiro, ma ascolta i suoni nella stanza senza giudicarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識をオープンにしてください。呼吸に固執せず、部屋の音を判断せずに聞いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 인식을 열어보세요. 호흡에 집착하지 말고 방 안의 소리를 판단하지 말고 들어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open je perceptie. Fixeer je niet op de ademhaling, maar luister naar de geluiden in de kamer zonder ze te beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz swoją percepcję. Nie skupiaj się na oddechu, ale słuchaj dźwięków w pomieszczeniu, nie oceniając ich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra sua percepção. Não se fixe na respiração, mas ouça os sons da sala sem julgá-los."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra sua percepção. Não se fixe na respiração, mas ouça os sons da sala sem julgá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте свое восприятие. Не зацикливайтесь на дыхании, а слушайте звуки в комнате, не оценивая их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algınızı açın. Nefesinize odaklanmayın, odadaki sesleri yargılamadan dinleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你的感知。不要专注于呼吸，而要倾听房间里的声音，不要评判它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開你的感知。不要專注於呼吸，而要傾聽房間裡的聲音，不要評判它們。"
          }
        }
      }
    },

          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud754\ub4e4\ub9ac\uc9c0 \uc54a\ub294 \uac83"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

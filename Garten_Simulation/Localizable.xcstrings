    "prog_screentime_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Timer im Handy heute abläuft, klicke NICHT auf '15 Minuten ignorieren'. Die App bleibt zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the timer on your phone expires today, DO NOT click 'Ignore 15 minutes'. The app remains closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el temporizador de su teléfono expira hoy, NO haga clic en \"Ignorar 15 minutos\". La aplicación permanece cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le minuteur de votre téléphone expire aujourd'hui, NE cliquez PAS sur « Ignorer 15 minutes ». L'application reste fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपके फ़ोन का टाइमर आज समाप्त हो रहा है, तो '15 मिनट अनदेखा करें' पर क्लिक न करें। ऐप बंद रहता है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il timer del tuo telefono scade oggi, NON fare clic su \"Ignora 15 minuti\". L'app rimane chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話のタイマーが今日切れる場合は、(15 分を無視) をクリックしないでください。アプリは閉じたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 휴대폰의 타이머가 만료된 경우 '15분 무시'를 클릭하지 마세요. 앱이 닫힌 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de timer op uw telefoon vandaag afloopt, klik dan NIET op '15 minuten negeren'. De app blijft gesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli licznik czasu w Twoim telefonie wygasa dzisiaj, NIE klikaj „Ignoruj ​​15 minut”. Aplikacja pozostaje zamknięta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o cronômetro do seu telefone expirar hoje, NÃO clique em 'Ignorar 15 minutos'. O aplicativo permanece fechado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o cronômetro do seu telefone expirar hoje, NÃO clique em 'Ignorar 15 minutos'. O aplicativo permanece fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если таймер на вашем телефоне истекает сегодня, НЕ НАЖИМАЙТЕ «Игнорировать 15 минут». Приложение остается закрытым."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzdaki zamanlayıcının süresi bugün dolarsa '15 dakikayı yoksay' seçeneğini tıklamayın. Uygulama kapalı kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您手机上的计时器今天到期，请勿点击“忽略 15 分钟”。该应用程序保持关闭状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您手機上的計時器今天到期，請勿點選「忽略 15 分鐘」。該應用程式保持關閉狀態。"
          }
        }
      }
    },

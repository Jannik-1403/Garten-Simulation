    "trash.luxus_uhr.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche Luxus-Marken aus deinen Social-Media-Feeds."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove luxury brands from your social media feeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las marcas de lujo de tus feeds de redes sociales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les marques de luxe de tes fils d'actualité des réseaux sociaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सोशल मीडिया फ़ीड से लक्ज़री ब्रांड्स हटा दें।"
          }
        },
        "it": {

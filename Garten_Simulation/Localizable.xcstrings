    "prog_coldshower_d1_t2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausatmung bewusst verlangsamt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exhalation consciously slowed down"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exhalación se ralentizó conscientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expiration consciemment ralentie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साँस छोड़ना जानबूझकर धीमा हो गया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espirazione è stata consapevolmente rallentata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼気を意識的に遅くした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호기가 의식적으로 느려짐"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitademing wordt bewust vertraagd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydech świadomie zwalniany"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A expiração desacelerou conscientemente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A expiração desacelerou conscientemente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдох сознательно замедлен"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nefes verme bilinçli olarak yavaşladı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "呼气有意识地减慢"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "呼氣有意識地減慢"
          }
        }
      }
    },
    "prog_coldshower_d1_title": {
      "extractionState": "manual",
      "localizations": {

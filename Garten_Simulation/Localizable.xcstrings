    "assessment.growth.profile.traeumer.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schwachpunkt ist die Umsetzung. Du planst viel, kommst aber nicht ins Tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weak point is implementation. You plan a lot, but don't get into action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su punto débil es la implementación. Planeas mucho, pero no entras en acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre point faible est la mise en œuvre. Vous planifiez beaucoup, mais ne passez pas à l’action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo punto debole è l'implementazione. Pianifichi molto, ma non entri in azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの弱点は実装です。いろいろ計画を立てているのに、なかなか行動に移さない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 약점은 구현입니다. 계획은 많이 세우지만 실행에 옮기지는 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zwakke punt is de implementatie. Je plant veel, maar komt niet tot actie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoim słabym punktem jest wdrożenie. Dużo planujesz, ale nie przystępujesz do działania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ponto fraco é a implementação. Você planeja muito, mas não entra em ação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zayıf noktanız uygulamadır. Çok fazla plan yapıyorsunuz ama harekete geçmiyorsunuz."
          }
        }
      }
    },
    "assessment.growth.profile.traeumer.title": {
      "comment": "",
      "extractionState": "manual",

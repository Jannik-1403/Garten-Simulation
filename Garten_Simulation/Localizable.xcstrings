    "prog_teeth_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spüle Zahnpasta am Ende NICHT mit Wasser aus. Spucke nur aus. Das Fluorid muss einwirken!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DO NOT rinse toothpaste with water at the end. Just spit. The fluoride has to work!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NO enjuague la pasta de dientes con agua al final. Sólo escupe. ¡El fluoruro tiene que funcionar!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NE PAS rincer le dentifrice avec de l'eau à la fin. Crachez simplement. Le fluorure doit fonctionner !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूथपेस्ट को अंत में पानी से न धोएं। बस थूक दो. फ्लोराइड को काम करना होगा!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NON sciacquare il dentifricio con acqua alla fine. Basta sputare. Il fluoro deve funzionare!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯磨き粉を最後に水で洗い流さないでください。ただ唾を吐きます。フッ素が効くはずですよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막에 치약을 물로 헹구지 마십시오. 그냥 침을 뱉으세요. 불소가 효과가 있어야 합니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoel de tandpasta aan het eind NIET af met water. Gewoon spugen. De fluoride moet werken!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NIE spłukuj pasty do zębów wodą na koniec. Po prostu pluj. Fluor musi działać!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO enxágue a pasta de dente com água no final. Apenas cuspa. O flúor tem que funcionar!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO enxágue a pasta de dente com água no final. Apenas cuspa. O flúor tem que funcionar!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НЕ смывайте зубную пасту водой в конце. Просто плюй. Фтор должен работать!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diş macununu sonunda suyla durulamayın. Sadece tükür. Florürün işe yaraması gerekiyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后请勿用水冲洗牙膏。只是吐口水。氟化物必须起作用！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後請勿用水沖洗牙膏。只是吐口水。氟化物必須起作用！"
          }
        }
      }
    },

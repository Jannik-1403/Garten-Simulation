          "stringUnit": {
            "state": "translated",
            "value": "트래커를 삭제하시겠습니까? 진행 상황이 손실됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je je tracker wilt verwijderen? Je voortgang gaat verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć swój tracker? Twój postęp zostanie utracony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir seu rastreador? Seu progresso será perdido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir seu rastreador? Seu progresso será perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты уверен, что хочешь удалить свой трекер? Твой прогресс при этом будет утерян."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleyicinizi silmek istediğinizden emin misiniz? İlerlemeniz kaybolacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要删除你的追踪器吗？你的进度将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要刪除您的追蹤器嗎？你的進步將會失去。"
          }
        }
      }
    },

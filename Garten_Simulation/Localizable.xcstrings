    "pfad_schwierigkeit_fortgeschritten_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ambitionierte Gärtner. Eine ausgewogene Mischung aus Herausforderung und Spaß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For ambitious gardeners. A balanced mix of challenge and fun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para jardineros ambiciosos. Una mezcla equilibrada de desafío y diversión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les jardiniers ambitieux. Un mélange équilibré de défi et de plaisir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महत्वाकांक्षी बागवानों के लिए. चुनौती और मनोरंजन का संतुलित मिश्रण।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per giardinieri ambiziosi. Un mix equilibrato di sfida e divertimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "野心的な庭師向け。挑戦と楽しみのバランスの取れた組み合わせ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야심찬 정원사를 위한 제품입니다. 도전과 재미의 균형 잡힌 조합."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor ambitieuze tuiniers. Een uitgebalanceerde mix van uitdaging en plezier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla ambitnych ogrodników. Zrównoważona mieszanka wyzwań i zabawy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para jardineiros ambiciosos. Uma mistura equilibrada de desafio e diversão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для амбициозных садоводов. Сбалансированная смесь вызова и удовольствия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hırslı bahçıvanlar için. Mücadele ve eğlencenin dengeli bir karışımı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适合有抱负的园丁。挑战与乐趣的均衡结合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於雄心勃勃的園丁來說。挑戰與樂趣的平衡結合。"
          }
        }
      }
    },
    "pfad_schwierigkeit_hinweis" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schwierigkeit beeinflusst die tägliche Aufgabenmenge und deinen XP-Gewinn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The difficulty level affects your daily task amount and your XP gain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nivel de dificultad afecta la cantidad de tareas diarias y tu ganancia de XP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau de difficulté influence la quantité de tâches quotidiennes et tes gains de XP."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कठिनाई कार्यों की दैनिक मात्रा और आपके XP लाभ को प्रभावित करती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello di difficoltà influisce sul numero di attività giornaliere e sul guadagno di XP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難易度は、毎日のタスク量と獲得 XP に影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",

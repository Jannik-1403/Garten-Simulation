    "assessment.lifestyle.q9.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich schaue ihm in die Augen und sage 'Nein', ohne mich zu rechtfertigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I look him in the eyes and say 'No' without justifying myself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo miro a los ojos y digo 'No' sin justificarme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je le regarde dans les yeux et dis « Non » sans me justifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं उसकी आंखों में देखता हूं और खुद को सही ठहराए बिना 'नहीं' कहता हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo guardo negli occhi e dico \"No\" senza giustificarmi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は彼の目を見て、自分を正当化することなく「ノー」と言います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 그의 눈을 바라보며 내 자신을 정당화하지 않고 '아니요'라고 말합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

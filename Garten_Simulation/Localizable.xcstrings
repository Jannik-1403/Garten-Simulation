    "weed_popup_body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unkraut blockiert deine Pflanzen – nur %1$@ XP pro Gießen. Erledige %2$d Gewohnheiten für das aktuelle Unkraut – oder zahle Coins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weeds block your plants – only %1$@ XP per watering. Complete %2$d habits for the current weed – or pay coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las malas hierbas bloquean tus plantas – solo %1$@ de XP por riego. Completa %2$d hábitos para la actual – o paga monedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mauvaises herbes bloquent tes plantes – seulement %1$@ d'XP par arrosage. Accomplis %2$d habitudes pour celle en cours – ou paye des pièces."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेवजह घास आपकी पौधों को रोक रही है – केवल%1$@XP प्रति पानी देने पर। वर्तमान बेवजह घास के लिए%2$dआदतें पूरी करें – या सिक्के चुकाएं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le erbacce bloccano le tue piante – solo %1$@ XP per annaffiatura. Completa %2$d abitudini per quella attuale – o paga monete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雑草が植物の邪魔をします - 水やりあたりの XP はわずか %1$@ です。現在の大麻の %2$d 個の習慣を完了するか、コインを支払います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잡초가 식물을 막습니다. 물을 뿌릴 때마다 %1$@ XP만 제공됩니다. 현재 잡초에 대해 %2$d개의 습관을 완료하거나 코인을 지불하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onkruid blokkeert je planten – slechts %1$@ XP per gietbeurt. Voltooi %2$d gewoonten voor de huidige wiet – of betaal munten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chwasty blokują Twoje rośliny – tylko %1$@ XP na podlewanie. Ukończ %2$d nawyków dla bieżącego zioła – lub zapłać monetami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ervas daninhas bloqueiam as tuas plantas – só %1$@ de XP por rega. Completa %2$d hábitos para a atual – ou paga moedas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сорняки блокируют ваши растения — всего%1$@XP за полив. Выполните привычки%2$dдля текущей травки — или заплатите монеты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yabani otlar bitkilerinizi engeller; sulama başına yalnızca %1$@ XP. Mevcut ot için %2$d alışkanlığı tamamlayın veya jeton ödeyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "杂草会堵塞您的植物 - 每次浇水只需使用%1$@XP。完成当前杂草的%2$d习惯 - 或支付硬币。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雜草會堵塞您的植物 - 每次澆水只需使用%1$@XP。完成當前雜草的%2$d習慣 - 或支付硬幣。"
          }
        }
      }
    },

    "screenTime.suggestions.instruction" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple erlaubt aus Datenschutzgründen keine automatische Sperrung. Bitte tippe bei 'Für immer blockieren' auf Hinzufügen, suche nach %@ und wähle es aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For privacy reasons, Apple does not allow automatic blocking. Please tap Add under 'Block permanently', search for %@ and select it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por razones de privacidad, Apple no permite el bloqueo automático. Toca Añadir en 'Bloquear permanentemente', busca %@ y selecciónalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour des raisons de confidentialité, Apple n'autorise pas le blocage automatique. Veuillez appuyer sur Ajouter sous 'Bloquer définitivement', rechercher %@ et le sélectionner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple गोपनीयता कारणों से स्वचालित अवरोधन की अनुमति नहीं देता है। कृपया 'ब्लॉक फॉरएवर' के अंतर्गत जोड़ें पर टैप करें,%@खोजें और उसे चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per motivi di privacy, Apple non consente il blocco automatico. Tocca Aggiungi in 'Blocca permanentemente', cerca %@ e selezionalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー保護のため、Appleは自動ブロックを許可していません。「永久にブロック」の下の「追加」をタップし、%@を検索して選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 정보 보호를 위해 Apple은 자동 차단을 허용하지 않습니다. '영구적으로 차단' 아래의 추가를 탭하고 %@을(를) 검색하여 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om privacyredenen staat Apple automatische blokkering niet toe. Tik op Toevoegen onder 'Permanent blokkeren', zoek naar %@ en selecteer het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze względów prywatności Apple nie zezwala na automatyczne blokowanie. Stuknij Dodaj pod 'Zablokuj na stałe', wyszukaj %@ i wybierz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por motivos de privacidade, a Apple não permite o bloqueio automático. Toque em Adicionar em 'Bloquear permanentemente', procure %@ e selecione-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не разрешает автоматическую блокировку по соображениям конфиденциальности. Нажмите «Добавить» в разделе «Заблокировать навсегда», найдите%@и выберите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik nedenlerinden dolayı, Apple otomatik engellemeye izin vermez. Lütfen 'Kalıcı olarak engelle' altındaki Ekle'ye dokunun, %@ uygulamasını arayın ve seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出于隐私原因，Apple 不允许自动阻止。请点击“永久阻止”下的添加，搜索%@并选择它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出於隱私原因，Apple 不允許自動封鎖。請點擊「永久封鎖」下的新增，搜尋%@並選擇它。"
          }
        }
      }
    },

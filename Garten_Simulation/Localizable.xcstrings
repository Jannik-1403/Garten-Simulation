    "settings.reset.final.message" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles ist dann unwiderruflich weg. Die App startet danach komplett neu mit dem Onboarding."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything will be gone forever. The app will restart from the onboarding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo desaparecerá para siempre. La aplicación se reiniciará desde el principio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout disparaîtra pour toujours. L'application redémarrera depuis le début."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ तब अनिवार्य रूप से चला जाता है। इसके बाद ऐप पूरी तरह से नए सिरे से ऑनबोर्डिंग के साथ शुरू होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto andrà perso per sempre. L'app si riavvierà dall'inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべては永遠に消えてしまいます。アプリはオンボーディングから再起動されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것이 영원히 사라질 것입니다. 온보딩부터 앱이 다시 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles zal voor altijd verdwenen zijn. De app wordt opnieuw opgestart vanaf de onboarding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zniknie na zawsze. Aplikacja uruchomi się ponownie po wejściu na pokład."

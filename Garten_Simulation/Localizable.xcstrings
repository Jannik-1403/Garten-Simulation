    "weekly_teaser.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herzlichen Glückwunsch! Du hast die Woche erfolgreich überstanden. Lass uns schauen, wie du abgeschnitten hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Congratulations! You have successfully survived the week. Let's see how you did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Felicidades! Has sobrevivido a la semana con éxito. Veamos cómo te fue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Félicitations ! Tu as survécu à la semaine avec succès. Voyons tes résultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बधाई हो! आपने सफलतापूर्वक सप्ताह पूरा कर लिया है। आइए देखें कि आपने कैसा प्रदर्शन किया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Congratulazioni! Hai superato la settimana con successo. Vediamo come è andata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おめでとうございます！一週間を無事に乗り切りました。結果を見てみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축하합니다! 한 주를 무사히 넘겼습니다. 결과를 확인해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefeliciteerd! Je hebt de week met succes overleefd. Laten we kijken hoe je het hebt gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratulacje! Z powodzeniem przetrwałeś tydzień. Zobaczmy, jak Ci poszło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parabéns! Você sobreviveu à semana com sucesso. Vamos ver como você se saiu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parabéns! Você sobreviveu à semana com sucesso. Vamos ver como você se saiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздравляем! Вы успешно пережили эту неделю. Давайте посмотрим на ваши результаты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tebrikler! Haftayı başarıyla atlattınız. Nasıl performans gösterdiğinize bakalım."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恭喜！您已成功度过本周。让我们看看您的表现如何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恭喜！您已成功度過本週。讓我們看看您的表現如何。"

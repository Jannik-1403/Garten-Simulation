    "support.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe dein Anliegen so genau wie möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your request as precisely as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe tu solicitud con la mayor precisión posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ta demande aussi précisément que possible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Anliegen को यथासंभव सटीक रूप से बताएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la tua richiesta nel modo più dettagliato possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストをできるだけ正確に説明してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 요청을 가능한 한 정확하게 설명하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf uw verzoek zo nauwkeurig mogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz swoją prośbę możliwie najdokładniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve o teu pedido com o máximo de detalhe possível."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve o teu pedido com o máximo de detalhe possível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите вашу проблему как можно точнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talebinizi mümkün olduğu kadar net bir şekilde açıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能准确地描述您的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "盡可能準確地描述您的請求。"
          }
        }
      }
    },

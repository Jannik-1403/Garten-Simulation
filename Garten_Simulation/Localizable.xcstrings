    "gameover.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Pflanzen sind vertrocknet. Deine Coins und Items bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All plants have dried out. Your coins and items are safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las plantas se han secado. Tus monedas y objetos están a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les plantes ont séché. Tes pièces et objets sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारे पौधे सूख गये हैं. आपके सिक्के और वस्तुएं बरकरार रखी जाएंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le piante si sono seccate. Le tue monete e i tuoi oggetti sono al sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての植物が枯れてしまいました。コインやアイテムは安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 식물이 말랐습니다. 당신의 코인과 아이템은 안전합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planten zijn uitgedroogd. Uw munten en items zijn veilig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie rośliny uschły. Twoje monety i przedmioty są bezpieczne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas secaram. As tuas moedas e itens estão seguros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas secaram. As tuas moedas e itens estão seguros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все растения высохли. Твои монеты и предметы сохраняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün bitkiler kurudu. Madeni paralarınız ve eşyalarınız güvende."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有植物都枯萎了。您的金币和物品将保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有植物都乾枯了。您的硬幣和物品將被保留。"
          }
        }
      }
    },

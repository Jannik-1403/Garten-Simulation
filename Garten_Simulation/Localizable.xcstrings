            "state": "translated",
            "value": "轻柔的压力"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕柔的壓力"
          }
        }
      }
    },
    "prog_teeth_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Innenseiten der Unterkiefer-Schneidezähne verkalken am schnellsten. Fokussiere dich heute besonders auf diese Stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The insides of the lower jaw incisors calcify the fastest. Focus particularly on these areas today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interior de los incisivos de la mandíbula inferior es el que se calcifica más rápido. Concéntrese particularmente en estas áreas hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intérieur des incisives de la mâchoire inférieure se calcifie le plus rapidement. Concentrez-vous particulièrement sur ces domaines aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निचले जबड़े के कृन्तकों के अंदरूनी भाग सबसे तेजी से कैल्सीकृत होते हैं। आज इन क्षेत्रों पर विशेष रूप से फोकस करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte interna degli incisivi della mascella inferiore calcifica più velocemente. Concentratevi particolarmente su queste aree oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下顎の切歯の内側が最も早く石灰化します。今日は特にこれらの分野に焦点を当ててください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래턱 앞니 안쪽이 가장 빨리 석회화됩니다. 오늘은 특히 이 분야에 집중하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De binnenkant van de snijtanden van de onderkaak verkalkt het snelst. Concentreer u vandaag vooral op deze gebieden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najszybciej zwapniają wnętrze siekaczy żuchwy. Skoncentruj się dzisiaj szczególnie na tych obszarach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O interior dos incisivos da mandíbula inferior calcifica mais rapidamente. Concentre-se particularmente nessas áreas hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O interior dos incisivos da mandíbula inferior calcifica mais rapidamente. Concentre-se particularmente nessas áreas hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрее всего кальцинируется внутренняя часть резцов нижней челюсти. Сегодня уделите особое внимание этим областям."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt çene kesici dişlerinin iç kısımları en hızlı kireçlenir. Bugün özellikle bu alanlara odaklanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下颌门牙的内部钙化最快。今天要特别关注这些领域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下顎門牙的內部鈣化最快。今天要特別關注這些領域。"
          }
        }
      }
    },
    "prog_teeth_d4_t1": {
      "extractionState": "manual",
      "localizations": {

    "item.gluecks_segen.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Segen, der 24h lang das Wachstum aller Pflanzen verdoppelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blessing that doubles the growth of all plants for 24h."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bendici\u00f3n que duplica el crecimiento de todas las plantas durante 24h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une b\u00e9n\u00e9diction qui double la croissance de toutes les plantes pendant 24h."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0910\u0938\u093e \u0935\u0930\u0926\u093e\u0928 \u091c\u094b 24 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u0938\u092d\u0940 \u092a\u094c\u0927\u094b\u0902 \u0915\u0940 \u0935\u0943\u0926\u094d\u0927\u093f \u0915\u094b \u0926\u094b\u0917\u0941\u0928\u093e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A blessing that doubles the growth of all plants for 24h."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24\u6642\u9593\u3059\u3079\u3066\u306e\u690d\u7269\u306e\u6210\u9577\u30922\u500d\u306b\u3059\u308b\u795d\u798f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24\uc2dc\uac04 \ub3d9\uc548 \ubaa8\ub4e0 \uc2dd\ubb3c\uc758 \uc131\uc7a5\uc774 \ub450 \ubc30\ub85c \ub298\uc5b4\ub098\ub294 \ucd95\ubcf5\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zegen die de groei van alle planten 24 uur lang verdubbelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0142ogos\u0142awie\u0144stwo podwajaj\u0105ce wzrost wszystkich ro\u015blin na 24h."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma b\u00ean\u00e7\u00e3o que duplica o crescimento de todas as plantas durante 24h."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24 \u0447\u0430\u0441\u043e\u0432 \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442 \u0440\u043e\u0441\u0442 \u0432\u0441\u0435\u0445 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saat boyunca t\u00fcm bitkilerin b\u00fcy\u00fcmesini ikiye katlayan bir nimet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u4e2a\u795d\u798f\uff0c\u572824\u5c0f\u65f6\u5185\u4f7f\u6240\u6709\u690d\u7269\u7684\u751f\u957f\u901f\u5ea6\u7ffb\u500d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u6240\u6709\u690d\u7269\u5728 24 \u5c0f\u6642\u5167\u751f\u9577\u7ffb\u500d\u7684\u795d\u798f\u3002"
          }
        }
      }
    },

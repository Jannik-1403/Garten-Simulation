        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva o teu progresso como ficheiro .gartensave. Podes importá-lo noutros dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохрани свой прогресс в файл .gartensave. Ты можешь импортировать его на других устройствах."

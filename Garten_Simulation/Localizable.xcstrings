    "level_unlock_meister_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alles erreicht. Alle Inhalte sind freigeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached the top. All content is unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has llegado a la cima. Todo el contenido est\u00e1 desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as tout accompli. Tout le contenu est d\u00e9bloqu\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947 \u0938\u092c \u0915\u0941\u091b \u0939\u093e\u0938\u093f\u0932 \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948. \u0938\u092d\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0905\u0928\u0932\u0949\u0915 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached the top. All content is unlocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9802\u4e0a\u306b\u5230\u9054\u3057\u307e\u3057\u305f\u3002\u3059\u3079\u3066\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u30ed\u30c3\u30af\u304c\u89e3\u9664\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc815\uc0c1\uc5d0 \ub3c4\ub2ec\ud588\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \ucf58\ud150\uce20\uac00 \uc7a0\uae08 \ud574\uc81c\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de top bereikt. Alle inhoud is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotar\u0142e\u015b na sam szczyt. Ca\u0142a zawarto\u015b\u0107 jest odblokowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegaste ao topo. Todo o conte\u00fado est\u00e1 desbloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0434\u043e\u0441\u0442\u0438\u0433 \u0432\u0441\u0435\u0433\u043e. \u0412\u0441\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zirveye ula\u015ft\u0131n\u0131z. T\u00fcm i\u00e7eri\u011fin kilidi a\u00e7\u0131ld\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u8fbe\u6210\u6240\u6709\u6210\u5c31\u3002\u6240\u6709\u5185\u5bb9\u5747\u5df2\u89e3\u9501\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7d93\u6210\u5c31\u4e86\u4e00\u5207\u3002\u6240\u6709\u5167\u5bb9\u5747\u5df2\u89e3\u9396\u3002"
          }
        }
      }
    },

            "state": "translated",
            "value": "De excuuszoeker"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poszukiwacz wym\u00f3wek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O buscador de desculpas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0449\u0443\u0449\u0438\u0439 \u043e\u0442\u0433\u043e\u0432\u043e\u0440\u043a\u0438"
          }
        },
        "tr": {

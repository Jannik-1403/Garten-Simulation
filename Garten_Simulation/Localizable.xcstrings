    "weekly_report.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Plane kleine, feste Fokus-Blöcke (z.B. 25 Minuten) ein, anstatt zu versuchen, stundenlang durchzuarbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Schedule small, fixed focus blocks (e.g. 25 minutes) instead of trying to work for hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Planifica bloques de enfoque pequeños y fijos (p.ej. 25 minutos) en lugar de intentar trabajar durante horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil: Planifie de petits blocs de concentration fixes (p.ex. 25 minutes) plutôt que d'essayer de travailler pendant des heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: छोटे, निश्चित फोकस-ब्लॉक्स (जैसे 25 मिनट) योजना बनाएं, बजाय इसके कि घंटों तक लगातार काम करने की कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Pianifica piccoli blocchi di concentrazione fissi (ad es. 25 minuti) invece di cercare di lavorare per ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：何時間も作業しようとするのではなく、小さな固定の集中ブロック（例：25分）を計画しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 몇 시간 동안 작업하려 하지 말고 작은 고정 집중 블록(예: 25분)을 계획하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Plan kleine, vaste focusblokken (bijv. 25 minuten) in plaats van te proberen urenlang te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Zaplanuj małe, stałe bloki skupienia (np. 25 minut) zamiast próbować pracować przez wiele godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Planeje blocos de foco pequenos e fixos (ex: 25 minutos) em vez de tentar trabalhar por horas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Planeje blocos de foco pequenos e fixos (ex: 25 minutos) em vez de tentar trabalhar por horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: планируйте небольшие фиксированные блоки внимания (например, 25 минут) вместо того, чтобы пытаться работать часами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Saatler boyunca çalışmaya çalışmak yerine küçük, sabit odak blokları (ör. 25 dakika) planla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：计划小的、固定的焦点（例如 25 分钟），而不是尝试工作几个小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：規劃小的、固定的焦點（例如 25 分鐘），而不是嘗試工作幾個小時。"
          }
        }
      }
    },
    "weekly_report.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Versuche, das Handy während deiner Sessions außer Sichtweite zu legen – das reduziert Ablenkungen enorm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Try keeping your phone out of sight during sessions – it massively reduces distractions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Intenta mantener el teléfono fuera de tu vista durante las sesiones, eso reduce enormemente las distracciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil: Essaie de garder ton téléphone hors de ta vue pendant tes sessions – cela réduit énormément les distractions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: अपनी सत्रों के दौरान मोबाइल फोन को नज़र से दूर रखने की कोशिश करें – इससे ध्यान भटकने में काफी कमी आती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Prova a tenere il telefono fuori dalla vista durante le sessioni – riduce enormemente le distrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：セッション中はスマホを視界の外に置くようにしましょう。これで気が散ることが大幅に減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 세션 동안 스마트폰을 보이지 않는 곳에 두어 집중력 분산을 크게 줄이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Probeer je telefoon tijdens sessies buiten het zicht te houden – dat vermindert afleidingen enorm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Staraj się trzymać telefon poza zasięgiem wzroku podczas sesji – to znacznie zmniejsza rozproszenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Tente manter o celular fora do seu campo de visão durante as sessões – isso reduz muito as distrações."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Tente manter o celular fora do seu campo de visão durante as sessões – isso reduz muito as distrações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: во время занятий старайтесь держать телефон вне поля зрения — это значительно уменьшит отвлекающие факторы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Seanslar sırasında telefonunu görüş alanının dışında tutmayı dene – bu dikkat dağınıklığını büyük ölçüde azaltır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在会议期间尽量将手机放在视线之外 - 这会大大减少干扰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在會議期間盡量將手機放在視線之外 - 這會大大減少干擾。"
          }
        }
      }
    },
    "weekly_report.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Erledige deine wichtigsten Gewohnheiten direkt morgens. So startest du bereits mit einem kleinen Sieg in den Tag!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Complete your most important habits first thing in the morning. That way you start the day with a small win!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Completa tus hábitos más importantes a primera hora de la mañana. ¡Así empezarás el día con una pequeña victoria!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil: Effectue tes habitudes les plus importantes dès le matin. Tu commenceras ainsi la journée avec une petite victoire !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संकेत: अपने सबसे महत्वपूर्ण आदतों को सीधे सुबह ही पूरा करें। इस तरह आप दिन की शुरुआत एक छोटी जीत से करेंगे!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Completa le tue abitudini più importanti di mattina. In questo modo inizi la giornata con una piccola vittoria!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：一番大切な習慣を朝一番に済ませましょう。小さな勝利で一日をスタートできます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 가장 중요한 습관을 아침 가장 먼저 완료하세요. 작은 성공으로 하루를 시작할 수 있습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Voltooi je belangrijkste gewoonten 's ochtends vroeg. Zo begin je de dag al met een kleine overwinning!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Wykonaj swoje najważniejsze nawyki od razu rano. W ten sposób zaczniesz dzień z małym sukcesem!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Conclua seus hábitos mais importantes logo de manhã. Assim você começa o dia com uma pequena vitória!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Conclua seus hábitos mais importantes logo de manhã. Assim você começa o dia com uma pequena vitória!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: первым делом утром занимайтесь своими самыми важными привычками. Итак, вы начинаете день с маленькой победы!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: En önemli alışkanlıklarını sabah ilk iş olarak tamamla. Böylece güne küçük bir zaferle başlarsın!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：早上第一件事就是养成最重要的习惯。所以你以一个小小的胜利开始了新的一天！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：早上第一件事就是養成最重要的習慣。所以你以一個小小的勝利開始了新的一天！"
          }
        }
      }
    },
    "weekly_report.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Weniger ist manchmal mehr. Konzentriere dich nächste Woche auf 2-3 Kern-Gewohnheiten, um sie wirklich zu festigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Less is sometimes more. Focus on 2-3 core habits next week to really cement them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: A veces menos es más. Concéntrate en 2-3 hábitos clave la próxima semana para consolidarlos de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil: Parfois, moins c'est plus. Concentre-toi sur 2-3 habitudes clés la semaine prochaine pour vraiment les ancrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: कभी-कभी कम अधिक होता है। अगले सप्ताह 2-3 मुख्य आदतों पर ध्यान केंद्रित करें, ताकि उन्हें वास्तव में मजबूत किया जा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: A volte meno è meglio. Concentrati su 2-3 abitudini principali la settimana prossima per consolidarle davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：少ない方がいいこともあります。来週は2〜3つのコア習慣に集中して、しっかり定着させましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 때로는 적을수록 더 좋습니다. 다음 주에는 2-3가지 핵심 습관에 집중해 확실히 굳혀보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Soms is minder meer. Richt je volgende week op 2-3 kerngewoonten om ze echt te verankeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Mniej znaczy czasem więcej. Skoncentruj się w przyszłym tygodniu na 2-3 podstawowych nawykach, by naprawdę je utrwalić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Às vezes, menos é mais. Foque em 2-3 hábitos essenciais na próxima semana para realmente consolidá-los."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Às vezes, menos é mais. Foque em 2-3 hábitos essenciais na próxima semana para realmente consolidá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: иногда меньше значит больше. На следующей неделе сосредоточьтесь на 2–3 основных привычках, которые действительно укрепят их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Bazen az daha fazladır. Gelecek hafta 2-3 temel alışkanlığa odaklanarak onları gerçekten pekiştir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：有时少即是多。下周，重点关注 2-3 个核心习惯，真正巩固它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：有時少即是多。下週，重點關注 2-3 個核心習慣，真正鞏固它們。"
          }
        }
      }
    },

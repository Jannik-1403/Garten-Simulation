    "backup_import_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle eine .gartensave Datei aus deinem Speicher aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a .gartensave file from your storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo .gartensave de tu almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionne un fichier .gartensave depuis ton stockage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092d\u0902\u0921\u093e\u0930\u0923 \u0938\u0947 \u090f\u0915 .gartensave \u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902\u0964"

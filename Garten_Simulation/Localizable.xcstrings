    "trash.party_pass.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereinbare eine feste Abholzeit mit Freunden – das erzwingt den Abgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange a fixed pick-up time with friends – this forces you to leave."
          }
        },
        "es": {

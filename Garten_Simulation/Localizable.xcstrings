        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u6628\u65e5\u3088\u308a%@\u5206\u591a\u304f\u96c6\u4e2d\u3057\u307e\u3057\u305f\u3002\u305d\u306e\u8abf\u5b50\u3067\uff01"

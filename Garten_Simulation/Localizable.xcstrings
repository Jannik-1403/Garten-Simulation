    "trash.party_pass.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane Events nur noch bis 23 Uhr \u2013 danach nach Hause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan events only until 11pm \u2013 then go home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica eventos solo hasta las 23:00, despu\u00e9s ve a casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifie les \u00e9v\u00e9nements seulement jusqu'\u00e0 23h \u2013 puis rentre chez toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0918\u091f\u0928\u093e\u0913\u0902 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u0938\u093f\u0930\u094d\u092b \u0930\u093e\u0924 11 \u092c\u091c\u0947 \u0924\u0915 \u2013 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0918\u0930 \u091a\u0932\u0947 \u091c\u093e\u090f\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica gli eventi solo fino alle 23 \u2013 poi vai a casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30d9\u30f3\u30c8\u306f23\u6642\u307e\u3067\u306e\u8a08\u753b\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u305d\u306e\u5f8c\u306f\u5e30\u5b85\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubca4\ud2b8\ub294 \ubc24 11\uc2dc\uae4c\uc9c0\ub9cc \uacc4\ud68d\ud558\uc138\uc694 \u2013 \uadf8 \ud6c4\uc5d0\ub294 \uc9d1\uc5d0 \uac00\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan evenementen nog maar tot 23 uur \u2013 daarna naar huis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planuj imprezy tylko do 23 \u2013 potem wr\u00f3\u0107 do domu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje eventos apenas at\u00e9 as 23h \u2013 depois v\u00e1 para casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043b\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e 23:00. - \u0442\u043e\u0433\u0434\u0430 \u0438\u0434\u0438 \u0434\u043e\u043c\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlikleri yaln\u0131zca 23:00'a kadar planla \u2013 sonra eve git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u8ba1\u5212\u665a\u4e0a 11 \u70b9\u4e4b\u524d\u7684\u6d3b\u52a8- \u7136\u540e\u56de\u5bb6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u8a08\u5283\u665a\u4e0a 11 \u9ede\u4e4b\u524d\u7684\u6d3b\u52d5- \u7136\u5f8c\u56de\u5bb6\u3002"
          }
        }
      }
    },
    "trash.party_pass.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung: Schlafentzug kostet Tage an Produktivit\u00e4t, nicht nur Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder: sleep deprivation costs days of productivity, not just hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda: la falta de sue\u00f1o te cuesta d\u00edas de productividad, no solo horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel : le manque de sommeil co\u00fbte des jours de productivit\u00e9, pas seulement des heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u093e\u0926\u0926\u093e\u0936\u094d\u0924: \u0928\u0940\u0902\u0926 \u0915\u0940 \u0915\u092e\u0940 \u0915\u0947\u0935\u0932 \u0918\u0902\u091f\u094b\u0902 \u0939\u0940 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0926\u093f\u0928\u094b\u0902 \u0915\u093e \u0909\u0924\u094d\u092a\u093e\u0926\u0915\u0924\u093e \u092d\u0940 \u0932\u0947 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria: la privazione del sonno costa giorni di produttivit\u00e0, non solo ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u899a\u3048\u3066\u304a\u304d\u307e\u3057\u3087\u3046\uff1a\u7761\u7720\u4e0d\u8db3\u306f\u6570\u6642\u9593\u3060\u3051\u3067\u306a\u304f\u3001\u6570\u65e5\u5206\u306e\u751f\u7523\u6027\u3092\u5931\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae30\uc5b5\ud558\uc138\uc694: \uc218\uba74 \ubd80\uc871\uc740 \uba87 \uc2dc\uac04\uc774 \uc544\ub2c8\ub77c \uba70\uce60\uc758 \uc0dd\uc0b0\uc131\uc744 \uc783\uac8c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnering: slaaptekort kost je dagen productiviteit, niet alleen uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie: brak snu kosztuje dni produktywno\u015bci, nie tylko godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete: a priva\u00e7\u00e3o de sono custa dias de produtividade, n\u00e3o apenas horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435: \u043b\u0438\u0448\u0435\u043d\u0438\u0435 \u0441\u043d\u0430 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u043f\u043e\u0442\u0435\u0440\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0434\u043d\u0435\u0439, \u0430 \u043d\u0435 \u0447\u0430\u0441\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat\u0131rlatma: uyku yoksunlu\u011fu yaln\u0131zca saatler de\u011fil, g\u00fcnlerce verimlilik kaybettirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u9192\uff1a\u7761\u7720\u4e0d\u8db3\u4f1a\u635f\u5931\u51e0\u5929\u7684\u751f\u4ea7\u529b\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u51e0\u4e2a\u5c0f\u65f6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u9192\uff1a\u7761\u7720\u4e0d\u8db3\u6703\u640d\u5931\u5e7e\u5929\u7684\u751f\u7522\u529b\uff0c\u800c\u4e0d\u50c5\u50c5\u662f\u5e7e\u500b\u5c0f\u6642\u3002"
          }
        }
      }
    },
    "trash.party_pass.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereinbare eine feste Abholzeit mit Freunden \u2013 das erzwingt den Abgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange a fixed pick-up time with friends \u2013 this forces you to leave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuerda una hora fija de recogida con amigos: eso te obliga a irte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange une heure de ramassage fixe avec des amis \u2013 \u00e7a t'oblige \u00e0 partir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0932\u0947\u0928\u0947 \u0915\u093e \u0938\u092e\u092f \u0924\u092f \u0915\u0930\u0947\u0902 \u2013 \u0907\u0938\u0938\u0947 \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u093e \u0926\u092c\u093e\u0935 \u092c\u0928\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza un orario fisso per il rientro con gli amici \u2013 ti costringer\u00e0 ad andartene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53cb\u9054\u3068\u56fa\u5b9a\u306e\u304a\u8fce\u3048\u6642\u9593\u3092\u6c7a\u3081\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u304c\u5e30\u308b\u53e3\u5b9f\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce5c\uad6c\ub4e4\uacfc \uace0\uc815\ub41c \ud53d\uc5c5 \uc2dc\uac04\uc744 \uc57d\uc18d\ud558\uc138\uc694 \u2013 \uc774\uac83\uc774 \uc790\ub9ac\ub97c \ub5a0\ub098\ub3c4\ub85d \uac15\uc81c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek een vaste ophaalzeit af met vrienden \u2013 dat dwingt je om te vertrekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustal sta\u0142\u0105 godzin\u0119 odbioru z przyjaci\u00f3\u0142mi \u2013 to zmusi ci\u0119 do wyj\u015bcia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine um hor\u00e1rio fixo de busca com amigos \u2013 isso te obriga a sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435\u0441\u044c \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u043e \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u2014 \u044d\u0442\u043e \u0432\u044b\u043d\u0443\u0434\u0438\u0442 \u0432\u0430\u0441 \u0443\u0439\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkada\u015flarla sabit bir al\u0131\u015f zaman\u0131 ayarla \u2013 bu ayr\u0131lmana zorlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0e\u670b\u53cb\u5b89\u6392\u56fa\u5b9a\u7684\u63a5\u673a\u65f6\u95f4 - \u8fd9\u4f1a\u8feb\u4f7f\u60a8\u79bb\u5f00\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8207\u670b\u53cb\u5b89\u6392\u56fa\u5b9a\u7684\u63a5\u6a5f\u6642\u9593 - \u9019\u6703\u8feb\u4f7f\u60a8\u96e2\u958b\u3002"
          }
        }
      }
    },
    "trash.party_pass.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere, wie du dich nach einer Durchmachnacht f\u00fchlen. Hilft das beim n\u00e4chsten Mal?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note how you feel after an all-nighter. Does it help next time?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota c\u00f3mo te sientes despu\u00e9s de una noche sin dormir. \u00bfTe ayuda la pr\u00f3xima vez?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note comment tu te sens apr\u00e8s une nuit blanche. Est-ce que \u00e7a aide la prochaine fois ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093f\u0916\u094b \u0915\u093f \u092a\u0942\u0930\u0947 \u0930\u093e\u0924 \u091c\u093e\u0917\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0924\u0941\u092e \u0915\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u094b\u0964 \u0915\u094d\u092f\u093e \u092f\u0939 \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota come ti senti dopo una notte in bianco. Ti aiuta la prossima volta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fb9\u591c\u660e\u3051\u306e\u6c17\u5206\u3092\u66f8\u304d\u7559\u3081\u307e\u3057\u3087\u3046\u3002\u6b21\u56de\u306e\u53c2\u8003\u306b\u306a\u308a\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc24\uc0d8 \ud6c4 \uc5b4\ub5a4 \uae30\ubd84\uc778\uc9c0 \uae30\ub85d\ud558\uc138\uc694. \ub2e4\uc74c \ubc88\uc5d0 \ub3c4\uc6c0\uc774 \ub418\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer hoe je je voelt na een doorgemaakte nacht. Helpt dit de volgende keer?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz, jak si\u0119 czujesz po nieprzespanej nocy. Czy pomaga to nast\u0119pnym razem?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote como voc\u00ea se sente ap\u00f3s uma noite em claro. Ajuda na pr\u00f3xima vez?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435, \u043a\u0430\u043a \u0432\u044b \u0441\u0435\u0431\u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u043f\u043e\u0441\u043b\u0435 \u0431\u0435\u0441\u0441\u043e\u043d\u043d\u043e\u0439 \u043d\u043e\u0447\u0438. \u041f\u043e\u043c\u043e\u0436\u0435\u0442 \u043b\u0438 \u044d\u0442\u043e \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0437?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabaha kadar uyumad\u0131ktan sonra nas\u0131l hissetti\u011fini yaz. Bir sonraki seferde yard\u0131mc\u0131 oluyor mu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5199\u4e0b\u4f60\u71ac\u591c\u540e\u7684\u611f\u53d7\u3002\u4e0b\u6b21\u8fd9\u4f1a\u6709\u5e2e\u52a9\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5beb\u4e0b\u71ac\u591c\u5f8c\u7684\u611f\u53d7\u3002\u4e0b\u6b21\u9019\u6703\u6709\u5e6b\u52a9\u55ce\uff1f"
          }
        }
      }
    },
    "trash.party_pass.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Zu viel Party)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Me-Time & Selfcare)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0930\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0938\u0947 \u0905\u0935\u0917\u0924 \u0939\u094b\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0902 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u092e\u0940-\u091f\u093e\u0907\u092e \u0914\u0930 \u0938\u0947\u0932\u094d\u092b \u0915\u0947\u092f\u0930)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0924\u0915 \u0918\u091f\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0418\u0437\u0431\u0430\u0432\u044c\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0440\u0435\u0434\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043e\u043a)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438: \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u044b \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445. \n3. \u0423\u0441\u043b\u043e\u0436\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0443: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043e\u0442 \u0441\u0435\u0442\u0438). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0435\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e. \n\n**\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u0438 \u0443\u0445\u043e\u0434 \u0437\u0430 \u0441\u043e\u0431\u043e\u0439)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c: \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u044d\u0442\u043e \u0441 \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \n3. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e: \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c: \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0441\u0435\u0431\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Party)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Me-Time & Selfcare)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u574f\u4e60\u60ef\uff08\u805a\u4f1a\u592a\u591a\uff09**\n1. \u9690\u5f62\uff1a\u5c06\u89e6\u53d1\u56e0\u7d20\u79fb\u51fa\u89c6\u91ce\u3002\n2. \u8ba9\u81ea\u5df1\u53d8\u5f97\u6ca1\u6709\u5438\u5f15\u529b\uff1a\u610f\u8bc6\u5230\u8d1f\u9762\u540e\u679c\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u56f0\u96be\uff1a\u8bbe\u7f6e\u969c\u788d\uff08\u4f8b\u5982\u5220\u9664\u5e94\u7528\u7a0b\u5e8f\u3001\u62d4\u6389\u63d2\u5934\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6ee1\u610f\uff1a\u9644\u52a0\u5211\u7f5a\u6267\u884c\u3002\n\n**\u5efa\u7acb\u826f\u597d\u7684\u4e60\u60ef\uff08\u81ea\u6211\u65f6\u95f4\u548c\u81ea\u6211\u62a4\u7406\uff09**\n1. \u4f7f\u5176\u663e\u800c\u6613\u89c1\uff1a\u5c06\u89e6\u53d1\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u89c1\u7684\u4f4d\u7f6e\u3002\n2. \u8ba9\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c06\u5b83\u4e0e\u4f60\u559c\u6b22\u7684\u4e1c\u897f\u8054\u7cfb\u8d77\u6765\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u7b80\u5355\uff1a\u5c06\u969c\u788d\u51cf\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u949f\uff09\u3002\n4. \u8ba9\u5b83\u4ee4\u4eba\u6ee1\u610f\uff1a\u4e8b\u540e\u7acb\u5373\u5956\u52b1\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u58de\u7fd2\u6163\uff08\u805a\u6703\u592a\u591a\uff09**\n1. \u96b1\u5f62\uff1a\u5c07\u89f8\u767c\u56e0\u7d20\u79fb\u51fa\u8996\u91ce\u3002\n2. \u8b93\u81ea\u5df1\u8b8a\u5f97\u6c92\u6709\u5438\u5f15\u529b\uff1a\u610f\u8b58\u5230\u8ca0\u9762\u5f8c\u679c\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u56f0\u96e3\uff1a\u8a2d\u5b9a\u969c\u7919\uff08\u4f8b\u5982\u522a\u9664\u61c9\u7528\u7a0b\u5f0f\u3001\u62d4\u6389\u63d2\u982d\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6eff\u610f\uff1a\u9644\u52a0\u5211\u7f70\u57f7\u884c\u3002\n\n**\u5efa\u7acb\u826f\u597d\u7684\u7fd2\u6163\uff08\u81ea\u6211\u6642\u9593\u548c\u81ea\u6211\u7167\u9867\uff09**\n1. \u4f7f\u5176\u986f\u800c\u6613\u898b\uff1a\u5c07\u89f8\u767c\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u898b\u7684\u4f4d\u7f6e\u3002\n2. \u8b93\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c07\u5b83\u8207\u4f60\u559c\u6b61\u7684\u6771\u897f\u9023\u7d50\u8d77\u4f86\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u7c21\u55ae\uff1a\u5c07\u969c\u7919\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u9418\uff09\u3002\n4. \u8b93\u5b83\u4ee4\u4eba\u6eff\u610f\uff1a\u4e8b\u5f8c\u7acb\u5373\u734e\u52f5\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere Koffein, um abends leichter zur Ruhe zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce caffeine to find it easier to rest in the evening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la cafe\u00edna para que te sea m\u00e1s f\u00e1cil descansar por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9duis la caf\u00e9ine pour trouver plus facilement le repos le soir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0915\u094b \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0906\u0930\u093e\u092e \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0948\u092b\u0940\u0928 \u0915\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci la caffeina per trovare pi\u00f9 facilmente riposo la sera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5915\u65b9\u306b\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u3084\u3059\u304f\u3059\u308b\u305f\u3081\u306b\u3001\u30ab\u30d5\u30a7\u30a4\u30f3\u3092\u6e1b\u3089\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub141\uc5d0 \ub354 \uc27d\uac8c \uc274 \uc218 \uc788\ub3c4\ub85d \uce74\ud398\uc778\uc744 \uc904\uc774\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder cafe\u00efne om 's avonds makkelijker tot rust te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz spo\u017cycie kofeiny, aby u\u0142atwi\u0107 sobie zasypianie wieczorem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza a cafe\u00edna para facilitar o descanso \u00e0 noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u0444\u0435\u0438\u043d\u0430, \u0447\u0442\u043e\u0431\u044b \u043b\u0435\u0433\u0447\u0435 \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u0438\u0442\u044c\u0441\u044f \u0432\u0435\u0447\u0435\u0440\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u015famlar\u0131 dinlenmeyi kolayla\u015ft\u0131rmak i\u00e7in kafeini azalt\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51cf\u5c11\u5496\u5561\u56e0\u6444\u5165\u91cf\uff0c\u8ba9\u665a\u4e0a\u66f4\u5bb9\u6613\u653e\u677e\u4e0b\u6765\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e1b\u5c11\u5496\u5561\u56e0\u651d\u53d6\u91cf\uff0c\u8b93\u665a\u4e0a\u66f4\u5bb9\u6613\u653e\u9b06\u3002"
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Zu viel Koffein) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u0915\u0948\u092b\u0940\u0928) \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u043a\u043e\u0444\u0435\u0438\u043d\u0430) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u6444\u5165\u8fc7\u591a\u5496\u5561\u56e0\uff09\u4f1a\u6d88\u8017\u60a8\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u651d\u53d6\u904e\u591a\u5496\u5561\u56e0\uff09\u6703\u6d88\u8017\u60a8\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },

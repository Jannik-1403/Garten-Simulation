    "assessment.fitness.q15.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehrlich gesagt trainiere ich nur, damit andere mich attraktiv finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To be honest, I only train so that other people find me attractive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinceramente, sólo entreno para que los demás me encuentren atractivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour être honnête, je m’entraîne uniquement pour que les autres me trouvent attirant."

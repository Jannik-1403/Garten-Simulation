    "trash.nacht_snack_box.obj_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grenzt deinen Garten sicher ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secures your garden boundaries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delimita las fronteras de tu jardín."
          }
        },
        "fr" : {
          "stringUnit" : {

    "weather.rule.sturm": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sturm: Wenn eine Pflanze stirbt, verlierst du 2 Leben statt 1."

    "notification.morning.3.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten gedeiht! %d Tage harte Arbeit warten auf Fortsetzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden thrives! %d days of hard work await continuation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Tu jard\u00edn prospera! %d d\u00edas de duro trabajo esperan continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton jardin prosp\u00e8re ! %d jours de dur labeur t'attendent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u092c\u0917\u0940\u091a\u093e \u092b\u0932-\u092b\u0942\u0932 \u0930\u0939\u093e \u0939\u0948!%d\u0915\u0921\u093c\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0947 \u0926\u093f\u0928 \u091c\u093e\u0930\u0940 \u0930\u0939\u0928\u0947 \u0915\u093e \u0907\u0902\u0924\u091c\u093e\u0930 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino prospera! %d giorni di duro lavoro aspettano di essere continuati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u306f\u7e41\u6804\u3057\u307e\u3059\uff01 %d \u65e5\u306e\u30cf\u30fc\u30c9\u30ef\u30fc\u30af\u304c\u7d99\u7d9a\u3092\u5f85\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc815\uc6d0\uc774 \ubc88\uc131\ud569\ub2c8\ub2e4! %d\uc77c\uac04\uc758 \ub178\ub825\uc774 \uacc4\uc18d\ub420 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw tuin bloeit! %d dagen hard werken wachten op voortzetting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j ogr\u00f3d kwitnie! %d dni ci\u0119\u017ckiej pracy czeka na kontynuacj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu jardim prospera! %d dias de trabalho \u00e1rduo aguardam continua\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u0441\u0430\u0434 \u043f\u0440\u043e\u0446\u0432\u0435\u0442\u0430\u0435\u0442!%d\u0434\u043d\u0435\u0439 \u0442\u044f\u0436\u0451\u043b\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0436\u0434\u0443\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7eniz geli\u015fiyor! %d g\u00fcnl\u00fck s\u0131k\u0131 \u00e7al\u0131\u015fma devam etmeyi bekliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u82b1\u56ed\u6b23\u6b23\u5411\u8363\uff01%d \u5929\u7684\u8f9b\u52e4\u5de5\u4f5c\u7b49\u5f85\u7ee7\u7eed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u82b1\u5712\u6b63\u5728\u84ec\u52c3\u767c\u5c55\uff01%d\u5e7e\u5929\u7684\u8f9b\u82e6\u5de5\u4f5c\u7b49\u8457\u7e7c\u7e8c\u3002"
          }
        }
      }
    },

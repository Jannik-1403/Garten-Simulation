    "plant.weltenbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge unendliches Wachstum und strebe nach Höherem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pursue infinite growth and strive for higher things."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Persigue el crecimiento infinito y aspira a cosas superiores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poursuivez une croissance infinie et visez plus haut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनंत वृद्धि का पीछा करें और उच्चतर की ओर प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persegui una crescita infinita e mira a cose superiori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無限の成長を追求し、より高い目標を目指しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무한한 성장을 추구하고 더 높은 것을 위해 노력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streef naar oneindige groei en mik op hogere doelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dąż do nieskończonego wzrostu i sięgaj wyżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque o crescimento infinito e aspire a coisas maiores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque o crescimento infinito e aspire a coisas maiores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стремись к бесконечному росту и стремись к высшему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuz büyümeyi hedefleyin ve daha yüksekleri arzulayın."
          }

    "widget_interactive_habits_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gie\u00dfe deine Pflanzen direkt vom Homescreen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants directly from the home screen."

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud648 \ud654\uba74\uc5d0\uc11c \uc9c1\uc811 \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc138\uc694."

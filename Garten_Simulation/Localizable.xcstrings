    "settings.restore.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben Sie bereits Käufe getätigt? Hier können Sie diese auf diesem Gerät wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you already made purchases? You can restore them on this device here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya realizaste compras? Puedes restaurarlas en este dispositivo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "As-tu déjà effectué des achats ? Tu peux les restaurer sur cet appareil ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you already made purchases? You can restore them on this device here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう購入しましたか?ここでこのデバイスにそれらを復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 구매하셨나요? 여기에서 이 기기에 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft u al aankopen gedaan? Je kunt ze hier op dit apparaat herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy dokonaliście już zakupów? Tutaj możesz je przywrócić na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já efetuaste compras? Podes restaurá-las neste dispositivo aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten alışveriş yaptınız mı? Bunları bu cihaza buradan geri yükleyebilirsiniz."
          }
        }
      }
    },

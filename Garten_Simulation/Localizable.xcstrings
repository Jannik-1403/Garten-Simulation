    "progression_wakeup_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Snooze! Stehe auf und trinke direkt ein Glas Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No snooze! Get up and drink a glass of water right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Sin repetici\u00f3n! Lev\u00e1ntate y bebe un vaso de agua de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de r\u00e9p\u00e9tition ! L\u00e8ve-toi et bois un verre d'eau tout de suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u094b \u0938\u094d\u0928\u0942\u091c\u093c! \u0909\u0920\u094b \u0914\u0930 \u0938\u0940\u0927\u0947 \u090f\u0915 \u0917\u093f\u0932\u093e\u0938 \u092a\u093e\u0928\u0940 \u092a\u093f\u092f\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente snooze! Alzati e bevi subito un bicchiere d'acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c45\u7720\u308a\u306f\u3042\u308a\u307e\u305b\u3093\uff01\u8d77\u304d\u3066\u3059\u3050\u306b\u30b3\u30c3\u30d7\u4e00\u676f\u306e\u6c34\u3092\u98f2\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc790\uc9c0 \ub9c8\uc138\uc694! \uc989\uc2dc \uc77c\uc5b4\ub098 \ubb3c \ud55c \uc794\uc744 \ub9c8\uc2e0\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen snooze! Sta op en drink meteen een glas water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017badnej drzemki! Wsta\u0144 i natychmiast wypij szklank\u0119 wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem repeti\u00e7\u00e3o! Levanta-te e bebe logo um copo de \u00e1gua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0437 \u043b\u0438\u0448\u043d\u0435\u0433\u043e \u0441\u043d\u0430! \u0412\u0441\u0442\u0430\u043d\u044c \u0438 \u0441\u0440\u0430\u0437\u0443 \u0432\u044b\u043f\u0435\u0439 \u0441\u0442\u0430\u043a\u0430\u043d \u0432\u043e\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ertelemek yok! Hemen kalk\u0131n ve bir bardak su i\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u8d56\u5e8a\uff01\u8d77\u5e8a\u540e\u76f4\u63a5\u559d\u4e00\u676f\u6c34\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u51c6\u6253\u778c\u7761\uff01\u7acb\u5373\u8d77\u8eab\u559d\u4e00\u676f\u6c34\u3002"
          }
        }
      }
    },
    "progression_wakeup_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehe heute sofort beim ersten Klingeln des Weckers auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get up immediately at the first ring of the alarm today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lev\u00e1ntate inmediatamente al primer sonido del despertador hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e8ve-toi imm\u00e9diatement \u00e0 la premi\u00e8re sonnerie du r\u00e9veil aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0905\u0932\u093e\u0930\u094d\u092e \u092c\u091c\u0924\u0947 \u0939\u0940 \u0924\u0941\u0930\u0902\u0924 \u0909\u0920\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati immediatamente al primo squillo della sveglia oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u6700\u521d\u306e\u76ee\u899a\u307e\u3057\u304c\u9cf4\u3063\u305f\u3089\u3059\u3050\u306b\u8d77\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298 \uc54c\ub78c\uc774 \uc6b8\ub9ac\uba74 \uc989\uc2dc \uc77c\uc5b4\ub098\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta vandaag meteen op bij het eerste belsignaal van de wekker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wsta\u0144 dzisiaj natychmiast po pierwszym sygnale budzika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta-te imediatamente ao primeiro toque do despertador hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0432\u0441\u0442\u0430\u0432\u0430\u0439 \u0441\u0440\u0430\u0437\u0443 \u043f\u0440\u0438 \u043f\u0435\u0440\u0432\u043e\u043c \u0437\u0432\u043e\u043d\u043a\u0435 \u0431\u0443\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn alarm\u0131n ilk \u00e7almas\u0131yla hemen kalk\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u95f9\u949f\u4e00\u54cd\u5c31\u7acb\u523b\u8d77\u5e8a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u9b27\u9418\u4e00\u97ff\u6211\u5c31\u8d77\u5e8a\u3002"
          }
        }
      }
    },
    "progression_wakeup_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Morgen geh\u00f6rt dir. Du meisterst den Start in den Tag!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The morning is yours. You master the start of the day!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ma\u00f1ana es tuya. \u00a1Dominas el comienzo del d\u00eda!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matin est \u00e0 toi. Tu ma\u00eetrises le d\u00e9but de la journ\u00e9e !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u092c\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0939\u0948\u0964 \u0924\u0941\u092e \u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0902\u092d\u093e\u0932\u0924\u0947 \u0939\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mattina \u00e8 tua. Padroneggi l'inizio della giornata!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u671d\u306f\u3042\u306a\u305f\u306e\u3082\u306e\u3067\u3059\u3002\u4e00\u65e5\u306e\u59cb\u307e\u308a\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uce68\uc740 \ub2f9\uc2e0\uc758 \uac83\uc785\ub2c8\ub2e4. \ud558\ub8e8\uc758 \uc2dc\uc791\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ochtend is van jou. Jij beheerst de start van de dag!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poranek jest Tw\u00f3j. Jeste\u015b mistrzem pocz\u0105tku dnia!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A manh\u00e3 \u00e9 tua. Dominas o in\u00edcio do dia!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0442\u0440\u043e \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u0442\u0435\u0431\u0435. \u0422\u044b \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0448\u044c\u0441\u044f \u0441 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0434\u043d\u044f!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah senindir. G\u00fcn\u00fcn ba\u015flang\u0131c\u0131nda ustala\u015f\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u6668\u5c5e\u4e8e\u4f60\u3002\u4f60\u638c\u63a7\u7740\u4e00\u5929\u7684\u5f00\u59cb\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u6668\u662f\u4f60\u7684\u3002\u4f60\u638c\u63e1\u4e86\u4e00\u5929\u7684\u958b\u59cb\uff01"
          }
        }
      }
    },
    "progression_wakeup_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stehe auf und absolviere direkt eine 5-Minuten Morgenroutine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get up and complete a 5-minute morning routine right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lev\u00e1ntate y completa una rutina matutina de 5 minutos de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e8ve-toi et effectue une routine matinale de 5 minutes tout de suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0920\u094b \u0914\u0930 \u0938\u0940\u0927\u0947 5 \u092e\u093f\u0928\u091f \u0915\u0940 \u092e\u0949\u0930\u094d\u0928\u093f\u0902\u0917 \u0930\u0942\u091f\u0940\u0928 \u092a\u0942\u0930\u0940 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati e completa subito una routine mattutina di 5 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u304d\u3066\u3001\u3059\u3050\u306b 5 \u5206\u9593\u306e\u671d\u306e\u30eb\u30fc\u30c6\u30a3\u30f3\u3092\u5b8c\u4e86\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc5b4\ub098\uc11c \uc989\uc2dc 5\ubd84 \uc544\uce68 \ub8e8\ud2f4\uc744 \uc644\ub8cc\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta op en voltooi meteen een ochtendroutine van 5 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wsta\u0144 i od razu wykonaj 5-minutow\u0105 porann\u0105 rutyn\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta-te e completa logo uma rotina matinal de 5 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u044c \u0438 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0438 5-\u043c\u0438\u043d\u0443\u0442\u043d\u0443\u044e \u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0440\u0443\u0442\u0438\u043d\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen kalk\u0131n ve 5 dakikal\u0131k bir sabah rutinini tamamlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u5e8a\u540e\u7acb\u5373\u5b8c\u62105\u5206\u949f\u7684\u6668\u95f4\u4f8b\u884c\u4e8b\u52a1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u5e8a\u5f8c\u7acb\u5373\u9032\u884c 5 \u5206\u9418\u7684\u6668\u9593\u4f8b\u884c\u6d3b\u52d5\u3002"
          }
        }
      }
    },
    "psychology.fact.levelup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gehirn bildet gerade neue neuronale Bahnen! Jeder Fortschritt festigt deine neue Identit\u00e4t."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brain is forming new neural pathways! Every step forward solidifies your new identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Tu cerebro est\u00e1 formando nuevas v\u00edas neuronales! Cada paso adelante consolida tu nueva identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton cerveau forme de nouvelles connexions neuronales ! Chaque pas en avant consolide ta nouvelle identit\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u093e\u0930\u093e \u092e\u0938\u094d\u0924\u093f\u0937\u094d\u0915 \u0905\u092d\u0940 \u0928\u090f \u0924\u0902\u0924\u094d\u0930\u093f\u0915\u093e \u092e\u093e\u0930\u094d\u0917 \u092c\u0928\u093e \u0930\u0939\u093e \u0939\u0948! \u0939\u0930 \u092a\u094d\u0930\u0917\u0924\u093f \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0928\u0908 \u092a\u0939\u091a\u093e\u0928 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cervello sta formando nuovi percorsi neurali! Ogni passo avanti consolida la tua nuova identit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8133\u304c\u65b0\u3057\u3044\u795e\u7d4c\u56de\u8def\u3092\u5f62\u6210\u3057\u3066\u3044\u307e\u3059\uff01\u4e00\u6b69\u524d\u9032\u3059\u308b\u3054\u3068\u306b\u3001\u65b0\u3057\u3044\u30a2\u30a4\u30c7\u30f3\u30c6\u30a3\u30c6\u30a3\u304c\u56fa\u307e\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \ub1cc\uac00 \uc0c8\ub85c\uc6b4 \uc2e0\uacbd \uacbd\ub85c\ub97c \ud615\uc131\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4! \uc55e\uc73c\ub85c \ub098\uc544\uac08 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c\uc6b4 \uc815\uccb4\uc131\uc774 \ud655\uace0\ud574\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je brein vormt nieuwe neurale paden! Elke stap vooruit verstevigt je nieuwe identiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j m\u00f3zg tworzy nowe \u015bcie\u017cki neuronowe! Ka\u017cdy krok naprz\u00f3d umacnia twoj\u0105 now\u0105 to\u017csamo\u015b\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu c\u00e9rebro est\u00e1 formando novas vias neurais! Cada passo adiante solidifica sua nova identidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u043c\u043e\u0437\u0433 \u0441\u0435\u0439\u0447\u0430\u0441 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442 \u043d\u043e\u0432\u044b\u0435 \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u044b\u0435 \u043f\u0443\u0442\u0438! \u041a\u0430\u0436\u0434\u044b\u0439 \u0443\u0441\u043f\u0435\u0445 \u0443\u043a\u0440\u0435\u043f\u043b\u044f\u0435\u0442 \u0442\u0432\u043e\u044e \u043d\u043e\u0432\u0443\u044e \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beynin yeni sinir yollar\u0131 olu\u015fturuyor! \u0130leriye do\u011fru at\u0131lan her ad\u0131m yeni kimli\u011fini sa\u011flamla\u015ft\u0131r\u0131yor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u5927\u8111\u6b63\u5728\u5f62\u6210\u65b0\u7684\u795e\u7ecf\u901a\u8def\uff01\u6bcf\u4e00\u6b21\u8fdb\u6b65\u90fd\u5de9\u56fa\u4e86\u4f60\u7684\u65b0\u8eab\u4efd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u5927\u8166\u76ee\u524d\u6b63\u5728\u5f62\u6210\u65b0\u7684\u795e\u7d93\u901a\u8def\uff01\u6bcf\u4e00\u500b\u9032\u6b65\u90fd\u6703\u978f\u56fa\u4f60\u7684\u65b0\u8eab\u5206\u3002"
          }
        }
      }
    },
    "psychology.fact.milestone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopamin-Aussch\u00fcttung erkannt: Du bist auf dem absolut richtigen Weg!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopamine release detected: You are absolutely on the right track!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberaci\u00f3n de dopamina detectada: \u00a1Est\u00e1s absolutamente en el camino correcto!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lib\u00e9ration de dopamine d\u00e9tect\u00e9e : Tu es absolument sur la bonne voie !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u094b\u092a\u093e\u092e\u093f\u0928 \u0938\u094d\u0930\u093e\u0935 \u092a\u0939\u091a\u093e\u0928\u093e \u0917\u092f\u093e: \u0906\u092a \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940 \u0930\u093e\u0938\u094d\u0924\u0947 \u092a\u0930 \u0939\u0948\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascio di dopamina rilevato: Sei assolutamente sulla strada giusta!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c9\u30fc\u30d1\u30df\u30f3\u306e\u653e\u51fa\u3092\u691c\u77e5\uff1a\u3042\u306a\u305f\u306f\u7d76\u5bfe\u306b\u6b63\u3057\u3044\u9053\u3092\u9032\u3093\u3067\u3044\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3c4\ud30c\ubbfc \ubc29\ucd9c \uac10\uc9c0\ub428: \ub2f9\uc2e0\uc740 \uc808\ub300\uc801\uc73c\ub85c \uc62c\ubc14\ub978 \uae38\uc744 \uac00\uace0 \uc788\uc2b5\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopamine-afgifte gedetecteerd: Je bent absoluut op de goede weg!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto uwalnianie dopaminy: Jeste\u015b na absolutnie w\u0142a\u015bciwej drodze!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera\u00e7\u00e3o de dopamina detectada: Voc\u00ea est\u00e1 absolutamente no caminho certo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0430 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0430: \u0432\u044b \u043d\u0430 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u043c \u043f\u0443\u0442\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopamin sal\u0131n\u0131m\u0131 tespit edildi: Kesinlikle do\u011fru yoldas\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u68c0\u6d4b\u5230\u591a\u5df4\u80fa\u91ca\u653e\uff1a\u4f60\u8d70\u5728\u7edd\u5bf9\u6b63\u786e\u7684\u9053\u8def\u4e0a\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5075\u6e2c\u5230\u591a\u5df4\u80fa\u91cb\u653e\uff1a\u60a8\u7d55\u5c0d\u8d70\u5728\u6b63\u78ba\u7684\u9053\u8def\u4e0a\uff01"
          }
        }
      }
    },

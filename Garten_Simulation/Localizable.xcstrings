    "pfad_lernen_day_14_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "14 Tage kontinuierliches Lernen. Du verstehst die Zusammenh\u00e4nge besser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 days of continuous learning. You understand the connections better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14 d\u00edas de estudio continuo. Entiendes mejor las conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 jours d'apprentissage continu. Tu comprends mieux les liens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0932\u0917\u093e\u0924\u093e\u0930 \u0938\u0940\u0916\u0928\u093e\u0964 \u0906\u092a \u0938\u0902\u092c\u0902\u0927\u094b\u0902 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u0938\u092e\u091d\u0924\u0947 \u0939\u0948\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "14 giorni di apprendimento continuo. Comprendi meglio i collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14\u65e5\u9593\u306e\u7d99\u7d9a\u5b66\u7fd2\u3002\u3064\u306a\u304c\u308a\u3092\u3088\u308a\u3088\u304f\u7406\u89e3\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14\uc77c \uc5f0\uc18d \ud559\uc2b5. \uc5f0\uacb0\uc744 \ub354 \uc798 \uc774\ud574\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dagen continu leren. Je begrijpt de verbanden beter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dni ci\u0105g\u0142ej nauki. Lepiej rozumiesz powi\u0105zania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dias de aprendizagem cont\u00ednua. Compreendes melhor as liga\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14 \u0434\u043d\u0435\u0439 \u043d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0433\u043e \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f. \u0422\u044b \u043b\u0443\u0447\u0448\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0448\u044c \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 g\u00fcn s\u00fcrekli \u00f6\u011frenme. Ba\u011flant\u0131lar\u0131 daha iyi anlars\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "14\u5929\u6301\u7eed\u5b66\u4e60\u3002\u4f60\u5bf9\u4e8b\u7269\u4e4b\u95f4\u7684\u8054\u7cfb\u7406\u89e3\u5f97\u66f4\u597d\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "14\u5929\u7684\u6301\u7e8c\u5b78\u7fd2\u3002\u60a8\u53ef\u4ee5\u66f4\u597d\u5730\u7406\u89e3\u5176\u4e2d\u7684\u806f\u7e6b\u3002"
          }
        }
      }
    },

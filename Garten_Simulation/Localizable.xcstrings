    "prog_coldshower_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Moment, in dem das Wasser dich trifft, löst einen Schnapp-Reflex aus. Kontrolliere sofort die Ausatmung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moment the water hits you triggers a gasp reflex. Immediately control your exhalation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el momento en que el agua te golpea, se desencadena un reflejo de jadeo. Controle inmediatamente su exhalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moment où l’eau vous frappe, vous déclenchez un réflexe de halètement. Contrôlez immédiatement votre expiration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही पानी आप पर पड़ता है, हांफने की प्रतिक्रिया शुरू हो जाती है। तुरंत अपनी साँस छोड़ने पर नियंत्रण रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel momento in cui l'acqua ti colpisce, si attiva il riflesso del sussulto. Controlla immediatamente la tua espirazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水が当たった瞬間にあえぎ反射が起こります。直ちに呼気をコントロールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물이 닿는 순간 헐떡거리는 반사가 유발됩니다. 즉시 호기를 조절하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het moment dat het water je raakt, ontstaat er een zuchtreflex. Controleer onmiddellijk uw uitademing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moment, w którym woda uderza w Ciebie, wyzwala odruch wdechu. Natychmiast kontroluj wydech."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento em que a água atinge você, desencadeia um reflexo de suspiro. Controle imediatamente sua expiração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento em que a água atinge você, desencadeia um reflexo de suspiro. Controle imediatamente sua expiração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В тот момент, когда вода попадает на вас, вызывает рефлекс удушья. Сразу же контролируйте выдох."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su size çarptığı anda nefes alma refleksi tetiklenir. Derhal nefesinizi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水接触到您的那一刻会触发喘息反射。立即控制呼气。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水接觸到您的那一刻會觸發喘息反射。立即控制呼氣。"
          }
        }
      }
    },
    "prog_coldshower_d1_t1": {
      "extractionState": "manual",
      "localizations": {

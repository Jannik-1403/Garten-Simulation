    "screenTime.layer2.desc" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Diese Apps und Webseiten sind immer blockiert und können nur durch den Notfall-Unlock entsperrt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These apps and websites are always blocked and can only be unblocked using Emergency Unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas aplicaciones y sitios web siempre están bloqueados y solo se pueden desbloquear mediante el Desbloqueo de emergencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces applications et sites Web sont toujours bloqués et ne peuvent être débloqués qu'à l'aide du déverrouillage d'urgence."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये ऐप्स और वेबसाइटें हमेशा ब्लॉक रहती हैं और इन्हें केवल आपातकालीन अनलॉक का उपयोग करके अनब्लॉक किया जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste app e questi siti Web sono sempre bloccati e possono essere sbloccati solo utilizzando lo sblocco di emergenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアプリや Web サイトは常にブロックされており、緊急ロック解除を使用しないとブロックを解除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이러한 앱과 웹사이트는 항상 차단되어 있으며 긴급 잠금 해제를 통해서만 차단을 해제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze apps en websites zijn altijd geblokkeerd en kunnen alleen worden gedeblokkeerd via Noodontgrendeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te aplikacje i strony internetowe są zawsze blokowane i można je odblokować wyłącznie za pomocą odblokowania awaryjnego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses aplicativos e sites estão sempre bloqueados e só podem ser desbloqueados usando o Desbloqueio de Emergência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти приложения и веб-сайты всегда блокируются, и их можно разблокировать только с помощью аварийной разблокировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamalar ve web siteleri her zaman engellenir ve yalnızca Acil Durum Kilit Açma kullanılarak engeli kaldırılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些应用程序和网站始终被阻止，只能使用紧急解锁来解除阻止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些應用程式和網站始終被阻止，只能使用緊急解鎖來解除封鎖。"
          }
        }
      }
    },

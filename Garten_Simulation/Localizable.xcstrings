        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokonałeś kryzys chwastów. Przez %2$d godzin zdobywasz %1$@ XP za podlewanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

    "prog_deepwork_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige die absolut wichtigste und schwerste Aufgabe des Tages direkt in deiner ersten Deep Work Session. Schiebe nichts auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the absolute most important and hardest task of the day right in your first deep work session. Don't put anything off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete la tarea más importante y difícil del día en su primera sesión de trabajo profundo. No pospongas nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accomplissez la tâche la plus importante et la plus difficile de la journée dès votre première séance de travail approfondi. Ne remettez rien à plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन का सबसे महत्वपूर्ण और कठिन कार्य अपने पहले गहन कार्य सत्र में ही पूरा करें। कुछ भी मत टालो."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa il compito in assoluto più importante e più difficile della giornata proprio nella tua prima sessione di lavoro profondo. Non rimandare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の本格的な作業セッションで、その日の中で最も重要かつ最も困難なタスクを完了します。何も先延ばしにしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 심층 작업 세션에서 오늘의 가장 중요하고 어려운 작업을 바로 완료하세요. 아무것도 미루지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi de absoluut belangrijkste en moeilijkste taak van de dag tijdens uw eerste diepe werksessie. Stel niets uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonaj absolutnie najważniejsze i najtrudniejsze zadanie dnia już podczas pierwszej sesji głębokiej pracy. Nie odkładaj niczego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a tarefa mais importante e mais difícil do dia logo na sua primeira sessão de trabalho profundo. Não adie nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a tarefa mais importante e mais difícil do dia logo na sua primeira sessão de trabalho profundo. Não adie nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните самую важную и сложную задачу дня прямо во время первого сеанса глубокой работы. Ничего не откладывайте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün en önemli ve en zor görevini, ilk derin çalışma seansınızda tamamlayın. Hiçbir şeyi ertelemeyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的第一次深度工作会议中完成当天绝对最重要和最困难的任务。不要拖延任何事情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的第一次深度工作會議中完成當天絕對最重要和最困難的任務。不要拖延任何事情。"
          }
        }
      }
    },

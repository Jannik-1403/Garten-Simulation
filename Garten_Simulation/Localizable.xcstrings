    "assessment.health.q2.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich drücke 3-mal Snooze und zwinge mich im letzten Moment panisch aus dem Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I press snooze three times and force myself out of bed in a panic at the last moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiono el botón de repetición tres veces y me obligo a levantarme de la cama presa del pánico en el último momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'appuie trois fois sur snooze et me force à sortir du lit, paniqué, au dernier moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premo snooze tre volte e all'ultimo momento mi costringo ad alzarmi dal letto in preda al panico."

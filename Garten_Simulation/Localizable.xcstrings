    "assessment.growth.q14" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist Samstagmorgen. Du hast keine Termine, keine Verpflichtungen. Wie entfaltet sich der Tag?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's Saturday morning. You have no appointments, no obligations. How does the day unfold?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sábado por la mañana. No tienes citas, ni obligaciones. ¿Cómo transcurre el día?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est samedi matin. Vous n'avez aucun rendez-vous, aucune obligation. Comment se déroule la journée ?"

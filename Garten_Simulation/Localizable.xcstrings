        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massima efficienza. Padroneggi perfettamente la tua giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大の効率。あなたは一日を完璧にマスターします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대의 효율성. 당신은 하루를 완벽하게 마스터합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximale efficiëntie. Je beheerst je dag perfect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalna wydajność. Doskonale opanowałeś swój dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eficiência máxima. Dominas o teu dia perfeitamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum verimlilik. Gününüzü mükemmel bir şekilde yönetiyorsunuz."
          }
        }
      }
    },
    "pfad_produktiv_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meistere deine Zeit. Fokus wird zur Gewohnheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master your time. Focus becomes a habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Domina tu tiempo. El enfoque se convierte en un hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maîtrise ton temps. La concentration devient une habitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Padroneggia il tuo tempo. Il focus diventa un'abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間をマスターしましょう。集中力が習慣になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 마스터하세요. 집중은 습관이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheers uw tijd. Focus wordt een gewoonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opanuj swój czas. Koncentracja staje się nawykiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Domina o teu tempo. O foco torna-se um hábito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanınıza hakim olun. Odaklanmak bir alışkanlık haline gelir."
          }
        }
      }
    },

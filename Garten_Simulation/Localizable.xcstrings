    "trash.couch_abo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Sportschuhe sichtbar bereit \u2013 sie erinnern dich t\u00e4glich ans Bewegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your sports shoes out visibly \u2013 they remind you to move every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tus zapatillas deportivas a la vista: te recuerdan cada d\u00eda que debes moverte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose tes chaussures de sport bien en vue \u2013 elles te rappellent chaque jour de bouger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0947\u0932 \u0915\u0947 \u091c\u0942\u0924\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902 \u2013 \u0935\u0947 \u0906\u092a\u0915\u094b \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u0947 \u0915\u0940 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti le scarpe sportive in bella vista \u2013 ti ricordano ogni giorno di muoverti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30dd\u30fc\u30c4\u30b7\u30e5\u30fc\u30ba\u3092\u898b\u3048\u308b\u3068\u3053\u308d\u306b\u7f6e\u304d\u307e\u3057\u3087\u3046\u3002\u6bce\u65e5\u904b\u52d5\u3092\u601d\u3044\u51fa\u3055\u305b\u3066\u304f\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b4\ub3d9\ud654\ub97c \ub208\uc5d0 \ub744\ub294 \uacf3\uc5d0 \ub450\uc138\uc694 \u2013 \ub9e4\uc77c \uc6c0\uc9c1\uc784\uc744 \uc0c1\uae30\uc2dc\ucf1c \uc90d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg sportschoenen zichtbaar klaar \u2013 ze herinneren je dagelijks aan bewegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142\u00f3\u017c buty sportowe w widocznym miejscu \u2013 codziennie b\u0119d\u0105 ci przypomina\u0107 o ruchu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe seus t\u00eanis esportivos \u00e0 vista \u2013 eles te lembram de se mover todo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0443\u044e \u043e\u0431\u0443\u0432\u044c \u043d\u0430 \u0432\u0438\u0434\u0443 \u2014 \u043e\u043d\u0430 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c \u0432\u0430\u043c \u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor ayakkab\u0131lar\u0131n\u0131 g\u00f6r\u00fcn\u00fcr bir yere koy \u2013 her g\u00fcn hareket etmeni hat\u0131rlat\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba9\u8fd0\u52a8\u978b\u663e\u773c\u2014\u2014\u5b83\u4eec\u4f1a\u63d0\u9192\u60a8\u6bcf\u5929\u8fd0\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b93\u904b\u52d5\u978b\u986f\u773c\u2014\u5b83\u5011\u6703\u63d0\u9192\u60a8\u6bcf\u5929\u904b\u52d5\u3002"
          }
        }
      }
    },
    "trash.couch_abo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaktivit\u00e4t schw\u00e4cht Muskeln, Kreislauf und Stimmung \u2013 jeden Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactivity weakens muscles, circulation and mood \u2013 every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inactividad debilita m\u00fasculos, circulaci\u00f3n y estado de \u00e1nimo, cada d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inactivit\u00e9 affaiblit les muscles, la circulation et l'humeur \u2013 chaque jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0932\u0938\u094d\u092f \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u094b\u0902, \u092a\u0930\u093f\u0938\u0902\u091a\u0930\u0923 \u0914\u0930 \u092e\u0942\u0921 \u0915\u094b \u0939\u0930 \u0926\u093f\u0928 \u0915\u092e\u091c\u094b\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inattivit\u00e0 indebolisce muscoli, circolazione e umore \u2013 ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u904b\u52d5\u4e0d\u8db3\u306f\u6bce\u65e5\u3001\u7b4b\u8089\u3001\u5faa\u74b0\u3001\u6c17\u5206\u3092\u5f31\u3081\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud65c\ub3d9 \ubd80\uc871\uc740 \ub9e4\uc77c \uadfc\uc721, \uc21c\ud658 \ubc0f \uae30\ubd84\uc744 \uc57d\ud654\uc2dc\ud0b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactiviteit verzwakt spieren, bloedsomloop en stemming \u2013 elke dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aktywno\u015bci os\u0142abia mi\u0119\u015bnie, kr\u0105\u017cenie i nastr\u00f3j \u2013 ka\u017cdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A inatividade enfraquece os m\u00fasculos, a circula\u00e7\u00e3o e o humor \u2013 todo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043e\u0441\u043b\u0430\u0431\u043b\u044f\u0435\u0442 \u043c\u044b\u0448\u0446\u044b, \u043a\u0440\u043e\u0432\u043e\u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u2013 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketsizlik her g\u00fcn kaslar\u0131, dola\u015f\u0131m\u0131 ve ruh halini zay\u0131flat\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f3a\u4e4f\u6d3b\u52a8\u6bcf\u5929\u90fd\u4f1a\u524a\u5f31\u808c\u8089\u3001\u8840\u6db2\u5faa\u73af\u548c\u60c5\u7eea\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f3a\u4e4f\u6d3b\u52d5\u6bcf\u5929\u90fd\u6703\u524a\u5f31\u808c\u8089\u3001\u8840\u6db2\u5faa\u74b0\u548c\u60c5\u7dd2\u3002"
          }
        }
      }
    },
    "trash.couch_abo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit nur 7 Minuten Bewegung \u2013 das ist leichter als du denkst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with just 7 minutes of movement \u2013 it's easier than you think."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con solo 7 minutos de movimiento: es m\u00e1s f\u00e1cil de lo que crees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec seulement 7 minutes de mouvement \u2013 c'est plus facile que tu ne le penses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0930\u094d\u092b 7 \u092e\u093f\u0928\u091f \u0915\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u2013 \u092f\u0939 \u0909\u0924\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u0948 \u091c\u093f\u0924\u0928\u093e \u0906\u092a \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con soli 7 minuti di movimento \u2013 \u00e8 pi\u00f9 facile di quanto pensi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305f\u3063\u305f7\u5206\u306e\u904b\u52d5\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u601d\u3063\u3066\u3044\u308b\u3088\u308a\u3082\u7c21\u5358\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e8 7\ubd84\uc758 \uc6c0\uc9c1\uc784\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694 \u2013 \uc0dd\uac01\ubcf4\ub2e4 \uc27d\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met slechts 7 minuten beweging \u2013 dat is makkelijker dan je denkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od zaledwie 7 minut ruchu \u2013 to \u0142atwiejsze ni\u017c my\u015blisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com apenas 7 minutos de movimento \u2013 \u00e9 mais f\u00e1cil do que voc\u00ea pensa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0432\u0441\u0435\u0433\u043e \u0441 7 \u043c\u0438\u043d\u0443\u0442 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 \u2013 \u044d\u0442\u043e \u043f\u0440\u043e\u0449\u0435, \u0447\u0435\u043c \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece 7 dakika hareketle ba\u015fla \u2013 d\u00fc\u015f\u00fcnd\u00fc\u011f\u00fcnden daha kolay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece 7 \u5206\u949f\u7684\u953b\u70bc\u5f00\u59cb - \u8fd9\u6bd4\u60a8\u60f3\u8c61\u7684\u8981\u5bb9\u6613\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e 7 \u5206\u9418\u7684\u904b\u52d5\u958b\u59cb - \u9019\u6bd4\u60a8\u60f3\u50cf\u7684\u8981\u5bb9\u6613\u3002"
          }
        }
      }
    },
    "trash.couch_abo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere: Wie viele Stunden sa\u00dft du heute? Was fehlt dir dadurch?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: how many hours did you sit today? What are you missing because of it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota: \u00bfcu\u00e1ntas horas has estado sentado hoy? \u00bfQu\u00e9 te pierdes por ello?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note : combien d'heures as-tu \u00e9t\u00e9 assis aujourd'hui ? Qu'est-ce que tu rates \u00e0 cause de \u00e7a ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u094b\u091f \u0915\u0930\u0947\u0902: \u0906\u092a \u0906\u091c \u0915\u093f\u0924\u0928\u0947 \u0918\u0902\u091f\u0947 \u092c\u0948\u0920\u0947 \u0930\u0939\u0947\u0902? \u0907\u0938\u0915\u0947 \u0915\u093e\u0930\u0923 \u0906\u092a\u0915\u094b \u0915\u094d\u092f\u093e \u0915\u092e\u0940 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: quante ore sei stato seduto oggi? Cosa ti manca per questo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u7559\u3081\u307e\u3057\u3087\u3046\u3002\u4eca\u65e5\u4f55\u6642\u9593\u5ea7\u3063\u3066\u3044\u307e\u3057\u305f\u304b\uff1f\u305d\u308c\u306b\u3088\u3063\u3066\u4f55\u304c\u5931\u308f\u308c\u3066\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae30\ub85d\ud558\uc138\uc694: \uc624\ub298 \uba87 \uc2dc\uac04 \uc549\uc544 \uc788\uc5c8\ub098\uc694? \uadf8\ub85c \uc778\ud574 \ubb34\uc5c7\uc774 \ubd80\uc871\ud55c\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer: hoeveel uur heb je vandaag gezeten? Wat mis je daardoor?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz: ile godzin siedzia\u0142e\u015b dzisiaj? Czego ci przez to brakuje?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote: quantas horas voc\u00ea ficou sentado hoje? O que est\u00e1 perdendo por isso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u043e\u0432 \u0432\u044b \u043f\u0440\u043e\u0441\u0438\u0434\u0435\u043b\u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f? \u0427\u0435\u0433\u043e \u0442\u0435\u0431\u0435 \u0437\u0434\u0435\u0441\u044c \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz: bug\u00fcn ka\u00e7 saat oturdun? Bu y\u00fczden nelerden yoksun kald\u0131n?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\uff1a\u60a8\u4eca\u5929\u5750\u4e86\u51e0\u4e2a\u5c0f\u65f6\uff1f\u4f60\u8fd8\u7f3a\u5c11\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\uff1a\u60a8\u4eca\u5929\u5750\u4e86\u5e7e\u500b\u5c0f\u6642\uff1f\u4f60\u9084\u7f3a\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "trash.couch_abo.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Auf der Couch liegen)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Stretching)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u093e (\u0938\u094b\u092b\u0947 \u092a\u0930 \u0932\u0947\u091f\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0937\u094d\u091f\u093f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u094b \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0947\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u092e\u0947\u0902 \u092c\u093e\u0927\u093e\u090f\u0902 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0915\u094b \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0938\u094d\u091f\u094d\u0930\u0947\u091a\u093f\u0902\u0917)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0924\u0915 \u0918\u091f\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0418\u0437\u0431\u0430\u0432\u044c\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0440\u0435\u0434\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u043b\u0435\u0436\u0430\u0442\u044c \u043d\u0430 \u0434\u0438\u0432\u0430\u043d\u0435)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438: \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u044b \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445. \n3. \u0423\u0441\u043b\u043e\u0436\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0443: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043e\u0442 \u0441\u0435\u0442\u0438). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0435\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e. \n\n**\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 (\u0440\u0430\u0441\u0442\u044f\u0436\u043a\u0430)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c: \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u044d\u0442\u043e \u0441 \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \n3. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e: \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c: \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0441\u0435\u0431\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Auf der Couch liegen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Stretching)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u574f\u4e60\u60ef\uff08\u8eba\u5728\u6c99\u53d1\u4e0a\uff09**\n1. \u9690\u5f62\uff1a\u5c06\u89e6\u53d1\u56e0\u7d20\u79fb\u51fa\u89c6\u91ce\u3002\n2. \u8ba9\u81ea\u5df1\u53d8\u5f97\u6ca1\u6709\u5438\u5f15\u529b\uff1a\u610f\u8bc6\u5230\u8d1f\u9762\u540e\u679c\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u56f0\u96be\uff1a\u8bbe\u7f6e\u969c\u788d\uff08\u4f8b\u5982\u5220\u9664\u5e94\u7528\u7a0b\u5e8f\u3001\u62d4\u6389\u63d2\u5934\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6ee1\u610f\uff1a\u9644\u52a0\u5211\u7f5a\u6267\u884c\u3002\n\n**\u517b\u6210\u826f\u597d\u7684\u4e60\u60ef\uff08\u4f38\u5c55\u8fd0\u52a8\uff09**\n1. \u4f7f\u5176\u663e\u800c\u6613\u89c1\uff1a\u5c06\u89e6\u53d1\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u89c1\u7684\u4f4d\u7f6e\u3002\n2. \u8ba9\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c06\u5b83\u4e0e\u4f60\u559c\u6b22\u7684\u4e1c\u897f\u8054\u7cfb\u8d77\u6765\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u7b80\u5355\uff1a\u5c06\u969c\u788d\u51cf\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u949f\uff09\u3002\n4. \u8ba9\u5b83\u4ee4\u4eba\u6ee1\u610f\uff1a\u4e8b\u540e\u7acb\u5373\u5956\u52b1\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u58de\u7fd2\u6163\uff08\u8eba\u5728\u6c99\u767c\u4e0a\uff09**\n1. \u96b1\u5f62\uff1a\u5c07\u89f8\u767c\u56e0\u7d20\u79fb\u51fa\u8996\u91ce\u3002\n2. \u8b93\u81ea\u5df1\u8b8a\u5f97\u6c92\u6709\u5438\u5f15\u529b\uff1a\u610f\u8b58\u5230\u8ca0\u9762\u5f8c\u679c\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u56f0\u96e3\uff1a\u8a2d\u5b9a\u969c\u7919\uff08\u4f8b\u5982\u522a\u9664\u61c9\u7528\u7a0b\u5f0f\u3001\u62d4\u6389\u63d2\u982d\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6eff\u610f\uff1a\u9644\u52a0\u5211\u7f70\u57f7\u884c\u3002\n\n**\u990a\u6210\u826f\u597d\u7684\u7fd2\u6163\uff08\u4f38\u5c55\u904b\u52d5\uff09**\n1. \u4f7f\u5176\u986f\u800c\u6613\u898b\uff1a\u5c07\u89f8\u767c\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u898b\u7684\u4f4d\u7f6e\u3002\n2. \u8b93\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c07\u5b83\u8207\u4f60\u559c\u6b61\u7684\u6771\u897f\u9023\u7d50\u8d77\u4f86\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u7c21\u55ae\uff1a\u5c07\u969c\u7919\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u9418\uff09\u3002\n4. \u8b93\u5b83\u4ee4\u4eba\u6eff\u610f\uff1a\u4e8b\u5f8c\u7acb\u5373\u734e\u52f5\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.doener_dauerkarte.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widerstehe der Versuchung an jeder Ecke und w\u00e4hle gesunde Alternativen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resist the temptation at every corner and choose healthy alternatives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resiste la tentaci\u00f3n en cada esquina y elige alternativas saludables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9siste \u00e0 la tentation \u00e0 chaque coin de rue et choisis des alternatives saines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0915\u094b\u0928\u0947 \u092a\u0930 \u092a\u094d\u0930\u0932\u094b\u092d\u0928 \u0915\u093e \u0935\u093f\u0930\u094b\u0927 \u0915\u0930\u094b \u0914\u0930 \u0938\u094d\u0935\u0938\u094d\u0925 \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resisti alla tentazione ad ogni angolo e scegli alternative sane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u3089\u3086\u308b\u8a98\u60d1\u306b\u8ca0\u3051\u305a\u3001\u5065\u5eb7\u7684\u306a\u4ee3\u66ff\u54c1\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uc720\ud639\uc744 \uc774\uaca8\ub0b4\uace0 \uac74\uac15\ud55c \ub300\uc548\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weersta de verleiding op elke hoek en kies voor gezonde alternatieven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprzej pokus\u0119 na ka\u017cdym kroku i wybierz zdrowe alternatywy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resista \u00e0 tenta\u00e7\u00e3o em cada esquina e escolha alternativas saud\u00e1veis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u044f\u0439\u0442\u0435\u0441\u044c \u0438\u0441\u043a\u0443\u0448\u0435\u043d\u0438\u044f\u043c \u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u043c \u0448\u0430\u0433\u0443 \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0435 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her k\u00f6\u015fedeki cazibeye direnin ve sa\u011fl\u0131kl\u0131 alternatifleri se\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u62b5\u5236\u6bcf\u4e00\u4e2a\u8bf1\u60d1\uff0c\u9009\u62e9\u5065\u5eb7\u7684\u66ff\u4ee3\u54c1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u62b5\u6297\u6bcf\u4e00\u500b\u8a98\u60d1\uff0c\u9078\u64c7\u5065\u5eb7\u7684\u66ff\u4ee3\u54c1\u3002"
          }
        }
      }
    },
    "trash.doener_dauerkarte.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Zu viel Fast Food) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921) \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0444\u0430\u0441\u0442-\u0444\u0443\u0434\u0430) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Fast Food) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u5403\u592a\u591a\u5feb\u9910\uff09\u4f1a\u6d88\u8017\u4f60\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u5403\u592a\u591a\u5feb\u9910\uff09\u6703\u6d88\u8017\u4f60\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },

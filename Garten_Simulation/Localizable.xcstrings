            "value": "Gie\u00dfe deine Pflanzen, um Statistiken zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants to see statistics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tus plantas para ver estad\u00edsticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrose tes plantes pour voir les statistiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u092a\u093e\u0928\u0940 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants to see statistics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u306b\u6c34\u3092\u3042\u3052\u3066\u7d71\u8a08\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud1b5\uacc4\ub97c \ubcf4\ub824\uba74 \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef uw planten water om statistieken te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewaj swoje ro\u015bliny, aby zobaczy\u0107 statystyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants to see statistics."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u0438\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130statistikleri g\u00f6rmek i\u00e7in bitkilerinizi sulay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ed9\u690d\u7269\u6d47\u6c34\u4ee5\u67e5\u770b\u7edf\u8ba1\u6570\u636e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d66\u690d\u7269\u6f86\u6c34\u4ee5\u67e5\u770b\u7d71\u8a08\u6578\u64da\u3002"
          }
        }
      }
    },

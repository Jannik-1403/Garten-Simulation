        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra di che pasta sei fatto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u304c\u4f55\u3067\u3067\u304d\u3066\u3044\u308b\u304b\u3092\u898b\u305b\u3066\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc774 \ubb34\uc5c7\uc778\uc9c0 \ubcf4\uc5ec\uc8fc\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat zien waar je van gemaakt bent!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poka\u017c na co Ci\u0119 sta\u0107!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra do que \u00e9s feito!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0436\u0438, \u0447\u0442\u043e \u0432 \u0442\u0435\u0431\u0435 \u0435\u0441\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyden yap\u0131ld\u0131\u011f\u0131n\u0131 g\u00f6ster!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c55\u73b0\u4f60\u7684\u6f5c\u529b\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c55\u793a\u4f60\u662f\u7531\u4ec0\u9ebc\u7d44\u6210\u7684\uff01"
          }
        }
      }
    },

            "state": "translated",
            "value": "Combate a pontos de acesso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Борьба с горячими точками"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcak nokta mücadelesi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热点攻克"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "熱點攻克"
          }
        }
      }
    },
    "prog_cleaning_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh durch alle Räume: Mülleimer leeren, Pfandflaschen zusammenstellen, Papiermüll entsorgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go through all rooms: empty trash cans, put together returnable bottles, dispose of paper waste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre todas las habitaciones: vacía los botes de basura, junta botellas retornables, desecha los residuos de papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez toutes les pièces: videz les poubelles, rassemblez les bouteilles consignées, jetez les déchets de papier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी कमरों में घूमें: खाली कूड़ेदान, वापसी योग्य बोतलें एक साथ रखें, कागज के कचरे का निपटान करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa per tutte le stanze: svuota i bidoni della spazzatura, raccogli le bottiglie a rendere, smaltisci i rifiuti di carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての部屋を見て回ります。ゴミ箱を空にし、リターナブルボトルをまとめ、紙くずを処分します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 방을 돌아보세요. 쓰레기통을 비우고, 재활용 가능한 병을 모으고, 종이 쓰레기를 처리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop alle kamers door: prullenbakken leegmaken, statiegeldflessen samenstellen, papierafval weggooien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź się po wszystkich pomieszczeniach: opróżnij kosze na śmieci, złóż butelki zwrotne, pozbądź się makulatury."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorra todos os cômodos: esvazie lixeiras, junte garrafas retornáveis, descarte resíduos de papel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorra todos os cômodos: esvazie lixeiras, junte garrafas retornáveis, descarte resíduos de papel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдитесь по всем комнатам: опустошите мусорные баки, соберите многоразовые бутылки, выбросьте бумажные отходы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm odaları inceleyin: çöp kutularını boşaltın, depozitolu şişeleri bir araya getirin, kağıt atıklarını atın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有房间：清空垃圾桶、整理可回收瓶子、处理废纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有房間：清空垃圾桶、整理可回收瓶子、處理廢紙。"
          }
        }
      }
    },

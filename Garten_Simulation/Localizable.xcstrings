    "plant.efeu.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breitet sich langsam aber stetig aus – tägliches Dehnen"

    "assessment.mental.profile.unerschuetterlicher.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deinen Kurs. Du bist auf dem richtigen Weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay your course. You are on the right path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tu rumbo. Estás en el camino correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre cap. Vous êtes sur la bonne voie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने रास्ते पर रहो. आप सही रास्ते पर हैं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la tua rotta. Sei sulla strada giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コースを維持してください。あなたは正しい道を歩んでいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 길을 유지하십시오. 당신은 올바른 길을 가고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf op koers. Je bent op de goede weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj swój kurs. Jesteś na dobrej drodze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha seu curso. Você está no caminho certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держи курс. Ты идёшь правильным путём."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotanızda kalın. Doğru yoldasın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坚持你的航向。你正在正确的道路上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "堅持你的路線。你走在正確的道路上。"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeide es, in Diskussionen immer das letzte Wort haben zu wollen – überlass den 1％ Raum dem anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid always wanting to have the last word in discussions - leave the 1％ space to the other person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite querer siempre tener la última palabra en las discusiones: deje el 1％ de espacio a la otra persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez de toujours vouloir avoir le dernier mot dans les discussions - laissez l'espace de 1％ à l'autre personne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चर्चाओं में हमेशा अंतिम शब्द बोलने की चाहत से बचें - 1％ स्थान दूसरे व्यक्ति के लिए छोड़ दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita di voler avere sempre l'ultima parola nelle discussioni: lascia lo spazio dell'1％ all'altra persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "議論の中で常に最後の言葉を言いたいと思うのは避けてください。1％ のスペースは他の人に任せてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토론에서 항상 마지막 말을 하고 싶어하지 마십시오. 1％의 공간을 다른 사람에게 남겨두십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermijd altijd het laatste woord te willen hebben in discussies; laat de ruimte van 1％ aan de ander over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj chęci posiadania zawsze ostatniego słowa w dyskusjach – zostaw 1％ miejsca drugiej osobie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite sempre querer ter a última palavra nas discussões – deixe o espaço de 1％ para a outra pessoa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избегай стремления всегда иметь последнее слово в обсуждениях – оставь 1％ пространства другому."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartışmalarda her zaman son sözü söylemekten kaçının; ％1'lik alanı diğer kişiye bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免在讨论中总是想要说最后一句话——把1％的空间留给对方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免總是想在討論中擁有最後發言權——把 1％ 的空間留給對方。"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm dir täglich 2 Minuten Zeit, um den Erfolg eines anderen ehrlich zu loben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take 2 minutes a day to honestly praise someone else's success."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómate 2 minutos al día para elogiar honestamente el éxito de otra persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez 2 minutes par jour pour féliciter honnêtement le succès de quelqu'un d'autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी और की सफलता की ईमानदारी से प्रशंसा करने के लिए प्रतिदिन 2 मिनट का समय निकालें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenditi 2 minuti al giorno per lodare onestamente il successo di qualcun altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 日 2 分間、他人の成功を正直に褒めてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 2분씩 다른 사람의 성공을 솔직하게 칭찬해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

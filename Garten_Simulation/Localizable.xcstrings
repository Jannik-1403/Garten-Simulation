    "calendar.auth.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy ben\u00f6tigt Zugriff auf deinen Kalender, um Termine anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy needs access to your calendar to display events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy necesita acceso a tu calendario para mostrar eventos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy a besoin d'acc\u00e9der \u00e0 votre calendrier pour afficher les \u00e9v\u00e9nements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0935\u0947\u0902\u091f \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0917\u094d\u0930\u094b\u0935\u0940 \u0915\u094b \u0906\u092a\u0915\u0947 \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy ha bisogno dell'accesso al tuo calendario per mostrare gli eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy\u306f\u30a4\u30d9\u30f3\u30c8\u3092\u8868\u793a\u3059\u308b\u305f\u3081\u306b\u30ab\u30ec\u30f3\u30c0\u30fc\u3078\u306e\u30a2\u30af\u30bb\u30b9\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubca4\ud2b8\ub97c \ud45c\uc2dc\ud558\ub824\uba74 Grovy\uac00 \uce98\ub9b0\ub354\uc5d0 \uc561\uc138\uc2a4\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy heeft toegang tot je agenda nodig om afspraken weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy potrzebuje dost\u0119pu do kalendarza, aby wy\u015bwietla\u0107 wydarzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy precisa acessar o seu calend\u00e1rio para exibir eventos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0432\u0430\u0448\u0435\u043c\u0443 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044e, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c \u0432\u0441\u0442\u0440\u0435\u0447\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy'nin etkinlikleri g\u00f6sterebilmesi i\u00e7in takviminize eri\u015fmesi gerekiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy \u9700\u8981\u8bbf\u95ee\u4f60\u7684\u65e5\u5386\u4ee5\u663e\u793a\u65e5\u7a0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy \u9700\u8981\u5b58\u53d6\u60a8\u7684\u65e5\u66c6\u624d\u80fd\u67e5\u770b\u4e8b\u4ef6\u3002"
          }
        }
      }
    },

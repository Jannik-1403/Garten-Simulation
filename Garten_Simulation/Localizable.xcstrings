        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 흡연 비용을 계산하세요: 대신 무엇을 살 수 있을까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken het maandelijkse rookbedrag: wat zou je in plaats daarvan kunnen kopen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblicz miesięczny koszt palenia: co mógłbyś zamiast tego kupić?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule o custo mensal de fumar: o que você poderia comprar em vez disso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule o custo mensal de fumar: o que você poderia comprar em vez disso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведите ежемесячное количество выкуриваемого дыма: что вы могли бы купить вместо этого?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık sigara maliyetini hesapla: bunun yerine ne alabilirdin?"
          }
        },
        "zh-Hans": {

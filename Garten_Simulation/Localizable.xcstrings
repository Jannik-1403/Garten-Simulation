    "onboarding_custom_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen eigenen Gewohnheiten einen Namen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your own habits a name!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Nombra tus propios h\u00e1bitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne un nom \u00e0 tes propres habitudes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u090f\u0915 \u0928\u093e\u092e \u0926\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your own habits a name!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u7fd2\u6163\u306b\u540d\u524d\u3092\u4ed8\u3051\u3066\u307f\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc2b5\uad00\uc5d0 \uc774\ub984\uc744 \uc9c0\uc5b4\ubcf4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je eigen gewoontes een naam!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwij swoje nawyki!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e1 um nome aos teus pr\u00f3prios h\u00e1bitos!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0430\u0439 \u0441\u0432\u043e\u0438\u043c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c \u0438\u043c\u044f!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi al\u0131\u015fkanl\u0131klar\u0131n\u0131za bir isim verin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ed9\u4f60\u7684\u4e60\u60ef\u547d\u540d\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d66\u81ea\u5df1\u7684\u7fd2\u6163\u53d6\u500b\u540d\u5b57\uff01"
          }
        }
      }
    },

          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Je le ferai...' ou 'Je le ferai...'"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u092e\u0948\u0902 \u0915\u0930\u0942\u0902\u0917\u093e...' \u092f\u093e '\u092e\u0948\u0902 \u0915\u0930\u0942\u0902\u0917\u093e...'"

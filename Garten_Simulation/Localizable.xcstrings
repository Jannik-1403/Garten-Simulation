    "prog_selfcare_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib drei Dinge auf, die du diese Woche an dir selbst gut fandest. Kein Eigenlob ist heute übertrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down three things you liked about yourself this week. No amount of self-praise is exaggerated today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tres cosas que te gustaron de ti esta semana. Hoy en día no se exagera ninguna cantidad de autoelogio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez trois choses que vous avez aimées chez vous cette semaine. Aucune louange n’est exagérée aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सप्ताह आपको अपने बारे में तीन चीज़ें पसंद आईं जो आपको पसंद आईं। आज आत्म-प्रशंसा की कोई भी मात्रा अतिरंजित नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi tre cose che ti sono piaciute di te questa settimana. Nessuna quantità di autoelogio è esagerata oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週、自分について気に入った点を 3 つ書き出してください。今日、いくら自画自賛しても誇張ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 자신에 대해 마음에 들었던 점 세 가지를 적어보세요. 오늘날에는 자기 칭찬이 아무리 과장되어도 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf deze week drie dingen op die je leuk vond aan jezelf. Geen enkele hoeveelheid zelflof wordt tegenwoordig overdreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz trzy rzeczy, które lubisz w sobie w tym tygodniu. Żadne samochwalenie się nie jest dziś przesadzone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva três coisas que você gostou em você esta semana. Nenhuma quantidade de auto-elogio é exagerada hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva três coisas que você gostou em você esta semana. Nenhuma quantidade de auto-elogio é exagerada hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите три вещи, которые вам понравились в себе на этой неделе. Никакая самооценка сегодня не преувеличена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta kendinizle ilgili beğendiğiniz üç şeyi yazın. Bugün hiçbir kendini övme abartılı değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下本周你喜欢自己的三件事。今天，再多的自我赞扬都不过分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下本週你喜歡自己的三件事。今天，再多的自我讚揚都不過分。"
          }
        }
      }
    },

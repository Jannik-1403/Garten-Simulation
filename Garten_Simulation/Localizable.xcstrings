        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajomość sieci. Teraz uczysz się złożonych połączeń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta conhecimentos. Estás agora a aprender ligações complexas."

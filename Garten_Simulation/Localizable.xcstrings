    "plant.brennnessel.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schmerzt kurz, macht unkaputtbar – Kaltdusche + Gym Kombo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stings briefly, makes unbreakable – Cold shower + gym combo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duele un momento, te vuelve irrompible – Ducha fría + gym"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pique brièvement, rend indestructible – Douche froide + salle de sport"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़े समय के लिए दर्द, इसे अविनाशी बनाता है - ठंडा स्नान + जिम कॉम्बो"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stings briefly, makes unbreakable – Cold shower + gym combo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短時間刺すだけで壊れなくなる – 冷水シャワーとジムの組み合わせ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠깐 찌르면 깨지지 않게 됩니다 – 냉수 샤워 + 체육관 콤보"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikt kort, maakt onbreekbaar – Koude douche + gym combo"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kłuje krótko, czyni niezniszczalnym – połączenie zimnego prysznica i siłowni"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arde brevemente, torna-te inquebrável – Duche frio + ginásio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Болит недолго, делает неуязвимым – комбинация холодного душа и тренажерного зала"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısa süreliğine acıtır, kırılmaz hale getirir – Soğuk duş + spor salonu kombinasyonu"
          }
        },
        "zh-Hans" : {

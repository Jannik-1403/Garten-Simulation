    "trash.endlos_scroll_tv.tip.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege die Fernbedienung in eine Schublade – nicht griffbereit auf dem Sofa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the remote control in a drawer – not within easy reach on the sofa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el mando a distancia en un cajón, no al alcance de la mano en el sofá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Range la télécommande dans un tiroir – pas à portée de main sur le canapé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमोट को ड्रा में रखो – सोफ़े पर आसानी से पहुँच में न हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti il telecomando in un cassetto – non a portata di mano sul divano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモコンを引き出しに入れておきましょう。ソファの手の届くところには置かないようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리모컨을 서랍에 넣어두세요 – 소파에서 쉽게 닿을 수 있는 곳에 두지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg de afstandsbediening in een la – niet binnen handbereik op de bank."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włóż pilota do szuflady – nie w zasięgu ręki na kanapie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o controle remoto em uma gaveta – não ao alcance fácil no sofá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите пульт дистанционного управления в дальний ящик дивана."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzaktan kumandayı bir çekmeceye koy – koltukta kolayca ulaşılabilir bir yerde değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将遥控器放在抽屉里，放在沙发上够不到的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將遙控器放在抽屜裡，放在沙發上搆不到的地方。"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle bewusst: Frage dich vor dem Einschalten, ob es sich lohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll consciously: ask yourself before turning it on if it's worth it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate conscientemente: pregúntate antes de encenderlo si vale la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais défiler consciemment : demande-toi avant d'allumer si ça vaut la peine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सजग रूप से स्क्रॉल करें: चालू करने से पहले अपने आप से पूछें कि क्या यह इसके लायक है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri consapevolmente: chiediti prima di accenderlo se ne vale la pena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意識的にスクロールしましょう。電源を入れる前に、それだけの価値があるかどうか自問しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의식적으로 스크롤하세요: 켜기 전에 그럴 가치가 있는지 자문해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll bewust: vraag jezelf af of het de moeite waard is voordat je het aanzet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewijaj świadomie: zapytaj siebie przed włączeniem, czy to się opłaca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role conscientemente: pergunte-se antes de ligar se vale a pena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пролистывайте осознанно: прежде чем включаться, спросите себя, стоит ли оно того."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinçli kaydır: açmadan önce buna değip değmediğini kendinize sorun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有意识地滚动：在打开之前，问问自己这是否值得。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有意識地滾動：在打開之前，問問自己這是否值得。"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze einen Timer: Stelle eine Stunde ein – danach automatisch ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a timer: set one hour – then automatically turn off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un temporizador: pon una hora y luego apaga automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise un minuteur : règle une heure – puis éteins automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक टाइमर का उपयोग करें: एक घंटे के लिए सेट करें – इसके बाद अपने आप बंद हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un timer: imposta un'ora – poi spegni automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーを使いましょう。1時間に設定して、その後は自動的にオフにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머를 사용하세요: 1시간을 설정하고 – 그 후 자동으로 꺼지게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een timer: stel een uur in – daarna automatisch uitschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj timera: ustaw godzinę – potem automatycznie wyłącz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um temporizador: defina uma hora – depois desligue automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте таймер: установите час – затем выключитесь автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcı kullan: bir saat ayarla – sonra otomatik olarak kapat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用定时器：设置一个小时 - 然后自动关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用定時器：設定一個小時 - 然後自動關閉。"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe ein TV-Tagebuch: Was hast du gestern geschaut? War es wert?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a TV diary: what did you watch yesterday? Was it worth it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva un diario de TV: ¿qué viste ayer? ¿Valió la pena?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiens un journal télévisé : qu'as-tu regardé hier ? Ça valait le coup ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टीवी डायरी बनाएं: आपने कल क्या देखा? क्या यह इसके लायक था?"
          }
        },
        "it" : {
          "stringUnit" : {

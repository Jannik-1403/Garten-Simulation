    "trash.online_shopping_app.obj_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein beruhigender Seerosenteich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calming lily pond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relajante estanque de lirios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mare aux n\u00e9nuphars apaisante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0936\u093e\u0902\u0924\u093f\u092a\u0942\u0930\u094d\u0923 \u0915\u092e\u0932 \u0915\u093e \u0924\u093e\u0932\u093e\u092c\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rilassante stagno di ninfee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u843d\u3061\u7740\u304f\u7761\u84ee\u306e\u6c60\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3c9\uc628\ud55c \ubc31\ud569 \uc5f0\ubabb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustgevende lelievijver."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspokajaj\u0105cy staw z liliami wodnymi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lago de nen\u00fafares relaxante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u043f\u043e\u043a\u0430\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u043f\u0440\u0443\u0434 \u0441 \u043a\u0443\u0432\u0448\u0438\u043d\u043a\u0430\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlendirici bir zambak g\u00f6leti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u9759\u7684\u7761\u83b2\u6c60\u3002"
          }

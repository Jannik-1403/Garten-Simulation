    "assessment.mental.q6" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dir ein extrem ambitioniertes Ziel gesetzt. Deine engsten Freunde sagen dir ins Gesicht, dass du das niemals schaffen wirst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have set yourself an extremely ambitious goal. Your closest friends tell you to your face that you'll never make it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te has fijado un objetivo extremadamente ambicioso. Tus amigos más cercanos te dicen en la cara que nunca lo lograrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes fixé un objectif extrêmement ambitieux. Vos amis les plus proches vous disent en face que vous n’y arriverez jamais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने अपने लिए एक अत्यंत महत्वाकांक्षी लक्ष्य निर्धारित किया है। आपके सबसे करीबी दोस्त आपके चेहरे पर आपसे कहते हैं कि आप कभी सफल नहीं होंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti sei posto un obiettivo estremamente ambizioso. I tuoi amici più cari ti dicono in faccia che non ce la farai mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは非常に野心的な目標を自分自身に設定しました。あなたの親しい友人たちは、あなたには決して成功しないだろうと面と向かって言います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 매우 야심 찬 목표를 세웠습니다. 당신의 가장 가까운 친구들은 당신이 결코 성공하지 못할 것이라고 대면하여 말합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt jezelf een uiterst ambitieus doel gesteld. Je beste vrienden vertellen je in je gezicht dat je het nooit zult redden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postawiłeś sobie niezwykle ambitny cel. Najbliżsi przyjaciele mówią ci prosto w twarz, że nigdy ci się nie uda."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você estabeleceu uma meta extremamente ambiciosa. Seus amigos mais próximos dizem na sua cara que você nunca conseguirá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты поставил перед собой крайне амбициозную цель. Твои близкие друзья прямо говорят тебе в лицо, что ты никогда этого не добьёшься."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendinize son derece iddialı bir hedef belirlediniz. En yakın arkadaşlarınız yüzünüze asla başaramayacağınızı söyler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你给自己定了一个极具雄心的目标。你最亲密的朋友当面告诉你，你永远都做不到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您為自己設定了一個極為雄心勃勃的目標。你最親密的朋友當面告訴你，你永遠不會成功。"
          }
        }
      }
    },
    "assessment.mental.q6.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich lasse es sein. Wenn meine Freunde nicht daran glauben, wird es wohl stimmen."
          }

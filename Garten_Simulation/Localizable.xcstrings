        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczone przez 2 minuty rano i wieczorem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpo por 2 minutos de manhã e à noite"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpo por 2 minutos de manhã e à noite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уборка за 2 минуты утром и вечером."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah ve akşam 2 dakika temizlendi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早晚清洁2分钟"
          }
        },
        "zh-Hant": {

    "fitness.running.detail.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute noch keine Laufeinheit. Ein kurzer 20-Minuten-Lauf reicht für den Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No running session today. A short 20-minute run is enough for the day."
          }
        },
        "es": {

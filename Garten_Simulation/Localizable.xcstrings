          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je vandaag %@ minuten meer gefocust dan gisteren. Ga zo door!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupi\u0142e\u015b si\u0119 dzisiaj o %@ minut wi\u0119cej ni\u017c wczoraj. Tak trzymaj!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje voc\u00ea se concentrou %@ minutos a mais do que ontem. Continue assim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0442\u044b \u0431\u044b\u043b \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d \u043d\u0430%@\u043c\u0438\u043d\u0443\u0442 \u0434\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0432\u0447\u0435\u0440\u0430. \u0422\u0430\u043a \u0434\u0435\u0440\u0436\u0430\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn d\u00fcnden %@ dakika daha fazla odakland\u0131n\u0131z. Aynen b\u00f6yle devam edin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u4eca\u5929\u6bd4\u6628\u5929\u66f4\u591a\u5730\u5173\u6ce8%@\u5206\u949f\u3002\u7ee7\u7eed\u52aa\u529b\u5427\uff01"

    "assessment.feedback.excellent.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Grundlagen in diesem Bereich sind extrem stark. Behalte diese positiven Gewohnheiten unbedingt bei, um dein Level zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your foundations in this area are extremely strong. Keep up these positive habits to maintain your level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus bases en este ámbito son extremadamente fuertes. Mantén estos hábitos positivos para conservar tu nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos bases dans ce domaine sont extrêmement solides. Conservez ces habitudes positives pour maintenir votre niveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्षेत्र में आपके बुनियादी सिद्धांत बेहद मजबूत हैं। अपने स्तर को बनाए रखने के लिए इन सकारात्मक आदतों को अवश्य बनाए रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue basi in questa area sono estremamente solide. Mantieni queste abitudini positive per mantenere il tuo livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この分野におけるあなたの基礎は非常に強固です。そのレベルを維持するために、これらの良い習慣を続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 분야에서 당신의 기초는 매우 튼튼합니다. 당신의 수준을 유지하기 위해 이러한 긍정적인 습관을 유지하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je basis in dit gebied is extreem sterk. Blijf deze positieve gewoonten behouden om je niveau te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje podstawy w tym obszarze są niezwykle silne. Utrzymaj te pozytywne nawyki, aby utrzymać swój poziom."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas bases nesta área são extremamente fortes. Mantém estes hábitos positivos para conservares o teu nível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои основы в этой области крайне сильны. Обязательно сохраняй эти положительные привычки, чтобы поддерживать свой уровень."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu alandaki temelleriniz son derece sağlam. Seviyenizi korumak için bu olumlu alışkanlıkları sürdürün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在这个领域的基础非常扎实。一定要保持这些积极的习惯，以维持你的水平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在這方面的基礎非常紮實。一定要保持這些積極的習慣來保持你的水平。"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "Why did you stop using the app?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u306a\u305c\u30a2\u30d7\u30ea\u306e\u4f7f\u7528\u3092\u3084\u3081\u305f\u306e\u3067\u3059\u304b?"

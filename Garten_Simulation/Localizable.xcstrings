    "assessment.mental.profile.spiegel.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sage jeden Tag zu einer winzigen, absolut unwichtigen Anfrage 'Nein', nur um die Ablehnung zu üben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say \"no\" to a tiny, absolutely unimportant request every day just to practice rejection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di \"no\" a una pequeña petición, absolutamente sin importancia, todos los días sólo para practicar el rechazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « non » chaque jour à une petite demande absolument sans importance, juste pour vous entraîner au rejet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्वीकृति का अभ्यास करने के लिए हर दिन एक छोटे, बिल्कुल महत्वहीन अनुरोध को \"नहीं\" कहें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' \"no\" ogni giorno a una piccola richiesta assolutamente insignificante solo per esercitarti nel rifiuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断る練習をするために、小さな、まったく重要ではないリクエストには毎日「ノー」と言いましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거절을 연습하기 위해 매일 사소하고 전혀 중요하지 않은 요청에 \"아니오\"라고 말하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg elke dag 'nee' tegen een klein, absoluut onbelangrijk verzoek, alleen maar om afwijzing te oefenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codziennie mów „nie” drobnej, absolutnie nieistotnej prośbie, aby poćwiczyć odmowę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “não” a um pedido minúsculo e absolutamente sem importância todos os dias apenas para praticar a rejeição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день говори «нет» маленькой, совершенно неважной просьбе, просто чтобы попрактиковаться в отказе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırf reddetme alıştırması yapmak için her gün küçük, kesinlikle önemsiz bir isteğe \"hayır\" deyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天对一个微小、绝对不重要的请求说“不要”，只是为了练习拒绝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天對一個微小的、絕對不重要的請求說“不”，只是為了練習拒絕。"
          }
        }
      }
    },
    "assessment.mental.profile.spiegel.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Selbstwert ist fremdgesteuert. Um Unabhängigkeit aufzubauen, musst du den 'Muskel der Ablehnung' in homöopathischen Dosen trainieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your self-worth is externally controlled. To build independence, you need to train the 'rejection muscle' in homeopathic doses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu autoestima está controlada externamente. Para desarrollar la independencia, es necesario entrenar el \"músculo del rechazo\" en dosis homeopáticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre estime de soi est contrôlée de l’extérieur. Pour développer votre indépendance, vous devez entraîner le « muscle du rejet » à des doses homéopathiques."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका आत्म-सम्मान बाहरी रूप से नियंत्रित होता है। स्वतंत्रता का निर्माण करने के लिए, आपको होम्योपैथिक खुराक में 'अस्वीकृति मांसपेशी' को प्रशिक्षित करने की आवश्यकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua autostima è controllata dall’esterno. Per costruire l'indipendenza, è necessario allenare il \"muscolo del rigetto\" in dosi omeopatiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの自尊心は外部からコントロールされます。自立心を築くには、ホメオパシーの用量で「拒絶筋」を鍛える必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 자존감은 외부적으로 통제됩니다. 독립성을 키우려면 동종요법 복용량으로 '거부 근육'을 훈련해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je eigenwaarde wordt extern gecontroleerd. Om onafhankelijkheid op te bouwen, moet je de ‘afstotingsspier’ trainen in homeopathische doses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja samoocena jest kontrolowana z zewnątrz. Aby zbudować niezależność, trzeba ćwiczyć „mięsień odrzucający” w dawkach homeopatycznych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua autoestima é controlada externamente. Para construir independência, é preciso treinar o “músculo da rejeição” em doses homeopáticas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя самооценка управляется извне. Чтобы обрести независимость, тебе нужно тренировать 'мышцу отказа' в гомеопатических дозах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendinize verdiğiniz değer dışarıdan kontrol edilir. Bağımsızlığı inşa etmek için 'reddetme kasını' homeopatik dozlarda çalıştırmanız gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的自我价值是被他人控制的。为了建立独立性，你必须以微量的方式锻炼“拒绝的肌肉”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的自我價值是由外在控制的。為了建立獨立性，您需要以順勢療法劑量訓練「拒絕肌肉」。"
          }
        }
      }
    },

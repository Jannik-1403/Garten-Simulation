        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3일 동안 자동으로 잡초를 제거해 주는 마술 지팡이입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

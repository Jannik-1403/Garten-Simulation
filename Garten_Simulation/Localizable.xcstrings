        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phone on 'Do Not Disturb' and place it out of sight after this setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu teléfono en 'No molestar' y colócalo fuera de la vista después de esta configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez votre téléphone sur 'Ne pas déranger' et placez-le hors de vue après cette configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब अपने फोन को 'परेशान न करें' पर स्विच करें और इस सेटअप के बाद इसे दृष्टि से दूर रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il telefono in 'Non disturbare' e mettilo fuori dalla vista dopo questa configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定後は、スマートフォンを「おやすみモード」にして見えない場所に置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정 후에는 휴대폰을 '방해 금지 모드'로 설정하고 보이지 않는 곳에 두십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je telefoon op 'Niet storeen' en leg hem na deze installatie uit het zicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tej konfiguracji przełącz telefon w tryb „Nie przeszkadzać” i odłóż go z pola widzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o seu telefone em 'Não incomodar' e coloque-o fora de vista após esta configuração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o seu telefone em 'Não incomodar' e coloque-o fora de vista após esta configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь включи на своём телефоне режим «Не беспокоить» и убери его из поля зрения после этой настройки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumdan sonra telefonunuzu 'Rahatsız Etmeyin' moduna alın ve gözden uzak bir yere koyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在将手机设置为“勿扰模式”，并在设置完成后将其放置在视线之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，將您的手機切換為“請勿打擾”，並在完成此設定後將其放在看不見的地方。"
          }
        }
      }
    },

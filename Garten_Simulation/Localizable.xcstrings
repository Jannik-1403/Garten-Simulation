    "assessment.lifestyle.q13": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du sprichst, was machen die Leute in deinem Umfeld?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you speak, what do the people around you do?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hablas, \u00bfqu\u00e9 hacen las personas que te rodean?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous parlez, que font les gens autour de vous ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u092c \u0906\u092a \u092c\u094b\u0932\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0906\u092a\u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0915\u0947 \u0932\u094b\u0917 \u0915\u094d\u092f\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando parli, cosa fanno le persone intorno a te?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u304c\u8a71\u3057\u3066\u3044\u308b\u3068\u304d\u3001\u3042\u306a\u305f\u306e\u5468\u308a\u306e\u4eba\u305f\u3061\u306f\u4f55\u3092\u3057\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc774 \ub9d0\ud560 \ub54c, \uc8fc\ubcc0 \uc0ac\ub78c\ub4e4\uc740 \ubb34\uc5c7\uc744 \ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat doen de mensen om je heen als je spreekt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy m\u00f3wisz, co robi\u0105 ludzie wok\u00f3\u0142 ciebie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando voc\u00ea fala, o que as pessoas ao seu redor fazem?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0448\u044c, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u044e\u0442 \u043b\u044e\u0434\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u0442\u0435\u0431\u044f?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz konu\u015furken \u00e7evrenizdeki insanlar ne yap\u0131yor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u4f60\u8bf4\u8bdd\u65f6\uff0c\u4f60\u5468\u56f4\u7684\u4eba\u5728\u505a\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7576\u4f60\u8aaa\u8a71\u6642\uff0c\u4f60\u5468\u570d\u7684\u4eba\u6703\u505a\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q13.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie unterbrechen mich st\u00e4ndig oder schauen aufs Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They constantly interrupt me or look at my cell phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me interrumpen constantemente o miran mi celular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils m'interrompent constamment ou regardent mon t\u00e9l\u00e9phone portable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947 \u0932\u0917\u093e\u0924\u093e\u0930 \u092e\u0941\u091d\u0947 \u091f\u094b\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u092e\u0947\u0930\u0947 \u0938\u0947\u0932 \u092b\u094b\u0928 \u0915\u094b \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi interrompono costantemente o guardano il mio cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f7c\u3089\u306f\u5e38\u306b\u79c1\u306e\u90aa\u9b54\u3092\u3057\u305f\u308a\u3001\u79c1\u306e\u643a\u5e2f\u96fb\u8a71\u3092\u898b\u305f\u308a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub4e4\uc740 \ub04a\uc784\uc5c6\uc774 \ub098\ub97c \ubc29\ud574\ud558\uac70\ub098 \ub0b4 \ud734\ub300\ud3f0\uc744 \ubd05\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze onderbreken me voortdurend of kijken naar mijn mobiele telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci\u0105gle mi przerywaj\u0105 lub patrz\u0105 na m\u00f3j telefon kom\u00f3rkowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles constantemente me interrompem ou olham para o meu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043c\u0435\u043d\u044f \u043f\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u0435\u0442\u0435 \u0438\u043b\u0438 \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0432 \u0442\u0435\u043b\u0435\u0444\u043e\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00fcrekli s\u00f6z\u00fcm\u00fc kesiyorlar ya da cep telefonuma bak\u0131yorlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4eec\u4e00\u76f4\u6253\u65ad\u6211\u6216\u8005\u770b\u624b\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u5011\u7d93\u5e38\u6253\u65b7\u6211\u6216\u770b\u6211\u7684\u624b\u6a5f\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q13.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie h\u00f6ren halb zu, aber meine Meinung hat wenig Gewicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're half-listening, but my opinion carries little weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s escuchando a medias, pero mi opini\u00f3n tiene poco peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous m'\u00e9coutez \u00e0 moiti\u00e9, mais mon avis n'a que peu de poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0906\u0927\u093e-\u0905\u0927\u0942\u0930\u093e \u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092e\u0947\u0930\u0940 \u0930\u093e\u092f \u0915\u093e \u0915\u094b\u0908 \u092e\u0939\u0924\u094d\u0935 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai ascoltando a met\u00e0, ma la mia opinione ha poco peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u534a\u5206\u805e\u3044\u3066\u3044\u308b\u3088\u3046\u3067\u3059\u304c\u3001\u79c1\u306e\u610f\u898b\u306b\u306f\u307b\u3068\u3093\u3069\u91cd\u307f\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ubc18\ub9cc \ub4e3\uace0 \uc788\uc9c0\ub9cc \ub0b4 \uc758\uacac\uc740 \ubcc4\ub85c \uc911\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je luistert maar half, maar mijn mening heeft weinig gewicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cz\u0119\u015bciowo s\u0142uchasz, ale moja opinia nie ma wi\u0119kszego znaczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 ouvindo pela metade, mas minha opini\u00e3o tem pouco peso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b \u0441\u043b\u0443\u0448\u0430\u0435\u0442\u0435 \u043d\u0430\u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443, \u043d\u043e \u043c\u043e\u0451 \u043c\u043d\u0435\u043d\u0438\u0435 \u0438\u043c\u0435\u0435\u0442 \u043c\u0430\u043b\u043e \u0432\u0435\u0441\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yar\u0131 dinliyorsunuz ama benim fikrimin pek bir \u00f6nemi yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4eec\u534a\u542c\u534a\u4e0d\u542c\uff0c\u4f46\u6211\u7684\u610f\u89c1\u5206\u91cf\u4e0d\u5927\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u53ea\u807d\u4e86\u4e00\u534a\uff0c\u4f46\u6211\u7684\u610f\u898b\u6c92\u6709\u4ec0\u9ebc\u5206\u91cf\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q13.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie h\u00f6ren normal zu, wie bei jedem anderen auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They listen normally, like everyone else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchan normalmente, como todos los dem\u00e1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils \u00e9coutent normalement, comme tout le monde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947 \u0939\u0930 \u0915\u093f\u0938\u0940 \u0915\u0940 \u0924\u0930\u0939 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0938\u0941\u0928\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascoltano normalmente, come tutti gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f7c\u3089\u306f\u4ed6\u306e\u307f\u3093\u306a\u3068\u540c\u3058\u3088\u3046\u306b\u3001\u666e\u901a\u306b\u8a71\u3092\u805e\u3044\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub4e4\uc740 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\ucc98\ub7fc \uc815\uc0c1\uc801\uc73c\ub85c \ub4e3\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze luisteren normaal, net als iedereen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0142uchaj\u0105 normalnie, jak wszyscy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles ouvem normalmente, como todo mundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043d\u0438 \u0441\u043b\u0443\u0448\u0430\u044e\u0442 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e, \u043a\u0430\u043a \u0438 \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes gibi normal bir \u015fekilde dinlerler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u50cf\u5bf9\u5f85\u5176\u4ed6\u4eba\u4e00\u6837\u6b63\u5e38\u5730\u542c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u5011\u50cf\u5176\u4ed6\u4eba\u4e00\u6a23\u6b63\u5e38\u50be\u807d\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q13.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum wird still und man achtet auf das, was ich sage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room becomes quiet and people pay attention to what I say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La habitaci\u00f3n se queda en silencio y la gente presta atenci\u00f3n a lo que digo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pi\u00e8ce devient silencieuse et les gens font attention \u00e0 ce que je dis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092e\u0930\u093e \u0936\u093e\u0902\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0932\u094b\u0917 \u092e\u0947\u0930\u0940 \u092c\u093e\u0924\u094b\u0902 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stanza diventa silenziosa e le persone prestano attenzione a ci\u00f2 che dico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5c4b\u306f\u9759\u304b\u306b\u306a\u308a\u3001\u4eba\u3005\u306f\u79c1\u306e\u8a00\u3046\u3053\u3068\u306b\u6ce8\u610f\u3092\u6255\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc29\uc740 \uc870\uc6a9\ud574\uc9c0\uace0 \uc0ac\ub78c\ub4e4\uc740 \ub0b4\uac00 \ub9d0\ud558\ub294 \uac83\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt stil in de kamer en mensen letten op wat ik zeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pokoju robi si\u0119 cicho i ludzie zwracaj\u0105 uwag\u0119 na to, co m\u00f3wi\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala fica silenciosa e as pessoas prestam aten\u00e7\u00e3o ao que eu digo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043c\u043d\u0430\u0442\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0442\u0438\u0445\u043e\u0439, \u0438 \u0432\u0441\u0435 \u043e\u0431\u0440\u0430\u0449\u0430\u044e\u0442 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u044f \u0433\u043e\u0432\u043e\u0440\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oda sessizle\u015fiyor ve insanlar s\u00f6ylediklerime dikkat ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u623f\u95f4\u5b89\u9759\u4e0b\u6765\uff0c\u4eba\u4eec\u6ce8\u610f\u542c\u6211\u8bf4\u7684\u8bdd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u623f\u9593\u8b8a\u5f97\u5b89\u975c\uff0c\u4eba\u5011\u958b\u59cb\u6ce8\u610f\u6211\u8aaa\u7684\u8a71\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q14": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst eine mittelm\u00e4\u00dfige Note, schlie\u00dft ein Projekt 'nur okay' ab oder bist mit deiner Form unzufrieden. Deine Reaktion?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get a mediocre grade, complete a project just okay, or are dissatisfied with your form. Your reaction?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtienes una calificaci\u00f3n mediocre, completas un proyecto sin problemas o no est\u00e1s satisfecho con tu formulario. \u00bfTu reacci\u00f3n?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous obtenez une note m\u00e9diocre, terminez un projet sans probl\u00e8me ou n'\u00eates pas satisfait de votre formulaire. Votre r\u00e9action ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u094b \u0914\u0938\u0924 \u0917\u094d\u0930\u0947\u0921 \u092e\u093f\u0932\u0924\u093e \u0939\u0948, \u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0920\u0940\u0915-\u0920\u093e\u0915 \u092a\u0942\u0930\u093e \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948, \u092f\u093e \u0906\u092a \u0905\u092a\u0928\u0947 \u092b\u0949\u0930\u094d\u092e \u0938\u0947 \u0905\u0938\u0902\u0924\u0941\u0937\u094d\u091f \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un voto mediocre, completi un progetto senza problemi o sei insoddisfatto del tuo modulo. La tua reazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u51e1\u306a\u6210\u7e3e\u3057\u304b\u5f97\u3089\u308c\u306a\u304b\u3063\u305f\u308a\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u307e\u3042\u307e\u3042\u3067\u5b8c\u4e86\u3057\u305f\u308a\u3001\u81ea\u5206\u306e\u6210\u7e3e\u306b\u4e0d\u6e80\u304c\u3042\u3063\u305f\u308a\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u53cd\u5fdc\u306f\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ud3c9\ubc94\ud55c \uc131\uc801\uc744 \ubc1b\uc558\uac70\ub098, \ud504\ub85c\uc81d\ud2b8\ub97c \uad1c\ucc2e\uac8c \uc644\ub8cc\ud588\uac70\ub098, \ub2f9\uc2e0\uc758 \uc591\uc2dd\uc5d0 \ub9cc\uc871\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ubc18\uc751\uc740?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je haalt een middelmatig cijfer, voltooit een project prima, of bent ontevreden over je formulier. Jouw reactie?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostajesz przeci\u0119tn\u0105 ocen\u0119, udaje Ci si\u0119 uko\u0144czy\u0107 projekt albo jeste\u015b niezadowolony ze swojej formy. Twoja reakcja?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea obt\u00e9m uma nota med\u00edocre, conclui um projeto corretamente ou est\u00e1 insatisfeito com seu formul\u00e1rio. Sua rea\u00e7\u00e3o?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c \u0441\u0440\u0435\u0434\u043d\u044e\u044e \u043e\u0446\u0435\u043d\u043a\u0443, \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0435\u0448\u044c \u043f\u0440\u043e\u0435\u043a\u0442 \u00ab\u0442\u0430\u043a \u0441\u0435\u0431\u0435\u00bb \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u0435\u043d \u0441\u0432\u043e\u0435\u0439 \u0444\u043e\u0440\u043c\u043e\u0439. \u0422\u0432\u043e\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasat bir not al\u0131yorsunuz, bir projeyi gayet iyi tamaml\u0131yorsunuz veya formunuzdan memnun de\u011filsiniz. Tepkiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5f97\u5230\u4e00\u4e2a\u4e2d\u7b49\u7684\u6210\u7ee9\uff0c\u53ea\u662f\u201c\u8fd8\u53ef\u4ee5\u201d\u5730\u5b8c\u6210\u4e00\u4e2a\u9879\u76ee\uff0c\u6216\u8005\u5bf9\u81ea\u5df1\u7684\u72b6\u6001\u4e0d\u6ee1\u610f\u3002\u4f60\u7684\u53cd\u5e94\u662f\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u6210\u7e3e\u5e73\u5eb8\uff0c\u5b8c\u6210\u4e00\u500b\u5c08\u6848\u9084\u4e0d\u932f\uff0c\u6216\u5c0d\u4f60\u7684\u8868\u73fe\u4e0d\u6eff\u610f\u3002\u4f60\u7684\u53cd\u61c9\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q14.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich vergleiche mich mit denen, die noch schlechter waren, um mich besser zu f\u00fchlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I compare myself to those who were even worse in order to feel better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me comparo con aquellos que estaban a\u00fan peor para sentirme mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me compare \u00e0 ceux qui ont \u00e9t\u00e9 encore pires pour me sentir mieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0947\u0939\u0924\u0930 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u0924\u0941\u0932\u0928\u093e \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0938\u0947 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u091c\u094b \u0914\u0930 \u092d\u0940 \u092c\u0941\u0930\u0947 \u0925\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi paragono a chi stava ancora peggio per sentirmi meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c17\u5206\u3092\u826f\u304f\u3059\u308b\u305f\u3081\u306b\u3001\u3055\u3089\u306b\u60aa\u3044\u4eba\u3068\u81ea\u5206\u3092\u6bd4\u8f03\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uae30\ubd84\uc774 \ub098\uc544\uc9c0\uae30 \uc704\ud574 \ub354 \ub098\uc05c \uc0ac\ub78c\ub4e4\uacfc \ub098\ub97c \ube44\uad50\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om me beter te voelen, vergelijk ik mezelf met degenen die nog slechter waren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Por\u00f3wnuj\u0119 si\u0119 do tych, kt\u00f3rzy byli jeszcze gorsi, \u017ceby poczu\u0107 si\u0119 lepiej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me comparo com aqueles que foram ainda piores para me sentir melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e \u0441\u0435\u0431\u044f \u0441 \u0442\u0435\u043c\u0438, \u043a\u0442\u043e \u0431\u044b\u043b \u0435\u0449\u0435 \u0445\u0443\u0436\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u043b\u0443\u0447\u0448\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi hissetmek i\u00e7in kendimi daha da k\u00f6t\u00fc olanlarla kar\u015f\u0131la\u015ft\u0131r\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u901a\u8fc7\u4e0e\u90a3\u4e9b\u66f4\u7cdf\u7684\u4eba\u6bd4\u8f83\u81ea\u5df1\u6765\u8ba9\u81ea\u5df1\u611f\u89c9\u66f4\u597d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5c07\u81ea\u5df1\u8207\u90a3\u4e9b\u66f4\u7cdf\u7cd5\u7684\u4eba\u9032\u884c\u6bd4\u8f03\uff0c\u4ee5\u4fbf\u611f\u89ba\u66f4\u597d\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q14.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage 'Hauptsache bestanden' und vergesse es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say 'mainly passed' and forget about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo \"mayormente aprobado\" y lo olvido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dis \u00ab essentiellement r\u00e9ussi \u00bb et j\u2019oublie \u00e7a."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u0939\u0924\u093e \u0939\u0942\u0902 '\u092e\u0941\u0916\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u092a\u093e\u0930\u093f\u0924' \u0914\u0930 \u0907\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092d\u0942\u0932 \u091c\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico \"principalmente superato\" e me ne dimentico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u4e3b\u306b\u5408\u683c\u3057\u307e\u3057\u305f\u300d\u3068\u8a00\u3063\u3066\u5fd8\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc8fc\ub85c \ud569\uaca9'\uc774\ub77c\uace0 \ub9d0\ud558\uace0 \uc78a\uc5b4\ubc84\ub9bd\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg 'grotendeels geslaagd' en vergeet het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3wi\u0119 \u201eg\u0142\u00f3wnie zda\u0142o\u201d i zapominam o tym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu digo 'aprovado principalmente' e esque\u00e7o isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u043e\u0432\u043e\u0440\u044e '\u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0441\u0434\u0430\u043b' \u0438 \u0437\u0430\u0431\u044b\u0432\u0430\u044e \u043e\u0431 \u044d\u0442\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u00c7o\u011funlukla ge\u00e7ti' diyorum ve unutuyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8bf4\u2018\u91cd\u8981\u7684\u662f\u901a\u8fc7\u2019\uff0c\u7136\u540e\u5c31\u5fd8\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8aaa\u201c\u57fa\u672c\u4e0a\u901a\u904e\u4e86\u201d\uff0c\u7136\u5f8c\u5c31\u5fd8\u4e86\u5b83\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q14.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich \u00e4rgere mich kurz, belasse es aber dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get annoyed for a moment, but leave it at that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me enojo por un momento, pero d\u00e9jalo as\u00ed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'\u00e9nerve un instant, mais reste-en l\u00e0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u090f\u0915 \u092a\u0932 \u0915\u0947 \u0932\u093f\u090f \u0928\u093e\u0930\u093e\u091c\u093c \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938\u0947 \u0935\u0939\u0940\u0902 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un attimo mi arrabbio, ma lasciamo perdere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u77ac\u30a4\u30e9\u3064\u304d\u307e\u3059\u304c\u3001\u305d\u306e\u307e\u307e\u306b\u3057\u3066\u304a\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\uc2dc \uc9dc\uc99d\uc774 \ub098\uc9c0\ub9cc \uadf8\ub9cc \ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik irriteer me even, maar laat het daarbij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez chwil\u0119 si\u0119 denerwuj\u0119, ale zostawmy to."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fico irritado por um momento, mas deixo por isso mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u043b\u044e\u0441\u044c, \u043d\u043e \u043d\u0430 \u044d\u0442\u043e\u043c \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0441\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir an sinirleniyorum ama b\u0131rakal\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6709\u70b9\u751f\u6c14\uff0c\u4f46\u5c31\u8fd9\u6837\u7b97\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6709\u4e00\u77ac\u9593\u5f88\u751f\u6c23\uff0c\u4f46\u5c31\u9019\u6a23\u5427\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q14.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich akzeptiere es absolut nicht. Ich analysiere den Fehler und erzwinge beim n\u00e4chsten Mal Dominanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I absolutely do not accept it. I analyze the mistake and enforce dominance next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo acepto en absoluto. Analizo el error y hago cumplir el dominio la pr\u00f3xima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne l'accepte absolument pas. J\u2019analyse l\u2019erreur et impose la domination la prochaine fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0907\u0938\u0947 \u0915\u0924\u0908 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e. \u092e\u0948\u0902 \u0917\u0932\u0924\u0940 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u092a\u094d\u0930\u092d\u0941\u0924\u094d\u0935 \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lo accetto assolutamente. Analizzo l'errore e impongo il dominio la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d76\u5bfe\u306b\u8a8d\u3081\u307e\u305b\u3093\u3002\u30df\u30b9\u3092\u5206\u6790\u3057\u3066\u3001\u6b21\u56de\u306f\u512a\u4f4d\u6027\u3092\u5f37\u5316\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub294 \uc808\ub300 \ubc1b\uc544\ub4e4\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc2e4\uc218\ub97c \ubd84\uc11d\ud558\uace0 \ub2e4\uc74c \ubc88\uc5d0\ub294 \uc6b0\uc704\ub97c \uc810\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik accepteer het absoluut niet. Ik analyseer de fout en dwing de volgende keer dominantie af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutnie tego nie akceptuj\u0119. Analizuj\u0119 b\u0142\u0105d i nast\u0119pnym razem wymuszam dominacj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu absolutamente n\u00e3o aceito isso. Eu analiso o erro e imponho o dom\u00ednio na pr\u00f3xima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e. \u042f \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443 \u0438 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0437 \u0431\u0443\u0434\u0443 \u043d\u0430\u0432\u044f\u0437\u044b\u0432\u0430\u0442\u044c \u0434\u043e\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle kabul etmiyorum. Hatay\u0131 analiz ediyorum ve bir dahaki sefere hakimiyeti uyguluyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7edd\u5bf9\u4e0d\u80fd\u63a5\u53d7\u3002\u6211\u5206\u6790\u9519\u8bef\uff0c\u5e76\u5728\u4e0b\u4e00\u6b21\u5f3a\u884c\u638c\u63a7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7d55\u5c0d\u4e0d\u63a5\u53d7\u3002\u6211\u6703\u5206\u6790\u932f\u8aa4\u4e26\u4e0b\u6b21\u52a0\u5f37\u7d71\u6cbb\u529b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q15": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gro\u00dfe Pl\u00e4ne. Du erz\u00e4hlst deiner Familie/deinen Freunden davon. Wie reagieren sie?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have big plans. You tell your family/friends about it. How do they react?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes grandes planes. Se lo cuentas a tu familia/amigos. \u00bfC\u00f3mo reaccionan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez de grands projets. Vous en parlez \u00e0 votre famille/amis. Comment r\u00e9agissent-ils ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092c\u0921\u093c\u0940 \u092f\u094b\u091c\u0928\u093e\u090f\u0902 \u0939\u0948\u0902. \u0906\u092a \u0905\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u093e\u0930/\u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u094b \u0907\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0924\u093e\u090f\u0902\u0964 \u0935\u0947 \u0915\u0948\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai grandi progetti. Ne parli alla tua famiglia/ai tuoi amici. Come reagiscono?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5927\u304d\u306a\u8a08\u753b\u304c\u3042\u308b\u306e\u3067\u3059\u306d\u3002\u3042\u306a\u305f\u306f\u5bb6\u65cf\u3084\u53cb\u4eba\u306b\u305d\u308c\u306b\u3064\u3044\u3066\u8a71\u3057\u307e\u3059\u3002\u5f7c\u3089\u306f\u3069\u3046\u53cd\u5fdc\u3059\u308b\u3067\u3057\u3087\u3046\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ud070 \uacc4\ud68d\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub2f9\uc2e0\uc758 \uac00\uc871/\uce5c\uad6c\ub4e4\uc5d0\uac8c \uadf8\uac83\uc5d0 \ub300\ud574 \uc774\uc57c\uae30\ud569\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \uc5b4\ub5bb\uac8c \ubc18\uc751\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt grootse plannen. Je vertelt het aan je familie/vrienden. Hoe reageren ze?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wielkie plany. M\u00f3wisz o tym rodzinie/przyjacio\u0142om. Jak reaguj\u0105?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea tem grandes planos. Voc\u00ea conta para sua fam\u00edlia/amigos sobre isso. Como eles reagem?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0442\u0435\u0431\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043f\u043b\u0430\u043d\u044b. \u0422\u044b \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0448\u044c \u043e \u043d\u0438\u0445 \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u043c\u044c\u0435/\u0441\u0432\u043e\u0438\u043c \u0434\u0440\u0443\u0437\u044c\u044f\u043c. \u041a\u0430\u043a \u043e\u043d\u0438 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044e\u0442?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcy\u00fck planlar\u0131n var. Bunu ailenize/arkada\u015flar\u0131n\u0131za anlat\u0131rs\u0131n\u0131z. Nas\u0131l tepki veriyorlar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6709\u5b8f\u4f1f\u7684\u8ba1\u5212\u3002\u4f60\u544a\u8bc9\u4e86\u4f60\u7684\u5bb6\u4eba/\u670b\u53cb\u3002\u4ed6\u4eec\u4f1a\u4f5c\u4f55\u53cd\u5e94\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6709\u5b8f\u5049\u7684\u8a08\u5283\u3002\u4f60\u544a\u8a34\u4f60\u7684\u5bb6\u4eba/\u670b\u53cb\u9019\u4ef6\u4e8b\u3002\u4ed6\u5011\u6709\u4f55\u53cd\u61c9\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q15.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie lachen mich aus oder sagen mir, ich soll realistisch bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They laugh at me or tell me to be realistic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se r\u00eden de m\u00ed o me dicen que sea realista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils se moquent de moi ou me disent d'\u00eatre r\u00e9aliste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947 \u092e\u0941\u091d \u092a\u0930 \u0939\u0902\u0938\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u092e\u0941\u091d\u0947 \u092f\u0925\u093e\u0930\u094d\u0925\u0935\u093e\u0926\u0940 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridono di me o mi dicono di essere realistico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f7c\u3089\u306f\u79c1\u3092\u7b11\u3063\u305f\u308a\u3001\u73fe\u5b9f\u7684\u306b\u306a\u308b\u3088\u3046\u306b\u8a00\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub4e4\uc740 \ub098\ub97c \ube44\uc6c3\uac70\ub098 \ub098\uc5d0\uac8c \ud604\uc2e4\uc801\uc774\ub77c\uace0 \ub9d0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze lachen me uit of zeggen dat ik realistisch moet zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015amiej\u0105 si\u0119 ze mnie lub m\u00f3wi\u0105, \u017cebym by\u0142 realist\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles riem de mim ou me dizem para ser realista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043d\u0438 \u0441\u043c\u0435\u044e\u0442\u0441\u044f \u043d\u0430\u0434\u043e \u043c\u043d\u043e\u0439 \u0438\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u043c\u043d\u0435, \u0447\u0442\u043e \u044f \u0434\u043e\u043b\u0436\u0435\u043d \u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana g\u00fcl\u00fcyorlar ya da ger\u00e7ek\u00e7i olmam\u0131 s\u00f6yl\u00fcyorlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u4eec\u53d6\u7b11\u6211\uff0c\u6216\u8005\u544a\u8bc9\u6211\u5e94\u4fdd\u6301\u73b0\u5b9e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u5011\u5632\u7b11\u6211\u6216\u544a\u8a34\u6211\u8981\u73fe\u5be6\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q15.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind gleichg\u00fcltig und wechseln das Thema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are indifferent and change the subject."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran indiferentes y cambian de tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont indiff\u00e9rents et changent de sujet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947 \u0909\u0926\u093e\u0938\u0940\u0928 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0935\u093f\u0937\u092f \u092c\u0926\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono indifferenti e cambiano argomento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f7c\u3089\u306f\u7121\u95a2\u5fc3\u3067\u8a71\u984c\u3092\u5909\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub4e4\uc740 \ubb34\uad00\uc2ec\ud558\uace0 \uc8fc\uc81c\ub97c \ubc14\uafc9\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze zijn onverschillig en veranderen van onderwerp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0105 oboj\u0119tni i zmieniaj\u0105 temat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles ficam indiferentes e mudam de assunto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043d\u0438 \u0440\u0430\u0432\u043d\u043e\u0434\u0443\u0448\u043d\u044b \u0438 \u043c\u0435\u043d\u044f\u044e\u0442 \u0442\u0435\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131ts\u0131z kal\u0131rlar ve konuyu de\u011fi\u015ftirirler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u4eec\u6f20\u4e0d\u5173\u5fc3\uff0c\u5e76\u4e14\u8f6c\u6362\u8bdd\u9898\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u5011\u6f20\u4e0d\u95dc\u5fc3\u4e26\u8f49\u79fb\u8a71\u984c\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q15.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie w\u00fcnschen mir viel Gl\u00fcck, helfen aber nicht aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They wish me good luck, but don't actively help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me desean buena suerte, pero no me ayudan activamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils me souhaitent bonne chance, mais ne m'aident pas activement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947 \u092e\u0941\u091d\u0947 \u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e\u090f\u0901 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0942\u092a \u0938\u0947 \u092e\u0926\u0926 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi augurano buona fortuna, ma non mi aiutano attivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f7c\u3089\u306f\u79c1\u306e\u5e78\u904b\u3092\u7948\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u7a4d\u6975\u7684\u306b\u306f\u52a9\u3051\u3066\u304f\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub4e4\uc740 \ub098\uc5d0\uac8c \ud589\uc6b4\uc744 \ube4c\uc9c0\ub9cc \uc801\uadf9\uc801\uc73c\ub85c \ub3c4\uc640\uc8fc\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze wensen me veel succes, maar helpen niet actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017bycz\u0105 mi powodzenia, ale nie pomagaj\u0105 aktywnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles me desejam boa sorte, mas n\u00e3o ajudam ativamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043d\u0438 \u0436\u0435\u043b\u0430\u044e\u0442 \u043c\u043d\u0435 \u0443\u0434\u0430\u0447\u0438, \u043d\u043e \u043d\u0435 \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana iyi \u015fanslar diliyorlar ama aktif olarak yard\u0131m etmiyorlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4eec\u795d\u6211\u597d\u8fd0\uff0c\u4f46\u5e76\u6ca1\u6709\u79ef\u6781\u5e2e\u5fd9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u5011\u795d\u6211\u597d\u904b\uff0c\u4f46\u4e26\u4e0d\u4e3b\u52d5\u5e6b\u5fd9\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q15.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie fragen sofort 'Wie k\u00f6nnen wir dir dabei helfen?' oder challengen den Plan konstruktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They immediately ask 'How can we help you with this?' or challenge the plan constructively."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente preguntan: '\u00bfC\u00f3mo podemos ayudarle con esto?' o desafiar el plan de manera constructiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils demandent imm\u00e9diatement : \u00ab\u00a0Comment pouvons-nous vous aider\u00a0?\u00a0\u00bb ou contester le plan de mani\u00e8re constructive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947 \u0924\u0941\u0930\u0902\u0924 \u092a\u0942\u091b\u0924\u0947 \u0939\u0948\u0902 '\u0939\u092e \u0907\u0938\u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0915\u0948\u0938\u0947 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?' \u092f\u093e \u092f\u094b\u091c\u0928\u093e \u0915\u094b \u0930\u091a\u0928\u093e\u0924\u094d\u092e\u0915 \u0930\u0942\u092a \u0938\u0947 \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedono immediatamente \"Come possiamo aiutarti in questo?\" o sfidare il piano in modo costruttivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f7c\u3089\u306f\u3059\u3050\u306b\u300c\u3053\u308c\u306b\u3064\u3044\u3066\u3069\u3046\u304a\u624b\u4f1d\u3044\u3067\u304d\u307e\u3059\u304b?\u300d\u3068\u5c0b\u306d\u307e\u3059\u3002\u307e\u305f\u306f\u5efa\u8a2d\u7684\u306b\u8a08\u753b\u306b\u7570\u8b70\u3092\u5531\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub4e4\uc740 \uc989\uc2dc '\uc5b4\ub5bb\uac8c \ub3c4\uc640\ub4dc\ub9b4\uae4c\uc694?'\ub77c\uace0 \ubb3b\uc2b5\ub2c8\ub2e4. \ub610\ub294 \uac74\uc124\uc801\uc73c\ub85c \uacc4\ud68d\uc5d0 \ub3c4\uc804\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze vragen meteen: 'Hoe kunnen we je hiermee helpen?' of daag het plan constructief uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast pytaj\u0105: \u201eJak mo\u017cemy Ci w tym pom\u00f3c?\u201d. lub konstruktywnie kwestionuj plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles imediatamente perguntam 'Como podemos ajud\u00e1-lo com isso?' ou desafiar o plano de forma construtiva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043d\u0438 \u0441\u0440\u0430\u0437\u0443 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u044e\u0442: '\u041a\u0430\u043a \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u0442\u0435\u0431\u0435 \u0432 \u044d\u0442\u043e\u043c \u043f\u043e\u043c\u043e\u0447\u044c?' \u0438\u043b\u0438 \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u044e\u0442 \u043f\u043b\u0430\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen 'Bu konuda size nas\u0131l yard\u0131mc\u0131 olabiliriz?' diye soruyorlar. veya plana yap\u0131c\u0131 bir \u015fekilde meydan okuyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4eec\u4f1a\u7acb\u523b\u95ee\u2018\u6211\u4eec\u600e\u4e48\u80fd\u5e2e\u4f60\uff1f\u2019\u6216\u8005\u5efa\u8bbe\u6027\u5730\u6311\u6218\u8fd9\u4e2a\u8ba1\u5212\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u5011\u7acb\u5373\u8a62\u554f\u300c\u6211\u5011\u53ef\u4ee5\u5982\u4f55\u5e6b\u52a9\u60a8\uff1f\u300d\u6216\u5efa\u8a2d\u6027\u5730\u8cea\u7591\u8a72\u8a08\u5283\u3002"
          }
        }
      }
    },
    "assessment.mental.nav.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geist & Seele"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind & Soul"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente y alma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esprit et \u00e2me"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0928 \u0914\u0930 \u0906\u0924\u094d\u092e\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente e anima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc3\u3068\u9b42"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc2e0\uacfc \uc601\ud63c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geest en ziel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umys\u0142 i dusza"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente e Alma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0443\u0445 \u0438 \u0434\u0443\u0448\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihin ve Ruh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc3\u7075\u4e0e\u7075\u9b42"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc3\u9748\u8207\u5fc3\u9748"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deinen Fokus und lerne, Nein zu sagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your focus and learn to say no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu enfoque y aprende a decir no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez votre concentration et apprenez \u00e0 dire non."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0928\u093e \u0915\u0939\u0928\u093e \u0938\u0940\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova la tua concentrazione e impara a dire di no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u7126\u70b9\u3092\u898b\u3064\u3051\u3066\u3001\u30ce\u30fc\u3068\u8a00\u3046\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd08\uc810\uc744 \ucc3e\uace0 \uac70\uc808\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind uw focus en leer nee zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajd\u017a swoje skupienie i naucz si\u0119 m\u00f3wi\u0107 nie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre seu foco e aprenda a dizer n\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0439\u0434\u0438 \u0441\u0432\u043e\u0439 \u0444\u043e\u043a\u0443\u0441 \u0438 \u043d\u0430\u0443\u0447\u0438\u0441\u044c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u00ab\u043d\u0435\u0442\u00bb."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak noktan\u0131z\u0131 bulun ve hay\u0131r demeyi \u00f6\u011frenin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u5230\u4f60\u7684\u91cd\u70b9\uff0c\u5e76\u5b66\u4f1a\u8bf4\u4e0d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u5230\u4f60\u7684\u7126\u9ede\u4e26\u5b78\u6703\u8aaa\u4e0d\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere die roten Benachrichtigungs-Badges auf deinem Home-Screen. Sie triggern dein Dopaminsystem k\u00fcnstlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable the red notification badges on your home screen. They artificially trigger your dopamine system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactive las insignias de notificaci\u00f3n rojas en su pantalla de inicio. Activan artificialmente su sistema de dopamina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9sactivez les badges de notification rouges sur votre \u00e9cran d'accueil. Ils d\u00e9clenchent artificiellement votre syst\u00e8me dopaminergique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0932\u093e\u0932 \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u092c\u0948\u091c \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964 \u0935\u0947 \u0915\u0943\u0924\u094d\u0930\u093f\u092e \u0930\u0942\u092a \u0938\u0947 \u0906\u092a\u0915\u0947 \u0921\u094b\u092a\u093e\u092e\u093e\u0907\u0928 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u094b \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva i badge di notifica rossi sulla schermata iniziale. Attivano artificialmente il tuo sistema dopaminergico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30db\u30fc\u30e0\u753b\u9762\u306e\u8d64\u3044\u901a\u77e5\u30d0\u30c3\u30b8\u3092\u7121\u52b9\u306b\u3057\u307e\u3059\u3002\u305d\u308c\u3089\u306f\u4eba\u70ba\u7684\u306b\u30c9\u30fc\u30d1\u30df\u30f3\u30b7\u30b9\u30c6\u30e0\u3092\u8a98\u767a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud648 \ud654\uba74\uc5d0\uc11c \ube68\uac04\uc0c9 \uc54c\ub9bc \ubc30\uc9c0\ub97c \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \ub3c4\ud30c\ubbfc \uc2dc\uc2a4\ud15c\uc744 \uc778\uc704\uc801\uc73c\ub85c \uc720\ubc1c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de rode meldingsbadges op uw startscherm uit. Ze activeren kunstmatig je dopaminesysteem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142\u0105cz czerwone plakietki powiadomie\u0144 na ekranie g\u0142\u00f3wnym. Sztucznie uruchamiaj\u0105 uk\u0142ad dopaminowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative os emblemas vermelhos de notifica\u00e7\u00e3o na tela inicial. Eles acionam artificialmente o seu sistema de dopamina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u043b\u044e\u0447\u0438 \u043a\u0440\u0430\u0441\u043d\u044b\u0435 \u0437\u043d\u0430\u0447\u043a\u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439 \u043d\u0430 \u0441\u0432\u043e\u0435\u043c \u0433\u043b\u0430\u0432\u043d\u043e\u043c \u044d\u043a\u0440\u0430\u043d\u0435. \u041e\u043d\u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u0443\u044e\u0442 \u0442\u0432\u043e\u044e \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u043e\u0432\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekran\u0131n\u0131zdaki k\u0131rm\u0131z\u0131 bildirim i\u015faretlerini devre d\u0131\u015f\u0131 b\u0131rak\u0131n. Dopamin sisteminizi yapay olarak tetiklerler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684\u4e3b\u5c4f\u5e55\u4e0a\u5173\u95ed\u7ea2\u8272\u901a\u77e5\u5fbd\u7ae0\u3002\u5b83\u4eec\u4f1a\u4eba\u4e3a\u89e6\u53d1\u4f60\u7684\u591a\u5df4\u80fa\u7cfb\u7edf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u7528\u4e3b\u756b\u9762\u4e0a\u7684\u7d05\u8272\u901a\u77e5\u5fbd\u7ae0\u3002\u5b83\u5011\u4eba\u70ba\u5730\u89f8\u767c\u60a8\u7684\u591a\u5df4\u80fa\u7cfb\u7d71\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dein Handy w\u00e4hrend der allerersten 15 Minuten deines Arbeitstages auf Flugmodus. Nur 15 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phone on airplane mode for the very first 15 minutes of your work day. Only 15 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu tel\u00e9fono en modo avi\u00f3n durante los primeros 15 minutos de tu jornada laboral. S\u00f3lo 15 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez votre t\u00e9l\u00e9phone en mode avion pendant les 15 premi\u00e8res minutes de votre journ\u00e9e de travail. Seulement 15 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0915\u093e\u0930\u094d\u092f \u0926\u093f\u0935\u0938 \u0915\u0947 \u092a\u0939\u0932\u0947 15 \u092e\u093f\u0928\u091f \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u090f\u092f\u0930\u092a\u094d\u0932\u0947\u0928 \u092e\u094b\u0921 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964 \u0938\u093f\u0930\u094d\u092b 15 \u092e\u093f\u0928\u091f."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il \u200b\u200btelefono in modalit\u00e0 aereo per i primi 15 minuti della tua giornata lavorativa. Solo 15 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52e4\u52d9\u6642\u9593\u306e\u6700\u521d\u306e 15 \u5206\u9593\u306f\u3001\u643a\u5e2f\u96fb\u8a71\u3092\u6a5f\u5185\u30e2\u30fc\u30c9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3063\u305f\u306e15\u5206\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadfc\ubb34\uc77c \uc911 \ucc98\uc74c 15\ubd84 \ub3d9\uc548 \ud734\ub300\ud3f0\uc744 \ube44\ud589\uae30 \ubaa8\ub4dc\ub85c \uc804\ud658\ud558\uc138\uc694. \ub2e8 15\ubd84."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet uw telefoon de eerste 15 minuten van uw werkdag in de vliegtuigmodus. Slechts 15 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105cz telefon w tryb samolotowy na pierwsze 15 minut dnia pracy. Tylko 15 minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seu telefone no modo avi\u00e3o durante os primeiros 15 minutos do seu dia de trabalho. Apenas 15 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438 \u0441\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432 \u0440\u0435\u0436\u0438\u043c \u043f\u043e\u043b\u0435\u0442\u0430 \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 15 \u043c\u0438\u043d\u0443\u0442 \u0442\u0432\u043e\u0435\u0433\u043e \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u0434\u043d\u044f. \u0412\u0441\u0435\u0433\u043e 15 \u043c\u0438\u043d\u0443\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u015f g\u00fcn\u00fcn\u00fcz\u00fcn ilk 15 dakikas\u0131nda telefonunuzu u\u00e7ak moduna al\u0131n. Sadece 15 dakika."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u5de5\u4f5c\u65e5\u7684\u6700\u521d15\u5206\u949f\u5185\uff0c\u5c06\u4f60\u7684\u624b\u673a\u5207\u6362\u5230\u98de\u884c\u6a21\u5f0f\u3002\u53ea\u970015\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5de5\u4f5c\u65e5\u7684\u524d 15 \u5206\u9418\u5c07\u624b\u6a5f\u8abf\u81f3\u98db\u822a\u6a21\u5f0f\u3002\u53ea\u9700\u898115\u5206\u9418\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist extrem reaktiv und hast null mentalen Fokus. Wir trainieren den Fokus-Muskel nicht mit stundenlanger Meditation, sondern mit winzigen Intervallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are extremely reactive and have zero mental focus. We train the focus muscle not with hours of meditation, but with tiny intervals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres extremadamente reactivo y no tienes concentraci\u00f3n mental. Entrenamos el m\u00fasculo de enfoque no con horas de meditaci\u00f3n, sino con peque\u00f1os intervalos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates extr\u00eamement r\u00e9actif et n\u2019avez aucune concentration mentale. Nous entra\u00eenons le muscle de concentration non pas avec des heures de m\u00e9ditation, mais avec de petits intervalles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092c\u0947\u0939\u0926 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e\u0936\u0940\u0932 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a\u0915\u093e \u092e\u093e\u0928\u0938\u093f\u0915 \u092b\u094b\u0915\u0938 \u0936\u0942\u0928\u094d\u092f \u0939\u0948\u0964 \u0939\u092e \u092b\u094b\u0915\u0938 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u094b\u0902 \u0915\u094b \u0918\u0902\u091f\u094b\u0902 \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u091b\u094b\u091f\u0947-\u091b\u094b\u091f\u0947 \u0905\u0902\u0924\u0930\u093e\u0932\u094b\u0902 \u0938\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei estremamente reattivo e hai zero concentrazione mentale. Alleniamo il muscolo della concentrazione non con ore di meditazione, ma con piccoli intervalli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u975e\u5e38\u306b\u53cd\u5fdc\u7684\u3067\u3001\u7cbe\u795e\u7684\u306a\u96c6\u4e2d\u529b\u304c\u30bc\u30ed\u3067\u3059\u3002\u79c1\u305f\u3061\u306f\u96c6\u4e2d\u529b\u306e\u7b4b\u8089\u3092\u4f55\u6642\u9593\u3082\u7791\u60f3\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u5c0f\u3055\u306a\u9593\u9694\u3067\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uadf9\ub3c4\ub85c \ubc18\uc751\uc801\uc774\uba70 \uc815\uc2e0\uc801 \uc9d1\uc911\ub825\uc774 \uc804\ud600 \uc5c6\uc2b5\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 \uba87 \uc2dc\uac04\uc758 \uba85\uc0c1\uc774 \uc544\ub2c8\ub77c \uc544\uc8fc \uc9e7\uc740 \uac04\uaca9\uc73c\ub85c \uc9d1\uc911 \uadfc\uc721\uc744 \ud6c8\ub828\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent extreem reactief en hebt geen enkele mentale focus. We trainen de focusspier niet met urenlange meditatie, maar met kleine tussenpozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b niezwykle reaktywny i masz zerow\u0105 koncentracj\u0119 mentaln\u0105. Trenujemy mi\u0119sie\u0144 skupienia nie godzinami medytacji, ale ma\u0142ymi przerwami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea \u00e9 extremamente reativo e n\u00e3o tem foco mental. Treinamos o m\u00fasculo do foco n\u00e3o com horas de medita\u00e7\u00e3o, mas com pequenos intervalos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043a\u0440\u0430\u0439\u043d\u0435 \u0440\u0435\u0430\u043a\u0442\u0438\u0432\u0435\u043d \u0438 \u0443 \u0442\u0435\u0431\u044f \u043d\u0443\u043b\u0435\u0432\u043e\u0439 \u0443\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0444\u043e\u043a\u0443\u0441. \u041c\u044b \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u0435\u043c \u043c\u044b\u0448\u0446\u0443 \u0444\u043e\u043a\u0443\u0441\u0430 \u043d\u0435 \u0447\u0430\u0441\u0430\u043c\u0438 \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0435\u0439, \u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c\u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0430\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son derece reaktifsiniz ve zihinsel odaklanman\u0131z s\u0131f\u0131r. Odaklanma kas\u0131n\u0131 saatlerce meditasyonla de\u011fil, k\u00fc\u00e7\u00fck aral\u0131klarla \u00e7al\u0131\u015ft\u0131r\u0131yoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u53cd\u5e94\u6781\u7aef\u4e14\u5b8c\u5168\u6ca1\u6709\u5fc3\u7406\u96c6\u4e2d\u529b\u3002\u6211\u4eec\u4e0d\u662f\u901a\u8fc7\u957f\u65f6\u95f4\u7684\u51a5\u60f3\u6765\u8bad\u7ec3\u4e13\u6ce8\u529b\u808c\u8089\uff0c\u800c\u662f\u901a\u8fc7\u6781\u77ed\u7684\u65f6\u95f4\u95f4\u9694\u8fdb\u884c\u8bad\u7ec3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u53cd\u61c9\u6027\u6975\u5f37\uff0c\u7cbe\u795e\u96c6\u4e2d\u5ea6\u70ba\u96f6\u3002\u6211\u5011\u8a13\u7df4\u7126\u9ede\u808c\u8089\u4e0d\u662f\u900f\u904e\u5e7e\u500b\u5c0f\u6642\u7684\u51a5\u60f3\uff0c\u800c\u662f\u900f\u904e\u5f88\u5c0f\u7684\u9593\u9694\u3002"
          }
        }
      }
    },

    "plant.palme.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht in der Wärme, braucht weite Horizonte – Abenteuer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stands in the heat, needs wide horizons – Adventure"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguanta el calor, necesita amplios horizontes – Aventura"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résiste à la chaleur, a besoin de vastes horizons – Aventure"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गर्मी में खड़ा रहता है, विस्तृत क्षितिज की जरूरत है – साहसिक"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stands in the heat, needs wide horizons – Adventure"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暑さの中に立つには広い視野が必要 – 冒険"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더위 속에서도 넓은 시야가 필요합니다 - 모험"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staat in de hitte, heeft een brede horizon nodig – Avontuur"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoi w upale, potrzebuje szerokich horyzontów – Przygoda"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suporta o calor, precisa de horizontes vastos – Aventura"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоит на солнце, нуждается в широких горизонтах – приключение"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcakta duruyor, geniş ufuklara ihtiyaç duyuyor – Macera"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生长在温暖之地，需要广阔的视野 – 冒险"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在溫暖中，需要廣闊的視野－冒險"
          }
        }
      }
    },

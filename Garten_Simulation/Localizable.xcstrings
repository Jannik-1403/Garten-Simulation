          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistentie: Dagelijkse kleine stapjes leiden tot groot succes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsekwencja: codzienne małe kroki prowadzą do wielkiego sukcesu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistência: Pequenos passos diários levam a um grande sucesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistência: Pequenos passos diários levam a um grande sucesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрерывность: ежедневные маленькие шаги приводят к большому успеху."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlılık: Günlük küçük adımlar büyük başarıya yol açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续性：每天的小步骤会带来巨大的成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續性：每天的小步驟會帶來巨大的成功。"
          }
        }
      }
    },
    "stats.coach.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtsamkeit: Höre auf deine Bedürfnisse und passe deine Ziele an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness: Listen to your needs and adjust your goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención plena: Escucha tus necesidades y ajusta tus metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pleine conscience: Écoute tes besoins et ajuste tes objectifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सजगता: अपनी ज़रूरतों को सुनो और अपने लक्ष्यों को अनुकूलित करो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consapevolezza: Ascolta i tuoi bisogni e adatta i tuoi obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マインドフルネス: 自分のニーズに耳を傾け、目標を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음챙김: 귀하의 필요 사항을 듣고 목표를 조정하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness: Luister naar uw behoeften en pas uw doelen aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uważność: słuchaj swoich potrzeb i dostosowuj swoje cele."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente alerta: Ouve as tuas necessidades e ajusta os teus objetivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente alerta: Ouve as tuas necessidades e ajusta os teus objetivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осознанность: Прислушивайтесь к своим потребностям и корректируйте свои цели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farkındalık: İhtiyaçlarınızı dinleyin ve hedeflerinizi ayarlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正念：倾听您的需求并调整您的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正念：傾聽您的需求並調整您的目標。"
          }
        }
      }
    },
    "stats.coach.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt: Feiere jeden Meilenstein, egal wie klein er ist."
          }

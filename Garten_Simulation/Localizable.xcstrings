    "assessment.feedback.excellent.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Grundlagen in diesem Bereich sind extrem stark. Behalte diese positiven Gewohnheiten unbedingt bei, um dein Level zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your foundations in this area are extremely strong. Keep up these positive habits to maintain your level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus bases en este \u00e1mbito son extremadamente fuertes. Mant\u00e9n estos h\u00e1bitos positivos para conservar tu nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos bases dans ce domaine sont extr\u00eamement solides. Conservez ces habitudes positives pour maintenir votre niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924 \u092c\u0947\u0939\u0926 \u092e\u091c\u092c\u0942\u0924 \u0939\u0948\u0902\u0964 \u0905\u092a\u0928\u0947 \u0938\u094d\u0924\u0930 \u0915\u094b \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0928 \u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0905\u0935\u0936\u094d\u092f \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue basi in questa area sono estremamente solide. Mantieni queste abitudini positive per mantenere il tuo livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u5206\u91ce\u306b\u304a\u3051\u308b\u3042\u306a\u305f\u306e\u57fa\u790e\u306f\u975e\u5e38\u306b\u5f37\u56fa\u3067\u3059\u3002\u305d\u306e\u30ec\u30d9\u30eb\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u3053\u308c\u3089\u306e\u826f\u3044\u7fd2\u6163\u3092\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubd84\uc57c\uc5d0\uc11c \ub2f9\uc2e0\uc758 \uae30\ucd08\ub294 \ub9e4\uc6b0 \ud2bc\ud2bc\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc218\uc900\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc774\ub7ec\ud55c \uae0d\uc815\uc801\uc778 \uc2b5\uad00\uc744 \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je basis in dit gebied is extreem sterk. Blijf deze positieve gewoonten behouden om je niveau te behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje podstawy w tym obszarze s\u0105 niezwykle silne. Utrzymaj te pozytywne nawyki, aby utrzyma\u0107 sw\u00f3j poziom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas bases nesta \u00e1rea s\u00e3o extremamente fortes. Mant\u00e9m estes h\u00e1bitos positivos para conservares o teu n\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0438 \u043e\u0441\u043d\u043e\u0432\u044b \u0432 \u044d\u0442\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u0440\u0430\u0439\u043d\u0435 \u0441\u0438\u043b\u044c\u043d\u044b. \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0439 \u044d\u0442\u0438 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alandaki temelleriniz son derece sa\u011flam. Seviyenizi korumak i\u00e7in bu olumlu al\u0131\u015fkanl\u0131klar\u0131 s\u00fcrd\u00fcr\u00fcn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u8fd9\u4e2a\u9886\u57df\u7684\u57fa\u7840\u975e\u5e38\u624e\u5b9e\u3002\u4e00\u5b9a\u8981\u4fdd\u6301\u8fd9\u4e9b\u79ef\u6781\u7684\u4e60\u60ef\uff0c\u4ee5\u7ef4\u6301\u4f60\u7684\u6c34\u5e73\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u9019\u65b9\u9762\u7684\u57fa\u790e\u975e\u5e38\u7d2e\u5be6\u3002\u4e00\u5b9a\u8981\u4fdd\u6301\u9019\u4e9b\u7a4d\u6975\u7684\u7fd2\u6163\u4f86\u4fdd\u6301\u4f60\u7684\u6c34\u5e73\u3002"
          }
        }
      }
    },

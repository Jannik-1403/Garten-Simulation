    "streak.freeze.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Streak auf Eis schützt deinen Streak einen Tag lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Streak Freeze protects your streak for one day."

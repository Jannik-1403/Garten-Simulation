    "assessment.finance.q15" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du an 'viel Geld' denkst – welches dieser vier Wörter beschreibt dein wahres Ziel am besten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you think of 'a lot of money' - which of these four words best describes your true goal?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando piensas en \"mucho dinero\", ¿cuál de estas cuatro palabras describe mejor tu verdadero objetivo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous pensez à « beaucoup d’argent », lequel de ces quatre mots décrit le mieux votre véritable objectif ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप 'बहुत सारे पैसे' के बारे में सोचते हैं - तो इन चार शब्दों में से कौन सा आपके वास्तविक लक्ष्य का सबसे अच्छा वर्णन करता है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando pensi a \"un sacco di soldi\", quale di queste quattro parole descrive meglio il tuo vero obiettivo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「多額のお金」について考えるとき、あなたの本当の目標を最もよく表す言葉は次の 4 つのうちどれですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'많은 돈'을 생각할 때, 다음 네 단어 중 귀하의 진정한 목표를 가장 잘 설명하는 단어는 무엇입니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u aan 'veel geld' denkt: welke van deze vier woorden beschrijft dan het beste uw ware doel?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy myślisz o „dużo pieniędzy” – które z tych czterech słów najlepiej opisuje Twój prawdziwy cel?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você pensa em “muito dinheiro” – qual destas quatro palavras melhor descreve seu verdadeiro objetivo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда ты думаешь о 'многих деньгах' — какое из этих четырёх слов лучше всего описывает твою настоящую цель?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Çok para'yı düşündüğünüzde, bu dört kelimeden hangisi gerçek hedefinizi en iyi şekilde tanımlıyor?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你想到“很多钱”时——这四个词中哪一个最能描述你的真实目标？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當您想到「很多錢」時，這四個詞中哪一個最能描述您的真正目標？"
          }
        }
      }
    },

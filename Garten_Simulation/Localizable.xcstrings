    "prog_strength_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolviere ein EMOM (Every Minute on the Minute) - %lld Minuten.\nMinute 1: Übung 1\nMinute 2: Übung 2\nMinute 3: Übung 3\nMinute 4: Pause"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete an EMOM (Every Minute on the Minute) - %lld minutes.\nMinute 1: Exercise 1\nMinute 2: Exercise 2\nMinute 3: Exercise 3\nMinute 4: Rest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un EMOM (Cada minuto en cada minuto): %lld minutos.\nMinuto 1: Ejercicio 1\nMinuto 2: Ejercicio 2\nMinuto 3: Ejercicio 3\nMinuto 4: Descanso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez un EMOM (Chaque minute sur la minute) - %lld minutes.\nMinute 1 : Exercice 1\nMinute 2 : Exercice 2\nMinute 3 : Exercice 3\nMinute 4 : Pause"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ईएमओएम पूरा करें (प्रत्येक मिनट पर मिनट) - %lld मिनट।\nमिनट 1: व्यायाम 1\nमिनट 2: व्यायाम 2\nमिनट 3: व्यायाम 3\nमिनट 4: ब्रेक"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un EMOM (Every Minute on the Minute) - %lld minuti.\nMinuto 1: Esercizio 1\nMinuto 2: Esercizio 2\nMinuto 3: Esercizio 3\nMinuto 4: Pausa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM (Every Minute on the Minute) を完了します - %lld 分。\n1 分目: 演習 1\n2分目: 演習2\n3 分: 演習 3\n4分目：休憩"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM(매 분마다) - %lld 분을 완료하세요.\n1분: 운동 1\n2분: 운동 2\n3분: 운동 3\n4분: 휴식"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi een EMOM - %lld minuten.\nMinuut 1: Oefening 1\nMinuut 2: Oefening 2\nMinuut 3: Oefening 3\nMinuut 4: Rust"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończ EMOM - %lld minut.\nMinuta 1: Ćwiczenie 1\nMinuta 2: Ćwiczenie 2\nMinuta 3: Ćwiczenie 3\nMinuta 4: Odpoczynek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua um EMOM - %lld minutos.\nMinuto 1: Exercício 1\nMinuto 2: Exercício 2\nMinuto 3: Exercício 3\nMinuto 4: Descanso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua um EMOM - %lld minutos.\nMinuto 1: Exercício 1\nMinuto 2: Exercício 2\nMinuto 3: Exercício 3\nMinuto 4: Descanso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните EMOM - %lld минут.\nМинута 1: Упражнение 1\nМинута 2: Упражнение 2\nМинута 3: Упражнение 3\nМинута 4: Отдых"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM tamamlayın - %lld dakika.\nDakika 1: Egzersiz 1\nDakika 2: Egzersiz 2\nDakika 3: Egzersiz 3\nDakika 4: Dinlenme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一个 EMOM - %lld 分钟。\n第1分钟：练习1\n第2分钟：练习2\n第3分钟：练习3\n第4分钟：休息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一個 EMOM - %lld 分鐘。\n第1分鐘：練習1\n第2分鐘：練習2\n第3分鐘：練習3\n第4分鐘：休息"
          }
        }
      }
    },

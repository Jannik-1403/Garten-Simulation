          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のお気に入りのエクササイズの重量を最小ディスク (1kg / 1.25kg) ずつ増やしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 가장 작은 디스크(1kg/1.25kg)로 좋아하는 운동의 무게를 늘려보세요."
          }
        },
        "nl" : {

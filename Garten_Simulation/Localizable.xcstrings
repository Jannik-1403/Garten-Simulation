            "value": "\u66f4\u5feb\u5730\u5956\u52b1\u81ea\u5df1"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u5feb\u734e\u52f5\u81ea\u5df1"
          }
        }
      }
    },
    "paywall.feature.weekly_report.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne dich selbst besser kennen. Entdecke, wann du am produktivsten bist und feiere deinen Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get to know yourself better. Discover when you're most productive and celebrate your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con\u00f3cete mejor. Descubre cu\u00e1ndo eres m\u00e1s productivo y celebra tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends \u00e0 mieux te conna\u00eetre. D\u00e9couvre quand tu es le plus productif et c\u00e9l\u00e8bre tes progr\u00e8s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u091c\u093e\u0928\u0947\u0902. \u091c\u093e\u0928\u0947\u0902 \u0915\u093f \u0906\u092a \u0915\u092c \u0938\u0930\u094d\u0935\u093e\u0927\u093f\u0915 \u0909\u0924\u094d\u092a\u093e\u0926\u0915 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u093e \u091c\u0936\u094d\u0928 \u092e\u0928\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara a conoscerti meglio. Scopri quando sei pi\u00f9 produttivo e festeggia i tuoi progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u81ea\u8eab\u3092\u3088\u308a\u3088\u304f\u77e5\u308a\u307e\u3057\u3087\u3046\u3002\u3044\u3064\u6700\u3082\u751f\u7523\u7684\u304b\u3092\u767a\u898b\u3057\u3001\u9032\u6b69\u3092\u795d\u3044\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc790\uc2e0\uc744 \ub354 \uc798 \uc54c\uc544\ubcf4\uc138\uc694. \uc5b8\uc81c\uac00 \uac00\uc7a5 \uc0dd\uc0b0\uc801\uc778\uc9c0 \ubc1c\uacac\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd95\ud558\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer jezelf beter kennen. Ontdek wanneer je het meest productief bent en vier je vooruitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj siebie lepiej. Odkryj, kiedy jeste\u015b najbardziej produktywny i \u015bwi\u0119tuj swoje post\u0119py."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conhe\u00e7a-se melhor. Descubra quando voc\u00ea \u00e9 mais produtivo e celebre seu progresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u0443\u0447\u0448\u0435 \u0443\u0437\u043d\u0430\u0439 \u0441\u0435\u0431\u044f. \u0412\u044b\u044f\u0441\u043d\u0438, \u043a\u043e\u0433\u0434\u0430 \u0442\u044b \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u0435\u043d, \u0438 \u043e\u0442\u043c\u0435\u0447\u0430\u0439 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendini daha iyi tan\u0131. Ne zaman en \u00fcretken oldu\u011funu ke\u015ffet ve ilerlemeni kutla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u597d\u5730\u4e86\u89e3\u81ea\u5df1\u3002\u53d1\u73b0\u60a8\u4f55\u65f6\u6548\u7387\u6700\u9ad8\uff0c\u5e76\u5e86\u795d\u60a8\u7684\u8fdb\u6b65\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u4e86\u89e3\u81ea\u5df1\u3002\u767c\u73fe\u60a8\u4f55\u6642\u6700\u6709\u751f\u7522\u529b\u4e26\u6176\u795d\u60a8\u7684\u9032\u6b65\u3002"
          }
        }
      }
    },

          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Storm: Als een plant sterft, verlies je 2 levens in plaats van 1."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Burza: Jeśli roślina zginie, tracisz 2 życia zamiast 1."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempestade: Se uma planta morrer, perdes 2 vidas em vez de 1."

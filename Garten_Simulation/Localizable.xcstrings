    "assessment.lifestyle.profile.elite.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast hohe Standards, ein starkes Umfeld und dominierst durch dein Verhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have high standards, a strong environment and dominate through your behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes altos estándares, un ambiente fuerte y dominas a través de tu comportamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez des exigences élevées, un environnement solide et dominez par votre comportement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai standard elevati, un ambiente forte e domini attraverso il tuo comportamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは高い基準と強力な環境を持ち、行動を通じて支配します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 높은 기준과 강력한 환경을 갖고 있으며 행동을 통해 지배합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt hoge normen, een sterke omgeving en domineert door je gedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wysokie standardy, silne środowisko i dominujesz poprzez swoje zachowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem padrões elevados, um ambiente forte e domina através de seu comportamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek standartlarınız, güçlü bir çevreniz var ve davranışlarınızla hükmediyorsunuz."
          }
        }
      }
    },

    "plant.erdbeerpflanze.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versorge deinen K\u00f6rper t\u00e4glich mit wichtigen Vitaminen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide your body with important vitamins every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciona a tu cuerpo vitaminas importantes todos los d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournissez \u00e0 votre corps des vitamines importantes tous les jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u091f\u093e\u092e\u093f\u0928\u094b\u0902 \u0938\u0947 \u092a\u094b\u0937\u0923 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornisci al tuo corpo vitamine importanti ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u3001\u4f53\u306b\u91cd\u8981\u306a\u30d3\u30bf\u30df\u30f3\u3092\u88dc\u7d66\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \uc911\uc694\ud55c \ube44\ud0c0\ubbfc\uc744 \ubab8\uc5d0 \uacf5\uae09\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorzie je lichaam elke dag van belangrijke vitamines."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarczaj organizmowi wa\u017cnych witamin ka\u017cdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Forne\u00e7a ao seu corpo vitaminas importantes todos os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0441\u043d\u0430\u0431\u0436\u0430\u0439\u0442\u0435 \u0441\u0432\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c \u0432\u0430\u0436\u043d\u044b\u043c\u0438 \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u0430\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuza her g\u00fcn \u00f6nemli vitaminler sa\u011flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u4e3a\u4f60\u7684\u8eab\u4f53\u63d0\u4f9b\u91cd\u8981\u7684\u7ef4\u751f\u7d20\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u70ba\u60a8\u7684\u8eab\u9ad4\u63d0\u4f9b\u91cd\u8981\u7684\u7dad\u751f\u7d20\u3002"
          }
        }
      }
    },
    "plant.eukalyptus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinigt die Luft von innen \u2013 Atem\u00fcbungen & Breathwork"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleans the air from within \u2013 Breathing exercises & Breathwork"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia el aire desde dentro \u2013 Respiraci\u00f3n y Breathwork"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifie l'air de l'int\u00e9rieur \u2013 exercices de respiration"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0902\u0926\u0930 \u0938\u0947 \u0939\u0935\u093e \u0915\u094b \u0938\u093e\u092b \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 \u0936\u094d\u0935\u093e\u0938 \u0905\u092d\u094d\u092f\u093e\u0938 \u0914\u0930 \u092c\u094d\u0930\u0947\u0925\u0935\u0930\u094d\u0915"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleans the air from within \u2013 Breathing exercises & Breathwork"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5185\u5074\u304b\u3089\u7a7a\u6c17\u3092\u304d\u308c\u3044\u306b\u3059\u308b \u2013 \u547c\u5438\u6cd5\u3068\u30d6\u30ec\u30b9\u30ef\u30fc\u30af"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\ubd80 \uacf5\uae30\ub97c \uc815\ud654\ud569\ub2c8\ub2e4 \u2013 \ud638\ud761 \uc6b4\ub3d9 & \ud638\ud761\ubc95"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinigt de lucht van binnenuit \u2013 Ademhalingsoefeningen & Ademwerk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczyszcza powietrze od wewn\u0105trz \u2013 \u0107wiczenia oddechowe i praca oddechowa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifica o ar por dentro \u2013 exerc\u00edcios de respira\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0447\u0438\u0449\u0430\u0435\u0442 \u0432\u043e\u0437\u0434\u0443\u0445 \u0438\u0437\u043d\u0443\u0442\u0440\u0438 \u2013 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u0430\u043d\u0430\u044f\u043c\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Havay\u0131 i\u00e7eriden temizler \u2013 Nefes egzersizleri ve Nefes \u00c7al\u0131\u015fmas\u0131"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u5185\u800c\u5916\u51c0\u5316\u7a7a\u6c14\u2014\u2014\u547c\u5438\u7ec3\u4e60\u4e0e\u547c\u5438\u6cd5"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u5167\u90e8\u6de8\u5316\u7a7a\u6c23\uff0d\u547c\u5438\u7df4\u7fd2\u8207\u547c\u5438\u6cd5"
          }
        }
      }
    },

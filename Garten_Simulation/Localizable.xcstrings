          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chodzę i wykonuję trening nienawiści, ale z 50% mniejszą wagą/prędkością."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

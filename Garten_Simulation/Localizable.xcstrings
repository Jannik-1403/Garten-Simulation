    "wasser.leer.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieße deine Pflanzen, um Statistiken zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants to see statistics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tus plantas para ver estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrose tes plantes pour voir les statistiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सांख्यिकी देखने के लिए अपने पौधों को पानी दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffia le tue piante per vedere le statistiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物に水をあげて統計を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계를 보려면 식물에 물을 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef uw planten water om statistieken te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewaj swoje rośliny, aby zobaczyć statystyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue suas plantas para ver as estatísticas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regue suas plantas para ver as estatísticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливайте растения, чтобы увидеть статистику."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstatistikleri görmek için bitkilerinizi sulayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给植物浇水以查看统计数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給植物澆水以查看統計數據。"
          }
        }
      }
    },

    "dopamine_story_s5_sub": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schnitt läuft etwas nach 66 Tagen automatisch. In deinem Garten wird jeder dieser Tage sichtbar – statt dem nächsten Kick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On average, something runs automatically after 66 days. In your garden, each of these days becomes visible – instead of the next kick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En promedio, algo se vuelve automático después de 66 días. En tu jardín, cada uno de esos días se hace visible – en lugar del siguiente estímulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, une action devient automatique après 66 jours. Dans ton jardin, chacun de ces jours devient visible – au lieu de la prochaine sensation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "औसतन, 66 दिनों के बाद कुछ स्वचालित रूप से चलता है। आपके बगीचे में, इनमें से प्रत्येक दिन दिखाई देता है - अगले किक के बजाय।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In media, qualcosa diventa automatico dopo 66 giorni. Nel tuo giardino, ognuno di questi giorni diventa visibile – invece del prossimo stimolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均して、何かは66日後に自動化されます。あなたの庭では、次の刺激の代わりに、これらの日がすべて可視化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평균적으로 66일이 지나면 무언가가 자동으로 실행됩니다. 정원에서는 다음 자극 대신 이 매일매일이 눈에 보이게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddeld gaat iets na 66 dagen automatisch. In je tuin wordt elk van die dagen zichtbaar – in plaats van de volgende kick."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnio coś staje się automatyczne po 66 dniach. W twoim ogrodzie każdy z tych dni staje się widoczny – zamiast kolejnego kopu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, algo torna-se automático após 66 dias. No teu jardim, cada um desses dias torna-se visível – em vez do próximo estímulo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, algo se torna automático após 66 dias. No seu jardim, cada um desses dias se torna visível – em vez do próximo estímulo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В среднем что-то становится автоматическим через 66 дней. В твоем саду каждый из этих дней становится видимым – вместо очередного стимула."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama olarak, bir şey 66 gün sonra otomatik hale gelir. Bahçende bu günlerin her biri görünür hale gelir – bir sonraki uyarıcı yerine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，有些事情在 66 天后会自动进行。在你的花园里，每一天都会清晰可见——而不是下一次刺激。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，有些事情在 66 天後會自動進行。在你的花園裡，每一天都會清晰可見——而不是下一次刺激。"
          }
        }
      }
    },
    "dopamine_story_s5_title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits gibt deinen\nGewohnheiten Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits gives your\nhabits time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits le da tiempo a\ntus hábitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits donne du temps\nà tes habitudes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्रोवी आपकी आदतों\nको समय देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits dà tempo alle\ntue abitudini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habitsはあなたの習慣に\n時間を与えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits는 당신의 습관에\n시간을 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits geeft je\ngewoonten de tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits daje czas twoim\nnawykom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zalimo Habits dá tempo aos\nteus hábitos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zalimo Habits dá tempo aos\nseus hábitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits дает время твоим\nпривычкам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits alışkanlıklarına\nzaman tanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits 给你的\n习惯一些时间。"
          }
        },
        "zh-Hant": {

    "plant.kaktus.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärke dein Immunsystem und deine Willenskraft durch kaltes Duschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your immune system and willpower through cold showers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece tu sistema inmunológico y tu fuerza de voluntad con duchas frías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcez votre système immunitaire et votre volonté par des douches froides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठंडे पानी से नहाने से अपनी प्रतिरक्षा प्रणाली और इच्छाशक्ति को मजबूत करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforza il tuo sistema immunitario e la tua forza di volontà con docce fredde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷水シャワーで免疫力と意志力を強化しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬물 샤워를 통해 면역력과 의지력을 강화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versterk je immuunsysteem en wilskracht met koude douches."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmocnij swój układ odpornościowy i siłę woli dzięki zimnym prysznicom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortaleça seu sistema imunológico e sua força de vontade com banhos frios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortaleça seu sistema imunológico e sua força de vontade com banhos frios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укрепляй свою иммунную систему и силу воли с помощью холодного душа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soğuk duşlarla bağışıklık sisteminizi ve iradenizi güçlendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过冷水淋浴增强免疫系统和意志力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過冷水淋浴增強您的免疫系統和意志力。"
          }
        }
      }
    },
    "plant.kirschbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blüht nur, wenn man sich gut um ihn kümmert – Selfcare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blooms only with good care – Selfcare"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Florece solo con buen cuidado – Autocuidado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleurit seulement avec un bon soin – Soin de soi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तब खिलता है जब उसकी अच्छी देखभाल की जाए – आत्म देखभाल"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiorisce solo se te ne prendi cura: cura di te stesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適切なケアを行った場合にのみ開花します – セルフケア"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배려가 있어야 꽃이 핀다 – 셀프케어"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeit alleen bij goede verzorging – Selfcare"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnie tylko przy dobrej pielęgnacji – Selfcare"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce apenas com bons cuidados – Autocuidado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce apenas com bons cuidados – Autocuidado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветет только если о нём хорошо заботиться – забота о себе"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca iyi bakımla çiçek açar – Kişisel Bakım"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有精心照料才会开花 – 自我关怀"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有好好照顧它，它才會綻放──自我照顧"
          }
        }
      }
    },

    "assessment.finance.q5" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du könntest in 10 Jahren 50.000€ mehr haben, wenn du jetzt 150€/Monat zurücklegst. Was machst du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You could have €50,000 more in 10 years if you put aside €150/month now. What are you doing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrías tener 50.000€ más en 10 años si ahorras 150€/mes ahora. ¿Qué estás haciendo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourriez disposer de 50 000 € de plus dans 10 ans si vous mettez de côté 150 €/mois dès maintenant. Que fais-tu?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप अभी €150/माह अलग रख दें तो 10 वर्षों में आपके पास €50,000 अधिक हो सकते हैं। आप क्या कर रहे हो?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potresti avere 50.000 € in più tra 10 anni se metti da parte 150 € al mese adesso. Cosa fai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月額 150 ユーロを積み立てておけば、10 年後にはさらに 50,000 ユーロを手に入れることができます。何してるの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 매달 €150를 저축하면 10년 후에는 €50,000를 더 벌 수 있습니다. 뭐하세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt over 10 jaar € 50.000 meer hebben als u nu € 150 per maand opzij zet. Wat ben je aan het doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz mieć o 50 000 euro więcej w ciągu 10 lat, jeśli odłożysz teraz 150 euro miesięcznie. Co robisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você poderia ter mais 50.000€ em 10 anos se reservar 150€/mês agora. O que você está fazendo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через 10 лет у тебя может быть на 50.000€ больше, если ты сейчас будешь откладывать 150€/месяц. Что ты будешь делать?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi ayda 150 € ayırırsanız 10 yıl içinde 50.000 € daha fazla kazanabilirsiniz. Ne yapıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

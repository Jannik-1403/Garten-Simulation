    "plant.feigenbaum.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht Pausen um zu tragen – Intervallfasten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs breaks to bear fruit – Intermittent fasting"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita descansos para dar frutos – Ayuno intermitente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A besoin de pauses pour donner des fruits – Jeûne intermittent"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ले जाने के लिए ब्रेक की आवश्यकता है – अंतराल उपवास"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs breaks to bear fruit – Intermittent fasting"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実を結ぶには休憩が必要 – 断続的な断食"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열매를 맺으려면 휴식이 필요하다 – 간헐적 단식"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft pauzes nodig om vrucht te dragen – Intermitterend vasten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebuje przerw, aby przynieść owoce – post przerywany"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa de pausas para dar frutos – Jejum intermitente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужны перерывы, чтобы носить – интервальное голодание"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meyve vermek için molalara ihtiyaç var – Aralıklı oruç"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要休息才能结果 – 间歇性禁食"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要休息來支撐－間歇性斷食"
          }
        }
      }
    },

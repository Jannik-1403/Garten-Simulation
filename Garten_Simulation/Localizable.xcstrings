    "trash.binge_streaming.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekt f\u00fcr ein kleines Schl\u00e4fchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect for a little nap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfecta para una peque\u00f1a siesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfait pour une petite sieste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u094b\u091f\u0940 \u091d\u092a\u0915\u0940 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u092b\u0947\u0915\u094d\u091f\u0964"

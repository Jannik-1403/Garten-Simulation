    "focus.session.all_done.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib im Fokus oder beende die Session frühzeitig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay focused or end the session early."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manténgase concentrado o finalice la sesión antes de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez concentré ou terminez la séance plus tôt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान केंद्रित रखें या सत्र जल्दी समाप्त करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani concentrato o termina la sessione in anticipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中力を維持するか、セッションを早めに終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중을 유지하거나 세션을 일찍 종료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf gefocust of beëindig de sessie voortijdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj koncentrację lub zakończ sesję wcześniej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o foco ou termine a sessão mais cedo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o foco ou termine a sessão mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сосредоточьтесь или завершите сеанс раньше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanın veya oturumu erken sonlandırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持专注或提前结束课程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持專注或提前結束課程。"
          }
        }
      }
    },
    "focus.session.cancelled.app_left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die App zu lange verlassen. Dein Fokus-Timer wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the app for too long. Your focus timer was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaste la app demasiado tiempo. Tu temporizador de enfoque fue cancelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez quitté l'application trop longtemps. Votre minuteur de concentration a été annulé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बहुत लंबे समय से ऐप से दूर हैं। आपका फोकस टाइमर रद्द कर दिया गया है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai lasciato l'app troppo a lungo. Il tuo timer di concentrazione è stato annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを長時間離れていました。フォーカスタイマーがキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 너무 오래 벗어났습니다. 포커스 타이머가 취소되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verliet de app te lang. Je focustimer is geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byłeś poza aplikacją zbyt długo. Twój timer skupienia został anulowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficaste fora da app durante tempo demais. O teu temporizador de foco foi cancelado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficaste fora da app durante tempo demais. O teu temporizador de foco foi cancelado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы слишком долго оставляли приложение. Ваш таймер фокуса был отменен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı çok uzun süre terk ettiniz. Odak zamanlayıcınız iptal edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你离开应用太久了。你的专注计时器已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您離開該應用程式的時間太長了。您的專注計時器已被取消。"
          }
        }
      }
    },

    "effekt.erholung.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze erholt sich nach der Wiederbelebung. Wachstum ist vor\u00fcbergehend reduziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is recovering after being revived. Growth is temporarily reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta se est\u00e1 recuperando tras ser revivida. El crecimiento est\u00e1 temporalmente reducido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante r\u00e9cup\u00e8re apr\u00e8s avoir \u00e9t\u00e9 ranim\u00e9e. La croissance est temporairement r\u00e9duite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u0941\u0926\u094d\u0927\u093e\u0930 \u0915\u0947 \u092c\u093e\u0926 \u092a\u094c\u0927\u093e \u0920\u0940\u0915 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u093f\u0915\u093e\u0938 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0915\u092e \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is recovering after being revived. Growth is temporarily reduced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u306f\u5fa9\u6d3b\u3057\u3066\u56de\u5fa9\u3057\u3066\u3044\u307e\u3059\u3002\u6210\u9577\u306f\u4e00\u6642\u7684\u306b\u4f4e\u4e0b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dd\ubb3c\uc774 \ubd80\ud65c\ud55c \ud6c4 \ud68c\ubcf5\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc131\uc7a5\uc774 \uc77c\uc2dc\uc801\uc73c\ub85c \uac10\uc18c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant herstelt zich nadat hij nieuw leven is ingeblazen. De groei wordt tijdelijk verminderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015blina wraca do zdrowia po o\u017cywieniu. Wzrost jest chwilowo ograniczony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta est\u00e1 a recuperar ap\u00f3s ser revivida. O crescimento est\u00e1 temporariamente reduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u043e\u0436\u0438\u0432\u043b\u0435\u043d\u0438\u044f. \u0420\u043e\u0441\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0441\u043d\u0438\u0436\u0435\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitki yeniden canland\u0131r\u0131ld\u0131ktan sonra iyile\u015fiyor. B\u00fcy\u00fcme ge\u00e7ici olarak azal\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u5728\u590d\u82cf\u540e\u6062\u590d\u3002\u751f\u957f\u6682\u65f6\u51cf\u5c11\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u6062\u5fa9\u5f8c\u6062\u5fa9\u3002\u589e\u9577\u66ab\u6642\u6e1b\u5c11\u3002"
          }
        }
      }
    },

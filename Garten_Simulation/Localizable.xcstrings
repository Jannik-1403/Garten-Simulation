            "state": "translated",
            "value": "\u30b7\u30e7\u30c3\u30d7\u3067\u4f7f\u3048\u308b\u30b3\u30a4\u30f3\u3092\u30b2\u30c3\u30c8"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\uc810\uc5d0\uc11c \uc0ac\uc6a9\ud560 \ucf54\uc778\uc744 \ubc1b\uc73c\uc138\uc694"
          }
        },

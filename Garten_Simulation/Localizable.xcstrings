    "item.gluecks_segen.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und segnet deinen Garten mit schnellem Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and blesses your garden with rapid growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actúa inmediatamente y bendice tu jardín con un rápido crecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active immédiatement et bénit ton jardin d'une croissance rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत कार्रवाई करता है और आपके बगीचे को तेजी से विकास का आशीर्वाद देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agisce immediatamente e benedice il tuo giardino con una rapida crescita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに活発になり、庭を急速に成長させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 활성화되어 정원이 빠르게 성장하도록 축복합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en zegent uw tuin met snelle groei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast staje się aktywny i błogosławi Twój ogród szybkim wzrostem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e abençoa o teu jardim com crescimento rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e abençoa o teu jardim com crescimento rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Становится активным сразу и благословляет ваш сад быстрым ростом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve bahçenize hızlı bir büyüme sağlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，为你的花园带来快速生长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即採取行動，祝福您的花園快速生長。"
          }
        }
      }
    },
    "item.goldener_schluessel.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wertvoller Schlüssel, der das volle Wachstumspotenzial deines Gartens für eine Woche entriegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A valuable key that unlocks the full growth potential of your garden for one week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valiosa llave que desbloquea el potencial de crecimiento completo de tu jardín durante una semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une précieuse clé qui déverrouille le plein potentiel de croissance de ton jardin pendant une semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मूल्यवान कुंजी जो एक सप्ताह के लिए आपके बगीचे की पूर्ण विकास क्षमता को खोल देती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave preziosa che sblocca il pieno potenziale di crescita del tuo giardino per una settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの庭の潜在的な成長の可能性を 1 週間解放する貴重な鍵です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일 동안 정원의 성장 잠재력을 최대한 발휘할 수 있는 귀중한 열쇠입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een waardevolle sleutel die gedurende één week het volledige groeipotentieel van uw tuin ontsluit."

    "effekt.erholung.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze erholt sich nach der Wiederbelebung. Wachstum ist vorübergehend reduziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is recovering after being revived. Growth is temporarily reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta se está recuperando tras ser revivida. El crecimiento está temporalmente reducido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante récupère après avoir été ranimée. La croissance est temporairement réduite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरुद्धार के बाद पौधा ठीक हो जाता है। विकास अस्थायी रूप से कम हो गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pianta si riprende dopo la rinascita. La crescita è temporaneamente ridotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物は復活して回復しています。成長は一時的に低下します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 부활한 후 회복되고 있습니다. 성장이 일시적으로 감소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant herstelt zich nadat hij nieuw leven is ingeblazen. De groei wordt tijdelijk verminderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roślina wraca do zdrowia po ożywieniu. Wzrost jest chwilowo ograniczony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está a recuperar após ser revivida. O crescimento está temporariamente reduzido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está a recuperar após ser revivida. O crescimento está temporariamente reduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Растение восстанавливается после оживления. Рост временно снижен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitki yeniden canlandırıldıktan sonra iyileşiyor. Büyüme geçici olarak azalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "植物在复苏后恢复。生长暂时减少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "植物恢復後恢復。增長暫時減少。"
          }
        }
      }
    },

    "goal_close": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast geschafft – nur noch %1$@ %2$@ bis zu deinem Ziel von %3$@ %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost there — just %1$@ %2$@ to go until your goal of %3$@ %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya casi lo logras — solo te faltan %1$@ %2$@ para tu objetivo de %3$@ %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu y es presque — plus que %1$@ %2$@ avant ton objectif de %3$@ %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस थोड़ा और — आपके %3$@ %2$@ के लक्ष्य तक पहुँचने में सिर्फ %1$@ %2$@ बाकी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sei quasi — mancano solo %1$@ %2$@ al tuo obiettivo di %3$@ %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少しです — 目標の%3$@ %2$@まで、あと%1$@ %2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 다 왔어요 — 목표 %3$@ %2$@까지 %1$@ %2$@만 남았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna klaar — nog maar %1$@ %2$@ te gaan tot je doel van %3$@ %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już prawie — zostało tylko %1$@ %2$@ do Twojego celu %3$@ %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase lá — faltam apenas %1$@ %2$@ para sua meta de %3$@ %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase lá — faltam apenas %1$@ %2$@ para sua meta de %3$@ %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти у цели — осталось всего %1$@ %2$@ до цели %3$@ %2$@."
          }
        },
        "tr": {
          "stringUnit": {

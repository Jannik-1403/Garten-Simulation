            "value" : "Мне просто крайне не везло, и обстоятельства были против меня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son derece şanssızdım ve koşullar bana karşıydı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我只是非常倒霉，情况对我不利。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我只是非常不幸，環境對我不利。"
          }
        }
      }
    },
    "assessment.growth.q15.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe mich ständig mit irrelevanter Theorie aufgehalten und mich nie getraut, die echten Hebel zu ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I was constantly dwelling on irrelevant theory and never dared to pull the real levers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaba constantemente pensando en teorías irrelevantes y nunca me atrevía a tirar de las palancas reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je m’attardais constamment sur des théories non pertinentes et je n’osais jamais actionner les vrais leviers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं लगातार अप्रासंगिक सिद्धांत पर विचार कर रहा था और वास्तविक लीवर खींचने की कभी हिम्मत नहीं कर पाया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi soffermavo costantemente su teorie irrilevanti e non osavo mai tirare le vere leve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は常に無関係な理論に固執し、実際のレバーを引く勇気がありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 끊임없이 관련 없는 이론에 빠져 있었고 감히 실제 레버를 당기지 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik was voortdurend bezig met irrelevante theorieën en durfde nooit aan de echte hefbomen te trekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciągle rozwodziłem się nad nieistotną teorią i nigdy nie odważyłem się pociągnąć za prawdziwą dźwignię."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu estava constantemente pensando em teorias irrelevantes e nunca ousei puxar as alavancas reais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я постоянно занимался несущественной теорией и никогда не смел задействовать настоящие рычаги."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürekli olarak alakasız teoriler üzerinde duruyordum ve gerçek kaldıraçları çekmeye asla cesaret edemiyordum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我一直沉迷于无关的理论，从未敢真正去发挥关键作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我總是沉迷於無關緊要的理論，從來不敢拉真正的槓桿。"
          }
        }
      }
    },
    "assessment.growth.q15.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe jedes Mal aufgegeben, wenn es keinen Spaß mehr gemacht hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gave up every time it stopped being fun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me rendí cada vez que dejó de ser divertido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai abandonné à chaque fois que ça n'était plus amusant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर बार जब इसमें मज़ा आना बंद हो गया तो मैंने हार मान ली।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi arrendevo ogni volta che smetteva di essere divertente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽しくなくなるたびに諦めていました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재미가 없어질 때마다 포기했어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke keer als het niet meer leuk was, gaf ik het op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poddawałam się za każdym razem, gdy przestało być zabawne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desisti toda vez que isso deixou de ser divertido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я сдавался каждый раз, когда это переставало приносить удовольствие."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eğlenceli olmayı bıraktığı her an vazgeçtim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次一旦不再有乐趣，我就放弃了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每當它不再有趣時我就放棄了。"
          }
        }
      }
    },
    "assessment.growth.q15.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle drei oben genannten Punkte treffen zu. Ich übernehme die volle Verantwortung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All three points above apply. I take full responsibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplican los tres puntos anteriores. Asumo toda la responsabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trois points ci-dessus s’appliquent. J'en assume l'entière responsabilité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपरोक्त तीनों बिंदु लागू होते हैं। मैं पूरी जिम्मेदारी लेता हूं."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applicano tutti e tre i punti precedenti. Mi assumo la piena responsabilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上記の3点がすべて当てはまります。私が全責任を負います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 세 가지 사항이 모두 적용됩니다. 나는 모든 책임을 집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle drie bovenstaande punten zijn van toepassing. Ik neem de volledige verantwoordelijkheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obowiązują wszystkie trzy powyższe punkty. Biorę na siebie pełną odpowiedzialność."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os três pontos acima se aplicam. Assumo total responsabilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все три вышеуказанных пункта верны. Я беру на себя полную ответственность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıdaki üç noktanın tümü geçerlidir. Tüm sorumluluğu alıyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上述三点都适用。我承担全部责任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上述三點均適用。我承擔全部責任。"
          }
        }
      }
    },

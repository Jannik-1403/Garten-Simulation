    "powerup.weed_shield.needs_weed.message" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Power-up bleibt in deinem Inventar. Sobald Unkraut da ist, erneut antippen und „Benutzen“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This power-up stays in your inventory. When weeds appear, tap it again and choose Use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este power-up queda en tu inventario. Cuando haya malas hierbas, tócalo y elige Usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce power-up reste dans ton inventaire. Quand il y a des mauvaises herbes, appuie dessus puis Utiliser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पावर-अप आपके इनवेंटरी में रहेगा। जैसे ही जीवाणु दिखाई दे, इसे फिर से टैप करें और 'उपयोग करें' चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo power-up resta nell'inventario. Con le erbacce, toccalo e scegli Usa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパワーアップはインベントリに残ります。雑草が表示されたら、もう一度タップして使用を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파워업은 인벤토리에 유지됩니다. 잡초가 나타나면 다시 탭하고 사용을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze power-up blijft in je inventaris. Wanneer er onkruid verschijnt, tikt u er nogmaals op en kiest u Gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wzmocnienie pozostaje w Twoim ekwipunku. Kiedy pojawią się chwasty, dotknij go ponownie i wybierz Użyj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este power-up fica no inventário. Com ervas, toca nele e escolhe Usar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это усиление останется в вашем инвентаре. Как только появится сорняк, нажмите на него снова и выберите «Использовать»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu güçlendirme envanterinizde kalır. Yabani otlar göründüğünde tekrar dokunun ve Kullan'ı seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此强化道具将保留在你的物品栏中。一旦出现杂草，再次点击并选择“使用”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此強化道具仍保留在您的庫存中。一旦雜草出現，再次點擊並選擇“使用”。"
          }
        }
      }
    },

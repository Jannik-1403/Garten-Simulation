        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate: how often do you buy fast food per month and what does it cost you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula: ¿con qué frecuencia compras comida rápida al mes y cuánto te cuesta?"
          }
        },
        "fr": {

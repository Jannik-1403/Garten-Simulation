          }
        }
      }
    },
    "assessment.finance.q6.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts aktiv, aber das Geld verschwindet am Monatsende trotzdem auf dem Girokonto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing active, but the money still disappears into the checking account at the end of the month."

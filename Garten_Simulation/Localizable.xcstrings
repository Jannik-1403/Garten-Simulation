    "onboarding_tutorial_powerup_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gebe dir verschiedene Effekte für den Garten. Benutze sie um schöne Fortschritte zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll give you various effects for the garden. Use them to make beautiful progress."
          }
        },
        "es": {

    "prog_cleaning_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder hat diesen einen Stuhl oder Tisch, auf dem sich alles sammelt. Nimm dir heute diesen Hotspot vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone has that one chair or table where everything collects. Target this hotspot today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el mundo tiene esa silla o mesa donde se recoge todo. Apunte a este punto de acceso hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde a une chaise ou une table où tout se rassemble. Ciblez ce hotspot aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर किसी के पास एक कुर्सी या मेज होती है जहां सब कुछ इकट्ठा होता है। आज ही इस हॉटस्पॉट को लक्षित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno ha quella sedia o quel tavolo dove tutto si raccoglie. Prendi di mira questo hotspot oggi stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰もが、すべてが集まる椅子やテーブルを 1 つ持っています。今日はこのホットスポットをターゲットにしてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사람은 모든 것을 모으는 의자나 테이블을 하나씩 가지고 있습니다. 오늘 이 핫스팟을 목표로 삼으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen heeft die ene stoel of tafel waar alles zich verzamelt. Richt je vandaag nog op deze hotspot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy ma to jedno krzesło lub stół, na którym gromadzi się wszystko. Wybierz ten hotspot już dziś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mundo tem aquela cadeira ou mesa onde tudo se acumula. Segmente este ponto de acesso hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mundo tem aquela cadeira ou mesa onde tudo se acumula. Segmente este ponto de acesso hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого есть стул или стол, где все собирается. Нацельтесь на эту горячую точку сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkesin her şeyin toplandığı bir sandalyesi veya masası vardır. Bugün bu etkin noktayı hedefleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个人都有一张椅子或一张桌子，用来收集所有东西。今天就瞄准这个热点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個人都有一張椅子或一張桌子，用來收集所有東西。今天就瞄準這個熱點。"
          }
        }
      }
    },

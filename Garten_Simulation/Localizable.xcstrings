    "focus.session.completed.proud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst %lld Minuten lang extrem fokussiert. Deine Pflanze ist stolz auf dich!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were extremely focused for %lld minutes. Your plant is proud of you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste extremadamente concentrado durante %lld minutos. \u00a1Tu planta est\u00e1 orgullosa de ti!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as \u00e9t\u00e9 extr\u00eamement concentr\u00e9 pendant %lld minutes. Ta plante est fi\u00e8re de toi !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a%lld \u092e\u093f\u0928\u091f \u0924\u0915 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0925\u0947\u0964 \u0906\u092a\u0915\u0947 \u092a\u094c\u0927\u0947 \u0915\u094b \u0906\u092a \u092a\u0930 \u0917\u0930\u094d\u0935 \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato estremamente concentrato per %lld minuti. La tua pianta \u00e8 orgogliosa di te!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f%lld\u5206\u9593\u975e\u5e38\u306b\u96c6\u4e2d\u3057\u307e\u3057\u305f\u3002\u3042\u306a\u305f\u306e\u690d\u7269\u306f\u3042\u306a\u305f\u3092\u8a87\u308a\u306b\u601d\u3063\u3066\u3044\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld\ubd84 \ub3d9\uc548 \ub9e4\uc6b0 \uc9d1\uc911\ud588\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc2dd\ubb3c\uc774 \ub2f9\uc2e0\uc744 \uc790\ub791\uc2a4\ub7ec\uc6cc\ud569\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was %lld minuten lang extreem gefocust. Je plant is trots op je!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By\u0142e\u015b niezwykle skupiony przez %lld minut. Twoja ro\u015blina jest z ciebie dumna!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea esteve extremamente focado por %lld minutos. Sua planta est\u00e1 orgulhosa de voc\u00ea!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 %lld \u043c\u0438\u043d\u0443\u0442. \u0422\u0432\u043e\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0433\u043e\u0440\u0434\u0438\u0442\u0441\u044f \u0442\u043e\u0431\u043e\u0439!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakika boyunca son derece odaklanm\u0131\u015ft\u0131n\u0131z. Bitkiniz sizinle gurur duyuyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4e13\u6ce8\u4e86 %lld \u5206\u949f\u3002\u4f60\u7684\u690d\u7269\u4e3a\u4f60\u611f\u5230\u9a84\u50b2\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5728%lld \u5206\u9418\u5167\u975e\u5e38\u5c08\u6ce8\u3002\u4f60\u7684\u5de5\u5ee0\u70ba\u4f60\u611f\u5230\u9a55\u50b2\uff01"
          }
        }
      }
    },
    "focus.session.completed.xp_shared": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst %lld Minuten lang extrem fokussiert. Die XP werden auf alle deine Pflanzen aufgeteilt!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were extremely focused for %lld minutes. The XP will be distributed to all your plants!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste extremadamente enfocado durante %lld minutos. \u00a1Los XP se distribuir\u00e1n entre todas tus plantas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez \u00e9t\u00e9 extr\u00eamement concentr\u00e9 pendant %lld minutes. Les XP seront distribu\u00e9s \u00e0 toutes vos plantes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a%lld \u092e\u093f\u0928\u091f \u0924\u0915 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0925\u0947\u0964 XP \u0906\u092a\u0915\u0947 \u0938\u092d\u0940 \u092a\u094d\u0932\u093e\u0902\u091f\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u092d\u093e\u091c\u093f\u0924 \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato estremamente concentrato per %lld minuti. I punti XP verranno distribuiti a tutte le tue piante!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld\u5206\u9593\u3001\u975e\u5e38\u306b\u96c6\u4e2d\u3057\u3066\u3044\u307e\u3057\u305f\u3002XP\u306f\u3059\u3079\u3066\u306e\u690d\u7269\u306b\u5206\u914d\u3055\u308c\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld\ubd84 \ub3d9\uc548 \ub9e4\uc6b0 \uc9d1\uc911\ud588\uc2b5\ub2c8\ub2e4. XP\uac00 \ubaa8\ub4e0 \uc2dd\ubb3c\uc5d0 \ubd84\ubc30\ub429\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was %lld minuten lang extreem gefocust. De XP wordt verdeeld over al je planten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By\u0142e\u015b niezwykle skupiony przez %lld minut. XP zostan\u0105 podzielone na wszystkie twoje ro\u015bliny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estiveste extremamente focado durante %lld minutos. Os XP ser\u00e3o distribu\u00eddos por todas as tuas plantas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0431\u044b\u043b \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u043e \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d %lld \u043c\u0438\u043d\u0443\u0442. \u041e\u043f\u044b\u0442 \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d \u043c\u0435\u0436\u0434\u0443 \u0432\u0441\u0435\u043c\u0438 \u0442\u0432\u043e\u0438\u043c\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f\u043c\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakika boyunca son derece odakland\u0131n\u0131z. XP t\u00fcm bitkilerinize da\u011f\u0131t\u0131lacak!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4e13\u6ce8\u4e86 %lld \u5206\u949f\u3002\u7ecf\u9a8c\u503c\u5c06\u5206\u914d\u7ed9\u4f60\u7684\u6240\u6709\u690d\u7269\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5728%lld \u5206\u9418\u5167\u975e\u5e38\u5c08\u6ce8\u3002 XP \u6703\u5206\u914d\u7d66\u6240\u6709\u60a8\u7684\u5de5\u5ee0\uff01"
          }
        }
      }
    },
    "focus.session.dnd_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dein Handy jetzt auf 'Nicht st\u00f6ren' und lege es nach dieser Einrichtung au\u00dfer Sichtweite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phone on 'Do Not Disturb' now and place it out of sight after this setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu tel\u00e9fono en 'No Molestar' ahora y col\u00f3calo fuera de la vista despu\u00e9s de esta configuraci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez votre t\u00e9l\u00e9phone sur 'Ne pas d\u00e9ranger' maintenant et placez-le hors de vue apr\u00e8s cette configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092c \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u094b '\u092a\u0930\u0947\u0936\u093e\u0928 \u0928 \u0915\u0930\u0947\u0902' \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0938 \u0938\u0947\u091f\u0905\u092a \u0915\u0947 \u092c\u093e\u0926 \u0907\u0938\u0947 \u0926\u0943\u0937\u094d\u091f\u093f \u0938\u0947 \u0926\u0942\u0930 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il tuo telefono in 'Non Disturbare' ora e mettilo fuori dalla vista dopo questa configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u3059\u3050\u96fb\u8a71\u3092\u300c\u304a\u3084\u3059\u307f\u30e2\u30fc\u30c9\u300d\u306b\u3057\u3066\u3001\u8a2d\u5b9a\u5f8c\u306b\u898b\u3048\u306a\u3044\u5834\u6240\u306b\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uae08 \ud734\ub300\uc804\ud654\ub97c '\ubc29\ud574 \uae08\uc9c0' \ubaa8\ub4dc\ub85c \uc124\uc815\ud558\uace0 \uc124\uc815 \ud6c4 \ub208\uc5d0 \ub744\uc9c0 \uc54a\ub294 \uacf3\uc5d0 \ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je telefoon nu op 'Niet storen' en leg hem uit het zicht na deze installatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142\u0105cz teraz tryb 'Nie przeszkadza\u0107' i od\u0142\u00f3\u017c telefon poza zasi\u0119g wzroku po tej konfiguracji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seu telefone em 'N\u00e3o Perturbe' agora e coloque-o fora de vista ap\u00f3s esta configura\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043f\u0435\u0440\u044c \u0432\u043a\u043b\u044e\u0447\u0438 \u043d\u0430 \u0441\u0432\u043e\u0451\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0440\u0435\u0436\u0438\u043c \u00ab\u041d\u0435 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u044c\u00bb \u0438 \u0443\u0431\u0435\u0440\u0438 \u0435\u0433\u043e \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzu \u015fimdi 'Rahats\u0131z Etmeyin' moduna al\u0131n ve bu kurulumdan sonra g\u00f6zden uzak bir yere koyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73b0\u5728\u5c06\u624b\u673a\u8bbe\u7f6e\u4e3a\u201c\u52ff\u6270\u6a21\u5f0f\u201d\uff0c\u5e76\u5728\u8bbe\u7f6e\u5b8c\u6210\u540e\u5c06\u5176\u653e\u7f6e\u5728\u89c6\u7ebf\u4e4b\u5916\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\uff0c\u5c07\u60a8\u7684\u624b\u6a5f\u5207\u63db\u70ba\u201c\u8acb\u52ff\u6253\u64fe\u201d\uff0c\u4e26\u5728\u5b8c\u6210\u6b64\u8a2d\u5b9a\u5f8c\u5c07\u5176\u653e\u5728\u770b\u4e0d\u898b\u7684\u5730\u65b9\u3002"
          }
        }
      }
    },

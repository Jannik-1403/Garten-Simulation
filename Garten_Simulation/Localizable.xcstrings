    "plant.chrysantheme.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffe Ordnung in deiner Umgebung für einen klaren Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create order in your environment for a clear head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea orden en tu entorno para una mente despejada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez de l'ordre dans votre environnement pour un esprit clair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना दिमाग साफ़ करने के लिए अपने आस-पास व्यवस्था बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea ordine nel tuo ambiente per una mente lucida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭をすっきりさせるために、環境を整えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맑은 머리를 위해 환경을 정리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Creëer orde in je omgeving voor een helder hoofd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób porządek w swoim otoczeniu dla czystego umysłu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie ordem no seu ambiente para uma mente clara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie ordem no seu ambiente para uma mente clara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведи порядок вокруг себя для ясности ума."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Berrak bir zihin için çevrenizde düzen yaratın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理你的环境，保持头脑清醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創造周遭環境的秩序，讓你的頭腦清醒。"
          }
        }
      }
    },

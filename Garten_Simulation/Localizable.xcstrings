        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अच्छे लोग, लेकिन उनमें से कोई भी वास्तव में मुझे चुनौती नहीं देता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

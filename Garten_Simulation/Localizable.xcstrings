    "tour_profile_prompt_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass uns dein Profil ansehen! Klicke auf Weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's view your profile! Click Next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Vamos a ver tu perfil! Haz clic en Siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardons ton profil ! Cliquez sur Suivant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0913 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0926\u0947\u0916\u0947\u0902! \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardiamo il tuo profilo! Clicca su Avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\uff01\u6b21\u3078\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\ud544\uc744 \uc0b4\ud3b4\ubd05\uc2dc\ub2e4! \ub2e4\uc74c\uc744 \ud074\ub9ad\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten we je profiel bekijken! Klik op Volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobaczmy tw\u00f3j profil! Kliknij Dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos ver seu perfil! Clique em Pr\u00f3ximo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043c \u0432\u0430\u0448 \u043f\u0440\u043e\u0444\u0438\u043b\u044c! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u0414\u0430\u043b\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadi profiline bakal\u0131m! Sonraki'ye t\u0131kla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba9\u6211\u4eec\u770b\u770b\u60a8\u7684\u4e2a\u4eba\u8d44\u6599\uff01\u5355\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b93\u6211\u5011\u770b\u770b\u60a8\u7684\u500b\u4eba\u8cc7\u6599\uff01\u6309\u4e00\u4e0b\u201c\u4e0b\u4e00\u6b65\u201d\u3002"
          }
        }
      }
    },
    "tour_prompt_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f6chtest du eine kurze Einf\u00fchrung in die wichtigsten Funktionen von Grovy erhalten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like a quick tour of the main features of Grovy?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfLe gustar\u00eda un recorrido r\u00e1pido por las caracter\u00edsticas principales de Grovy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous un tour rapide des principales fonctionnalit\u00e9s de Grovy ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a Grovy \u0915\u0940 \u092e\u0941\u0916\u094d\u092f \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u090f\u0915 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u092a\u0930\u093f\u091a\u092f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Desideri un rapido tour delle principali funzionalit\u00e0 di Grovy?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy \u306e\u4e3b\u306a\u6a5f\u80fd\u306b\u3064\u3044\u3066\u7c21\u5358\u306b\u8aac\u660e\u3057\u3066\u307f\u307e\u305b\u3093\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy\uc758 \uc8fc\uc694 \uae30\ub2a5\uc744 \ube60\ub974\uac8c \uc0b4\ud3b4\ubcf4\uace0 \uc2f6\uc73c\uc2e0\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u een korte rondleiding door de belangrijkste functies van Grovy?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz szybko zapozna\u0107 si\u0119 z g\u0142\u00f3wnymi funkcjami Grovy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de um tour r\u00e1pido pelos principais recursos do Grovy?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0425\u043e\u0442\u0438\u0442\u0435 \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f \u0441 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c\u0438 Grovy?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grovy'nin ana \u00f6zelliklerine h\u0131zl\u0131 bir tur atmak ister misiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u60f3\u5feb\u901f\u4e86\u89e3 Grovy \u7684\u4e3b\u8981\u529f\u80fd\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u60f3\u5feb\u901f\u4e86\u89e3 Grovy \u7684\u4e3b\u8981\u529f\u80fd\u55ce\uff1f"
          }
        }
      }
    },

    "trash.party_pass.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sch\u00f6ner Weg durchs Gr\u00fcne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beautiful path through the greenery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hermoso sendero entre el verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un beau chemin \u00e0 travers la verdure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930\u0940-\u092d\u0930\u0940 \u091c\u0917\u0939 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u090f\u0915 \u0938\u0941\u0902\u0926\u0930 \u092e\u093e\u0930\u094d\u0917\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A beautiful path through the greenery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7dd1\u306e\u4e2d\u306e\u7f8e\u3057\u3044\u5c0f\u9053\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc9c0\ub97c \ud1b5\uacfc\ud558\ub294 \uc544\ub984\ub2e4\uc6b4 \uae38."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een prachtig pad door het groen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi\u0119kna \u015bcie\u017cka w\u015br\u00f3d zieleni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um belo caminho pelo verde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0440\u0430\u0441\u0438\u0432\u044b\u0439 \u043f\u0443\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u043b\u044c\u0441\u043a\u0443\u044e \u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ye\u015filliklerin aras\u0131nda g\u00fczel bir yol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6761\u7f8e\u4e3d\u7684\u5c0f\u8def\u7a7f\u8fc7\u4e61\u6751\u3002"
          }
        },
        "zh-Hant": {

    "backup_fehler_version": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde mit einer neueren App-Version erstellt. Bitte aktualisiere die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was created with a newer version of the app. Please update the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo fue creado con una versión más reciente de la app. Por favor actualiza la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a été créé avec une version plus récente de l'application. Mets l'application à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल एक नए ऐप संस्करण के साथ बनाई गई थी। कृपया ऐप को अपडेट करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è stato creato con una versione più recente dell'app. Aggiorna l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは、新しいバージョンのアプリで作成されました。アプリをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 최신 버전의 앱으로 생성되었습니다. 앱을 업데이트해주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is gemaakt met een nieuwere versie van de app. Update de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik został utworzony w nowszej wersji aplikacji. Zaktualizuj aplikację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro foi criado com uma versão mais recente da aplicação. Atualiza a aplicação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro foi criado com uma versão mais recente da aplicação. Atualiza a aplicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл был создан с помощью более новой версии приложения. Пожалуйста, обновите приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya uygulamanın daha yeni bir sürümüyle oluşturuldu. Lütfen uygulamayı güncelleyin."

    "assessment.growth.q5": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist seit 20 Minuten hochkonzentriert bei der Arbeit. Plötzlich vibriert dein Handy – eine Nachricht von einer Person, die du extrem interessant findest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have been highly concentrated at work for 20 minutes. Suddenly your phone vibrates - a message from someone you find extremely interesting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has estado muy concentrado en el trabajo durante 20 minutos. De repente, tu teléfono vibra: es un mensaje de alguien que te parece extremadamente interesante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été très concentré au travail pendant 20 minutes. Soudain, votre téléphone vibre – un message de quelqu'un que vous trouvez extrêmement intéressant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato molto concentrato sul lavoro per 20 minuti. All'improvviso il tuo telefono vibra: un messaggio da qualcuno che trovi estremamente interessante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは 20 分間、非常に集中して仕事に取り組みました。突然携帯電話が振動します。非常に興味深い人からのメッセージです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 20분 동안 직장에 매우 집중했습니다. 갑자기 휴대전화가 진동합니다. 매우 흥미로운 사람이 보낸 메시지입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U bent gedurende 20 minuten zeer geconcentreerd aan het werk geweest. Plots trilt je telefoon: een bericht van iemand die je buitengewoon interessant vindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byłeś bardzo skoncentrowany w pracy przez 20 minut. Nagle Twój telefon wibruje – wiadomość od osoby, którą uważasz za niezwykle interesującą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você esteve altamente concentrado no trabalho por 20 minutos. De repente, seu telefone vibra – uma mensagem de alguém que você acha extremamente interessante."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "20 dakika boyunca işinize son derece konsantre oldunuz. Aniden telefonunuz titrer; son derece ilginç bulduğunuz birinden gelen bir mesaj."
          }
        }
      }
    },
    "assessment.growth.q5.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schaue sofort nach und antworte kurz. Das dauert ja nur 10 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll check immediately and answer briefly. That only takes 10 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo comprobaré inmediatamente y responderé brevemente. Eso sólo lleva 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais vérifier immédiatement et répondre brièvement. Cela ne prend que 10 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllo subito e rispondo brevemente. Ci vogliono solo 10 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに確認して簡単にお答えします。所要時間はわずか 10 秒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 확인하고 간략하게 답변 드리겠습니다. 단 10초밖에 걸리지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

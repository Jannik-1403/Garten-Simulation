    "streak.freeze.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Streak auf Eis schützt deinen Streak einen Tag lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Streak Freeze protects your streak for one day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un protector de racha protege tu racha por un día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gel de série protège ta série pendant un jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बर्फ पर एक स्ट्रीक आपके स्ट्रीक को एक दिन के लिए बचाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno Streak Freeze protegge la tua serie per un giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーク フリーズは、ストリークを 1 日間保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak Freeze는 하루 동안 연속 기록을 보호합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Streak Freeze beschermt je streak voor één dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak Freeze chroni Twoją passę przez jeden dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um protetor de sequência protege a tua sequência por um dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um protetor de sequência protege a tua sequência por um dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полоса на льду защищает ваш стрик в течение одного дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizgi Dondurma serinizi bir gün boyunca korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冰上连胜可以保护您一天的连胜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "冰上連勝可以保護您一天的連勝。"
          }
        }
      }
    },

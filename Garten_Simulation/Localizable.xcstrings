    "plant.sonnenblume.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht sich immer zur Sonne \u2013 Fr\u00fchaufsteher-Energie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always turns to the sun \u2013 Early bird energy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre mira al sol \u2013 Energ\u00eda madrugadora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tourne toujours vers le soleil \u2013 \u00c9nergie du l\u00e8ve-t\u00f4t"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u092e\u0947\u0936\u093e \u0938\u0942\u0930\u091c \u0915\u0940 \u0913\u0930 \u092e\u0941\u0921\u093c\u0924\u093e \u0939\u0948 \u2013 \u0938\u0941\u092c\u0939 \u091c\u0932\u094d\u0926\u0940 \u0909\u0920\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u0915\u0940 \u090a\u0930\u094d\u091c\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Always turns to the sun \u2013 Early bird energy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e38\u306b\u592a\u967d\u3092\u5411\u304f \u2013 \u65e9\u8d77\u304d\u306e\u30a8\u30cd\u30eb\u30ae\u30fc"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b8\uc81c\ub098 \ud0dc\uc591\uc744 \ud5a5\ud55c\ub2e4 - \uc5bc\ub9ac\ubc84\ub4dc \uc5d0\ub108\uc9c0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait zich altijd naar de zon \u2013 Early bird-energie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze zwraca si\u0119 ku s\u0142o\u0144cu \u2013 Energia wczesnego ptaka"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre voltado para o sol \u2013 Energia de madrugador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435\u0433\u0434\u0430 \u043f\u043e\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a \u0441\u043e\u043b\u043d\u0446\u0443 \u2013 \u044d\u043d\u0435\u0440\u0433\u0438\u044f \u0440\u0430\u043d\u043d\u0438\u0445 \u043f\u0442\u0430\u0448\u0435\u043a"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman g\u00fcne\u015fe d\u00f6ner \u2013 Erkenci ku\u015f enerjisi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c38\u8fdc\u9762\u5411\u592a\u9633 \u2013 \u65e9\u8d77\u8005\u7684\u80fd\u91cf"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c38\u9060\u9762\u5411\u592a\u967d\uff0d\u65e9\u8d77\u7684\u80fd\u91cf"
          }
        }
      }
    },
    "plant.sonnenblume.name": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {

    "backup_import_bestaetigung_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller Spielstand wird vollständig überschrieben. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current save will be completely replaced. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida actual será completamente reemplazada. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sauvegarde actuelle sera entièrement remplacée. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वर्तमान सेव पूरी तरह से अधिलेखित कर दिया जाएगा. इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo salvataggio attuale verrà completamente sovrascritto. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の保存は完全に置き換えられます。この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 저장 내용이 완전히 대체됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huidige save wordt volledig vervangen. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój obecny zapis zostanie całkowicie zastąpiony. Tej akcji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu progresso atual será completamente substituído. Esta ação não pode ser desfeita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu progresso atual será completamente substituído. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш текущий прогресс в игре будет полностью перезаписан. Это действие нельзя будет отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kaydetmeniz tamamen değiştirilecek. Bu eylem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前的游戏进度将被完全覆盖。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您目前的保存將被完全覆蓋。此操作無法撤銷。"
          }
        }
      }
    },

    "prog_selfcare_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir heute extra Zeit für deinen Körper. Eine Gesichtsmaske, ein Peeling oder Eincremen mit bewusster Aufmerksamkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take extra time for your body today. A face mask, a peeling or cream with conscious attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate más tiempo para tu cuerpo hoy. Una mascarilla, un peeling o una crema con atención consciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez plus de temps pour votre corps aujourd’hui. Un masque, un peeling ou une crème avec une attention consciente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज अपने शरीर के लिए अतिरिक्त समय निकालें। एक फेस मास्क, एक छीलने या सचेत ध्यान से क्रीम।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi più tempo per il tuo corpo oggi. Una maschera per il viso, un peeling o una crema con attenzione consapevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は体のためにもっと時間をとってください。意識してフェイスマスクやピーリング、クリームを塗る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 몸을 위한 시간을 더 가져보세요. 의식적으로 주의를 기울여 얼굴 마스크, 필링 또는 크림을 바르십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem vandaag extra tijd voor je lichaam. Een gezichtsmasker, een peeling of crème met bewuste aandacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poświęć dziś więcej czasu swojemu ciału. Maseczka do twarzy, peeling lub krem ​​ze świadomą uwagą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve um tempo extra para o seu corpo hoje. Uma máscara facial, um peeling ou creme com atenção consciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve um tempo extra para o seu corpo hoje. Uma máscara facial, um peeling ou creme com atenção consciente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уделите сегодня больше времени своему телу. Маска для лица, пилинг или крем с осознанным вниманием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün vücudunuza ekstra zaman ayırın. Bilinçli bir dikkat ile yüz maskesi, peeling veya krem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天多花点时间照顾身体。有意识地敷面膜、去角质或面霜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天多花點時間照顧身體。有意識地敷面膜、去角質或乳霜。"
          }
        }
      }
    },

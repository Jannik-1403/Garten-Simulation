    "stats.focus.less": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute %@ Minuten fr\u00fcher Schluss gemacht als gestern. Bleib dran!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stopped %@ minutes earlier today than yesterday. Keep at it!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy terminaste %@ minutos antes que ayer. \u00a1Sigue as\u00ed!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez arr\u00eat\u00e9 %@ minutes plus t\u00f4t aujourd'hui qu'hier. Continuez !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u0928\u0947 \u0906\u091c \u0915\u0932 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u092e\u0947\u0902%@\u092e\u093f\u0928\u091f \u092a\u0939\u0932\u0947 \u0915\u093e\u092e \u0916\u0924\u094d\u092e \u0915\u093f\u092f\u093e\u0964 \u0932\u0917\u0947 \u0930\u0939\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai finito %@ minuti prima oggi rispetto a ieri. Tieni duro!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u6628\u65e5\u3088\u308a%@\u5206\u65e9\u304f\u7d42\u4e86\u3057\u307e\u3057\u305f\u3002\u9811\u5f35\u3063\u3066\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \uc5b4\uc81c\ubcf4\ub2e4 %@\ubd84 \uc77c\ucc0d \ub9c8\ucce4\uc2b5\ub2c8\ub2e4. \uacc4\uc18d\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent vandaag %@ minuten eerder gestopt dan gisteren. Blijf volhouden!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sko\u0144czy\u0142e\u015b dzisiaj o %@ minut wcze\u015bniej ni\u017c wczoraj. Trzymaj tak dalej!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea terminou %@ minutos mais cedo hoje do que ontem. Continue!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0442\u044b \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b \u043d\u0430%@\u043c\u0438\u043d\u0443\u0442 \u0440\u0430\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u0432\u0447\u0435\u0440\u0430. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0432 \u0442\u043e\u043c \u0436\u0435 \u0434\u0443\u0445\u0435!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn d\u00fcnden %@ dakika daha erken bitirdiniz. Devam edin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u4eca\u5929\u6bd4\u6628\u5929\u65e9\u5b8c\u6210\u4e86%@\u5206\u949f\u3002\u656c\u8bf7\u5173\u6ce8\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u4eca\u5929\u6bd4\u6628\u5929\u65e9\u5b8c\u6210\u4e86%@\u5206\u9418\u3002\u656c\u8acb\u95dc\u6ce8\uff01"
          }
        }
      }
    },

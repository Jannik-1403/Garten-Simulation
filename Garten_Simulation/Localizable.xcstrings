    "prog_coldshower_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne an den Füßen und Händen und wandere langsam Richtung Herzmuskel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with your feet and hands and slowly move towards your heart muscle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience con los pies y las manos y avance lentamente hacia el músculo cardíaco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par vos pieds et vos mains et avancez lentement vers votre muscle cardiaque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पैरों और हाथों से शुरू करें और धीरे-धीरे अपने हृदय की मांसपेशियों की ओर बढ़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con i piedi e le mani e muoviti lentamente verso il muscolo cardiaco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足と手から始めて、ゆっくりと心筋に向かって動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발과 손부터 시작하여 천천히 심장 근육쪽으로 이동하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met je voeten en handen en beweeg langzaam richting je hartspier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od stóp i dłoni i powoli przesuwaj się w stronę mięśnia sercowego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com os pés e as mãos e mova-se lentamente em direção ao músculo cardíaco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com os pés e as mãos e mova-se lentamente em direção ao músculo cardíaco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с ног и рук и медленно двигайтесь к сердечной мышце."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaklarınız ve ellerinizle başlayın ve yavaşça kalp kasınıza doğru ilerleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从脚和手开始，慢慢移向心肌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從腳和手開始，慢慢移向心肌。"
          }
        }
      }
    },

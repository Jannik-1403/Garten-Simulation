    "prog_strength_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolviere ein EMOM - %lld Minuten. Squats müssen tief sein (Hüfte unter Kniehöhe)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete an EMOM - %lld minutes. Squats must be deep (hips below knees)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un EMOM - %lld minutos. Las sentadillas deben ser profundas (caderas por debajo de la altura de las rodillas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez un EMOM - %lld minutes. Les squats doivent être profonds (hanches en dessous de la hauteur des genoux)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक EMOM पूरा करें - %lld मिनट। स्क्वैट्स गहरे होने चाहिए (कूल्हे घुटने से नीचे)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un EMOM - %lld minuti. Gli squat devono essere profondi (fianchi sotto l'altezza del ginocchio)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOMを完了してください - %lld 分間。スクワットは深く（股関節が膝より下になるように）行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM 완료 - %lld 분. 스쿼트는 깊게 해야 합니다(엉덩이가 무릎 아래로)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi een EMOM - %lld minuten. Squats moeten diep zijn (heupen onder kniehoogte)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończ EMOM - %lld minut. Przysiady muszą być głębokie (biodra poniżej kolan)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua um EMOM - %lld minutos. Os agachamentos devem ser profundos (quadril abaixo do joelho)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua um EMOM - %lld minutos. Os agachamentos devem ser profundos (quadril abaixo do joelho)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните EMOM - %lld минут. Приседания должны быть глубокими (таз ниже уровня колен)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EMOM tamamlayın - %lld dakika. Squat'lar derin olmalıdır (kalça diz seviyesinin altında)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 EMOM - %lld 分钟。深蹲必须够深（臀部低于膝盖）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 EMOM - %lld 分鐘。深蹲必須夠深（臀部低於膝蓋）。"
          }
        }
      }
    },

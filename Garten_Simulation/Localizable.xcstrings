    "assessment.health.profile.vergifter.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sabotierst deinen eigenen Motor. Falsches Essen, falsche Getränke, kein echtes Wasser — dein Gehirn kämpft täglich mit dem Material, das du ihm gibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're sabotaging your own engine. Wrong food, wrong drinks, no real water — your brain battles daily with the material you give it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás saboteando tu propio motor. Comida equivocada, bebidas equivocadas, nada de agua real: tu cerebro lucha diariamente con el material que le das."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous sabotez votre propre moteur. Mauvaise nourriture, mauvaises boissons, pas de vraie eau – votre cerveau se bat quotidiennement avec le matériel que vous lui donnez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai sabotando il tuo stesso motore. Cibo sbagliato, bevande sbagliate, niente vera acqua: il tuo cervello combatte quotidianamente con il materiale che gli dai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身のエンジンを妨害しているのです。間違った食べ物、間違った飲み物、本物の水はありません - あなたの脳は毎日与えられる物質と戦っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 자신의 엔진을 파괴하고 있습니다. 잘못된 음식, 잘못된 음료, 실제 물 없음 — 당신의 두뇌는 당신이 제공하는 물질과 매일 싸우고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je saboteert je eigen motor. Verkeerd eten, verkeerde drankjes, geen echt water – je hersenen strijden dagelijks met de stof die je ze geeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabotujesz własny silnik. Niewłaściwe jedzenie, złe napoje, brak prawdziwej wody – Twój mózg codziennie walczy z materiałem, który mu podajesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está sabotando seu próprio motor. Comida errada, bebidas erradas, sem água de verdade – seu cérebro luta diariamente com o material que você lhe dá."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi motorunu sabote ediyorsun. Yanlış yiyecek, yanlış içecekler, gerçek su yok; beyniniz ona verdiğiniz materyalle her gün savaşır."
          }
        }
      }
    },

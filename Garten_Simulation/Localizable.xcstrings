    "onboarding_legal_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du loslegst, bitten wir dich, unsere Bedingungen zu akzeptieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you get started, please accept our terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de empezar, acepta nuestros términos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de commencer, veuillez accepter nos conditions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरंभ करने से पहले, हम आपसे हमारे नियम और शर्तें स्वीकार करने के लिए कहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di iniziare, accetta i nostri termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始める前に、利用規約に同意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하기 전에 약관에 동의해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteer eerst onze voorwaarden voordat u aan de slag gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim zaczniesz, zaakceptuj nasze warunki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de começares, aceita os nossos termos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de começares, aceita os nossos termos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем начать, мы просим вас принять наши условия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamadan önce lütfen şartlarımızı kabul edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在开始之前，请你接受我们的条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開始之前，我們要求您接受我們的條款和條件。"
          }
        }
      }
    },

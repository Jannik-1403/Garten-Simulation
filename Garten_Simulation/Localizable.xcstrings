      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verhandle mit mir selbst: 'Nur 5 Minuten anfangen', ziehe es dann aber oft durch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I negotiate with myself: 'Just start for 5 minutes', but then I often follow through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negocio conmigo mismo: \"Sólo empiezo por 5 minutos\", pero luego a menudo sigo hasta el final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je négocie avec moi-même : « Commencez juste pendant 5 minutes », mais ensuite je vais souvent jusqu'au bout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं खुद से बातचीत करता हूं: 'बस 5 मिनट के लिए शुरुआत करें', लेकिन फिर मैं अक्सर उस पर अमल करता हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negozio con me stesso: \"Inizia solo per 5 minuti\", ma poi spesso vado avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「5分だけ始めて」と自分に言い聞かせますが、その後はやり遂げることが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'5분만 시작해 보세요'라고 스스로 협상하지만, 그러다가 끝까지 따라가는 경우가 많습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik onderhandel met mezelf: ‘Begin maar 5 minuten’, maar dan ga ik vaak door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negocjuję ze sobą: „Zacznij od 5 minut”, ale potem często dotrzymuję słowa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu negocio comigo mesmo: 'Comece por 5 minutos', mas depois muitas vezes sigo em frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я веду с собой переговоры: «Только начать на 5 минут», но часто все же довожу дело до конца."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendimle pazarlık yapıyorum: 'Sadece 5 dakikalığına başla', ama sonra çoğu zaman sonuna kadar devam ediyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

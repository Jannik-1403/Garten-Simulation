    "streak.freeze.used.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Streak Freeze hat deinen Streak heute gerettet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Streak Freeze saved your streak today."

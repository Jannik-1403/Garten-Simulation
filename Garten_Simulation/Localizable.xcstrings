    "habit.gratitude.differently.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würdest du rückblickend anders machen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you do differently in retrospect?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué harías diferente en retrospectiva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que feriez-vous différemment avec le recul ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीछे मुड़कर देखें तो आप क्या अलग करते?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa faresti diversamente col senno di poi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り返ってみて、何を違うようにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌이켜보면 무엇을 다르게 하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat zou je achteraf gezien anders doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co byś zrobił inaczej z perspektywy czasu?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você faria diferente em retrospecto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você faria diferente em retrospecto?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы вы сделали по-другому, оглядываясь назад?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geriye dönüp baktığında neyi farklı yapardın?"

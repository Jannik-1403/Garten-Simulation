        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was sent to jannik.schill.2010@gmail.com. We'll get back to you soon!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su mensaje ha sido enviado a jannik.schill.2010@gmail.com. ¡Estaremos en contacto pronto!"

      "comment": "A",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld / 5": {
      "comment": "A text label showing the current amount of life points a user has, followed by a slash and the maximum possible amount. The argument is the current life points, and the second is the maximum possible amount.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true
    },
    "%lld %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld %2$@"
          }
        }
      }
    },
    "%lld Unkraut": {
      "comment": "A label that describes the number of weeds in the stack indicator. The argument is the number of weeds.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true
    },
    "%lld.": {},

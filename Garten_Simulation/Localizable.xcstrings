    "trash.junk_mail_abo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere alle nicht dringenden Benachrichtigungen auf deinem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable all non-urgent notifications on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva todas las notificaciones no urgentes en tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive toutes les notifications non urgentes sur ton téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फोन पर सभी गैर-ज़रूरी सूचनाओं को अक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabilita tutte le notifiche non urgenti sul tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話の緊急でない通知をすべてオフにしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰의 긴급하지 않은 알림을 모두 끄세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel alle niet-urgente meldingen op je telefoon uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz wszystkie niepilne powiadomienia w telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative todas as notificações não urgentes no seu celular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative todas as notificações não urgentes no seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите все несрочные уведомления на телефоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonundaki tüm acil olmayan bildirimleri devre dışı bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭手机上所有非紧急通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉手機上所有非緊急通知。"
          }
        }
      }
    },
    "trash.junk_mail_abo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Minute am Bildschirm ist eine Minute weniger echtes Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every minute on screen is one less minute of real life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada minuto frente a la pantalla es un minuto menos de vida real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque minute à l'écran est une minute de moins de vraie vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर हर मिनट असली जीवन में एक मिनट कम होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni minuto sullo schermo è un minuto in meno di vita reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の前の1分は、現実の生活の1分が失われることを意味します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 앞의 1분은 실제 생활의 1분이 줄어드는 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke minuut op het scherm is een minuut minder echt leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda minuta przed ekranem to minuta mniej prawdziwego życia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada minuto na tela é um minuto a menos de vida real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada minuto na tela é um minuto a menos de vida real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая минута на экране — это на минуту меньше реальной жизни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran başındaki her dakika, gerçek hayattan bir dakika daha azdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上的每一分钟都比现实生活少一分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕上的每一分鐘都比現實生活少一分鐘。"
          }
        }
      }
    },
    "trash.junk_mail_abo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine App, die deine Bildschirmzeit begrenzt (z.B. Screentime)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an app that limits your screen time (e.g. Screen Time)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una app que limite tu tiempo de pantalla (p. ej., Tiempo de Pantalla)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une application qui limite ton temps d'écran (p. ex. Temps d'écran)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऐप का उपयोग करें जो आपकी स्क्रीन समय को सीमित करे (जैसे Screentime)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un'app che limita il tuo tempo schermo (es. Tempo di utilizzo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムを制限するアプリを使いましょう（例：スクリーンタイム）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임을 제한하는 앱을 사용하세요(예: 스크린 타임)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een app die je schermtijd beperkt (bijv. Schermtijd)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj aplikacji ograniczającej czas przed ekranem (np. Czas przed ekranem)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um app que limite seu tempo de tela (ex: Tempo de Uso)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um app que limite seu tempo de tela (ex: Tempo de Uso)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте приложение, которое ограничивает ваше экранное время (например, Screentime)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran sürenizi sınırlayan bir uygulama kullanın (örn. Ekran Süresi)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用限制屏幕时间的应用程序（例如 Screentime）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用限制螢幕時間的應用程式（例如 Screentime）。"
          }
        }
      }
    },
    "trash.junk_mail_abo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaue jeden Abend die Bildschirmzeit-Statistik an – und setze neue Rekorde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the screen time statistics every evening – and set new records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba cada noche las estadísticas del tiempo de pantalla y bate nuevos récords."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte les statistiques de temps d'écran chaque soir – et établis de nouveaux records."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रात स्क्रीन समय सांख्यिकी देखें – और नए रिकॉर्ड बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le statistiche del tempo schermo ogni sera – e stabilisci nuovi record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎晩スクリーンタイムの統計を確認して、新記録を目指しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 저녁 스크린 타임 통계를 확인하고 새 기록을 세우세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk elke avond de statistieken van de schermtijd – en stel nieuwe records."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzaj co wieczór statystyki czasu przed ekranem – i ustanawiaj nowe rekordy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as estatísticas de tempo de tela toda noite – e estabeleça novos recordes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as estatísticas de tempo de tela toda noite – e estabeleça novos recordes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяйте статистику экранного времени каждый вечер — и устанавливайте новые рекорды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her akşam ekran süresi istatistiklerine bak – ve yeni rekorlar kır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天晚上查看屏幕时间统计数据 - 并创造新记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天晚上查看螢幕時間統計資料 - 並創造新記錄。"
          }
        }
      }
    },
    "trash.junk_mail_abo.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Spam & Ablenkung)**\n1. Unsichtbar machen: Entferne die Auslöser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue Hürden ein (z.B. Apps löschen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausführung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Digital Detox)**\n1. Offensichtlich machen: Platziere den Auslöser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die Hürden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Distractions)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Deshágase de los malos hábitos (spam y distracciones)**\n1. Hazte invisible: elimina los factores desencadenantes de tu campo de visión.\n2. Hazte poco atractivo: sé consciente de las consecuencias negativas.\n3. Hazlo difícil: establece obstáculos (por ejemplo, eliminar aplicaciones, desconectarte).\n4. Hacerlo insatisfactorio: Adjuntar la ejecución a una pena.\n\n**Establece buenos hábitos (Digital Detox)**\n1. Hazlo obvio: coloca el gatillo claramente visible.\n2. Hazlo atractivo: Asócialo con algo que te guste.\n3. Hazlo simple: reduce los obstáculos al mínimo (por ejemplo, solo 2 minutos).\n4. Hazlo satisfactorio: Prémiate inmediatamente después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Débarrassez-vous des mauvaises habitudes (spam et distraction)**\n1. Rendre invisible : supprimez les déclencheurs de votre champ de vision.\n2. Rendez-vous peu attrayant : soyez conscient des conséquences négatives.\n3. Rendez les choses difficiles : définissez des obstacles (par exemple, supprimer des applications, débrancher).\n4. Rendez-le insatisfaisant : attachez l’exécution à une pénalité.\n\n**Établir de bonnes habitudes (Digital Detox)**\n1. Rendez-le évident : placez la gâchette clairement visible.\n2. Rendez-le attrayant : Associez-le à quelque chose que vous aimez.\n3. Faites simple : réduisez les obstacles au minimum (par exemple seulement 2 minutes).\n4. Rendez-le satisfaisant : récompensez-vous immédiatement après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**बुरी आदत से छुटकारा पाना (स्पैम और ध्यान भटकना)**\n1. अदृश्य बनाएं: अपने दृश्य क्षेत्र से ट्रिगर्स हटा दें।\n2. अप्रिय बनाएं: नकारात्मक परिणामों के बारे में जागरूक हों।\n3. मुश्किल बनाएं: बाधाएँ डालें (जैसे ऐप्स हटाना, प्लग निकालना)।\n4. असंतोषजनक बनाएं: कार्य को दंड से जोड़ें।\n\n**अच्छी आदत स्थापित करना (डिजिटल डिटॉक्स)**\n1. स्पष्ट बनाएं: ट्रिगर को अच्छी तरह दिखाई देने वाली जगह पर रखें।\n2. आकर्षक बनाएं: इसे किसी चीज़ के साथ जोड़ें जो आपको पसंद हो।\n3. आसान बनाएं: बाधाओं को न्यूनतम पर रखें (जैसे केवल 2 मिनट)।\n4. संतोषजनक बनाएं: तुरंत बाद खुद को इनाम दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina la cattiva abitudine (Spam e distrazioni)**\n1. Rendila invisibile: Rimuovi i trigger dal tuo campo visivo.\n2. Rendila poco attraente: Prendi consapevolezza delle conseguenze negative.\n3. Rendila difficile: Aggiungi ostacoli (es. elimina le app, stacca la spina).\n4. Rendila insoddisfacente: Collega l'azione a una punizione.\n\n**Stabilisci la buona abitudine (Digital detox)**\n1. Rendila evidente: Posiziona il trigger ben visibile.\n2. Rendila attraente: Associala a qualcosa che ti piace.\n3. Rendila facile: Riduci gli ostacoli al minimo (es. solo 2 minuti).\n4. Rendila soddisfacente: Premiati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**悪い習慣を断ち切る（スパムと気晴らし）**\n1. 見えないようにする：トリガーを視界から取り除く。\n2. 魅力的にしない：否定的な結果を意識する。\n3. 難しくする：ハードルを設ける（アプリの削除、プラグを抜くなど）。\n4. 満足できないようにする：実行と罰を結びつける。\n\n**良い習慣を確立する（デジタルデトックス）**\n1. はっきりさせる：トリガーを見やすい場所に配置する。\n2. 魅力的にする：好きなことと結びつける。\n3. 簡単にする：ハードルを最小限に抑える（例：2分間だけ）。\n4. 満足できるものにする：実行した直後に自分にご褒美をあげる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**나쁜 습관 제거(스팸 및 방해 요소)**\n1. 보이지 않게 만들기: 시야에서 트리거를 제거합니다.\n2. 자신을 매력적이지 않게 만드세요. 부정적인 결과를 염두에 두세요.\n3. 어렵게 만들기: 장애물을 설정합니다(예: 앱 삭제, 플러그 뽑기).\n4. 불만족스럽게 만들기: 처형에 벌금을 부과합니다.\n\n**좋은 습관 확립(디지털 디톡스)**\n1. 명확하게 만드십시오: 트리거를 명확하게 보이도록 배치하십시오.\n2. 매력적으로 만드십시오: 당신이 좋아하는 것과 연관시키십시오.\n3. 단순하게 만드세요. 장애물을 최소한으로 줄이세요(예: 단 2분).\n4. 만족스러운 일을 하십시오: 직후에 자신에게 보상하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slechte gewoonte afleren (Spam en afleiding)**\n1. Onzichtbaar maken: Verwijder de triggers uit je blikveld.\n2. Onaantrekkelijk maken: Word je bewust van de negatieve gevolgen.\n3. Moeilijk maken: Bouw obstakels in (bijv. apps verwijderen, stekker eruit trekken).\n4. Onbevredigend maken: Koppel de handeling aan een straf.\n\n**Goede gewoonte opbouwen (Digitale detox)**\n1. Duidelijk maken: Plaats de trigger goed zichtbaar.\n2. Aantrekkelijk maken: Koppel het aan iets wat je leuk vindt.\n3. Makkelijk maken: Beperk de obstakels tot een minimum (bijv. slechts 2 minuten).\n4. Bevredigend maken: Beloon jezelf direct daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pozbądź się złych nawyków (spamu i rozpraszania uwagi)**\n1. Uczyń niewidzialnym: Usuń wyzwalacze z pola widzenia.\n2. Stań się nieatrakcyjny: bądź świadomy negatywnych konsekwencji.\n3. Utrudnij to: ustaw przeszkody (np. usuń aplikacje, odłącz).\n4. Spraw, aby było to niezadowalające: Połącz egzekucję z karą.\n\n**Wypracuj dobre nawyki (Cyfrowy Detox)**\n1. Spraw, aby było to oczywiste: umieść spust w dobrze widocznym miejscu.\n2. Spraw, aby było atrakcyjne: skojarz to z czymś, co lubisz.\n3. Uprość sprawę: ogranicz przeszkody do minimum (np. tylko 2 minuty).\n4. Spraw, aby było to satysfakcjonujące: natychmiast po tym nagradzaj siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Livra-te do mau hábito (Spam e distrações)**\n1. Torná-lo invisível: Remove os gatilhos do teu campo de visão.\n2. Torná-lo pouco atrativo: Consciencializa-te das consequências negativas.\n3. Torná-lo difícil: Cria obstáculos (por ex. elimina apps, desliga a ficha).\n4. Torná-lo insatisfatório: Associa a ação a uma penalização.\n\n**Estabelece o bom hábito (Digital detox)**\n1. Torná-lo evidente: Coloca o gatilho bem visível.\n2. Torná-lo atrativo: Associa-o a algo de que gostas.\n3. Torná-lo fácil: Reduz os obstáculos ao mínimo (por ex. apenas 2 minutos).\n4. Torná-lo satisfatório: Recompensa-te logo a seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimine o mau hábito (Spam e distrações)**\n1. Torne-o invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-o pouco atraente: Conscientize-se das consequências negativas.\n3. Torne-o difícil: Crie obstáculos (ex.: exclua apps, desligue a tomada).\n4. Torne-o insatisfatório: Associe a ação a uma punição.\n\n**Estabeleça o bom hábito (Detox digital)**\n1. Torne-o evidente: Coloque o gatilho bem visível.\n2. Torne-o atraente: Associe-o a algo que você gosta.\n3. Torne-o fácil: Reduza os obstáculos ao mínimo (ex.: apenas 2 minutos).\n4. Torne-o satisfatório: Recompense-se logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Избавьтесь от вредных привычек (спама и отвлекающих факторов)**\n1. Сделайте невидимыми: уберите триггеры из поля зрения. \n2. Сделайте себя непривлекательным. Помните о негативных последствиях. \n3. Усложните задачу: установите препятствия (например, удалите приложения, отключите их от сети). \n4. Сделайте его неудовлетворительным: прикрепите исполнение к наказанию. \n\n**Прививайте хорошие привычки (Цифровой детокс)**\n1. Сделайте это очевидным: разместите триггер на видном месте. \n2. Сделайте это привлекательным. Свяжите это с чем-то, что вам нравится. \n3. Сделайте это просто: сократите препятствия до минимума (например, всего 2 минуты). \n4. Сделайте это приятным: вознаградите себя сразу после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kötü Alışkanlıklardan (Spam ve Dikkat Dağıtma) Kurtulun**\n1. Görünmez kılın: Tetikleyicileri görüş alanınızdan kaldırın.\n2. Kendinizi çekici olmaktan çıkarın: Olumsuz sonuçların farkında olun.\n3. Zorlaştırın: Engeller koyun (ör. uygulamaları silin, fişi çekin).\n4. Yetersiz hale getirin: İnfazı cezaya ekleyin.\n\n**İyi alışkanlıklar edinin (Dijital Detoks)**\n1. Açıkça belirtin: Tetiği açıkça görülebilecek şekilde yerleştirin.\n2. Çekici hale getirin: Onu sevdiğiniz bir şeyle ilişkilendirin.\n3. Basitleştirin: Engelleri en aza indirin (örneğin sadece 2 dakika).\n4. Tatmin edici hale getirin: Hemen ardından kendinizi ödüllendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉坏习惯（垃圾邮件和干扰）**\n1. 隐形：将触发因素移出视野。\n2. 让自己变得没有吸引力：意识到负面后果。\n3. 让它变得困难：设置障碍（例如删除应用程序、拔掉插头）。\n4. 使其不令人满意：附加刑罚执行。\n\n**建立良好习惯（数字排毒）**\n1. 使其显而易见：将触发器放置在清晰可见的位置。\n2. 让它有吸引力：将它与你喜欢的东西联系起来。\n3. 让它变得简单：将障碍减少到最低限度（例如只需 2 分钟）。\n4. 让它令人满意：事后立即奖励自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉壞習慣（垃圾郵件和乾擾）**\n1. 隱形：將觸發因素移出視野。\n2. 讓自己變得沒有吸引力：意識到負面後果。\n3. 讓它變得困難：設定障礙（例如刪除應用程式、拔掉插頭）。\n4. 使其不令人滿意：附加刑罰執行。\n\n**建立良好的習慣（數位排毒）**\n1. 使其顯而易見：將觸發器放置在清晰可見的位置。\n2. 讓它有吸引力：將它與你喜歡的東西連結起來。\n3. 讓它變得簡單：將障礙減少到最低限度（例如只需 2 分鐘）。\n4. 讓它令人滿意：事後立即獎勵自己。"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare dein Geld anstatt es für Mikrotransaktionen und Glücksspiel auszugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your money instead of spending it on microtransactions and gambling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra tu dinero en lugar de gastarlo en microtransacciones y apuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économise ton argent au lieu de le dépenser en microtransactions et jeux d'argent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पैसे बचाओ बजाय इसके कि उन्हें माइक्रोट्रांजेक्शन्स और जुआ में खर्च करो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmia i tuoi soldi invece di spenderli in microtransazioni e gioco d'azzardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少額の取引やギャンブルにお金を使う代わりに、お金を節約しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소액 결제와 도박에 돈을 쓰는 대신 저축하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bespaar je geld in plaats van het uit te geven aan microtransacties en gokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszczędzaj pieniądze, zamiast wydawać je na mikrotransakcje i hazard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Economize seu dinheiro em vez de gastá-lo em microtransações e jogos de azar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Economize seu dinheiro em vez de gastá-lo em microtransações e jogos de azar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экономьте свои деньги вместо того, чтобы тратить их на микротранзакции и азартные игры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranızı mikro dönüşümlere ve kumara harcamak yerine biriktirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节省你的钱，而不是把钱花在微交易和赌博上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節省你的錢，而不是把錢花在微交易和賭博上。"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Glücksspiel/Lootboxen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gambling/Lootboxes) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Apuestas/cajas de botín) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Jeux d'argent/Loot boxes) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (जुआ/लूटबॉक्स) आपको लंबे समय में ऊर्जा, समय और पैसा खर्च कराती है। यह आपको अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Gioco d'azzardo/Lootbox) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（ギャンブル/戦利品ボックス）は、長期的にはエネルギー、時間、お金を費やします。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(도박/전리품 상자)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (Gokken/Loot boxes) kost je op lange termijn energie, tijd en geld. Het weerhoudt je ervan je volledige potentieel te benutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (hazard/skrzynki z łupami) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Jogos de azar/Loot boxes) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (jogo/loot boxes) custa-lhe energia, tempo e dinheiro a longo prazo. Isso o impede de atingir todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (азартные игры/лутбоксы) в долгосрочной перспективе отнимает у вас энергию, время и деньги. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (kumar/ganimet kutuları) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（赌博/战利品箱）会消耗你的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，這個習慣（賭博/戰利品箱）會消耗你的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

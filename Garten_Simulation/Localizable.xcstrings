    "trash.party_pass.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung: Schlafentzug kostet Tage an Produktivität, nicht nur Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder: sleep deprivation costs days of productivity, not just hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda: la falta de sueño te cuesta días de productividad, no solo horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappel: le manque de sommeil coûte des jours de productivité, pas seulement des heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "याददाश्त: नींद की कमी केवल घंटों ही नहीं, बल्कि दिनों का उत्पादकता भी ले जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria: la privazione del sonno costa giorni di produttività, non solo ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えておきましょう：睡眠不足は数時間だけでなく、数日分の生産性を失うことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억하세요: 수면 부족은 몇 시간이 아니라 며칠의 생산성을 잃게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnering: slaaptekort kost je dagen productiviteit, niet alleen uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie: brak snu kosztuje dni produktywności, nie tylko godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete: a privação de sono custa dias de produtividade, não apenas horas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete: a privação de sono custa dias de produtividade, não apenas horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание: лишение сна приводит к потере продуктивности дней, а не часов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma: uyku yoksunluğu yalnızca saatler değil, günlerce verimlilik kaybettirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒：睡眠不足会损失几天的生产力，而不仅仅是几个小时。"

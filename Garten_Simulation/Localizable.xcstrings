    "assessment.finance.profile.verdraenger.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte heute mit dem Habit 'Kontostand prüfen'. 30 Sekunden täglich. Das ist der erste Schritt raus aus der Verdrängung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start your Check Account Balance habit today. 30 seconds daily. This is the first step out of repression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comience su hábito de verificar el saldo de su cuenta hoy. 30 segundos diarios. Este es el primer paso para salir de la represión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez dès aujourd’hui à vérifier le solde de votre compte. 30 secondes par jour. C'est la première étape pour sortir de la répression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज ही अपना अकाउंट बैलेंस चेक करने की आदत शुरू करें। प्रतिदिन 30 सेकंड. यह दमन से बाहर निकलने का पहला कदम है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia oggi la tua abitudine di controllare il saldo del conto. 30 secondi al giorno. Questo è il primo passo per uscire dalla repressione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント残高を確認する習慣を今すぐ始めましょう。毎日30秒。これが抑圧からの第一歩です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘부터 계좌 잔고 확인 습관을 시작해 보세요. 매일 30초. 이것이 억압에서 벗어나는 첫 번째 단계입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin vandaag nog met uw gewoonte om uw rekeningsaldo te controleren. 30 seconden per dag. Dit is de eerste stap uit de repressie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Już dziś zacznij nawyk salda konta czekowego. 30 sekund dziennie. To pierwszy krok w stronę wyjścia z represji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece hoje mesmo o hábito de verificar o saldo da conta. 30 segundos diários. Este é o primeiro passo para sair da repressão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начни сегодня с привычки 'проверять баланс счета'. 30 секунд в день. Это первый шаг к выходу из отрицания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çek Hesap Bakiyesi alışkanlığınıza bugün başlayın. Günde 30 saniye. Bu baskıdan kurtulmanın ilk adımıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天开始养成“检查账户余额”的习惯。每天30秒。这是走出回避的第一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從今天開始養成檢查帳戶餘額的習慣。每天 30 秒。這是擺脫鎮壓的第一步。"
          }
        }
      }
    },
    "assessment.finance.profile.verdraenger.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör auf, Briefe direkt in die Schublade zu legen. Lege sie zumindest ungeöffnet gut sichtbar auf deinen Schreibtisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop putting letters straight in the drawer. At least put it unopened and clearly visible on your desk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de poner letras directamente en el cajón. Al menos colóquelo sin abrir y claramente visible en su escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez de mettre les lettres directement dans le tiroir. Mettez-le au moins non ouvert et clairement visible sur votre bureau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पत्रों को सीधे दराज में रखना बंद करें। कम से कम इसे अपने डेस्क पर खुला और स्पष्ट रूप से दिखाई देने वाला रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smettila di riporre le lettere direttamente nel cassetto. Almeno mettilo chiuso e ben visibile sulla tua scrivania."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手紙をそのまま引き出しに入れるのはやめましょう。少なくとも未開封の状態で机の上にはっきりと見えるように置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편지를 서랍에 똑바로 넣지 마세요. 최소한 개봉하지 않은 상태로 책상 위에 명확하게 보이도록 놓으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop met het direct in de lade leggen van brieven. Leg hem in ieder geval ongeopend en duidelijk zichtbaar op je bureau."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań wkładać listy prosto do szuflady. Przynajmniej połóż to nieotwarte i dobrze widoczne na biurku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare de colocar as cartas direto na gaveta. Pelo menos coloque-o fechado e claramente visível em sua mesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перестань класть письма прямо в ящик. По крайней мере, положи их нераспечатанными на видное место на свой стол."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mektupları doğrudan çekmeceye koymayı bırakın. En azından onu açılmamış ve açıkça görülebilecek şekilde masanıza koyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别再把信直接放进抽屉了。至少把它们未拆封地清楚地放在你的书桌上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別再把信件直接放在抽屜裡了。至少將其未打開且放在辦公桌上清晰可見。"
          }
        }
      }
    },
    "assessment.finance.profile.verdraenger.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle dir wöchentlich einen 2-Minuten-Timer. Öffne in dieser Zeit nur deine Banking-App, schau rein und schließe sie wieder. Mehr nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a 2-minute timer every week. During this time, just open your banking app, check it out and close it again. Not more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure un cronómetro de 2 minutos cada semana. Durante este tiempo, simplemente abra su aplicación bancaria, compruébela y ciérrela nuevamente. No más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez une minuterie de 2 minutes chaque semaine. Pendant ce temps, ouvrez simplement votre application bancaire, vérifiez-la et fermez-la à nouveau. Pas plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हफ्ते 2 मिनट का टाइमर सेट करें। इस दौरान बस अपना बैंकिंग ऐप खोलें, उसे जांचें और फिर से बंद कर दें। अधिक नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un timer di 2 minuti ogni settimana. Durante questo periodo, apri l'app bancaria, controllala e chiudila di nuovo. Non di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週2分のタイマーを設定します。この間は、バンキング アプリを開いて確認し、再度閉じてください。それ以上ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 2분 타이머를 설정하세요. 이 시간 동안에는 뱅킹 앱을 열고 확인한 후 다시 닫으세요. 그 이상은 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel elke week een timer van 2 minuten in. Gedurende deze tijd opent u gewoon uw bankapp, checkt u deze uit en sluit u deze weer. Niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw minutnik na 2 minuty co tydzień. W tym czasie wystarczy otworzyć aplikację bankową, sprawdzić ją i zamknąć ponownie. Nie więcej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um cronômetro de 2 minutos toda semana. Durante esse tempo, basta abrir o aplicativo do seu banco, conferir e fechá-lo novamente. Não mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установи себе еженедельно 2-минутный таймер. В это время открывай только своё банковское приложение, загляни туда и закрой. Больше ничего."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hafta 2 dakikalık bir zamanlayıcı ayarlayın. Bu süre zarfında bankacılık uygulamanızı açın, kontrol edin ve tekrar kapatın. Daha fazla değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周给自己设定一个2分钟的计时器。在这段时间里，只打开你的银行应用程序，查看一下，然后关闭它。就是这些，不做更多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週設定 2 分鐘的計時器。在此期間，只需打開您的銀行應用程序，查看並再次關閉即可。不多了。"
          }
        }
      }
    },
    "assessment.finance.profile.verdraenger.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du meidest finanzielle Realitäten aus Angst vor dem Ergebnis. Nach der 'Marginal Gains' Methode musst du nicht alles sofort lösen, sondern nur die Hemmschwelle extrem senken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You avoid financial realities for fear of the outcome. According to the 'Marginal Gains' method, you don't have to solve everything immediately, you just have to extremely lower your inhibition threshold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitas las realidades financieras por miedo al resultado. Según el método de las 'Ganancias Marginales', no es necesario resolver todo inmediatamente, sólo hay que reducir al máximo su umbral de inhibición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous évitez les réalités financières par peur du résultat. Selon la méthode des « Gains Marginaux », vous n’êtes pas obligé de tout résoudre immédiatement, il vous suffit de baisser extrêmement votre seuil d’inhibition."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप परिणाम के डर से वित्तीय वास्तविकताओं से बचते हैं। 'सीमांत लाभ' पद्धति के अनुसार, आपको हर चीज़ को तुरंत हल नहीं करना है, आपको बस अपनी अवरोध सीमा को बेहद कम करना है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eviti le realtà finanziarie per paura del risultato. Secondo il metodo dei 'Guadagni Marginali' non devi risolvere tutto subito, devi solo abbassare estremamente la tua soglia di inibizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果を恐れて経済的な現実を避けます。 「限界利益」法によると、すぐにすべてを解決する必要はなく、阻害閾値を極端に下げるだけで済みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과에 대한 두려움 때문에 재정적 현실을 피합니다. '한계 이득' 방법에 따르면, 모든 것을 즉시 해결할 필요는 없으며 억제 역치를 극도로 낮추기만 하면 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vermijdt de financiële realiteit uit angst voor de uitkomst. Volgens de 'Marginal Gains'-methode hoef je niet alles meteen op te lossen, je hoeft alleen maar je remmingsdrempel extreem te verlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikasz realiów finansowych ze strachu przed konsekwencjami. Zgodnie z metodą „Zysków Marginalnych” nie musisz rozwiązywać wszystkiego od razu, wystarczy bardzo obniżyć próg hamowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você evita as realidades financeiras por medo do resultado. De acordo com o método dos 'Ganhos Marginais', você não precisa resolver tudo imediatamente, apenas precisa diminuir extremamente o seu limiar de inibição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты избегашь финансовых реалий из-за страха перед результатом. По методу 'Marginal Gains' тебе не нужно решать всё сразу, а только значительно снизить порог сопротивления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonuç korkusuyla finansal gerçeklerden kaçınırsınız. 'Marjinal Kazanımlar' yöntemine göre, her şeyi hemen çözmeniz gerekmez, sadece engelleme eşiğinizi son derece düşürmeniz gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你因为害怕结果而回避经济现实。根据“边际收益”方法，你不需要立即解决所有问题，只需极大地降低障碍即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你因為擔心結果而迴避財務現實。根據「邊際收益」方法，你不必立即解決所有問題，你只需要大幅降低你的抑制閾值。"
          }
        }
      }
    },

            "state": "translated",
            "value": "Usa tu diario para reflexionar sobre tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise ton journal pour réfléchir à ta journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने दिन पर विचार करने के लिए अपनी जर्नल का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {

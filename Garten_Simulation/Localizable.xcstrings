        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0935\u093e\u092a\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0915\u093e\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"

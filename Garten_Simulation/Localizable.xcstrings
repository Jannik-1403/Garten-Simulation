    "notification.routine.start": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte jetzt deine Routine und verdiene Fokus-Punkte!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start your routine now and earn focus points!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Inicia tu rutina ahora y gana puntos de enfoque!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez votre routine maintenant et gagnez des points de concentration !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0905\u092a\u0928\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092b\u094b\u0915\u0938 \u0905\u0902\u0915 \u0905\u0930\u094d\u091c\u093f\u0924 \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia la tua routine ora e guadagna punti concentrazione!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u3059\u3050\u30eb\u30fc\u30c1\u30f3\u3092\u958b\u59cb\u3057\u3066\u3001\u30d5\u30a9\u30fc\u30ab\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uae08 \ub8e8\ud2f4\uc744 \uc2dc\uc791\ud558\uace0 \ud3ec\ucee4\uc2a4 \ud3ec\uc778\ud2b8\ub97c \ud68d\ub4dd\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start nu je routine en verdien focuspunten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij swoj\u0105 rutyn\u0119 teraz i zdobywaj punkty skupienia!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Come\u00e7a a tua rotina agora e ganha pontos de foco!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0447\u043d\u0438 \u0441\u0432\u043e\u044e \u0440\u0443\u0442\u0438\u043d\u0443 \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439 \u043e\u0447\u043a\u0438 \u0444\u043e\u043a\u0443\u0441\u0430!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eimdi rutininize ba\u015flay\u0131n ve odak puanlar\u0131 kazan\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u5f00\u59cb\u4f60\u7684\u4f8b\u884c\u4e8b\u52a1\u5e76\u8d5a\u53d6\u4e13\u6ce8\u70b9\u6570\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u5c31\u958b\u59cb\u4f60\u7684\u65e5\u5e38\u6d3b\u52d5\u4e26\u8d0f\u5f97\u7126\u9ede\u5206\u6578\uff01"
          }
        }
      }
    },
    "notification.streak.1.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohje! Wenn du jetzt nachl\u00e4sst, stirbt die Pflanze und du verlierst %d Tage Streak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh dear! If you slack now, the plant dies and you lose a %d-day streak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Oh no! Si aflojas ahora, la planta muere y pierdes una racha de %d d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh l\u00e0 l\u00e0 ! Si tu rel\u00e2ches maintenant, la plante meurt et tu perds %d jours de s\u00e9rie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0913 \u092a\u094d\u092f\u093e\u0930\u0947! \u092f\u0926\u093f \u0906\u092a \u0905\u092d\u0940 \u0939\u093e\u0930 \u092e\u093e\u0928 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092a\u094c\u0927\u093e \u092e\u0930 \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0906\u092a%d\u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e \u0916\u094b \u0926\u0947\u0902\u0917\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh no! Se ti arrendi ora, la pianta muore e perdi %d giorni di serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3042\uff01\u3053\u3053\u3067\u6020\u3051\u308b\u3068\u3001\u690d\u7269\u306f\u67af\u308c\u3066\u3057\u307e\u3044\u3001%d \u65e5\u9023\u7d9a\u3067\u640d\u5931\u304c\u767a\u751f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ub7f0! \uc9c0\uae08 \ub290\uc2a8\ud574\uc9c0\uba74 \uc2dd\ubb3c\uc774 \uc8fd\uace0 %d\uc77c \uc5f0\uc18d \uae30\ub85d\uc744 \uc783\uac8c \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "O lief! Als je nu verslapt, sterft de plant en verlies je een streak van %d dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Och kochanie! Je\u015bli teraz zwolnisz, ro\u015blina umrze i stracisz pass\u0119 %d-dniow\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh n\u00e3o! Se vacilares agora, a planta morre e perdes um streak de %d dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0439-\u043e\u0439! \u0415\u0441\u043b\u0438 \u0442\u044b \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u0441\u043b\u0430\u0431\u0438\u0448\u044c, \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0443\u043c\u0440\u0451\u0442, \u0438 \u0442\u044b \u043f\u043e\u0442\u0435\u0440\u044f\u0435\u0448\u044c%d\u0434\u043d\u0435\u0439 \u043f\u043e\u0434\u0440\u044f\u0434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ah hayat\u0131m! \u015eimdi gev\u015ferseniz, bitki \u00f6l\u00fcr ve %d g\u00fcnl\u00fck seriyi kaybedersiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54e6\u4e0d\uff01\u5982\u679c\u4f60\u73b0\u5728\u653e\u5f03\uff0c\u690d\u7269\u5c31\u4f1a\u67af\u840e\uff0c\u4f60\u5c06\u5931\u53bb %d \u5929\u7684\u8fde\u51fb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54e6\u89aa\u611b\u7684\uff01\u5982\u679c\u4f60\u73fe\u5728\u653e\u9b06\uff0c\u690d\u7269\u5c31\u6703\u6b7b\u4ea1\uff0c\u4f60\u5c07\u5931\u53bb%d\u5929\u7684\u9023\u7e8c\u8a18\u9304\u3002"
          }
        }
      }
    },
    "notification.streak.1.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung, Streak in Gefahr!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out, streak in danger!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Cuidado, racha en peligro!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention, s\u00e9rie en danger !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093e\u0935\u0927\u093e\u0928 \u0930\u0939\u0947\u0902, \u0916\u093c\u0924\u0930\u0947 \u092e\u0947\u0902 \u0939\u0948\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione, serie in pericolo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c17\u3092\u3064\u3051\u3066\u3001\u9023\u7d9a\u5371\u967a\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc870\uc2ec\ud558\uc138\uc694, \uc704\ud5d8\uc5d0 \ucc98\ud574\uc788\uc2b5\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas op, streak in gevaar!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwa\u017caj, passa w niebezpiecze\u0144stwie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidado, streak em perigo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043d\u0438\u043c\u0430\u043d\u0438\u0435, \u0421\u0442\u0440\u0438\u043a \u0432 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat, tehlikede \u00e7izgi!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\uff0c\u8fde\u51fb\u6709\u5371\u9669\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u5fc3\uff0c\u6709\u5371\u96aa\uff01"
          }
        }
      }
    },
    "notification.streak.2.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gewohnheit steht auf der Kippe. Rette jetzt deine %d-Tage harte Arbeit!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your habit is on the brink. Save your %d days of hard work now!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu h\u00e1bito est\u00e1 en peligro. \u00a1Salva ahora tus %d d\u00edas de duro trabajo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton habitude est en p\u00e9ril. Sauve maintenant tes %d jours de dur labeur !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0940 \u0906\u0926\u0924 \u091a\u091f\u094d\u091f\u093e\u0928\u094b\u0902 \u092a\u0930 \u0939\u0948. \u0905\u092a\u0928\u0947%d\u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0915\u0921\u093c\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u094b \u0905\u092d\u0940 \u092c\u091a\u093e\u090f\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua abitudine \u00e8 a rischio. Salva ora i tuoi %d giorni di duro lavoro!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u7fd2\u6163\u306f\u702c\u6238\u969b\u306b\u3042\u308a\u307e\u3059\u3002 %d \u65e5\u9593\u306e\u30cf\u30fc\u30c9\u30ef\u30fc\u30af\u3092\u4eca\u3059\u3050\u7bc0\u7d04\u3057\u307e\u3057\u3087\u3046!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc2b5\uad00\uc774 \uc704\uae30\uc5d0 \ucc98\ud574 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 %d\uc77c\uac04 \uc5f4\uc2ec\ud788 \uc77c\ud55c \uc2dc\uac04\uc744 \uc808\uc57d\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gewoonte staat op de rand. Bespaar nu uw %d dagen hard werken!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j nawyk jest na kraw\u0119dzi. Zaoszcz\u0119d\u017a teraz %d dni ci\u0119\u017ckiej pracy!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu h\u00e1bito corre perigo. Salva agora os teus %d dias de trabalho \u00e1rduo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u043d\u0430 \u0433\u0440\u0430\u043d\u0438. \u0421\u043f\u0430\u0441\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0432\u043e\u0438%d\u0434\u043d\u0435\u0439 \u0443\u0441\u0435\u0440\u0434\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Al\u0131\u015fkanl\u0131\u011f\u0131n\u0131z e\u015fi\u011finde. %d g\u00fcnl\u00fck s\u0131k\u0131 \u00e7al\u0131\u015fman\u0131z\u0131 \u015fimdi kaydedin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u4e60\u60ef\u5c8c\u5c8c\u53ef\u5371\u3002\u73b0\u5728\u5c31\u62ef\u6551\u4f60 %d \u5929\u7684\u8f9b\u52e4\u5de5\u4f5c\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u7fd2\u6163\u5df2\u7d93\u5c8c\u5c8c\u53ef\u5371\u4e86\u3002\u7acb\u5373\u7bc0\u7701\u60a8%d\u5e7e\u5929\u7684\u8f9b\u82e6\u5de5\u4f5c\uff01"
          }
        }
      }
    },

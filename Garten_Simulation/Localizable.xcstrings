    "prog_saving_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Wochenende gibt man am meisten für Essen aus. Koche heute selbst oder lade Freunde zu dir ein, statt teuer auszugehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekends are where you spend the most on food. Cook yourself today or invite friends over instead of going out expensively."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fines de semana es donde más se gasta en comida. Cocine usted mismo hoy o invite a amigos en lugar de salir costosamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les week-ends sont l’endroit où vous dépensez le plus en nourriture. Cuisinez vous-même aujourd'hui ou invitez des amis au lieu de sortir cher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताहांत वह समय होता है जब आप भोजन पर सबसे अधिक खर्च करते हैं। आज बाहर जाने के बजाय खुद खाना पकाएं या दोस्तों को आमंत्रित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fine settimana sono i luoghi in cui si spende di più in cibo. Cucinati oggi o invita gli amici invece di uscire in modo costoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末は食費が一番かかる日です。今日は高価な外出の代わりに自炊をしたり、友人を家に招待したりしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말은 음식에 가장 많은 돈을 쓰는 시간입니다. 값비싼 외출을 하는 대신 오늘 직접 요리를 하거나 친구를 초대하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het weekend geef je het meeste uit aan eten. Kook vandaag nog zelf of nodig vrienden uit in plaats van duur uit te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekendy to czas, w którym wydajesz najwięcej na jedzenie. Gotuj już dziś lub zaproś znajomych zamiast drogich wyjść."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fins de semana são onde você gasta mais com comida. Cozinhe hoje ou convide amigos em vez de sair caro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os fins de semana são onde você gasta mais com comida. Cozinhe hoje ou convide amigos em vez de sair caro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходные — это время, когда вы тратите больше всего на еду. Приготовьте сами сегодня или пригласите друзей вместо того, чтобы тратить деньги на дорогу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonları yemeğe en çok para harcadığınız zamandır. Pahalı bir şekilde dışarı çıkmak yerine bugün kendinizi pişirin veya arkadaşlarınızı davet edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周末是您在食物上花费最多的时间。今天自己做饭或邀请朋友过来，而不是花大钱出去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週末是您在食物上花費最多的時間。今天自己做飯或邀請朋友來，而不是花大錢出去。"
          }
        }
      }
    },

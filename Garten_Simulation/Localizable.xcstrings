    "progression_sleep_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge für mindestens 7-8 Stunden ungestörten Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure at least 7-8 hours of undisturbed sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de tener al menos 7-8 horas de sueño ininterrumpido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assure-toi d'avoir au moins 7-8 heures de sommeil ininterrompu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati almeno 7-8 ore di sonno indisturbato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも 7 ～ 8 時間は妨げられない睡眠を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어도 7~8시간은 방해받지 않고 잠을 자도록 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg voor minimaal 7-8 uur ongestoorde slaap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj o co najmniej 7-8 godzin niezakłóconego snu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegura pelo menos 7-8 horas de sono ininterrupto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 7-8 saat kesintisiz uyku sağlayın."
          }
        }
      }
    },

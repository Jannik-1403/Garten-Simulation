    "onboarding_tutorial_giessen_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den Wassertropfen auf die Pflanze, um sie zu gie\u00dfen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the water drop onto the plant to water it!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Arrastra la gota de agua a la planta para regarla!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser la goutte d'eau sur la plante pour l'arroser !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094c\u0927\u0947 \u0915\u094b \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0928\u0940 \u0915\u0940 \u092c\u0942\u0902\u0926 \u0915\u094b \u092a\u094c\u0927\u0947 \u092a\u0930 \u0916\u0940\u0902\u091a\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the water drop onto the plant to water it!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c34\u30c9\u30ed\u30c3\u30d7\u3092\u690d\u7269\u306e\u4e0a\u306b\u30c9\u30e9\u30c3\u30b0\u3057\u3066\u6c34\u3084\u308a\u3092\u3057\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb3c\ubc29\uc6b8\uc744 \uc2dd\ubb3c \uc704\ub85c \ub4dc\ub798\uadf8\ud558\uc5ec \ubb3c\uc744 \uc8fc\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de waterdruppel naar de plant om hem water te geven!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeci\u0105gnij kropl\u0119 wody na ro\u015blin\u0119, aby j\u0105 podla\u0107!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta a gota de \u00e1gua para a planta para a regares!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438 \u043a\u0430\u043f\u043b\u044e \u0432\u043e\u0434\u044b \u043d\u0430 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u043f\u043e\u043b\u0438\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulamak i\u00e7in su damlas\u0131n\u0131 bitkinin \u00fczerine s\u00fcr\u00fckleyin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u6c34\u6ef4\u62d6\u5230\u690d\u7269\u4e0a\uff0c\u7ed9\u5b83\u6d47\u6c34\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u6c34\u6ef4\u62d6\u5230\u690d\u7269\u4e0a\u4f86\u6f86\u6c34\uff01"
          }
        }
      }
    },
    "onboarding_tutorial_giessen_erfolg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse! So pflegst du deine Gewohnheiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great! This is how you nurture your habits."
          }

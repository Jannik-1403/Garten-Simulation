        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0434\u0435\u0436\u043d\u043e \u0440\u0430\u0437\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0442 \u0432\u0430\u0448 \u0441\u0430\u0434."

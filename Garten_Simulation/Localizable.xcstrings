    "item.waechter_turm.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Pflanze, die du mit dem Turm sch\u00fctzen m\u00f6chtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap on the plant you want to protect with the tower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Pflanze, die du mit dem Turm sch\u00fctzen m\u00f6chtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur la plante que tu veux prot\u00e9ger avec la tour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0938 \u092a\u094c\u0927\u0947 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u091f\u093e\u0935\u0930 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap on the plant you want to protect with the tower."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30ef\u30fc\u3067\u5b88\u308a\u305f\u3044\u690d\u7269\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0c0\uc6cc\ub85c \ubcf4\ud638\ud558\uace0 \uc2f6\uc740 \uc2dd\ubb3c\uc744 \ud0ed\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de plant die je wilt beschermen met de toren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ro\u015blin\u0119, kt\u00f3r\u0105 chcesz chroni\u0107 za pomoc\u0105 wie\u017cy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca na planta que queres proteger com a torre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438 \u043d\u0430 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0442\u044b \u0445\u043e\u0447\u0435\u0448\u044c \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c \u0431\u0430\u0448\u043d\u0435\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuleyle korumak istedi\u011finiz bitkiye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u4f60\u60f3\u7528\u5854\u4fdd\u62a4\u7684\u690d\u7269\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u64ca\u4f60\u60f3\u8981\u7528\u5854\u4fdd\u8b77\u7684\u690d\u7269\u3002"
          }
        }
      }
    },
    "item.wunder_wasser.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettet eine vertrocknete Pflanze sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescues a dried plant immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescata una planta seca inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauve imm\u00e9diatement une plante dess\u00e9ch\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0942\u0916\u0947 \u092a\u094c\u0927\u0947 \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u092c\u091a\u093e\u0924\u093e \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescues a dried plant immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u67af\u308c\u305f\u690d\u7269\u3092\u3059\u3050\u306b\u6551\u51fa\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9d0\ub9b0 \uc2dd\ubb3c\uc744 \uc989\uc2dc \uad6c\ucd9c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Redt een gedroogde plant onmiddellijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast ratuje wysuszon\u0105 ro\u015blin\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva imediatamente uma planta ressecada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0440\u0430\u0437\u0443 \u0441\u043f\u0430\u0441\u0438\u0442\u0435 \u0432\u044b\u0441\u043e\u0445\u0448\u0435\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurumu\u015f bir bitkiyi an\u0131nda kurtar\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u62ef\u6551\u4e00\u682a\u67af\u840e\u7684\u690d\u7269\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u4fdd\u5b58\u4e7e\u71e5\u7684\u690d\u7269\u3002"
          }
        }
      }
    },

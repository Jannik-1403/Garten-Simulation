    "pfad_activation_diff_change_title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ ausgew\u00e4hlt. Bist du noch immer %@ oder willst du das jetzt h\u00f6her machen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You selected %@. Are you still %@ or do you want to change it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has seleccionado %@. \u00bfSigues siendo %@ o quieres cambiarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as s\u00e9lectionn\u00e9 %@. Es-tu toujours %@ ou veux-tu le changer ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947%@\u0915\u093e \u091a\u092f\u0928 \u0915\u093f\u092f\u093e. \u0915\u094d\u092f\u093e \u0906\u092a \u0905\u092d\u0940 \u092d\u0940%@\u0939\u0948\u0902 \u092f\u093e \u0906\u092a \u0907\u0938\u0947 \u0905\u092d\u0940 \u0914\u0930 \u090a\u092a\u0930 \u0932\u0947 \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai selezionato %@. Sei ancora %@ o vuoi cambiarlo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u3092\u9078\u629e\u3057\u307e\u3057\u305f\u3002\u307e\u3060 %@ \u306e\u307e\u307e\u3067\u3059\u304b? \u305d\u308c\u3068\u3082\u5909\u66f4\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc744(\ub97c) \uc120\ud0dd\ud558\uc168\uc2b5\ub2c8\ub2e4. \uc544\uc9c1 %@ \uc0c1\ud0dc\uc778\uac00\uc694, \uc544\ub2c8\uba74 \ubcc0\uacbd\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft %@ geselecteerd. Bent u nog steeds %@ of wilt u dit wijzigen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybra\u0142e\u015b %@. Czy nadal jeste\u015b %@, czy chcesz to zmieni\u0107?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionaste %@. Ainda \u00e9s %@ ou queres mudar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b \u0432\u044b\u0431\u0440\u0430\u043b\u0438%@. \u0412\u044b \u0432\u0441\u0451 \u0435\u0449\u0451%@\u0438\u043b\u0438 \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u044d\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'yi se\u00e7tiniz. Hala %@ m\u0131s\u0131n yoksa de\u011fi\u015ftirmek mi istiyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u9009\u62e9\u4e86%@\u3002\u60a8\u4ecd\u7136\u662f%@\u5417\uff0c\u8fd8\u662f\u73b0\u5728\u60f3\u63d0\u9ad8\u96be\u5ea6\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u9078\u64c7\u4e86%@\u3002\u60a8\u4ecd\u7136\u662f%@\u9084\u662f\u73fe\u5728\u60f3\u8981\u66f4\u9ad8\uff1f"
          }
        }
      }
    },

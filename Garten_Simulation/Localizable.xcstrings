    "powerup.weed_shield.needs_weed.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Power-up bleibt in deinem Inventar. Sobald Unkraut da ist, erneut antippen und \u201eBenutzen\u201c w\u00e4hlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This power-up stays in your inventory. When weeds appear, tap it again and choose Use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este power-up queda en tu inventario. Cuando haya malas hierbas, t\u00f3calo y elige Usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce power-up reste dans ton inventaire. Quand il y a des mauvaises herbes, appuie dessus puis Utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092a\u093e\u0935\u0930-\u0905\u092a \u0906\u092a\u0915\u0947 \u0907\u0928\u0935\u0947\u0902\u091f\u0930\u0940 \u092e\u0947\u0902 \u0930\u0939\u0947\u0917\u093e\u0964 \u091c\u0948\u0938\u0947 \u0939\u0940 \u091c\u0940\u0935\u093e\u0923\u0941 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947, \u0907\u0938\u0947 \u092b\u093f\u0930 \u0938\u0947 \u091f\u0948\u092a \u0915\u0930\u0947\u0902 \u0914\u0930 '\u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902' \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo power-up resta nell'inventario. Con le erbacce, toccalo e scegli Usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306b\u6b8b\u308a\u307e\u3059\u3002\u96d1\u8349\u304c\u8868\u793a\u3055\u308c\u305f\u3089\u3001\u3082\u3046\u4e00\u5ea6\u30bf\u30c3\u30d7\u3057\u3066\u4f7f\u7528\u3092\u9078\u629e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud30c\uc6cc\uc5c5\uc740 \uc778\ubca4\ud1a0\ub9ac\uc5d0 \uc720\uc9c0\ub429\ub2c8\ub2e4. \uc7a1\ucd08\uac00 \ub098\ud0c0\ub098\uba74 \ub2e4\uc2dc \ud0ed\ud558\uace0 \uc0ac\uc6a9\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze power-up blijft in je inventaris. Wanneer er onkruid verschijnt, tikt u er nogmaals op en kiest u Gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wzmocnienie pozostaje w Twoim ekwipunku. Kiedy pojawi\u0105 si\u0119 chwasty, dotknij go ponownie i wybierz U\u017cyj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este power-up fica no invent\u00e1rio. Com ervas, toca nele e escolhe Usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0432 \u0432\u0430\u0448\u0435\u043c \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0435. \u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0441\u043e\u0440\u043d\u044f\u043a, \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043d\u0435\u0433\u043e \u0441\u043d\u043e\u0432\u0430 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u00ab\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u00bb."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu g\u00fc\u00e7lendirme envanterinizde kal\u0131r. Yabani otlar g\u00f6r\u00fcnd\u00fc\u011f\u00fcnde tekrar dokunun ve Kullan'\u0131 se\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5f3a\u5316\u9053\u5177\u5c06\u4fdd\u7559\u5728\u4f60\u7684\u7269\u54c1\u680f\u4e2d\u3002\u4e00\u65e6\u51fa\u73b0\u6742\u8349\uff0c\u518d\u6b21\u70b9\u51fb\u5e76\u9009\u62e9\u201c\u4f7f\u7528\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

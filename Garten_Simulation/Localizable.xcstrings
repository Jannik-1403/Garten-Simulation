    "activity.all_done": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle Pflanzen gegossen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've watered all plants!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Has regado todas las plantas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as arros\u00e9 toutes les plantes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947 \u0938\u092d\u0940 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u092a\u093e\u0928\u0940 \u0926\u093f\u092f\u093e!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai annaffiato tutte le piante!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u690d\u7269\u306b\u6c34\u3092\u3042\u3052\u307e\u3057\u305f\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc5c8\uc5b4\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt alle planten water gegeven!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podla\u0142e\u015b wszystkie ro\u015bliny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regaste todas as plantas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043b\u0438\u043b(\u0430) \u0432\u0441\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fct\u00fcn bitkileri sulad\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u7ed9\u6240\u6709\u690d\u7269\u6d47\u6c34\u4e86\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7d66\u6240\u6709\u7684\u690d\u7269\u6f86\u6c34\u4e86\uff01"
          }
        }
      }
    },
    "alert.strict_mode.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im strikten Modus (Handy weglegen) bricht der Timer ab, wenn du die App f\u00fcr mehr als 10 Sekunden verl\u00e4sst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In strict mode (put phone away), the timer will cancel if you leave the app for more than 10 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo estricto, el temporizador se cancelar\u00e1 si sales de la app por m\u00e1s de 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode strict, le minuteur sera annul\u00e9 si tu quittes l'application plus de 10 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0916\u094d\u0924 \u092e\u094b\u0921 \u092e\u0947\u0902 (\u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0926\u0942\u0930 \u0930\u0916\u0947\u0902), \u092f\u0926\u093f \u0906\u092a \u0910\u092a \u0915\u094b 10 \u0938\u0947\u0915\u0902\u0921 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0938\u092e\u092f \u0915\u0947 \u0932\u093f\u090f \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u091f\u093e\u0907\u092e\u0930 \u0930\u0926\u094d\u0926 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalit\u00e0 rigorosa, il timer verr\u00e0 annullato se lasci l'app per pi\u00f9 di 10 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53b3\u683c\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30a2\u30d7\u30ea\u309210\u79d2\u4ee5\u4e0a\u96e2\u308c\u308b\u3068\u30bf\u30a4\u30de\u30fc\u304c\u30ad\u30e3\u30f3\u30bb\u30eb\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5c4\uaca9 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc571\uc744 10\ucd08 \uc774\uc0c1 \uc885\ub8cc\ud558\uba74 \ud0c0\uc774\uba38\uac00 \ucde8\uc18c\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de strikte modus annuleert de timer als je de app langer dan 10 seconden verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie \u015bcis\u0142ym minutnik zostanie anulowany, je\u015bli opu\u015bcisz aplikacj\u0119 na d\u0142u\u017cej ni\u017c 10 sekund."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo rigoroso, o temporizador ser\u00e1 cancelado se sa\u00edres da aplica\u00e7\u00e3o por mais de 10 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0441\u0442\u0440\u043e\u0433\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 (\u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d) \u0442\u0430\u0439\u043c\u0435\u0440 \u043f\u0440\u0435\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0432\u044b \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c \u043d\u0430 10 \u0441\u0435\u043a\u0443\u043d\u0434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kat\u0131 modda, uygulamadan 10 saniyeden fazla ayr\u0131l\u0131rsan\u0131z zamanlay\u0131c\u0131 iptal olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e25\u683c\u6a21\u5f0f\uff08\u628a\u624b\u673a\u653e\u4e0b\uff09\u4e0b\uff0c\u5982\u679c\u4f60\u79bb\u5f00\u5e94\u7528\u8d85\u8fc710\u79d2\uff0c\u8ba1\u65f6\u5668\u5c06\u4e2d\u6b62\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u56b4\u683c\u6a21\u5f0f\u4e0b\uff08\u628a\u624b\u6a5f\u6536\u8d77\u4f86\uff09\uff0c\u5982\u679c\u60a8\u96e2\u958b\u61c9\u7528\u7a0b\u5f0f\u8d85\u904e 10 \u79d2\uff0c\u8a08\u6642\u5668\u5c07\u53d6\u6d88\u3002"
          }
        }
      }
    },
    "alert.strict_mode.no": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein, Handy weglegen"
          }
        },
        "en": {

    "pfad_produktiv_day_1_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeite heute 25 Minuten ohne Ablenkung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work for 25 minutes without distraction today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabaja hoy 25 minutos sin distracciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille 25 minutes sans distraction aujourd'hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज बिना ध्यान भटकाए 25 मिनट तक काम करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavora per 25 minuti senza distrazioni oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は気を散らさずに 25 分間仕事をしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 방해받지 않고 25분 동안 일하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk vandaag 25 minuten zonder afleiding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracuj dzisiaj przez 25 minut bez rozpraszania uwagi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalha 25 minutos sem distração hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работай сегодня 25 минут без отвлечений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün dikkatiniz dağılmadan 25 dakika çalışın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天专注工作25分钟，不受干扰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天心無旁騖地工作 25 分鐘。"
          }
        }
      }
    },

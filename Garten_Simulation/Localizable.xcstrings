            "state": "translated",
            "value": "Proteggi la tua salute mentale ed evita i contenuti tossici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精神的健康を守り、有害なコンテンツを避けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정신 건강을 보호하고 유해한 콘텐츠를 피하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm je mentale gezondheid en vermijd giftige inhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroń swoje zdrowie psychiczne i unikaj toksycznych treści."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja a sua saúde mental e evite conteúdo tóxico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja a sua saúde mental e evite conteúdo tóxico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите свое психическое здоровье и избегайте токсичного контента."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruh sağlığınızı koruyun ve zehirli içeriklerden uzak durun."
          }
        },

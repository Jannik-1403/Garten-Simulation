    "pfad_produktiv_day_21_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "21 Tage. Die Gewohnheit festigt sich nun in deinem Alltag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "21 days. The habit is now firmly established in your daily life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "21 d\u00edas. El h\u00e1bito ya est\u00e1 firmemente establecido en tu vida diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "21 jours. L'habitude est maintenant fermement \u00e9tablie dans ton quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "21 \u0926\u093f\u0928. \u092f\u0939 \u0906\u0926\u0924 \u0905\u092c \u0906\u092a\u0915\u0940 \u0930\u094b\u091c\u092e\u0930\u094d\u0930\u093e \u0915\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u094b\u0924\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "21 giorni. L'abitudine \u00e8 ormai consolidata nella tua quotidianit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "21\u65e5\u3002\u4eca\u3067\u306f\u305d\u306e\u7fd2\u6163\u304c\u65e5\u5e38\u751f\u6d3b\u306b\u3057\u3063\u304b\u308a\u3068\u5b9a\u7740\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "21\uc77c. \uc774\uc81c \uadf8 \uc2b5\uad00\uc774 \uc77c\uc0c1\uc0dd\ud65c\uc5d0 \ud655\uace0\ud788 \uc790\ub9ac \uc7a1\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "21 dagen. De gewoonte is nu stevig verankerd in uw dagelijks leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "21 dni. Nawyk ten jest teraz mocno zakorzeniony w Twoim codziennym \u017cyciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "21 dias. O h\u00e1bito est\u00e1 agora firmemente estabelecido no teu quotidiano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "21 \u0434\u0435\u043d\u044c. \u041f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u0432\u0430\u0448\u0435\u0439 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21 g\u00fcn. Bu al\u0131\u015fkanl\u0131k art\u0131k g\u00fcnl\u00fck ya\u015fam\u0131n\u0131zda sa\u011flam bir \u015fekilde yerle\u015fmi\u015ftir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "21\u5929\u3002\u8fd9\u4e2a\u4e60\u60ef\u73b0\u5728\u5df2\u878d\u5165\u4f60\u7684\u65e5\u5e38\u751f\u6d3b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "21\u5929\u3002\u73fe\u5728\uff0c\u9019\u500b\u7fd2\u6163\u5df2\u7d93\u878d\u5165\u60a8\u7684\u65e5\u5e38\u751f\u6d3b\u4e2d\u3002"
          }
        }
      }
    },

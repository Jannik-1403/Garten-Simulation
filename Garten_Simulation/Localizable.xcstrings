    "assessment.mental.profile.unerschuetterlicher.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mindset ist absolut stabil. Du hast in allen Bereichen exzellent abgeschnitten. Behalte deine mentalen Routinen unbedingt bei!"
          }
        },
        "en": {

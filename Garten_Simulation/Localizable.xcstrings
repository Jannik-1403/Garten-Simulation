    "plant.erdbeerpflanze.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Früchte, große Belohnung – Obst & Gemüse essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small fruits, big reward – eating fruit & veg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutos pequeños, gran recompensa – comer frutas y verduras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits fruits, grande récompense – manger des fruits et légumes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे फल, बड़ा पुरस्कार – फल और सब्जियाँ खाएं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccoli frutti, grandi ricompense: mangia frutta e verdura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな果物、大きな報酬 - 果物と野菜を食べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 과일, 큰 보상 – 과일과 채소 먹기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein fruit, grote beloning – het eten van fruit en groenten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Małe owoce, duża nagroda – jedzenie owoców i warzyw"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutos pequenos, grande recompensa – comer frutas e legumes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frutos pequenos, grande recompensa – comer frutas e legumes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькие фрукты, большая награда – есть фрукты и овощи"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük meyveler, büyük ödül – meyve ve sebze yemek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小果实，大回报——多吃水果蔬菜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小水果，大回報－多吃水果和蔬菜"
          }
        }
      }
    },

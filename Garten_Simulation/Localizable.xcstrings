    "screenTime.blocked.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du befindest dich gerade in deiner aktiven Block-Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are currently in your active block time. You can only change these settings once the block time has expired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en tu tiempo de bloqueo activo. Solo puedes cambiar estos ajustes una vez que expire el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes actuellement dans votre temps de blocage actif. Vous ne pouvez modifier ces paramètres qu'une fois le temps expiré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप वर्तमान में अपने सक्रिय ब्लॉक समय में हैं। आप ब्लॉक समय समाप्त होने के बाद ही इन सेटिंग्स को बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei attualmente nel tuo periodo di blocco attivo. Puoi modificare queste impostazioni solo al termine del blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、有効なブロック時間中です。ブロック時間が終了するまで設定を変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 활성 차단 시간입니다. 차단 시간이 만료되어야만 이 설정을 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bevindt je momenteel in je actieve bloktijd. Je kunt deze instellingen pas wijzigen nadat de bloktijd is verstreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś obecnie w aktywnym czasie blokady. Możesz zmienić te ustawienia dopiero po upływie czasu blokady."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está atualmente em seu tempo de bloqueio ativo. Você só pode alterar essas configurações após o término do tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está atualmente em seu tempo de bloqueio ativo. Você só pode alterar essas configurações após o término do tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время действует время блокировки. Вы сможете изменить эти настройки только после истечения времени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda aktif engelleme sürenizdesiniz. Bu ayarları yalnızca engelleme süresi dolduğunda değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您目前处于活动阻止时间内。阻止时间结束后，您才能更改这些设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您目前處於活動阻止時間內。阻止時間結束後，您才能更改這些設置。"
          }
        }
      }
    },

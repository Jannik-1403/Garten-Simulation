            "value": "Kontynuuj dominacj\u0119"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar a dominar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0434\u043e\u043c\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c"
          }
        },
        "tr": {

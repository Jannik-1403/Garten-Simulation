    "item.unkraut_schild.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Unkraut: Schild auf 1, 2 und 3 ziehen. Danach 24 h kein neues Unkraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When weeds appear: drag the shield onto 1, 2, and 3. Then 24 h without new weeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con malas hierbas: arrastra el escudo a 1, 2 y 3. Luego 24 h sin nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec des mauvaises herbes: glisse le bouclier sur 1, 2 et 3. Puis 24 h sans nouvelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरपतवारों के लिए: ढाल को 1, 2 और 3 पर ले जाएँ। उसके बाद 24 घंटों तक कोई नया खरपतवार नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con erbacce: trascina lo scudo su 1, 2 e 3. Poi 24 h senza nuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雑草が現れたら、シールドを 1、2、3 にドラッグします。その後、新しい雑草が発生しない状態で 24 時間放置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잡초가 나타나면 방패를 1, 2, 3으로 드래그하세요. 그런 다음 24시간 동안 새로운 잡초가 나오지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er onkruid verschijnt: sleep het schild naar 1, 2 en 3. Daarna 24 uur zonder nieuw onkruid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy pojawią się chwasty: przeciągnij tarczę na 1, 2 i 3. Następnie 24 godziny bez nowych chwastów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ervas: arrasta o escudo para 1, 2 e 3. Depois 24 h sem novas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ervas: arrasta o escudo para 1, 2 e 3. Depois 24 h sem novas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сорняках: потяните щит на 1, 2 и 3. После этого 24 часа никакой новой травы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabani otlar göründüğünde: kalkanı 1, 2 ve 3'e sürükleyin. Ardından 24 saat boyunca yeni yabani otlar olmadan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有杂草时：将护盾拖到1、2和3。之后24小时内不会有新杂草。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於雜草：將防護罩移至1、2、3。之後24小時內沒有新的雜草。"
          }
        }
      }
    },
    "item.waechter_turm.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettet eine Pflanze einmalig vor dem Austrocknen und dem sicheren Tod."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a plant once from drying out and certain death."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una planta una vez de secarse y de una muerte segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauve une plante une fois du dessèchement et d'une mort certaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार पौधे को सूखने और निश्चित मृत्यु से बचाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una pianta una volta dall'essiccazione e da morte certa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物を乾燥と確実な死から一度救います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 마르고 죽는 것을 한 번만 방지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt een plant één keer uitdrogen en een zekere dood."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz ratuje roślinę przed wysychaniem i pewną śmiercią."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma planta uma vez de secar e de morte certa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma planta uma vez de secar e de morte certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасает растение единожды от высыхания и верной смерти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkiyi bir kez kurumaktan ve kesin ölümden kurtarır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性拯救一株植物，使其免于枯萎和死亡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使植物免於乾燥和死亡一次。"
          }
        }
      }
    },

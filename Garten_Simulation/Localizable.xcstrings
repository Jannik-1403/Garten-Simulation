    "fitness.strength.detail.critical": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letztes Krafttraining liegt zu lange zurück. Heute eine kurze Einheit einplanen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been too long since your last strength training session. Plan a short session today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha pasado demasiado tiempo desde tu última sesión de entrenamiento de fuerza. Planifique una sesión corta hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait trop longtemps depuis votre dernière séance de musculation. Planifiez une courte séance aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अंतिम शक्ति प्रशिक्षण सत्र को बहुत लंबा समय हो गया है। आज एक छोटे सत्र की योजना बनाएं."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È passato troppo tempo dalla tua ultima sessione di allenamento per la forza. Pianifica una breve sessione oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の筋力トレーニング セッションから時間が経ちすぎています。今日は短いセッションを計画してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 근력 훈련 세션 이후 너무 오랜 시간이 지났습니다. 오늘 짧은 세션을 계획해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is te lang geleden sinds je laatste krachttraining. Plan vandaag nog een korte sessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minęło zbyt dużo czasu od Twojej ostatniej sesji treningu siłowego. Zaplanuj dzisiaj krótką sesję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já faz muito tempo desde sua última sessão de treinamento de força. Planeje uma breve sessão hoje."
          }

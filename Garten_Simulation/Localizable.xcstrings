            "value": "Im Moment sieht alles gut aus! Bleib am Ball."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Todo pinta bien de momento! Manténganse al tanto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le moment, tout semble bien ! Continue comme ça."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सब कुछ अच्छा लग रहा है! इसे जारी रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento sembra che tutto vada bene! Continua così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のところすべて順調です！この調子で頑張りましょう。"

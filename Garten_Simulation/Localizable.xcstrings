    "item.diamant_erde.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanentes +10\uff05 XP f\u00fcr eine Pflanze. F\u00fcr immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent +10\uff05 XP for one plant. Forever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+10\uff05 XP permanente para una planta. Para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "+10\uff05 XP permanent pour une plante. Pour toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0938\u0902\u092f\u0902\u0924\u094d\u0930 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u092f\u0940 +10\uff05 \u090f\u0915\u094d\u0938\u092a\u0940\u0964 \u0939\u092e\u0947\u0936\u093e \u0915\u0947 \u0932\u093f\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+10\uff05 XP permanente per una pianta. Per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u3064\u306e\u690d\u7269\u306e XP \u304c\u6c38\u7d9a\u7684\u306b +10\uff05\u3002\u6c38\u9060\u306b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud55c \uc2dd\ubb3c\uc5d0 \ub300\ud574 \uc601\uad6c\uc801\uc73c\ub85c +10\uff05 XP\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc601\uc6d0\ud788."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent +10\uff05 XP voor \u00e9\u00e9n plant. Voor altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta\u0142e +10\uff05 XP dla jednej ro\u015bliny. Na zawsze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "+10\uff05 XP permanente para uma planta. Para sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 +10\uff05 \u043e\u043f\u044b\u0442\u0430 \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f. \u041d\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitki i\u00e7in kal\u0131c\u0131 +%10 XP. Sonsuza kadar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u4e00\u682a\u690d\u7269\u6c38\u4e45\u589e\u52a010\uff05\u7ecf\u9a8c\u503c\u3002\u6c38\u4e45\u6709\u6548\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u6c38\u4e45+10\uff05 XP\u3002\u6c38\u9060\u3002"
          }
        }
      }
    },

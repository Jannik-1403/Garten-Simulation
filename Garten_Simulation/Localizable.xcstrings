    "routine.note.assign.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz wird an die Routine angeh\u00e4ngt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note will be attached to the routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota se adjuntar\u00e1 a la rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note sera jointe \u00e0 la routine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0928\u094b\u091f \u0930\u0942\u091f\u0940\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa nota verr\u00e0 allegata alla routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e1\u30e2\u306f\u30eb\u30fc\u30c1\u30f3\u306b\u6dfb\u4ed8\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uba54\ubaa8\ub294 \ub8e8\ud2f4\uc5d0 \ucca8\ubd80\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie wordt aan de routine gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta notatka zostanie do\u0142\u0105czona do rutyny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota ser\u00e1 anexada \u00e0 rotina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u0437\u0430\u043c\u0435\u0442\u043a\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0430 \u043a \u0440\u0443\u0442\u0438\u043d\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu not rutine eklenecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u7b14\u8bb0\u5c06\u9644\u52a0\u5230\u4f8b\u884c\u4e8b\u9879\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u8a3b\u91cb\u9644\u5728\u4f8b\u7a0b\u4e2d\u3002"
          }
        }
      }
    },
    "routine.onboarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle deine bevorzugten Routinen aus und f\u00fcge direkt Gewohnheiten hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your preferred routines and add habits directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tus rutinas preferidas y a\u00f1ade h\u00e1bitos directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez vos routines pr\u00e9f\u00e9r\u00e9es et ajoutez des habitudes directement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0938\u0940\u0927\u0947 \u0906\u0926\u0924\u0947\u0902 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le tue routine preferite e aggiungi le abitudini direttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u597d\u307f\u306e\u30eb\u30fc\u30c1\u30f3\u3092\u9078\u629e\u3057\u3001\u7fd2\u6163\u3092\u76f4\u63a5\u8ffd\u52a0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud638\ud558\ub294 \ub8e8\ud2f4\uc744 \uc120\ud0dd\ud558\uace0 \uc2b5\uad00\uc744 \uc9c1\uc811 \ucd94\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je favoriete routines en voeg direct gewoonten toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz swoje preferowane rutyny i od razu dodaj nawyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha suas rotinas preferidas e adicione h\u00e1bitos diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0432\u043e\u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0443\u0442\u0438\u043d\u044b \u0438 \u0441\u0440\u0430\u0437\u0443 \u0434\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercih etti\u011finiz rutinleri se\u00e7in ve do\u011frudan al\u0131\u015fkanl\u0131klar ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u4f60\u504f\u597d\u7684\u4f8b\u884c\u4e8b\u9879\u5e76\u76f4\u63a5\u6dfb\u52a0\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u60a8\u6700\u559c\u6b61\u7684\u7fd2\u6163\u4e26\u7acb\u5373\u6dfb\u52a0\u7fd2\u6163\u3002"
          }
        }
      }
    },

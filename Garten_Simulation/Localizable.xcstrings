        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u043e\u0432\u044b\u0439 \u0434\u0435\u043d\u044c, \u043d\u043e\u0432\u0430\u044f \u0443\u0434\u0430\u0447\u0430"

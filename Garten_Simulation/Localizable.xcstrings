    "prog_meditation_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald ein Gedanke oder Gefühl auftaucht, gib ihm ein stilles Etikett (z.B. 'Planen', 'Sorgen', 'Freude') und lass es ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as a thought or feeling arises, give it a silent label (e.g., \"planning,\" \"worry,\" \"joy\") and let it go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan pronto como surja un pensamiento o sentimiento, asígnele una etiqueta silenciosa (por ejemplo, \"planificación\", \"preocupación\", \"alegría\") y déjelo ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès qu'une pensée ou un sentiment surgit, donnez-lui une étiquette silencieuse (par exemple, « planification », « inquiétude », « joie ») et laissez-le partir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही कोई विचार या भावना उठे, उसे एक मूक लेबल दें (उदाहरण के लिए, \"योजना,\" \"चिंता,\" ​​\"खुशी\") और उसे जाने दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appena sorge un pensiero o un sentimento, dagli un'etichetta silenziosa (ad esempio, \"pianificazione\", \"preoccupazione\", \"gioia\") e lascialo andare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考えや感情が浮かんだらすぐに、それに沈黙のラベル（例：「計画」、「心配」、「喜び」）を付けて手放してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각이나 느낌이 떠오르자마자, 그것에 조용히 꼬리표(예: \"계획\", \"걱정\", \"기쁨\")를 붙이고 놓아버리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra een gedachte of gevoel opkomt, geef je het een stil label (bijvoorbeeld ‘planning’, ‘zorgen’, ‘vreugde’) en laat je het los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy tylko pojawi się myśl lub uczucie, nadaj jej cichą etykietę (np. „planowanie”, „zmartwienie”, „radość”) i pozwól jej odejść."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que surgir um pensamento ou sentimento, dê-lhe um rótulo silencioso (por exemplo, “planejamento”, “preocupação”, “alegria”) e deixe-o ir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que surgir um pensamento ou sentimento, dê-lhe um rótulo silencioso (por exemplo, “planejamento”, “preocupação”, “alegria”) e deixe-o ir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только возникает мысль или чувство, дайте ей молчаливый ярлык (например, «планирование», «беспокойство», «радость») и отпустите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düşünce ya da duygu ortaya çıktığı anda ona sessiz bir etiket verin (örneğin, \"planlama\", \"endişe\", \"neşe\") ve onu bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦出现某种想法或感觉，就给它贴上一个无声的标签（例如“计划”、“担忧”、“喜悦”），然后放手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦出現某種想法或感覺，就給它貼上一個無聲的標籤（例如“計劃”、“擔憂”、“喜悅”），然後放手。"
          }
        }
      }
    },

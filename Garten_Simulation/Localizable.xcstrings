          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3055\u3048\u305a\u308b\u53cb\u9054\u3092\u5f15\u304d\u5bc4\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uc800\uadc0\ub294 \uce5c\uad6c\ub4e4\uc744 \ub04c\uc5b4\ub4e4\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekt tjilpende vrienden aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyci\u0105ga \u0107wierkaj\u0105cych przyjaci\u00f3\u0142."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrai amigos que cantam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0442\u0432\u0438\u0442\u0442\u0435\u0440-\u0434\u0440\u0443\u0437\u0435\u0439."
          }
        },
        "tr": {

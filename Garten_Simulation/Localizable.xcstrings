    "nutrient.settings.dge_info": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ziele basieren auf den Empfehlungen der DGE (Deutsche Gesellschaft für Ernährung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The targets are based on the recommendations of the DGE."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos se basan en las recomendaciones de la DGE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objectifs sont basés sur les recommandations de la DGE."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य डीजीई (जर्मन सोसाइटी फॉर न्यूट्रिशन) की सिफारिशों पर आधारित हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi si basano sulle raccomandazioni della DGE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この目標は、DGE (ドイツ栄養学会) の推奨事項に基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표는 DGE(독일 영양학회)의 권장 사항을 기반으로 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De doelstellingen zijn gebaseerd op de aanbevelingen van de DGE (Duitse Vereniging voor Voeding)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele opierają się na zaleceniach DGE (Niemieckiego Towarzystwa Żywienia)."
          }

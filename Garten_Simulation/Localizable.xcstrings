    "assessment.fitness.profile.ausreden_sucher.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptiere die Realit\u00e4t. Dein K\u00f6rper ist das exakte Resultat deiner Entscheidungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept reality. Your body is the exact result of your decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepta la realidad. Tu cuerpo es el resultado exacto de tus decisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptez la r\u00e9alit\u00e9. Votre corps est le r\u00e9sultat exact de vos d\u00e9cisions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915\u0924\u093e \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902. \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0906\u092a\u0915\u0947 \u0928\u093f\u0930\u094d\u0923\u092f\u094b\u0902 \u0915\u093e \u0938\u091f\u0940\u0915 \u092a\u0930\u093f\u0923\u093e\u092e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetta la realt\u00e0. Il tuo corpo \u00e8 il risultato esatto delle tue decisioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5b9f\u3092\u53d7\u3051\u5165\u308c\u3066\u304f\u3060\u3055\u3044\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u3042\u306a\u305f\u306e\u6c7a\u65ad\u306e\u6b63\u78ba\u306a\u7d50\u679c\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc2e4\uc744 \ubc1b\uc544\ub4e4\uc774\uc138\uc694. \ub2f9\uc2e0\uc758 \ubab8\uc740 \ub2f9\uc2e0\uc774 \ub0b4\ub9b0 \uacb0\uc815\uc758 \uc815\ud655\ud55c \uacb0\uacfc\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteer de realiteit. Je lichaam is het exacte resultaat van je beslissingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaakceptuj rzeczywisto\u015b\u0107. Twoje cia\u0142o jest dok\u0142adnym rezultatem Twoich decyzji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceite a realidade. Seu corpo \u00e9 o resultado exato de suas decis\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u2014 \u044d\u0442\u043e \u0442\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0442\u0432\u043e\u0438\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger\u00e7ekli\u011fi kabul edin. V\u00fccudunuz kararlar\u0131n\u0131z\u0131n kesin sonucudur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u53d7\u73b0\u5b9e\u3002\u4f60\u7684\u8eab\u4f53\u662f\u4f60\u51b3\u5b9a\u7684\u786e\u5207\u7ed3\u679c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u53d7\u73fe\u5be6\u3002\u4f60\u7684\u8eab\u9ad4\u662f\u4f60\u7684\u6c7a\u5b9a\u7684\u78ba\u5207\u7d50\u679c\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.break": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutze niemals die Worte 'keine Zeit'. Sag stattdessen laut: 'Sport hat f\u00fcr mich heute keine Priorit\u00e4t'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never use the words 'no time'. Instead, say out loud: 'Exercise is not a priority for me today.'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca utilices las palabras \"no hay tiempo\". En lugar de eso, diga en voz alta: \"El ejercicio no es una prioridad para m\u00ed hoy\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilisez jamais les mots \u00ab pas le temps \u00bb. Dites plut\u00f4t \u00e0 voix haute : \u00ab\u00a0L'exercice n'est pas une priorit\u00e9 pour moi aujourd'hui.\u00a0\u00bb"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092d\u0940 \u092d\u0940 '\u0938\u092e\u092f \u0928\u0939\u0940\u0902' \u0936\u092c\u094d\u0926 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f, \u091c\u093c\u094b\u0930 \u0938\u0947 \u0915\u0939\u0947\u0902: '\u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0906\u091c \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non usare mai le parole \"non c'\u00e8 tempo\". Invece, d\u00ec ad alta voce: \"L'esercizio fisico non \u00e8 una priorit\u00e0 per me oggi\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u6642\u9593\u304c\u306a\u3044\u300d\u3068\u3044\u3046\u8a00\u8449\u306f\u6c7a\u3057\u3066\u4f7f\u308f\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u4ee3\u308f\u308a\u306b\u3001\u300c\u4eca\u65e5\u306f\u904b\u52d5\u306f\u79c1\u306b\u3068\u3063\u3066\u512a\u5148\u4e8b\u9805\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u300d\u3068\u58f0\u306b\u51fa\u3057\u3066\u8a00\u3063\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc2dc\uac04\uc774 \uc5c6\ub2e4'\ub294 \ub9d0\uc740 \uc808\ub300 \uc0ac\uc6a9\ud558\uc9c0 \ub9c8\uc138\uc694. \ub300\uc2e0 '\uc624\ub298\uc740 \uc6b4\ub3d9\uc774 \uc6b0\uc120\uc21c\uc704\uac00 \uc544\ub2c8\ub2e4'\ub77c\uace0 \ud070 \uc18c\ub9ac\ub85c \ub9d0\ud574\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik nooit de woorden \u2018geen tijd\u2019. Zeg in plaats daarvan hardop: 'Bewegen heeft vandaag geen prioriteit voor mij.'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie u\u017cywaj s\u0142\u00f3w \u201enie ma czasu\u201d. Zamiast tego powiedz na g\u0142os: \u201e\u0106wiczenia nie s\u0105 dzi\u015b dla mnie priorytetem\u201d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca use as palavras 'sem tempo'. Em vez disso, diga em voz alta: 'O exerc\u00edcio n\u00e3o \u00e9 uma prioridade para mim hoje.'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0441\u043b\u043e\u0432\u0430 '\u043d\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438'. \u0421\u043a\u0430\u0436\u0438 \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u0432\u0441\u043b\u0443\u0445: '\u0421\u043f\u043e\u0440\u0442 \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u043e\u043c'."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla 'zaman yok' kelimesini kullanmay\u0131n. Bunun yerine y\u00fcksek sesle \u015funu s\u00f6yleyin: 'Egzersiz bug\u00fcn benim i\u00e7in bir \u00f6ncelik de\u011fil.'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c38\u8fdc\u4e0d\u8981\u4f7f\u7528'\u6ca1\u6709\u65f6\u95f4'\u8fd9\u51e0\u4e2a\u8bcd\u3002\u53d6\u800c\u4ee3\u4e4b\uff0c\u5927\u58f0\u8bf4\uff1a'\u4eca\u5929\u8fd0\u52a8\u5bf9\u6211\u6765\u8bf4\u4e0d\u662f\u4f18\u5148\u4e8b\u9879'\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c38\u9060\u4e0d\u8981\u4f7f\u7528\u201c\u6c92\u6709\u6642\u9593\u201d\u9019\u500b\u8a5e\u3002\u76f8\u53cd\uff0c\u5927\u8072\u8aaa\uff1a\u201c\u4eca\u5929\u935b\u7149\u4e0d\u662f\u6211\u7684\u9996\u8981\u4efb\u52d9\u3002\u201d"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.build": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereite deine Sporttasche abends vor und stelle sie exakt vor die Haust\u00fcr, sodass du dar\u00fcber stolperst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare your sports bag in the evening and place it exactly in front of the front door so that you can trip over it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare su bolsa de deporte por la noche y col\u00f3quela exactamente delante de la puerta de entrada para que pueda tropezarse con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9parez votre sac de sport le soir et placez-le exactement devant la porte d'entr\u00e9e pour pouvoir tr\u00e9bucher dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0915\u094b \u0905\u092a\u0928\u093e \u0938\u094d\u092a\u094b\u0930\u094d\u091f\u094d\u0938 \u092c\u0948\u0917 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u0938\u0947 \u0938\u093e\u092e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0926\u0930\u0935\u093e\u091c\u0947 \u0915\u0947 \u0920\u0940\u0915 \u0938\u093e\u092e\u0928\u0947 \u0930\u0916\u0947\u0902 \u0924\u093e\u0915\u093f \u0906\u092a \u0909\u0938 \u092a\u0930 \u0938\u0947 \u092b\u093f\u0938\u0932 \u0938\u0915\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparate la sera la vostra borsa sportiva e posizionatela esattamente davanti alla porta d'ingresso in modo da poterci inciampare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5915\u65b9\u306b\u306f\u30b9\u30dd\u30fc\u30c4\u30d0\u30c3\u30b0\u3092\u6e96\u5099\u3057\u3001\u3064\u307e\u305a\u3044\u3066\u3082\u5927\u4e08\u592b\u306a\u3088\u3046\u306b\u7384\u95a2\u306e\u3059\u3050\u524d\u306b\u7f6e\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub141\uc5d0 \uc2a4\ud3ec\uce20 \uac00\ubc29\uc744 \uc900\ube44\ud558\uace0 \uac78\ub824 \ub118\uc5b4\uc9c8 \uc218 \uc788\ub3c4\ub85d \uc815\ubb38 \ubc14\ub85c \uc55e\uc5d0 \ub193\uc544\ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je sporttas 's avonds klaar en plaats deze precies voor de voordeur, zodat je erover kunt struikelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczorem przygotuj torb\u0119 sportow\u0105 i umie\u015b\u0107 j\u0105 dok\u0142adnie przed drzwiami wej\u015bciowymi, tak aby mo\u017cna by\u0142o si\u0119 o ni\u0105 potkn\u0105\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare sua bolsa esportiva \u00e0 noite e coloque-a exatamente em frente \u00e0 porta da frente para que voc\u00ea possa trope\u00e7ar nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u044c \u0441\u0432\u043e\u044e \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0443\u044e \u0441\u0443\u043c\u043a\u0443 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u044c \u0435\u0451 \u043f\u0440\u044f\u043c\u043e \u043f\u0435\u0440\u0435\u0434 \u0434\u0432\u0435\u0440\u044c\u044e, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u043d\u0430 \u043d\u0435\u0451 \u0441\u043f\u043e\u0442\u043a\u043d\u0443\u043b\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u015fam spor \u00e7antan\u0131z\u0131 haz\u0131rlay\u0131n ve tak\u0131l\u0131p d\u00fc\u015febilece\u011finiz \u015fekilde tam \u00f6n kap\u0131n\u0131n \u00f6n\u00fcne yerle\u015ftirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u51c6\u5907\u597d\u4f60\u7684\u8fd0\u52a8\u5305\uff0c\u5e76\u5c06\u5b83\u51c6\u786e\u5730\u653e\u5728\u95e8\u524d\uff0c\u4ee5\u81f3\u4e8e\u4f60\u4f1a\u7eca\u5012\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u6e96\u5099\u597d\u4f60\u7684\u904b\u52d5\u5305\uff0c\u628a\u5b83\u653e\u5728\u524d\u9580\u6b63\u524d\u65b9\uff0c\u9019\u6a23\u4f60\u5c31\u4e0d\u6703\u88ab\u5b83\u7d46\u5012\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verwaltest Ausreden. Durch 1\uff05 Vorbereitung am Vorabend eliminierst du die Option, abzusagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You manage excuses. By preparing 1\uff05 the night before, you eliminate the option of canceling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00fa manejas las excusas. Al preparar el 1\uff05 la noche anterior, eliminas la opci\u00f3n de cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous g\u00e9rez les excuses. En pr\u00e9parant 1\uff05 la veille, vous \u00e9liminez la possibilit\u00e9 d\u2019annuler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092c\u0939\u093e\u0928\u0947 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902. \u090f\u0915 \u0930\u093e\u0924 \u092a\u0939\u0932\u0947 1\uff05 \u0924\u0948\u092f\u093e\u0930\u0940 \u0915\u0930\u0915\u0947, \u0906\u092a \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le scuse. Preparando l'1\uff05 la sera prima, elimini la possibilit\u00e0 di annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u8a00\u3044\u8a33\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002\u524d\u65e5\u306e\u591c\u306b1\uff05\u3092\u6e96\u5099\u3057\u3066\u304a\u3051\u3070\u3001\u30ad\u30e3\u30f3\u30bb\u30eb\u306e\u9078\u629e\u80a2\u304c\u306a\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ubcc0\uba85\uc744 \uad00\ub9ac\ud569\ub2c8\ub2e4. \uc804\ub0a0 \ubc24 1\uff05\ub97c \uc900\ube44\ud558\uba74 \ucde8\uc18c\ud560 \uac00\ub2a5\uc131\uc774 \uc5c6\uc5b4\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beheert excuses. Door de avond ervoor 1\uff05 voor te bereiden, elimineert u de mogelijkheid om te annuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarz\u0105dzasz wym\u00f3wkami. Przygotowuj\u0105c 1\uff05 dzie\u0144 wcze\u015bniej, eliminujesz mo\u017cliwo\u015b\u0107 rezygnacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea gerencia desculpas. Ao preparar 1\uff05 na noite anterior, voc\u00ea elimina a op\u00e7\u00e3o de cancelamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0448\u044c \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u044f\u043c\u0438. \u0412\u0441\u0435\u0433\u043e 1\uff05 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u043d\u0430\u043a\u0430\u043d\u0443\u043d\u0435 \u0443\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043c\u0435\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahaneleri y\u00f6netiyorsun. \uff051'i bir gece \u00f6nceden haz\u0131rlayarak iptal se\u00e7ene\u011fini ortadan kald\u0131r\u0131rs\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u7ba1\u7406\u501f\u53e3\u3002\u901a\u8fc7\u524d\u4e00\u665a 1\uff05 \u7684\u51c6\u5907\uff0c\u4f60\u53ef\u4ee5\u6d88\u9664\u53d6\u6d88\u7684\u9009\u9879\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7ba1\u7406\u85c9\u53e3\u3002\u900f\u904e\u524d\u4e00\u5929\u665a\u4e0a\u6e96\u5099 1\uff05\uff0c\u60a8\u5c31\u7121\u9700\u53d6\u6d88\u9810\u8a02\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ausreden-Sucher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The excuse seeker"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El buscador de excusas"
          }
        },
        "fr": {

    "assessment.growth.q5" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist seit 20 Minuten hochkonzentriert bei der Arbeit. Plötzlich vibriert dein Handy – eine Nachricht von einer Person, die du extrem interessant findest."

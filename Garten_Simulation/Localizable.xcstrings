    "effekt.frostwarnung.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute gibt es nur %@ Coins und XP beim Gießen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %@ coins and XP from watering today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %@ de monedas y XP al regar hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %@ de pièces et XP à l'arrosage aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज ढलाई के समय केवल %@ सिक्के और एक्सपी हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi ci sono solo %@ monete e XP per l'annaffiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の水やりによるコインとXPは%@のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 물을 뿌리면 코인과 XP가 %@만 지급됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechts %@ munten en XP door vandaag water te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko %@ monet i XP z dzisiejszego podlewania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %@ de moedas e XP ao regar hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %@ de moedas e XP ao regar hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня при поливе дают только %@ монет и опыта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü sulamadan yalnızca %@50 jeton ve XP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天浇水时只有%@的金币和经验值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天鑄造時只有 %@ 的金幣和 XP。"
          }
        }
      }
    },

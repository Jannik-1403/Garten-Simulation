    "onboarding_benachrichtigung_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll ich dich an deine Gewohnheiten erinnern? So vergisst du nie zu gießen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I remind you of your habits? That way you'll never forget to water!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres que te recuerde tus hábitos? ¡Así nunca olvidarás regar!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois-je te rappeler tes habitudes ? Ainsi, tu n'oublieras jamais d'arroser !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप चाहते हैं कि मैं आपको आपकी आदतें याद दिलाऊं? इस तरह आप पानी देना कभी नहीं भूलेंगे!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi che ti ricordi le tue abitudini? In questo modo non ti dimenticherai mai di annaffiare!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの習慣を思い出させたほうがいいでしょうか？そうすれば水やりを忘れることがなくなりますよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 습관을 상기시켜 드려야 할까요? 그렇게 하면 물 주는 것을 결코 잊지 않을 것입니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moet ik je aan je gewoontes herinneren? Zo vergeet je nooit meer water te geven!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam ci przypomnieć o twoich nawykach? Dzięki temu nigdy nie zapomnisz o podlaniu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres que te lembre dos teus hábitos? Assim nunca te esquecerás de regar!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres que te lembre dos teus hábitos? Assim nunca te esquecerás de regar!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне напомнить тебе о твоих привычках? Так ты никогда не забудешь поливать!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana alışkanlıklarını hatırlatmalı mıyım? Böylece sulamayı asla unutmayacaksınız!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要我提醒你养成习惯吗？这样你就永远不会忘记浇水了！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你想讓我提醒你你的習慣嗎？這樣你就永遠不會忘記澆水！"
          }
        }
      }
    },

    "item.diamant_erde.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und verbessert die Bodenqualität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and improves soil quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa inmediatamente y mejora la calidad del suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active immédiatement et améliore la qualité du sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत सक्रिय हो जाता है और मिट्टी की गुणवत्ता में सुधार लाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si attiva immediatamente e migliora la qualità del terreno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに活性化して土壌の質を改善します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 활성화되어 토양의 질을 향상시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt direct actief en verbetert de bodemkwaliteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast staje się aktywny i poprawia jakość gleby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e melhora a qualidade do solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e melhora a qualidade do solo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу начинает действовать и улучшает качество почвы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve toprak kalitesini artırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效并改善土壤质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即變得活躍並改善土壤品質。"
          }
        }
      }
    },

        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "植物も忘れずに！ %2$d %1$@ は今日も水が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 식물을 잊지 마세요! %2$d %1$@ 오늘도 여전히 물이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergeet je planten niet! %2$d %1$@ heeft vandaag nog steeds water nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zapomnij o swoich roślinach! %2$d %1$@ nadal dzisiaj potrzebuje wody."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não te esqueças das tuas plantas! %2$d %1$@ ainda precisa de água hoje."
          }
        },

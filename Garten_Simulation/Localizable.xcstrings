        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub450 \uc815\uc0c1\uc785\ub2c8\ub2e4. \ubb3c\uc744 \ud55c \ubc88 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Allemaal normaal. E\u00e9n keer water geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko normalne. Raz podla\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo normal. Rega uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e. \u041f\u043e\u043b\u0438\u0432\u0430\u0439\u0442\u0435 \u043e\u0434\u0438\u043d \u0440\u0430\u0437."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi normal. Bir kez su."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u5207\u6b63\u5e38\u3002\u6d47\u4e00\u6b21\u6c34\u3002"

          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30fc\u30c8\u30bf\u30c3\u30c1\u3068\u6642\u4ee3\u3092\u8d85\u8d8a\u3057\u305f\u96f0\u56f2\u6c17\u3002"

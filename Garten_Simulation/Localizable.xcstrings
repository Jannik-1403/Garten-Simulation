          "stringUnit": {
            "state": "translated",
            "value": "하루에 2번, 2분 동안 이를 닦으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poets je tanden twee keer per dag gedurende 2 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Myj zęby dwa razy dziennie przez 2 minuty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escova os dentes 2 vezes por dia durante 2 minutos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dişlerinizi günde iki kez 2 dakika boyunca fırçalayın."

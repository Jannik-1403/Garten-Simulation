    "pfad_fehlt_phase_aufbau_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst Fortschritte. Steigere deinen pers\u00f6nlichen Einsatz heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are making progress. Increase your personal effort today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s progresando. Aumenta tu esfuerzo personal hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fais des progr\u00e8s. Augmente ton effort personnel aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902. \u0906\u091c \u0905\u092a\u0928\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927\u0924\u093e \u092c\u0922\u093c\u093e\u090f\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai facendo progressi. Aumenta il tuo impegno personale oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9032\u6b69\u3057\u3066\u3044\u307e\u3059\u306d\u3002\u4eca\u65e5\u306f\u500b\u4eba\u306e\u52aa\u529b\u3092\u5897\u3084\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ubc1c\uc804\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc624\ub298 \uac1c\uc778\uc801\uc778 \ub178\ub825\uc744 \ub354 \ub9ce\uc774 \ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je boekt vooruitgang. Verhoog vandaag nog uw persoonlijke inspanning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Robisz post\u0119py. Zwi\u0119ksz sw\u00f3j osobisty wysi\u0142ek ju\u017c dzi\u015b."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s a progredir. Aumenta o teu esfor\u00e7o pessoal hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c \u0443\u0441\u043f\u0435\u0445\u0438. \u041f\u043e\u0432\u044b\u0448\u0430\u0439 \u0441\u0432\u043e\u0438 \u043b\u0438\u0447\u043d\u044b\u0435 \u0443\u0441\u0438\u043b\u0438\u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lerleme kaydediyorsun. Bug\u00fcn ki\u015fisel \u00e7aban\u0131z\u0131 art\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u6b63\u5728\u53d6\u5f97\u8fdb\u5c55\u3002\u4eca\u5929\u63d0\u9ad8\u60a8\u7684\u4e2a\u4eba\u6295\u5165\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u5728\u9032\u6b65\u3002\u4eca\u5929\u5c31\u589e\u52a0\u4f60\u7684\u500b\u4eba\u627f\u8afe\u3002"
          }
        }
      }
    },
    "pfad_fehlt_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beginn von etwas Gro\u00dfem. Dein pers\u00f6nliches Ziel wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The beginning of something great. Your personal goal awaits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comienzo de algo grande. Tu objetivo personal te espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le d\u00e9but de quelque chose de grand. Ton objectif personnel t'attend."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u092c\u0921\u093c\u0940 \u091a\u0940\u091c\u093c \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924. \u0906\u092a\u0915\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0932\u0915\u094d\u0937\u094d\u092f \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930 \u0930\u0939\u093e \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inizio di qualcosa di grande. Il tuo obiettivo personale ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d20\u6674\u3089\u3057\u3044\u3082\u306e\u306e\u59cb\u307e\u308a\u3002\u3042\u306a\u305f\u306e\u500b\u4eba\u7684\u306a\u76ee\u6a19\u304c\u5f85\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc704\ub300\ud55c \uc77c\uc758 \uc2dc\uc791. \ub2f9\uc2e0\uc758 \uac1c\uc778\uc801\uc778 \ubaa9\ud45c\uac00 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het begin van iets groots. Jouw persoonlijke doel wacht op je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocz\u0105tek czego\u015b wielkiego. Tw\u00f3j osobisty cel czeka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O in\u00edcio de algo grande. O teu objetivo pessoal espera por ti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0447\u0430\u043b\u043e \u0447\u0435\u0433\u043e-\u0442\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433\u043e. \u0422\u0432\u043e\u044f \u043b\u0438\u0447\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0436\u0434\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika bir \u015feyin ba\u015flang\u0131c\u0131. Ki\u015fisel hedefiniz sizi bekliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1f\u5927\u4e8b\u4e1a\u7684\u5f00\u59cb\u3002\u60a8\u7684\u4e2a\u4eba\u76ee\u6807\u6b63\u5728\u7b49\u5f85\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5927\u4e8b\u7684\u958b\u59cb\u3002\u60a8\u7684\u500b\u4eba\u76ee\u6a19\u6b63\u5728\u7b49\u8457\u60a8\u3002"
          }
        }
      }
    },
    "pfad_fehlt_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel erreicht! Du hast bewiesen was in dir steckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goal reached! You have proven what you are made of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Meta alcanzada! Has demostrado de qu\u00e9 est\u00e1s hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectif atteint ! Tu as prouv\u00e9 de quoi tu es capable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0915\u094d\u0937\u094d\u092f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u0906! \u0906\u092a\u0928\u0947 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0915\u093f\u0938 \u091a\u0940\u091c \u0938\u0947 \u092c\u0928\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiettivo raggiunto! Hai dimostrato di che pasta sei fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6a19\u9054\u6210\uff01\u3042\u306a\u305f\u306f\u81ea\u5206\u304c\u4f55\u3067\u3067\u304d\u3066\u3044\u308b\u304b\u3092\u8a3c\u660e\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa9\ud45c \ub2ec\uc131! \ub2f9\uc2e0\uc740 \ub2f9\uc2e0\uc774 \ubb34\uc5c7\uc73c\ub85c \ub9cc\ub4e4\uc5b4\uc84c\ub294\uc9c0 \uc99d\uba85\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doel bereikt! Je hebt bewezen waar je van gemaakt bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel osi\u0105gni\u0119ty! Udowodni\u0142e\u015b, na co ci\u0119 sta\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetivo alcan\u00e7ado! Provaste do que \u00e9s capaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u043b\u044c \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u0430! \u0422\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u043d\u0430 \u0447\u0442\u043e \u0442\u044b \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefe ula\u015f\u0131ld\u0131! Neyden yarat\u0131ld\u0131\u011f\u0131n\u0131z\u0131 kan\u0131tlad\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6807\u8fbe\u6210\uff01\u4f60\u5df2\u8bc1\u660e\u4e86\u81ea\u5df1\u7684\u5b9e\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6a19\u9054\u5230\u4e86\uff01\u4f60\u5df2\u7d93\u8b49\u660e\u4e86\u4f60\u662f\u7531\u4ec0\u9ebc\u7d44\u6210\u7684\u3002"
          }
        }
      }
    },
    "pfad_fehlt_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib dran an deinem Ziel. Du bist fast da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay focused on your goal. You are almost there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente enfocado en tu meta. Casi est\u00e1s ah\u00ed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste concentr\u00e9 sur ton objectif. Tu y es presque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u094d\u092f \u092a\u0930 \u091f\u093f\u0915\u0947 \u0930\u0939\u094b. \u0924\u0941\u092e \u0932\u0917\u092d\u0917 \u0935\u0939\u093e\u0902 \u0925\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani concentrato sul tuo obiettivo. Ci sei quasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6a19\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3082\u3046\u3059\u3050\u305d\u3053\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa9\ud45c\uc5d0 \uacc4\uc18d \uc9d1\uc911\ud558\uc138\uc694. \uac70\uc758 \ub2e4 \uc654\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf gefocust op je doel. Je bent er bijna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoncentruj si\u0119 na swoim celu. Ju\u017c prawie jeste\u015b."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9m-te focado no teu objetivo. Est\u00e1s quase l\u00e1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u0440\u0436\u0438\u0441\u044c \u0441\u0432\u043e\u0435\u0439 \u0446\u0435\u043b\u0438. \u0422\u044b \u043f\u043e\u0447\u0442\u0438 \u0442\u0430\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefinize odaklan\u0131n. Neredeyse oradas\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u575a\u6301\u4f60\u7684\u76ee\u6807\u3002\u4f60\u5feb\u6210\u529f\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5805\u6301\u4f60\u7684\u76ee\u6a19\u3002\u4f60\u5feb\u5230\u4e86\u3002"
          }
        }
      }
    },
    "pfad_fit_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach heute 10 Liegest\u00fctze. Qualit\u00e4t vor Quantit\u00e4t."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 10 pushups today. Quality over quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz 10 flexiones hoy. Calidad sobre cantidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais 10 pompes aujourd'hui. Qualit\u00e9 avant quantit\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c 10 \u092a\u0941\u0936-\u0905\u092a\u094d\u0938 \u0915\u0930\u0947\u0902\u0964 \u092e\u093e\u0924\u094d\u0930\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai 10 flessioni oggi. Qualit\u00e0 prima della quantit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u8155\u7acb\u3066\u4f0f\u305b\u309210\u56de\u3084\u3063\u3066\u307f\u3088\u3046\u3002\u91cf\u3088\u308a\u8cea\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298 \ud314\uad7d\ud600\ud3b4\uae30 10\uac1c\ub97c \ud574\ubcf4\uc138\uc694. \uc591\ubcf4\ub2e4 \uc9c8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe vandaag 10 push-ups. Kwaliteit boven kwantiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zr\u00f3b dzisiaj 10 pompek. Jako\u015b\u0107 ponad ilo\u015b\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz 10 flex\u00f5es hoje. Qualidade acima de quantidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0434\u0435\u043b\u0430\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f 10 \u043e\u0442\u0436\u0438\u043c\u0430\u043d\u0438\u0439. \u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0432\u0430\u0436\u043d\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn 10 \u015f\u0131nav \u00e7ekin. Miktar\u0131n \u00fczerinde kalite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u505a10\u4e2a\u4fef\u5367\u6491\u3002\u91cd\u8d28\u4e0d\u91cd\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u505a10\u500b\u4f0f\u5730\u633a\u8eab\u3002\u8cea\u91cd\u65bc\u6578\u91cf\u3002"
          }
        }
      }
    },
    "pfad_fit_day_1_title": {

    "plant.teestrauch.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfter, nachhaltiger Wachstum \u2013 Weniger Kaffee"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle, sustainable growth \u2013 Less coffee"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crecimiento suave y sostenible \u2013 Menos caf\u00e9"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croissance douce et durable \u2013 Moins de caf\u00e9"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094c\u092e\u094d\u092f, \u0938\u094d\u0925\u093e\u092f\u0940 \u0935\u093f\u0915\u093e\u0938 \u2013 \u0915\u092e \u0915\u0949\u092b\u0940"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle, sustainable growth \u2013 Less coffee"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a4f\u3084\u304b\u3067\u6301\u7d9a\u53ef\u80fd\u306a\u6210\u9577 \u2013 \u30b3\u30fc\u30d2\u30fc\u306e\u91cf\u3092\u6e1b\u3089\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc628\ud654\ud558\uace0 \uc9c0\uc18d \uac00\ub2a5\ud55c \uc131\uc7a5 \u2013 \ucee4\ud53c \uac10\uc18c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachte, duurzame groei \u2013 Minder koffie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatny, zr\u00f3wnowa\u017cony wzrost \u2013 Mniej kawy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crescimento suave e sustent\u00e1vel \u2013 Menos caf\u00e9"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u044f\u0433\u043a\u0438\u0439, \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0439 \u0440\u043e\u0441\u0442 \u2013 \u043c\u0435\u043d\u044c\u0448\u0435 \u043a\u043e\u0444\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik, s\u00fcrd\u00fcr\u00fclebilir b\u00fcy\u00fcme \u2013 Daha az kahve"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e29\u548c\u3001\u53ef\u6301\u7eed\u7684\u751f\u957f \u2013 \u5c11\u559d\u5496\u5561"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6eab\u548c\u3001\u53ef\u6301\u7e8c\u7684\u6210\u9577\uff0d\u6e1b\u5c11\u5496\u5561\u7684\u651d\u53d6\u91cf"
          }
        }
      }
    },

    "streak.freeze.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Streak auf Eis sch\u00fctzt deinen Streak einen Tag lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Streak Freeze protects your streak for one day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un protector de racha protege tu racha por un d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gel de s\u00e9rie prot\u00e8ge ta s\u00e9rie pendant un jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0930\u094d\u092b \u092a\u0930 \u090f\u0915 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0906\u092a\u0915\u0947 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u094b \u090f\u0915 \u0926\u093f\u0928 \u0915\u0947 \u0932\u093f\u090f \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno Streak Freeze protegge la tua serie per un giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30ea\u30fc\u30af \u30d5\u30ea\u30fc\u30ba\u306f\u3001\u30b9\u30c8\u30ea\u30fc\u30af\u3092 1 \u65e5\u9593\u4fdd\u8b77\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak Freeze\ub294 \ud558\ub8e8 \ub3d9\uc548 \uc5f0\uc18d \uae30\ub85d\uc744 \ubcf4\ud638\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Streak Freeze beschermt je streak voor \u00e9\u00e9n dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak Freeze chroni Twoj\u0105 pass\u0119 przez jeden dzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um protetor de sequ\u00eancia protege a tua sequ\u00eancia por um dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u043e\u0441\u0430 \u043d\u0430 \u043b\u044c\u0434\u0443 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0432\u0430\u0448 \u0441\u0442\u0440\u0438\u043a \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7izgi Dondurma serinizi bir g\u00fcn boyunca korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51b0\u4e0a\u8fde\u80dc\u53ef\u4ee5\u4fdd\u62a4\u60a8\u4e00\u5929\u7684\u8fde\u80dc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51b0\u4e0a\u9023\u52dd\u53ef\u4ee5\u4fdd\u8b77\u60a8\u4e00\u5929\u7684\u9023\u52dd\u3002"
          }
        }
      }
    },

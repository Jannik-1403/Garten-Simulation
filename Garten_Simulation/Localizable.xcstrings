    "trash.zigaretten_automat.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befreie deine Lungen und wähle ein gesundes, rauchfreies Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free your lungs and choose a healthy, smoke-free life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera tus pulmones y elige una vida sana y sin humo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère tes poumons et choisis une vie saine et sans fumée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फेफड़े को मुक्त करें और एक स्वस्थ, धूम्रपान-मुक्त जीवन चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera i tuoi polmoni e scegli una vita sana e senza fumo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肺を解放し、健康で煙のない生活を選びましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폐를 해방시키고 건강하고 담배 없는 삶을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevrijd je longen en kies voor een gezond, rookvrij leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwolnij swoje płuca i wybierz zdrowe życie wolne od dymu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte seus pulmões e escolha uma vida saudável e sem fumo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte seus pulmões e escolha uma vida saudável e sem fumo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите свои легкие и выберите здоровую жизнь без табачного дыма."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akciğerlerinizi özgürleştirin ve sağlıklı, dumansız bir hayat seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清肺，选择健康、无烟的生活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清肺，選擇健康、無菸的生活。"
          }
        }
      }
    },
    "trash.zigaretten_automat.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Rauchen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Smoking) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Fumar) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Fumer) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (धूम्रपान) लंबे समय में तुम्हारी ऊर्जा, समय और पैसा खर्च करती है। यह तुम्हें अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Fumare) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（喫煙）は、長期的にはエネルギー、時間、お金を消費します。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(흡연)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (Roken) kost je op lange termijn energie, tijd en geld. Het weerhoudt je ervan je volledige potentieel te benutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (palenie) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Fumar) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Fumar) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (курение) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (sigara içmek) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（吸烟）会消耗您的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，這種習慣（吸煙）會消耗您的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

    "progression_noalcohol_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke weiterhin Wasser oder Tee statt alkoholischen Getr\u00e4nken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue drinking water or tea instead of alcoholic beverages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue bebiendo agua o t\u00e9 en lugar de bebidas alcoh\u00f3licas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de boire de l'eau ou du th\u00e9 au lieu de boissons alcoolis\u00e9es."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0930\u093e\u092c\u0940 \u092a\u0947\u092f \u0915\u0947 \u092c\u091c\u093e\u092f \u092a\u093e\u0928\u0940 \u092f\u093e \u091a\u093e\u092f \u092a\u0940\u0924\u0947 \u0930\u0939\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a bere acqua o t\u00e8 invece di bevande alcoliche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30eb\u30b3\u30fc\u30eb\u98f2\u6599\u306e\u4ee3\u308f\u308a\u306b\u6c34\u3084\u304a\u8336\u3092\u98f2\u307f\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc54c\ucf54\uc62c \uc74c\ub8cc \ub300\uc2e0 \ubb3c\uc774\ub098 \ucc28\ub97c \uacc4\uc18d \uc12d\ucde8\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf water of thee drinken in plaats van alcoholische dranken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj picie wody lub herbaty zamiast napoj\u00f3w alkoholowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a beber \u00e1gua ou ch\u00e1 em vez de bebidas alco\u00f3licas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u043f\u0438\u0442\u044c \u0432\u043e\u0434\u0443 \u0438\u043b\u0438 \u0447\u0430\u0439 \u0432\u043c\u0435\u0441\u0442\u043e \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u043f\u0438\u0442\u043a\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkoll\u00fc i\u00e7ecekler yerine su veya \u00e7ay i\u00e7meye devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ee7\u7eed\u559d\u6c34\u6216\u8336\uff0c\u800c\u4e0d\u662f\u9152\u7cbe\u996e\u6599\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7e7c\u7e8c\u559d\u6c34\u6216\u8336\u800c\u4e0d\u662f\u9152\u7cbe\u98f2\u6599\u3002"
          }
        }
      }
    },
    "progression_noalcohol_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzichte heute komplett auf Alkohol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstain from alcohol completely today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstente de alcohol por completo hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abstiens-toi compl\u00e8tement d'alcool aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0936\u0930\u093e\u092c \u0938\u0947 \u092a\u0930\u0939\u0947\u091c \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Astitieniti completamente dall'alcol oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u30a2\u30eb\u30b3\u30fc\u30eb\u3092\u5b8c\u5168\u306b\u63a7\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \uc220\uc744 \uc644\uc804\ud788 \uc0bc\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onthoud u vandaag volledig van alcohol."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od dzisiaj ca\u0142kowicie powstrzymaj si\u0119 od alkoholu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abst\u00e9m-te completamente de \u00e1lcool hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0430\u0436\u0438\u0441\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0442 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn alkolden tamamen uzak durun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u5b8c\u5168\u6212\u9152\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u8981\u5b8c\u5168\u907f\u514d\u98f2\u9152\u3002"
          }
        }
      }
    },
    "progression_noalcohol_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du beweist eiserne Disziplin. Bleib stark und alkoholfrei!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You prove iron discipline. Stay strong and alcohol-free!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demuestras una disciplina de hierro. \u00a1Mantente fuerte y sin alcohol!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fais preuve d'une discipline de fer. Reste fort et sans alcool !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u0932\u094b\u0939\u093e \u091c\u0948\u0938\u0940 \u0905\u0928\u0941\u0936\u093e\u0938\u0928 \u0926\u093f\u0916\u093e\u0924\u0947 \u0939\u094b\u0964 \u092e\u091c\u092c\u0942\u0924 \u0930\u0939\u094b \u0914\u0930 \u0936\u0930\u093e\u092c \u092e\u0941\u0915\u094d\u0924 \u0930\u0939\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimostri una disciplina di ferro. Rimani forte e senza alcol!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u9244\u306e\u898f\u5f8b\u3092\u8a3c\u660e\u3057\u307e\u3059\u3002\u30a2\u30eb\u30b3\u30fc\u30eb\u3092\u63a7\u3048\u3066\u5f37\u304f\u306a\u308a\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uac15\ucca0 \uac19\uc740 \uaddc\uc728\uc744 \uc99d\uba85\ud588\uc2b5\ub2c8\ub2e4. \ud798\ub0b4\uc2dc\uace0 \uc54c\ucf54\uc62c \uc5c6\uc774 \uc9c0\ub0b4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bewijst ijzeren discipline. Blijf sterk en alcoholvrij!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazujesz \u017celazn\u0105 dyscyplin\u0119. B\u0105d\u017a silny i wolny od alkoholu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Provas uma disciplina de ferro. Mant\u00e9m-te forte e sem \u00e1lcool!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0435\u0448\u044c \u0436\u0435\u043b\u0435\u0437\u043d\u0443\u044e \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0443. \u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0438 \u0442\u0440\u0435\u0437\u0432\u044b\u043c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demir disiplini kan\u0131tl\u0131yorsun. G\u00fc\u00e7l\u00fc ve alkols\u00fcz kal\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5c55\u73b0\u4e86\u94a2\u94c1\u822c\u7684\u7eaa\u5f8b\u3002\u4fdd\u6301\u5f3a\u5927\uff0c\u8fdc\u79bb\u9152\u7cbe\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5c55\u73fe\u4e86\u92fc\u9435\u822c\u7684\u7d00\u5f8b\u3002\u4fdd\u6301\u5805\u5f37\uff0c\u9060\u96e2\u9152\u7cbe\uff01"
          }
        }
      }
    },
    "progression_noalcohol_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke neue alkoholfreie Alternativen und genie\u00dfe die Klarheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover new non-alcoholic alternatives and enjoy the clarity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre nuevas alternativas sin alcohol y disfruta de la claridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9couvre de nouvelles alternatives sans alcool et profite de la clart\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0908 \u0936\u0930\u093e\u092c \u092e\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u0915\u0940 \u0916\u094b\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u094d\u092a\u0937\u094d\u091f\u0924\u093e \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri nuove alternative analcoliche e goditi la lucidit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u3057\u3044\u30ce\u30f3\u30a2\u30eb\u30b3\u30fc\u30eb\u306e\u4ee3\u66ff\u54c1\u3092\u767a\u898b\u3057\u3001\u305d\u306e\u900f\u660e\u611f\u3092\u304a\u697d\u3057\u307f\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c8\ub85c\uc6b4 \ubb34\uc54c\ucf5c \ub300\uc548\uc744 \ubc1c\uacac\ud558\uace0 \uba85\ub8cc\ud568\uc744 \uc990\uaca8\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek nieuwe alcoholvrije alternatieven en geniet van de helderheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkryj nowe bezalkoholowe alternatywy i ciesz si\u0119 klarowno\u015bci\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descobre novas alternativas sem \u00e1lcool e desfruta da clareza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u0431\u0435\u0437\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u044b\u0435 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u044b \u0438 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0439\u0442\u0435\u0441\u044c \u044f\u0441\u043d\u043e\u0441\u0442\u044c\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni alkols\u00fcz alternatifleri ke\u015ffedin ve berrakl\u0131\u011f\u0131n tad\u0131n\u0131 \u00e7\u0131kar\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a2\u7d22\u65b0\u7684\u65e0\u9152\u7cbe\u66ff\u4ee3\u54c1\uff0c\u4eab\u53d7\u6e05\u9192\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u767c\u73fe\u65b0\u7684\u4e0d\u542b\u9152\u7cbe\u7684\u66ff\u4ee3\u54c1\u4e26\u4eab\u53d7\u6e05\u6670\u5ea6\u3002"
          }
        }
      }
    },
    "progression_screentime_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere deine Bildschirmzeit am Tag um 1 Stunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce your daily screen time by 1 hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce tu tiempo de pantalla diario en 1 hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9duis ton temps d'\u00e9cran quotidien d'une heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u092e\u092f \u0915\u094b 1 \u0918\u0902\u091f\u0947 \u0915\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci il tuo tempo di utilizzo dello schermo giornaliero di 1 ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u65e5\u306e\u30b9\u30af\u30ea\u30fc\u30f3\u30bf\u30a4\u30e0\u3092 1 \u6642\u9593\u6e1b\u3089\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc77c \ud654\uba74 \uc0ac\uc6a9 \uc2dc\uac04\uc744 1\uc2dc\uac04 \uc904\uc774\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder uw dagelijkse schermtijd met 1 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skr\u00f3\u0107 dzienny czas korzystania z ekranu o 1 godzin\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz o teu tempo de ecr\u00e3 di\u00e1rio em 1 hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u043a\u0440\u0430\u0442\u0438 \u0441\u0432\u043e\u0451 \u0432\u0440\u0435\u043c\u044f \u043f\u0435\u0440\u0435\u0434 \u044d\u043a\u0440\u0430\u043d\u043e\u043c \u043d\u0430 \u0434\u0435\u043d\u044c \u043d\u0430 1 \u0447\u0430\u0441."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck ekran s\u00fcrenizi 1 saat azalt\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u51cf\u5c111\u5c0f\u65f6\u7684\u5c4f\u5e55\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u6e1b\u5c11\u770b\u87a2\u5e55\u7684\u6642\u9593 1 \u5c0f\u6642\u3002"
          }
        }
      }
    },
    "progression_screentime_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege das Handy 30 Minuten vor dem Schlafen weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the phone away 30 minutes before sleeping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el tel\u00e9fono 30 minutos antes de dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range le t\u00e9l\u00e9phone 30 minutes avant de dormir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094b\u0928\u0947 \u0938\u0947 30 \u092e\u093f\u0928\u091f \u092a\u0939\u0932\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u092b\u094b\u0928 \u0915\u094b \u0926\u0942\u0930 \u0930\u0916\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti via il telefono 30 minuti prima di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bdd\u308b30\u5206\u524d\u306b\u306f\u643a\u5e2f\u96fb\u8a71\u3092\u3057\u307e\u3063\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\ub4e4\uae30 30\ubd84 \uc804\uc5d0\ub294 \uc804\ud654\uae30\ub97c \uce58\uc6cc\ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg de telefoon 30 minuten voordat u gaat slapen weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od\u0142\u00f3\u017c telefon na 30 minut przed snem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda o telem\u00f3vel 30 minutos antes de dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u043e\u0436\u0438 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0437\u0430 30 \u043c\u0438\u043d\u0443\u0442 \u0434\u043e \u0441\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyumadan 30 dakika \u00f6nce telefonu bir kenara b\u0131rak\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7761\u524d30\u5206\u949f\u653e\u4e0b\u624b\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7761\u524d 30 \u5206\u9418\u628a\u624b\u6a5f\u6536\u8d77\u4f86\u3002"
          }
        }
      }
    },
    "progression_screentime_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meistere den digitalen Minimalismus. Nutze dein Handy nur noch bewusst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master digital minimalism. Use your phone only consciously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Domina el minimalismo digital. Usa tu tel\u00e9fono solo conscientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u00eetrise le minimalisme num\u00e9rique. Utilise ton t\u00e9l\u00e9phone uniquement consciemment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u093f\u091c\u093f\u091f\u0932 \u0928\u094d\u092f\u0942\u0928\u0924\u093e\u0935\u093e\u0926 \u092e\u0947\u0902 \u092e\u093e\u0939\u093f\u0930 \u092c\u0928\u094b\u0964 \u0905\u092a\u0928\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0905\u092c \u0915\u0947\u0935\u0932 \u0938\u091a\u0947\u0924 \u0930\u0942\u092a \u0938\u0947 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Padroneggia il minimalismo digitale. Usa il telefono solo consapevolmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c7\u30b8\u30bf\u30eb\u30df\u30cb\u30de\u30ea\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002\u643a\u5e2f\u96fb\u8a71\u306f\u610f\u8b58\u7684\u306b\u306e\u307f\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub514\uc9c0\ud138 \ubbf8\ub2c8\uba40\ub9ac\uc998\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. \ud734\ub300\uc804\ud654\ub294 \uc758\uc2dd\uc801\uc73c\ub85c\ub9cc \uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheers digitaal minimalisme. Gebruik je telefoon alleen bewust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opanuj cyfrowy minimalizm. Korzystaj z telefonu tylko \u015bwiadomie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Domina o minimalismo digital. Usa o teu telem\u00f3vel apenas conscientemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0432\u043e\u0439\u0442\u0435 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u0438\u0437\u043c. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0442\u0435\u043f\u0435\u0440\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijital minimalizmde ustala\u015f\u0131n. Telefonunuzu yaln\u0131zca bilin\u00e7li kullan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u638c\u63e1\u6570\u5b57\u6781\u7b80\u4e3b\u4e49\u3002\u53ea\u5728\u6709\u610f\u8bc6\u65f6\u4f7f\u7528\u624b\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u638c\u63e1\u6578\u5b57\u6975\u7c21\u4e3b\u7fa9\u3002\u6709\u610f\u8b58\u5730\u4f7f\u7528\u624b\u6a5f\u3002"
          }
        }
      }
    },
    "progression_screentime_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbanne Bildschirme aus deinem Schlafzimmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ban screens from your bedroom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proh\u00edbe las pantallas en tu dormitorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bannis les \u00e9crans de ta chambre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092c\u0947\u0921\u0930\u0942\u092e \u0938\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0939\u091f\u093e \u0926\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandisci gli schermi dalla tua camera da letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bdd\u5ba4\u306b\u30b9\u30af\u30ea\u30fc\u30f3\u3092\u8a2d\u7f6e\u3059\u308b\u3053\u3068\u3092\u7981\u6b62\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce68\uc2e4\uc5d0\uc11c \uc2a4\ud06c\ub9b0\uc744 \uae08\uc9c0\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbied schermen uit je slaapkamer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakaz ekran\u00f3w w swojej sypialni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bane os ecr\u00e3s do teu quarto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0433\u043e\u043d\u0438 \u044d\u043a\u0440\u0430\u043d\u044b \u0438\u0437 \u0441\u0432\u043e\u0435\u0439 \u0441\u043f\u0430\u043b\u044c\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatak odan\u0131zdaki ekranlar\u0131 yasaklay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u5c4f\u5e55\u8bbe\u5907\u4ece\u4f60\u7684\u5367\u5ba4\u4e2d\u79fb\u9664\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u628a\u87a2\u5e55\u5f9e\u81e5\u5ba4\u79fb\u8d70\u3002"
          }
        }
      }
    },
    "progression_selfcare_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue kleine Wohlf\u00fchl-Rituale in deinen Tag ein (z.B. Lesen, entspannende Musik)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build small wellness rituals into your day (e.g. reading, relaxing music)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora peque\u00f1os rituales de bienestar en tu d\u00eda (ej. leer, m\u00fasica relajante)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Int\u00e8gre de petits rituels de bien-\u00eatre dans ta journ\u00e9e (ex. lecture, musique relaxante)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0926\u093f\u0928 \u092e\u0947\u0902 \u091b\u094b\u091f\u0947-\u091b\u094b\u091f\u0947 \u0938\u0941\u0916\u0926 \u0930\u0940\u0924\u093f\u092f\u094b\u0902 \u0915\u094b \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u092a\u0922\u093c\u0928\u093e, \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915 \u0938\u0902\u0917\u0940\u0924)\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci piccoli rituali di benessere nella tua giornata (es. leggere, musica rilassante)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u65e5\u306e\u4e2d\u306b\u5c0f\u3055\u306a\u5065\u5eb7\u7fd2\u6163\u3092\u7d44\u307f\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\uff08\u8aad\u66f8\u3001\u30ea\u30e9\u30c3\u30af\u30b9\u3067\u304d\u308b\u97f3\u697d\u306a\u3069\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3c5\uc11c, \ud3b8\uc548\ud55c \uc74c\uc545 \ub4f1 \uc791\uc740 \uac74\uac15 \uc758\uc2dd\uc744 \ud558\ub8e8\uc5d0 \uc2e4\ucc9c\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw kleine wellnessrituelen in uw dag (bijvoorbeeld lezen, ontspannende muziek)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbuduj w sw\u00f3j dzie\u0144 drobne rytua\u0142y wellness (np. czytanie, relaksuj\u0105ca muzyka)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora pequenos rituais de bem-estar no teu dia (ex. ler, m\u00fasica relaxante)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043a\u043b\u044e\u0447\u0430\u0439 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0440\u0438\u0442\u0443\u0430\u043b\u044b \u0434\u043b\u044f \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044f \u0432 \u0441\u0432\u043e\u0439 \u0434\u0435\u043d\u044c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0447\u0442\u0435\u043d\u0438\u0435, \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u044f\u044e\u0449\u0430\u044f \u043c\u0443\u0437\u044b\u043a\u0430)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcn\u00fcn\u00fcze k\u00fc\u00e7\u00fck sa\u011fl\u0131kl\u0131 ya\u015fam rit\u00fcelleri ekleyin (\u00f6r. kitap okumak, rahatlat\u0131c\u0131 m\u00fczik)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684\u65e5\u5e38\u751f\u6d3b\u4e2d\u52a0\u5165\u4e00\u4e9b\u5c0f\u5c0f\u7684\u653e\u677e\u4eea\u5f0f\uff08\u4f8b\u5982\u9605\u8bfb\u3001\u542c\u653e\u677e\u7684\u97f3\u4e50\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684\u4e00\u5929\u4e2d\u5efa\u7acb\u4e00\u4e9b\u8b93\u4f60\u611f\u89ba\u826f\u597d\u7684\u5c0f\u7fd2\u6163\uff08\u4f8b\u5982\u95b1\u8b80\u3001\u653e\u9b06\u7684\u97f3\u6a02\uff09\u3002"
          }
        }
      }
    },
    "progression_selfcare_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir t\u00e4glich bewusst 10 Minuten Zeit nur f\u00fcr dich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take 10 minutes consciously just for yourself every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3mate 10 minutos conscientemente solo para ti todos los d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends 10 minutes consciemment juste pour toi tous les jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0926\u093f\u0928 \u0915\u0947\u0935\u0932 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u091c\u093e\u0917\u0930\u0942\u0915 \u0930\u0942\u092a \u0938\u0947 10 \u092e\u093f\u0928\u091f \u0915\u093e \u0938\u092e\u092f \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi 10 minuti consapevolmente solo per te ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u610f\u8b58\u7684\u306b\u81ea\u5206\u306e\u305f\u3081\u3060\u3051\u306b10\u5206\u9593\u6642\u9593\u3092\u3068\u3063\u3066\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \uc790\uc2e0\uc744 \uc704\ud574 \uc758\uc2dd\uc801\uc73c\ub85c 10\ubd84\uc744 \ud22c\uc790\ud574\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem elke dag bewust 10 minuten alleen voor jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cdego dnia po\u015bwi\u0119\u0107 10 minut \u015bwiadomie tylko dla siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira 10 minutos conscientemente s\u00f3 para ti todos os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u0441\u0435\u0431\u0435 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e 10 \u043c\u0438\u043d\u0443\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0441\u0435\u0431\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her g\u00fcn bilin\u00e7li olarak kendinize 10 dakika ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u6709\u610f\u8bc6\u5730\u62bd\u51fa10\u5206\u949f\u53ea\u5c5e\u4e8e\u4f60\u81ea\u5df1\u7684\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u610f\u8b58\u5730\u6bcf\u5929\u82b1 10 \u5206\u9418\u7684\u6642\u9593\u70ba\u81ea\u5df1\u670d\u52d9\u3002"
          }
        }
      }
    },
    "progression_selfcare_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein Meister der Selfcare. Behalte deine gesunden Routinen bei!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a master of self-care. Maintain your healthy routines!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un maestro del autocuidado. \u00a1Mant\u00e9n tus rutinas saludables!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un ma\u00eetre des soins personnels. Maintiens tes routines saines !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u0906\u0924\u094d\u092e-\u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0947 \u092e\u093e\u0938\u094d\u091f\u0930 \u0939\u094b\u0964 \u0905\u092a\u0928\u0940 \u0938\u094d\u0935\u0938\u094d\u0925 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u092c\u0928\u093e\u090f \u0930\u0916\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un maestro della cura di te stesso. Mantieni le tue routine sane!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u30bb\u30eb\u30d5\u30b1\u30a2\u306e\u9054\u4eba\u3067\u3059\u3002\u5065\u5eb7\u7684\u306a\u751f\u6d3b\u7fd2\u6163\u3092\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc790\uae30\uad00\ub9ac\uc758 \ub2ec\uc778\uc785\ub2c8\ub2e4. \uac74\uac15\ud55c \uc77c\uc0c1\uc744 \uc720\uc9c0\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een meester in zelfzorg. Onderhoud uw gezonde routines!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b mistrzyni\u0105 dbania o siebie. Utrzymuj swoje zdrowe nawyki!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9s um mestre do autocuidado. Mant\u00e9m as tuas rotinas saud\u00e1veis!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043c\u0430\u0441\u0442\u0435\u0440 \u0437\u0430\u0431\u043e\u0442\u044b \u043e \u0441\u0435\u0431\u0435. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0439 \u0441\u0432\u043e\u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen ki\u015fisel bak\u0131m\u0131n ustas\u0131s\u0131n. Sa\u011fl\u0131kl\u0131 rutinlerinizi koruyun!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u662f\u4e00\u4f4d\u81ea\u6211\u5173\u6000\u5927\u5e08\u3002\u4fdd\u6301\u4f60\u7684\u5065\u5eb7\u4e60\u60ef\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u662f\u81ea\u6211\u4fdd\u5065\u7684\u5927\u5e2b\u3002\u4fdd\u6301\u5065\u5eb7\u7684\u4f5c\u606f\u7fd2\u6163\uff01"
          }
        }
      }
    },
    "progression_selfcare_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f6nn dir eine t\u00e4gliche 30-min\u00fctige Auszeit komplett ohne Bildschirme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treat yourself to a daily 30-minute break completely without screens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reg\u00e1late un descanso diario de 30 minutos completamente sin pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre-toi une pause quotidienne de 30 minutes compl\u00e8tement sans \u00e9crans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0941\u0926 \u0915\u094b \u0930\u094b\u091c\u093c\u093e\u0928\u093e 30 \u092e\u093f\u0928\u091f \u0915\u093e \u0910\u0938\u093e \u0938\u092e\u092f \u0926\u0947\u0902 \u091c\u093f\u0938\u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concediti una pausa quotidiana di 30 minuti completamente senza schermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u3001\u30b9\u30af\u30ea\u30fc\u30f3\u306e\u306a\u3044 30 \u5206\u9593\u306e\u4f11\u61a9\u3092\u3068\u308a\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud654\uba74 \uc5c6\uc774 \ub9e4\uc77c 30\ubd84\uac04 \ud734\uc2dd\uc744 \ucde8\ud574\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakteer uzelf op een dagelijkse pauze van 30 minuten, geheel zonder schermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaruj sobie codzienn\u0105 30-minutow\u0105 przerw\u0119 ca\u0142kowicie bez ekran\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mima-te com uma pausa di\u00e1ria de 30 minutos completamente sem ecr\u00e3s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0437\u0432\u043e\u043b\u044c \u0441\u0435\u0431\u0435 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0439 30-\u043c\u0438\u043d\u0443\u0442\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0440\u044b\u0432 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0431\u0435\u0437 \u044d\u043a\u0440\u0430\u043d\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinize tamamen ekrans\u0131z, g\u00fcnl\u00fck 30 dakikal\u0131k bir mola verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u7ed9\u81ea\u5df130\u5206\u949f\u5b8c\u5168\u4e0d\u770b\u5c4f\u5e55\u7684\u4f11\u606f\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u7d66\u81ea\u5df1 30 \u5206\u9418\u7684\u4f11\u606f\u6642\u9593\uff0c\u4e0d\u8981\u770b\u4efb\u4f55\u96fb\u5b50\u7522\u54c1\u3002"
          }
        }
      }
    },
    "progression_sleep_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge f\u00fcr mindestens 7-8 Stunden ungest\u00f6rten Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure at least 7-8 hours of undisturbed sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseg\u00farate de tener al menos 7-8 horas de sue\u00f1o ininterrumpido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assure-toi d'avoir au moins 7-8 heures de sommeil ininterrompu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092e \u0938\u0947 \u0915\u092e 7-8 \u0918\u0902\u091f\u0947 \u0915\u0940 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u0918\u094d\u0928 \u0915\u0947 \u0928\u0940\u0902\u0926 \u0915\u093e \u0927\u094d\u092f\u093e\u0928 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati almeno 7-8 ore di sonno indisturbato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c11\u306a\u304f\u3068\u3082 7 \uff5e 8 \u6642\u9593\u306f\u59a8\u3052\u3089\u308c\u306a\u3044\u7761\u7720\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc801\uc5b4\ub3c4 7~8\uc2dc\uac04\uc740 \ubc29\ud574\ubc1b\uc9c0 \uc54a\uace0 \uc7a0\uc744 \uc790\ub3c4\ub85d \ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg voor minimaal 7-8 uur ongestoorde slaap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj o co najmniej 7-8 godzin niezak\u0142\u00f3conego snu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegura pelo menos 7-8 horas de sono ininterrupto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u044c \u0441\u0435\u0431\u0435 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 7-8 \u0447\u0430\u0441\u043e\u0432 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0433\u043e \u0441\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 7-8 saat kesintisiz uyku sa\u011flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u786e\u4fdd\u81f3\u5c117-8\u5c0f\u65f6\u4e0d\u53d7\u6253\u6270\u7684\u7761\u7720\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7372\u5f97\u81f3\u5c11 7-8 \u5c0f\u6642\u4e0d\u53d7\u5e72\u64fe\u7684\u7761\u7720\u3002"
          }
        }
      }
    },
    "progression_sleep_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe heute 15 Minuten fr\u00fcher ins Bett als sonst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to bed 15 minutes earlier than usual today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a la cama 15 minutos antes de lo habitual hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va au lit 15 minutes plus t\u00f4t que d'habitude aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u0947 15 \u092e\u093f\u0928\u091f \u092a\u0939\u0932\u0947 \u0938\u094b\u0928\u0947 \u091c\u093e\u0913\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a letto 15 minuti prima del solito oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u3044\u3064\u3082\u3088\u308a15\u5206\u65e9\u304f\u5bdd\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \ud3c9\uc18c\ubcf4\ub2e4 15\ubd84 \uc77c\ucc0d \uc7a0\uc790\ub9ac\uc5d0 \ub4dc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga vandaag 15 minuten eerder naar bed dan normaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj id\u017a spa\u0107 15 minut wcze\u015bniej ni\u017c zwykle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai para a cama 15 minutos mais cedo do que o habitual hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u043e\u0436\u0438\u0441\u044c \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0441\u043f\u0430\u0442\u044c \u043d\u0430 15 \u043c\u0438\u043d\u0443\u0442 \u0440\u0430\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u043e\u0431\u044b\u0447\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn her zamankinden 15 dakika erken yat\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u6bd4\u5e73\u65f6\u65e915\u5206\u949f\u4e0a\u5e8a\u7761\u89c9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u6bd4\u5e73\u5e38\u65e915\u5206\u9418\u7761\u89ba\u3002"
          }
        }
      }
    },
    "progression_sleep_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekte Schlafroutine. Dein K\u00f6rper dankt dir diese Energie!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect sleep routine. Your body thanks you for this energy!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutina de sue\u00f1o perfecta. \u00a1Tu cuerpo te agradece esta energ\u00eda!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine de sommeil parfaite. Ton corps te remercie pour cette \u00e9nergie !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0928\u0940\u0902\u0926 \u0915\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e\u0964 \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0907\u0938 \u090a\u0930\u094d\u091c\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0915\u0930\u0924\u093e \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine del sonno perfetta. Il tuo corpo ti ringrazia per questa energia!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u74a7\u306a\u7761\u7720\u30eb\u30fc\u30c1\u30f3\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u3053\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u306b\u611f\u8b1d\u3057\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc644\ubcbd\ud55c \uc218\uba74 \ub8e8\ud2f4. \ub2f9\uc2e0\uc758 \ubab8\uc740 \uc774 \uc5d0\ub108\uc9c0\uc5d0 \uac10\uc0ac\ub4dc\ub9bd\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfecte slaaproutine. Je lichaam bedankt je voor deze energie!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idealna rutyna snu. Twoje cia\u0142o dzi\u0119kuje Ci za t\u0119 energi\u0119!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotina de sono perfeita. O teu corpo agradece-te esta energia!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0441\u043d\u0430. \u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442 \u0442\u0435\u0431\u044f \u0437\u0430 \u044d\u0442\u0443 \u044d\u043d\u0435\u0440\u0433\u0438\u044e!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00fckemmel uyku rutini. V\u00fccudunuz bu enerji i\u00e7in size te\u015fekk\u00fcr ediyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u7f8e\u7684\u7761\u7720\u4e60\u60ef\u3002\u4f60\u7684\u8eab\u4f53\u4f1a\u611f\u8c22\u4f60\u5e26\u6765\u7684\u8fd9\u4efd\u80fd\u91cf\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u7f8e\u7684\u7761\u7720\u7fd2\u6163\u3002\u60a8\u7684\u8eab\u9ad4\u611f\u8b1d\u60a8\u63d0\u4f9b\u7684\u9019\u7a2e\u80fd\u91cf\uff01"
          }
        }
      }
    },
    "progression_sleep_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dich an feste Schlafenszeiten, auch am Wochenende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick to fixed bedtimes, even on weekends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumple horarios fijos para dormir, incluso los fines de semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respecte des heures de coucher fixes, m\u00eame le week-end."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092a\u094d\u0924\u093e\u0939\u093e\u0928\u094d\u0924 \u092a\u0930 \u092d\u0940, \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0938\u094b\u0928\u0947 \u0915\u0947 \u0938\u092e\u092f \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispetta orari fissi per andare a dormire, anche nei fine settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305f\u3068\u3048\u9031\u672b\u3067\u3042\u3063\u3066\u3082\u3001\u5c31\u5bdd\u6642\u9593\u306f\u56fa\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\ub9d0\uc5d0\ub3c4 \uc815\ud574\uc9c4 \ucde8\uce68 \uc2dc\uac04\uc744 \uc9c0\ud0a4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd u aan vaste bedtijden, ook in het weekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj si\u0119 sta\u0142ych godzin snu, nawet w weekendy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpre hor\u00e1rios fixos para dormir, mesmo aos fins de semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0441\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u043d\u0430, \u0434\u0430\u0436\u0435 \u0432 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonlar\u0131 bile sabit uyku saatlerine sad\u0131k kal\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u56fa\u5b9a\u7684\u7761\u7720\u65f6\u95f4\uff0c\u5373\u4f7f\u5728\u5468\u672b\u4e5f\u662f\u5982\u6b64\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5805\u6301\u898f\u5f8b\u7684\u5c31\u5be2\u6642\u9593\uff0c\u5373\u4f7f\u662f\u9031\u672b\u4e5f\u662f\u5982\u6b64\u3002"
          }
        }
      }
    },
    "progression_teeth_aufbau": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze zus\u00e4tzlich einmal t\u00e4glich Zahnseide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additionally use dental floss once a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa adem\u00e1s hilo dental una vez al d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise en plus du fil dentaire une fois par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0926\u093f\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930 \u092b\u094d\u0932\u0949\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa inoltre il filo interdentale una volta al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3055\u3089\u306b\u30c7\u30f3\u30bf\u30eb\u30d5\u30ed\u30b9\u30921\u65e51\u56de\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub610\ud55c \ud558\ub8e8\uc5d0 \ud55c \ubc88 \uce58\uc2e4\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik daarnaast \u00e9\u00e9n keer per dag tandzijde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowo raz dziennie u\u017cywaj nici dentystycznej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa adicionalmente fio dent\u00e1rio uma vez por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0437\u0443\u0431\u043d\u0443\u044e \u043d\u0438\u0442\u044c \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayr\u0131ca g\u00fcnde bir kez di\u015f ipi kullan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u989d\u5916\u4f7f\u7528\u4e00\u6b21\u7259\u7ebf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5916\uff0c\u6bcf\u5929\u4f7f\u7528\u7259\u7dda\u4e00\u6b21\u3002"
          }
        }
      }
    },
    "progression_teeth_einstieg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Putze deine Z\u00e4hne 2x t\u00e4glich f\u00fcr 2 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brush your teeth twice a day for 2 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cep\u00edllate los dientes 2 veces al d\u00eda durante 2 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brosse-toi les dents 2 fois par jour pendant 2 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0926\u093e\u0902\u0924 \u0926\u093f\u0928 \u092e\u0947\u0902 2 \u092c\u093e\u0930 2 \u092e\u093f\u0928\u091f \u0915\u0947 \u0932\u093f\u090f \u092c\u094d\u0930\u0936 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavati i denti 2 volte al giorno per 2 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u65e52\u56de\u30012\u5206\u9593\u6b6f\u3092\u78e8\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud558\ub8e8\uc5d0 2\ubc88, 2\ubd84 \ub3d9\uc548 \uc774\ub97c \ub2e6\uc73c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poets je tanden twee keer per dag gedurende 2 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Myj z\u0119by dwa razy dziennie przez 2 minuty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escova os dentes 2 vezes por dia durante 2 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0438\u0441\u0442\u0438 \u0437\u0443\u0431\u044b \u0434\u0432\u0430\u0436\u0434\u044b \u0432 \u0434\u0435\u043d\u044c \u043f\u043e \u0434\u0432\u0435 \u043c\u0438\u043d\u0443\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Di\u015flerinizi g\u00fcnde iki kez 2 dakika boyunca f\u0131r\u00e7alay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u5237\u72592\u6b21\uff0c\u6bcf\u6b212\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u5237\u7259\u5169\u6b21\uff0c\u6bcf\u6b21 2 \u5206\u9418\u3002"
          }
        }
      }
    },
    "progression_teeth_meisterschaft": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekte Dentalhygiene. Behalte diese starke Routine bei!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect dental hygiene. Keep up this strong routine!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Higiene dental perfecta. \u00a1Mant\u00e9n esta fuerte rutina!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hygi\u00e8ne dentaire parfaite. Maintiens cette solide routine !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0921\u0947\u0902\u091f\u0932 \u0939\u093e\u0907\u091c\u0940\u0928\u0964 \u0907\u0938 \u092e\u091c\u092c\u0942\u0924 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u0915\u094b \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Igiene dentale perfetta. Mantieni questa forte routine!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u74a7\u306a\u6b6f\u306e\u885b\u751f\u72b6\u614b\u3002\u3053\u306e\u5f37\u529b\u306a\u30eb\u30fc\u30c1\u30f3\u3092\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc644\ubcbd\ud55c \uce58\uc544 \uc704\uc0dd. \uc774 \uac15\ub825\ud55c \ub8e8\ud2f4\uc744 \uacc4\uc18d \uc720\uc9c0\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfecte mondhygi\u00ebne. Houd deze sterke routine vol!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doskona\u0142a higiena z\u0119b\u00f3w. Kontynuuj t\u0119 siln\u0105 rutyn\u0119!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Higiene dent\u00e1ria perfeita. Mant\u00e9m esta forte rotina!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0434\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0438\u0433\u0438\u0435\u043d\u0430 \u043f\u043e\u043b\u043e\u0441\u0442\u0438 \u0440\u0442\u0430. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0439 \u044d\u0442\u0443 \u0441\u0438\u043b\u044c\u043d\u0443\u044e \u0440\u0443\u0442\u0438\u043d\u0443!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00fckemmel di\u015f hijyeni. Bu g\u00fc\u00e7l\u00fc rutini s\u00fcrd\u00fcr\u00fcn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u7f8e\u7684\u53e3\u8154\u536b\u751f\u3002\u4fdd\u6301\u8fd9\u4e2a\u597d\u4e60\u60ef\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u7f8e\u7684\u7259\u9f52\u885b\u751f\u3002\u7e7c\u7e8c\u4fdd\u6301\u9019\u500b\u5f37\u800c\u6709\u529b\u7684\u7fd2\u6163\uff01"
          }
        }
      }
    },
    "progression_teeth_vertiefung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende nun Zahnseide und Mundsp\u00fclung nach dem Putzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now use dental floss and mouthwash after brushing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora usa hilo dental y enjuague bucal despu\u00e9s de cepillarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise maintenant du fil dentaire et un bain de bouche apr\u00e8s le brossage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092c \u092c\u094d\u0930\u0936 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092b\u094d\u0932\u0949\u0938 \u0914\u0930 \u092e\u093e\u0909\u0925\u0935\u0949\u0936 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora usa filo interdentale e collutorio dopo aver lavato i denti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b6f\u78e8\u304d\u5f8c\u306f\u30c7\u30f3\u30bf\u30eb\u30d5\u30ed\u30b9\u3068\u30de\u30a6\u30b9\u30a6\u30a9\u30c3\u30b7\u30e5\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\uc81c \uc591\uce58 \ud6c4 \uce58\uc2e4\uacfc \uad6c\uac15 \uccad\uacb0\uc81c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik nu tandzijde en mondwater na het poetsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz po szczotkowaniu u\u017cyj nici dentystycznej i p\u0142ynu do p\u0142ukania jamy ustnej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora usa fio dent\u00e1rio e colut\u00f3rio ap\u00f3s a escovagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043f\u0435\u0440\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0437\u0443\u0431\u043d\u0443\u044e \u043d\u0438\u0442\u044c \u0438 \u043e\u043f\u043e\u043b\u0430\u0441\u043a\u0438\u0432\u0430\u0442\u0435\u043b\u044c \u0434\u043b\u044f \u0440\u0442\u0430 \u043f\u043e\u0441\u043b\u0435 \u0447\u0438\u0441\u0442\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art\u0131k di\u015flerinizi f\u0131r\u00e7alad\u0131ktan sonra di\u015f ipi ve gargara kullan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73b0\u5728\u5237\u7259\u540e\u4f7f\u7528\u7259\u7ebf\u548c\u6f31\u53e3\u6c34\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u5237\u7259\u5f8c\u4f7f\u7528\u7259\u7dda\u548c\u6f31\u53e3\u6c34\u3002"
          }
        }
      }
    },

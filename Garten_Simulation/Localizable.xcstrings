    "dopamine_story_prob_sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Social Media liefert schnelle, unerwartete Belohnungen. Das Gehirn will immer mehr, der echte Fokus sinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social media delivers quick, unexpected rewards. The brain wants more, and true focus drops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las redes sociales dan recompensas rápidas. El cerebro quiere más y el enfoque cae."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réseaux sociaux offrent des récompenses rapides. Le cerveau en veut toujours plus, et la concentration baisse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोशल मीडिया त्वरित इनाम देता है। दिमाग और अधिक चाहता है, और असली ध्यान कम हो जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I social media offrono ricompense rapide. Il cervello ne vuole di più, e la concentrazione cala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SNSは手軽な報酬を与えます。脳はもっと欲しがり、集中力は低下します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소셜 미디어는 빠르고 예기치 않은 보상을 제공합니다. 뇌는 더 원하고 집중력은 떨어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Social media geeft snelle beloningen. Je brein wil meer, en je focus daalt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соцсети дают быстрые награды. Мозг хочет больше, и концентрация падает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosyal medya hızlı ödüller sunar. Beyin daha fazlasını ister ve odaklanma düşer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社交媒体提供快速奖励。大脑想要更多，而真正的专注力下降。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "社交媒體提供快速獎勵。大腦想要更多，而真正的專注力下降。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Social Media liefert schnelle, unerwartete Belohnungen. Das Gehirn will immer mehr, der echte Fokus sinkt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Social Media liefert schnelle, unerwartete Belohnungen. Das Gehirn will immer mehr, der echte Fokus sinkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Social Media liefert schnelle, unerwartete Belohnungen. Das Gehirn will immer mehr, der echte Fokus sinkt."
          }
        }
      }
    },

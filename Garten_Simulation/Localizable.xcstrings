    "lucky_wheel_locked_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gie\u00df zuerst deine Pflanzen, um das Gl\u00fccksrad freizuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants first to unlock the lucky wheel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tus plantas primero para desbloquear la ruleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrose d'abord tes plantes pour d\u00e9bloquer la roue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092d\u093e\u0917\u094d\u092f \u0915\u0947 \u091a\u0915\u094d\u0930 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u092a\u093e\u0928\u0940 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annaffia prima le piante per sbloccare la ruota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e9\u30c3\u30ad\u30fc\u30db\u30a4\u30fc\u30eb\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u690d\u7269\u306b\u6c34\u3092\u3042\u3052\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud589\uc6b4\uc758 \ubc14\ud034\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \uba3c\uc800 \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je planten eerst water om het gelukswiel te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw podlej ro\u015bliny, aby odblokowa\u0107 szcz\u0119\u015bliwe ko\u0142o."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega as plantas primeiro para desbloquear a roda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u043b\u0435\u0439 \u0441\u0432\u043e\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043b\u0435\u0441\u043e \u0443\u0434\u0430\u0447\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eansl\u0131 \u00e7ark\u0131n kilidini a\u00e7mak i\u00e7in \u00f6nce bitkilerinizi sulay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u7ed9\u4f60\u7684\u690d\u7269\u6d47\u6c34\uff0c\u4ee5\u89e3\u9501\u5e78\u8fd0\u8f6e\u76d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9996\u5148\u7d66\u4f60\u7684\u690d\u7269\u6f86\u6c34\u4ee5\u89e3\u9396\u547d\u904b\u4e4b\u8f2a\u3002"
          }
        }
      }
    },

    "assessment.fitness.q1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wecker klingelt um 5:30 Uhr f\u00fcr das geplante Workout. Es ist drau\u00dfen eiskalt, dunkel und regnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your alarm goes off at 5:30 a.m. for your planned workout. It's freezing cold, dark and raining outside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su alarma suena a las 5:30 a. m. para su entrenamiento planificado. Afuera hace mucho fr\u00edo, est\u00e1 oscuro y llueve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre alarme sonne \u00e0 5h30 pour votre entra\u00eenement pr\u00e9vu. Il fait un froid glacial, il fait sombre et il pleut dehors."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u0928\u093f\u092f\u094b\u091c\u093f\u0924 \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u0941\u092c\u0939 5:30 \u092c\u091c\u0947 \u092c\u091c \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u093e\u0939\u0930 \u091c\u092e\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u0920\u0902\u0921, \u0905\u0902\u0927\u0947\u0930\u093e \u0914\u0930 \u092c\u093e\u0930\u093f\u0936 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sveglia suona alle 5:30 per l'allenamento pianificato. Fuori fa un freddo gelido, \u00e8 buio e piove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a08\u753b\u3057\u305f\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u306e\u305f\u3081\u306b\u3001\u5348\u524d 5 \u6642 30 \u5206\u306b\u30a2\u30e9\u30fc\u30e0\u304c\u9cf4\u308a\u307e\u3059\u3002\u5916\u306f\u51cd\u3048\u308b\u307b\u3069\u5bd2\u304f\u3001\u6697\u304f\u3001\u96e8\u304c\u964d\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacc4\ud68d\ub41c \uc6b4\ub3d9\uc744 \uc704\ud574 \uc624\uc804 5\uc2dc 30\ubd84\uc5d0 \uc54c\ub78c\uc774 \uc6b8\ub9bd\ub2c8\ub2e4. \ubc16\uc5d0\ub294 \ucda5\uace0 \uc5b4\ub461\uace0 \ube44\uac00 \ub0b4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wekker gaat om 05.30 uur af voor je geplande training. Buiten is het ijskoud, donker en regent het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j budzik w\u0142\u0105czy si\u0119 o 5:30 w zwi\u0105zku z zaplanowanym treningiem. Na zewn\u0105trz jest przera\u017aliwie zimno, ciemno i pada deszcz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu alarme dispara \u00e0s 5h30 para o treino planejado. Est\u00e1 muito frio, escuro e chovendo l\u00e1 fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u0431\u0443\u0434\u0438\u043b\u044c\u043d\u0438\u043a \u0437\u0432\u043e\u043d\u0438\u0442 \u0432 5:30 \u0443\u0442\u0440\u0430 \u0434\u043b\u044f \u0437\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438. \u041d\u0430 \u0443\u043b\u0438\u0446\u0435 \u043b\u0435\u0434\u044f\u043d\u043e\u0439 \u0445\u043e\u043b\u043e\u0434, \u0442\u0435\u043c\u043d\u043e \u0438 \u0438\u0434\u0435\u0442 \u0434\u043e\u0436\u0434\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlad\u0131\u011f\u0131n\u0131z antrenman i\u00e7in alarm\u0131n\u0131z sabah 5:30'da \u00e7al\u0131yor. D\u0131\u015far\u0131s\u0131 dondurucu so\u011fuk, karanl\u0131k ve ya\u011fmur ya\u011f\u0131yor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u95f9\u949f\u57285:30\u54cd\u8d77\uff0c\u4e3a\u8ba1\u5212\u7684\u953b\u70bc\u65f6\u95f4\u505a\u51c6\u5907\u3002\u5916\u9762\u5bd2\u51b7\u523a\u9aa8\u3001\u9ed1\u6697\u5e76\u4e0b\u7740\u96e8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u9b27\u9418\u6703\u5728\u51cc\u6668 5:30 \u97ff\u8d77\uff0c\u9032\u884c\u60a8\u8a08\u5283\u7684\u935b\u934a\u3002\u5916\u9762\u4e0b\u8457\u96e8\uff0c\u5929\u6c23\u5bd2\u51b7\u3001\u9ed1\u6697\u3002"
          }
        }
      }
    },
    "assessment.fitness.q1.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich dr\u00fccke auf Snooze. Schlaf ist schlie\u00dflich auch wichtig f\u00fcr die Regeneration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I hit snooze. After all, sleep is also important for regeneration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presion\u00e9 el bot\u00f3n de repetici\u00f3n. Al fin y al cabo, el sue\u00f1o tambi\u00e9n es importante para la regeneraci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai appuy\u00e9 sur snooze. Apr\u00e8s tout, le sommeil est \u00e9galement important pour la r\u00e9g\u00e9n\u00e9ration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902\u0928\u0947 \u091d\u092a\u0915\u0940 \u092e\u093e\u0930 \u0926\u0940\u0964 \u0906\u0916\u093c\u093f\u0930\u0915\u093e\u0930, \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u0902\u0926 \u092d\u0940 \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho premuto il tasto snooze. Dopotutto, anche il sonno \u00e8 importante per la rigenerazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5c45\u7720\u308a\u3092\u3057\u307e\u3057\u305f\u3002\u7d50\u5c40\u306e\u3068\u3053\u308d\u3001\u7761\u7720\u306f\u518d\u751f\u306b\u3082\u91cd\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub2e4\uc2dc \uc54c\ub9bc\uc744 \ub20c\ub800\ub2e4. \uacb0\uad6d \uc7ac\uc0dd\uc5d0\ub294 \uc218\uba74\ub3c4 \uc911\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik drukte op snooze. Slaap is immers ook belangrijk voor regeneratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142\u0105czy\u0142em drzemk\u0119. W ko\u0144cu sen jest r\u00f3wnie\u017c wa\u017cny dla regeneracji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apertei a soneca. Afinal, o sono tamb\u00e9m \u00e9 importante para a regenera\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0430\u0436\u0438\u043c\u0430\u044e \u043d\u0430 \u043e\u0442\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u0441\u0438\u0433\u043d\u0430\u043b \u0431\u0443\u0434\u0438\u043b\u044c\u043d\u0438\u043a\u0430. \u0421\u043e\u043d, \u0432 \u043a\u043e\u043d\u0446\u0435 \u043a\u043e\u043d\u0446\u043e\u0432, \u0442\u0430\u043a\u0436\u0435 \u0432\u0430\u0436\u0435\u043d \u0434\u043b\u044f \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ertele tu\u015funa bast\u0131m. Sonu\u00e7ta uyku yenilenme i\u00e7in de \u00f6nemlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6309\u4e0b\u8d2a\u7761\u952e\u3002\u6bd5\u7adf\u7761\u7720\u5bf9\u6062\u590d\u4e5f\u5f88\u91cd\u8981\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6253\u778c\u7761\u3002\u7562\u7adf\uff0c\u7761\u7720\u5c0d\u65bc\u518d\u751f\u4e5f\u5f88\u91cd\u8981\u3002"
          }
        }
      }
    },
    "assessment.fitness.q1.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe liegen und nehme mir fest vor, das Workout heute Abend nachzuholen (was ich dann nicht tue)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I stay in bed and make up my mind to catch up on the workout this evening (which I don't do)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me quedo en la cama y decido ponerme al d\u00eda con el ejercicio de esta noche (cosa que no hago)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reste au lit et d\u00e9cide de rattraper mon retard sur l'entra\u00eenement de ce soir (ce que je ne fais pas)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u0930\u0939\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0906\u091c \u0936\u093e\u092e \u0915\u094b \u0915\u0938\u0930\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u092e\u0928 \u092c\u0928\u093e\u0924\u093e \u0939\u0942\u0902 (\u091c\u094b \u092e\u0948\u0902 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e)\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resto a letto e decido di recuperare l'allenamento stasera (cosa che non faccio)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u30d9\u30c3\u30c9\u306b\u3044\u3066\u3001\u4eca\u591c\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u8ffd\u3044\u3064\u304f\u3053\u3068\u3092\u6c7a\u5fc3\u3057\u307e\u3059\uff08\u5b9f\u969b\u306b\u306f\u3057\u307e\u305b\u3093\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uce68\ub300\uc5d0 \ub204\uc6cc\uc11c \uc624\ub298 \uc800\ub141\uc5d0 \uc6b4\ub3d9\uc744 \ub530\ub77c\uc7a1\uae30\ub85c \ub9c8\uc74c\uba39\uc5c8\ub2e4(\ub098\ub294 \uadf8\ub807\uac8c \ud558\uc9c0 \uc54a\ub294\ub2e4)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf in bed liggen en neem me voor om vanavond de training in te halen (wat ik niet doe)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Le\u017c\u0119 w \u0142\u00f3\u017cku i postanawiam nadrobi\u0107 zaleg\u0142o\u015bci w treningu dzisiejszego wieczoru (czego nie robi\u0119)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu fico na cama e decido colocar o treino em dia esta noite (o que n\u00e3o fa\u00e7o)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0441\u0442\u0430\u044e\u0441\u044c \u043b\u0435\u0436\u0430\u0442\u044c \u0438 \u0442\u0432\u0435\u0440\u0434\u043e \u043d\u0430\u043c\u0435\u0440\u0435\u0432\u0430\u044e\u0441\u044c \u043d\u0430\u0432\u0435\u0440\u0441\u0442\u0430\u0442\u044c \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0432\u0435\u0447\u0435\u0440\u043e\u043c (\u0447\u0435\u0433\u043e \u044f \u043f\u043e\u0442\u043e\u043c \u043d\u0435 \u0434\u0435\u043b\u0430\u044e)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatakta kal\u0131yorum ve bu ak\u015famki antrenmana yeti\u015fmeye karar veriyorum (ki bunu yapm\u0131yorum)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8eba\u4e0b\uff0c\u5e76\u4e14\u4e0b\u5b9a\u51b3\u5fc3\u4eca\u665a\u8981\u8865\u505a\u953b\u70bc\uff08\u4f46\u6211\u6700\u7ec8\u6ca1\u6709\u505a\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8eba\u5728\u5e8a\u4e0a\uff0c\u4e0b\u5b9a\u6c7a\u5fc3\u8981\u8d95\u4e0a\u4eca\u665a\u7684\u904b\u52d5\uff08\u6211\u6c92\u6709\u9019\u6a23\u505a\uff09\u3002"
          }
        }
      }
    },
    "assessment.fitness.q1.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stehe auf, mache aber nur ein kurzes, halbes Workout zu Hause im Warmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get up, but only do a short, half-workout at home in the warmth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me levanto, pero solo hago un breve medio entrenamiento en casa, al calor del calor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me l\u00e8ve, mais je ne fais qu'un court demi-entra\u00eenement \u00e0 la maison, au chaud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0909\u0920\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0918\u0930 \u092a\u0930 \u0917\u0930\u094d\u092e\u0940 \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u090f\u0915 \u091b\u094b\u091f\u0940, \u0906\u0927\u0940 \u0915\u0938\u0930\u0924 \u0939\u0940 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alzo, ma faccio solo un breve allenamento a casa al caldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u8d77\u304d\u307e\u3059\u304c\u3001\u6696\u304b\u3044\u5bb6\u306e\u4e2d\u3067\u77ed\u6642\u9593\u306e\u534a\u5206\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u3059\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc77c\uc5b4\ub098\uc9c0\ub9cc \ub530\ub73b\ud55c \uc9d1\uc5d0\uc11c \uc9e7\uc740 \ubc18\ub9cc \uc6b4\ub3d9\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sta op, maar doe thuis alleen een korte, halve training in de warmte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstaj\u0119, ale robi\u0119 tylko kr\u00f3tki, p\u00f3\u0142treningowy trening w domu, w upale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me levanto, mas s\u00f3 fa\u00e7o um pequeno treino em casa, no calor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u0441\u0442\u0430\u044e, \u043d\u043e \u0434\u0435\u043b\u0430\u044e \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e, \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0447\u0430\u0442\u0443\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u0434\u043e\u043c\u0430, \u0432 \u0442\u0435\u043f\u043b\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalk\u0131yorum ama evde s\u0131cakta sadece k\u0131sa, yar\u0131m egzersiz yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8d77\u5e8a\u4e86\uff0c\u4f46\u53ea\u5728\u5bb6\u91cc\u6e29\u6696\u7684\u5730\u65b9\u505a\u4e00\u4e2a\u7b80\u77ed\u7684\u534a\u8eab\u953b\u70bc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8d77\u5e8a\uff0c\u4f46\u53ea\u5728\u6eab\u6696\u7684\u5bb6\u4e2d\u9032\u884c\u4e86\u77ed\u66ab\u7684\u534a\u904b\u52d5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q1.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fluche, stehe auf, friere und ziehe das geplante Workout zu 100\uff05 durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I curse, get up, freeze and do the planned workout 100\uff05."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maldigo, me levanto, me congelo y hago el entrenamiento planificado al 100\uff05."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je maudis, je me l\u00e8ve, je me fige et je fais l'entra\u00eenement pr\u00e9vu \u00e0 100 \uff05."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0936\u093e\u092a \u0926\u0947\u0924\u093e \u0939\u0942\u0902, \u0909\u0920\u0924\u093e \u0939\u0942\u0902, \u091c\u092e \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0928\u093f\u092f\u094b\u091c\u093f\u0924 \u0915\u0938\u0930\u0924 100\uff05 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impreco, mi alzo, mi blocco e faccio l'allenamento pianificato al 100\uff05."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u60aa\u614b\u3092\u3064\u304d\u3001\u8d77\u304d\u4e0a\u304c\u308a\u3001\u56fa\u307e\u308a\u3001\u8a08\u753b\u3057\u305f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092100\uff05\u5b9f\u884c\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc695\ud558\uace0, \uc77c\uc5b4\ub098\uace0, \uc5bc\uc5b4\ubd99\uace0, \uacc4\ud68d\ud55c \uc6b4\ub3d9\uc744 100\uff05 \ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik vloek, sta op, bevries en doe de geplande training 100\uff05."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeklinam, wstaj\u0119, zamarzam i realizuj\u0119 zaplanowany trening na 100\uff05."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaldi\u00e7oo, levanto, congelo e fa\u00e7o 100\uff05 o treino planejado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0440\u0443\u0433\u0430\u044e\u0441\u044c, \u0432\u0441\u0442\u0430\u044e, \u043c\u0451\u0440\u0437\u043d\u0443 \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044e \u0437\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u043d\u0430 100\uff05."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanet ediyorum, kalk\u0131yorum, donuyorum ve planlad\u0131\u011f\u0131m antrenman\u0131 \uff05100 yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5492\u9a82\uff0c\u8d77\u8eab\uff0c\u611f\u5230\u5bd2\u51b7\uff0c\u5e76\u4e14\u767e\u5206\u4e4b\u767e\u5b8c\u6210\u8ba1\u5212\u4e2d\u7684\u953b\u70bc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5492\u7f75\u8457\uff0c\u7ad9\u8d77\u4f86\uff0c\u4e00\u52d5\u4e5f\u4e0d\u52d5\uff0c100\uff05 \u5b8c\u6210\u8a08\u756b\u7684\u935b\u934a\u3002"
          }
        }
      }
    },
    "assessment.fitness.q2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du zahlst seit 6 Monaten 50\u20ac f\u00fcr ein Gym, warst aber diesen Monat erst ein einziges Mal dort. Was sagst du dir selbst?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been paying \u20ac50 for a gym for 6 months, but you've only been there once this month. What are you telling yourself?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas 6 meses pagando 50\u20ac por un gimnasio, pero este mes solo has estado una vez. \u00bfQu\u00e9 te est\u00e1s diciendo a ti mismo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez 50 \u20ac pour une salle de sport depuis 6 mois, mais vous n'y \u00eates all\u00e9 qu'une fois ce mois-ci. Qu'est-ce que tu te dis ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a 6 \u092e\u0939\u0940\u0928\u0947 \u0938\u0947 \u091c\u093f\u092e \u0915\u0947 \u0932\u093f\u090f \u20ac50 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0907\u0938 \u092e\u0939\u0940\u0928\u0947 \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u0935\u0939\u093e\u0902 \u0917\u090f \u0939\u0948\u0902\u0964 \u0906\u092a \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0947 \u0915\u094d\u092f\u093e \u0915\u0939 \u0930\u0939\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono 6 mesi che paghi 50\u20ac per una palestra, ma questo mese ci sei stato solo una volta. Cosa stai dicendo a te stesso?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u30b8\u30e0\u306b 6 \u304b\u6708\u9593 50 \u30e6\u30fc\u30ed\u6255\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u4eca\u6708\u306f 1 \u56de\u3057\u304b\u884c\u3063\u3066\u3044\u307e\u305b\u3093\u3002\u81ea\u5206\u306b\u4f55\u3092\u8a00\u3044\u805e\u304b\u305b\u3066\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 6\uac1c\uc6d4 \ub3d9\uc548 \uccb4\uc721\uad00 \ube44\uc6a9\uc73c\ub85c \u20ac50\ub97c \uc9c0\ubd88\ud588\uc9c0\ub9cc \uc774\ubc88 \ub2ec\uc5d0\ub294 \uccb4\uc721\uad00\uc5d0 \ud55c \ubc88\ub9cc \uac00\ubd24\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc2a4\uc2a4\ub85c\uc5d0\uac8c \ubb34\uc5c7\uc744 \ub9d0\ud558\uace0 \uc788\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je betaalt al 6 maanden \u20ac 50,- voor een sportschool, maar je bent er deze maand maar \u00e9\u00e9n keer geweest. Wat vertel je jezelf?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0142acisz 50 euro za si\u0142owni\u0119 od 6 miesi\u0119cy, ale by\u0142e\u015b tam tylko raz w tym miesi\u0105cu. Co sobie m\u00f3wisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e1 6 meses que pagas 50\u20ac por um gin\u00e1sio, mas s\u00f3 estiveste l\u00e1 uma vez este m\u00eas. O que voc\u00ea est\u00e1 dizendo a si mesmo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043b\u0430\u0442\u0438\u0448\u044c 50\u20ac \u0437\u0430 \u0441\u043f\u043e\u0440\u0442\u0437\u0430\u043b \u0443\u0436\u0435 6 \u043c\u0435\u0441\u044f\u0446\u0435\u0432, \u043d\u043e \u0432 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u044f\u0446\u0435 \u0431\u044b\u043b \u0442\u0430\u043c \u0432\u0441\u0435\u0433\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437. \u0427\u0442\u043e \u0442\u044b \u0441\u0435\u0431\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "6 ayd\u0131r spor salonuna 50\u20ac \u00f6d\u00fcyorsunuz ama bu ay sadece bir kez oraya gittiniz. Kendine ne s\u00f6yl\u00fcyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u4e3a\u4e00\u4e2a\u5065\u8eab\u623f\u652f\u4ed8\u4e866\u4e2a\u6708\u7684\u8d39\u7528\uff0c\u6bcf\u670850\u6b27\u5143\uff0c\u4f46\u8fd9\u4e2a\u6708\u4f60\u53ea\u53bb\u8fc7\u4e00\u6b21\u3002\u4f60\u5bf9\u81ea\u5df1\u8bf4\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5df2\u7d93\u82b1\u8cbb 50 \u6b50\u5143\u53bb\u5065\u8eab\u623f 6 \u500b\u6708\u4e86\uff0c\u4f46\u9019\u500b\u6708\u60a8\u53ea\u53bb\u904e\u4e00\u6b21\u3002\u4f60\u5728\u544a\u8a34\u81ea\u5df1\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q2.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich hatte in letzter Zeit einfach extrem viel Stress und keine Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've just had a lot of stress lately and no time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00daltimamente he tenido mucho estr\u00e9s y no tengo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai juste eu beaucoup de stress ces derniers temps et pas de temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0941\u091d\u0947 \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0924\u0928\u093e\u0935 \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u093e \u0939\u0948 \u0914\u0930 \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0938\u092e\u092f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c8 che ultimamente sono molto stressato e non ho tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u8fd1\u30b9\u30c8\u30ec\u30b9\u304c\u591a\u304f\u3066\u6642\u9593\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc694\uc998 \uc2a4\ud2b8\ub808\uc2a4\uac00 \ub108\ubb34 \ub9ce\uc544\uc11c \uc2dc\uac04\uc774 \uc5c6\uc5b4\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de laatste tijd veel stress en geen tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio mam du\u017co stresu i nie mam czasu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimamente tenho estado muito estressado e sem tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0443 \u043c\u0435\u043d\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u044b\u043b\u043e \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0435\u0441\u0441\u0430 \u0438 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son zamanlarda \u00e7ok fazla stres ya\u015fad\u0131m ve zaman\u0131m yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6700\u8fd1\u5b9e\u5728\u662f\u538b\u529b\u975e\u5e38\u5927\uff0c\u6839\u672c\u6ca1\u6709\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u8fd1\u58d3\u529b\u5f88\u5927\uff0c\u6c92\u6709\u6642\u9593\u3002"
          }
        }
      }
    },
    "assessment.fitness.q2.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gym ist zu weit weg und die Ger\u00e4te sind eh immer belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gym is too far away and the equipment is always occupied anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gimnasio est\u00e1 demasiado lejos y el equipo siempre est\u00e1 ocupado de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La salle de sport est trop \u00e9loign\u00e9e et les \u00e9quipements sont de toute fa\u00e7on toujours occup\u00e9s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u093f\u092e \u092c\u0939\u0941\u0924 \u0926\u0942\u0930 \u0939\u0948 \u0914\u0930 \u0909\u092a\u0915\u0930\u0923 \u0935\u0948\u0938\u0947 \u092d\u0940 \u0939\u092e\u0947\u0936\u093e \u092d\u0930\u0947 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La palestra \u00e8 troppo lontana e comunque gli attrezzi sono sempre occupati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b8\u30e0\u306f\u9060\u3059\u304e\u308b\u3057\u3001\u3068\u306b\u304b\u304f\u8a2d\u5099\u306f\u3044\u3064\u3082\u4eba\u304c\u3044\u3063\u3071\u3044\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud5ec\uc2a4\uc7a5\uc740 \ub108\ubb34 \uba40\uace0 \uc5b4\ucc28\ud53c \uc7a5\ube44\ub294 \ud56d\uc0c1 \uaf49 \ucc28\uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sportschool is te ver weg en de apparatuur is toch altijd bezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Si\u0142ownia jest za daleko, a sprz\u0119t i tak jest zawsze zaj\u0119ty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A academia fica muito longe e os equipamentos est\u00e3o sempre ocupados de qualquer maneira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0435\u043d\u0430\u0436\u0451\u0440\u043d\u044b\u0439 \u0437\u0430\u043b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0434\u0430\u043b\u0435\u043a\u043e, \u0430 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430\u043d\u044f\u0442\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor salonu \u00e7ok uzakta ve ekipmanlar zaten her zaman dolu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5065\u8eab\u623f\u592a\u8fdc\u4e86\uff0c\u800c\u4e14\u5668\u68b0\u603b\u662f\u88ab\u5360\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5065\u8eab\u623f\u592a\u9060\u4e86\uff0c\u53cd\u6b63\u5668\u6750\u7e3d\u662f\u88ab\u4f54\u6eff\u3002"
          }
        }
      }
    },
    "assessment.fitness.q2.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich k\u00fcndige das Abo. Offensichtlich bin ich nicht der Typ daf\u00fcr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm canceling the subscription. Obviously I'm not the type of person for that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy cancelando la suscripci\u00f3n. Obviamente no soy el tipo de persona para eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'annule l'abonnement. \u00c9videmment, je ne suis pas le genre de personne pour \u00e7a."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0930\u0926\u094d\u0926 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902. \u091c\u093e\u0939\u093f\u0930 \u0924\u094c\u0930 \u092a\u0930 \u092e\u0948\u0902 \u0909\u0938 \u0924\u0930\u0939 \u0915\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0928\u0939\u0940\u0902 \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto annullando l'abbonamento. Ovviamente non sono il tipo di persona per questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9a\u671f\u8cfc\u8aad\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u307e\u3059\u3002\u3082\u3061\u308d\u3093\u3001\u79c1\u306f\u305d\u3046\u3044\u3046\u30bf\u30a4\u30d7\u306e\u4eba\u9593\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad6c\ub3c5\uc744 \ucde8\uc18c\ud558\uaca0\uc2b5\ub2c8\ub2e4. \ubd84\uba85\ud788 \ub098\ub294 \u200b\u200b\uadf8\ub7f0 \uc0ac\ub78c\uc774 \uc544\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg het abonnement op. Daar ben ik duidelijk niet het type persoon voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj\u0119 subskrypcj\u0119. Najwyra\u017aniej nie jestem do tego typem osoby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou cancelando a assinatura. Obviamente n\u00e3o sou o tipo de pessoa para isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0442\u043c\u0435\u043d\u044f\u044e \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0443. \u041e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u044f \u043d\u0435 \u0438\u0437 \u0442\u0435\u0445, \u043a\u0442\u043e \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneli\u011fi iptal ediyorum. A\u00e7\u0131k\u00e7as\u0131 ben buna uygun bir insan de\u011filim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53d6\u6d88\u8ba2\u9605\u3002\u663e\u7136\u6211\u4e0d\u662f\u90a3\u79cd\u7c7b\u578b\u7684\u4eba\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8981\u53d6\u6d88\u8a02\u95b1\u3002\u986f\u7136\u6211\u4e0d\u662f\u90a3\u7a2e\u4eba\u3002"
          }
        }
      }
    },
    "assessment.fitness.q2.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin undiszipliniert gewesen. Ich packe in dieser Sekunde meine Sporttasche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have been undisciplined. I'm packing my gym bag this second."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He sido indisciplinado. Estoy empacando mi bolsa de gimnasia en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai \u00e9t\u00e9 indisciplin\u00e9. Je pr\u00e9pare mon sac de sport cette seconde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u0928\u0941\u0936\u093e\u0938\u0928\u0939\u0940\u0928 \u0939\u0942\u0902. \u092e\u0948\u0902 \u0905\u092d\u0940 \u0905\u092a\u0928\u093e \u091c\u093f\u092e \u092c\u0948\u0917 \u092a\u0948\u0915 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono stato indisciplinato. Sto preparando la borsa della palestra in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u898f\u5f8b\u3092\u6b20\u3044\u3066\u3044\u307e\u3059\u3002\u4eca\u3059\u3050\u30b8\u30e0\u30d0\u30c3\u30b0\u306b\u8377\u7269\u3092\u8a70\u3081\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud6c8\ub828\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 \ub2f9\uc7a5 \uc6b4\ub3d9\uac00\ubc29\uc744 \ucc59\uae30\uace0 \uc788\uc5b4\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben ongedisciplineerd geweest. Ik ben meteen mijn sporttas aan het inpakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowa\u0142em si\u0119 niezdyscyplinowany. W tej chwili pakuj\u0119 torb\u0119 sportow\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenho sido indisciplinado. Estou arrumando minha mochila de gin\u00e1stica neste segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0431\u044b\u043b \u043d\u0435\u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c. \u041f\u0440\u044f\u043c\u043e \u0432 \u044d\u0442\u0443 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u044f \u0443\u043f\u0430\u043a\u043e\u0432\u044b\u0432\u0430\u044e \u0441\u0432\u043e\u044e \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0443\u044e \u0441\u0443\u043c\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disiplinsiz davrand\u0131m. \u015eu anda spor \u00e7antam\u0131 haz\u0131rl\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e00\u76f4\u5f88\u4e0d\u81ea\u5f8b\u3002\u6211\u6b63\u5728\u8fd9\u4e00\u79d2\u6253\u5305\u6211\u7684\u8fd0\u52a8\u5305\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e00\u76f4\u6c92\u6709\u7d00\u5f8b\u3002\u6211\u73fe\u5728\u6b63\u5728\u6536\u62fe\u6211\u7684\u5065\u8eab\u5305\u3002"
          }
        }
      }
    },
    "assessment.fitness.q3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst eine \u00dcbung. Dein Plan sagt 12 Wiederholungen. Bei Nummer 9 fangen deine Muskeln an, extrem zu brennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do an exercise. Your plan says 12 reps. At number 9 your muscles start to burn extremely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haces un ejercicio. Tu plan dice 12 repeticiones. En el n\u00famero 9 tus m\u00fasculos empiezan a arder much\u00edsimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous faites un exercice. Votre plan dit 12 r\u00e9p\u00e9titions. Au num\u00e9ro 9, vos muscles commencent \u00e0 br\u00fbler extr\u00eamement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u090f\u0915 \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0930\u0947\u0902. \u0906\u092a\u0915\u0940 \u092f\u094b\u091c\u0928\u093e 12 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f \u0915\u0939\u0924\u0940 \u0939\u0948\u0964 9\u0935\u0947\u0902 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0906\u092a\u0915\u0940 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u093e\u0902 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u091c\u0932\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un esercizio. Il tuo piano dice 12 ripetizioni. Al numero 9 i tuoi muscoli iniziano a bruciare moltissimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u904b\u52d5\u3092\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u8a08\u753b\u3067\u306f12\u56de\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002 9 \u756a\u76ee\u3067\u306f\u3001\u7b4b\u8089\u304c\u6975\u5ea6\u306b\u71c3\u3048\u59cb\u3081\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc6b4\ub3d9\uc744\ud569\ub2c8\ub2e4. \uadc0\ud558\uc758 \uacc4\ud68d\uc5d0\ub294 12\ud68c \ubc18\ubcf5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. 9\ubc88\uc5d0\uc11c\ub294 \uadfc\uc721\uc774 \uadf9\ub3c4\ub85c \ud0c0\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je doet een oefening. Je plan zegt 12 herhalingen. Op nummer 9 beginnen je spieren extreem te verbranden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Robisz \u0107wiczenie. Tw\u00f3j plan zak\u0142ada 12 powt\u00f3rze\u0144. Przy liczbie 9 Twoje mi\u0119\u015bnie zaczynaj\u0105 si\u0119 niesamowicie pali\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea faz um exerc\u00edcio. Seu plano diz 12 repeti\u00e7\u00f5es. No n\u00famero 9, seus m\u00fasculos come\u00e7am a queimar extremamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0448\u044c \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435. \u0422\u0432\u043e\u0439 \u043f\u043b\u0430\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u0442 12 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u0439. \u041d\u0430 \u0434\u0435\u0432\u044f\u0442\u043e\u043c \u0442\u0432\u043e\u0438 \u043c\u044b\u0448\u0446\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u044c\u043d\u043e \u0433\u043e\u0440\u0435\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir egzersiz yap\u0131yorsun. Plan\u0131n\u0131zda 12 tekrar yaz\u0131yor. 9 numarada kaslar\u0131n\u0131z a\u015f\u0131r\u0131 derecede yanmaya ba\u015flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u505a\u4e00\u4e2a\u7ec3\u4e60\u3002\u4f60\u7684\u8ba1\u5212\u5199\u774012\u6b21\u91cd\u590d\u3002\u5728\u7b2c9\u6b21\u65f6\uff0c\u4f60\u7684\u808c\u8089\u5f00\u59cb\u6781\u5ea6\u71c3\u70e7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u505a\u4e00\u500b\u7df4\u7fd2\u3002\u4f60\u7684\u8a08\u5283\u8aaa\u7684\u662f 12 \u6b21\u3002\u5728 9 \u865f\u6642\uff0c\u4f60\u7684\u808c\u8089\u958b\u59cb\u6975\u5ea6\u71c3\u71d2\u3002"
          }
        }
      }
    },
    "assessment.fitness.q3.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich h\u00f6re bei 9 auf. Ich will mich ja nicht verletzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll stop at 9. I don't want to hurt myself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar\u00e9 a las 9. No quiero lastimarme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'arr\u00eaterai \u00e0 9 heures. Je ne veux pas me blesser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 9 \u092c\u091c\u0947 \u0930\u0941\u0915\u0942\u0902\u0917\u093e\u0964 \u092e\u0948\u0902 \u0916\u0941\u0926 \u0915\u094b \u091a\u094b\u091f \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0902\u091a\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi fermo alle 9. Non voglio farmi del male."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9\u6642\u306b\u6b62\u307e\u308a\u307e\u3059\u3002\u81ea\u5206\u3092\u50b7\u3064\u3051\u305f\u304f\u306a\u3044\u306e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "9\uc2dc\uc5d0 \uadf8\ub9cc\ud560\uac8c\uc694. \ub2e4\uce58\uac8c \ud558\uace0 \uc2f6\uc9c0 \uc54a\uc544\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik stop om negen uur. Ik wil mezelf geen pijn doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymam si\u0119 o 9. Nie chc\u0119 sobie zrobi\u0107 krzywdy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paro \u00e0s 9. N\u00e3o quero me machucar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u0435\u043a\u0440\u0430\u0449\u0443 \u0432 9. \u042f \u0436\u0435 \u043d\u0435 \u0445\u043e\u0447\u0443 \u0442\u0440\u0430\u0432\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "9'da duraca\u011f\u0131m. Kendime zarar vermek istemiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u57289\u70b9\u505c\u6b62\u3002\u6211\u53ef\u4e0d\u60f3\u53d7\u4f24\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u5728 9 \u9ede\u505c\u6b62\u3002\u6211\u4e0d\u60f3\u50b7\u5bb3\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "assessment.fitness.q3.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich qu\u00e4le mich auf 10 und breche dann ab. Das reicht auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I push myself to 10 and then stop. That's enough too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me esfuerzo hasta 10 y luego me detengo. Eso tambi\u00e9n es suficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me pousse \u00e0 10 puis m'arr\u00eate. Cela suffit aussi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0916\u0941\u0926 \u0915\u094b 10 \u0924\u0915 \u0927\u0915\u0947\u0932\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0930\u0941\u0915 \u091c\u093e\u0924\u093e \u0939\u0942\u0902\u0964 \u092f\u0939 \u092d\u0940 \u0915\u093e\u092b\u0940 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi spingo fino a 10 e poi mi fermo. Anche questo basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u81ea\u5206\u81ea\u8eab\u309210\u307e\u3067\u62bc\u3057\u4e0a\u3052\u3066\u304b\u3089\u505c\u6b62\u3057\u307e\u3059\u3002\u305d\u308c\u3067\u5341\u5206\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 10\uae4c\uc9c0 \ubc00\uace0 \ub098\uc11c \uba48\ucd98\ub2e4. \uadf8\uac83\ub3c4 \ucda9\ubd84\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik duw mezelf naar 10 en stop dan. Dat is ook genoeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobijam do 10 i zatrzymuj\u0119 si\u0119. To te\u017c wystarczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me esfor\u00e7o para 10 e ent\u00e3o paro. Isso tamb\u00e9m \u00e9 o suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u0443\u0447\u0430\u044e\u0441\u044c \u0434\u043e 10 \u0438 \u043f\u043e\u0442\u043e\u043c \u0431\u0440\u043e\u0441\u0430\u044e. \u042d\u0442\u043e\u0433\u043e \u0442\u043e\u0436\u0435 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendimi 10'a zorluyorum ve sonra duruyorum. Bu da yeterli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6298\u78e8\u81ea\u5df1\u523010\uff0c\u7136\u540e\u5c31\u653e\u5f03\u3002\u8fd9\u4e5f\u591f\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u628a\u81ea\u5df1\u63a8\u523010\uff0c\u7136\u5f8c\u505c\u4e0b\u4f86\u3002\u9019\u4e5f\u8db3\u5920\u4e86\u3002"
          }
        }
      }
    },
    "assessment.fitness.q3.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bei\u00dfe die Z\u00e4hne zusammen, zwinge mich bis zur 12 und lege keuchend ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I grit my teeth, force myself to 12 and lay down, panting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprieto los dientes, me obligo a tener 12 y me acuesto, jadeando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je serre les dents, me force \u00e0 12 et m'allonge, haletant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0926\u093e\u0901\u0924 \u092a\u0940\u0938\u0924\u093e \u0939\u0942\u0901, \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b 12 \u092c\u091c\u0947 \u0924\u0915 \u092e\u091c\u092c\u0942\u0930 \u0915\u0930\u0924\u093e \u0939\u0942\u0901 \u0914\u0930 \u0939\u093e\u0901\u092b\u0924\u0947 \u0939\u0941\u090f \u0932\u0947\u091f \u091c\u093e\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stringo i denti, mi costringo a 12 e mi sdraio, ansimando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u6b6f\u3092\u98df\u3044\u3057\u3070\u3063\u306612\u6642\u306b\u529b\u3092\u5165\u308c\u3001\u606f\u3092\u5207\u3089\u3057\u306a\u304c\u3089\u6a2a\u305f\u308f\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc774\ub97c \uc545\ubb3c\uace0 \uc5b5\uc9c0\ub85c 12\ub3c4\ub97c \uc720\uc9c0\ud55c \ub4a4 \ub204\uc6cc \ud5d0\ub5a1\uac70\ub838\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik klem mijn tanden op elkaar, dwing mezelf tot 12 en ga hijgend liggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaciskam z\u0119by, zmuszam si\u0119 do 12 i k\u0142ad\u0119 si\u0119, dysz\u0105c."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerro os dentes, for\u00e7o-me a fazer 12 e deito-me, ofegante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0436\u0438\u043c\u0430\u044e \u0437\u0443\u0431\u044b, \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e \u0441\u0435\u0431\u044f \u0434\u043e 12 \u0438 \u043a\u043b\u0430\u0434\u0443, \u0437\u0430\u0434\u044b\u0445\u0430\u044f\u0441\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Di\u015flerimi s\u0131kt\u0131m, kendimi 12'ye zorlad\u0131m ve nefes nefese uzand\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u54ac\u7d27\u7259\u5173\uff0c\u903c\u81ea\u5df1\u505a\u523012\uff0c\u7136\u540e\u6c14\u5598\u5401\u5401\u5730\u653e\u4e0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u54ac\u7dca\u7259\u95dc\uff0c\u5f37\u8feb\u81ea\u5df1\u523012\u9ede\uff0c\u6c23\u5598\u5401\u7c72\u5730\u8eba\u4e0b\u3002"
          }
        }
      }
    },
    "assessment.fitness.q3.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn 12 das Ziel ist und ich bei 12 noch Kraft habe, mache ich 14, bis der Muskel komplett versagt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If 12 is the goal and I still have strength at 12, I do 14 until the muscle fails completely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el objetivo es 12 y todav\u00eda tengo fuerza en 12, hago 14 hasta que el m\u00fasculo falla por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'objectif est de 12 et que j'ai encore de la force \u00e0 12, j'en fais 14 jusqu'\u00e0 ce que le muscle \u00e9choue compl\u00e8tement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0926\u093f 12 \u0932\u0915\u094d\u0937\u094d\u092f \u0939\u0948 \u0914\u0930 \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0905\u092d\u0940 \u092d\u0940 12 \u092a\u0930 \u0924\u093e\u0915\u0924 \u0939\u0948, \u0924\u094b \u092e\u0948\u0902 14 \u0924\u092c \u0924\u0915 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u091c\u092c \u0924\u0915 \u0915\u093f \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u0940 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0935\u093f\u092b\u0932 \u0928 \u0939\u094b \u091c\u093e\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'obiettivo \u00e8 12 e ho ancora forza a 12, faccio 14 finch\u00e9 il muscolo non cede completamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12\u304c\u76ee\u6a19\u3067\u300112\u3067\u3082\u7b4b\u529b\u304c\u6b8b\u3063\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u7b4b\u8089\u304c\u5b8c\u5168\u306b\u8870\u3048\u308b\u307e\u306714\u3092\u884c\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12\ud68c\uac00 \ubaa9\ud45c\uc774\uace0 12\uc2dc\uc5d0\ub3c4 \uc5ec\uc804\ud788 \ud798\uc774 \ub0a8\uc544 \uc788\ub2e4\uba74 \uadfc\uc721\uc774 \uc644\uc804\ud788 \ub9dd\uac00\uc9c8 \ub54c\uae4c\uc9c0 14\ud68c\ub97c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als 12 het doel is en ik heb nog steeds kracht op 12, doe ik 14 totdat de spier volledig faalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je\u015bli celem jest 12, a nadal mam si\u0142\u0119 na 12, robi\u0119 14, a\u017c mi\u0119sie\u0144 ca\u0142kowicie zawiedzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se 12 \u00e9 o objetivo e ainda tenho for\u00e7a aos 12, fa\u00e7o 14 at\u00e9 o m\u00fasculo falhar completamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0441\u043b\u0438 \u0446\u0435\u043b\u044c\u044e \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f 12 \u0438 \u0443 \u043c\u0435\u043d\u044f \u0435\u0449\u0451 \u0435\u0441\u0442\u044c \u0441\u0438\u043b\u044b \u043f\u0440\u0438 12, \u044f \u0434\u0435\u043b\u0430\u044e 14, \u043f\u043e\u043a\u0430 \u043c\u044b\u0448\u0446\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0435 \u043e\u0442\u043a\u0430\u0436\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u011fer hedef 12 ise ve 12'de hala g\u00fcc\u00fcm varsa, kaslar tamamen bitene kadar 14 yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u76ee\u6807\u662f12\u4e2a\uff0c\u800c\u6211\u5728\u7b2c12\u4e2a\u65f6\u8fd8\u6709\u529b\u6c14\uff0c\u6211\u5c31\u505a14\u4e2a\uff0c\u76f4\u5230\u808c\u8089\u5b8c\u5168\u529b\u7aed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u76ee\u6a19\u662f12\uff0c\u800c\u6211\u572812\u6642\u4ecd\u6709\u529b\u91cf\uff0c\u6211\u5c31\u6703\u505a14\uff0c\u76f4\u5230\u808c\u8089\u5b8c\u5168\u8870\u7aed\u3002"
          }
        }
      }
    },
    "assessment.fitness.q4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher dieser S\u00e4tze beschreibt deine aktuelle k\u00f6rperliche Verfassung am besten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which of these sentences best describes your current physical condition?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfCu\u00e1l de estas frases describe mejor tu condici\u00f3n f\u00edsica actual?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laquelle de ces phrases d\u00e9crit le mieux votre condition physique actuelle\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u094c\u0928 \u0938\u093e \u0935\u093e\u0915\u094d\u092f \u0906\u092a\u0915\u0940 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u093e \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0924\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale di queste frasi descrive meglio la tua attuale condizione fisica?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b21\u306e\u6587\u306e\u3046\u3061\u3001\u3042\u306a\u305f\u306e\u73fe\u5728\u306e\u4f53\u8abf\u3092\u6700\u3082\u3088\u304f\u8868\u3057\u3066\u3044\u308b\u3082\u306e\u306f\u3069\u308c\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c \uc911 \uadc0\ud558\uc758 \ud604\uc7ac \uc2e0\uccb4 \uc0c1\ud0dc\ub97c \uac00\uc7a5 \uc798 \uc124\uba85\ud558\ub294 \ubb38\uc7a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke van deze zinnen beschrijft het beste uw huidige fysieke conditie?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kt\u00f3re z tych zda\u0144 najlepiej opisuje Tw\u00f3j obecny stan fizyczny?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual destas frases melhor descreve sua condi\u00e7\u00e3o f\u00edsica atual?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a\u043e\u0435 \u0438\u0437 \u044d\u0442\u0438\u0445 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0435 \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu c\u00fcmlelerden hangisi \u015fu anki fiziksel durumunuzu en iyi \u015fekilde tan\u0131ml\u0131yor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u9762\u54ea\u4e00\u53e5\u6700\u80fd\u63cf\u8ff0\u4f60\u76ee\u524d\u7684\u8eab\u4f53\u72b6\u51b5\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u5217\u54ea\u4e00\u53e5\u8a71\u6700\u80fd\u63cf\u8ff0\u60a8\u76ee\u524d\u7684\u8eab\u9ad4\u72c0\u6cc1\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q4.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe einfach nicht die Genetik f\u00fcr einen guten K\u00f6rper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I just don't have the genetics for a good body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplemente no tengo la gen\u00e9tica para un buen cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'ai tout simplement pas la g\u00e9n\u00e9tique n\u00e9cessaire pour avoir un bon corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0947\u0930\u0947 \u0905\u0902\u0926\u0930 \u0905\u091a\u094d\u091b\u0947 \u0936\u0930\u0940\u0930 \u0915\u0940 \u0906\u0928\u0941\u0935\u0902\u0936\u093f\u0915\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Semplicemente non ho la genetica per un buon corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306b\u306f\u826f\u3044\u4f53\u3092\u4f5c\u308b\u305f\u3081\u306e\u907a\u4f1d\u5b66\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub09c \uadf8\ub0e5 \ubab8\uc774 \uc88b\uc740 \uc720\uc804\uc801 \ud2b9\uc131\uc744 \uac16\uace0 \uc788\uc9c0 \uc54a\uc740 \uac83 \ubfd0\uc774\uc57c."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb gewoon niet de genetica voor een goed lichaam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po prostu nie mam gen\u00f3w na dobr\u0105 sylwetk\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu simplesmente n\u00e3o tenho a gen\u00e9tica para um bom corpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u043c\u0435\u043d\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435\u0442 \u0433\u0435\u043d\u0435\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u0445\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u0442\u0435\u043b\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130yi bir v\u00fccut i\u00e7in geneti\u011fim yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6839\u672c\u6ca1\u6709\u62e5\u6709\u597d\u8eab\u6750\u7684\u57fa\u56e0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u662f\u6c92\u6709\u597d\u8eab\u6750\u7684\u57fa\u56e0\u3002"
          }
        }
      }
    },
    "assessment.fitness.q4.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich mehr Freizeit h\u00e4tte, w\u00e4re ich in Topform."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If I had more free time, I would be in great shape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tuviera m\u00e1s tiempo libre, estar\u00eda en muy buena forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si j\u2019avais plus de temps libre, je serais en pleine forme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0926\u093f \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0905\u0927\u093f\u0915 \u0916\u093e\u0932\u0940 \u0938\u092e\u092f \u0939\u094b\u0924\u093e, \u0924\u094b \u092e\u0948\u0902 \u092c\u0939\u0941\u0924 \u0905\u091a\u094d\u091b\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0939\u094b\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avessi pi\u00f9 tempo libero sarei in ottima forma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3082\u3063\u3068\u81ea\u7531\u306a\u6642\u9593\u304c\u3042\u308c\u3070\u3001\u79c1\u306f\u7d20\u6674\u3089\u3057\u3044\u4f53\u8abf\u3092\u4fdd\u3063\u3066\u3044\u308b\u3067\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9cc\uc57d \ub098\uc5d0\uac8c \uc790\uc720 \uc2dc\uac04\uc774 \ub354 \uc788\uc5c8\ub2e4\uba74, \ub098\ub294 \ubab8\ub9e4\uac00 \ub354 \uc88b\uc558\uc744 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als ik meer vrije tijd had, zou ik in topvorm zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdybym mia\u0142 wi\u0119cej wolnego czasu, by\u0142bym w \u015bwietnej formie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eu tivesse mais tempo livre, estaria em \u00f3tima forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0441\u043b\u0438 \u0431\u044b \u0443 \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u044f \u0431\u044b\u043b \u0431\u044b \u0432 \u043e\u0442\u043b\u0438\u0447\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla bo\u015f zaman\u0131m olsayd\u0131 \u00e7ok iyi durumda olurdum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u6211\u6709\u66f4\u591a\u7684\u7a7a\u95f2\u65f6\u95f4\uff0c\u6211\u5c31\u4f1a\u72b6\u6001\u5f88\u597d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u6211\u6709\u66f4\u591a\u7684\u7a7a\u9592\u6642\u9593\uff0c\u6211\u7684\u72c0\u614b\u5c31\u6703\u5f88\u597d\u3002"
          }
        }
      }
    },
    "assessment.fitness.q4.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trainiere zwar, aber meine Ern\u00e4hrung macht mir meine Ergebnisse kaputt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I work out, but my diet is ruining my results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hago ejercicio, pero mi dieta est\u00e1 arruinando mis resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'entra\u00eene, mais mon r\u00e9gime ruine mes r\u00e9sultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u0938\u0930\u0924 \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u092e\u0947\u0930\u093e \u0906\u0939\u093e\u0930 \u092e\u0947\u0930\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u094b \u0916\u0930\u093e\u092c \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alleno, ma la mia dieta sta rovinando i miei risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306f\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304c\u3001\u98df\u751f\u6d3b\u306e\u305b\u3044\u3067\u7d50\u679c\u304c\u53f0\u7121\u3057\u306b\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b4\ub3d9\uc744 \ud558\ub294\ub370 \ub2e4\uc774\uc5b4\ud2b8\uac00 \uacb0\uacfc\ub97c \ub9dd\uce58\uace0 \uc788\uc5b4\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik train, maar mijn dieet verpest mijn resultaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0106wicz\u0119, ale moja dieta rujnuje moje wyniki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu malho, mas minha dieta est\u00e1 arruinando meus resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u044e\u0441\u044c, \u043d\u043e \u043c\u043e\u0435 \u043f\u0438\u0442\u0430\u043d\u0438\u0435 \u043f\u043e\u0440\u0442\u0438\u0442 \u043c\u043e\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor yap\u0131yorum ama diyetim sonu\u00e7lar\u0131m\u0131 mahvediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u867d\u7136\u5728\u953b\u70bc\uff0c\u4f46\u6211\u7684\u996e\u98df\u6bc1\u4e86\u6211\u7684\u6210\u679c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u904b\u52d5\u4e86\uff0c\u4f46\u6211\u7684\u98f2\u98df\u7834\u58de\u4e86\u6211\u7684\u7d50\u679c\u3002"
          }
        }
      }
    },
    "assessment.fitness.q4.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein K\u00f6rper ist das exakte Spiegelbild meiner Disziplin. Ich bekomme das, was ich verdiene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My body is the exact reflection of my discipline. I get what I deserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi cuerpo es el reflejo exacto de mi disciplina. Recibo lo que merezco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon corps est le reflet exact de ma discipline. J'obtiens ce que je m\u00e9rite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0947\u0930\u093e \u0936\u0930\u0940\u0930 \u092e\u0947\u0930\u0947 \u0905\u0928\u0941\u0936\u093e\u0938\u0928 \u0915\u093e \u0938\u091f\u0940\u0915 \u092a\u094d\u0930\u0924\u093f\u092c\u093f\u0902\u092c \u0939\u0948\u0964 \u092e\u0941\u091d\u0947 \u0935\u0939\u0940 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u092e\u0948\u0902 \u0939\u0915\u0926\u093e\u0930 \u0939\u0942\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio corpo \u00e8 l'esatto riflesso della mia disciplina. Ottengo ci\u00f2 che merito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306e\u4f53\u306f\u79c1\u306e\u898f\u5f8b\u3092\u6b63\u78ba\u306b\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u3002\u79c1\u306f\u81ea\u5206\u306b\u5024\u3059\u308b\u3082\u306e\u3092\u624b\u306b\u5165\u308c\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4 \ubab8\uc740 \ub0b4 \uaddc\uc728\uc744 \uc815\ud655\ud558\uac8c \ubc18\uc601\ud569\ub2c8\ub2e4. \ub098\ub294 \ub0b4\uac00 \ub9c8\ub545\ud55c \uac83\uc744 \uc5bb\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn lichaam is de exacte weerspiegeling van mijn discipline. Ik krijg wat ik verdien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moje cia\u0142o jest dok\u0142adnym odzwierciedleniem mojej dyscypliny. Dostaj\u0119 to, na co zas\u0142uguj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu corpo \u00e9 o reflexo exato da minha disciplina. Eu recebo o que mere\u00e7o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0451 \u0442\u0435\u043b\u043e \u2014 \u044d\u0442\u043e \u0442\u043e\u0447\u043d\u043e\u0435 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0435\u0439 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b. \u042f \u043f\u043e\u043b\u0443\u0447\u0430\u044e \u0442\u043e, \u0447\u0442\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudum disiplinimin tam yans\u0131mas\u0131d\u0131r. Hak etti\u011fimi al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u8eab\u4f53\u662f\u6211\u81ea\u5f8b\u7684\u7cbe\u51c6\u5199\u7167\u3002\u6211\u5f97\u5230\u6211\u5e94\u5f97\u7684\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u8eab\u9ad4\u662f\u6211\u81ea\u5f8b\u7684\u6e96\u78ba\u53cd\u6620\u3002\u6211\u5f97\u5230\u4e86\u6211\u61c9\u5f97\u7684\u3002"
          }
        }
      }
    },
    "assessment.fitness.q5": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute steht dein absolutes Hass-Workout auf dem Plan (z.B. schweres Beintraining oder intensives Cardio). Du hast leichte Kopfschmerzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today your absolute hate workout is on the plan (e.g. heavy leg training or intense cardio). You have a slight headache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy tu entrenamiento de odio absoluto est\u00e1 en el plan (por ejemplo, entrenamiento pesado de piernas o cardio intenso). Tienes un ligero dolor de cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd'hui, votre entra\u00eenement de haine absolue est au programme (par exemple, entra\u00eenement des jambes lourdes ou cardio intense). Vous avez un l\u00e9ger mal de t\u00eate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0906\u092a\u0915\u0940 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0928\u092b\u0930\u0924 \u0935\u093e\u0932\u0940 \u0915\u0938\u0930\u0924 \u092f\u094b\u091c\u0928\u093e \u092a\u0930 \u0939\u0948 (\u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092d\u093e\u0930\u0940 \u092a\u0948\u0930 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u092f\u093e \u0917\u0939\u0928 \u0915\u093e\u0930\u094d\u0921\u093f\u092f\u094b)\u0964 \u0906\u092a\u0915\u094b \u0939\u0932\u094d\u0915\u093e \u0938\u093f\u0930\u0926\u0930\u094d\u0926 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi \u00e8 in programma il tuo allenamento pi\u00f9 odioso (ad esempio allenamento per le gambe pesanti o cardio intenso). Hai un leggero mal di testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u3001\u7d76\u5bfe\u306b\u5acc\u3044\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u304c\u8a08\u753b\u3055\u308c\u3066\u3044\u307e\u3059 (\u4f8b: \u6fc0\u3057\u3044\u811a\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3084\u6fc0\u3057\u3044\u6709\u9178\u7d20\u904b\u52d5\u306a\u3069)\u3002\u5c11\u3057\u982d\u304c\u75db\u3044\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \ub2f9\uc2e0\uc774 \uac00\uc7a5 \uc2eb\uc5b4\ud558\ub294 \uc6b4\ub3d9(\uc608: \ubb34\uac70\uc6b4 \ub2e4\ub9ac \ud6c8\ub828 \ub610\ub294 \uac15\ub82c\ud55c \uc720\uc0b0\uc18c \uc6b4\ub3d9)\uc774 \uacc4\ud68d\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc57d\uac04\uc758 \ub450\ud1b5\uc774 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag staat jouw absolute haattraining op het plan (bijvoorbeeld zware beentraining of intensieve cardio). Je hebt lichte hoofdpijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj w planie jest Tw\u00f3j absolutny trening nienawi\u015bci (np. ci\u0119\u017cki trening n\u00f3g lub intensywne cardio). Masz lekki b\u00f3l g\u0142owy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje o seu treino de \u00f3dio absoluto est\u00e1 no plano (por exemplo, treino pesado para as pernas ou cardio intenso). Voc\u00ea est\u00e1 com uma leve dor de cabe\u00e7a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0443 \u0442\u0435\u0431\u044f \u0432 \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0430\u044f \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430 \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u0438 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430 \u043d\u043e\u0433 \u0438\u043b\u0438 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0435 \u043a\u0430\u0440\u0434\u0438\u043e). \u0423 \u0442\u0435\u0431\u044f \u043b\u0435\u0433\u043a\u0430\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn kesinlikle nefret antrenman\u0131n\u0131z planlan\u0131yor (\u00f6rne\u011fin a\u011f\u0131r bacak antrenman\u0131 veya yo\u011fun kardiyo). Hafif bir ba\u015f a\u011fr\u0131n\u0131z var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u4f60\u8ba1\u5212\u8fdb\u884c\u4f60\u6700\u8ba8\u538c\u7684\u8bad\u7ec3\uff08\u4f8b\u5982\uff0c\u91cd\u817f\u8bad\u7ec3\u6216\u9ad8\u5f3a\u5ea6\u6709\u6c27\uff09\u3002\u4f60\u6709\u8f7b\u5fae\u7684\u5934\u75db\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\uff0c\u4f60\u7d55\u5c0d\u8a0e\u53ad\u7684\u904b\u52d5\u5df2\u5728\u8a08\u5283\u4e2d\uff08\u4f8b\u5982\u5927\u91cd\u91cf\u7684\u817f\u90e8\u8a13\u7df4\u6216\u5287\u70c8\u7684\u6709\u6c27\u904b\u52d5\uff09\u3002\u4f60\u6709\u8f15\u5fae\u7684\u982d\u75db\u3002"
          }
        }
      }
    },
    "assessment.fitness.q5.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lasse das Training heute komplett ausfallen. Der K\u00f6rper braucht Ruhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm skipping training completely today. The body needs rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy me saltar\u00e9 el entrenamiento por completo. El cuerpo necesita descansar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je saute compl\u00e8tement l'entra\u00eenement aujourd'hui. Le corps a besoin de repos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0906\u091c \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u091b\u094b\u0921\u093c \u0930\u0939\u093e \u0939\u0942\u0902\u0964 \u0936\u0930\u0940\u0930 \u0915\u094b \u0906\u0930\u093e\u092e \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi salter\u00f2 completamente l'allenamento. Il corpo ha bisogno di riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u5b8c\u5168\u306b\u30b5\u30dc\u3063\u3066\u307e\u3059\u3002\u4f53\u306b\u306f\u4f11\u606f\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \ud6c8\ub828\uc744 \uc644\uc804\ud788 \ube7c\uba39\uaca0\uc2b5\ub2c8\ub2e4. \ubab8\uc5d0\ub294 \ud734\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sla de training vandaag helemaal over. Het lichaam heeft rust nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj ca\u0142kowicie rezygnuj\u0119 z trening\u00f3w. Cia\u0142o potrzebuje odpoczynku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou pulando completamente o treino hoje. O corpo precisa de descanso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0440\u043e\u043f\u0443\u0449\u0443 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443. \u0422\u0435\u043b\u0443 \u043d\u0443\u0436\u0435\u043d \u043e\u0442\u0434\u044b\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn antrenman\u0131 tamamen atl\u0131yorum. V\u00fccudun dinlenmeye ihtiyac\u0131 var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4eca\u5929\u5b8c\u5168\u4e0d\u8bad\u7ec3\u3002\u8eab\u4f53\u9700\u8981\u4f11\u606f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4eca\u5929\u5b8c\u5168\u8df3\u904e\u8a13\u7df4\u3002\u8eab\u9ad4\u9700\u8981\u4f11\u606f\u3002"
          }
        }
      }
    },
    "assessment.fitness.q5.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe hin, mache aber stattdessen Brust/Bizeps oder etwas Einfaches, das Spa\u00df macht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll go but do chest/biceps or something simple and fun instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir\u00e9, pero har\u00e9 pecho/b\u00edceps o algo simple y divertido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais y aller mais fais plut\u00f4t des pectoraux/biceps ou quelque chose de simple et d'amusant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u093e\u090a\u0902\u0917\u093e \u0932\u0947\u0915\u093f\u0928 \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u091a\u0947\u0938\u094d\u091f/\u092c\u093e\u0907\u0938\u0947\u092a\u094d\u0938 \u092f\u093e \u0915\u0941\u091b \u0938\u0930\u0932 \u0914\u0930 \u092e\u091c\u0947\u0926\u093e\u0930 \u0915\u093e\u092e \u0915\u0930\u0942\u0902\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Far\u00f2 invece petto/bicipiti o qualcosa di semplice e divertente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee3\u308f\u308a\u306b\u3001\u80f8\u90e8/\u4e0a\u8155\u4e8c\u982d\u7b4b\u304b\u3001\u7c21\u5358\u3067\u697d\u3057\u3044\u4f55\u304b\u3092\u3059\u308b\u3064\u3082\u308a\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\uc2e0 \uac00\uc2b4/\uc774\ub450 \uc6b4\ub3d9\uc774\ub098 \uac04\ub2e8\ud558\uace0 \uc7ac\ubbf8\uc788\ub294 \uc6b4\ub3d9\uc744 \ud560\uac8c\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga maar in plaats daarvan borst/biceps doen of iets eenvoudigs en leuks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u00f3jd\u0119, ale zamiast tego \u0107wicz\u0119 klatk\u0119 piersiow\u0105/biceps lub co\u015b prostego i przyjemnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu vou, mas fa\u00e7o peito/b\u00edceps ou algo simples e divertido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0438\u0434\u0443 \u0442\u0443\u0434\u0430, \u043d\u043e \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u0434\u0435\u043b\u0430\u044e \u0433\u0440\u0443\u0434\u044c/\u0431\u0438\u0446\u0435\u043f\u0441 \u0438\u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0435, \u0447\u0442\u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gidece\u011fim ama onun yerine g\u00f6\u011f\u00fcs/biceps veya basit ve e\u011flenceli bir \u015feyler yapaca\u011f\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53bb\u90a3\u513f\uff0c\u4f46\u53cd\u800c\u505a\u80f8\u808c/\u4e8c\u5934\u808c\u6216\u8005\u4e00\u4e9b\u7b80\u5355\u3001\u6709\u8da3\u7684\u4e1c\u897f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u53bb\u505a\u80f8\u90e8/\u4e8c\u982d\u808c\u6216\u4e00\u4e9b\u7c21\u55ae\u6709\u8da3\u7684\u4e8b\u3002"
          }
        }
      }
    },
    "assessment.fitness.q5.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe hin, mache das Hass-Workout, aber mit 50\uff05 weniger Gewicht/Geschwindigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I go and do the hate workout but with 50\uff05 less weight/speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voy y hago el entrenamiento de odio pero con un 50\uff05 menos de peso/velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais faire l'entra\u00eenement haineux mais avec 50\uff05 de poids/vitesse en moins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0939\u0947\u091f \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0932\u0947\u0915\u093f\u0928 50\uff05 \u0915\u092e \u0935\u091c\u0928/\u0917\u0924\u093f \u0915\u0947 \u0938\u093e\u0925\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vado a fare l'allenamento dell'odio ma con il 50\uff05 in meno di peso/velocit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u30d8\u30a4\u30c8\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u3092\u884c\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u91cd\u91cf\u3068\u30b9\u30d4\u30fc\u30c9\u306f50\uff05\u6e1b\u5c11\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uac00\uc11c \uc2eb\uc5b4\ud558\ub294 \uc6b4\ub3d9\uc744 \ud558\uc9c0\ub9cc \ubb34\uac8c/\uc18d\ub3c4\ub294 50\uff05 \uc904\uc600\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga de haattraining doen, maar met 50\uff05 minder gewicht/snelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chodz\u0119 i wykonuj\u0119 trening nienawi\u015bci, ale z 50\uff05 mniejsz\u0105 wag\u0105/pr\u0119dko\u015bci\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu vou e fa\u00e7o o treino do \u00f3dio, mas com 50\uff05 menos peso/velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0438\u0434\u0443 \u0442\u0443\u0434\u0430, \u0434\u0435\u043b\u0430\u044e \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u043d\u0443\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443, \u043d\u043e \u0441 50\uff05 \u043c\u0435\u043d\u044c\u0448\u0438\u043c \u0432\u0435\u0441\u043e\u043c/\u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gidip nefret antrenman\u0131 yap\u0131yorum ama \uff0550 daha az a\u011f\u0131rl\u0131k/h\u0131zla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53bb\u505a\u90a3\u4e2a\u8ba8\u538c\u7684\u953b\u70bc\uff0c\u4f46\u91cd\u91cf/\u901f\u5ea6\u51cf\u5c1150\uff05\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53bb\u505a\u8a0e\u53ad\u7684\u935b\u7149\uff0c\u4f46\u91cd\u91cf/\u901f\u5ea6\u6e1b\u5c11\u4e86 50\uff05\u3002"
          }
        }
      }
    },
    "assessment.fitness.q5.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe hin und zerst\u00f6re das Hass-Workout exakt nach Plan. Kopfschmerzen sind keine Ausrede."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I go and destroy the hate workout exactly according to plan. Headaches are not an excuse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voy y destruyo el entrenamiento de odio exactamente seg\u00fan lo planeado. Los dolores de cabeza no son una excusa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais d\u00e9truire l'entra\u00eenement haineux exactement comme pr\u00e9vu. Les maux de t\u00eate ne sont pas une excuse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0928\u092b\u0930\u0924 \u0915\u0940 \u0915\u0938\u0930\u0924 \u0915\u094b \u0928\u0937\u094d\u091f \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964 \u0938\u093f\u0930\u0926\u0930\u094d\u0926 \u0915\u094b\u0908 \u092c\u0939\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vado e distruggo l'allenamento dell'odio esattamente secondo il piano. Il mal di testa non \u00e8 una scusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u8a08\u753b\u901a\u308a\u306b\u30d8\u30a4\u30c8\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u7834\u58ca\u3057\u306b\u884c\u304d\u307e\u3059\u3002\u982d\u75db\u306f\u8a00\u3044\u8a33\u306b\u306f\u306a\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uacc4\ud68d\ub300\ub85c \uc815\ud655\ud558\uac8c \uc99d\uc624 \uc6b4\ub3d9\uc744 \ud30c\uad34\ud569\ub2c8\ub2e4. \ub450\ud1b5\uc740 \ubcc0\uba85\uc774 \ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga de haattraining precies volgens plan vernietigen. Hoofdpijn is geen excuus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Id\u0119 i niszcz\u0119 trening nienawi\u015bci dok\u0142adnie zgodnie z planem. B\u00f3le g\u0142owy nie s\u0105 wym\u00f3wk\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu vou e destruo o treino de \u00f3dio exatamente de acordo com o planejado. Dores de cabe\u00e7a n\u00e3o s\u00e3o desculpa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0438\u0434\u0443 \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u0438 \u0442\u043e\u0447\u043d\u043e \u043f\u043e \u043f\u043b\u0430\u043d\u0443. \u0413\u043e\u043b\u043e\u0432\u043d\u0430\u044f \u0431\u043e\u043b\u044c \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u0435\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gidip nefret antrenman\u0131n\u0131 tam olarak plana g\u00f6re yok ediyorum. Ba\u015f a\u011fr\u0131s\u0131 mazeret de\u011fildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6309\u8ba1\u5212\u53bb\u7834\u574f\u8fd9\u5957\u4ec7\u6068\u8bad\u7ec3\u3002\u5934\u75db\u4e0d\u662f\u501f\u53e3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5b8c\u5168\u6309\u7167\u8a08\u756b\u53bb\u6467\u6bc0\u4ec7\u6068\u8a13\u7df4\u3002\u982d\u75db\u4e0d\u662f\u85c9\u53e3\u3002"
          }
        }
      }
    },
    "assessment.fitness.q6": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trainierst seit 8 Wochen, siehst aber absolut keinen Fortschritt mehr im Spiegel oder auf der Waage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been training for 8 weeks, but you can't see any progress in the mirror or on the scales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas 8 semanas entrenando, pero no ves ning\u00fan progreso en el espejo ni en la b\u00e1scula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous entra\u00eenez depuis 8 semaines, mais vous ne voyez aucun progr\u00e8s dans le miroir ou sur la balance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a 8 \u0938\u092a\u094d\u0924\u093e\u0939 \u0938\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0926\u0930\u094d\u092a\u0923 \u092f\u093e \u0924\u0930\u093e\u091c\u0942 \u092a\u0930 \u0915\u094b\u0908 \u092a\u094d\u0930\u0917\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti alleni da 8 settimane, ma non vedi alcun progresso allo specchio o sulla bilancia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8\u9031\u9593\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u7d9a\u3051\u3066\u3044\u307e\u3059\u304c\u3001\u93e1\u3084\u4f53\u91cd\u8a08\u3092\u898b\u3066\u3082\u9032\u6b69\u304c\u898b\u3089\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8\uc8fc \ub3d9\uc548 \ud6c8\ub828\uc744 \ud588\uc9c0\ub9cc \uac70\uc6b8\uc774\ub098 \uccb4\uc911\uacc4\ub97c \ud1b5\ud574 \uc544\ubb34\ub7f0 \uc9c4\uc804\ub3c4 \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je traint al 8 weken, maar je ziet geen vooruitgang in de spiegel of op de weegschaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenujesz ju\u017c 8 tygodni, ale w lustrze i na wadze nie widzisz post\u0119p\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 treinando h\u00e1 8 semanas, mas n\u00e3o consegue ver nenhum progresso no espelho ou na balan\u00e7a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u0435\u0448\u044c\u0441\u044f \u0443\u0436\u0435 8 \u043d\u0435\u0434\u0435\u043b\u044c, \u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u0438\u0434\u0438\u0448\u044c \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430 \u0432 \u0437\u0435\u0440\u043a\u0430\u043b\u0435 \u0438\u043b\u0438 \u043d\u0430 \u0432\u0435\u0441\u0430\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 haftad\u0131r antrenman yap\u0131yorsunuz ama ne aynada ne de tart\u0131da bir ilerleme g\u00f6remiyorsunuz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u8bad\u7ec3\u4e868\u5468\uff0c\u4f46\u5728\u955c\u5b50\u6216\u4f53\u91cd\u79e4\u4e0a\u5b8c\u5168\u770b\u4e0d\u5230\u4efb\u4f55\u8fdb\u5c55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5df2\u7d93\u8a13\u7df4\u4e86 8 \u9031\uff0c\u4f46\u60a8\u5728\u93e1\u5b50\u6216\u9ad4\u91cd\u8a08\u4e0a\u770b\u4e0d\u5230\u4efb\u4f55\u9032\u5c55\u3002"
          }
        }
      }
    },
    "assessment.fitness.q6.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verliere die Motivation und h\u00f6re auf. Das System funktioniert bei mir nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I lose motivation and quit. The system doesn't work for me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdo la motivaci\u00f3n y lo dejo. El sistema no me funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je perds ma motivation et j'arr\u00eate. Le syst\u00e8me ne fonctionne pas pour moi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092a\u094d\u0930\u0947\u0930\u0923\u093e \u0916\u094b \u0926\u0947\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0928\u094c\u0915\u0930\u0940 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964 \u0938\u093f\u0938\u094d\u091f\u092e \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u0915\u093e\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdo la motivazione e smetto. Il sistema non funziona per me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c1\u30d9\u30fc\u30b7\u30e7\u30f3\u304c\u4e0b\u304c\u3063\u3066\u8f9e\u3081\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u79c1\u306b\u3068\u3063\u3066\u306f\u3046\u307e\u304f\u3044\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc758\uc695\uc744 \uc783\uace0 \uadf8\ub9cc \ub450\uac8c \ub429\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc774 \ub098\uc5d0\uac8c \uc791\ub3d9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik verlies de motivatie en stop ermee. Het systeem werkt bij mij niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trac\u0119 motywacj\u0119 i rezygnuj\u0119. System mi nie dzia\u0142a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perco a motiva\u00e7\u00e3o e desisto. O sistema n\u00e3o funciona para mim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0442\u0435\u0440\u044f\u044e \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u044e \u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u044e. \u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0443 \u043c\u0435\u043d\u044f \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivasyonumu kaybediyorum ve b\u0131rak\u0131yorum. Sistem bana g\u00f6re \u00e7al\u0131\u015fm\u0131yor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5931\u53bb\u4e86\u52a8\u529b\uff0c\u505c\u6b62\u4e86\u3002\u8fd9\u4e2a\u7cfb\u7edf\u5bf9\u6211\u4e0d\u8d77\u4f5c\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5931\u53bb\u52d5\u529b\u4e26\u9000\u51fa\u3002\u8a72\u7cfb\u7d71\u4e0d\u9069\u5408\u6211\u3002"
          }
        }
      }
    },
    "assessment.fitness.q6.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trainiere lustlos genau gleich weiter und hoffe auf ein Wunder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I continue to train listlessly and hope for a miracle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigo entrenando con indiferencia y espero un milagro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je continue de m'entra\u00eener apathiquement et j'esp\u00e8re un miracle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u093f\u0928\u093e \u0938\u094b\u091a\u0947-\u0938\u092e\u091d\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0915\u093f\u0938\u0940 \u091a\u092e\u0924\u094d\u0915\u093e\u0930 \u0915\u0940 \u0906\u0936\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuo ad allenarmi svogliatamente e spero in un miracolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5947\u8de1\u3092\u9858\u3063\u3066\u7121\u6c17\u529b\u306b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u7d9a\u3051\u308b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uacc4\uc18d\ud574\uc11c \ubb34\uae30\ub825\ud558\uac8c \ud6c8\ub828\ud558\uba70 \uae30\uc801\uc744 \ubc14\ub77c\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf lusteloos trainen en hoop op een wonder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal trenuj\u0119 apatycznie i mam nadziej\u0119 na cud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuo treinando com indiferen\u00e7a e esperando um milagre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043b\u0435\u043d\u0438\u0432\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0442\u043e\u0447\u043d\u043e \u0442\u0430\u043a \u0436\u0435 \u0438 \u043d\u0430\u0434\u0435\u044e\u0441\u044c \u043d\u0430 \u0447\u0443\u0434\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131ts\u0131zca antrenman yapmaya devam ediyorum ve bir mucize olmas\u0131n\u0131 umuyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6beb\u65e0\u5174\u8da3\u5730\u7167\u65e7\u8bad\u7ec3\uff0c\u5e0c\u671b\u80fd\u591f\u6709\u5947\u8ff9\u53d1\u751f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7e7c\u7e8c\u7121\u7cbe\u6253\u91c7\u5730\u8a13\u7df4\uff0c\u5e0c\u671b\u80fd\u51fa\u73fe\u5947\u8e5f\u3002"
          }
        }
      }
    },
    "assessment.fitness.q6.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kaufe teure Supplements oder suche nach einer geheimen neuen \u00dcbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I buy expensive supplements or look for a secret new exercise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro suplementos caros o busco un nuevo ejercicio secreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ach\u00e8te des suppl\u00e9ments co\u00fbteux ou je cherche un nouvel exercice secret."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092e\u0939\u0902\u0917\u0947 \u0938\u092a\u094d\u0932\u0940\u092e\u0947\u0902\u091f\u094d\u0938 \u0916\u0930\u0940\u0926\u0924\u093e \u0939\u0942\u0902 \u092f\u093e \u0915\u093f\u0938\u0940 \u0917\u0941\u092a\u094d\u0924 \u0928\u090f \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0940 \u0924\u0932\u093e\u0936 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro integratori costosi o cerco un nuovo esercizio segreto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u4fa1\u306a\u30b5\u30d7\u30ea\u30e1\u30f3\u30c8\u3092\u8cfc\u5165\u3057\u305f\u308a\u3001\u79d8\u5bc6\u306e\u65b0\u3057\u3044\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u3092\u63a2\u3057\u305f\u308a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uac12\ube44\uc2fc \ubcf4\ucda9\uc81c\ub97c \uc0ac\uac70\ub098 \uc0c8\ub85c\uc6b4 \ube44\ubc00 \uc6b4\ub3d9\uc744 \ucc3e\ub294\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik koop dure supplementen of zoek een geheime nieuwe oefening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupuj\u0119 drogie suplementy lub szukam nowego sekretnego \u0107wiczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro suplementos caros ou procuro um novo exerc\u00edcio secreto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u043a\u0443\u043f\u0430\u044e \u0434\u043e\u0440\u043e\u0433\u0438\u0435 \u0434\u043e\u0431\u0430\u0432\u043a\u0438 \u0438\u043b\u0438 \u0438\u0449\u0443 \u043d\u043e\u0432\u043e\u0435 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahal\u0131 takviyeler al\u0131yorum veya yeni ve gizli bir egzersiz ar\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e70\u6602\u8d35\u7684\u8865\u5145\u54c1\uff0c\u6216\u8005\u5bfb\u627e\u4e00\u4e2a\u79d8\u5bc6\u7684\u65b0\u953b\u70bc\u65b9\u6cd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8cfc\u8cb7\u6602\u8cb4\u7684\u88dc\u5145\u5291\u6216\u5c0b\u627e\u79d8\u5bc6\u7684\u65b0\u904b\u52d5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q6.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich analysiere meine Ern\u00e4hrung, erh\u00f6he die Intensit\u00e4t und zwinge den K\u00f6rper zur Anpassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I analyze my diet, increase the intensity and force the body to adapt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizo mi dieta, aumento la intensidad y obligo al cuerpo a adaptarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'analyse mon alimentation, j'augmente l'intensit\u00e9 et force le corps \u00e0 s'adapter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0906\u0939\u093e\u0930 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u0924\u0940\u0935\u094d\u0930\u0924\u093e \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0936\u0930\u0940\u0930 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0915\u0947 \u0932\u093f\u090f \u092e\u091c\u092c\u0942\u0930 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizzo la mia dieta, aumento l'intensit\u00e0 e costringo il corpo ad adattarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u81ea\u5206\u306e\u98df\u4e8b\u3092\u5206\u6790\u3057\u3001\u5f37\u5ea6\u3092\u4e0a\u3052\u3066\u4f53\u3092\u5f37\u5236\u7684\u306b\u9069\u5fdc\u3055\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc2dd\ub2e8\uc744 \ubd84\uc11d\ud558\uace0 \uac15\ub3c4\ub97c \ub192\uc774\uba70 \uc2e0\uccb4\uac00 \uc801\uc751\ud558\ub3c4\ub85d \uac15\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik analyseer mijn dieet, verhoog de intensiteit en dwing het lichaam zich aan te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizuj\u0119 swoj\u0105 diet\u0119, zwi\u0119kszam jej intensywno\u015b\u0107 i zmuszam organizm do adaptacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiso minha alimenta\u00e7\u00e3o, aumento a intensidade e for\u00e7o o corpo a se adaptar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e \u0441\u0432\u043e\u0451 \u043f\u0438\u0442\u0430\u043d\u0438\u0435, \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e \u0442\u0435\u043b\u043e \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyetimi analiz ediyorum, yo\u011funlu\u011fu art\u0131r\u0131yorum ve v\u00fccudu uyum sa\u011flamaya zorluyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5206\u6790\u6211\u7684\u996e\u98df\uff0c\u589e\u52a0\u5f3a\u5ea6\uff0c\u5e76\u8feb\u4f7f\u8eab\u4f53\u9002\u5e94\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5206\u6790\u6211\u7684\u98f2\u98df\uff0c\u589e\u52a0\u5f37\u5ea6\u4e26\u8feb\u4f7f\u8eab\u9ad4\u9069\u61c9\u3002"
          }
        }
      }
    },
    "assessment.fitness.q7": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst eine schwere \u00dcbung vor anderen Leuten im Gym. Das Gewicht ist eigentlich zu schwer, um es mit sauberer Technik zu bewegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do a heavy exercise in front of other people in the gym. The weight is actually too heavy to move with proper technique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haces un ejercicio intenso delante de otras personas en el gimnasio. En realidad, el peso es demasiado pesado para moverlo con la t\u00e9cnica adecuada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous faites un exercice intense devant d\u2019autres personnes dans la salle de sport. Le poids est en fait trop lourd pour \u00eatre d\u00e9plac\u00e9 avec une technique appropri\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u091c\u093f\u092e \u092e\u0947\u0902 \u0905\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u092d\u093e\u0930\u0940 \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u091c\u093c\u0928 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0909\u091a\u093f\u0924 \u0924\u0915\u0928\u0940\u0915 \u0915\u0947 \u0938\u093e\u0925 \u0939\u093f\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u092d\u093e\u0930\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un esercizio pesante davanti ad altre persone in palestra. Il peso \u00e8 in realt\u00e0 troppo pesante per essere spostato con la tecnica adeguata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b8\u30e0\u3067\u4ed6\u306e\u4eba\u306e\u524d\u3067\u6fc0\u3057\u3044\u904b\u52d5\u3092\u3057\u307e\u3059\u3002\u5b9f\u969b\u3001\u9069\u5207\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3067\u52d5\u304b\u3059\u306b\u306f\u91cd\u91cf\u304c\u91cd\u3059\u304e\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uccb4\uc721\uad00\uc5d0\uc11c \ub2e4\ub978 \uc0ac\ub78c\ub4e4 \uc55e\uc5d0\uc11c \ubb34\uac70\uc6b4 \uc6b4\ub3d9\uc744 \ud569\ub2c8\ub2e4. \uc2e4\uc81c\ub85c \ubb34\uac8c\uac00 \ub108\ubb34 \ubb34\uac70\uc6cc\uc11c \uc801\uc808\ud55c \uae30\uc220\ub85c \uc6c0\uc9c1\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je doet een zware oefening voor andere mensen in de sportschool. Het gewicht is eigenlijk te zwaar om met de juiste techniek te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonujesz ci\u0119\u017ckie \u0107wiczenia w obecno\u015bci innych os\u00f3b na si\u0142owni. Ci\u0119\u017car jest w rzeczywisto\u015bci zbyt du\u017cy, aby mo\u017cna go by\u0142o przenie\u015b\u0107 przy odpowiedniej technice."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea faz um exerc\u00edcio pesado na frente de outras pessoas na academia. O peso \u00e9 realmente muito pesado para ser movido com a t\u00e9cnica adequada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c \u0442\u044f\u0436\u0435\u043b\u043e\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0434 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0432 \u0441\u043f\u043e\u0440\u0442\u0437\u0430\u043b\u0435. \u0412\u0435\u0441 \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0442\u044f\u0436\u0435\u043b\u044b\u0439, \u0447\u0442\u043e\u0431\u044b \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u0435\u0433\u043e \u0441 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor salonunda di\u011fer insanlar\u0131n \u00f6n\u00fcnde a\u011f\u0131r bir egzersiz yap\u0131yorsunuz. A\u011f\u0131rl\u0131k asl\u0131nda uygun teknikle hareket edemeyecek kadar a\u011f\u0131rd\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u5065\u8eab\u623f\u5f53\u7740\u522b\u4eba\u9762\u505a\u4e00\u4e2a\u5f88\u91cd\u7684\u7ec3\u4e60\u3002\u8fd9\u4e2a\u91cd\u91cf\u5b9e\u9645\u4e0a\u592a\u91cd\u4e86\uff0c\u65e0\u6cd5\u7528\u6b63\u786e\u7684\u6280\u672f\u4e3e\u8d77\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5728\u5065\u8eab\u623f\u7684\u5176\u4ed6\u4eba\u9762\u524d\u9032\u884c\u5287\u70c8\u904b\u52d5\u3002\u5be6\u969b\u4e0a\uff0c\u91cd\u91cf\u592a\u91cd\uff0c\u7121\u6cd5\u900f\u904e\u9069\u7576\u7684\u6280\u8853\u79fb\u52d5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q7.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich rei\u00dfe das Gewicht mit absolut miserabler Form hoch, um stark auszusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I pull up the weight with absolutely terrible form to look strong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanto el peso con una forma absolutamente terrible para parecer fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je soul\u00e8ve le poids avec une forme absolument terrible pour avoir l'air fort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092e\u091c\u092c\u0942\u0924 \u0926\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092d\u092f\u093e\u0928\u0915 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0935\u091c\u0928 \u0909\u0920\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevo il peso con una forma assolutamente terribile per sembrare forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f37\u305d\u3046\u306b\u898b\u305b\u308b\u305f\u3081\u306b\u3001\u3068\u3093\u3067\u3082\u306a\u304f\u3072\u3069\u3044\u30d5\u30a9\u30fc\u30e0\u3067\u91cd\u91cf\u3092\u5f15\u304d\u4e0a\u3052\u308b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac15\ud574 \ubcf4\uc774\uae30 \uc704\ud574 \uc815\ub9d0 \ud615\ud3b8\uc5c6\ub294 \ud615\ud0dc\ub85c \ubb34\uac8c\ub97c \ub04c\uc5b4\uc62c\ub9b0\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik trek het gewicht omhoog met een absoluut vreselijke vorm om er sterk uit te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podci\u0105gam ci\u0119\u017cary w absolutnie okropnej formie, \u017ceby wygl\u0105da\u0107 na silnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu levanto o peso de uma forma absolutamente terr\u00edvel para parecer forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e \u0432\u0435\u0441 \u0441 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0443\u0436\u0430\u0441\u043d\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u043e\u0439, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u0442\u044c \u0441\u0438\u043b\u044c\u043d\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fc\u00e7l\u00fc g\u00f6r\u00fcnmek i\u00e7in a\u011f\u0131rl\u0131\u011f\u0131 kesinlikle korkun\u00e7 bir formla kald\u0131r\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7528\u7edd\u5bf9\u7cdf\u7cd5\u7684\u59ff\u52bf\u63d0\u8d77\u91cd\u91cf\uff0c\u53ea\u662f\u4e3a\u4e86\u770b\u8d77\u6765\u5f3a\u58ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4ee5\u6975\u5176\u7cdf\u7cd5\u7684\u59ff\u52e2\u62c9\u8d77\u91cd\u91cf\uff0c\u4ee5\u770b\u8d77\u4f86\u5f88\u5f37\u58ef\u3002"
          }
        }
      }
    },
    "assessment.fitness.q7.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bitte jemanden, extrem viel mitzuhelfen, und behaupte danach, ich h\u00e4tte es selbst gedr\u00fcckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I ask someone to help out a lot and then claim that I did it myself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pido ayuda a alguien y luego digo que lo hice yo mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je demande beaucoup \u00e0 quelqu'un de m'aider et je pr\u00e9tends ensuite que je l'ai fait moi-m\u00eame."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u093f\u0938\u0940 \u0938\u0947 \u092c\u0939\u0941\u0924 \u092e\u0926\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0926\u093e\u0935\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092f\u0939 \u092e\u0948\u0902\u0928\u0947 \u0916\u0941\u0926 \u0915\u093f\u092f\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedo a qualcuno di aiutarmi molto e poi affermo di averlo fatto da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ab0\u304b\u306b\u305f\u304f\u3055\u3093\u624b\u4f1d\u3063\u3066\u3082\u3089\u3063\u3066\u3001\u305d\u308c\u3092\u81ea\u5206\u3067\u3084\u3063\u305f\u3068\u4e3b\u5f35\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub204\uad70\uac00\uc5d0\uac8c \ub9ce\uc740 \ub3c4\uc6c0\uc744 \uc694\uccad\ud55c \ub2e4\uc74c \ub0b4\uac00 \uc9c1\uc811 \ud588\ub2e4\uace0 \uc8fc\uc7a5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik vraag iemand om veel te helpen en beweer dan dat ik het zelf heb gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bardzo prosz\u0119 kogo\u015b o pomoc, a potem twierdz\u0119, \u017ce sam to zrobi\u0142em."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe\u00e7o muita ajuda a algu\u00e9m e depois afirmo que fui eu quem fez isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0448\u0443 \u043a\u043e\u0433\u043e-\u0442\u043e \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u043c\u043e\u0447\u044c \u0438 \u0437\u0430\u0442\u0435\u043c \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e, \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b \u044d\u0442\u043e \u0441\u0430\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinden \u00e7ok yard\u0131m etmesini rica ediyorum ve sonra bunu kendim yapt\u0131\u011f\u0131m\u0131 iddia ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8bf7\u67d0\u4eba\u5e2e\u5fd9\u505a\u5927\u91cf\u5de5\u4f5c\uff0c\u7136\u540e\u58f0\u79f0\u6211\u662f\u81ea\u5df1\u505a\u7684\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8acb\u5225\u4eba\u5e6b\u5fd9\u5f88\u591a\uff0c\u7136\u5f8c\u53c8\u8072\u7a31\u662f\u6211\u81ea\u5df1\u505a\u7684\u3002"
          }
        }
      }
    },
    "assessment.fitness.q7.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lege Gewicht ab, bis ich es mit perfekter Form schaffe, auch wenn es peinlich wenig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I lose weight until I can do it with perfect form, even if it's embarrassingly small."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdo peso hasta que puedo hacerlo en perfecta forma, aunque sea vergonzosamente peque\u00f1o."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je perds du poids jusqu'\u00e0 ce que je puisse le faire avec une forme parfaite, m\u00eame si c'est embarrassant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u093e \u0935\u091c\u093c\u0928 \u0924\u092c \u0924\u0915 \u0918\u091f\u093e\u0924\u093e \u0939\u0942\u0901 \u091c\u092c \u0924\u0915 \u0915\u093f \u092e\u0948\u0902 \u0907\u0938\u0947 \u0938\u0939\u0940 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u0924\u093e, \u092d\u0932\u0947 \u0939\u0940 \u092f\u0939 \u0936\u0930\u094d\u092e\u0928\u093e\u0915 \u0930\u0942\u092a \u0938\u0947 \u091b\u094b\u091f\u093e \u0939\u0940 \u0915\u094d\u092f\u094b\u0902 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdo peso finch\u00e9 riesco a farlo con una forma perfetta, anche se \u00e8 imbarazzantemente piccola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305f\u3068\u3048\u6065\u305a\u304b\u3057\u3044\u307b\u3069\u5c0f\u3055\u304f\u3066\u3082\u3001\u5b8c\u74a7\u306a\u30d5\u30a9\u30fc\u30e0\u3067\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u307e\u3067\u4f53\u91cd\u3092\u6e1b\u3089\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubd80\ub044\ub7ec\uc6b8 \uc815\ub3c4\ub85c \uc791\ub354\ub77c\ub3c4 \uc644\ubcbd\ud55c \ud615\ud0dc\ub85c \ud560 \uc218 \uc788\uc744 \ub54c\uae4c\uc9c0 \uccb4\uc911\uc744 \uac10\ub7c9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik val af totdat ik het in een perfecte vorm kan doen, ook al is het beschamend klein."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trac\u0119 wag\u0119, dop\u00f3ki nie uda mi si\u0119 tego osi\u0105gn\u0105\u0107 w doskona\u0142ej formie, nawet je\u015bli jest ona \u017cenuj\u0105co ma\u0142a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu perco peso at\u00e9 conseguir fazer isso de forma perfeita, mesmo que seja embara\u00e7osamente pequeno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u044e \u0432\u0435\u0441, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0441\u043c\u043e\u0433\u0443 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u044d\u0442\u043e \u0441 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0442\u0435\u0445\u043d\u0438\u043a\u043e\u0439, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0435\u0433\u043e \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043c\u0430\u043b\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan\u00e7 verici derecede k\u00fc\u00e7\u00fck olsa bile, m\u00fckemmel bir formda olana kadar kilo veriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u51cf\u8f7b\u91cd\u91cf\uff0c\u76f4\u5230\u6211\u80fd\u4ee5\u5b8c\u7f8e\u7684\u59ff\u52bf\u5b8c\u6210\uff0c\u5373\u4f7f\u91cd\u91cf\u5c11\u5f97\u53ef\u601c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u6e1b\u80a5\uff0c\u76f4\u5230\u6211\u80fd\u4ee5\u5b8c\u7f8e\u7684\u5f62\u5f0f\u6e1b\u80a5\uff0c\u5373\u4f7f\u5b83\u5c0f\u5f97\u4ee4\u4eba\u5c37\u5c2c\u3002"
          }
        }
      }
    },
    "assessment.fitness.q7.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trainiere sowieso nur an gef\u00fchrten Maschinen, weil mir freie Gewichte zu anstrengend sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I only train on guided machines anyway because free weights are too strenuous for me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De todos modos, solo entreno en m\u00e1quinas guiadas porque las pesas libres son demasiado agotadoras para m\u00ed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De toute fa\u00e7on, je ne m'entra\u00eene que sur des machines guid\u00e9es, car les poids libres sont trop fatigants pour moi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0935\u0948\u0938\u0947 \u092d\u0940 \u0915\u0947\u0935\u0932 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0924 \u092e\u0936\u0940\u0928\u094b\u0902 \u092a\u0930 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0941\u092b\u094d\u0924 \u0935\u091c\u0928 \u092e\u0947\u0930\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u0915\u0920\u093f\u0928 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ogni caso mi alleno solo su macchine guidate perch\u00e9 i pesi liberi sono troppo faticosi per me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30ea\u30fc\u30a6\u30a7\u30a4\u30c8\u306f\u79c1\u306b\u3068\u3063\u3066\u6fc0\u3057\u3059\u304e\u308b\u306e\u3067\u3001\u3068\u306b\u304b\u304f\u30ac\u30a4\u30c9\u4ed8\u304d\u30de\u30b7\u30f3\u3067\u306e\u307f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub9ac \uc6e8\uc774\ud2b8\ub294 \ub098\uc5d0\uac8c \ub108\ubb34 \ud798\ub4e4\uae30 \ub54c\ubb38\uc5d0 \uc5b4\uca0c\ub4e0 \uac00\uc774\ub4dc \uba38\uc2e0\uc5d0\uc11c\ub9cc \ud6c8\ub828\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik train sowieso alleen op geleide machines, omdat losse gewichten mij te zwaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "I tak trenuj\u0119 tylko na maszynach z prowadzeniem, bo wolne ci\u0119\u017cary s\u0105 dla mnie za du\u017ce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer forma, eu s\u00f3 treino em m\u00e1quinas guiadas porque pesos livres s\u00e3o muito cansativos para mim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u044e\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0442\u0440\u0435\u043d\u0430\u0436\u0451\u0440\u0430\u0445, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0435 \u0432\u0435\u0441\u0430 \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten sadece g\u00fcd\u00fcml\u00fc makinelerle antrenman yap\u0131yorum \u00e7\u00fcnk\u00fc serbest a\u011f\u0131rl\u0131klar benim i\u00e7in \u00e7ok yorucu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53cd\u6b63\u53ea\u5728\u5668\u68b0\u4e0a\u953b\u70bc\uff0c\u56e0\u4e3a\u81ea\u7531\u91cd\u91cf\u592a\u7d2f\u4eba\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u8ad6\u5982\u4f55\uff0c\u6211\u53ea\u5728\u5f15\u5c0e\u6a5f\u5668\u4e0a\u8a13\u7df4\uff0c\u56e0\u70ba\u81ea\u7531\u91cd\u91cf\u5c0d\u6211\u4f86\u8aaa\u592a\u8cbb\u529b\u4e86\u3002"
          }
        }
      }
    },
    "assessment.fitness.q8": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf dem Weg zum Training. Deine Freunde rufen an: 'Komm sofort her, wir haben Pizza bestellt und fangen gleich an zu zocken!'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on your way to training. Your friends call: 'Come here now, we've ordered pizza and we're about to start playing!'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s en camino al entrenamiento. Tus amigos llaman: '\u00a1Ven aqu\u00ed ahora, hemos pedido pizza y estamos a punto de empezar a jugar!'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates en route pour l'entra\u00eenement. Vos amis vous appellent : \u00ab Viens ici maintenant, nous avons command\u00e9 une pizza et nous allons commencer \u00e0 jouer !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u092e\u093f\u0924\u094d\u0930 \u0915\u0949\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902: '\u0905\u092d\u0940 \u092f\u0939\u093e\u0901 \u0906\u0913, \u0939\u092e\u0928\u0947 \u092a\u093f\u091c\u093c\u094d\u091c\u093c\u093e \u0911\u0930\u094d\u0921\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948 \u0914\u0930 \u0939\u092e \u0916\u0947\u0932\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902!'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai andando ad allenarti. I tuoi amici chiamano: 'Vieni qui adesso, abbiamo ordinato la pizza e stiamo per iniziare a giocare!'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u5411\u304b\u3063\u3066\u3044\u307e\u3059\u3002\u53cb\u9054\u304c\u300c\u3055\u3042\u3001\u3053\u3053\u306b\u6765\u3066\u3001\u30d4\u30b6\u3092\u6ce8\u6587\u3057\u305f\u304b\u3089\u3001\u3053\u308c\u304b\u3089\u904a\u3073\u59cb\u3081\u308b\u3088\uff01\u300d\u3068\u547c\u3073\u304b\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud6c8\ub828\ud558\ub7ec \uac00\ub294 \uc911\uc774\uad70\uc694. \uce5c\uad6c\ub4e4\uc774 \uc804\ud654\ud569\ub2c8\ub2e4. '\uc9c0\uae08 \uc774\ub9ac \uc624\uc138\uc694. \ud53c\uc790\ub97c \uc8fc\ubb38\ud588\uace0 \uc774\uc81c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uaca0\uc2b5\ub2c8\ub2e4!'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent op weg naar een training. Je vrienden roepen: 'Kom nu hier, we hebben pizza besteld en we gaan spelen!'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b w drodze na trening. Twoi znajomi dzwoni\u0105: \u201ePrzyjd\u017a teraz, zam\u00f3wili\u015bmy pizz\u0119 i zaraz zaczynamy gra\u0107!\u201d"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 a caminho do treinamento. Seus amigos ligam: 'Venha aqui agora, pedimos pizza e vamos come\u00e7ar a brincar!'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043d\u0430 \u043f\u0443\u0442\u0438 \u043d\u0430 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443. \u0422\u0432\u043e\u0438 \u0434\u0440\u0443\u0437\u044c\u044f \u0437\u0432\u043e\u043d\u044f\u0442: '\u041f\u0440\u0438\u0445\u043e\u0434\u0438 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u043c\u044b \u0437\u0430\u043a\u0430\u0437\u0430\u043b\u0438 \u043f\u0438\u0446\u0446\u0443 \u0438 \u0441\u043a\u043e\u0440\u043e \u043d\u0430\u0447\u043d\u0435\u043c \u0438\u0433\u0440\u0430\u0442\u044c!'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u011fitime do\u011fru gidiyorsun. Arkada\u015flar\u0131n\u0131z sesleniyor: '\u015eimdi buraya gelin, pizza sipari\u015f ettik ve oynamaya ba\u015flamak \u00fczereyiz!'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u8981\u53bb\u8bad\u7ec3\u3002\u4f60\u7684\u670b\u53cb\u6253\u7535\u8bdd\u6765\u8bf4\uff1a\u2018\u5feb\u8fc7\u6765\uff0c\u6211\u4eec\u8ba2\u4e86\u62ab\u8428\uff0c\u9a6c\u4e0a\u5f00\u59cb\u73a9\u6e38\u620f\uff01\u2019"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u5728\u53bb\u8a13\u7df4\u7684\u8def\u4e0a\u3002\u4f60\u7684\u670b\u53cb\u558a\u9053\uff1a\u201c\u73fe\u5728\u904e\u4f86\uff0c\u6211\u5011\u5df2\u7d93\u9ede\u4e86\u62ab\u85a9\uff0c\u6211\u5011\u8981\u958b\u59cb\u73a9\u4e86\uff01\u201d"
          }
        }
      }
    },
    "assessment.fitness.q8.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich drehe sofort um. Man ist nur einmal jung und Training kann man nachholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I turn around immediately. You are only young once and you can catch up on training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me doy la vuelta inmediatamente. S\u00f3lo eres joven una vez y puedes ponerte al d\u00eda con el entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me retourne imm\u00e9diatement. On n'est jeune qu'une fois et on peut rattraper son retard en s'entra\u00eenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0924\u0941\u0930\u0902\u0924 \u092a\u0932\u091f \u091c\u093e\u0924\u093e \u0939\u0942\u0902. \u0906\u092a \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u092f\u0941\u0935\u093e \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi giro subito. Sei giovane solo una volta e puoi recuperare il ritardo con l'allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3059\u3050\u306b\u632f\u308a\u5411\u304f\u3002\u82e5\u3044\u306e\u306f\u4e00\u5ea6\u3060\u3051\u3001\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3067\u8ffd\u3044\u3064\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc989\uc2dc \ub3cc\uc544\uc130\ub2e4. \ub2f9\uc2e0\uc740 \ud55c \ubc88\ub9cc \uc80a\uace0 \ud6c8\ub828\uc744 \ub530\ub77c\uc7a1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik draai me meteen om. Je bent maar \u00e9\u00e9n keer jong en je kunt een opleiding inhalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast si\u0119 odwracam. M\u0142odym jeste\u015b tylko raz i mo\u017cesz nadrobi\u0107 zaleg\u0142o\u015bci w treningach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me viro imediatamente. Voc\u00ea s\u00f3 \u00e9 jovem uma vez e pode atualizar o treinamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u044e\u0441\u044c. \u041c\u043e\u043b\u043e\u0434\u044b\u043c\u0438 \u043c\u044b \u0431\u044b\u0432\u0430\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437, \u0430 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0432\u0435\u0440\u0441\u0442\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen arkam\u0131 d\u00f6n\u00fcyorum. Sadece bir kez gen\u00e7 olursunuz ve antrenmanlara yeti\u015febilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u5c31\u6389\u5934\u56de\u53bb\u3002\u4eba\u53ea\u5e74\u8f7b\u4e00\u6b21\uff0c\u8bad\u7ec3\u53ef\u4ee5\u8865\u4e0a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u5373\u8f49\u8eab\u3002\u5e74\u8f15\u53ea\u6709\u4e00\u6b21\uff0c\u4f60\u53ef\u4ee5\u900f\u904e\u8a13\u7df4\u4f86\u8d95\u4e0a\u3002"
          }
        }
      }
    },
    "assessment.fitness.q8.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fahre hin, habe aber ein extrem schlechtes Gewissen dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm going there, but I have an extremely bad conscience about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voy all\u00ed, pero tengo muy mala conciencia al respecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'y vais, mais j'ai extr\u00eamement mauvaise conscience."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0935\u0939\u093e\u0902 \u091c\u093e \u0930\u0939\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u0905\u0902\u0924\u0930\u093e\u0924\u094d\u092e\u093e \u092c\u0947\u0939\u0926 \u0916\u0930\u093e\u092c \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci andr\u00f2, ma ho la coscienza estremamente sporca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u305d\u3053\u306b\u884c\u304f\u3064\u3082\u308a\u3067\u3059\u304c\u3001\u305d\u308c\u306b\u3064\u3044\u3066\u975e\u5e38\u306b\u60aa\u3044\u826f\u5fc3\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uac70\uae30\uc5d0 \uac08 \uc608\uc815\uc774\uc9c0\ub9cc \uadf8\uac83\uc5d0 \ub300\ud574 \ub9e4\uc6b0 \ub098\uc05c \uc591\uc2ec\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga erheen, maar ik heb er een buitengewoon slecht geweten over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chodz\u0119 tam, ale mam z tego powodu ogromne wyrzuty sumienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou para l\u00e1, mas estou com a consci\u00eancia extremamente pesada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0435\u0434\u0443 \u0442\u0443\u0434\u0430, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0443 \u043c\u0435\u043d\u044f \u0443\u0436\u0430\u0441\u043d\u043e\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0432\u0438\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraya gidiyorum ama bu konuda son derece vicdan azab\u0131 \u00e7ekiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53bb\u90a3\u91cc\uff0c\u4f46\u5fc3\u91cc\u975e\u5e38\u5185\u759a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8981\u53bb\u90a3\u88e1\uff0c\u4f46\u6211\u5c0d\u6b64\u611f\u5230\u975e\u5e38\u6127\u759a\u3002"
          }
        }
      }
    },
    "assessment.fitness.q8.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage ihnen, dass ich in 60 Minuten komme, und ziehe mein Workout vorher in Rekordzeit durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I tell them I'll be there in 60 minutes and do my workout beforehand in record time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Les digo que estar\u00e9 all\u00ed en 60 minutos y har\u00e9 mi entrenamiento antes en un tiempo r\u00e9cord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je leur dis que je serai l\u00e0 dans 60 minutes et que je ferai mon entra\u00eenement \u00e0 l'avance en un temps record."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0909\u0928\u0938\u0947 \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0948\u0902 60 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0935\u0939\u093e\u0902 \u092a\u0939\u0941\u0902\u091a \u091c\u093e\u090a\u0902\u0917\u093e \u0914\u0930 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0938\u092e\u092f \u092e\u0947\u0902 \u0905\u092a\u0928\u093e \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u092a\u0939\u0932\u0947 \u0939\u0940 \u0915\u0930 \u0932\u0942\u0902\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico loro che sar\u00f2 l\u00ec tra 60 minuti e che far\u00f2 il mio allenamento in anticipo a tempo di record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5f7c\u3089\u306b60\u5206\u4ee5\u5185\u306b\u5230\u7740\u3059\u308b\u3053\u3068\u3092\u4f1d\u3048\u3001\u4e8b\u524d\u306b\u8a18\u9332\u7684\u306a\u901f\u3055\u3067\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u3057\u3066\u304a\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uadf8\ub4e4\uc5d0\uac8c 60\ubd84 \ud6c4\uc5d0 \ub3c4\ucc29\ud560 \uac83\uc774\ub77c\uace0 \ub9d0\ud558\uace0 \uae30\ub85d\uc801\uc778 \uc2dc\uac04 \ub0b4\uc5d0 \ubbf8\ub9ac \uc6b4\ub3d9\uc744 \ud560 \uac83\uc774\ub77c\uace0 \ub9d0\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik vertel ze dat ik er over 60 minuten ben en doe mijn training vooraf in recordtijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3wi\u0119 im, \u017ce b\u0119d\u0119 na miejscu za 60 minut i wykonam trening wcze\u015bniej w rekordowym czasie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo a eles que estarei l\u00e1 em 60 minutos e farei meu treino antes em tempo recorde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u043e\u0432\u043e\u0440\u044e \u0438\u043c, \u0447\u0442\u043e \u043f\u0440\u0438\u0434\u0443 \u0447\u0435\u0440\u0435\u0437 60 \u043c\u0438\u043d\u0443\u0442, \u0438 \u043f\u0440\u043e\u0432\u043e\u0436\u0443 \u0441\u0432\u043e\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443 \u0440\u0430\u043d\u044c\u0448\u0435 \u0432 \u0440\u0435\u043a\u043e\u0440\u0434\u043d\u044b\u0435 \u0441\u0440\u043e\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onlara 60 dakika i\u00e7inde orada olaca\u011f\u0131m\u0131 ve rekor s\u00fcrede antrenman\u0131m\u0131 yapaca\u011f\u0131m\u0131 s\u00f6yl\u00fcyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u544a\u8bc9\u4ed6\u4eec\u621160\u5206\u949f\u540e\u5230\uff0c\u5e76\u5728\u4e4b\u524d\u4ee5\u521b\u7eaa\u5f55\u7684\u901f\u5ea6\u5b8c\u6210\u6211\u7684\u953b\u70bc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u544a\u8a34\u4ed6\u5011\u6211\u6703\u5728 60 \u5206\u9418\u5167\u5230\u9054\u90a3\u88e1\uff0c\u4e26\u4ee5\u5275\u7d00\u9304\u7684\u6642\u9593\u63d0\u524d\u505a\u597d\u935b\u934a\u3002"
          }
        }
      }
    },
    "assessment.fitness.q8.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lehne eiskalt ab. Meine Workout-Zeiten sind nicht verhandelbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I coldly refuse. My workout times are non-negotiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me niego fr\u00edamente. Mis tiempos de entrenamiento no son negociables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je refuse froidement. Mes horaires d'entra\u00eenement ne sont pas n\u00e9gociables."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902\u0928\u0947 \u092c\u0947\u0930\u0941\u0916\u0940 \u0938\u0947 \u092e\u0928\u093e \u0915\u0930 \u0926\u093f\u092f\u093e. \u092e\u0947\u0930\u0947 \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0915\u0947 \u0938\u092e\u092f \u092a\u0930 \u0938\u092e\u091d\u094c\u0924\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi rifiuto freddamente. I miei tempi di allenamento non sono negoziabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51b7\u305f\u304f\u304a\u65ad\u308a\u3057\u307e\u3059\u3002\u79c1\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u6642\u9593\u306f\u4ea4\u6e09\u306e\u4f59\u5730\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ucc28\uac11\uac8c \uac70\uc808\ud55c\ub2e4. \ub0b4 \uc6b4\ub3d9 \uc2dc\uac04\uc740 \ud611\uc0c1\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik weiger koelbloedig. Mijn trainingstijden zijn niet onderhandelbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zimno odmawiam. Moje godziny trening\u00f3w nie podlegaj\u0105 negocjacjom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu recuso friamente. Meus hor\u00e1rios de treino n\u00e3o s\u00e3o negoci\u00e1veis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0441\u044c. \u041c\u043e\u0438 \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043e\u043a \u043d\u0435 \u043f\u043e\u0434\u043b\u0435\u0436\u0438\u0442 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "So\u011fukkanl\u0131l\u0131kla reddediyorum. Antrenman saatlerim tart\u0131\u015f\u0131lamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u575a\u51b3\u62d2\u7edd\u3002\u6211\u7684\u953b\u70bc\u65f6\u95f4\u4e0d\u5bb9\u534f\u5546\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u51b7\u51b7\u62d2\u7d55\u3002\u6211\u7684\u904b\u52d5\u6642\u9593\u662f\u6c92\u6709\u5546\u91cf\u9918\u5730\u7684\u3002"
          }
        }
      }
    },
    "assessment.fitness.q9": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie genau dokumentierst du deine Trainingsfortschritte (Gewichte, Zeiten, Wiederholungen)?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How exactly do you document your training progress (weights, times, repetitions)?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfC\u00f3mo documentas exactamente tu progreso en el entrenamiento (pesos, tiempos, repeticiones)?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment documentez-vous exactement vos progr\u00e8s d\u2019entra\u00eenement (poids, dur\u00e9es, r\u00e9p\u00e9titions)\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u092a\u094d\u0930\u0917\u0924\u093f (\u0935\u091c\u0928, \u0938\u092e\u092f, \u0926\u094b\u0939\u0930\u093e\u0935) \u0915\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u0940\u0915\u0930\u0923 \u0915\u0948\u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come documenti esattamente i tuoi progressi nell'allenamento (pesi, tempi, ripetizioni)?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306e\u9032\u6357\u72b6\u6cc1 (\u91cd\u91cf\u3001\u56de\u6570\u3001\u7e70\u308a\u8fd4\u3057) \u3092\u3069\u306e\u3088\u3046\u306b\u6b63\u78ba\u306b\u8a18\u9332\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud6c8\ub828 \uc9c4\ud589 \uc0c1\ud669(\ubb34\uac8c, \ud69f\uc218, \ubc18\ubcf5)\uc744 \uc815\ud655\ud788 \uc5b4\ub5bb\uac8c \ubb38\uc11c\ud654\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe documenteer je precies je trainingsvoortgang (gewichten, tijden, herhalingen)?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak dok\u0142adnie dokumentujesz swoje post\u0119py treningowe (ci\u0119\u017cary, czasy, powt\u00f3rzenia)?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como exatamente voc\u00ea documenta o progresso do seu treinamento (pesos, tempos, repeti\u00e7\u00f5es)?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u044b \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u0435\u0448\u044c \u0441\u0432\u043e\u0438 \u0443\u0441\u043f\u0435\u0445\u0438 \u0432 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430\u0445 (\u0432\u0435\u0441\u0430, \u0432\u0440\u0435\u043c\u044f, \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u044f)?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman ilerlemenizi tam olarak nas\u0131l belgeliyorsunuz (a\u011f\u0131rl\u0131klar, s\u00fcreler, tekrarlar)?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u662f\u5982\u4f55\u51c6\u786e\u8bb0\u5f55\u4f60\u7684\u8bad\u7ec3\u8fdb\u5c55\uff08\u91cd\u91cf\u3001\u65f6\u95f4\u3001\u6b21\u6570\uff09\u7684\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7a76\u7adf\u5982\u4f55\u8a18\u9304\u60a8\u7684\u8a13\u7df4\u9032\u5ea6\uff08\u91cd\u91cf\u3001\u6642\u9593\u3001\u91cd\u8907\u6b21\u6578\uff09\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q9.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gar nicht. Ich mache das, worauf ich an dem Tag spontan Lust habe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not at all. I do whatever I spontaneously feel like doing that day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De nada. Hago lo que me apetece espont\u00e1neamente ese d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas du tout. Je fais ce que j\u2019ai spontan\u00e9ment envie de faire ce jour-l\u00e0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0928\u0939\u0940\u0902\u0964 \u092e\u0948\u0902 \u0909\u0938 \u0926\u093f\u0928 \u0935\u0939\u0940 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u091c\u094b \u092e\u0941\u091d\u0947 \u0905\u0928\u093e\u092f\u093e\u0938 \u0915\u0930\u0928\u0947 \u0915\u093e \u092e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affatto. Faccio qualunque cosa mi venga spontaneamente voglia di fare quel giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5168\u304f\u306a\u3044\u3002\u305d\u306e\u65e5\u3084\u308a\u305f\u3044\u3068\u601d\u3063\u305f\u3053\u3068\u306f\u4f55\u3067\u3082\u3084\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcc4\ub9d0\uc500\uc744\uc694. \ub098\ub294 \uadf8\ub0a0 \uc989\ud765\uc801\uc73c\ub85c \ud558\uace0 \uc2f6\uc740 \uc77c\uc744 \ubb34\uc5c7\uc774\ub4e0 \ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helemaal niet. Ik doe die dag waar ik spontaan zin in heb."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zupe\u0142nie nie. Robi\u0119 to, na co spontanicznie mam ochot\u0119 danego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De jeito nenhum. Fa\u00e7o tudo o que tenho vontade de fazer espontaneamente naquele dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0432\u0441\u0435\u043c \u043d\u0435\u0442. \u042f \u0434\u0435\u043b\u0430\u044e \u0442\u043e, \u0447\u0435\u0433\u043e \u043c\u043d\u0435 \u0432 \u0442\u043e\u0442 \u0434\u0435\u043d\u044c \u0441\u043f\u043e\u043d\u0442\u0430\u043d\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u00e7 de bile. O g\u00fcn kendili\u011finden ne yapmak istersem onu \u200b\u200byap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u70b9\u4e5f\u4e0d\u3002\u6211\u505a\u7684\u662f\u90a3\u5929\u6211\u5373\u5174\u60f3\u505a\u7684\u4e8b\u60c5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u9ede\u4e5f\u4e0d\u3002\u90a3\u5929\u6211\u6703\u505a\u4efb\u4f55\u6211\u81ea\u767c\u6027\u60f3\u505a\u7684\u4e8b\u60c5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q9.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich merke mir das ungef\u00e4hr im Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I remember that pretty much in my head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo recuerdo pr\u00e1cticamente en mi cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'en souviens assez bien dans ma t\u00eate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092c\u093e\u0924 \u092e\u0941\u091d\u0947 \u0905\u092a\u0928\u0947 \u0926\u093f\u092e\u093e\u0917\u093c \u092e\u0947\u0902 \u0915\u093e\u092b\u093c\u0940 \u0939\u0926 \u0924\u0915 \u092f\u093e\u0926 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Me lo ricordo praticamente nella mia testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u308c\u306f\u304b\u306a\u308a\u982d\u306e\u4e2d\u3067\u899a\u3048\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uadf8\uac83\uc744 \ub0b4 \uba38\ub9ac \uc18d\uc5d0 \uac70\uc758 \uae30\uc5b5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik herinner me dat nog zo ongeveer in mijn hoofd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pami\u0119tam to mniej wi\u0119cej w swojej g\u0142owie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me lembro disso muito bem na minha cabe\u00e7a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0434\u0435\u0440\u0436\u0443 \u044d\u0442\u043e \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0432 \u0433\u043e\u043b\u043e\u0432\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kafamda hemen hemen hat\u0131rl\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5927\u6982\u5728\u8111\u5b50\u91cc\u8bb0\u4f4f\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u8166\u5b50\u88e1\u8a18\u5f97\u5f88\u6e05\u695a\u3002"
          }
        }
      }
    },
    "assessment.fitness.q9.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe einen groben Plan auf dem Handy und trage ab und zu mal was ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have a rough plan on my phone and enter something every now and then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengo un plan aproximado en mi tel\u00e9fono e ingreso algo de vez en cuando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai un plan approximatif sur mon t\u00e9l\u00e9phone et je saisis quelque chose de temps en temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0947\u0930\u0947 \u092b\u094b\u0928 \u092a\u0930 \u090f\u0915 \u092e\u094b\u091f\u093e \u092a\u094d\u0932\u093e\u0928 \u0939\u0948 \u0914\u0930 \u092e\u0948\u0902 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0915\u0941\u091b \u0928 \u0915\u0941\u091b \u0921\u093e\u0932\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho un piano approssimativo sul telefono e ogni tanto inserisco qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u643a\u5e2f\u96fb\u8a71\u306b\u5927\u307e\u304b\u306a\u8a08\u753b\u3092\u7acb\u3066\u3066\u3001\u6642\u3005\u4f55\u304b\u3092\u5165\u529b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud734\ub300\ud3f0\uc5d0 \ub300\ub7b5\uc801\uc778 \uacc4\ud68d\uc744 \uc138\uc6b0\uace0 \uac00\ub054\uc529 \ubb34\uc5b8\uac00\ub97c \uc785\ub825\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb een grof plan op mijn telefoon en voer zo nu en dan iets in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam w telefonie przybli\u017cony plan i od czasu do czasu co\u015b wpisuj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenho um plano aproximado no meu telefone e digito algo de vez em quando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u043c\u0435\u043d\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0435\u0441\u0442\u044c \u0433\u0440\u0443\u0431\u044b\u0439 \u043f\u043b\u0430\u043d, \u0438 \u0438\u043d\u043e\u0433\u0434\u0430 \u044f \u0447\u0442\u043e-\u0442\u043e \u0432 \u043d\u0435\u0433\u043e \u0432\u043d\u043e\u0448\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonumda kaba bir plan var ve ara s\u0131ra bir \u015feyler giriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u624b\u673a\u4e0a\u6709\u4e00\u4e2a\u5927\u81f4\u7684\u8ba1\u5212\uff0c\u5e76\u4e14\u4e0d\u65f6\u4f1a\u8bb0\u5f55\u4e00\u4e9b\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u624b\u6a5f\u4e0a\u6709\u4e00\u500b\u7c97\u7565\u7684\u8a08\u5283\uff0c\u6642\u4e0d\u6642\u5730\u8f38\u5165\u4e00\u4e9b\u6771\u897f\u3002"
          }
        }
      }
    },
    "assessment.fitness.q9.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einheit, jedes Gewicht und jede Zeit wird pr\u00e4zise geloggt. Ohne Daten kein Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every unit, every weight and every time is logged precisely. Without data, there is no growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada unidad, cada peso y cada tiempo se registran con precisi\u00f3n. Sin datos no hay crecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque unit\u00e9, chaque poids et chaque temps sont enregistr\u00e9s avec pr\u00e9cision. Sans donn\u00e9es, pas de croissance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0907\u0915\u093e\u0908, \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092d\u093e\u0930 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u092e\u092f \u0915\u094b \u0938\u091f\u0940\u0915 \u0930\u0942\u092a \u0938\u0947 \u0932\u0949\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0921\u0947\u091f\u093e \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u094b\u0908 \u0935\u093f\u0915\u093e\u0938 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni unit\u00e0, ogni peso e ogni tempo vengono registrati con precisione. Senza dati non c\u2019\u00e8 crescita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u5358\u4f4d\u3001\u3059\u3079\u3066\u306e\u91cd\u91cf\u3001\u3059\u3079\u3066\u306e\u6642\u9593\u304c\u6b63\u78ba\u306b\u8a18\u9332\u3055\u308c\u307e\u3059\u3002\u30c7\u30fc\u30bf\u304c\u306a\u3051\u308c\u3070\u6210\u9577\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \ub2e8\uc704, \ubaa8\ub4e0 \uc911\ub7c9 \ubc0f \ubaa8\ub4e0 \uc2dc\uac04\uc774 \uc815\ud655\ud558\uac8c \uae30\ub85d\ub429\ub2c8\ub2e4. \ub370\uc774\ud130\uac00 \uc5c6\uc73c\uba74 \uc131\uc7a5\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke eenheid, elk gewicht en elke tijd wordt nauwkeurig geregistreerd. Zonder data is er geen groei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cda jednostka, ka\u017cda waga i ka\u017cdy czas s\u0105 precyzyjnie rejestrowane. Bez danych nie ma wzrostu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada unidade, cada peso e cada tempo s\u00e3o registrados com precis\u00e3o. Sem dados n\u00e3o h\u00e1 crescimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u043e\u0435 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435, \u043a\u0430\u0436\u0434\u044b\u0439 \u0432\u0435\u0441 \u0438 \u043a\u0430\u0436\u0434\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0442\u043e\u0447\u043d\u043e. \u0411\u0435\u0437 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0435\u0442 \u0440\u043e\u0441\u0442\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her birim, her a\u011f\u0131rl\u0131k ve her zaman tam olarak kaydedilir. Veri olmadan b\u00fcy\u00fcme olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u4e2a\u5355\u4f4d\u3001\u6bcf\u4e2a\u91cd\u91cf\u548c\u6bcf\u4e2a\u65f6\u95f4\u90fd\u4f1a\u88ab\u7cbe\u786e\u8bb0\u5f55\u3002\u6ca1\u6709\u6570\u636e\u5c31\u6ca1\u6709\u6210\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u500b\u55ae\u4f4d\u3001\u6bcf\u500b\u91cd\u91cf\u548c\u6bcf\u6b21\u6642\u9593\u90fd\u88ab\u7cbe\u78ba\u8a18\u9304\u3002\u6c92\u6709\u6578\u64da\u5c31\u6c92\u6709\u6210\u9577\u3002"
          }
        }
      }
    },
    "assessment.fitness.q10": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist eine Woche im Urlaub oder auf einem Schul-Ausflug. Es gibt kein Gym und du hast keine Ausr\u00fcstung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are on vacation or on a school trip for a week. There is no gym and you have no equipment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s de vacaciones o de viaje escolar durante una semana. No hay gimnasio y no tienes equipamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates en vacances ou en voyage scolaire pour une semaine. Il n'y a pas de salle de sport et vous n'avez aucun \u00e9quipement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u090f\u0915 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u091b\u0941\u091f\u094d\u091f\u0940 \u092a\u0930 \u0939\u0948\u0902 \u092f\u093e \u0938\u094d\u0915\u0942\u0932 \u092f\u093e\u0924\u094d\u0930\u093e \u092a\u0930 \u0939\u0948\u0902\u0964 \u0935\u0939\u093e\u0901 \u0915\u094b\u0908 \u091c\u093f\u092e \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0915\u094b\u0908 \u0909\u092a\u0915\u0930\u0923 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in vacanza o in gita scolastica per una settimana. Non c'\u00e8 palestra e non hai attrezzature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u4e00\u9031\u9593\u306e\u4f11\u6687\u307e\u305f\u306f\u4fee\u5b66\u65c5\u884c\u4e2d\u3067\u3059\u3002\u30b8\u30e0\u306f\u306a\u304f\u3001\u5668\u5177\u3082\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc77c\uc8fc\uc77c\uac04 \ud734\uac00\ub098 \uc218\ud559\uc5ec\ud589 \uc911\uc785\ub2c8\ub2e4. \uccb4\uc721\uad00\ub3c4 \uc5c6\uace0 \uc7a5\ube44\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een week op vakantie of op schoolreisje. Er is geen sportschool en je hebt geen apparatuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b na tygodniowym urlopie lub wycieczce szkolnej. Nie ma si\u0142owni i nie masz sprz\u0119tu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 de f\u00e9rias ou em viagem escolar por uma semana. N\u00e3o h\u00e1 academia e voc\u00ea n\u00e3o tem equipamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0432 \u043e\u0442\u043f\u0443\u0441\u043a\u0435 \u0438\u043b\u0438 \u043d\u0430 \u0448\u043a\u043e\u043b\u044c\u043d\u043e\u0439 \u044d\u043a\u0441\u043a\u0443\u0440\u0441\u0438\u0438 \u043d\u0435\u0434\u0435\u043b\u044e. \u0422\u0430\u043c \u043d\u0435\u0442 \u0441\u043f\u043e\u0440\u0442\u0437\u0430\u043b\u0430, \u0438 \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir haftal\u0131\u011f\u0131na tatildesiniz ya da okul gezisine \u00e7\u0131k\u0131yorsunuz. Spor salonu yok ve ekipman\u0131n\u0131z yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u5728\u5ea6\u5047\u4e00\u5468\u6216\u53c2\u52a0\u4e00\u6b21\u5b66\u6821\u65c5\u884c\u3002\u6ca1\u6709\u5065\u8eab\u623f\uff0c\u4e5f\u6ca1\u6709\u4efb\u4f55\u88c5\u5907\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u6b63\u5728\u5ea6\u5047\u6216\u53c3\u52a0\u70ba\u671f\u4e00\u5468\u7684\u5b78\u6821\u65c5\u884c\u3002\u6c92\u6709\u5065\u8eab\u623f\uff0c\u4f60\u4e5f\u6c92\u6709\u8a2d\u5099\u3002"
          }
        }
      }
    },
    "assessment.fitness.q10.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Urlaub ist Urlaub. Ich bewege mich eine Woche lang absolut gar nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacation is vacation. I don't move at all for a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vacaciones son vacaciones. No me muevo en absoluto durante una semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vacances sont des vacances. Je ne bouge pas du tout pendant une semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u0941\u091f\u094d\u091f\u093f\u092f\u093e\u0901 \u0924\u094b \u091b\u0941\u091f\u094d\u091f\u093f\u092f\u093e\u0901 \u0939\u0948\u0902. \u092e\u0948\u0902 \u090f\u0915 \u0938\u092a\u094d\u0924\u093e\u0939 \u0924\u0915 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0939\u093f\u0932\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vacanza \u00e8 vacanza. Non mi muovo affatto per una settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f11\u6687\u306f\u4f11\u6687\u3060\u3002\u4e00\u9031\u9593\u5168\u304f\u52d5\u304b\u306a\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud734\uac00\ub294 \ud734\uac00\uc785\ub2c8\ub2e4. \uc77c\uc8fc\uc77c \ub3d9\uc548 \uc804\ud600 \uc6c0\uc9c1\uc774\uc9c0 \uc54a\uc544\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakantie is vakantie. Ik beweeg een week lang helemaal niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakacje to wakacje. Przez tydzie\u0144 w og\u00f3le si\u0119 nie ruszam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e9rias s\u00e3o f\u00e9rias. Eu n\u00e3o me movo por uma semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043f\u0443\u0441\u043a \u2014 \u044d\u0442\u043e \u043e\u0442\u043f\u0443\u0441\u043a. \u042f \u043d\u0435\u0434\u0435\u043b\u044e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0438\u043a\u0443\u0434\u0430 \u043d\u0435 \u0434\u0432\u0438\u0433\u0430\u044e\u0441\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatil tatildir. Bir hafta boyunca hi\u00e7 hareket etmiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5047\u671f\u5c31\u662f\u5047\u671f\u3002\u6211\u6574\u6574\u4e00\u5468\u90fd\u4e00\u70b9\u4e5f\u4e0d\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5047\u671f\u5c31\u662f\u5047\u671f\u3002\u6211\u4e00\u9031\u90fd\u6c92\u52d5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q10.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich nehme mir vor zu joggen, lasse die Schuhe aber die ganze Woche im Koffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I plan to jog, but leave the shoes in my suitcase all week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeo hacer jogging, pero dejo los zapatos en mi maleta toda la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai l'intention de faire du jogging, mais je laisse les chaussures dans ma valise toute la semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u0949\u0917\u093f\u0902\u0917 \u0915\u0930\u0928\u0947 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e \u0930\u0939\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u092a\u0942\u0930\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 \u091c\u0942\u0924\u0947 \u0905\u092a\u0928\u0947 \u0938\u0942\u091f\u0915\u0947\u0938 \u092e\u0947\u0902 \u0939\u0940 \u091b\u094b\u0921\u093c \u0926\u0942\u0902\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho intenzione di fare jogging, ma lascio le scarpe in valigia tutta la settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b8\u30e7\u30ae\u30f3\u30b0\u3059\u308b\u3064\u3082\u308a\u3067\u3059\u304c\u3001\u4eca\u9031\u305a\u3063\u3068\u9774\u3092\u30b9\u30fc\u30c4\u30b1\u30fc\u30b9\u306b\u5165\u308c\u305f\u307e\u307e\u306b\u3057\u3066\u304a\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc870\uae45\uc744 \ud560 \uacc4\ud68d\uc778\ub370 \uc2e0\ubc1c\uc740 \uc77c\uc8fc\uc77c \ub0b4\ub0b4 \uac00\ubc29\uc5d0 \ub123\uc5b4\ub450\uc5c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben van plan om te gaan joggen, maar laat de schoenen de hele week in mijn koffer zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam zamiar pobiega\u0107, ale buty zostawiam w walizce na ca\u0142y tydzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretendo correr, mas deixo os sapatos na mala a semana toda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0441\u044c \u0431\u0435\u0433\u0430\u0442\u044c \u0442\u0440\u0443\u0441\u0446\u043e\u0439, \u043d\u043e \u0432\u0441\u044e \u043d\u0435\u0434\u0435\u043b\u044e \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e \u043a\u0440\u043e\u0441\u0441\u043e\u0432\u043a\u0438 \u0432 \u0447\u0435\u043c\u043e\u0434\u0430\u043d\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko\u015fu yapmay\u0131 planl\u0131yorum ama ayakkab\u0131lar\u0131m\u0131 b\u00fct\u00fcn hafta \u00e7antamda b\u0131rakaca\u011f\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6253\u7b97\u53bb\u6162\u8dd1\uff0c\u4f46\u6574\u6574\u4e00\u5468\u978b\u5b50\u90fd\u653e\u5728\u884c\u674e\u7bb1\u91cc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6253\u7b97\u6162\u8dd1\uff0c\u4f46\u6574\u500b\u661f\u671f\u90fd\u628a\u978b\u5b50\u653e\u5728\u884c\u674e\u7bb1\u88e1\u3002"
          }
        }
      }
    },
    "assessment.fitness.q10.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe viel spazieren oder schwimmen, mache aber kein echtes Workout."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I walk or swim a lot, but don't do any real workouts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camino o nado mucho, pero no hago ning\u00fan entrenamiento real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je marche ou nage beaucoup, mais je ne fais pas de v\u00e9ritable entra\u00eenement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0916\u0942\u092c \u091a\u0932\u0924\u093e \u0939\u0942\u0902 \u092f\u093e \u0924\u0948\u0930\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u094b\u0908 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0915\u0938\u0930\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cammino o nuoto molto, ma non faccio veri allenamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3088\u304f\u6b69\u3044\u305f\u308a\u6cf3\u3044\u3060\u308a\u3057\u307e\u3059\u304c\u3001\u672c\u683c\u7684\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306f\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uac77\uac70\ub098 \uc218\uc601\uc744 \ub9ce\uc774 \ud558\uc9c0\ub9cc \uc2e4\uc81c \uc6b4\ub3d9\uc740 \uc804\ud600 \ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik loop of zwem veel, maar doe geen echte trainingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du\u017co chodz\u0119 i p\u0142ywam, ale nie wykonuj\u0119 \u017cadnych prawdziwych \u0107wicze\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ando ou nado muito, mas n\u00e3o fa\u00e7o nenhum treino de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u043d\u043e\u0433\u043e \u0445\u043e\u0436\u0443 \u043f\u0435\u0448\u043a\u043e\u043c \u0438\u043b\u0438 \u043f\u043b\u0430\u0432\u0430\u044e, \u043d\u043e \u043d\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0441\u044c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7ok y\u00fcr\u00fcyorum ya da y\u00fcz\u00fcyorum ama ger\u00e7ek bir egzersiz yapm\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7ecf\u5e38\u6563\u6b65\u6216\u6e38\u6cf3\uff0c\u4f46\u4e0d\u8fdb\u884c\u771f\u6b63\u7684\u953b\u70bc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7d93\u5e38\u6563\u6b65\u6216\u6e38\u6cf3\uff0c\u4f46\u4e0d\u505a\u4efb\u4f55\u771f\u6b63\u7684\u904b\u52d5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q10.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wache morgens auf und zerst\u00f6re meinen K\u00f6rper mit 300 Liegest\u00fctzen und Kniebeugen im Hotelzimmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I wake up in the morning and destroy my body doing 300 push-ups and squats in the hotel room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me levanto por la ma\u00f1ana y destrozo mi cuerpo haciendo 300 flexiones y sentadillas en la habitaci\u00f3n del hotel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me r\u00e9veille le matin et d\u00e9truit mon corps en faisant 300 pompes et squats dans la chambre d'h\u00f4tel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u0941\u092c\u0939 \u0909\u0920\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0939\u094b\u091f\u0932 \u0915\u0947 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 300 \u092a\u0941\u0936-\u0905\u092a\u094d\u0938 \u0914\u0930 \u0938\u094d\u0915\u094d\u0935\u0948\u091f\u094d\u0938 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u0928\u0937\u094d\u091f \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi sveglio la mattina e distruggo il mio corpo facendo 300 flessioni e squat nella camera d'albergo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u671d\u8d77\u304d\u3066\u30db\u30c6\u30eb\u306e\u90e8\u5c4b\u3067\u8155\u7acb\u3066\u4f0f\u305b\u3068\u30b9\u30af\u30ef\u30c3\u30c8\u3092300\u56de\u3084\u3063\u3066\u4f53\u3092\u58ca\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uce68\uc5d0 \uc77c\uc5b4\ub098 \ud638\ud154\ubc29\uc5d0\uc11c \ud314\uad7d\ud600\ud3b4\uae30, \uc2a4\ucffc\ud2b8 300\uac1c\ub97c \ud558\uba74\uc11c \ubab8\uc744 \ub9dd\uac00\ub728\ub9bd\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik word 's ochtends wakker en vernietig mijn lichaam door 300 push-ups en squats in de hotelkamer te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budz\u0119 si\u0119 rano i niszcz\u0119 swoje cia\u0142o robi\u0105c 300 pompek i przysiad\u00f3w w pokoju hotelowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordo de manh\u00e3 e destruo meu corpo fazendo 300 flex\u00f5es e agachamentos no quarto do hotel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u044e\u0441\u044c \u0443\u0442\u0440\u043e\u043c \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044e \u0441\u0432\u043e\u0451 \u0442\u0435\u043b\u043e 300 \u043e\u0442\u0436\u0438\u043c\u0430\u043d\u0438\u044f\u043c\u0438 \u0438 \u043f\u0440\u0438\u0441\u0435\u0434\u0430\u043d\u0438\u044f\u043c\u0438 \u0432 \u0433\u043e\u0441\u0442\u0438\u043d\u0438\u0447\u043d\u043e\u043c \u043d\u043e\u043c\u0435\u0440\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah uyan\u0131yorum ve otel odas\u0131nda 300 \u015f\u0131nav ve squat yaparak v\u00fccudumu mahvediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u65e9\u4e0a\u9192\u6765\uff0c\u5728\u9152\u5e97\u623f\u95f4\u91cc\u7528300\u4e2a\u4fef\u5367\u6491\u548c\u6df1\u8e72\u6467\u6bc1\u6211\u7684\u8eab\u4f53\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u65e9\u4e0a\u9192\u4f86\uff0c\u5728\u98ef\u5e97\u623f\u9593\u88e1\u505a\u4e86 300 \u500b\u4f0f\u5730\u633a\u8eab\u548c\u6df1\u8e72\uff0c\u6bc0\u6389\u4e86\u6211\u7684\u8eab\u9ad4\u3002"
          }
        }
      }
    },
    "assessment.fitness.q11": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie verh\u00e4ltst du dich zwischen deinen S\u00e4tzen w\u00e4hrend des Workouts?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you behave between your sets during your workout?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfC\u00f3mo te comportas entre series durante tu entrenamiento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment vous comportez-vous entre vos s\u00e9ries pendant votre entra\u00eenement ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u0947 \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0938\u0947\u091f \u0915\u0947 \u092c\u0940\u091a \u0915\u0948\u0938\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come ti comporti tra una serie e l'altra durante l'allenamento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u4e2d\u3001\u30bb\u30c3\u30c8\u9593\u3067\u306f\u3069\u306e\u3088\u3046\u306b\u884c\u52d5\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b4\ub3d9\ud558\ub294 \ub3d9\uc548 \uc138\ud2b8 \uc0ac\uc774\uc5d0 \uc5b4\ub5bb\uac8c \ud589\ub3d9\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe gedraag jij je tussen je sets door tijdens je training?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak zachowujesz si\u0119 pomi\u0119dzy seriami podczas treningu?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como voc\u00ea se comporta entre as s\u00e9ries durante o treino?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0442\u044b \u0441\u0435\u0431\u044f \u0432\u0435\u0434\u0451\u0448\u044c \u043c\u0435\u0436\u0434\u0443 \u0441\u0432\u043e\u0438\u043c\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u0430\u043c\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman s\u0131ras\u0131nda set aralar\u0131nda nas\u0131l davran\u0131yorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u953b\u70bc\u671f\u95f4\uff0c\u4f60\u5728\u53e5\u5b50\u4e4b\u95f4\u5982\u4f55\u8868\u73b0\u81ea\u5df1\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8a13\u7df4\u671f\u9593\uff0c\u60a8\u5728\u7d44\u9593\u8868\u73fe\u5982\u4f55\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q11.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich scrolle auf TikTok/Instagram, vergesse die Zeit und sitze 5 Minuten am Ger\u00e4t."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I scroll on TikTok/Instagram, lose track of time and sit on the device for 5 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me desplazo por TikTok/Instagram, pierdo la noci\u00f3n del tiempo y me siento en el dispositivo durante 5 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais d\u00e9filer TikTok/Instagram, je perds la notion du temps et je reste assis sur l'appareil pendant 5 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091f\u093f\u0915\u091f\u0949\u0915/\u0907\u0902\u0938\u094d\u091f\u093e\u0917\u094d\u0930\u093e\u092e \u092a\u0930 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u0938\u092e\u092f \u0915\u093e \u0927\u094d\u092f\u093e\u0928 \u0928\u0939\u0940\u0902 \u0930\u0939\u0924\u093e \u0914\u0930 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 5 \u092e\u093f\u0928\u091f \u0924\u0915 \u092c\u0948\u0920\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorro su TikTok/Instagram, perdo la cognizione del tempo e rimango seduto sul dispositivo per 5 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok/Instagram \u3092\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u3001\u6642\u9593\u3092\u5fd8\u308c\u3066 5 \u5206\u9593\u30c7\u30d0\u30a4\u30b9\u306e\u4e0a\u306b\u5ea7\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub294 TikTok/Instagram\uc744 \uc2a4\ud06c\ub864\ud558\uace0 \uc2dc\uac04 \uac00\ub294 \uc904 \ubaa8\ub974\uace0 5\ubd84 \ub3d9\uc548 \uae30\uae30 \uc704\uc5d0 \uc549\uc544 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik scroll op TikTok/Instagram, vergeet de tijd en zit 5 minuten op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegl\u0105dam TikTok/Instagram, trac\u0119 poczucie czasu i siedz\u0119 na urz\u0105dzeniu przez 5 minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu enrolo no TikTok/Instagram, perco a no\u00e7\u00e3o do tempo e fico sentado no aparelho por 5 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043b\u0438\u0441\u0442\u0430\u044e TikTok/Instagram, \u0437\u0430\u0431\u044b\u0432\u0430\u044e \u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0441\u0438\u0436\u0443 \u0437\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e\u043c 5 \u043c\u0438\u043d\u0443\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok/Instagram'da geziniyorum, zaman\u0131n nas\u0131l ge\u00e7ti\u011fini anlayam\u0131yorum ve 5 dakika boyunca cihaz\u0131n ba\u015f\u0131nda oturuyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728 TikTok/Instagram \u4e0a\u6ed1\u52a8\uff0c\u5fd8\u8bb0\u65f6\u95f4\uff0c\u53ea\u5728\u8bbe\u5907\u524d\u5750\u4e865\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728 TikTok/Instagram \u4e0a\u6efe\u52d5\uff0c\u5fd8\u8a18\u4e86\u6642\u9593\uff0c\u5728\u8a2d\u5099\u4e0a\u5750\u4e86 5 \u5206\u9418\u3002"
          }
        }
      }
    },
    "assessment.fitness.q11.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich texte mit Freunden, mache aber nach Gef\u00fchl irgendwann weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I text with friends, but I feel like I'll move on at some point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Env\u00edo mensajes de texto a amigos, pero siento que seguir\u00e9 adelante en alg\u00fan momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'envoie des SMS \u00e0 des amis, mais j'ai l'impression que je vais passer \u00e0 autre chose \u00e0 un moment donn\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0926\u094b\u0938\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u093f\u0938\u0940 \u092c\u093f\u0902\u0926\u0941 \u092a\u0930 \u092e\u0948\u0902 \u0906\u0917\u0947 \u092c\u0922\u093c \u091c\u093e\u090a\u0902\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mando messaggi agli amici, ma sento che prima o poi andr\u00f2 avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53cb\u9054\u3068\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u9001\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u3044\u3064\u304b\u5148\u306b\u9032\u3080\u3064\u3082\u308a\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce5c\uad6c\ub4e4\uacfc \ubb38\uc790\ub97c \ubcf4\ub0b4\uc9c0\ub9cc \uc5b4\ub290 \uc21c\uac04\uc5d0\ub294 \uacc4\uc18d \ub098\uc544\uac08 \uac83 \uac19\uc740 \ub290\ub08c\uc774 \ub4ed\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sms met vrienden, maar ik heb het gevoel dat ik op een gegeven moment wel verder zal gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz\u0119 SMS-y do znajomych, ale czuj\u0119, \u017ce w pewnym momencie odejd\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu mando mensagens para amigos, mas sinto que em algum momento irei seguir em frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0441\u044c \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438, \u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u043f\u043e \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f\u043c \u043f\u043e\u0437\u0436\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkada\u015flar\u0131mla mesajla\u015f\u0131yorum ama bir noktada devam edece\u011fimi hissediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u548c\u670b\u53cb\u53d1\u4fe1\u606f\uff0c\u4f46\u603b\u662f\u51ed\u611f\u89c9\u4ec0\u4e48\u65f6\u5019\u7ee7\u7eed\u5c31\u4ec0\u4e48\u65f6\u5019\u7ee7\u7eed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u548c\u670b\u53cb\u767c\u77ed\u4fe1\uff0c\u4f46\u6211\u89ba\u5f97\u5728\u67d0\u500b\u6642\u5019\u6211\u6703\u7e7c\u7e8c\u524d\u9032\u3002"
          }
        }
      }
    },
    "assessment.fitness.q11.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kontrolliere exakt meine Pausenzeit auf der Uhr, atme und fokussiere mich auf den n\u00e4chsten Satz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I check my break time exactly on the clock, breathe and focus on the next sentence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miro exactamente mi tiempo de descanso en el reloj, respiro y me concentro en la siguiente frase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je v\u00e9rifie exactement mon temps de pause sur l'horloge, je respire et je me concentre sur la phrase suivante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u092c\u094d\u0930\u0947\u0915 \u0915\u093e \u0938\u092e\u092f \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0918\u0921\u093c\u0940 \u092a\u0930 \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0902, \u0938\u093e\u0902\u0938 \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u0917\u0932\u0947 \u0935\u093e\u0915\u094d\u092f \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllo esattamente la pausa sull'orologio, respiro e mi concentro sulla frase successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6642\u8a08\u3067\u4f11\u61a9\u6642\u9593\u3092\u6b63\u78ba\u306b\u78ba\u8a8d\u3057\u3001\u4e00\u606f\u3064\u3044\u3066\u6b21\u306e\u6587\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc26c\ub294 \uc2dc\uac04\uc744 \uc2dc\uacc4\ub85c \uc815\ud655\ud788 \ud655\uc778\ud558\uace0 \uc228\uc744 \uace0\ub974\uba70 \ub2e4\uc74c \ubb38\uc7a5\uc5d0 \uc9d1\uc911\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik controleer mijn pauzetijd precies op de klok, haal diep adem en concentreer me op de volgende zin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzam dok\u0142adnie czas przerwy na zegarku, oddycham i skupiam si\u0119 na kolejnym zdaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifico exatamente meu intervalo no rel\u00f3gio, respiro e me concentro na pr\u00f3xima frase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0442\u043e\u0447\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u044e \u0432\u0440\u0435\u043c\u044f \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u043e\u0432 \u043f\u043e \u0447\u0430\u0441\u0430\u043c, \u0434\u044b\u0448\u0443 \u0438 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u0430\u0447\u0438\u0432\u0430\u044e\u0441\u044c \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u043f\u043e\u0434\u0445\u043e\u0434\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mola zaman\u0131m\u0131 tam olarak saat \u00fczerinden kontrol ediyorum, nefes al\u0131yorum ve bir sonraki c\u00fcmleye odaklan\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7cbe\u786e\u5730\u7528\u8868\u63a7\u5236\u6211\u7684\u4f11\u606f\u65f6\u95f4\uff0c\u547c\u5438\uff0c\u5e76\u4e13\u6ce8\u4e8e\u4e0b\u4e00\u4e2a\u52a8\u4f5c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6e96\u78ba\u5730\u67e5\u770b\u6642\u9418\u4e0a\u7684\u4f11\u606f\u6642\u9593\uff0c\u547c\u5438\u4e26\u5c08\u6ce8\u65bc\u4e0b\u4e00\u53e5\u8a71\u3002"
          }
        }
      }
    },
    "assessment.fitness.q11.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich rede mit jedem im Gym und mein Puls f\u00e4llt komplett in den Keller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I talk to everyone in the gym and my heart rate drops completely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablo con todos en el gimnasio y mi frecuencia card\u00edaca baja por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je parle \u00e0 tout le monde dans la salle de sport et mon rythme cardiaque chute compl\u00e8tement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u093f\u092e \u092e\u0947\u0902 \u0938\u092d\u0940 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092e\u0947\u0930\u0940 \u0939\u0943\u0926\u092f \u0917\u0924\u093f \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0915\u092e \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlo con tutti in palestra e la mia frequenza cardiaca diminuisce completamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b8\u30e0\u3067\u307f\u3093\u306a\u3068\u8a71\u3057\u3066\u3044\u308b\u3068\u3001\u5fc3\u62cd\u6570\u304c\u5b8c\u5168\u306b\u4e0b\u304c\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uccb4\uc721\uad00\uc5d0 \uc788\ub294 \ubaa8\ub4e0 \uc0ac\ub78c\ub4e4\uacfc \uc774\uc57c\uae30\ub97c \ub098\ub204\ub294\ub370 \uc2ec\uc7a5\ubc15\ub3d9\uc218\uac00 \uc644\uc804\ud788 \ub5a8\uc5b4\uc84c\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik praat met iedereen in de sportschool en mijn hartslag daalt volledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmawiam ze wszystkimi na si\u0142owni i t\u0119tno mi ca\u0142kowicie spada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Converso com todo mundo na academia e minha frequ\u00eancia card\u00edaca cai completamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u044e \u0441 \u043a\u0430\u0436\u0434\u044b\u043c \u0432 \u0437\u0430\u043b\u0435, \u0438 \u043c\u043e\u0439 \u043f\u0443\u043b\u044c\u0441 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0430\u0434\u0430\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor salonundaki herkesle konu\u015fuyorum ve kalp at\u0131\u015flar\u0131m tamamen d\u00fc\u015f\u00fcyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u548c\u5065\u8eab\u623f\u91cc\u7684\u6bcf\u4e2a\u4eba\u90fd\u8bf4\u8bdd\uff0c\u800c\u6211\u7684\u5fc3\u8df3\u5b8c\u5168\u964d\u5230\u8c37\u5e95\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u548c\u5065\u8eab\u623f\u88e1\u7684\u6bcf\u500b\u4eba\u4ea4\u8ac7\uff0c\u6211\u7684\u5fc3\u7387\u5b8c\u5168\u4e0b\u964d\u3002"
          }
        }
      }
    },
    "assessment.fitness.q12": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hrend einer \u00dcbung sp\u00fcrst du ein starkes, brennendes Gef\u00fchl in den Muskeln, es ist extrem unangenehm. Was denkst du in dieser Millisekunde?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During an exercise you feel a strong, burning sensation in your muscles, it is extremely uncomfortable. What are you thinking in that millisecond?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante un ejercicio sientes una fuerte sensaci\u00f3n de ardor en los m\u00fasculos, es sumamente inc\u00f3modo. \u00bfQu\u00e9 est\u00e1s pensando en ese milisegundo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant un exercice, vous ressentez une forte sensation de br\u00fblure dans vos muscles, c'est extr\u00eamement inconfortable. \u00c0 quoi penses-tu pendant cette milliseconde ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0906\u092a \u0905\u092a\u0928\u0940 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0924\u0947\u091c\u093c, \u091c\u0932\u0928 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u092f\u0939 \u092c\u0947\u0939\u0926 \u0905\u0938\u0941\u0935\u093f\u0927\u093e\u091c\u0928\u0915 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0909\u0938 \u092e\u093f\u0932\u0940\u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante un esercizio avverti una forte sensazione di bruciore nei muscoli, \u00e8 estremamente fastidioso. Cosa stai pensando in quel millisecondo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u904b\u52d5\u4e2d\u306b\u7b4b\u8089\u306b\u5f37\u3044\u707c\u71b1\u611f\u3092\u611f\u3058\u307e\u3059\u304c\u3001\u3053\u308c\u306f\u975e\u5e38\u306b\u4e0d\u5feb\u3067\u3059\u3002\u305d\u306e\u30df\u30ea\u79d2\u306e\u9593\u306b\u4f55\u3092\u8003\u3048\u3066\u3044\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b4\ub3d9\ud558\ub294 \ub3d9\uc548 \uadfc\uc721\uc5d0 \uac15\ud558\uace0 \ud0c0\ub294\ub4ef\ud55c \ub290\ub08c\uc774 \ub4e4\uba70 \ub9e4\uc6b0 \ubd88\ud3b8\ud569\ub2c8\ub2e4. \uadf8 \ubc00\ub9ac\ucd08 \ub3d9\uc548 \ub2f9\uc2e0\uc740 \ubb34\uc2a8 \uc0dd\uac01\uc744 \ud558\uace0 \uc788\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens een oefening voel je een sterk, branderig gevoel in je spieren, dit is uiterst oncomfortabel. Wat denk jij in die milliseconde?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas \u0107wicze\u0144 odczuwasz silne, pieczenie w mi\u0119\u015bniach, jest to niezwykle nieprzyjemne. O czym my\u015blisz w ci\u0105gu tej milisekundy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante um exerc\u00edcio voc\u00ea sente uma forte sensa\u00e7\u00e3o de queima\u00e7\u00e3o nos m\u00fasculos, \u00e9 extremamente desconfort\u00e1vel. O que voc\u00ea est\u00e1 pensando naquele milissegundo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u0442\u044b \u043e\u0449\u0443\u0449\u0430\u0435\u0448\u044c \u0441\u0438\u043b\u044c\u043d\u043e\u0435, \u0436\u0433\u0443\u0447\u0435\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u0432 \u043c\u044b\u0448\u0446\u0430\u0445, \u044d\u0442\u043e \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e. \u041e \u0447\u0451\u043c \u0442\u044b \u0434\u0443\u043c\u0430\u0435\u0448\u044c \u0432 \u044d\u0442\u0443 \u043c\u0438\u043b\u043b\u0438\u0441\u0435\u043a\u0443\u043d\u0434\u0443?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz s\u0131ras\u0131nda kaslar\u0131n\u0131zda g\u00fc\u00e7l\u00fc bir yanma hissi hissedersiniz, bu son derece rahats\u0131z edicidir. O milisaniyede ne d\u00fc\u015f\u00fcn\u00fcyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e00\u6b21\u953b\u70bc\u4e2d\uff0c\u4f60\u611f\u5230\u808c\u8089\u6709\u4e00\u79cd\u5f3a\u70c8\u7684\u707c\u70e7\u611f\uff0c\u975e\u5e38\u4e0d\u8212\u670d\u3002\u5728\u8fd9\u4e00\u6beb\u79d2\u4f60\u4f1a\u60f3\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u904b\u52d5\u904e\u7a0b\u4e2d\uff0c\u4f60\u6703\u611f\u89ba\u5230\u808c\u8089\u6709\u5f37\u70c8\u7684\u707c\u71b1\u611f\uff0c\u9019\u662f\u975e\u5e38\u4e0d\u8212\u670d\u7684\u3002\u90a3\u4e00\u6beb\u79d2\u4f60\u5728\u60f3\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q12.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Das tut weh, ich muss sofort aufh\u00f6ren, bevor ich kaputt gehe.'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'This hurts, I have to stop now before I break.'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Esto duele, tengo que parar ahora antes de que me rompa\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\u00c7a fait mal, je dois arr\u00eater maintenant avant de craquer.\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u092f\u0939 \u0926\u0941\u0916\u0926\u093e\u092f\u0940 \u0939\u0948, \u092e\u0941\u091d\u0947 \u091f\u0942\u091f\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092c \u0930\u0941\u0915\u0928\u093e \u0939\u094b\u0917\u093e\u0964'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Fa male, devo fermarmi adesso prima di rompermi.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u3053\u308c\u306f\u75db\u3044\u3001\u58ca\u308c\u308b\u524d\u306b\u4eca\u3059\u3050\u3084\u3081\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u300d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc544\ud504\ub2e4. \uae68\uc9c0\uae30 \uc804\uc5d0 \uc774\uc81c \uadf8\ub9cc\ub46c\uc57c\uaca0\ub2e4.'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Dit doet pijn, ik moet nu stoppen voordat ik breek.'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eTo boli. Musz\u0119 teraz przesta\u0107, zanim si\u0119 z\u0142ami\u0119\u201d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'Isso d\u00f3i, tenho que parar agora antes de quebrar.'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab\u042d\u0442\u043e \u0431\u043e\u043b\u044c\u043d\u043e, \u043c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u044f \u0441\u043b\u043e\u043c\u0430\u044e\u0441\u044c.\u00bb"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Bu ac\u0131t\u0131yor, k\u0131r\u0131lmadan \u00f6nce durmam laz\u0131m.'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u8fd9\u5f88\u75db\uff0c\u6211\u5fc5\u987b\u7acb\u523b\u505c\u6b62\uff0c\u514d\u5f97\u6211\u5d29\u6e83\u3002\u201d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u9019\u5f88\u75db\uff0c\u6211\u5fc5\u9808\u5728\u6454\u65b7\u4e4b\u524d\u505c\u4e0b\u4f86\u3002\u201d"
          }
        }
      }
    },
    "assessment.fitness.q12.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Ich hasse dieses Gef\u00fchl, wann ist das endlich vorbei?'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'I hate this feeling, when will this finally be over?'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'Odio este sentimiento, \u00bfcu\u00e1ndo terminar\u00e1 esto finalmente?'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Je d\u00e9teste ce sentiment, quand est-ce que \u00e7a sera enfin fini ?\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u092e\u0941\u091d\u0947 \u0907\u0938 \u092d\u093e\u0935\u0928\u093e \u0938\u0947 \u0928\u092b\u0930\u0924 \u0939\u0948, \u092f\u0939 \u0906\u0916\u093f\u0930\u0915\u093e\u0930 \u0915\u092c \u0916\u0924\u094d\u092e \u0939\u094b\u0917\u093e?'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'Odio questa sensazione, quando finir\u00e0 finalmente tutto questo?'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u3053\u306e\u6c17\u6301\u3061\u306f\u5acc\u3060\u3001\u3044\u3064\u306b\u306a\u3063\u305f\u3089\u7d42\u308f\u308b\u3093\u3060\u308d\u3046\uff1f\u300d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc774 \ub290\ub08c\uc774 \uc2eb\ub2e4. \uc5b8\uc81c\ucbe4 \ub05d\ub098\uc9c0?'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Ik haat dit gevoel, wanneer is dit eindelijk voorbij?'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eNienawidz\u0119 tego uczucia. Kiedy to w ko\u0144cu si\u0119 sko\u0144czy?\u201d"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'Eu odeio esse sentimento, quando isso finalmente acabar\u00e1?'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u042f \u043d\u0435\u043d\u0430\u0432\u0438\u0436\u0443 \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e, \u043a\u043e\u0433\u0434\u0430 \u0436\u0435 \u044d\u0442\u043e \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u0441\u044f?'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Bu duygudan nefret ediyorum, bu nihayet ne zaman bitecek?'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8ba8\u538c\u8fd9\u79cd\u611f\u89c9\uff0c\u8fd9\u5230\u5e95\u4ec0\u4e48\u65f6\u5019\u624d\u7ed3\u675f\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u6211\u8a0e\u53ad\u9019\u7a2e\u611f\u89ba\uff0c\u4ec0\u9ebc\u6642\u5019\u624d\u80fd\u7d50\u675f\uff1f\u201d"
          }
        }
      }
    },
    "assessment.fitness.q12.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Noch zwei Wiederholungen, dann habe ich es \u00fcberstanden.'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'Two more repetitions and I'll be over it.'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Dos repeticiones m\u00e1s y lo superar\u00e9\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Encore deux r\u00e9p\u00e9titions et j'en aurai fini avec \u00e7a.\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u0926\u094b \u0914\u0930 \u0926\u094b\u0939\u0930\u093e\u0935 \u0914\u0930 \u092e\u0948\u0902 \u0907\u0938\u0947 \u0916\u0924\u094d\u092e \u0915\u0930 \u0926\u0942\u0902\u0917\u093e\u0964'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Ancora due ripetizioni e avr\u00f2 finito.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u3042\u30682\u56de\u7e70\u308a\u8fd4\u305b\u3070\u7d42\u308f\u308a\u307e\u3059\u3002\u300d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\ub450 \ubc88\ub9cc \ub354 \ubc18\ubcf5\ud558\uba74 \ub05d\ub098\uaca0\uc2b5\ub2c8\ub2e4.'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Nog twee herhalingen en ik ben er overheen.'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eJeszcze dwa powt\u00f3rzenia i sko\u0144cz\u0119\u201d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'Mais duas repeti\u00e7\u00f5es e eu superarei isso.'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab\u0415\u0449\u0435 \u0434\u0432\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u044f, \u0438 \u044f \u0441 \u044d\u0442\u0438\u043c \u0441\u043f\u0440\u0430\u0432\u043b\u044e\u0441\u044c.\u00bb"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u0130ki tekrar daha sonra bitirece\u011fim.'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u518d\u505a\u4e24\u6b21\uff0c\u6211\u5c31\u71ac\u8fc7\u53bb\u4e86\u3002\u201d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u518d\u91cd\u8907\u5169\u6b21\u6211\u5c31\u53ef\u4ee5\u4e86\u3002\u201d"
          }
        }
      }
    },
    "assessment.fitness.q12.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Dieses Brennen ist exakt der Punkt, an dem mein K\u00f6rper w\u00e4chst. Ich dr\u00fccke weiter!'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'This burning sensation is exactly the point at which my body grows. I keep pushing!'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'Esta sensaci\u00f3n de ardor es exactamente el punto en el que mi cuerpo crece. \u00a1Sigo presionando!'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab Cette sensation de br\u00fblure est exactement le moment o\u00f9 mon corps se d\u00e9veloppe. Je continue \u00e0 pousser\u00a0!\u00a0\u00bb"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u092f\u0939 \u091c\u0932\u0928 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0935\u0939\u0940 \u092c\u093f\u0902\u0926\u0941 \u0939\u0948 \u091c\u093f\u0938 \u092a\u0930 \u092e\u0947\u0930\u093e \u0936\u0930\u0940\u0930 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u091c\u094b\u0930 \u0932\u0917\u093e\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902!'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'Questa sensazione di bruciore \u00e8 esattamente il punto in cui il mio corpo cresce. Continuo a spingere!'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u3053\u306e\u707c\u71b1\u306e\u611f\u899a\u306f\u307e\u3055\u306b\u79c1\u306e\u4f53\u304c\u6210\u9577\u3059\u308b\u30dd\u30a4\u30f3\u30c8\u3067\u3059\u3002\u79c1\u306f\u62bc\u3057\u7d9a\u3051\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc774 \ud0c0\ub294\ub4ef\ud55c \ub290\ub08c\uc740 \ubc14\ub85c \ub0b4 \ubab8\uc774 \uc131\uc7a5\ud558\ub294 \uc9c0\uc810\uc785\ub2c8\ub2e4. \uacc4\uc18d \ubc00\uace0 \uc788\uc5b4\uc694!'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Dit brandende gevoel is precies het punt waarop mijn lichaam groeit. Ik blijf duwen!'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eTo uczucie pieczenia jest dok\u0142adnie momentem, w kt\u00f3rym moje cia\u0142o ro\u015bnie. Naciskam dalej!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'Essa sensa\u00e7\u00e3o de queima\u00e7\u00e3o \u00e9 exatamente o ponto em que meu corpo cresce. Eu continuo pressionando!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab\u042d\u0442\u043e \u0436\u0436\u0435\u043d\u0438\u0435 \u2014 \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u0430 \u0442\u043e\u0447\u043a\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043c\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c \u0440\u0430\u0441\u0442\u0435\u0442. \u042f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u0434\u0430\u0432\u0438\u0442\u044c!\u00bb"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Bu yanma hissi tam olarak v\u00fccudumun b\u00fcy\u00fcd\u00fc\u011f\u00fc noktad\u0131r. \u0130tmeye devam ediyorum!'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u8fd9\u79cd\u707c\u70e7\u611f\u6b63\u662f\u6211\u7684\u8eab\u4f53\u5728\u751f\u957f\u7684\u5730\u65b9\u3002\u6211\u4f1a\u7ee7\u7eed\u52aa\u529b\uff01\u201d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u9019\u7a2e\u707c\u71b1\u611f\u6b63\u662f\u6211\u7684\u8eab\u9ad4\u751f\u9577\u7684\u6642\u523b\u3002\u6211\u7e7c\u7e8c\u63a8\u52d5\uff01"
          }
        }
      }
    },
    "assessment.fitness.q13": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wachst auf und hast so brutalen Muskelkater in den Beinen, dass du kaum die Treppe runterkommst. Heute steht Oberk\u00f6rper auf dem Plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You wake up with muscles in your legs so sore you can barely get down the stairs. Today the upper body is on the agenda."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te despiertas con los m\u00fasculos de las piernas tan doloridos que apenas puedes bajar las escaleras. Hoy la parte superior del cuerpo est\u00e1 en la agenda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous r\u00e9veillez avec les muscles des jambes si endoloris que vous pouvez \u00e0 peine descendre les escaliers. Aujourd\u2019hui le haut du corps est \u00e0 l\u2019ordre du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u0947 \u092a\u0948\u0930\u094b\u0902 \u0915\u0940 \u092e\u093e\u0902\u0938\u092a\u0947\u0936\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0909\u0920\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0907\u0924\u0928\u0940 \u092a\u0940\u0921\u093c\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u0938\u0947 \u0938\u0940\u0922\u093c\u093f\u092f\u094b\u0902 \u0938\u0947 \u0928\u0940\u091a\u0947 \u0909\u0924\u0930 \u092a\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u091c \u090a\u092a\u0930\u0940 \u0928\u093f\u0915\u093e\u092f \u090f\u091c\u0947\u0902\u0921\u0947 \u092e\u0947\u0902 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti svegli con i muscoli delle gambe cos\u00ec doloranti che riesci a malapena a scendere le scale. Oggi la parte superiore del corpo \u00e8 all'ordine del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u671d\u8d77\u304d\u308b\u3068\u8db3\u304c\u7b4b\u8089\u75db\u306b\u306a\u3063\u3066\u3044\u3066\u3001\u968e\u6bb5\u3092\u964d\u308a\u308b\u306e\u304c\u3084\u3063\u3068\u3067\u3059\u3002\u4eca\u65e5\u306f\u4e0a\u534a\u8eab\u304c\u8b70\u984c\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc5b4\ub098\uba74 \ub2e4\ub9ac \uadfc\uc721\uc774 \ub108\ubb34 \uc544\ud30c\uc11c \uacc4\ub2e8\uc744 \uac70\uc758 \ub0b4\ub824\uac08 \uc218 \uc5c6\uc744 \uc815\ub3c4\uc785\ub2c8\ub2e4. \uc624\ub298\uc740 \uc0c1\uccb4 \ud68c\uc758\uac00 \uc758\uc81c\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt wakker met spieren in je benen die zo pijnlijk zijn dat je nauwelijks de trap af kunt komen. Vandaag staat het bovenlichaam op de agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budzisz si\u0119 z tak obola\u0142ymi mi\u0119\u015bniami n\u00f3g, \u017ce ledwo mo\u017cesz zej\u015b\u0107 po schodach. Dzi\u015b w porz\u0105dku obrad jest g\u00f3rna cz\u0119\u015b\u0107 cia\u0142a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea acorda com os m\u00fasculos das pernas t\u00e3o doloridos que mal consegue descer as escadas. Hoje a parte superior do corpo est\u00e1 na ordem do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u0435\u0448\u044c\u0441\u044f \u0438 \u0443 \u0442\u0435\u0431\u044f \u0442\u0430\u043a\u0430\u044f \u0441\u0438\u043b\u044c\u043d\u0430\u044f \u043c\u044b\u0448\u0435\u0447\u043d\u0430\u044f \u0431\u043e\u043b\u044c \u0432 \u043d\u043e\u0433\u0430\u0445, \u0447\u0442\u043e \u0442\u044b \u0435\u0434\u0432\u0430 \u043c\u043e\u0436\u0435\u0448\u044c \u0441\u043f\u0443\u0441\u0442\u0438\u0442\u044c\u0441\u044f \u043f\u043e \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0435. \u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0432 \u043f\u043b\u0430\u043d\u0435 \u0432\u0435\u0440\u0445\u043d\u044f\u044f \u0447\u0430\u0441\u0442\u044c \u0442\u0435\u043b\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bacaklar\u0131n\u0131zdaki kaslarla uyan\u0131yorsunuz, o kadar a\u011fr\u0131yor ki merdivenlerden zar zor inebiliyorsunuz. Bug\u00fcn \u00fcst v\u00fccut g\u00fcndemde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u9192\u6765\u65f6\u817f\u90e8\u808c\u8089\u9178\u75db\u5f97\u5389\u5bb3\uff0c\u51e0\u4e4e\u4e0b\u4e0d\u53bb\u697c\u68af\u3002\u4eca\u5929\u7684\u8ba1\u5212\u662f\u953b\u70bc\u4e0a\u534a\u8eab\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7576\u4f60\u9192\u4f86\u6642\uff0c\u817f\u90e8\u808c\u8089\u9178\u75db\u5f97\u5e7e\u4e4e\u7121\u6cd5\u4e0b\u6a13\u68af\u3002\u4eca\u5929\u4e0a\u534a\u8eab\u63d0\u4e0a\u4e86\u8b70\u7a0b\u3002"
          }
        }
      }
    },
    "assessment.fitness.q13.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe im Bett. Mein ganzer K\u00f6rper braucht Erholung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll stay in bed. My whole body needs rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me quedar\u00e9 en la cama. Todo mi cuerpo necesita descansar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais rester au lit. Tout mon corps a besoin de repos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u0939\u0940 \u0930\u0939\u0942\u0902\u0917\u093e. \u092e\u0947\u0930\u0947 \u092a\u0942\u0930\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u0906\u0930\u093e\u092e \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Star\u00f2 a letto. Tutto il mio corpo ha bisogno di riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d9\u30c3\u30c9\u306b\u3044\u307e\u3059\u3002\u4f53\u5168\u4f53\u304c\u4f11\u606f\u3092\u5fc5\u8981\u3068\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uce68\ub300\uc5d0 \uba38\ubb3c \uac83\uc774\ub2e4. \ub0b4 \ubab8 \uc804\uccb4\uc5d0 \ud734\uc2dd\uc774 \ud544\uc694\ud574\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf in bed. Mijn hele lichaam heeft rust nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostan\u0119 w \u0142\u00f3\u017cku. Ca\u0142e moje cia\u0142o potrzebuje odpoczynku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu ficarei na cama. Todo o meu corpo precisa de descanso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0441\u0442\u0430\u044e\u0441\u044c \u0432 \u043f\u043e\u0441\u0442\u0435\u043b\u0438. \u041c\u043e\u0435\u043c\u0443 \u0442\u0435\u043b\u0443 \u043d\u0443\u0436\u0435\u043d \u043e\u0442\u0434\u044b\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben yatakta kalaca\u011f\u0131m. B\u00fct\u00fcn v\u00fccudumun dinlenmeye ihtiyac\u0131 var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8eba\u5728\u5e8a\u4e0a\u3002\u6211\u7684\u6574\u4e2a\u8eab\u4f53\u9700\u8981\u4f11\u606f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u7559\u5728\u5e8a\u4e0a\u3002\u6211\u7684\u6574\u500b\u8eab\u9ad4\u90fd\u9700\u8981\u4f11\u606f\u3002"
          }
        }
      }
    },
    "assessment.fitness.q13.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe nicht ins Training, weil der Weg dorthin schon zu anstrengend ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't go to training because the journey there is already too strenuous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No voy a entrenar porque el viaje ya es demasiado agotador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne vais pas \u00e0 l'entra\u00eenement car le trajet l\u00e0-bas est d\u00e9j\u00e0 trop fatiguant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091f\u094d\u0930\u0947\u0928\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u0939\u093e\u0902 \u0915\u093e \u0938\u092b\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u092c\u0939\u0941\u0924 \u0915\u0920\u093f\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vado agli allenamenti perch\u00e9 il viaggio \u00e8 gi\u00e0 troppo faticoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u3053\u307e\u3067\u306e\u9053\u7a0b\u304c\u3059\u3067\u306b\u5927\u5909\u3059\u304e\u308b\u306e\u3067\u3001\u79c1\u306f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u306f\u884c\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud6c8\ub828\ud558\ub7ec \uac00\uc9c0 \uc54a\ub294 \uc774\uc720\ub294 \uadf8\uacf3\uc5d0\uc11c\uc758 \uc5ec\uc815\uc774 \uc774\ubbf8 \ub108\ubb34 \ud798\ub4e4\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga niet naar training omdat de reis erheen al te inspannend is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie chodz\u0119 na treningi, bo podr\u00f3\u017c tam jest ju\u017c zbyt m\u0119cz\u0105ca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o vou treinar porque a viagem at\u00e9 l\u00e1 j\u00e1 \u00e9 muito cansativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435 \u0438\u0434\u0443 \u043d\u0430 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0434\u043e\u0440\u043e\u0433\u0430 \u0442\u0443\u0434\u0430 \u0443\u0436\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0443\u0442\u043e\u043c\u0438\u0442\u0435\u043b\u044c\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanlara gitmiyorum \u00e7\u00fcnk\u00fc oradaki yolculuk zaten \u00e7ok yorucu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e0d\u53bb\u8bad\u7ec3\uff0c\u56e0\u4e3a\u53bb\u90a3\u91cc\u7684\u8def\u5df2\u7ecf\u592a\u7d2f\u4eba\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e0d\u53bb\u8a13\u7df4\uff0c\u56e0\u70ba\u90a3\u88e1\u7684\u8def\u5df2\u7d93\u592a\u8f9b\u82e6\u4e86\u3002"
          }
        }
      }
    },
    "assessment.fitness.q13.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werfe eine Schmerztablette ein und trainiere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I pop a painkiller and exercise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomo un analg\u00e9sico y hago ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prends un analg\u00e9sique et je fais de l'exercice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0926\u0930\u094d\u0926 \u0928\u093f\u0935\u093e\u0930\u0915 \u0926\u0935\u093e \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendo un antidolorifico e faccio esercizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u75db\u307f\u6b62\u3081\u3092\u98f2\u3093\u3067\u904b\u52d5\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ud1b5\uc81c\ub97c \uba39\uace0 \uc6b4\ub3d9\uc744 \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik neem een \u200b\u200bpijnstiller en ga sporten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bior\u0119 \u015brodek przeciwb\u00f3lowy i \u0107wicz\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomo um analg\u00e9sico e fa\u00e7o exerc\u00edcios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0443\u044e \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0443 \u0438 \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u044e\u0441\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u011fr\u0131 kesici al\u0131p spor yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5403\u4e86\u4e00\u7247\u6b62\u75db\u836f\u7136\u540e\u953b\u70bc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u670d\u7528\u6b62\u75db\u85e5\u4e26\u9032\u884c\u904b\u52d5\u3002"
          }
        }
      }
    },
    "assessment.fitness.q13.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich humple fluchend ins Gym, w\u00e4rme mich auf und trainiere den Oberk\u00f6rper exakt nach Plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I limp into the gym cursing, warm up and train my upper body exactly according to plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro cojeando al gimnasio maldiciendo, caliento y entreno la parte superior de mi cuerpo exactamente seg\u00fan lo planeado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je boite dans la salle de sport en jurant, je m'\u00e9chauffe et j'entra\u00eene le haut de mon corps exactement comme pr\u00e9vu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0932\u0902\u0917\u0921\u093c\u093e\u0924\u0947 \u0939\u0941\u090f \u091c\u093f\u092e \u091c\u093e\u0924\u093e \u0939\u0942\u0902, \u0935\u093e\u0930\u094d\u092e\u0905\u092a \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0905\u092a\u0928\u0947 \u090a\u092a\u0930\u0940 \u0936\u0930\u0940\u0930 \u0915\u094b \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vado zoppicando in palestra imprecando, mi riscaldo e alleno la parte superiore del corpo esattamente secondo il piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u60aa\u614b\u3092\u3064\u304d\u306a\u304c\u3089\u8db3\u3092\u5f15\u304d\u305a\u308a\u306a\u304c\u3089\u30b8\u30e0\u306b\u5165\u308a\u3001\u8a08\u753b\u901a\u308a\u306b\u30a6\u30a9\u30fc\u30e0\u30a2\u30c3\u30d7\u3057\u3066\u4e0a\u534a\u8eab\u3092\u935b\u3048\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc808\ub69d\uac70\ub9ac\uba70 \uc695\uc124\uc744 \ud558\uba70 \uccb4\uc721\uad00\uc5d0 \ub4e4\uc5b4\uac00 \uc900\ube44\uc6b4\ub3d9\uc744 \ud558\uace0 \uacc4\ud68d\ub300\ub85c \uc815\ud655\ud558\uac8c \uc0c1\uccb4\ub97c \ub2e8\ub828\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik strompel vloekend de sportschool in, doe een warming-up en train mijn bovenlichaam precies volgens plan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku\u015btykaj\u0105c, przeklinam, wchodz\u0119 na si\u0142owni\u0119, rozgrzewam si\u0119 i trenuj\u0119 g\u00f3rn\u0105 cz\u0119\u015b\u0107 cia\u0142a dok\u0142adnie wed\u0142ug planu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro mancando na academia xingando, me aque\u00e7o e treino a parte superior do corpo exatamente de acordo com o planejado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0445\u0440\u043e\u043c\u0430\u044e, \u0440\u0443\u0433\u0430\u044f\u0441\u044c, \u0432 \u0441\u043f\u043e\u0440\u0442\u0437\u0430\u043b, \u0440\u0430\u0437\u043c\u0438\u043d\u0430\u044e\u0441\u044c \u0438 \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u044e \u0432\u0435\u0440\u0445\u043d\u044e\u044e \u0447\u0430\u0441\u0442\u044c \u0442\u0435\u043b\u0430 \u0442\u043e\u0447\u043d\u043e \u043f\u043e \u043f\u043b\u0430\u043d\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00fcf\u00fcr ederek topallayarak spor salonuna giriyorum, \u0131s\u0131n\u0131yorum ve \u00fcst bedenimi tam olarak plana g\u00f6re \u00e7al\u0131\u015ft\u0131r\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e00\u8fb9\u5492\u9a82\u4e00\u8fb9\u4e00\u7638\u4e00\u62d0\u5730\u8d70\u8fdb\u5065\u8eab\u623f\uff0c\u70ed\u8eab\u540e\u6309\u7167\u8ba1\u5212\u7cbe\u786e\u5730\u8bad\u7ec3\u4e0a\u534a\u8eab\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5492\u7f75\u8457\u4e00\u8ddb\u4e00\u8ddb\u5730\u8d70\u9032\u5065\u8eab\u623f\uff0c\u71b1\u8eab\u4e26\u5b8c\u5168\u6309\u7167\u8a08\u756b\u8a13\u7df4\u6211\u7684\u4e0a\u534a\u8eab\u3002"
          }
        }
      }
    },
    "assessment.fitness.q14": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du schaust an einem schlechten Tag in den Spiegel und bist mit deinem K\u00f6rper absolut unzufrieden. Was ist deine erste Reaktion?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You look in the mirror on a bad day and are completely dissatisfied with your body. What is your first reaction?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te miras al espejo en un mal d\u00eda y est\u00e1s completamente insatisfecho con tu cuerpo. \u00bfCu\u00e1l es tu primera reacci\u00f3n?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous regardez dans le miroir lors d\u2019une mauvaise journ\u00e9e et \u00eates compl\u00e8tement insatisfait de votre corps. Quelle est votre premi\u00e8re r\u00e9action ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0915\u093f\u0938\u0940 \u092c\u0941\u0930\u0947 \u0926\u093f\u0928 \u0915\u094b \u0906\u0908\u0928\u0947 \u092e\u0947\u0902 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0905\u0938\u0902\u0924\u0941\u0937\u094d\u091f \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0940 \u092a\u0939\u0932\u0940 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094d\u092f\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti guardi allo specchio in una brutta giornata e sei completamente insoddisfatto del tuo corpo. Qual \u00e8 la tua prima reazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8abf\u5b50\u306e\u60aa\u3044\u65e5\u306b\u93e1\u3092\u898b\u308b\u3068\u3001\u81ea\u5206\u306e\u4f53\u306b\u307e\u3063\u305f\u304f\u4e0d\u6e80\u3092\u611f\u3058\u3066\u3044\u307e\u3059\u3002\u6700\u521d\u306e\u53cd\u5fdc\u306f\u4f55\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ub0a0\uc528\uac00 \uc88b\uc9c0 \uc54a\uc740 \ub0a0 \uac70\uc6b8\uc744 \ubcf4\uace0 \ub2f9\uc2e0\uc758 \ubab8\uc5d0 \uc644\uc804\ud788 \ub9cc\uc871\ud558\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uccab \ubc88\uc9f8 \ubc18\uc751\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kijkt op een slechte dag in de spiegel en bent totaal ontevreden over je lichaam. Wat is je eerste reactie?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy masz z\u0142y dzie\u0144, patrzysz w lustro i jeste\u015b ca\u0142kowicie niezadowolona ze swojego cia\u0142a. Jaka jest Twoja pierwsza reakcja?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea se olha no espelho em um dia ruim e fica completamente insatisfeito com seu corpo. Qual \u00e9 a sua primeira rea\u00e7\u00e3o?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0441\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u0432 \u0437\u0435\u0440\u043a\u0430\u043b\u043e \u0432 \u043f\u043b\u043e\u0445\u043e\u0439 \u0434\u0435\u043d\u044c \u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u0435\u043d \u0441\u0432\u043e\u0438\u043c \u0442\u0435\u043b\u043e\u043c. \u041a\u0430\u043a\u043e\u0432\u0430 \u0442\u0432\u043e\u044f \u043f\u0435\u0440\u0432\u0430\u044f \u0440\u0435\u0430\u043a\u0446\u0438\u044f?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00f6t\u00fc bir g\u00fcnde aynaya bak\u0131yorsunuz ve v\u00fccudunuzdan hi\u00e7 memnun de\u011filsiniz. \u0130lk tepkiniz nedir?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u7cdf\u7cd5\u7684\u4e00\u5929\u7167\u955c\u5b50\uff0c\u5bf9\u81ea\u5df1\u7684\u8eab\u4f53\u611f\u5230\u975e\u5e38\u4e0d\u6ee1\u3002\u4f60\u7684\u7b2c\u4e00\u53cd\u5e94\u662f\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc3\u60c5\u4e0d\u597d\u7684\u6642\u5019\uff0c\u4f60\u7167\u93e1\u5b50\uff0c\u5c0d\u81ea\u5df1\u7684\u8eab\u9ad4\u5b8c\u5168\u4e0d\u6eff\u610f\u3002\u4f60\u7684\u7b2c\u4e00\u500b\u53cd\u61c9\u662f\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q14.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich tr\u00f6ste mich mit Fast Food. Ist eh schon alles egal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I console myself with fast food. It doesn't matter anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me consuelo con la comida r\u00e1pida. No importa de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me console avec de la restauration rapide. De toute fa\u00e7on, cela n'a pas d'importance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921 \u0938\u0947 \u0916\u0941\u0926 \u0915\u094b \u0938\u093e\u0902\u0924\u094d\u0935\u0928\u093e \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964 \u0935\u0948\u0938\u0947 \u092d\u0940 \u0907\u0938\u0938\u0947 \u0915\u094b\u0908 \u092b\u0930\u094d\u0915 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0924\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi consolo con il fast food. Non importa comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30b9\u30c8\u30d5\u30fc\u30c9\u3067\u81ea\u5206\u3092\u6170\u3081\u307e\u3059\u3002\u3068\u306b\u304b\u304f\u95a2\u4fc2\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud328\uc2a4\ud2b8\ud478\ub4dc\ub85c \ub098\ub97c \uc704\ub85c\ud55c\ub2e4. \uc5b4\uca0c\ub4e0 \uadf8\uac83\uc740 \uc911\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik troost mezelf met fastfood. Het maakt toch niet uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocieszam si\u0119 fast foodami. To i tak nie ma znaczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me consolo com fast food. N\u00e3o importa de qualquer maneira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0443\u0442\u0435\u0448\u0430\u044e \u0441\u0435\u0431\u044f \u0444\u0430\u0441\u0442\u0444\u0443\u0434\u043e\u043c. \u0412\u0441\u044f\u043a\u043e \u0443\u0436\u0435 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food yiyerek kendimi teselli ediyorum. Zaten \u00f6nemli de\u011fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7528\u5feb\u9910\u6765\u5b89\u6170\u81ea\u5df1\u3002\u53cd\u6b63\u4e00\u5207\u90fd\u65e0\u6240\u8c13\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7528\u5feb\u9910\u4f86\u5b89\u6170\u81ea\u5df1\u3002\u53cd\u6b63\u6c92\u95dc\u4fc2\u3002"
          }
        }
      }
    },
    "assessment.fitness.q14.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich rede mir ein, dass 'innere Werte' eh viel wichtiger sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I tell myself that 'inner values' are much more important anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me digo a m\u00ed mismo que los \"valores internos\" son mucho m\u00e1s importantes de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me dis que les \u00ab valeurs int\u00e9rieures \u00bb sont de toute fa\u00e7on bien plus importantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0916\u0941\u0926 \u0938\u0947 \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0915\u093f '\u0906\u0902\u0924\u0930\u093f\u0915 \u092e\u0942\u0932\u094d\u092f' \u0935\u0948\u0938\u0947 \u092d\u0940 \u0915\u0939\u0940\u0902 \u0905\u0927\u093f\u0915 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi dico che comunque i \"valori interiori\" sono molto pi\u00f9 importanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3068\u306b\u304b\u304f\u300c\u5185\u306a\u308b\u4fa1\u5024\u89b3\u300d\u306e\u65b9\u304c\u306f\u308b\u304b\u306b\u91cd\u8981\u3060\u3068\u81ea\u5206\u306b\u8a00\u3044\u805e\u304b\u305b\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\uca0c\ub4e0 '\ub0b4\uba74\uc758 \uac00\uce58'\uac00 \ud6e8\uc52c \ub354 \uc911\uc694\ud558\ub2e4\uace0 \uc2a4\uc2a4\ub85c\uc5d0\uac8c \ub2e4\uc9d0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg tegen mezelf dat \u2018innerlijke waarden\u2019 sowieso veel belangrijker zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzam sobie, \u017ce \u201ewarto\u015bci wewn\u0119trzne\u201d i tak s\u0105 o wiele wa\u017cniejsze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo a mim mesmo que os \u201cvalores internos\u201d s\u00e3o muito mais importantes de qualquer maneira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0443\u0431\u0435\u0436\u0434\u0430\u044e \u0441\u0435\u0431\u044f, \u0447\u0442\u043e '\u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438' \u0438 \u0442\u0430\u043a \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0432\u0430\u0436\u043d\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendime 'i\u00e7sel de\u011ferlerin' zaten \u00e7ok daha \u00f6nemli oldu\u011funu s\u00f6yl\u00fcyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8bf4\u670d\u81ea\u5df1\uff0c\u201c\u5185\u5728\u4ef7\u503c\u201d\u53cd\u6b63\u66f4\u91cd\u8981\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u544a\u8a34\u81ea\u5df1\u300c\u5167\u5728\u50f9\u503c\u89c0\u300d\u7121\u8ad6\u5982\u4f55\u90fd\u66f4\u91cd\u8981\u3002"
          }
        }
      }
    },
    "assessment.fitness.q14.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werde w\u00fctend auf mich selbst und beschlie\u00dfe, morgen h\u00e4rter zu trainieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get mad at myself and decide to train harder tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me enojo conmigo mismo y decido entrenar m\u00e1s duro ma\u00f1ana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'en veux et d\u00e9cide de m'entra\u00eener plus dur demain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0906\u092a \u092a\u0930 \u0915\u094d\u0930\u094b\u0927\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0915\u0932 \u0914\u0930 \u0915\u0921\u093c\u0940 \u091f\u094d\u0930\u0947\u0928\u093f\u0902\u0917 \u0915\u0930\u0928\u0947 \u0915\u093e \u092b\u0948\u0938\u0932\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi arrabbio con me stesso e decido di allenarmi pi\u00f9 duramente domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306b\u8179\u304c\u7acb\u3063\u305f\u306e\u3067\u3001\u660e\u65e5\u306f\u3082\u3063\u3068\u7df4\u7fd2\u3059\u308b\u3053\u3068\u306b\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub098 \uc790\uc2e0\uc5d0\uac8c \ud654\uac00 \ub098\uc11c \ub0b4\uc77c \ub354 \uc5f4\uc2ec\ud788 \ud6c8\ub828\ud558\uae30\ub85c \uacb0\uc2ec\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik word boos op mezelf en besluit morgen harder te trainen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jestem na siebie z\u0142y i postanawiam jutro trenowa\u0107 ci\u0119\u017cej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fico bravo comigo mesmo e decido treinar mais forte amanh\u00e3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0437\u043b\u044e\u0441\u044c \u043d\u0430 \u0441\u0435\u0431\u044f \u0438 \u0440\u0435\u0448\u0430\u044e\u0441\u044c \u0437\u0430\u0432\u0442\u0440\u0430 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0443\u0441\u0435\u0440\u0434\u043d\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendime k\u0131z\u0131yorum ve yar\u0131n daha s\u0131k\u0131 antrenman yapmaya karar veriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5bf9\u81ea\u5df1\u611f\u5230\u751f\u6c14\uff0c\u5e76\u51b3\u5b9a\u660e\u5929\u66f4\u52aa\u529b\u5730\u8bad\u7ec3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5c0d\u81ea\u5df1\u5f88\u751f\u6c23\uff0c\u6c7a\u5b9a\u660e\u5929\u8981\u66f4\u52aa\u529b\u8a13\u7df4\u3002"
          }
        }
      }
    },
    "assessment.fitness.q14.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bestrafe die Schw\u00e4che sofort: Laufschuhe an, raus auf die Stra\u00dfe, 5 Kilometer rennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I punish the weakness immediately: put on running shoes, get out on the street, run 5 kilometers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Castigo la debilidad de inmediato: me pongo zapatillas para correr, salgo a la calle, corro 5 kil\u00f3metros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je punis imm\u00e9diatement la faiblesse : enfilez des chaussures de course, sortez dans la rue, courez 5 kilom\u00e8tres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u092e\u091c\u093c\u094b\u0930\u0940 \u092a\u0930 \u0924\u0941\u0930\u0902\u0924 \u0938\u091c\u093c\u093e \u0926\u0947\u0924\u093e \u0939\u0942\u0901: \u0926\u094c\u0921\u093c\u0928\u0947 \u0935\u093e\u0932\u0947 \u091c\u0942\u0924\u0947 \u092a\u0939\u0928\u094b, \u0938\u0921\u093c\u0915 \u092a\u0930 \u0928\u093f\u0915\u0932\u094b, 5 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0926\u094c\u0921\u093c\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punisco subito la debolezza: mettiti le scarpe da corsa, esci per strada, corri per 5 chilometri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5f31\u3055\u3092\u3059\u3050\u306b\u7f70\u3057\u307e\u3059\u3002\u30e9\u30f3\u30cb\u30f3\u30b0\u30b7\u30e5\u30fc\u30ba\u3092\u5c65\u3044\u3066\u3001\u901a\u308a\u306b\u51fa\u3066\u30015\u30ad\u30ed\u8d70\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc57d\uc810\uc744 \uc989\uc2dc \ucc98\ubc8c\ud569\ub2c8\ub2e4. \uc6b4\ub3d9\ud654\ub97c \uc2e0\uace0 \uac70\ub9ac\ub85c \ub098\uac00\uc11c 5km\ub97c \ub2ec\ub9ac\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik straf de zwakte onmiddellijk: trek hardloopschoenen aan, ga de straat op, ren 5 kilometer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast karz\u0119 s\u0142abo\u015b\u0107: za\u0142\u00f3\u017c buty do biegania, wyjd\u017a na ulic\u0119, przebiegnij 5 kilometr\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Puno a fraqueza imediatamente: cal\u00e7o t\u00eanis, saio na rua, corro 5 quil\u00f4metros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043d\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u044e \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c: \u043d\u0430\u0434\u0435\u0432\u0430\u044e \u043a\u0440\u043e\u0441\u0441\u043e\u0432\u043a\u0438, \u0432\u044b\u0445\u043e\u0436\u0443 \u043d\u0430 \u0443\u043b\u0438\u0446\u0443, \u0431\u0435\u0433\u0443 5 \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zay\u0131fl\u0131\u011f\u0131 hemen cezaland\u0131r\u0131yorum: Ko\u015fu ayakkab\u0131lar\u0131n\u0131 giyin, soka\u011fa \u00e7\u0131k\u0131n, 5 kilometre ko\u015fun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u60e9\u7f5a\u8f6f\u5f31\uff1a\u7a7f\u4e0a\u8dd1\u978b\uff0c\u8dd1\u5230\u8857\u4e0a\uff0c\u8dd1\u4e94\u516c\u91cc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u61f2\u7f70\u5f31\u9ede\uff1a\u7a7f\u4e0a\u8dd1\u978b\uff0c\u5230\u8857\u4e0a\u8dd15\u516c\u91cc\u3002"
          }
        }
      }
    },
    "assessment.fitness.q15": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum willst du \u00fcberhaupt fit oder stark sein?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why do you even want to be fit or strong?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfPor qu\u00e9 quieres estar en forma o ser fuerte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi voulez-vous m\u00eame \u00eatre en forme ou fort\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092b\u093f\u091f \u092f\u093e \u092e\u091c\u092c\u0942\u0924 \u0915\u094d\u092f\u094b\u0902 \u092c\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch\u00e9 vuoi essere in forma o forte?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u306a\u305c\u5065\u5eb7\u306b\u306a\u308a\u305f\u3044\u3001\u5f37\u304f\u306a\u308a\u305f\u3044\u3068\u601d\u3046\u306e\u3067\u3057\u3087\u3046\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc65c \uac74\uac15\ud574\uc9c0\uace0 \uac15\ud574\uc9c0\uace0 \uc2f6\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom wil je \u00fcberhaupt fit of sterk zijn?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego w og\u00f3le chcesz by\u0107 sprawny i silny?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que voc\u00ea quer estar em forma ou forte?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0447\u0435\u043c \u0442\u0435\u0431\u0435 \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u044b\u0442\u044c \u0432 \u0444\u043e\u0440\u043c\u0435 \u0438\u043b\u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u043c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden formda veya g\u00fc\u00e7l\u00fc olmak istiyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4e3a\u4ec0\u4e48 \u00fcberhaupt \u60f3\u8981\u5065\u5eb7\u6216\u5f3a\u58ee\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u4ec0\u9ebc\u4f60\u60f3\u8981\u8b8a\u5f97\u5065\u5eb7\u6216\u5f37\u58ef\uff1f"
          }
        }
      }
    },
    "assessment.fitness.q15.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrlich gesagt trainiere ich nur, damit andere mich attraktiv finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To be honest, I only train so that other people find me attractive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinceramente, s\u00f3lo entreno para que los dem\u00e1s me encuentren atractivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour \u00eatre honn\u00eate, je m\u2019entra\u00eene uniquement pour que les autres me trouvent attirant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0908\u092e\u093e\u0928\u0926\u093e\u0930\u0940 \u0938\u0947 \u0915\u0939\u0942\u0902 \u0924\u094b, \u092e\u0948\u0902 \u0915\u0947\u0935\u0932 \u0907\u0938\u0932\u093f\u090f \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u0924\u093e\u0915\u093f \u0905\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092e\u0948\u0902 \u0906\u0915\u0930\u094d\u0937\u0915 \u0932\u0917\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad essere sincero, mi alleno solo perch\u00e9 gli altri mi trovino attraente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u76f4\u306b\u8a00\u3046\u3068\u3001\u79c1\u306f\u4ed6\u4eba\u306b\u9b45\u529b\u7684\u306b\u601d\u308f\u308c\u308b\u305f\u3081\u306b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3057\u3066\u3044\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc194\uc9c1\ud788 \ub9d0\ud574\uc11c \ub098\ub294 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc774 \ub098\ub97c \ub9e4\ub825\uc801\uc73c\ub85c \ub290\ub07c\ub3c4\ub85d \ud6c8\ub828\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerlijk gezegd train ik alleen zodat andere mensen mij aantrekkelijk vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczerze m\u00f3wi\u0105c, trenuj\u0119 tylko po to, \u017ceby inni uznali mnie za atrakcyjn\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ser sincero, s\u00f3 treino para que outras pessoas me considerem atraente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u044f \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u044e\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u043c\u0435\u043d\u044f \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fcr\u00fcst olmak gerekirse, sadece di\u011fer insanlar beni \u00e7ekici bulsun diye antrenman yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf4\u5b9e\u8bdd\uff0c\u6211\u7ec3\u4e60\u53ea\u662f\u4e3a\u4e86\u8ba9\u522b\u4eba\u89c9\u5f97\u6211\u6709\u5438\u5f15\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aaa\u5be6\u8a71\uff0c\u6211\u8a13\u7df4\u53ea\u662f\u70ba\u4e86\u8b93\u5225\u4eba\u89ba\u5f97\u6211\u6709\u5438\u5f15\u529b\u3002"
          }
        }
      }
    },
    "assessment.fitness.q15.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will auf Social Media gute Bilder posten k\u00f6nnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to be able to post good pictures on social media."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiero poder publicar buenas fotos en las redes sociales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux pouvoir publier de bonnes photos sur les r\u00e9seaux sociaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u092a\u0930 \u0905\u091a\u094d\u091b\u0940 \u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voglio poter pubblicare belle foto sui social media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d20\u6575\u306a\u5199\u771f\u3092SNS\u306b\u6295\u7a3f\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u305f\u3044\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SNS\uc5d0 \uc88b\uc740 \uc0ac\uc9c4\uc744 \uc62c\ub9ac\uace0 \uc2f6\uc5b4\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil goede foto\u2019s op sociale media kunnen plaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chc\u0119 m\u00f3c publikowa\u0107 dobre zdj\u0119cia w mediach spo\u0142eczno\u015bciowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quero poder postar boas fotos nas redes sociais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0445\u043e\u0447\u0443 \u0443\u043c\u0435\u0442\u044c \u0432\u044b\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u0432 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0442\u044f\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosyal medyada g\u00fczel foto\u011fraflar payla\u015fabilmek istiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u60f3\u5728\u793e\u4ea4\u5a92\u4f53\u4e0a\u53d1\u5e03\u597d\u770b\u7684\u7167\u7247\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5e0c\u671b\u80fd\u5920\u5728\u793e\u7fa4\u5a92\u9ad4\u4e0a\u767c\u5e03\u597d\u7167\u7247\u3002"
          }
        }
      }
    },
    "assessment.fitness.q15.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trainiere aus Angst, sp\u00e4ter krank oder schwach zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I train for fear of getting sick or weak later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entreno por miedo a enfermarme o debilitarme m\u00e1s tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'entra\u00eene de peur de tomber malade ou de m'affaiblir plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u093e\u0926 \u092e\u0947\u0902 \u092c\u0940\u092e\u093e\u0930 \u0939\u094b\u0928\u0947 \u092f\u093e \u0915\u092e\u091c\u093c\u094b\u0930 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0921\u0930 \u0938\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alleno per paura di ammalarmi o indebolirmi in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f8c\u3067\u75c5\u6c17\u306b\u306a\u3063\u305f\u308a\u8870\u5f31\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3092\u6050\u308c\u3066\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\uc911\uc5d0 \uc544\ud504\uac70\ub098 \uc57d\ud574\uc9c8\uae4c \ubd10 \ud6c8\ub828\uc744 \ud574\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik train uit angst om later ziek of zwak te worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuj\u0119 ze strachu, \u017ce p\u00f3\u017aniej zachoruj\u0119 lub os\u0142abi\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino com medo de ficar doente ou fraco depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u044e\u0441\u044c \u0438\u0437 \u0441\u0442\u0440\u0430\u0445\u0430 \u043f\u043e\u0437\u0436\u0435 \u0437\u0430\u0431\u043e\u043b\u0435\u0442\u044c \u0438\u043b\u0438 \u043e\u0441\u043b\u0430\u0431\u0435\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sonra hastalanma veya zay\u0131flama korkusuyla antrenman yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u953b\u70bc\u662f\u56e0\u4e3a\u5bb3\u6015\u4ee5\u540e\u751f\u75c5\u6216\u53d8\u5f31\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8a13\u7df4\u662f\u70ba\u4e86\u64d4\u5fc3\u4ee5\u5f8c\u751f\u75c5\u6216\u865b\u5f31\u3002"
          }
        }
      }
    },
    "assessment.fitness.q15.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will wissen, wo mein absolutes k\u00f6rperliches Limit liegt. Es geht um mentale Dominanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to know what my absolute physical limit is. It's about mental dominance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiero saber cu\u00e1l es mi l\u00edmite f\u00edsico absoluto. Se trata de dominio mental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je veux savoir quelle est ma limite physique absolue. Il s'agit de domination mentale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092e\u0947\u0930\u0940 \u092a\u0942\u0930\u094d\u0923 \u0936\u093e\u0930\u0940\u0930\u093f\u0915 \u0938\u0940\u092e\u093e \u0915\u094d\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u092e\u093e\u0928\u0938\u093f\u0915 \u092a\u094d\u0930\u092d\u0941\u0924\u094d\u0935 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voglio sapere qual \u00e8 il mio limite fisico assoluto. Si tratta di dominanza mentale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u7d76\u5bfe\u7684\u306a\u4f53\u529b\u306e\u9650\u754c\u304c\u3069\u306e\u304f\u3089\u3044\u306a\u306e\u304b\u77e5\u308a\u305f\u3044\u3067\u3059\u3002\u305d\u308c\u306f\u7cbe\u795e\u7684\u306a\u512a\u4f4d\u6027\u306b\u3064\u3044\u3066\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\uc758 \uc808\ub300\uc801\uc778 \uc2e0\uccb4\uc801 \ud55c\uacc4\uac00 \ubb34\uc5c7\uc778\uc9c0 \uc54c\uace0 \uc2f6\uc2b5\ub2c8\ub2e4. \uc815\uc2e0\uc801 \uc9c0\ubc30\uc5d0 \uad00\ud55c \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil weten wat mijn absolute fysieke grens is. Het gaat om mentale dominantie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chc\u0119 wiedzie\u0107, jaki jest m\u00f3j absolutny limit fizyczny. Chodzi o dominacj\u0119 mentaln\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quero saber qual \u00e9 o meu limite f\u00edsico absoluto. \u00c9 uma quest\u00e3o de dom\u00ednio mental."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0445\u043e\u0447\u0443 \u0437\u043d\u0430\u0442\u044c, \u0433\u0434\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043c\u043e\u0439 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u0435\u0434\u0435\u043b. \u0420\u0435\u0447\u044c \u0438\u0434\u0435\u0442 \u043e \u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0441\u0442\u0432\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutlak fiziksel s\u0131n\u0131r\u0131m\u0131n ne oldu\u011funu bilmek istiyorum. Bu zihinsel hakimiyetle ilgilidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u60f3\u77e5\u9053\u6211\u7684\u8eab\u4f53\u6781\u9650\u5728\u54ea\u91cc\u3002\u8fd9\u5173\u4e4e\u5fc3\u7406\u4e0a\u7684\u652f\u914d\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u60f3\u77e5\u9053\u6211\u7684\u7d55\u5c0d\u8eab\u9ad4\u6975\u9650\u662f\u591a\u5c11\u3002\u9019\u662f\u95dc\u65bc\u7cbe\u795e\u4e0a\u7684\u7d71\u6cbb\u3002"
          }
        }
      }
    },

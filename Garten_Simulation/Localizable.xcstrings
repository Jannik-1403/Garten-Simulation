    "plant.kirschbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir bewusst Zeit für dich selbst und dein Wohlbefinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consciously take time for yourself and your well-being."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate el tiempo conscientemente para ti y tu bienestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez consciemment du temps pour vous et votre bien-être."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi consapevolmente del tempo per te stesso e per il tuo benessere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意識的に自分の時間と幸福のために時間を取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의식적으로 자신과 웰빙을 위한 시간을 가지세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem bewust tijd voor jezelf en je welzijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świadomie poświęć czas dla siebie i swojego dobrego samopoczucia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedique conscientemente um tempo para si e para o seu bem-estar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinçli olarak kendinize ve refahınıza zaman ayırın."
          }
        }
      }
    },
    "plant.klee.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {

    "plant.apfelbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nähre deinen Körper mit gesunden, selbstgekochten Mahlzeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourish your body with healthy, home-cooked meals."

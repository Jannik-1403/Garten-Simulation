        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible but unbreakable \u2013 Journaling"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u67d4\u8edf\u3060\u304c\u58ca\u308c\u306a\u3044 \u2013 \u30b8\u30e3\u30fc\u30ca\u30ea\u30f3\u30b0"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc720\uc5f0\ud558\uc9c0\ub9cc \uae68\uc9c0\uc9c0 \uc54a\uc74c \u2013 \uc800\ub110\ub9c1"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexibel maar onbreekbaar \u2013 Journaling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elastyczny, ale niezniszczalny \u2013 Journaling"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Flex\u00edvel mas inquebr\u00e1vel \u2013 Journaling"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0438\u0431\u043a\u0438\u0439, \u043d\u043e \u043d\u0435\u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043c\u044b\u0439 \u2013 \u0412\u0435\u0434\u0435\u043d\u0438\u0435 \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnek ama k\u0131r\u0131lmaz \u2013 G\u00fcnl\u00fck Tutma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7075\u6d3b\u4f46\u575a\u4e0d\u53ef\u6467 \u2013 \u65e5\u8bb0"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9748\u6d3b\u4f46\u7262\u4e0d\u53ef\u7834\uff0d\u65e5\u8a18"
          }
        }
      }
    },

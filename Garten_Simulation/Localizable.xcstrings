    "plant.rosmarin.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Würzt das Leben, braucht tägliche Pflege – Meal Prep"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spices up life, needs daily care – Meal Prep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazona la vida, necesita cuidado diario – Meal Prep"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne du goût à la vie, nécessite des soins quotidiens – Meal Prep"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़िंदगी को मसालेदार बनाइए, रोज़ाना देखभाल की ज़रूरत होती है – मील प्रेप"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravviva la vita, ha bisogno di cure quotidiane: preparazione dei pasti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生活にスパイスを加えるには毎日のケアが必要 – 食事の準備"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삶에 활력을 불어넣고 일상적인 관리가 필요합니다 – 식사 준비"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft meer pit aan het leven, heeft dagelijkse verzorging nodig – Maaltijdbereiding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyprawia życie, wymaga codziennej pielęgnacji – Meal Prep"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempera a vida, precisa de cuidados diários – Meal Prep"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempera a vida, precisa de cuidados diários – Meal Prep"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приправляет жизнь, требует ежедневного ухода – подготовка еды"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayata renk katar, günlük bakıma ihtiyaç duyar – Yemek Hazırlığı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为生活增添风味，需要日常照料 – 膳食准备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為生活增添情趣，需要日常照顧－膳食準備"
          }
        }
      }
    },

    "backup_fehler_version": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wurde mit einer neueren App-Version erstellt. Bitte aktualisiere die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was created with a newer version of the app. Please update the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo fue creado con una versi\u00f3n m\u00e1s reciente de la app. Por favor actualiza la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a \u00e9t\u00e9 cr\u00e9\u00e9 avec une version plus r\u00e9cente de l'application. Mets l'application \u00e0 jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092b\u093c\u093e\u0907\u0932 \u090f\u0915 \u0928\u090f \u0910\u092a \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0928\u093e\u0908 \u0917\u0908 \u0925\u0940\u0964 \u0915\u0943\u092a\u092f\u093e \u0910\u092a \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This file was created with a newer version of the app. Please update the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d5\u30a1\u30a4\u30eb\u306f\u3001\u65b0\u3057\u3044\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u30a2\u30d7\u30ea\u3067\u4f5c\u6210\u3055\u308c\u307e\u3057\u305f\u3002\u30a2\u30d7\u30ea\u3092\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud30c\uc77c\uc740 \ucd5c\uc2e0 \ubc84\uc804\uc758 \uc571\uc73c\ub85c \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc571\uc744 \uc5c5\ub370\uc774\ud2b8\ud574\uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is gemaakt met een nieuwere versie van de app. Update de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik zosta\u0142 utworzony w nowszej wersji aplikacji. Zaktualizuj aplikacj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro foi criado com uma vers\u00e3o mais recente da aplica\u00e7\u00e3o. Atualiza a aplica\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e\u0442 \u0444\u0430\u0439\u043b \u0431\u044b\u043b \u0441\u043e\u0437\u0434\u0430\u043d \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0431\u043e\u043b\u0435\u0435 \u043d\u043e\u0432\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya uygulaman\u0131n daha yeni bir s\u00fcr\u00fcm\u00fcyle olu\u015fturuldu. L\u00fctfen uygulamay\u0131 g\u00fcncelleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6587\u4ef6\u662f\u4f7f\u7528\u8f83\u65b0\u7248\u672c\u7684\u5e94\u7528\u7a0b\u5e8f\u521b\u5efa\u7684\u3002\u8bf7\u66f4\u65b0\u5e94\u7528\u7a0b\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a72\u6587\u4ef6\u662f\u4f7f\u7528\u8f03\u65b0\u7684\u61c9\u7528\u7a0b\u5f0f\u7248\u672c\u5efa\u7acb\u7684\u3002\u8acb\u66f4\u65b0\u61c9\u7528\u7a0b\u5f0f\u3002"
          }
        }
      }
    },

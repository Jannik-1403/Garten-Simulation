    "Historie, Notizen und Routine-/Zielzuordnungen werden entfernt. Bereits gespeicherte Fokus-Sessions bleiben als Sitzungsverlauf erhalten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie, Notizen und Routine-/Zielzuordnungen werden entfernt. Bereits gespeicherte Fokus-Sessions bleiben als Sitzungsverlauf erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History, notes, and routine/goal links will be removed. Saved focus sessions remain preserved in your log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán el historial, notas y asignaciones de rutina/meta. Las sesiones de enfoque guardadas se mantendrán en el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique, les notes et les liaisons aux routines/objectifs seront supprimés. Les sessions de focus enregistrées sont conservées dans l'historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास, नोट्स और दिनचर्या/लक्ष्य लिंक हटा दिए जाएंगे। सहेजे गए फोकस सत्र इतिहास में बने रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia, note e associazioni a routine/obiettivi verranno rimosse. Le sessioni di concentrazione salvate rimarranno nella cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴、メモ、ルーティンや目標との連携は削除されます。保存済みのフォーカスセッションはログとして保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록, 메모, 루틴/목표 연결이 삭제됩니다. 이미 저장된 집중 세션은 세션 기록에 보존됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschiedenis, notities en routine-/doelkoppelingen worden verwijderd. Reeds opgeslagen focussessies blijven behouden in het overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia, notatki oraz przypisania do rutyn/celów zostaną usunięte. Zapisane sesje skupienia pozostaną w historii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico, as notas e as ligações a rotinas/metas serão removidos. As sessões de foco guardadas mantêm-se no histórico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico, notas e vínculos com rotinas/metas serão removidos. As sessões de foco salvas permanecem no histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История, заметки и привязки к рутинам/целям будут удалены. Сохраненные сессии фокуса останутся в истории."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş, notlar ve rutin/hedef bağlantıları kaldırılacaktır. Kayıtlı odaklanma oturumları geçmişte korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录、笔记以及日常/目标关联将被移除。已保存的专注会话仍会保留在历史记录中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史記錄、筆記以及日常/目標關聯將被移除。已儲存的專注時段仍會保留在記錄中。"
          }
        }
      }
    },

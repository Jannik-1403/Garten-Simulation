    "pfad_schwierigkeit_experte_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ultimative Herausforderung. Zeige deine Disziplin und meistere anspruchsvolle Aufgaben!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ultimate challenge. Show your discipline and master demanding tasks!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desafío definitivo. ¡Muestra tu disciplina y domina tareas exigentes!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défi ultime. Fais preuve de discipline et maîtrise des tâches exigeantes !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतिम चुनौती. अपना अनुशासन दिखाएं और चुनौतीपूर्ण कार्यों में महारत हासिल करें!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sfida definitiva. Mostra la tua disciplina e supera compiti impegnativi!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "究極の挑戦。規律を示して、要求の厳しいタスクをマスターしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "궁극적인 도전. 당신의 규율을 보여주고 까다로운 작업을 마스터하세요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ultieme uitdaging. Toon je discipline en beheers veeleisende taken!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostateczne wyzwanie. Pokaż swoją dyscyplinę i opanuj wymagające zadania!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desafio definitivo. Mostra a tua disciplina e domina tarefas exigentes!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абсолютный вызов. Покажи свою дисциплину и справься с требовательными задачами!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nihai zorluk. Disiplininizi gösterin ve zorlu görevlerde ustalaşın!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终极挑战。展现你的纪律性，掌握高难度任务！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終極挑戰。展現你的紀律並完成具有挑戰性的任務！"
          }
        }
      }
    },

          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezmy\u015blnie przewija\u0142"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolou sem sentido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u043b \u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlams\u0131zca kayd\u0131rd\u0131"
          }
        },
        "zh-Hans": {

    "plant.kakaobaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Süß nur nach harter Arbeit – Belohnung verdienen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweet only after hard work – Earn the reward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dulce solo tras el esfuerzo – Gánate la recompensa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doux seulement après l'effort – Mériter la récompense"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ कड़ी मेहनत के बाद ही मीठा – इनाम पाने के योग्य"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolce solo dopo un duro lavoro: merita una ricompensa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "苦労した後にのみ甘い – 報酬を獲得する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열심히 일한 후에야 달콤함 – 보상을 받으세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen zoet na hard werken – Verdien de beloning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słodko tylko po ciężkiej pracy – Zdobądź nagrodę"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Doce apenas após esforço – Merecer a recompensa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doce apenas após esforço – Merecer a recompensa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сладко только после тяжёлой работы – заслужить награду"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece çok çalıştıktan sonra tatlı – Ödülü kazanın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有辛勤工作后才甜美 – 赢得奖励"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辛勞之後才甜蜜－值得回報"
          }
        }
      }
    },

    "plant.kaktus.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "St\u00e4rke dein Immunsystem und deine Willenskraft durch kaltes Duschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your immune system and willpower through cold showers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece tu sistema inmunol\u00f3gico y tu fuerza de voluntad con duchas fr\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcez votre syst\u00e8me immunitaire et votre volont\u00e9 par des douches froides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0920\u0902\u0921\u0947 \u092a\u093e\u0928\u0940 \u0938\u0947 \u0928\u0939\u093e\u0928\u0947 \u0938\u0947 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0924\u093f\u0930\u0915\u094d\u0937\u093e \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0914\u0930 \u0907\u091a\u094d\u091b\u093e\u0936\u0915\u094d\u0924\u093f \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforza il tuo sistema immunitario e la tua forza di volont\u00e0 con docce fredde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51b7\u6c34\u30b7\u30e3\u30ef\u30fc\u3067\u514d\u75ab\u529b\u3068\u610f\u5fd7\u529b\u3092\u5f37\u5316\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc2c\ubb3c \uc0e4\uc6cc\ub97c \ud1b5\ud574 \uba74\uc5ed\ub825\uacfc \uc758\uc9c0\ub825\uc744 \uac15\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versterk je immuunsysteem en wilskracht met koude douches."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmocnij sw\u00f3j uk\u0142ad odporno\u015bciowy i si\u0142\u0119 woli dzi\u0119ki zimnym prysznicom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortale\u00e7a seu sistema imunol\u00f3gico e sua for\u00e7a de vontade com banhos frios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0440\u0435\u043f\u043b\u044f\u0439 \u0441\u0432\u043e\u044e \u0438\u043c\u043c\u0443\u043d\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0438 \u0441\u0438\u043b\u0443 \u0432\u043e\u043b\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0443\u0448\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "So\u011fuk du\u015flarla ba\u011f\u0131\u015f\u0131kl\u0131k sisteminizi ve iradenizi g\u00fc\u00e7lendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u51b7\u6c34\u6dcb\u6d74\u589e\u5f3a\u514d\u75ab\u7cfb\u7edf\u548c\u610f\u5fd7\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u51b7\u6c34\u6dcb\u6d74\u589e\u5f37\u60a8\u7684\u514d\u75ab\u7cfb\u7d71\u548c\u610f\u5fd7\u529b\u3002"
          }
        }
      }
    },
    "plant.kirschbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bl\u00fcht nur, wenn man sich gut um ihn k\u00fcmmert \u2013 Selfcare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blooms only with good care \u2013 Selfcare"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Florece solo con buen cuidado \u2013 Autocuidado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleurit seulement avec un bon soin \u2013 Soin de soi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0947\u0935\u0932 \u0924\u092c \u0916\u093f\u0932\u0924\u093e \u0939\u0948 \u091c\u092c \u0909\u0938\u0915\u0940 \u0905\u091a\u094d\u091b\u0940 \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0940 \u091c\u093e\u090f \u2013 \u0906\u0924\u094d\u092e \u0926\u0947\u0916\u092d\u093e\u0932"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blooms only with good care \u2013 Selfcare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9069\u5207\u306a\u30b1\u30a2\u3092\u884c\u3063\u305f\u5834\u5408\u306b\u306e\u307f\u958b\u82b1\u3057\u307e\u3059 \u2013 \u30bb\u30eb\u30d5\u30b1\u30a2"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc30\ub824\uac00 \uc788\uc5b4\uc57c \uaf43\uc774 \ud540\ub2e4 \u2013 \uc140\ud504\ucf00\uc5b4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeit alleen bij goede verzorging \u2013 Selfcare"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnie tylko przy dobrej piel\u0119gnacji \u2013 Selfcare"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce apenas com bons cuidados \u2013 Autocuidado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0432\u0435\u0442\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u043e \u043d\u0451\u043c \u0445\u043e\u0440\u043e\u0448\u043e \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u2013 \u0437\u0430\u0431\u043e\u0442\u0430 \u043e \u0441\u0435\u0431\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca iyi bak\u0131mla \u00e7i\u00e7ek a\u00e7ar \u2013 Ki\u015fisel Bak\u0131m"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u6709\u7cbe\u5fc3\u7167\u6599\u624d\u4f1a\u5f00\u82b1 \u2013 \u81ea\u6211\u5173\u6000"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u6709\u597d\u597d\u7167\u9867\u5b83\uff0c\u5b83\u624d\u6703\u7dbb\u653e\u2500\u2500\u81ea\u6211\u7167\u9867"
          }
        }
      }
    },

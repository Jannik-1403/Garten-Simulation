    "item.unkraut_schild.description" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Unkraut mit dem Schild-Ritual und schützt 24 Stunden vor neuem Unkraut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes weeds with the shield ritual and protects against new weeds for 24 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina malas hierbas con el ritual del escudo y protege 24 h contra nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire les mauvaises herbes par le rituel du bouclier et protège 24 h contre les nouvelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ढाल अनुष्ठान से खर-पतवार को हटाता है और 24 घंटे तक नये खर-पतवार से बचाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le erbacce con il rituale dello scudo e protegge per 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シールドリチュアルで雑草を除去し、新たな雑草を24時間防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방패 의식으로 잡초를 제거하고 24시간 동안 새로운 잡초를 막아줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert onkruid met het schildritueel en beschermt 24 uur lang tegen nieuw onkruid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa chwasty za pomocą rytuału tarczy i chroni przed nowymi chwastami przez 24 godziny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove ervas com o ritual do escudo e protege 24 h contra novas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет сорняки с помощью ритуала щита и защищает от новых сорняков в течение 24 часов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalkan ritüeli ile yabani otları yok eder ve 24 saat boyunca yeni yabani otlara karşı koruma sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过护盾仪式清除杂草，并在24小时内防止新杂草出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過盾牌儀式清除雜草，並在 24 小時內防止新雜草的生長。"
          }
        }
      }
    },

    "assessment.lifestyle.profile.chaot.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Standards sind zu niedrig. Fehlende Ordnung und Konsequenz rauben dir die Klarheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your standards are too low. A lack of order and consistency robs you of clarity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estándares son demasiado bajos. La falta de orden y coherencia te roba la claridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos normes sont trop basses. Un manque d’ordre et de cohérence vous prive de clarté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi standard sono troppo bassi. La mancanza di ordine e coerenza ti priva della chiarezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの基準は低すぎます。秩序と一貫性が欠けていると、明晰さが失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 기준이 너무 낮습니다. 질서와 일관성이 부족하면 명확성이 떨어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je normen zijn te laag. Een gebrek aan orde en consistentie berooft je van duidelijkheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje standardy są zbyt niskie. Brak porządku i konsekwencji pozbawia Cię przejrzystości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus padrões são muito baixos. A falta de ordem e consistência rouba sua clareza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standartlarınız çok düşük. Düzen ve tutarlılık eksikliği sizi netlikten mahrum bırakır."
          }
        }
      }
    },

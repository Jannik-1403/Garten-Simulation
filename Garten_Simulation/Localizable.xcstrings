            "value": "Usa il tuo diario per riflettere sulla tua giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記を使って一日を振り返りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기를 활용해 하루를 되돌아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je dagboek om op je dag te reflecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj swojego dziennika, aby zastanowić się nad swoim dniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o teu diário para refletir sobre o teu dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use seu diário para refletir sobre o seu dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте свой журнал для размышлений о прошедшем дне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğünü kullanarak gününü değerlendir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用日记来反思你的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用日記來反思你的一天。"
          }
        }
      }

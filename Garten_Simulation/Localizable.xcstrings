    "trash.luxus_uhr.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxusgüter machen nach kurzer Zeit nicht mehr glücklicher – das ist wissenschaftlich belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxury goods don't make you happier after a short time – scientifically proven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bienes de lujo no hacen más feliz después de poco tiempo: científicamente probado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les biens de luxe ne rendent pas plus heureux après peu de temps – c'est prouvé scientifiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ज़री सामान थोड़े समय के बाद अधिक खुश नहीं बनाते – यह वैज्ञानिक रूप से सिद्ध है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I beni di lusso non rendono più felici dopo poco tempo – scientificamente provato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高級品は短時間後には幸福感を与えなくなります。科学的に証明されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명품은 짧은 시간 후에는 더 이상 행복하게 만들지 않습니다 – 과학적으로 증명되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxegoederen maken na korte tijd niet meer gelukkiger – dit is wetenschappelijk aangetoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobra luksusowe po krótkim czasie nie czynią szczęśliwszymi – naukowo udowodnione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bens de luxo não tornam mais feliz após pouco tempo – comprovado cientificamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bens de luxo não tornam mais feliz após pouco tempo – comprovado cientificamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предметы роскоши уже не делают вас счастливее через короткое время – это научно доказано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lüks eşyalar kısa süre sonra artık mutlu etmiyor – bilimsel olarak kanıtlanmış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "奢侈品在短时间内不再让你更快乐——这是科学证明的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "奢侈品在短時間內不再讓你更快樂——這是科學證明的。"
          }
        }
      }
    },
    "trash.luxus_uhr.tip.3": {
      "extractionState": "manual",
      "localizations": {

    "prog_cooking_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche etwas, das du noch nie zubereitet hast. Such dir ein gesundes Rezept im Internet und folge ihm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook something you've never cooked before. Find a healthy recipe online and follow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina algo que nunca hayas cocinado antes. Encuentre una receta saludable en línea y sígala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisinez quelque chose que vous n'avez jamais cuisiné auparavant. Trouvez une recette saine en ligne et suivez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ऐसा पकाएं जो आपने पहले कभी नहीं पकाया हो। ऑनलाइन एक स्वस्थ नुस्खा खोजें और उसका पालन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina qualcosa che non hai mai cucinato prima. Trova una ricetta salutare online e seguila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでに作ったことのないものを作ります。オンラインで健康的なレシピを見つけて、それに従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번도 요리해 본 적이 없는 것을 요리해 보세요. 온라인에서 건강한 요리법을 찾아 따라해보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook iets dat je nog nooit eerder hebt gekookt. Zoek online een gezond recept en volg het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugotuj coś, czego nigdy wcześniej nie gotowałeś. Znajdź w Internecie zdrowy przepis i postępuj zgodnie z nim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe algo que você nunca cozinhou antes. Encontre uma receita saudável online e siga-a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe algo que você nunca cozinhou antes. Encontre uma receita saudável online e siga-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приготовьте то, что вы никогда раньше не готовили. Найдите в Интернете здоровый рецепт и следуйте ему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce hiç pişirmediğiniz bir şeyi pişirin. İnternetten sağlıklı bir tarif bulun ve uygulayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "煮一些你以前从未煮过的东西。在线查找健康食谱并遵循。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "煮一些你從未煮過的東西。在線查找健康食譜並遵循。"
          }
        }
      }
    },

    "cheat_punishment.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die App- & Website-Aktivitäten in den iOS-Einstellungen deaktiviert. Damit hast du das Fundament deines Gartens zerstört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have disabled App & Website Activities in the iOS settings. With this, you have destroyed the foundation of your garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has desactivado las Actividades de Apps y Sitios Web en los ajustes de iOS. Con esto, has destruido los cimientos de tu jardín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez désactivé les Activités des apps et des sites web dans les réglages d'iOS. Avec cela, vous avez détruit les fondations de votre jardin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने iOS सेटिंग्स में ऐप और वेबसाइट गतिविधियों को अक्षम कर दिया है। इसके साथ, आपने अपने बगीचे की नींव नष्ट कर दी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai disabilitato le Attività di app e siti web nelle impostazioni di iOS. Con questo, hai distrutto le fondamenta del tuo giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定でアプリとウェブサイトのアクティビティを無効にしました。これにより、あなたは庭の基盤を破壊しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 앱 및 웹사이트 활동을 비활성화했습니다. 이로써 정원의 기반이 파괴되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt App- en website-activiteiten uitgeschakeld in de iOS-instellingen. Hiermee heb je de fundering van je tuin vernietigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączyłeś Aktywność aplikacji i witryn w ustawieniach iOS. Tym samym zniszczyłeś fundamenty swojego ogrodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você desativou as Atividades de Apps e Sites nos ajustes do iOS. Com isso, você destruiu os alicerces do seu jardim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você desativou as Atividades de Apps e Sites nos ajustes do iOS. Com isso, você destruiu os alicerces do seu jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отключили активность приложений и веб-сайтов в настройках iOS. Тем самым вы разрушили фундамент своего сада."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ayarlarında Uygulama ve Web Sitesi Etkinliklerini devre dışı bıraktınız. Bununla bahçenizin temelini yok ettiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已在 iOS 设置中禁用了应用程序和网站活动。你毁掉了你花园的地基。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已在 iOS 設定中停用了應用程式和網站活動。你毀掉了你花園的地基。"
          }
        }
      }
    },

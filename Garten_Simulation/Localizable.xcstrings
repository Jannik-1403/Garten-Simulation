            "value": "\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015far\u0131lar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6210\u5c31"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6210\u5c31"
          }
        }
      }
    },
    "tour_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Fortschritte im Auge und versuche, deine Streak nicht abrei\u00dfen zu lassen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep an eye on your progress and try not to break your streak!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Est\u00e9 atento a su progreso y trate de no romper su racha!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un \u0153il sur vos progr\u00e8s et essayez de ne pas interrompre votre s\u00e9quence\u00a0!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u092a\u0930 \u0928\u091c\u0930 \u0930\u0916\u0947\u0902 \u0914\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u091f\u0942\u091f \u0928 \u091c\u093e\u090f!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni d'occhio i tuoi progressi e cerca di non interrompere la tua serie di vittorie consecutive!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u9032\u6b69\u306b\u6ce8\u76ee\u3057\u3066\u3001\u9023\u7d9a\u8a18\u9332\u3092\u9014\u5207\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc8fc\uc2dc\ud558\uace0 \uc5f0\uc18d \uae30\ub85d\uc744 \uae68\ub728\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \ub178\ub825\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je voortgang in de gaten en probeer je streak niet te breken!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj swoje post\u0119py i staraj si\u0119 nie przerwa\u0107 swojej passy!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique de olho no seu progresso e tente n\u00e3o quebrar sua seq\u00fc\u00eancia!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0441\u0432\u043e\u0438\u043c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u043e\u043c \u0438 \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u0441\u0432\u043e\u0435\u0439 \u0441\u0435\u0440\u0438\u0438 \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c\u0441\u044f!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lerlemenize dikkat edin ve serinizi bozmamaya \u00e7al\u0131\u015f\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bc6\u5207\u5173\u6ce8\u4f60\u7684\u8fdb\u6b65\uff0c\u5c3d\u91cf\u4e0d\u8981\u8ba9\u4f60\u7684\u8fde\u80dc\u88ab\u6253\u7834\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bc6\u5207\u6ce8\u610f\u4f60\u7684\u9032\u6b65\uff0c\u76e1\u91cf\u4e0d\u8981\u8b93\u4f60\u7684\u9023\u52dd\u88ab\u6253\u7834\uff01"
          }
        }
      }
    },

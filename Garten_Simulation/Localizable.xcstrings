    "assessment.growth.profile.macher.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeide es, Aufgaben anderer zu übernehmen, nur weil du es 'schneller' erledigen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid taking on other people's tasks just because you can do it 'quicker'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite asumir tareas de otras personas sólo porque puede hacerlo \"más rápido\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez de vous charger des tâches des autres simplement parce que vous pouvez les faire « plus rapidement »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे लोगों के काम सिर्फ़ इसलिए अपने ऊपर लेने से बचें क्योंकि आप इसे 'तेज़ी से' कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita di assumerti i compiti di altre persone solo perché puoi farlo \"più velocemente\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のほうが「早く」できるからといって、他の人のタスクを引き受けないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단지 '더 빨리' 할 수 있다는 이유만으로 다른 사람의 작업을 떠맡는 것을 피하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem niet de taken van anderen over, alleen maar omdat u het 'sneller' kunt doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj podejmowania zadań innych osób tylko dlatego, że możesz to zrobić „szybciej”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite assumir tarefas de outras pessoas só porque você pode fazer isso “mais rápido”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избегай брать на себя задачи других, только потому что ты можешь выполнить их «быстрее»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırf 'daha hızlı' yapabileceğiniz için başkalarının görevlerini üstlenmekten kaçının."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免仅仅因为你能更快完成就接手别人的任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免僅僅因為你可以「更快」地完成其他人的任務。"
          }
        }
      }
    },
    "assessment.growth.profile.macher.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentiere jeden Freitag für 5 Minuten einen Prozess per Video, um ihn in Zukunft delegieren zu können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Document a process on video for 5 minutes every Friday so you can delegate it in the future."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documenta un proceso en vídeo durante 5 minutos todos los viernes para poder delegarlo en el futuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentez un processus en vidéo pendant 5 minutes chaque vendredi afin de pouvoir le déléguer à l'avenir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक शुक्रवार को 5 मिनट के लिए वीडियो पर एक प्रक्रिया का दस्तावेजीकरण करें ताकि आप इसे भविष्य में सौंप सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documenta un processo in video per 5 minuti ogni venerdì in modo da poterlo delegare in futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週金曜日に 5 分間プロセスをビデオで記録し、将来それを委任できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 위임할 수 있도록 매주 금요일 5분 동안 프로세스를 비디오로 문서화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documenteer elke vrijdag gedurende 5 minuten een proces op video, zodat u dit in de toekomst kunt delegeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumentuj proces na wideo przez 5 minut w każdy piątek, aby móc go delegować w przyszłości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documente um processo em vídeo por 5 minutos todas as sextas-feiras para que você possa delegá-lo no futuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Документируйте процесс каждую пятницу в течение 5 минут с помощью видео, чтобы в будущем его можно было передать другим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir işlemi her Cuma 5 dakika boyunca videoyla belgeleyin, böylece gelecekte bu işlemi devredebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周五用视频记录一个流程5分钟，以便将来能够委派它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週五用 5 分鐘的視訊記錄流程，以便您將來可以將其委派給他人。"
          }
        }
      }
    },
    "assessment.growth.profile.macher.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lieferst ab. Die letzten 1％ liegen in der Skalierung: Du darfst nicht selbst zum Flaschenhals werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deliver. The last 1％ is in scaling: you can't become a bottleneck yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú entregas. El último 1％ está en escala: usted mismo no puede convertirse en un cuello de botella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous livrez. Le dernier 1 ％ est consacré à la mise à l'échelle : vous ne pouvez pas devenir vous-même un goulot d'étranglement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप वितरित करें. अंतिम 1％ स्केलिंग में है: आप स्वयं बाधा नहीं बन सकते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu consegni. L'ultimo 1％ riguarda il ridimensionamento: non puoi diventare tu stesso un collo di bottiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが配達します。最後の 1％ はスケーリングに関係します。自分自身がボトルネックになることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 배달합니다. 마지막 1％는 확장에 있습니다. 스스로 병목 현상을 일으킬 수는 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij levert. De laatste 1％ zit in schaalvergroting: je kunt zelf geen knelpunt worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostarczasz. Ostatni 1％ to skalowanie: nie możesz sam stać się wąskim gardłem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entrega. O último 1％ está no dimensionamento: você mesmo não pode se tornar um gargalo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты сдаёшься. Последние 1％ заключаются в масштабировании: не позволяй самому себе стать узким местом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen teslim et. Geriye kalan ％1 ise ölçeklendirmeyle ilgilidir: Kendi başınıza bir darboğaz haline gelemezsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你交付成果。最后的1％在于扩展：你不能自己成为瓶颈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你交付。最後 1％ 是擴充：你自己不能成為瓶頸。"
          }
        }
      }
    },

    "assessment.fitness.profile.ausreden_sucher.build": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm Verantwortung für deinen Körper. Etabliere eine 'No-Excuses'-Mentalität und starte mit kleinen, täglichen Workouts."
          }
        },
        "en": {
          "stringUnit": {

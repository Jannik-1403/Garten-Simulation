    "trash.nacht_snack_box.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe eine Woche lang Buch über Abend-Snacks – die Gesamtkalorien überraschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep track of evening snacks for a week – the total calories will surprise you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva un registro de los aperitivos nocturnos durante una semana: el total de calorías te sorprenderá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note tes collations du soir pendant une semaine – le total des calories te surprendra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रात के स्नैक्स का एक सप्ताह तक रिकॉर्ड रखें – कुल कैलोरी आपको चकित कर सकती हैं।"
          }
        },
        "it": {
          "stringUnit": {

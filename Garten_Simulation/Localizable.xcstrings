          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a\u043e\u0432\u0430 \u0442\u0432\u043e\u044f \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0441\u0430\u0434\u0430?"

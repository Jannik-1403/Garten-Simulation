    "plant.chrysantheme.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnung = Blüte – Sauberkeit & Aufräumen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order = Bloom – Cleanliness & Tidying"
          }

    "item.zauberstab.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein magischer Stab, der 3 Tage lang automatisch das Unkraut wegzaubert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A magic wand that automatically removes weeds for 3 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una varita mágica que elimina automáticamente las malas hierbas durante 3 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une baguette magique qui élimine automatiquement les mauvaises herbes pendant 3 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जादुई कर्मचारी जो 3 दिनों तक स्वचालित रूप से खर-पतवार हटाता है।"
          }
        },
        "it": {
          "stringUnit": {

    "screenTime.suggestions.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Kategorie – der Apple-Picker öffnet sich, wo du die Apps auswählen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a category – the Apple Picker opens so you can select apps to block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una categoría – se abre el selector de Apple para que puedas seleccionar apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une catégorie – le sélecteur Apple s'ouvre pour choisir les apps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी श्रेणी पर टैप करें - ऐप्पल पिकर खुलता है जहां आप ऐप्स का चयन कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una categoria – si apre il selettore Apple per scegliere le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリをタップすると、Appleのピッカーが開きアプリを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리를 탭하면 Apple 피커가 열려 앱을 선택할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een categorie – de Apple-picker opent om apps te selecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij kategorię – otworzy się Apple Picker, gdzie możesz wybrać aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa categoria – o seletor da Apple abre para escolher apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa categoria – o seletor da Apple abre para escolher apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь категории — откроется окно выбора Apple, в котором можно выбрать приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kategoriye dokun – Apple Seçici açılır, uygulama seçebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击类别 - Apple 选择器将打开，您可以在其中选择应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊類別 - Apple 選擇器將打開，您可以在其中選擇應用程式。"
          }
        }
      }
    },

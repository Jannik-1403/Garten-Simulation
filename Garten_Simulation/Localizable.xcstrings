        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u091c\u0940\u0935\u0928 \u0915\u093f\u0924\u0928\u093e \u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u0939\u0948?"

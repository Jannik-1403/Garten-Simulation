    "tour_routine_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcndele mehrere Gewohnheiten zu einer Routine und starte sie gemeinsam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle multiple habits into a routine and start them together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa varios h\u00e1bitos en una rutina e in\u00edcielos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez plusieurs habitudes dans une routine et lancez-les ensemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0908 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u090f\u0915 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u092e\u0947\u0902 \u092c\u093e\u0901\u0927\u094b \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915 \u0938\u093e\u0925 \u0936\u0941\u0930\u0942 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa pi\u00f9 abitudini in una routine e avviale insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8907\u6570\u306e\u7fd2\u6163\u3092\u30eb\u30fc\u30c6\u30a3\u30f3\u306b\u307e\u3068\u3081\u3066\u3001\u4e00\u7dd2\u306b\u958b\u59cb\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ec\ub7ec \uc2b5\uad00\uc744 \ub8e8\ud2f4\uc73c\ub85c \ubb36\uc5b4 \ud568\uaed8 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundel meerdere gewoonten in een routine en start ze samen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po\u0142\u0105cz kilka nawyk\u00f3w w rutyn\u0119 i zacznij je razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa v\u00e1rios h\u00e1bitos numa rotina e inicia-os juntos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a \u0432 \u0440\u0443\u0442\u0438\u043d\u0443 \u0438 \u043d\u0430\u0447\u043d\u0438\u0442\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0438\u0445 \u0432\u043c\u0435\u0441\u0442\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla al\u0131\u015fkanl\u0131\u011f\u0131 bir rutine toplay\u0131n ve birlikte ba\u015flat\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u51e0\u4e2a\u4e60\u60ef\u6346\u7ed1\u6210\u4e00\u4e2a\u65e5\u5e38\u4e60\u60ef\uff0c\u7136\u540e\u4e00\u8d77\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u5e7e\u500b\u7fd2\u6163\u6346\u7d81\u6210\u4e00\u500b\u65e5\u5e38\u7fd2\u6163\uff0c\u7136\u5f8c\u4e00\u8d77\u958b\u59cb\u3002"
          }
        }
      }
    },
    "tour_routine_prompt_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Routine, um sie zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a routine to start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una rutina para iniciarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une routine pour la d\u00e9marrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u0930\u0942\u091f\u0940\u0928 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una routine per avviarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30eb\u30fc\u30c6\u30a3\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u3066\u958b\u59cb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub8e8\ud2f4\uc744 \ud0ed\ud558\uc5ec \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een routine om te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij rutyny, aby j\u0105 uruchomi\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa rotina para a iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015flatmak i\u00e7in bir rutine dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u4e00\u4e2a\u4f8b\u7a0b\u5373\u53ef\u542f\u52a8\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u64ca\u4e00\u500b\u4f8b\u7a0b\u5373\u53ef\u555f\u52d5\u5b83\u3002"
          }
        }
      }
    },

    "onboarding_tutorial_2_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pflanzen wachsen von Bronze bis Diamant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plants grow from Bronze to Diamond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus plantas crecen de bronce a diamante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes plantes poussent de Bronze \u00e0 Diamant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092a\u094c\u0927\u0947 \u0915\u093e\u0902\u0938\u0947 \u0938\u0947 \u0939\u0940\u0930\u0947 \u0924\u0915 \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plants grow from Bronze to Diamond."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u306f\u30d6\u30ed\u30f3\u30ba\u304b\u3089\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u307e\u3067\u6210\u9577\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadc0\ud558\uc758 \uc2dd\ubb3c\uc740 \ube0c\ub860\uc988\uc5d0\uc11c \ub2e4\uc774\uc544\ubaac\ub4dc\uae4c\uc9c0 \uc790\ub78d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je planten groeien van Brons naar Diamant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ro\u015bliny rosn\u0105 od br\u0105zu do diamentu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas plantas crescem de Bronze a Diamante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0443\u0442 \u043e\u0442 \u0431\u0440\u043e\u043d\u0437\u044b \u0434\u043e \u0430\u043b\u043c\u0430\u0437\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkileriniz Bronz'dan Elmas'a kadar b\u00fcy\u00fcr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u690d\u7269\u4ece\u9752\u94dc\u7ea7\u6210\u957f\u5230\u94bb\u77f3\u7ea7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u690d\u7269\u5f9e\u9752\u9285\u6210\u9577\u70ba\u947d\u77f3\u3002"
          }
        }
      }
    },

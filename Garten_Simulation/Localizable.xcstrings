    "assessment.finance.profile.verdraenger.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verschließt die Augen vor deiner finanziellen Realität. Beginne sofort damit, einen klaren Überblick über deine Einnahmen und Ausgaben zu schaffen."

    "assessment.health.profile.vergifter.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle deinen Körper wie eine Hochleistungsmaschine. Müll rein — Müll raus. Fang mit einer Flasche Wasser an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat your body like a high-performance machine. Garbage in - garbage out. Start with a bottle of water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trate su cuerpo como una máquina de alto rendimiento. Basura entra, basura sale. Comience con una botella de agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traitez votre corps comme une machine performante. Déchets à l'intérieur - déchets à l'extérieur. Commencez par une bouteille d'eau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने शरीर को एक उच्च-प्रदर्शन मशीन की तरह समझें। कचरा आया कचरा गया। पानी की एक बोतल से शुरुआत करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratta il tuo corpo come una macchina ad alte prestazioni. Immondizia in entrata, immondizia in uscita. Inizia con una bottiglia d'acqua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の体を高性能マシンのように扱ってください。ゴミの流入 - ゴミの流出。まずは水の入ったボトルから始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 몸을 고성능 기계처럼 다루십시오. 쓰레기 투입 - 쓰레기 배출. 물 한 병으로 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandel je lichaam als een krachtige machine. Vuilnis erin, afval eruit. Begin met een fles water."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traktuj swoje ciało jak wydajną maszynę. Śmieci na wejściu - śmieci na zewnątrz. Zacznij od butelki wody."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trate seu corpo como uma máquina de alto desempenho. Entra lixo - sai lixo. Comece com uma garrafa de água."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обращайся со своим телом как с высокопроизводительным механизмом. Мусор внутрь — мусор наружу. Начни с бутылки воды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vücudunuza yüksek performanslı bir makine gibi davranın. Çöp girişi - çöp çıkışı. Bir şişe su ile başlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的身体当作一台高性能机器来对待。输入垃圾——输出垃圾。从一瓶水开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像對待一台高性能機器一樣對待您的身體。垃圾進-垃圾出。從一瓶水開始。"
          }
        }
      }
    },
    "assessment.health.profile.vergifter.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagere ungesunde Snacks nicht mehr in Augenhöhe, sondern im hintersten Fach ganz oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop storing unhealthy snacks at eye level and instead store them at the top in the back compartment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deje de almacenar bocadillos no saludables a la altura de los ojos y guárdelos en la parte superior del compartimento trasero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez de ranger les collations malsaines à la hauteur des yeux et rangez-les plutôt en haut dans le compartiment arrière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्वास्थ्यकर स्नैक्स को आंखों के स्तर पर संग्रहित करना बंद करें और इसके बजाय उन्हें पीछे के डिब्बे में शीर्ष पर संग्रहित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetti di conservare gli snack malsani all'altezza degli occhi e conservali invece in alto, nello scomparto posteriore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不健康なスナックを目の高さに保管するのをやめ、後ろのコンパートメントの上部に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강에 해로운 간식을 눈높이에 보관하지 말고 대신 뒤쪽 수납칸 상단에 보관하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar ongezonde tussendoortjes niet langer op ooghoogte, maar bewaar ze bovenaan in het achtervak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań przechowywać niezdrowe przekąski na wysokości oczu i zamiast tego przechowuj je na górze, w tylnej komorze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare de armazenar lanches não saudáveis ​​na altura dos olhos e, em vez disso, guarde-os na parte superior, no compartimento traseiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не храни нездоровые закуски на уровне глаз, а в самом верхнем заднем отделении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlıksız atıştırmalıkları göz hizasında saklamayı bırakın ve bunun yerine üstteki arka bölmede saklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要再把不健康的零食放在视线平齐的位置，而要放在最里面的最上层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要將不健康的零食存放在與視線齊平的位置，而應將其存放在後部隔層的頂部。"
          }
        }
      }
    },
    "assessment.health.profile.vergifter.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausche täglich nur einen einzigen zuckerhaltigen Snack gegen eine Handvoll Nüsse oder einen Apfel aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swap just one sugary snack each day for a handful of nuts or an apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambie solo un refrigerio azucarado cada día por un puñado de nueces o una manzana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacez une seule collation sucrée chaque jour par une poignée de noix ou une pomme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक दिन केवल एक मीठे नाश्ते की जगह मुट्ठी भर मेवे या एक सेब लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia solo uno spuntino zuccherato ogni giorno con una manciata di noci o una mela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日、甘いスナックを 1 つだけ、一握りのナッツまたはリンゴと交換してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 한 줌의 견과류나 사과로 달콤한 간식을 바꾸세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verruil elke dag slechts één suikerrijke snack voor een handvol noten of een appel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamień tylko jedną słodką przekąskę każdego dnia na garść orzechów lub jabłka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque apenas um lanche açucarado por dia por um punhado de nozes ou uma maçã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняйте каждый день всего один сладкий перекус на горсть орехов или одно яблоко."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün sadece bir şekerli atıştırmalığı bir avuç fındık veya bir elma ile değiştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天只把一份含糖零食换成一把坚果或一个苹果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天只吃一份含糖零食，換成一把堅果或一個蘋果。"
          }
        }
      }
    },
    "assessment.health.profile.vergifter.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du füllst den falschen Kraftstoff ein. Keine radikale Diät – wir verändern nur die Umgebung um 1％, um die Gewohnheit zu brechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're putting the wrong fuel in. Not a radical diet - we just change the environment by 1％ to break the habit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás poniendo el combustible equivocado. No es una dieta radical: simplemente cambiamos el medio ambiente en un 1％ para romper con el hábito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous mettez le mauvais carburant. Pas un régime radical - nous modifions simplement l'environnement de 1 ％ pour rompre avec cette habitude."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप गलत ईंधन डाल रहे हैं। कोई कट्टरपंथी आहार नहीं - हम आदत को तोड़ने के लिए पर्यावरण को सिर्फ 1％ बदलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai inserendo il carburante sbagliato. Non è una dieta radicale: cambiamo semplicemente l'ambiente dell'1％ per rompere l'abitudine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違った燃料を入れています。過激なダイエットではありません。習慣を断ち切るために環境を 1％ 変えるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못된 연료를 넣고 있는 것입니다. 급진적인 다이어트는 아닙니다. 습관을 깨기 위해 환경을 1％만 바꾸는 것뿐입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je stopt er de verkeerde brandstof in. Geen radicaal dieet; we veranderen alleen de omgeving met 1％ om de gewoonte te doorbreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tankujesz złe paliwo. Nie jest to radykalna dieta – po prostu zmieniamy środowisko o 1％, aby przełamać nawyk."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está colocando o combustível errado. Não é uma dieta radical - apenas mudamos o ambiente em 1％ para quebrar o hábito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты заливаешь неправильное топливо. Никаких радикальных диет — мы просто меняем окружение на 1％, чтобы сломать привычку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanlış yakıt koyuyorsunuz. Radikal bir diyet değil; sadece alışkanlığı kırmak için çevreyi ％1 oranında değiştiriyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你加错燃料了。不是激进的节食——我们只是把环境改变1％，以打破习惯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你添加了錯誤的燃料。不是激進的飲食——我們只是改變 1％ 的環境來改掉這個習慣。"
          }
        }
      }
    },

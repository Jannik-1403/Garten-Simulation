        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 사람들이지만 그들 중 누구도 나에게 도전하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "screenTime.layer2.confirm.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wenn du dies bestätigst, kann es nicht mehr rückgängig gemacht werden, außer du entsperrst es mühsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you confirm this, it cannot be undone unless you laboriously unlock it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez que confirmes esto, no podrás deshacerlo a menos que lo desbloquees laboriosamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois que vous avez confirmé cela, il ne peut être annulé que si vous le déverrouillez laborieusement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार जब आप इसकी पुष्टि कर लेते हैं, तो इसे तब तक पूर्ववत नहीं किया जा सकता जब तक आप परिश्रमपूर्वक इसे अनलॉक नहीं करते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta confermato, non è possibile annullarlo a meno che non lo sblocchi faticosamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを確認すると、苦労してロックを解除しない限り、元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이를 확인한 후에는 힘들게 잠금을 해제하지 않는 한 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra u dit bevestigt, kan dit niet meer ongedaan worden gemaakt, tenzij u het moeizaam ontgrendelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy to potwierdzisz, nie będzie można tego cofnąć, chyba że mozolnie go odblokujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de confirmar isso, não será possível desfazê-lo, a menos que você o desbloqueie laboriosamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как только вы подтвердите это, его нельзя будет отменить, если вы не разблокируете его с большим трудом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu onayladıktan sonra, zahmetli bir şekilde kilidini açmadığınız sürece bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦确认，就无法撤消，除非您费力地解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦確認，就無法撤銷，除非您費力地解鎖。"
          }
        }
      }
    },

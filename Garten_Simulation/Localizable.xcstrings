        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mache täglich genau eine Liegestütze oder lies genau eine Seite. Die Hürde muss lächerlich klein sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do exactly one push-up or read exactly one page every day. The hurdle has to be ridiculously small."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz exactamente una flexión o lee exactamente una página todos los días. El obstáculo tiene que ser ridículamente pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites exactement une pompe ou lisez exactement une page chaque jour. L’obstacle doit être ridiculement petit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन बिल्कुल एक पुश-अप करें या ठीक एक पेज पढ़ें। बाधा हास्यास्पद रूप से छोटी होनी चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai esattamente una flessione o leggi esattamente una pagina ogni giorno. L’ostacolo deve essere ridicolmente piccolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日ちょうど 1 回の腕立て伏せをするか、ちょうど 1 ページの読書をしてください。ハードルはとんでもなく低いはずだ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 정확히 한 번만 푸시업을 하거나 정확히 한 페이지를 읽으세요. 장애물은 엄청나게 작아야합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe elke dag precies één push-up of lees precies één pagina. De hindernis moet belachelijk klein zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codziennie rób dokładnie jedną pompkę lub czytaj dokładnie jedną stronę. Przeszkoda musi być śmiesznie mała."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça exatamente uma flexão ou leia exatamente uma página todos os dias. O obstáculo deve ser ridiculamente pequeno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делай ежедневно ровно один отжим или читай ровно одну страницу. Порог должен быть смехотворно маленьким."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün tam olarak bir şınav çekin veya tam olarak bir sayfa okuyun. Engel gülünç derecede küçük olmalı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天只做一个俯卧撑或只读一页。门槛必须非常低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天只做一個伏地挺身或閱讀一頁。這個障礙必須小得離譜。"
          }
        }
      }
    },
    "assessment.growth.profile.aufgeber.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald es schwer wird, schmeißt du hin. Wir machen die Einstiegshürde so absurd klein, dass du nicht aufgeben kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as it gets difficult, you give up. We make the barrier to entry so absurdly small that you can't give up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan pronto como se pone difícil, te rindes. Hacemos que la barrera de entrada sea tan absurdamente pequeña que no puedes rendirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que ça devient difficile, on abandonne. Nous rendons la barrière à l’entrée si absurdement petite que vous ne pouvez pas abandonner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही यह कठिन हो जाता है, आप हार मान लेते हैं। हम प्रवेश की बाधा को इतना छोटा बना देते हैं कि आप हार नहीं मान सकते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non appena diventa difficile, ti arrendi. Rendiamo la barriera all'ingresso così assurdamente piccola che non puoi arrenderti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難しくなるとすぐに諦めてしまいます。私たちは参入障壁を非常に低くしているので、あなたは諦めることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힘들면 바로 포기하세요. 우리는 포기할 수 없을 정도로 진입 장벽을 너무 작게 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra het moeilijk wordt, geef je het op. Wij maken de toetredingsdrempel zo absurd klein dat je niet kunt opgeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy tylko zrobi się trudno, poddajesz się. Sprawiamy, że bariera wejścia jest tak absurdalnie mała, że ​​nie można się poddać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim que fica difícil, você desiste. Tornamos a barreira de entrada tão absurdamente pequena que você não consegue desistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как только становится тяжело, ты сдаешься. Мы делаем порог входа настолько абсурдно маленьким, что ты не сможешь сдаться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorlaştığı anda vazgeçiyorsun. Giriş engelini o kadar küçük yapıyoruz ki vazgeçemiyorsunuz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦变得困难，你就放弃。我们把入门门槛做得非常低，以至于你无法放弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦變得困難，你就會放棄。我們將進入門檻設置得小得離譜，讓您無法放棄。"
          }
        }
      }
    },

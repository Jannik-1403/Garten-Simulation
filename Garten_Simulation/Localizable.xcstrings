    "leben.regel1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieße deine Pflanzen täglich um Leben zu behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants daily to keep your lives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tus plantas cada día para mantener tus vidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrose tes plantes quotidiennement pour garder tes vies"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जीवन बनाए रखने के लिए अपने पौधों को प्रतिदिन पानी दें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Innaffia le piante ogni giorno per mantenere le vite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "命を守るために毎日植物に水をあげましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생명을 유지하려면 매일 식물에 물을 주세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef uw planten dagelijks water om uw leven te behouden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewaj rośliny codziennie, aby zachować życie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega as tuas plantas diariamente para manter as vidas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega as tuas plantas diariamente para manter as vidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поливай свои растения каждый день, чтобы сохранить жизнь"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşamınızı sürdürmek için bitkilerinizi günlük olarak sulayın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天给你的植物浇水以保持生命"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天給植物澆水以保持生命"
          }
        }
      }
    },
    "leben.regel2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stirbt eine Pflanze, verlierst du ein Leben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a plant dies, you lose one life"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si una planta muere, pierdes una vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une plante meurt, tu perds une vie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि एक पौधा मर जाता है, तो आप एक जीवन खो देते हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se una pianta muore, perdi una vita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物が枯れると命が一つ失われる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 죽으면 생명 하나를 잃습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een plant sterft, verlies je één leven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli roślina obumrze, tracisz jedno życie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se uma planta morrer, perdes uma vida"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se uma planta morrer, perdes uma vida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если растение погибает, ты теряешь жизнь"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitki ölürse bir can kaybedersiniz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果一株植物死亡，你将失去一条生命"

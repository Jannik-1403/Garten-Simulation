    "paywall.feature.shop_discount.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir doppelt so schnell neue Pflanzen. Dein Erfolg wird direkt sichtbar belohnt (400 statt 800 M\u00fcnzen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get new plants twice as fast. Your success is visibly rewarded right away (400 instead of 800 coins)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue nuevas plantas el doble de r\u00e1pido. Tu \u00e9xito es recompensado visiblemente (400 en lugar de 800 monedas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiens de nouvelles plantes deux fois plus vite. Ton succ\u00e8s est r\u00e9compens\u00e9 visiblement et imm\u00e9diatement (400 au lieu de 800 pi\u00e8ces)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u0917\u0941\u0928\u0940 \u0924\u0947\u091c\u0940 \u0938\u0947 \u0928\u092f\u0947 \u092a\u094c\u0927\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u0940 \u0938\u092b\u0932\u0924\u093e \u0915\u093e \u0924\u0941\u0930\u0902\u0924 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0930\u0942\u092a \u0938\u0947 \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e (800 \u0938\u093f\u0915\u094d\u0915\u094b\u0902 \u0915\u0947 \u092c\u091c\u093e\u092f 400)\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni nuove piante il doppio pi\u00f9 velocemente. Il tuo successo viene premiato visibilmente (400 invece di 800 monete)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2\u500d\u306e\u901f\u3055\u3067\u65b0\u3057\u3044\u690d\u7269\u3092\u624b\u306b\u5165\u308c\u307e\u3057\u3087\u3046\u3002\u6210\u529f\u306f\u3059\u3050\u306b\u76ee\u306b\u898b\u3048\u308b\u5f62\u3067\u5831\u308f\u308c\u307e\u3059\uff08800\u30b3\u30a4\u30f3\u3067\u306f\u306a\u304f400\u30b3\u30a4\u30f3\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub450 \ubc30 \ub354 \ube68\ub9ac \uc0c8\ub85c\uc6b4 \uc2dd\ubb3c\uc744 \uc5bb\uc73c\uc138\uc694. \uc131\uacf5\uc740 \uc989\uc2dc \ub208\uc5d0 \ub744\uac8c \ubcf4\uc0c1\ubc1b\uc2b5\ub2c8\ub2e4 (800 \ucf54\uc778 \ub300\uc2e0 400 \ucf54\uc778)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg nieuwe planten twee keer zo snel. Jouw succes wordt direct zichtbaar beloond (400 in plaats van 800 munten)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdob\u0105d\u017a nowe ro\u015bliny dwa razy szybciej. Tw\u00f3j sukces jest widocznie nagradzany (400 zamiast 800 monet)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha novas plantas duas vezes mais r\u00e1pido. Seu sucesso \u00e9 recompensado visivelmente (400 em vez de 800 moedas)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u0443\u0447\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0432\u0434\u0432\u043e\u0435 \u0431\u044b\u0441\u0442\u0440\u0435\u0435. \u0412\u0430\u0448 \u0443\u0441\u043f\u0435\u0445 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0432\u0438\u0434\u0438\u043c\u043e \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0451\u043d (400 \u0432\u043c\u0435\u0441\u0442\u043e 800 \u043c\u043e\u043d\u0435\u0442)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bitkileri iki kat daha h\u0131zl\u0131 al. Ba\u015far\u0131n an\u0131nda g\u00f6r\u00fcn\u00fcr \u015fekilde \u00f6d\u00fcllendirilir (800 yerine 400 jeton)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u83b7\u53d6\u65b0\u690d\u7269\u7684\u901f\u5ea6\u5feb\u4e24\u500d\u3002\u60a8\u7684\u6210\u529f\u5c06\u76f4\u63a5\u83b7\u5f97\u53ef\u89c1\u7684\u5956\u52b1\uff08400\u800c\u975e800\u786c\u5e01\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7372\u5f97\u65b0\u690d\u7269\u7684\u901f\u5ea6\u63d0\u9ad8\u4e86\u4e00\u500d\u3002\u60a8\u7684\u6210\u529f\u5c07\u7acb\u5373\u7372\u5f97\u660e\u986f\u7684\u734e\u52f5\uff08400 \u500b\u786c\u5e63\uff0c\u800c\u4e0d\u662f 800 \u500b\u786c\u5e63\uff09\u3002"
          }
        }
      }
    },

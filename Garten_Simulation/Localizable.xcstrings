    "sleep.routine.insight.excellent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Top, bitte weiter so! Deine Schlafroutine ist ausgezeichnet. Im Schnitt gehst du um %@ ins Bett. Um 8 Stunden Schlaf zu bekommen, solltest du um %@ aufstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great job, keep it up! Your sleep routine is excellent. On average, you go to bed at %@. To get 8 hours of sleep, you should wake up at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Buen trabajo, sigue así! Tu rutina de sueño es excelente. En promedio, te acuestas a las %@. Para dormir 8 horas, deberías despertarte a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent, continuez ainsi ! Votre routine de sommeil est parfaite. En moyenne, vous vous couchez à %@. Pour dormir 8 heures, vous devriez vous réveiller à %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया, इसे जारी रखें! आपकी नींद की दिनचर्या उत्कृष्ट है। औसतन आप %@ बजे बिस्तर पर जाते हैं। 8 घंटे की नींद पाने के लिए, आपको %@ बजे उठना चाहिए。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo lavoro, continua così! La tua routine di sonno è eccellente. In media, vai a letto alle %@. Per dormire 8 ore, dovresti svegliarti alle %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素晴らしい、その調子です！あなたの睡眠ルーティンは最高です。平均して %@ に就寝しています。8時間の睡眠をとるには、%@ に起きる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘하고 있어요, 계속 유지하세요! 당신의 수면 루틴은 훌륭합니다. 평균적으로 %@ 에 잠자리에 듭니다. 8시간을 자려면 %@ 에 일어나야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed gedaan, ga zo door! Je slaaproutine is uitstekend. Gemiddeld ga je om %@ naar bed. Om 8 uur slaap te krijgen, moet je om %@ opstaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Super, tak trzymaj! Twoja rutyna snu jest doskonała. Średnio kładziesz się spać o %@. Aby przespać 8 godzin, powinieneś wstać o %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo trabalho, continue assim! Sua rotina de sono é excelente. Em média, você vai para a cama às %@. Para ter 8 horas de sono, você deve acordar às %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo trabalho, continue assim! Sua rotina de sono é excelente. Em média, você vai para a cama às %@. Para ter 8 horas de sono, você deve acordar às %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отличная работа, продолжайте в том же духе! Ваш режим сна идеален. В среднем вы ложитесь в %@. Чтобы спать 8 часов, вам следует просыпаться в %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika, lütfen böyle devam edin! Uyku rutininiz mükemmel. Ortalama olarak saat %@'de yatıyorsunuz. 8 saat uyumak için %@'de kalkmalısınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "干得好，继续保持！你的睡眠惯例非常棒。平均而言，你在 %@ 睡觉。为了睡够8小时，你应该在 %@ 起床。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幹得好，繼續保持！你的睡眠慣例非常棒。平均而言，你在 %@ 睡覺。為了睡夠8小時，你應該在 %@ 起床。"
          }
        }
      }
    },
    "sleep.routine.insight.missing_last_night": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Langzeitschnitt ist berechnet, aber für die letzte Nacht fehlen noch Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your long-term average is calculated, but data for last night is still missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu promedio a largo plazo está calculado, pero aún faltan los datos de anoche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre moyenne à long terme est calculée, mais les données de la nuit dernière sont encore manquantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दीर्घकालिक औसत गणना किया गया है, लेकिन कल रात का डेटा अभी बाकी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua media a lungo termine è calcolata, ma mancano ancora i dati della scorsa notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期平均は計算されていますが、昨夜のデータはまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장기 평균이 계산되었지만, 어젯밤 데이터가 아직 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je langetermijngemiddelde is berekend, maar gegevens van afgelopen nacht ontbreken nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja średnia długoterminowa została obliczona, ale brakuje danych z ostatniej nocy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua média a longo prazo está calculada, mas ainda faltam dados da noite passada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua média a longo prazo foi calculada, mas ainda faltam dados da noite passada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш долгосрочный средний показатель рассчитан, но данных за прошлую ночь еще нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun vadeli ortalamanız hesaplandı, ancak geçen geceye ait veriler henüz eksik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期平均值已计算完毕，但昨晚的数据尚未同步。"
          }
        },
        "zh-Hant": {

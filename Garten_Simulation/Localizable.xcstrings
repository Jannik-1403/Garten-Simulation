    "plant.zitronenbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe hydriert und halte K\u00f6rper und Geist erfrischt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay hydrated and keep your body and mind refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente hidratado y mant\u00e9n tu cuerpo y mente refrescados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez hydrat\u00e9 et gardez votre corps et votre esprit rafra\u00eechis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u093e\u0907\u0921\u094d\u0930\u0947\u091f\u0947\u0921 \u0930\u0939\u0947\u0902 \u0914\u0930 \u0936\u0930\u0940\u0930 \u0914\u0930 \u092e\u0928 \u0915\u094b \u0924\u093e\u091c\u0917\u0940 \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani idratato e mantieni il tuo corpo e la tua mente rinfrescati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c34\u5206\u3092\u88dc\u7d66\u3057\u3001\u5fc3\u8eab\u3092\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u3055\u305b\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc218\ubd84\uc744 \uc720\uc9c0\ud558\uace0 \ubab8\uacfc \ub9c8\uc74c\uc744 \uc0c1\ucf8c\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf gehydrateerd en houd je lichaam en geest verfrist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozosta\u0144 nawodniony i utrzymaj cia\u0142o i umys\u0142 od\u015bwie\u017cone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se hidratado e mantenha seu corpo e mente revigorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0433\u0438\u0434\u0440\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u0438 \u0434\u0435\u0440\u0436\u0438 \u0442\u0435\u043b\u043e \u0438 \u0440\u0430\u0437\u0443\u043c \u0441\u0432\u0435\u0436\u0438\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su i\u00e7in ve bedeninizi ve zihninizi taze tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u6c34\u5206\u5145\u8db3\uff0c\u8ba9\u8eab\u5fc3\u4fdd\u6301\u6e05\u723d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u6c34\u5206\u4e26\u4fdd\u6301\u8eab\u5fc3\u6e05\u723d\u3002"
          }
        }
      }
    },
    "plant.zuckerrohr.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zucker = das Feld bleibt sauber \u2013 Zuckerfrei + Sport"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sugar = the field stays clean \u2013 Sugar-free + Sports"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin az\u00facar = el campo queda limpio \u2013 Sin az\u00facar + deporte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sucre = le champ reste propre \u2013 Sans sucre + Sport"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0936\u0915\u094d\u0915\u0930 \u0928\u0939\u0940\u0902 = \u0916\u0947\u0924 \u0938\u093e\u092b \u0930\u0939\u0924\u093e \u0939\u0948 \u2013 \u092c\u093f\u0928\u093e \u0936\u0915\u094d\u0915\u0930 + \u0648\u0631\u0632\u0634"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "No sugar = the field stays clean \u2013 Sugar-free + Sports"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7802\u7cd6\u4e0d\u4f7f\u7528 = \u30d5\u30a3\u30fc\u30eb\u30c9\u306f\u304d\u308c\u3044\u306a\u307e\u307e \u2013 \u7802\u7cd6\u4e0d\u4f7f\u7528 + \u30b9\u30dd\u30fc\u30c4"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\ud0d5 \uc5c6\uc74c = \ud604\uc7a5\uc774 \uae68\ub057\ud558\uac8c \uc720\uc9c0\ub428 - \ubb34\uc124\ud0d5 + \uc2a4\ud3ec\uce20"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen suiker = het veld blijft schoon \u2013 Suikervrij + Sporten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez cukru = pole pozostaje czyste \u2013 Bez cukru + Sport"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem a\u00e7\u00facar = o campo fica limpo \u2013 Sem a\u00e7\u00facar + Desporto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430 = \u043f\u043e\u043b\u0435 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0447\u0438\u0441\u0442\u044b\u043c \u2013 \u0431\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430 + \u0441\u043f\u043e\u0440\u0442"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eekersiz = Tarla temiz kal\u0131r \u2013 \u015eekersiz + Spor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u7cd6 = \u573a\u5730\u4fdd\u6301\u6e05\u6d01 \u2013 \u65e0\u7cd6 + \u8fd0\u52a8"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u7cd6 = \u5834\u5730\u4fdd\u6301\u6e05\u6f54 \u2013 \u7121\u7cd6 + \u904b\u52d5"
          }
        }
      }
    },

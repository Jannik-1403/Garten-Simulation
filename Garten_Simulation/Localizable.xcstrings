    "assessment.growth.profile.fakeWorker.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schwachpunkt ist die Effizienz. Du beschäftigst dich mit Details statt den echten Hebeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weak point is efficiency. You're dealing with details instead of the real levers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su punto débil es la eficiencia. Estás lidiando con detalles en lugar de palancas reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre point faible est l'efficacité. Vous traitez des détails plutôt que des véritables leviers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo punto debole è l’efficienza. Hai a che fare con i dettagli invece che con le vere leve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの弱点は効率性です。実際のレバーではなく、詳細を扱っているのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 약점은 효율성이다. 실제 레버 대신 세부 사항을 다루고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zwakke punt is efficiëntie. Je hebt te maken met details in plaats van met de echte hefbomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoim słabym punktem jest wydajność. Masz do czynienia ze szczegółami, a nie z prawdziwymi dźwigniami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ponto fraco é a eficiência. Você está lidando com detalhes em vez de alavancas reais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zayıf noktanız verimliliktir. Gerçek kaldıraçlar yerine ayrıntılarla uğraşıyorsunuz."
          }
        }
      }
    },

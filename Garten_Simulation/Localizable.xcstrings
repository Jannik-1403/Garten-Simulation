    "settings.display.mode.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle, ob der Name der Pflanze/Schlechte Gewohnheit oder die verkn\u00fcpfte Gewohnheit im Garten angezeigt werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether to display the plant/item name or the linked habit in the garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres ver el nombre de la planta o el h\u00e1bito vinculado en el jard\u00edn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis si le nom de la plante ou l'habitude li\u00e9e doit \u00eatre affich\u00e9 dans le jardin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0941\u0928\u0947\u0902 \u0915\u093f \u092a\u094c\u0927\u0947/\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u093e \u0928\u093e\u092e \u092f\u093e \u092c\u0917\u0940\u091a\u0947 \u092e\u0947\u0902 \u091c\u0941\u0921\u093c\u0940 \u0939\u0941\u0908 \u0906\u0926\u0924 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether to display the plant name or the linked habit in the garden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5ead\u5185\u306e\u690d\u7269\u306e\u540d\u524d\u307e\u305f\u306f\u30ea\u30f3\u30af\u3055\u308c\u305f\u7fd2\u6027\u3092\u8868\u793a\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u9078\u629e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc5d0 \uc2dd\ubb3c \uc774\ub984\uc744 \ud45c\uc2dc\ud560\uc9c0, \uc5f0\uacb0\ub41c \uc2b5\uad00\uc744 \ud45c\uc2dc\ud560\uc9c0 \uc120\ud0dd\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of u de plantnaam of de daaraan gekoppelde gewoonte in de tuin wilt weergeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy chcesz wy\u015bwietla\u0107 nazw\u0119 ro\u015bliny, czy powi\u0105zany zwyczaj w ogrodzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe se o nome da planta ou o h\u00e1bito associado deve ser exibido no jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435, \u0434\u043e\u043b\u0436\u043d\u043e \u043b\u0438 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f/\u043f\u043b\u043e\u0445\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438\u043b\u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u044f \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 \u0432 \u0441\u0430\u0434\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7ede bitki ad\u0131n\u0131n m\u0131 yoksa ba\u011flant\u0131l\u0131 al\u0131\u015fkanl\u0131\u011f\u0131n m\u0131 g\u00f6r\u00fcnt\u00fclenece\u011fini se\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u662f\u5426\u663e\u793a\u690d\u7269\u540d\u79f0/\u574f\u4e60\u60ef\u6216\u82b1\u56ed\u4e2d\u7684\u76f8\u5173\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u662f\u5426\u986f\u793a\u690d\u7269\u540d\u7a31/\u58de\u7fd2\u6163\u6216\u82b1\u5712\u4e2d\u7684\u76f8\u95dc\u7fd2\u6163\u3002"
          }
        }
      }
    },

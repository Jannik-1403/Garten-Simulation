    "focus.session.completed.proud": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst %lld Minuten lang extrem fokussiert. Deine Pflanze ist stolz auf dich!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were extremely focused for %lld minutes. Your plant is proud of you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste extremadamente concentrado durante %lld minutos. ¡Tu planta está orgullosa de ti!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as été extrêmement concentré pendant %lld minutes. Ta plante est fière de toi !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप%lld मिनट तक अत्यधिक केंद्रित थे। आपके पौधे को आप पर गर्व है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato estremamente concentrato per %lld minuti. La tua pianta è orgogliosa di te!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは%lld分間非常に集中しました。あなたの植物はあなたを誇りに思っています！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분 동안 매우 집중했습니다. 당신의 식물이 당신을 자랑스러워합니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was %lld minuten lang extreem gefocust. Je plant is trots op je!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byłeś niezwykle skupiony przez %lld minut. Twoja roślina jest z ciebie dumna!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você esteve extremamente focado por %lld minutos. Sua planta está orgulhosa de você!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você esteve extremamente focado por %lld minutos. Sua planta está orgulhosa de você!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты был очень сосредоточен в течение %lld минут. Твое растение гордится тобой!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakika boyunca son derece odaklanmıştınız. Bitkiniz sizinle gurur duyuyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你专注了 %lld 分钟。你的植物为你感到骄傲！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在%lld 分鐘內非常專注。你的工廠為你感到驕傲！"
          }
        }
      }
    },
    "focus.session.completed.xp_shared": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst %lld Minuten lang extrem fokussiert. Die XP werden auf alle deine Pflanzen aufgeteilt!"
          }
        },
        "en": {
          "stringUnit": {

    "stats.balance.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie ausgewogen ist dein Leben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How balanced is your life?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQu\u00e9 tan equilibrada est\u00e1 tu vida?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est l'\u00e9quilibre de votre vie ?"

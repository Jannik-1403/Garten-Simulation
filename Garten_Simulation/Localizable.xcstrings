    "assessment.growth.profile.traeumer.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt handeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Act\u00fae ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agissez maintenant"
          }
        },
        "hi": {
          "stringUnit": {

    "trash.nacht_snack_box.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlie\u00dfe die K\u00fcche ab 21 Uhr \u2013 stelle ein Schild an den K\u00fchlschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the kitchen at 9pm \u2013 put a sign on the fridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la cocina a las 21:00: pon un cartel en el frigor\u00edfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme la cuisine \u00e0 21h \u2013 mets une pancarte sur le r\u00e9frig\u00e9rateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093e\u0924 9 \u092c\u091c\u0947 \u0938\u0947 \u0930\u0938\u094b\u0908 \u092c\u0902\u0926 \u0915\u0930 \u0926\u094b \u2013 \u092b\u094d\u0930\u093f\u091c \u092a\u0930 \u090f\u0915 \u0928\u094b\u091f \u0932\u0917\u093e \u0926\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la cucina alle 21 \u2013 metti un cartello sul frigorifero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "21\u6642\u306b\u30ad\u30c3\u30c1\u30f3\u3092\u9589\u3081\u307e\u3057\u3087\u3046\u3002\u51b7\u8535\u5eab\u306b\u30b5\u30a4\u30f3\u3092\u8cbc\u3063\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc24 9\uc2dc\uc5d0 \uc8fc\ubc29\uc744 \ub2eb\uc73c\uc138\uc694 \u2013 \ub0c9\uc7a5\uace0\uc5d0 \ud45c\uc2dc\ub97c \ubd99\uc5ec\ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de keuken om 21 uur \u2013 hang een bordje aan de koelkast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij kuchni\u0119 o 21 \u2013 powie\u015b tabliczk\u0119 na lod\u00f3wce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche a cozinha \u00e0s 21h \u2013 coloque uma placa na geladeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043a\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u043a\u0443\u0445\u043d\u044e \u043f\u043e\u0441\u043b\u0435 9 \u0432\u0435\u0447\u0435\u0440\u0430. - \u043f\u043e\u0432\u0435\u0441\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0447\u043a\u0443 \u043d\u0430 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutfa\u011f\u0131 21:00'de kapat \u2013 buzdolab\u0131na bir i\u015faret koy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a 9 \u70b9\u540e\u5173\u95ed\u53a8\u623f- \u5728\u51b0\u7bb1\u4e0a\u8d34\u4e0a\u6807\u5fd7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a 9 \u9ede\u5f8c\u95dc\u9589\u5eda\u623f- \u5728\u51b0\u7bb1\u4e0a\u8cbc\u4e0a\u6a19\u8a8c\u3002"
          }
        }
      }
    },
    "trash.nacht_snack_box.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends snacken = schlechter Schlaf + mehr Hunger am n\u00e4chsten Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacking at night = poor sleep + more hunger the next day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Picar por la noche = sue\u00f1o malo + m\u00e1s hambre al d\u00eda siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grignoter le soir = mauvais sommeil + plus de faim le lendemain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0915\u094b \u0938\u094d\u0928\u0948\u0915 \u0915\u0930\u0928\u093e = \u0916\u0930\u093e\u092c \u0928\u0940\u0902\u0926 + \u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u0905\u0927\u093f\u0915 \u092d\u0942\u0916\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuntini serali = sonno scarso + pi\u00f9 fame il giorno dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u591c\u306e\u30b9\u30ca\u30c3\u30af\u306f\u7761\u7720\u4e0d\u826f\u3068\u7fcc\u65e5\u306e\u7a7a\u8179\u611f\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc24\uc5d0 \uac04\uc2dd\uc744 \uba39\uc73c\uba74 \uc218\uba74\uc774 \ub098\ube60\uc9c0\uace0 \ub2e4\uc74c \ub0a0 \ub354 \ubc30\uac00 \uace0\ud30c\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacken 's avonds = slechte slaap + meer honger de volgende dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczorne przek\u0105ski = s\u0142aby sen + wi\u0119cej g\u0142odu nast\u0119pnego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanchar \u00e0 noite = sono ruim + mais fome no dia seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u0443\u0441 \u0432\u0435\u0447\u0435\u0440\u043e\u043c = \u043f\u043b\u043e\u0445\u043e\u0439 \u0441\u043e\u043d + \u0435\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0439 \u0433\u043e\u043b\u043e\u0434 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece at\u0131\u015ft\u0131rmak = k\u00f6t\u00fc uyku + ertesi g\u00fcn daha fazla a\u00e7l\u0131k."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u5403\u96f6\u98df=\u7761\u7720\u4e0d\u4f73+\u7b2c\u4e8c\u5929\u66f4\u9965\u997f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u5403\u96f6\u98df=\u7761\u4e0d\u597d+\u9694\u5929\u66f4\u98e2\u9913\u3002"
          }
        }
      }
    },
    "trash.nacht_snack_box.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereite abends einen Kr\u00e4utertee vor \u2013 das gibt Besch\u00e4ftigung ohne Kalorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare herbal tea in the evening \u2013 it gives you something to do without calories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara una infusi\u00f3n de hierbas por la noche: algo que hacer sin calor\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9pare une tisane le soir \u2013 \u00e7a t'occupe sans calories."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0915\u094b \u090f\u0915 \u0939\u0930\u094d\u092c\u0932 \u091a\u093e\u092f \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902 \u2013 \u092f\u0939 \u092c\u093f\u0928\u093e \u0915\u0948\u0932\u094b\u0930\u0940 \u0915\u0947 \u0935\u094d\u092f\u0938\u094d\u0924\u0924\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara una tisana di sera \u2013 ti d\u00e0 qualcosa da fare senza calorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5915\u65b9\u306b\u30cf\u30fc\u30d6\u30c6\u30a3\u30fc\u3092\u6e96\u5099\u3057\u307e\u3057\u3087\u3046\u3002\u30ab\u30ed\u30ea\u30fc\u3092\u53d6\u3089\u305a\u306b\u4f55\u304b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub141\uc5d0 \ud5c8\ube0c \ucc28\ub97c \uc900\ube44\ud558\uc138\uc694 \u2013 \uce7c\ub85c\ub9ac \uc5c6\uc774 \ubb34\uc5b8\uac00\ub97c \ud560 \uc218 \uc788\uac8c \ud574\uc90d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet 's avonds een kruideninfusie klaar \u2013 dat geeft bezigheid zonder calorie\u00ebn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj wieczorem herbat\u0119 zio\u0142ow\u0105 \u2013 to daje zaj\u0119cie bez kalorii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare ch\u00e1 de ervas \u00e0 noite \u2013 algo para fazer sem calorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u0442\u0440\u0430\u0432\u044f\u043d\u043e\u0439 \u0447\u0430\u0439 \u2013 \u043e\u043d \u0437\u0430\u0439\u043c\u0451\u0442 \u0432\u0430\u0441 \u0431\u0435\u0437 \u043a\u0430\u043b\u043e\u0440\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u015fam bitki \u00e7ay\u0131 haz\u0131rla \u2013 kalori almadan bir \u015feyler yapman\u0131 sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u51c6\u5907\u4e00\u676f\u82b1\u8349\u8336\u2014\u2014\u5b83\u80fd\u8ba9\u4f60\u4fdd\u6301\u5fd9\u788c\u4e14\u4e0d\u542b\u5361\u8def\u91cc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u6e96\u5099\u4e00\u676f\u82b1\u8349\u8336\u2014\u2014\u5b83\u80fd\u8b93\u4f60\u4fdd\u6301\u5fd9\u788c\u4e14\u4e0d\u542b\u5361\u8def\u91cc\u3002"
          }
        }
      }
    },
    "trash.nacht_snack_box.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fchre eine Woche lang Buch \u00fcber Abend-Snacks \u2013 die Gesamtkalorien \u00fcberraschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep track of evening snacks for a week \u2013 the total calories will surprise you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva un registro de los aperitivos nocturnos durante una semana: el total de calor\u00edas te sorprender\u00e1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note tes collations du soir pendant une semaine \u2013 le total des calories te surprendra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093e\u0924 \u0915\u0947 \u0938\u094d\u0928\u0948\u0915\u094d\u0938 \u0915\u093e \u090f\u0915 \u0938\u092a\u094d\u0924\u093e\u0939 \u0924\u0915 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0930\u0916\u0947\u0902 \u2013 \u0915\u0941\u0932 \u0915\u0948\u0932\u094b\u0930\u0940 \u0906\u092a\u0915\u094b \u091a\u0915\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia degli spuntini serali per una settimana \u2013 le calorie totali ti sorprenderanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u9031\u9593\u591c\u306e\u30b9\u30ca\u30c3\u30af\u3092\u8a18\u9332\u3057\u307e\u3057\u3087\u3046\u3002\u5408\u8a08\u30ab\u30ed\u30ea\u30fc\u306b\u9a5a\u304f\u306f\u305a\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc8fc\uc77c \ub3d9\uc548 \uc800\ub141 \uac04\uc2dd\uc744 \uae30\ub85d\ud558\uc138\uc694 \u2013 \ucd1d \uce7c\ub85c\ub9ac\uac00 \ub180\ub77c\uc6b8 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een week lang bij wat je 's avonds snackt \u2013 het totaal aan calorie\u00ebn zal je verbazen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez tydzie\u0144 zapisuj wieczorne przek\u0105ski \u2013 \u0142\u0105czna liczba kalorii ci\u0119 zaskoczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre os lanches noturnos por uma semana \u2013 o total de calorias vai te surpreender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0434\u0438\u0442\u0435 \u0443\u0447\u0435\u0442 \u0432\u0435\u0447\u0435\u0440\u043d\u0438\u0445 \u043f\u0435\u0440\u0435\u043a\u0443\u0441\u043e\u0432 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0435\u0434\u0435\u043b\u0438 \u2013 \u043e\u0431\u0449\u0430\u044f \u043a\u0430\u043b\u043e\u0440\u0438\u0439\u043d\u043e\u0441\u0442\u044c \u0432\u0430\u0441 \u0443\u0434\u0438\u0432\u0438\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hafta boyunca ak\u015fam at\u0131\u015ft\u0131rmal\u0131klar\u0131n\u0131 kaydet \u2013 toplam kalori seni \u015fa\u015f\u0131rtacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bb0\u5f55\u4e00\u5468\u7684\u665a\u95f4\u96f6\u98df\u2014\u2014\u603b\u70ed\u91cf\u4f1a\u8ba9\u4f60\u5927\u5403\u4e00\u60ca\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a18\u9304\u4e00\u9031\u7684\u665a\u9593\u96f6\u98df\uff0d\u7e3d\u71b1\u91cf\u6703\u8b93\u4f60\u5927\u5403\u4e00\u9a5a\u3002"
          }
        }
      }
    },
    "trash.nacht_snack_box.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (N\u00e4chtliches Snacken)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Intervallfasten)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e (\u0930\u093e\u0924 \u092e\u0947\u0902 \u0938\u094d\u0928\u0948\u0915\u094d\u0938 \u0915\u0930\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u094d\u0930\u092d\u093e\u0935\u094b\u0902 \u0938\u0947 \u0905\u0935\u0917\u0924 \u0939\u094b\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0902 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u092e\u093e\u0927\u093e\u0928\u0915\u093e\u0930\u0940 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0907\u0902\u091f\u0930\u0935\u0932 \u092b\u093e\u0938\u094d\u091f\u093f\u0902\u0917)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0938\u0930\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0418\u0437\u0431\u0430\u0432\u044c\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0440\u0435\u0434\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u043f\u0435\u0440\u0435\u043a\u0443\u0441\u044b\u0432\u0430\u0442\u044c \u043f\u043e \u043d\u043e\u0447\u0430\u043c)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438: \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u044b \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445. \n3. \u0423\u0441\u043b\u043e\u0436\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0443: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043e\u0442 \u0441\u0435\u0442\u0438). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0435\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e. \n\n**\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0433\u043e\u043b\u043e\u0434\u0430\u043d\u0438\u0435)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c: \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u044d\u0442\u043e \u0441 \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \n3. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e: \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c: \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0441\u0435\u0431\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (N\u00e4chtliches Snacken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Intervallfasten)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u574f\u4e60\u60ef\uff08\u591c\u95f4\u5403\u96f6\u98df\uff09**\n1. \u9690\u5f62\uff1a\u5c06\u89e6\u53d1\u56e0\u7d20\u79fb\u51fa\u89c6\u91ce\u3002\n2. \u8ba9\u81ea\u5df1\u53d8\u5f97\u6ca1\u6709\u5438\u5f15\u529b\uff1a\u610f\u8bc6\u5230\u8d1f\u9762\u540e\u679c\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u56f0\u96be\uff1a\u8bbe\u7f6e\u969c\u788d\uff08\u4f8b\u5982\u5220\u9664\u5e94\u7528\u7a0b\u5e8f\u3001\u62d4\u6389\u63d2\u5934\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6ee1\u610f\uff1a\u9644\u52a0\u5211\u7f5a\u6267\u884c\u3002\n\n**\u5efa\u7acb\u826f\u597d\u7684\u4e60\u60ef\uff08\u95f4\u6b47\u6027\u7981\u98df\uff09**\n1. \u4f7f\u5176\u663e\u800c\u6613\u89c1\uff1a\u5c06\u89e6\u53d1\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u89c1\u7684\u4f4d\u7f6e\u3002\n2. \u8ba9\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c06\u5b83\u4e0e\u4f60\u559c\u6b22\u7684\u4e1c\u897f\u8054\u7cfb\u8d77\u6765\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u7b80\u5355\uff1a\u5c06\u969c\u788d\u51cf\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u949f\uff09\u3002\n4. \u8ba9\u5b83\u4ee4\u4eba\u6ee1\u610f\uff1a\u4e8b\u540e\u7acb\u5373\u5956\u52b1\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u58de\u7fd2\u6163\uff08\u591c\u9593\u5403\u96f6\u98df\uff09**\n1. \u96b1\u5f62\uff1a\u5c07\u89f8\u767c\u56e0\u7d20\u79fb\u51fa\u8996\u91ce\u3002\n2. \u8b93\u81ea\u5df1\u8b8a\u5f97\u6c92\u6709\u5438\u5f15\u529b\uff1a\u610f\u8b58\u5230\u8ca0\u9762\u5f8c\u679c\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u56f0\u96e3\uff1a\u8a2d\u5b9a\u969c\u7919\uff08\u4f8b\u5982\u522a\u9664\u61c9\u7528\u7a0b\u5f0f\u3001\u62d4\u6389\u63d2\u982d\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6eff\u610f\uff1a\u9644\u52a0\u5211\u7f70\u57f7\u884c\u3002\n\n**\u5efa\u7acb\u826f\u597d\u7684\u7fd2\u6163\uff08\u9593\u6b47\u6027\u65b7\u98df\uff09**\n1. \u4f7f\u5176\u986f\u800c\u6613\u898b\uff1a\u5c07\u89f8\u767c\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u898b\u7684\u4f4d\u7f6e\u3002\n2. \u8b93\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c07\u5b83\u8207\u4f60\u559c\u6b61\u7684\u6771\u897f\u9023\u7d50\u8d77\u4f86\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u7c21\u55ae\uff1a\u5c07\u969c\u7919\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u9418\uff09\u3002\n4. \u8b93\u5b83\u4ee4\u4eba\u6eff\u610f\uff1a\u4e8b\u5f8c\u7acb\u5373\u734e\u52f5\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.negativitaets_feed.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sch\u00fctze deine mentale Gesundheit und meide toxische Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your mental health and avoid toxic content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege tu salud mental y evita el contenido t\u00f3xico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prot\u00e8ge ta sant\u00e9 mentale et \u00e9vite les contenus toxiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u092e\u093e\u0928\u0938\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 \u0914\u0930 \u0935\u093f\u0937\u0948\u0932\u0947 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0947 \u0926\u0942\u0930 \u0930\u0939\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi la tua salute mentale ed evita i contenuti tossici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cbe\u795e\u7684\u5065\u5eb7\u3092\u5b88\u308a\u3001\u6709\u5bb3\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc2e0 \uac74\uac15\uc744 \ubcf4\ud638\ud558\uace0 \uc720\ud574\ud55c \ucf58\ud150\uce20\ub97c \ud53c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm je mentale gezondheid en vermijd giftige inhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chro\u0144 swoje zdrowie psychiczne i unikaj toksycznych tre\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja a sua sa\u00fade mental e evite conte\u00fado t\u00f3xico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0449\u0438\u0442\u0438\u0442\u0435 \u0441\u0432\u043e\u0435 \u043f\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0438 \u0438\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruh sa\u011fl\u0131\u011f\u0131n\u0131z\u0131 koruyun ve zehirli i\u00e7eriklerden uzak durun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u62a4\u60a8\u7684\u5fc3\u7406\u5065\u5eb7\u5e76\u907f\u514d\u6709\u6bd2\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u8b77\u60a8\u7684\u5fc3\u7406\u5065\u5eb7\u4e26\u907f\u514d\u6709\u6bd2\u5167\u5bb9\u3002"
          }
        }
      }
    },
    "trash.negativitaets_feed.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Negativer News Feed) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Negativer News Feed) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Negativer News Feed) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Negativer News Feed) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u0928\u094d\u092f\u0942\u091c\u093c \u092b\u0940\u0921) \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Negativer News Feed) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Negativer News Feed) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {

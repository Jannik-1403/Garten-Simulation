    "trash.schlaf_killer_koffein.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Koffein nach 14 Uhr \u2013 stelle einen festen Alarm als Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No caffeine after 2pm \u2013 set a fixed alarm as a reminder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cafe\u00edna despu\u00e9s de las 14:00: establece una alarma fija como recordatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de caf\u00e9ine apr\u00e8s 14h \u2013 mets une alarme fixe comme rappel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u092a\u0939\u0930 2 \u092c\u091c\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0915\u094b\u0908 \u0915\u0948\u092b\u0940\u0928 \u0928\u0939\u0940\u0902 \u2013 \u0938\u094d\u092e\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente caffeina dopo le 14 \u2013 imposta un allarme fisso come promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5348\u5f8c2\u6642\u4ee5\u964d\u306f\u30ab\u30d5\u30a7\u30a4\u30f3\u3092\u53d6\u3089\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u56fa\u5b9a\u30a2\u30e9\u30fc\u30e0\u3092\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u3068\u3057\u3066\u8a2d\u5b9a\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ud6c4 2\uc2dc \uc774\ud6c4\uc5d0\ub294 \uce74\ud398\uc778\uc744 \uc12d\ucde8\ud558\uc9c0 \ub9c8\uc138\uc694 \u2013 \uace0\uc815 \uc54c\ub78c\uc744 \ub9ac\ub9c8\uc778\ub354\ub85c \uc124\uc815\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen cafe\u00efne na 14 uur \u2013 stel een vast alarm in als herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017badnej kofeiny po 14 \u2013 ustaw sta\u0142y alarm jako przypomnienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cafe\u00edna ap\u00f3s as 14h \u2013 defina um alarme fixo como lembrete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u043a\u043e\u0444\u0435\u0438\u043d\u0430 \u043f\u043e\u0441\u043b\u0435 14:00 \u2013 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0436\u0435\u0441\u0442\u043a\u0438\u0439 \u0431\u0443\u0434\u0438\u043b\u044c\u043d\u0438\u043a \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14:00'den sonra kafein yok \u2013 hat\u0131rlat\u0131c\u0131 olarak sabit bir alarm kur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u5348 2 \u70b9\u540e\u7981\u6b62\u6444\u5165\u5496\u5561\u56e0\u2014\u2014\u8bbe\u7f6e\u786c\u95f9\u949f\u4f5c\u4e3a\u63d0\u9192\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u5348 2 \u9ede\u5f8c\u7981\u6b62\u651d\u53d6\u5496\u5561\u56e0\u2014\u2014\u8a2d\u5b9a\u786c\u9b27\u9418\u4f5c\u70ba\u63d0\u9192\u3002"
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koffein hat eine Halbwertszeit von 6 Stunden \u2013 Kaffee um 16 Uhr = schlechter Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine has a half-life of 6 hours \u2013 coffee at 4pm = poor sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cafe\u00edna tiene una vida media de 6 horas: caf\u00e9 a las 16:00 = sue\u00f1o deficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caf\u00e9ine a une demi-vie de 6 heures \u2013 caf\u00e9 \u00e0 16h = mauvais sommeil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0948\u092b\u0940\u0928 \u0915\u093e \u0905\u0930\u094d\u0927\u091c\u0940\u0935\u0928 6 \u0918\u0902\u091f\u0947 \u0939\u0948 \u2013 \u0936\u093e\u092e 4 \u092c\u091c\u0947 \u0915\u0949\u092b\u0940 = \u0916\u0930\u093e\u092c \u0928\u0940\u0902\u0926\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La caffeina ha una emivita di 6 ore \u2013 caff\u00e8 alle 16 = sonno scarso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ab\u30d5\u30a7\u30a4\u30f3\u306e\u534a\u6e1b\u671f\u306f6\u6642\u9593\u3067\u3059\u3002\u5348\u5f8c4\u6642\u306e\u30b3\u30fc\u30d2\u30fc\uff1d\u7761\u7720\u306e\u8cea\u306e\u4f4e\u4e0b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce74\ud398\uc778\uc758 \ubc18\uac10\uae30\ub294 6\uc2dc\uac04\uc785\ub2c8\ub2e4 \u2013 \uc624\ud6c4 4\uc2dc \ucee4\ud53c = \ub098\uc05c \uc218\uba74."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafe\u00efne heeft een halfwaardetijd van 6 uur \u2013 koffie om 16 uur = slechte slaap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kofeina ma okres p\u00f3\u0142trwania 6 godzin \u2013 kawa o 16 = z\u0142y sen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cafe\u00edna tem meia-vida de 6 horas \u2013 caf\u00e9 \u00e0s 16h = sono ruim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0438\u043e\u0434 \u043f\u043e\u043b\u0443\u0440\u0430\u0441\u043f\u0430\u0434\u0430 \u043a\u043e\u0444\u0435\u0438\u043d\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 6 \u0447\u0430\u0441\u043e\u0432 \u2013 \u043a\u043e\u0444\u0435 \u0432 16:00 = \u043f\u043b\u043e\u0445\u043e\u0439 \u0441\u043e\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafeinin yar\u0131 \u00f6mr\u00fc 6 saattir \u2013 saat 16'da kahve = k\u00f6t\u00fc uyku."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5496\u5561\u56e0\u7684\u534a\u8870\u671f\u4e3a 6 \u5c0f\u65f6 - \u4e0b\u5348 4 \u70b9\u559d\u5496\u5561 = \u7761\u7720\u4e0d\u597d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5496\u5561\u56e0\u7684\u534a\u8870\u671f\u70ba 6 \u5c0f\u6642 - \u4e0b\u5348 4 \u9ede\u559d\u5496\u5561 = \u7761\u4e0d\u597d\u3002"
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze den Nachmittags-Kaffee durch einen kurzen Spaziergang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the afternoon coffee with a short walk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el caf\u00e9 de la tarde por un breve paseo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le caf\u00e9 de l'apr\u00e8s-midi par une courte promenade."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u092a\u0939\u0930 \u0915\u0940 \u0915\u0949\u092b\u0940 \u0915\u094b \u090f\u0915 \u091b\u094b\u091f\u0947 \u0938\u0947 \u091f\u0939\u0932\u0928\u0947 \u0938\u0947 \u092c\u0926\u0932 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci il caff\u00e8 pomeridiano con una breve passeggiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5348\u5f8c\u306e\u30b3\u30fc\u30d2\u30fc\u3092\u77ed\u3044\u6563\u6b69\u306b\u7f6e\u304d\u63db\u3048\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ud6c4 \ucee4\ud53c\ub97c \uc9e7\uc740 \uc0b0\ucc45\uc73c\ub85c \ub300\uccb4\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de middagkoffie door een korte wandeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zast\u0105p popo\u0142udniow\u0105 kaw\u0119 kr\u00f3tkim spacerem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua o caf\u00e9 da tarde por uma curta caminhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043c\u0435\u043d\u0438\u0442\u0435 \u043f\u043e\u0441\u043b\u0435\u043e\u0431\u0435\u0434\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u0444\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6\u011fleden sonra kahvesini k\u0131sa bir y\u00fcr\u00fcy\u00fc\u015fle de\u011fi\u015ftir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u77ed\u6682\u7684\u6b65\u884c\u6765\u4ee3\u66ff\u4e0b\u5348\u7684\u5496\u5561\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u77ed\u66ab\u7684\u6b65\u884c\u4f86\u4ee3\u66ff\u4e0b\u5348\u7684\u5496\u5561\u3002"
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere deine Schlafqualit\u00e4t nach koffeinfreien Tagen vs. koffeinhaltigen Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note your sleep quality after caffeine-free days vs. caffeine days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu calidad de sue\u00f1o despu\u00e9s de d\u00edas sin cafe\u00edna frente a d\u00edas con cafe\u00edna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note ta qualit\u00e9 de sommeil apr\u00e8s les jours sans caf\u00e9ine par rapport aux jours avec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0948\u092b\u0940\u0928 \u092e\u0941\u0915\u094d\u0924 \u0926\u093f\u0928 \u092c\u0928\u093e\u092e \u0915\u0948\u092b\u0940\u0928 \u092f\u0941\u0915\u094d\u0924 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926 \u0905\u092a\u0928\u0940 \u0928\u0940\u0902\u0926 \u0915\u0940 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0928\u094b\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota la qualit\u00e0 del tuo sonno dopo giorni senza caffeina vs. giorni con caffeina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ab\u30d5\u30a7\u30a4\u30f3\u306a\u3057\u306e\u65e5\u3068\u30ab\u30d5\u30a7\u30a4\u30f3\u3042\u308a\u306e\u65e5\u306e\u7761\u7720\u306e\u8cea\u3092\u8a18\u9332\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce74\ud398\uc778 \uc5c6\ub294 \ub0a0\uacfc \uce74\ud398\uc778 \uc788\ub294 \ub0a0\uc758 \uc218\uba74 \uc9c8\uc744 \uae30\ub85d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer je slaapkwaliteit na cafe\u00efnevrije dagen versus cafe\u00efnehoudende dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj jako\u015b\u0107 swojego snu po dniach bez kofeiny w por\u00f3wnaniu do dni z kofein\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre a qualidade do sono ap\u00f3s dias sem cafe\u00edna vs. dias com cafe\u00edna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0441\u043d\u0430 \u043f\u043e\u0441\u043b\u0435 \u0434\u043d\u0435\u0439 \u0431\u0435\u0437 \u043a\u043e\u0444\u0435\u0438\u043d\u0430 \u0438 \u0434\u043d\u0435\u0439 \u0441 \u043a\u043e\u0444\u0435\u0438\u043d\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafeinsiz g\u00fcnlerin ard\u0131ndan uyku kalitenizi kafeinsiz g\u00fcnlerle kar\u015f\u0131la\u015ft\u0131rarak kaydedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bb0\u5f55\u4e0d\u542b\u5496\u5561\u56e0\u7684\u65e5\u5b50\u4e0e\u542b\u5496\u5561\u56e0\u7684\u65e5\u5b50\u540e\u7684\u7761\u7720\u8d28\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a18\u9304\u4e0d\u542b\u5496\u5561\u56e0\u7684\u65e5\u5b50\u8207\u542b\u5496\u5561\u56e0\u7684\u65e5\u5b50\u5f8c\u7684\u7761\u7720\u54c1\u8cea\u3002"
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Zu viel Koffein)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Schlafroutine)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Koffein)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Schlafroutine)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Koffein)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Schlafroutine)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Koffein)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Schlafroutine)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u0915\u0948\u092b\u0940\u0928)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0928\u0940\u0902\u0926 \u0915\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0932\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Koffein)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Schlafroutine)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Koffein)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Schlafroutine)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Koffein)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Schlafroutine)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."

    "calorie_decrease_suggested": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf deinem Trend der letzten %1$@ Wochen empfehlen wir, deine täglichen Kalorien um etwa %2$@ kcal zu senken, um dein Ziel bis %3$@ zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your trend over the last %1$@ weeks, we recommend lowering your daily calories by about %2$@ kcal to stay on track for your goal by %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según tu tendencia de las últimas %1$@ semanas, te recomendamos reducir tus calorías diarias en unas %2$@ kcal para alcanzar tu objetivo antes del %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'après ta tendance des %1$@ dernières semaines, nous te recommandons de réduire tes calories quotidiennes d'environ %2$@ kcal pour atteindre ton objectif d'ici le %3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले %1$@ हफ्तों के आपके ट्रेंड के आधार पर, हम सुझाव देते हैं कि %3$@ तक अपने लक्ष्य तक पहुँचने के लिए अपनी दैनिक कैलोरी लगभग %2$@ kcal कम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base alla tua tendenza delle ultime %1$@ settimane, ti consigliamo di ridurre le calorie giornaliere di circa %2$@ kcal per raggiungere il tuo obiettivo entro il %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去%1$@週間のトレンドに基づき、%3$@までに目標を達成するために、1日の摂取カロリーを約%2$@kcal減らすことをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 %1$@주간의 추세를 기준으로, %3$@까지 목표를 달성하려면 하루 섭취 칼로리를 약 %2$@kcal 줄이는 것을 권장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van je trend van de afgelopen %1$@ weken raden we aan je dagelijkse calorieën met ongeveer %2$@ kcal te verlagen om je doel voor %3$@ te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie Twojego trendu z ostatnich %1$@ tygodni zalecamy zmniejszenie dziennej liczby kalorii o około %2$@ kcal, aby osiągnąć cel do %3$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base na sua tendência das últimas %1$@ semanas, recomendamos reduzir suas calorias diárias em cerca de %2$@ kcal para atingir sua meta até %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base na sua tendência das últimas %1$@ semanas, recomendamos reduzir suas calorias diárias em cerca de %2$@ kcal para atingir sua meta até %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На основе вашего тренда за последние %1$@ нед. рекомендуем снизить дневную калорийность примерно на %2$@ ккал, чтобы достичь цели к %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %1$@ haftalık eğilimine göre, %3$@ tarihine kadar hedefine ulaşmak için günlük kalorini yaklaşık %2$@ kcal azaltmanı öneririz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你过去 %1$@ 周的趋势,建议将每日热量减少约 %2$@ 千卡,以便在 %3$@ 前达成目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你過去 %1$@ 週的趨勢,建議將每日熱量減少約 %2$@ 大卡,以便在 %3$@ 前達成目標。"
          }
        }
      }
    },

    "trend_stable_weekly_noise": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert dieser Woche ist eine normale Schwankung (Wasser, Nahrung, Hormone). Dein zugrunde liegender Trend liegt weiterhin bei %1$@ %2$@/Woche – keine Anpassung nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week's number looks like normal day-to-day fluctuation (water, food, hormones). Your underlying trend is still %1$@ %2$@/week — no change needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de esta semana parece una fluctuación normal (agua, comida, hormonas). Tu tendencia real sigue siendo de %1$@ %2$@/semana — no hace falta ningún cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre de cette semaine ressemble à une fluctuation normale (eau, alimentation, hormones). Ta tendance de fond reste à %1$@ %2$@/semaine — aucun changement nécessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सप्ताह की संख्या सामान्य उतार-चढ़ाव (पानी, भोजन, हार्मोन) जैसी लगती है। आपका असली ट्रेंड अभी भी %1$@ %2$@/सप्ताह है — किसी बदलाव की ज़रूरत नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore di questa settimana sembra una normale oscillazione (acqua, cibo, ormoni). La tua tendenza di fondo resta %1$@ %2$@/settimana — nessuna modifica necessaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の数値は通常の変動(水分、食事、ホルモンなど)によるものと考えられます。実際のトレンドは引き続き%1$@ %2$@/週です — 変更の必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 수치는 정상적인 변동(수분, 식사, 호르몬 등)으로 보입니다. 실제 추세는 여전히 주당 %1$@ %2$@이며, 조정이 필요하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het cijfer van deze week lijkt op een normale schommeling (vocht, voeding, hormonen). Je onderliggende trend blijft %1$@ %2$@/week — geen aanpassing nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik z tego tygodnia wygląda na normalne wahanie (woda, jedzenie, hormony). Twój rzeczywisty trend to nadal %1$@ %2$@/tydzień — żadna zmiana nie jest potrzebna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O número desta semana parece uma flutuação normal (água, alimentação, hormônios). Sua tendência real continua em %1$@ %2$@/semana — nenhuma mudança é necessária."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número desta semana parece uma flutuação normal (água, alimentação, hormônios). Sua tendência real continua em %1$@ %2$@/semana — nenhuma mudança é necessária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатель этой недели похож на обычное колебание (вода, питание, гормоны). Ваш реальный тренд по-прежнему %1$@ %2$@/нед. — изменений не требуется."

    "plant.thymian.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein, unscheinbar, aber immer da – Konsequenz & Routine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small, inconspicuous, but always there – Consistency & Routine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeño, discreto, pero siempre presente – Constancia y Rutina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit, discret, mais toujours présent – Constance & Routine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Small, inconspicuous, but always there – Consistency & Routine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さくて目立たないが、常にそこにある - 一貫性と日常性"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작고 눈에 띄지 않지만 항상 존재합니다 – 일관성 및 루틴"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein, onopvallend, maar altijd aanwezig – Consistentie & Routine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały, niepozorny, ale zawsze obecny – Konsekwencja i rutyna"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno, discreto, mas sempre presente – Consistência & Rotina"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük, göze çarpmayan ama her zaman orada – Tutarlılık ve Rutin"
          }
        }
      }
    },

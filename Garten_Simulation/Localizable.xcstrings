          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u044b"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Standartlar\u0131 belirlemek"
          }
        },
        "zh-Hans": {

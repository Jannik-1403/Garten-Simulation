            "value" : "मैंने नौकरी छोड़ दी लेकिन जो समय और पैसा मैंने खोया उसके लिए महीनों तक पछताता रहा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho smesso, ma per mesi sono sprofondato nel rimorso per il tempo e i soldi che ho perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は辞めましたが、失った時間とお金に対して何ヶ月も後悔に沈みました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그만두었지만 몇 달 동안 잃어버린 시간과 돈에 대한 후회에 빠져들었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik stopte ermee, maar kreeg maandenlang spijt van de tijd en het geld dat ik verloren had."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rzuciłem palenie, ale przez wiele miesięcy pogrążałem się w żalu z powodu straconego czasu i pieniędzy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desisti, mas me arrependi por meses do tempo e do dinheiro que perdi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я прекращаю, но несколько месяцев погружаюсь в сожаление о потерянном времени и деньгах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bıraktım ama kaybettiğim zaman ve paradan dolayı aylarca pişmanlık duydum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我停止了，但却长时间沉浸在对失去的时间和金钱的懊悔中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我放棄了，但幾個月來我對失去的時間和金錢感到後悔。"
          }
        }
      }
    },
    "assessment.mental.q14.c" : {

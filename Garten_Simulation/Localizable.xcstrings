    "prog_teeth_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiziere dein Zahnfleisch im Spiegel. Sieht es rosa und gesund aus oder gibt es rötliche, blutende Stellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect your gums in the mirror. Does it look pink and healthy or are there reddish, bleeding spots?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecciona tus encías en el espejo. ¿Se ve rosado y saludable o tiene manchas rojizas y sangrantes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspectez vos gencives dans le miroir. Est-ce qu'il a l'air rose et sain ou y a-t-il des taches rougeâtres et saignantes ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्पण में अपने मसूड़ों का निरीक्षण करें। क्या यह गुलाबी और स्वस्थ दिखता है या इसमें लाल, खून बहने वाले धब्बे हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina le gengive allo specchio. Sembra rosa e sano o ci sono macchie rossastre e sanguinanti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡で歯茎をチェックしてください。ピンク色で健康的に見えますか、それとも赤みがかった出血斑がありますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거울로 잇몸을 살펴보세요. 분홍색이고 건강해 보입니까, 아니면 붉고 출혈이 있는 반점이 있습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecteer uw tandvlees in de spiegel. Ziet het er roze en gezond uit of zijn er roodachtige, bloedende plekken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź swoje dziąsła w lustrze. Czy wygląda na różowy i zdrowy, czy też są na nim czerwonawe, krwawiące plamy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione suas gengivas no espelho. Parece rosado e saudável ou há manchas avermelhadas e sangrantes?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione suas gengivas no espelho. Parece rosado e saudável ou há manchas avermelhadas e sangrantes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осмотрите свои десны в зеркале. Выглядит ли он розовым и здоровым или есть красноватые кровоточащие пятна?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynada diş etlerinizi inceleyin. Pembe ve sağlıklı mı görünüyor yoksa kırmızımsı, kanayan lekeler var mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对着镜子检查你的牙龈。它看起来是粉红色的、健康的还是有微红的出血点？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對著鏡子檢查你的牙齦。它看起來是粉紅色的、健康的還是有微紅的出血點？"
          }
        }
      }
    },

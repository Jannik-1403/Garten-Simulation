    "prog_cleaning_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine saubere Küche ist das Herzstück. Gehe niemals mit dreckigem Geschirr in der Spüle ins Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean kitchen is the heart of it. Never go to bed with dirty dishes in the sink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cocina limpia es el corazón de esto. Nunca te acuestes con los platos sucios en el fregadero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une cuisine propre en est le cœur. Ne vous couchez jamais avec de la vaisselle sale dans l'évier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्वच्छ रसोईघर इसका हृदय है। सिंक में गंदे बर्तन रखकर कभी भी न सोएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cucina pulita è il cuore di tutto. Non andare mai a letto con i piatti sporchi nel lavandino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "清潔なキッチンがその中心です。シンクに汚れた食器を入れたまま就寝しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗한 주방이 그 핵심입니다. 싱크대에 더러운 접시를 넣은 채로 잠자리에 들지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schone keuken is daarbij het hart. Ga nooit naar bed met de vuile vaat in de gootsteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysta kuchnia to jej serce. Nigdy nie kładź się spać z brudnymi naczyniami w zlewie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cozinha limpa é o cerne disso. Nunca vá para a cama com a louça suja na pia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cozinha limpa é o cerne disso. Nunca vá para a cama com a louça suja na pia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистая кухня – это главное. Никогда не ложитесь спать с грязной посудой в раковине."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temiz bir mutfak bunun kalbidir. Asla lavaboda kirli bulaşıklarla yatmayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "干净的厨房是它的核心。切勿将水槽里的脏盘子放在床上睡觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "乾淨的廚房是它的核心。切勿將水槽裡的髒盤子放在床上睡覺。"
          }
        }
      }
    },

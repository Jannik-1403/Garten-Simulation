    "prog_meditation_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wünsche dir selbst, einem geliebten Menschen und jemandem, den du schwer erträgst, still 'Mögest du glücklich sein'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silently wish 'May you be happy' to yourself, a loved one and someone you find difficult to bear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deséate en silencio \"Que seas feliz\" a ti mismo, a un ser querido y a alguien que te resulte difícil de soportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez silencieusement « Puissiez-vous être heureux » à vous-même, à un être cher et à quelqu'un que vous avez du mal à supporter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुपचाप अपने लिए, किसी प्रियजन के लिए और किसी ऐसे व्यक्ति के लिए 'आप खुश रहें' की कामना करें जिसे सहन करना आपके लिए कठिन हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Augura silenziosamente \"Che tu possa essere felice\" a te stesso, a una persona cara e a qualcuno che trovi difficile da sopportare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身、愛する人、そして耐えがたい人に「あなたが幸せになりますように」と静かに願います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신에게, 사랑하는 사람에게, 견디기 힘든 사람에게 '행복하시길'을 조용히 기원해보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wens in stilte 'Moge je gelukkig zijn' voor jezelf, een dierbare en iemand die je moeilijk kunt verdragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po cichu złóż życzenie „Obyś był szczęśliwy” sobie, ukochanej osobie i osobie, którą trudno znieść."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseje silenciosamente 'Que você seja feliz' para si mesmo, para um ente querido e para alguém que você acha difícil de suportar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseje silenciosamente 'Que você seja feliz' para si mesmo, para um ente querido e para alguém que você acha difícil de suportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихо пожелайте «Будь ты счастлив» себе, близкому человеку и тому, кого вам трудно вынести."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinize, sevdiğinize, katlanmakta zorlandığınız birine sessizce 'Mutlu olmanızı dilerim' dileyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默默地祝福自己、所爱的人和你难以忍受的人“祝你幸福”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "默默地祝福自己、所愛的人和你難以忍受的人「祝你幸福」。"
          }
        }
      }
    },

    "iap_error_purchase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf fehlgeschlagen. Bitte erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase failed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra fall\u00f3. Por favor, int\u00e9ntalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat \u00e9chou\u00e9. Veuillez r\u00e9essayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0935\u093f\u092b\u0932. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto fallito. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cfc\u5165\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002\u3082\u3046\u4e00\u5ea6\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad6c\ub9e4\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankoop mislukt. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup nie powi\u00f3d\u0142 si\u0119. Spr\u00f3buj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra falhada. Por favor tenta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0443\u043f\u043a\u0430 \u043d\u0435 \u0443\u0434\u0430\u043b\u0430\u0441\u044c. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u043d\u043e\u0432\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat\u0131n alma ba\u015far\u0131s\u0131z oldu. L\u00fctfen tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d2d\u4e70\u5931\u8d25\u3002\u8bf7\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cfc\u8cb7\u5931\u6557\u3002\u8acb\u518d\u8a66\u4e00\u6b21\u3002"
          }
        }
      }
    },

    "screenTime.permanent.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apps & Kategorien sind unabhängig vom Zeitplan immer gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These apps & categories are always blocked regardless of the schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas aplicaciones y categorías siempre están bloqueadas independientemente del horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces applications et catégories sont toujours bloquées quel que soit le programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल की परवाह किए बिना ये ऐप्स और श्रेणियां हमेशा लॉक रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste app e categorie sono sempre bloccate indipendentemente dal programma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリとカテゴリは、スケジュールに関係なく常にブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 앱과 카테고리는 일정에 관계없이 항상 차단됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze apps en categorieën zijn altijd geblokkeerd, ongeacht het schema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te aplikacje i kategorie są zawsze blokowane bez względu na harmonogram."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses aplicativos e categorias estão sempre bloqueados, independentemente da programação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses aplicativos e categorias estão sempre bloqueados, independentemente da programação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти приложения и категории всегда заблокированы независимо от расписания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamalar ve kategoriler programdan bağımsız olarak her zaman engellenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论时间表如何，这些应用程序和类别始终处于锁定状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論時間表如何，這些應用程式和類別始終處於鎖定狀態。"
          }
        }
      }
    },

    "paywall.feature.coin_bonus.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiene bei jedem Gie\u00dfen und Erledigen von Aufgaben 25\uff05 mehr M\u00fcnzen, um deinen Garten schneller wachsen zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn 25\uff05 more coins with every watering and completed task to grow your garden faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana un 25\uff05 m\u00e1s de monedas con cada riego y tarea completada para hacer crecer tu jard\u00edn m\u00e1s r\u00e1pido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne 25\uff05 de pi\u00e8ces en plus \u00e0 chaque arrosage et t\u00e2che compl\u00e9t\u00e9e pour faire grandir ton jardin plus vite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u094b \u0924\u0947\u091c\u0940 \u0938\u0947 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0930 \u092c\u093e\u0930 \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u0947 \u0914\u0930 \u0915\u093e\u0930\u094d\u092f \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u092a\u0930 25\uff05 \u0905\u0927\u093f\u0915 \u0938\u093f\u0915\u094d\u0915\u0947 \u0905\u0930\u094d\u091c\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagna il 25\uff05 in pi\u00f9 di monete con ogni annaffiatura e attivit\u00e0 completata per far crescere il tuo giardino pi\u00f9 velocemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5ead\u3092\u3088\u308a\u901f\u304f\u80b2\u3066\u308b\u305f\u3081\u306b\u3001\u6c34\u3084\u308a\u3084\u30bf\u30b9\u30af\u5b8c\u4e86\u306e\u305f\u3073\u306b25\uff05\u591a\u304f\u306e\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc744 \ub354 \ube68\ub9ac \ud0a4\uc6b0\uae30 \uc704\ud574 \ubb3c\uc744 \uc904 \ub54c\ub098 \uc791\uc5c5\uc744 \uc644\ub8cc\ud560 \ub54c\ub9c8\ub2e4 25\uff05 \ub354 \ub9ce\uc740 \ucf54\uc778\uc744 \ud68d\ub4dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien 25\uff05 meer munten bij elke waterbeurt en voltooide taak om je tuin sneller te laten groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarabiaj o 25\uff05 wi\u0119cej monet za ka\u017cde podlewanie i wykonane zadanie, aby szybciej rozwija\u0107 sw\u00f3j ogr\u00f3d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhe 25\uff05 mais moedas a cada rega e tarefa conclu\u00edda para cultivar seu jardim mais r\u00e1pido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u0430 25\uff05 \u0431\u043e\u043b\u044c\u0448\u0435 \u043c\u043e\u043d\u0435\u0442 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u043e\u043b\u0438\u0432 \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0439, \u0447\u0442\u043e\u0431\u044b \u0432\u0430\u0448 \u0441\u0430\u0434 \u0440\u043e\u0441 \u0431\u044b\u0441\u0442\u0440\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7enizi daha h\u0131zl\u0131 b\u00fcy\u00fctmek i\u00e7in her sulamada ve tamamlanan g\u00f6revde \uff0525 daha fazla jeton kazan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u6d47\u6c34\u548c\u5b8c\u6210\u4efb\u52a1\u65f6\uff0c\u53ef\u989d\u5916\u83b7\u5f9725\uff05\u7684\u786c\u5e01\uff0c\u8ba9\u60a8\u7684\u82b1\u56ed\u66f4\u5feb\u6210\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u6f86\u6c34\u4e26\u5b8c\u6210\u4efb\u52d9\u6642\uff0c\u60a8\u53ef\u4ee5\u591a\u8cfa\u53d6 25\uff05 \u7684\u91d1\u5e63\uff0c\u8b93\u60a8\u7684\u82b1\u5712\u751f\u9577\u5f97\u66f4\u5feb\u3002"
          }
        }
      }
    },

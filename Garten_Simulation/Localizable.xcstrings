    "trash.junk_mail_abo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere alle nicht dringenden Benachrichtigungen auf deinem Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable all non-urgent notifications on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva todas las notificaciones no urgentes en tu tel\u00e9fono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9sactive toutes les notifications non urgentes sur ton t\u00e9l\u00e9phone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0938\u092d\u0940 \u0917\u0948\u0930-\u091c\u093c\u0930\u0942\u0930\u0940 \u0938\u0942\u091a\u0928\u093e\u0913\u0902 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabilita tutte le notifiche non urgenti sul tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u643a\u5e2f\u96fb\u8a71\u306e\u7dca\u6025\u3067\u306a\u3044\u901a\u77e5\u3092\u3059\u3079\u3066\u30aa\u30d5\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud734\ub300\ud3f0\uc758 \uae34\uae09\ud558\uc9c0 \uc54a\uc740 \uc54c\ub9bc\uc744 \ubaa8\ub450 \ub044\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel alle niet-urgente meldingen op je telefoon uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142\u0105cz wszystkie niepilne powiadomienia w telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative todas as notifica\u00e7\u00f5es n\u00e3o urgentes no seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0432\u0441\u0435 \u043d\u0435\u0441\u0440\u043e\u0447\u043d\u044b\u0435 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonundaki t\u00fcm acil olmayan bildirimleri devre d\u0131\u015f\u0131 b\u0131rak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5173\u95ed\u624b\u673a\u4e0a\u6240\u6709\u975e\u7d27\u6025\u901a\u77e5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95dc\u9589\u624b\u6a5f\u4e0a\u6240\u6709\u975e\u7dca\u6025\u901a\u77e5\u3002"
          }
        }
      }
    },
    "trash.junk_mail_abo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Minute am Bildschirm ist eine Minute weniger echtes Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every minute on screen is one less minute of real life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada minuto frente a la pantalla es un minuto menos de vida real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque minute \u00e0 l'\u00e9cran est une minute de moins de vraie vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0939\u0930 \u092e\u093f\u0928\u091f \u0905\u0938\u0932\u0940 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u090f\u0915 \u092e\u093f\u0928\u091f \u0915\u092e \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni minuto sullo schermo \u00e8 un minuto in meno di vita reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u753b\u9762\u306e\u524d\u306e1\u5206\u306f\u3001\u73fe\u5b9f\u306e\u751f\u6d3b\u306e1\u5206\u304c\u5931\u308f\u308c\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud654\uba74 \uc55e\uc758 1\ubd84\uc740 \uc2e4\uc81c \uc0dd\ud65c\uc758 1\ubd84\uc774 \uc904\uc5b4\ub4dc\ub294 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke minuut op het scherm is een minuut minder echt leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cda minuta przed ekranem to minuta mniej prawdziwego \u017cycia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada minuto na tela \u00e9 um minuto a menos de vida real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u0430\u044f \u043c\u0438\u043d\u0443\u0442\u0430 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 \u2014 \u044d\u0442\u043e \u043d\u0430 \u043c\u0438\u043d\u0443\u0442\u0443 \u043c\u0435\u043d\u044c\u0448\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran ba\u015f\u0131ndaki her dakika, ger\u00e7ek hayattan bir dakika daha azd\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c4f\u5e55\u4e0a\u7684\u6bcf\u4e00\u5206\u949f\u90fd\u6bd4\u73b0\u5b9e\u751f\u6d3b\u5c11\u4e00\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u87a2\u5e55\u4e0a\u7684\u6bcf\u4e00\u5206\u9418\u90fd\u6bd4\u73fe\u5be6\u751f\u6d3b\u5c11\u4e00\u5206\u9418\u3002"
          }
        }
      }
    },
    "trash.junk_mail_abo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine App, die deine Bildschirmzeit begrenzt (z.B. Screentime)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an app that limits your screen time (e.g. Screen Time)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una app que limite tu tiempo de pantalla (p. ej., Tiempo de Pantalla)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une application qui limite ton temps d'\u00e9cran (p. ex. Temps d'\u00e9cran)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u092e\u092f \u0915\u094b \u0938\u0940\u092e\u093f\u0924 \u0915\u0930\u0947 (\u091c\u0948\u0938\u0947 Screentime)\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un'app che limita il tuo tempo schermo (es. Tempo di utilizzo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30af\u30ea\u30fc\u30f3\u30bf\u30a4\u30e0\u3092\u5236\u9650\u3059\u308b\u30a2\u30d7\u30ea\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\uff08\u4f8b\uff1a\u30b9\u30af\u30ea\u30fc\u30f3\u30bf\u30a4\u30e0\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud06c\ub9b0 \ud0c0\uc784\uc744 \uc81c\ud55c\ud558\ub294 \uc571\uc744 \uc0ac\uc6a9\ud558\uc138\uc694(\uc608: \uc2a4\ud06c\ub9b0 \ud0c0\uc784)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een app die je schermtijd beperkt (bijv. Schermtijd)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj aplikacji ograniczaj\u0105cej czas przed ekranem (np. Czas przed ekranem)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um app que limite seu tempo de tela (ex: Tempo de Uso)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0435 \u044d\u043a\u0440\u0430\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, Screentime)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran s\u00fcrenizi s\u0131n\u0131rlayan bir uygulama kullan\u0131n (\u00f6rn. Ekran S\u00fcresi)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u9650\u5236\u5c4f\u5e55\u65f6\u95f4\u7684\u5e94\u7528\u7a0b\u5e8f\uff08\u4f8b\u5982 Screentime\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u9650\u5236\u87a2\u5e55\u6642\u9593\u7684\u61c9\u7528\u7a0b\u5f0f\uff08\u4f8b\u5982 Screentime\uff09\u3002"
          }
        }
      }
    },
    "trash.junk_mail_abo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaue jeden Abend die Bildschirmzeit-Statistik an \u2013 und setze neue Rekorde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the screen time statistics every evening \u2013 and set new records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba cada noche las estad\u00edsticas del tiempo de pantalla y bate nuevos r\u00e9cords."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte les statistiques de temps d'\u00e9cran chaque soir \u2013 et \u00e9tablis de nouveaux records."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0930\u093e\u0924 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u092e\u092f \u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940 \u0926\u0947\u0916\u0947\u0902 \u2013 \u0914\u0930 \u0928\u090f \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092c\u0928\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le statistiche del tempo schermo ogni sera \u2013 e stabilisci nuovi record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u6669\u30b9\u30af\u30ea\u30fc\u30f3\u30bf\u30a4\u30e0\u306e\u7d71\u8a08\u3092\u78ba\u8a8d\u3057\u3066\u3001\u65b0\u8a18\u9332\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \uc800\ub141 \uc2a4\ud06c\ub9b0 \ud0c0\uc784 \ud1b5\uacc4\ub97c \ud655\uc778\ud558\uace0 \uc0c8 \uae30\ub85d\uc744 \uc138\uc6b0\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk elke avond de statistieken van de schermtijd \u2013 en stel nieuwe records."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzaj co wiecz\u00f3r statystyki czasu przed ekranem \u2013 i ustanawiaj nowe rekordy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as estat\u00edsticas de tempo de tela toda noite \u2013 e estabele\u00e7a novos recordes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u044d\u043a\u0440\u0430\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0432\u0435\u0447\u0435\u0440 \u2014 \u0438 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u0440\u0435\u043a\u043e\u0440\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ak\u015fam ekran s\u00fcresi istatistiklerine bak \u2013 ve yeni rekorlar k\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u665a\u4e0a\u67e5\u770b\u5c4f\u5e55\u65f6\u95f4\u7edf\u8ba1\u6570\u636e - \u5e76\u521b\u9020\u65b0\u8bb0\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u665a\u4e0a\u67e5\u770b\u87a2\u5e55\u6642\u9593\u7d71\u8a08\u8cc7\u6599 - \u4e26\u5275\u9020\u65b0\u8a18\u9304\u3002"
          }
        }
      }
    },
    "trash.junk_mail_abo.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Spam & Ablenkung)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Digital Detox)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u092c\u0941\u0930\u0940 \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u0938\u094d\u092a\u0948\u092e \u0914\u0930 \u0927\u094d\u092f\u093e\u0928 \u092d\u091f\u0915\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0926\u0902\u0921 \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0921\u093f\u091c\u093f\u091f\u0932 \u0921\u093f\u091f\u0949\u0915\u094d\u0938)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0930\u0916\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0418\u0437\u0431\u0430\u0432\u044c\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0440\u0435\u0434\u043d\u044b\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a (\u0441\u043f\u0430\u043c\u0430 \u0438 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u044e\u0449\u0438\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u043e\u0432)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438: \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u044b \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445. \n3. \u0423\u0441\u043b\u043e\u0436\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0443: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043e\u0442 \u0441\u0435\u0442\u0438). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0435\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e. \n\n**\u041f\u0440\u0438\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u0426\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0434\u0435\u0442\u043e\u043a\u0441)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c: \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u044d\u0442\u043e \u0441 \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \n3. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e: \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c: \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0441\u0435\u0431\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Spam & Ablenkung)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Digital Detox)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u574f\u4e60\u60ef\uff08\u5783\u573e\u90ae\u4ef6\u548c\u5e72\u6270\uff09**\n1. \u9690\u5f62\uff1a\u5c06\u89e6\u53d1\u56e0\u7d20\u79fb\u51fa\u89c6\u91ce\u3002\n2. \u8ba9\u81ea\u5df1\u53d8\u5f97\u6ca1\u6709\u5438\u5f15\u529b\uff1a\u610f\u8bc6\u5230\u8d1f\u9762\u540e\u679c\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u56f0\u96be\uff1a\u8bbe\u7f6e\u969c\u788d\uff08\u4f8b\u5982\u5220\u9664\u5e94\u7528\u7a0b\u5e8f\u3001\u62d4\u6389\u63d2\u5934\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6ee1\u610f\uff1a\u9644\u52a0\u5211\u7f5a\u6267\u884c\u3002\n\n**\u5efa\u7acb\u826f\u597d\u4e60\u60ef\uff08\u6570\u5b57\u6392\u6bd2\uff09**\n1. \u4f7f\u5176\u663e\u800c\u6613\u89c1\uff1a\u5c06\u89e6\u53d1\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u89c1\u7684\u4f4d\u7f6e\u3002\n2. \u8ba9\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c06\u5b83\u4e0e\u4f60\u559c\u6b22\u7684\u4e1c\u897f\u8054\u7cfb\u8d77\u6765\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u7b80\u5355\uff1a\u5c06\u969c\u788d\u51cf\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u949f\uff09\u3002\n4. \u8ba9\u5b83\u4ee4\u4eba\u6ee1\u610f\uff1a\u4e8b\u540e\u7acb\u5373\u5956\u52b1\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u58de\u7fd2\u6163\uff08\u5783\u573e\u90f5\u4ef6\u548c\u4e7e\u64fe\uff09**\n1. \u96b1\u5f62\uff1a\u5c07\u89f8\u767c\u56e0\u7d20\u79fb\u51fa\u8996\u91ce\u3002\n2. \u8b93\u81ea\u5df1\u8b8a\u5f97\u6c92\u6709\u5438\u5f15\u529b\uff1a\u610f\u8b58\u5230\u8ca0\u9762\u5f8c\u679c\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u56f0\u96e3\uff1a\u8a2d\u5b9a\u969c\u7919\uff08\u4f8b\u5982\u522a\u9664\u61c9\u7528\u7a0b\u5f0f\u3001\u62d4\u6389\u63d2\u982d\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6eff\u610f\uff1a\u9644\u52a0\u5211\u7f70\u57f7\u884c\u3002\n\n**\u5efa\u7acb\u826f\u597d\u7684\u7fd2\u6163\uff08\u6578\u4f4d\u6392\u6bd2\uff09**\n1. \u4f7f\u5176\u986f\u800c\u6613\u898b\uff1a\u5c07\u89f8\u767c\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u898b\u7684\u4f4d\u7f6e\u3002\n2. \u8b93\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c07\u5b83\u8207\u4f60\u559c\u6b61\u7684\u6771\u897f\u9023\u7d50\u8d77\u4f86\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u7c21\u55ae\uff1a\u5c07\u969c\u7919\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u9418\uff09\u3002\n4. \u8b93\u5b83\u4ee4\u4eba\u6eff\u610f\uff1a\u4e8b\u5f8c\u7acb\u5373\u734e\u52f5\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare dein Geld anstatt es f\u00fcr Mikrotransaktionen und Gl\u00fccksspiel auszugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your money instead of spending it on microtransactions and gambling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra tu dinero en lugar de gastarlo en microtransacciones y apuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9conomise ton argent au lieu de le d\u00e9penser en microtransactions et jeux d'argent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092a\u0948\u0938\u0947 \u092c\u091a\u093e\u0913 \u092c\u091c\u093e\u092f \u0907\u0938\u0915\u0947 \u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u091f\u094d\u0930\u093e\u0902\u091c\u0947\u0915\u094d\u0936\u0928\u094d\u0938 \u0914\u0930 \u091c\u0941\u0906 \u092e\u0947\u0902 \u0916\u0930\u094d\u091a \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmia i tuoi soldi invece di spenderli in microtransazioni e gioco d'azzardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c11\u984d\u306e\u53d6\u5f15\u3084\u30ae\u30e3\u30f3\u30d6\u30eb\u306b\u304a\u91d1\u3092\u4f7f\u3046\u4ee3\u308f\u308a\u306b\u3001\u304a\u91d1\u3092\u7bc0\u7d04\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc18c\uc561 \uacb0\uc81c\uc640 \ub3c4\ubc15\uc5d0 \ub3c8\uc744 \uc4f0\ub294 \ub300\uc2e0 \uc800\ucd95\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bespaar je geld in plaats van het uit te geven aan microtransacties en gokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszcz\u0119dzaj pieni\u0105dze, zamiast wydawa\u0107 je na mikrotransakcje i hazard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Economize seu dinheiro em vez de gast\u00e1-lo em microtransa\u00e7\u00f5es e jogos de azar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u043a\u043e\u043d\u043e\u043c\u044c\u0442\u0435 \u0441\u0432\u043e\u0438 \u0434\u0435\u043d\u044c\u0433\u0438 \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0438\u0445 \u043d\u0430 \u043c\u0438\u043a\u0440\u043e\u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 \u0438 \u0430\u0437\u0430\u0440\u0442\u043d\u044b\u0435 \u0438\u0433\u0440\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paran\u0131z\u0131 mikro d\u00f6n\u00fc\u015f\u00fcmlere ve kumara harcamak yerine biriktirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8282\u7701\u4f60\u7684\u94b1\uff0c\u800c\u4e0d\u662f\u628a\u94b1\u82b1\u5728\u5fae\u4ea4\u6613\u548c\u8d4c\u535a\u4e0a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7bc0\u7701\u4f60\u7684\u9322\uff0c\u800c\u4e0d\u662f\u628a\u9322\u82b1\u5728\u5fae\u4ea4\u6613\u548c\u8ced\u535a\u4e0a\u3002"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Gl\u00fccksspiel/Lootboxen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gl\u00fccksspiel/Lootboxen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gl\u00fccksspiel/Lootboxen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gl\u00fccksspiel/Lootboxen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u091c\u0941\u0906/\u0932\u0942\u091f\u092c\u0949\u0915\u094d\u0938) \u0906\u092a\u0915\u094b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gl\u00fccksspiel/Lootboxen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gl\u00fccksspiel/Lootboxen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Gl\u00fccksspiel/Lootboxen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {

    "prog_wakeup_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke sofort ein Glas Wasser und strecke dich für 2 Minuten. Aktiviere den Kreislauf, bevor das Gehirn Ausreden findet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immediately drink a glass of water and stretch for 2 minutes. Activate the circuit before the brain makes excuses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe inmediatamente un vaso de agua y estira durante 2 minutos. Activa el circuito antes de que el cerebro ponga excusas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez immédiatement un verre d'eau et étirez-vous pendant 2 minutes. Activez le circuit avant que le cerveau ne trouve des excuses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत एक गिलास पानी पिएं और 2 मिनट तक स्ट्रेच करें। इससे पहले कि मस्तिष्क कोई बहाना बनाये, सर्किट सक्रिय करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bere immediatamente un bicchiere d'acqua e fare stretching per 2 minuti. Attiva il circuito prima che il cervello trovi delle scuse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにコップ一杯の水を飲み、2分間ストレッチしてください。脳が言い訳をする前に回路を活性化させましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 물 한 컵을 마시고 2분간 스트레칭을 해주세요. 뇌가 변명하기 전에 회로를 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink onmiddellijk een glas water en stretch gedurende 2 minuten. Activeer het circuit voordat de hersenen excuses verzinnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast wypij szklankę wody i rozciągaj przez 2 minuty. Aktywuj obwód, zanim mózg zacznie szukać wymówek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba imediatamente um copo de água e estique por 2 minutos. Ative o circuito antes que o cérebro dê desculpas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba imediatamente um copo de água e estique por 2 minutos. Ative o circuito antes que o cérebro dê desculpas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу выпейте стакан воды и потянитесь в течение 2 минут. Активируйте эту схему, прежде чем мозг начнет оправдываться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen bir bardak su içip 2 dakika esneme yapın. Beyin bahaneler üretmeden devreyi etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即喝一杯水并伸展2分钟。在大脑找借口之前激活电路。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即喝一杯水並伸展2分鐘。在大腦找藉口之前先啟動電路。"
          }
        }
      }
    },

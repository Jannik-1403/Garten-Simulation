    "tour_plant_path_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deinen Weg! Bleib 90 Tage am Ball, um diese Pflanze vollst\u00e4ndig zu meistern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your path! Keep it up for 90 days to fully master this plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Sigue tu camino! Mant\u00e9nlo durante 90 d\u00edas para dominar por completo esta planta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre chemin ! Continuez pendant 90 jours pour ma\u00eetriser compl\u00e8tement cette plante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u0930\u093e\u0938\u094d\u0924\u093e \u0916\u094b\u091c\u094b! \u0907\u0938 \u092a\u094c\u0927\u0947 \u092e\u0947\u0902 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u092e\u0939\u093e\u0930\u0924 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 90 \u0926\u093f\u0928 \u0932\u0917\u093e\u0924\u093e\u0930 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia il tuo percorso! Continua per 90 giorni per padroneggiare completamente questa pianta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u9053\u7b4b\u3092\u305f\u3069\u3063\u3066\u304f\u3060\u3055\u3044\uff01\u3053\u306e\u690d\u7269\u3092\u5b8c\u5168\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b90\u65e5\u9593\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uae38\uc744 \ucd94\uc801\ud558\uc138\uc694! \uc774 \uc2dd\ubb3c\uc744 \uc644\uc804\ud788 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 90\uc77c \ub3d9\uc548 \uacc4\uc18d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je pad! Houd dit 90 dagen vol om deze plant volledig onder de knie te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015aled\u017a swoj\u0105 \u015bcie\u017ck\u0119! Utrzymaj to przez 90 dni, aby w pe\u0142ni opanowa\u0107 t\u0119 ro\u015blin\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe seu caminho! Continue por 90 dias para dominar totalmente esta planta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u0435\u0434\u0443\u0439 \u0441\u0432\u043e\u0438\u043c \u043f\u0443\u0442\u0435\u043c! \u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u043c\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 90 \u0434\u043d\u0435\u0439, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0441\u0432\u043e\u0438\u0442\u044c \u044d\u0442\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolunuzu takip edin! Bu bitkide tamamen ustala\u015fmak i\u00e7in 90 g\u00fcn boyunca devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9075\u5faa\u4f60\u7684\u9053\u8def\uff01\u8bf7\u7ee7\u7eed\u5173\u6ce8 90 \u5929\uff0c\u4ee5\u5b8c\u5168\u638c\u63e1\u8fd9\u79cd\u690d\u7269\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9075\u5faa\u4f60\u7684\u9053\u8def\uff01\u8acb\u7e7c\u7e8c\u95dc\u6ce8 90 \u5929\uff0c\u4ee5\u5b8c\u5168\u638c\u63e1\u9019\u7a2e\u690d\u7269\u3002"
          }
        }
      }
    },

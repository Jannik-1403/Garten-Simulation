    },
    "plant.mandelbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Investition zahlt sich erst später aus – Sparen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Investment pays off later – Saving"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inversión rinde después – Ahorro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'investissement paie plus tard – Épargne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निवेश का लाभ बाद में ही मिलता है – बचत"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'investimento ripaga solo in seguito: risparmiando"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投資は後で報われます – 節約"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투자는 나중에 성과를 냅니다 – 절약"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Investeren loont later – Besparen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inwestycja zwraca się później – Oszczędność"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O investimento compensa mais tarde – Poupar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O investimento compensa mais tarde – Poupar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инвестиции окупаются только позже – экономия"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatırım sonradan karşılığını verir – Tasarruf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投资回报需时日 – 储蓄"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投資事後才會得到回報——儲蓄"
          }
        }
      }
    },

          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non importa. Semplicemente non lo faccio più, comunque non si nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関係ない。もうやらないだけで目立たないです。"

    "trash.junk_mail_abo.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrümple dein digitales Leben und reduziere Ablenkungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declutter your digital life and reduce distractions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena tu vida digital y reduce las distracciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désencombre ta vie numérique et réduis les distractions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina la tua vita digitale e riduci le distrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デジタル生活を整理して、気を散らすものを減らしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디지털 삶을 정리하고 주의가 산만해지는 요소를 줄이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim je digitale leven op en verminder afleidingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporządkuj swoje cyfrowe życie i zredukuj rozpraszacze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize a sua vida digital e reduza as distrações."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijital hayatınızı düzene sokun ve dikkat dağıtıcı unsurları azaltın."
          }
        }
      }
    },
    "trash.junk_mail_abo.impact": {

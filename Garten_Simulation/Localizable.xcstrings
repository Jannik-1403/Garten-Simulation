    "target.reached.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Tagesziel erreicht und deine Pflanze wurde gegossen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached your daily goal and your plant was watered!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Alcanzaste tu objetivo diario y tu planta fue regada!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint votre objectif quotidien et votre plante a \u00e9t\u00e9 arros\u00e9e !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u093e \u0926\u0948\u0928\u093f\u0915 \u0932\u0915\u094d\u0937\u094d\u092f \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u093e \u092a\u094c\u0927\u093e \u0938\u0940\u0902\u091a\u093e \u0917\u092f\u093e \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il tuo obiettivo giornaliero e la tua pianta \u00e8 stata annaffiata!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u65e5\u306e\u76ee\u6a19\u3092\u9054\u6210\u3057\u3001\u690d\u7269\u306b\u6c34\u304c\u3084\u3089\u308c\u307e\u3057\u305f\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc77c \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uc5ec \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc5c8\uc2b5\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je dagelijkse doel bereikt en je plant is water gegeven!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osi\u0105gn\u0105\u0142e\u015b sw\u00f3j dzienny cel, a twoja ro\u015blina zosta\u0142a podlana!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea atingiu sua meta di\u00e1ria e sua planta foi regada!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0434\u043e\u0441\u0442\u0438\u0433 \u0441\u0432\u043e\u0435\u0439 \u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0446\u0435\u043b\u0438, \u0438 \u0442\u0432\u043e\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u043b\u0438\u0442\u043e!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck hedefine ula\u015ft\u0131n ve bitkin suland\u0131!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5df2\u8fbe\u5230\u6bcf\u65e5\u76ee\u6807\uff0c\u5e76\u4e14\u60a8\u7684\u690d\u7269\u5df2\u6d47\u6c34\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5df2\u9054\u5230\u6bcf\u65e5\u76ee\u6a19\uff0c\u4e26\u4e14\u60a8\u7684\u690d\u7269\u5df2\u6f86\u6c34\uff01"
          }
        }
      }
    },

    "pfad_gesund_day_14_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Wochen gesunde Routinen. Deine Energie steigt spürbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two weeks of healthy routines. Your energy is noticeably increasing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos semanas de rutinas saludables. Tu energía aumenta notablemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux semaines de routines saines. Ton énergie augmente sensiblement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due settimane di routine sane. La tua energia sta aumentando sensibilmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2週間の健康的な習慣。あなたのエネルギーは著しく増加しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주간의 건강한 일상. 당신의 에너지가 눈에 띄게 증가하고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee weken gezonde routines. Je energie neemt merkbaar toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa tygodnie zdrowych nawyków. Twoja energia zauważalnie wzrasta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas semanas de rotinas saudáveis. A tua energia está a aumentar visivelmente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki haftalık sağlıklı rutinler. Enerjiniz gözle görülür biçimde artıyor."
          }
        }
      }
    },

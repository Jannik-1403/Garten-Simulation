    "assessment.fitness.q12.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Dieses Brennen ist exakt der Punkt, an dem mein Körper wächst. Ich drücke weiter!'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'This burning sensation is exactly the point at which my body grows. I keep pushing!'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Esta sensación de ardor es exactamente el punto en el que mi cuerpo crece. ¡Sigo presionando!'"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Cette sensation de brûlure est exactement le moment où mon corps se développe. Je continue à pousser ! »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'यह जलन बिल्कुल वही बिंदु है जिस पर मेरा शरीर बढ़ता है। मैं जोर लगाता रहता हूं!'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Questa sensazione di bruciore è esattamente il punto in cui il mio corpo cresce. Continuo a spingere!'"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「この灼熱の感覚はまさに私の体が成長するポイントです。私は押し続けます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'이 타는듯한 느낌은 바로 내 몸이 성장하는 지점입니다. 계속 밀고 있어요!'"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Dit brandende gevoel is precies het punt waarop mijn lichaam groeit. Ik blijf duwen!'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„To uczucie pieczenia jest dokładnie momentem, w którym moje ciało rośnie. Naciskam dalej!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Essa sensação de queimação é exatamente o ponto em que meu corpo cresce. Eu continuo pressionando!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Это жжение — именно та точка, в которой мой организм растет. Я продолжаю давить!»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Bu yanma hissi tam olarak vücudumun büyüdüğü noktadır. İtmeye devam ediyorum!'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“这种灼烧感正是我的身体在生长的地方。我会继续努力！”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「這種灼熱感正是我的身體生長的時刻。我繼續推動！"
          }
        }
      }
    },
    "assessment.fitness.q13" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wachst auf und hast so brutalen Muskelkater in den Beinen, dass du kaum die Treppe runterkommst. Heute steht Oberkörper auf dem Plan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You wake up with muscles in your legs so sore you can barely get down the stairs. Today the upper body is on the agenda."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te despiertas con los músculos de las piernas tan doloridos que apenas puedes bajar las escaleras. Hoy la parte superior del cuerpo está en la agenda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous réveillez avec les muscles des jambes si endoloris que vous pouvez à peine descendre les escaliers. Aujourd’hui le haut du corps est à l’ordre du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपने पैरों की मांसपेशियों के साथ उठते हैं और इतनी पीड़ा महसूस करते हैं कि आप मुश्किल से सीढ़ियों से नीचे उतर पाते हैं। आज ऊपरी निकाय एजेंडे में है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti svegli con i muscoli delle gambe così doloranti che riesci a malapena a scendere le scale. Oggi la parte superiore del corpo è all'ordine del giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝起きると足が筋肉痛になっていて、階段を降りるのがやっとです。今日は上半身が議題です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일어나면 다리 근육이 너무 아파서 계단을 거의 내려갈 수 없을 정도입니다. 오늘은 상체 회의가 의제입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wordt wakker met spieren in je benen die zo pijnlijk zijn dat je nauwelijks de trap af kunt komen. Vandaag staat het bovenlichaam op de agenda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budzisz się z tak obolałymi mięśniami nóg, że ledwo możesz zejść po schodach. Dziś w porządku obrad jest górna część ciała."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você acorda com os músculos das pernas tão doloridos que mal consegue descer as escadas. Hoje a parte superior do corpo está na ordem do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты просыпаешься и у тебя такая сильная мышечная боль в ногах, что ты едва можешь спуститься по лестнице. Сегодня в плане верхняя часть тела."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bacaklarınızdaki kaslarla uyanıyorsunuz, o kadar ağrıyor ki merdivenlerden zar zor inebiliyorsunuz. Bugün üst vücut gündemde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你醒来时腿部肌肉酸痛得厉害，几乎下不去楼梯。今天的计划是锻炼上半身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你醒來時，腿部肌肉酸痛得幾乎無法下樓梯。今天上半身提上了議程。"
          }
        }
      }
    },

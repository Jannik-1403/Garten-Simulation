        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje wilgoć w ogrodzie na dłużej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém seu jardim úmido por mais tempo."
          }
        },
        "pt-BR": {

    "assessment.fitness.profile.schoenwetter_sportler.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsistenz ist alles. Trainiere heute, auch wenn du absolut keine Lust hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistency is everything. Train today, even if you absolutely don't feel like it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coherencia lo es todo. Entrena hoy, incluso si no te apetece en absoluto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cohérence est primordiale. Entraînez-vous aujourd’hui, même si vous n’en avez absolument pas envie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संगति ही सब कुछ है. आज ही प्रशिक्षण लें, भले ही आपका बिल्कुल मन न हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coerenza è tutto. Allenati oggi, anche se non ne hai assolutamente voglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一貫性がすべてです。たとえ気分が乗らなくても、今日はトレーニングしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일관성이 전부입니다. 전혀 기분이 좋지 않더라도 오늘 훈련하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistentie is alles. Train vandaag nog, ook als je absoluut geen zin hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spójność jest wszystkim. Trenuj już dziś, nawet jeśli zupełnie nie masz na to ochoty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistência é tudo. Treine hoje, mesmo que você não tenha vontade alguma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последовательность — это всё. Тренируйся сегодня, даже если у тебя совсем нет желания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutarlılık her şeydir. Canınız hiç istemese bile bugün antrenman yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坚持就是一切。即使你一点都不想，也要今天训练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致性就是一切。今天就訓練，即使你絕對不喜歡。"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.break" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checke nie wieder den Wetterbericht, bevor du entscheidest, ob du trainieren gehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never again check the weather forecast before deciding whether to exercise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca más consultes el pronóstico del tiempo antes de decidir si hacer ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vérifiez plus jamais les prévisions météorologiques avant de décider de faire de l'exercice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यायाम करना है या नहीं, इसका निर्णय लेने से पहले कभी भी मौसम के पूर्वानुमान की जाँच न करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non controllare mai più le previsioni del tempo prima di decidere se fare attività fisica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動するかどうかを決める前に天気予報をチェックする必要はもうありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동할지 여부를 결정하기 전에 다시는 일기예보를 확인하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer nooit meer de weersvoorspelling voordat u besluit of u gaat sporten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy więcej nie sprawdzaj prognozy pogody przed podjęciem decyzji o ćwiczeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca mais verifique a previsão do tempo antes de decidir se vai fazer exercícios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда больше не проверяй прогноз погоды, прежде чем решишь, идти ли тренироваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egzersiz yapıp yapmayacağınıza karar vermeden önce bir daha asla hava durumunu kontrol etmeyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在决定是否去训练之前，永远不要再查看天气预报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在決定是否運動之前，不要再查看天氣預報。"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.build" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an Trainingstagen nur deine Sportkleidung an. Ob du dann trainierst, ist egal – die Hürde ist das Umziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On training days, wear only your gym clothes. It doesn't matter whether you train or not - the hurdle is getting changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los días de entrenamiento, usa sólo tu ropa de gimnasia. No importa si entrenas o no: los obstáculos cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours d’entraînement, portez uniquement vos vêtements de sport. Peu importe que vous vous entraîniez ou non, les obstacles sont en train de changer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रशिक्षण के दिनों में केवल अपने जिम के कपड़े ही पहनें। इससे कोई फर्क नहीं पड़ता कि आप प्रशिक्षण लेते हैं या नहीं - बाधा बदल रही है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei giorni di allenamento indossa solo l'abbigliamento da palestra. Non importa se ti alleni o meno: l'ostacolo sta cambiando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習日は体操服のみを着用してください。トレーニングをするかしないかは関係ありません。ハードルは変わりつつあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련일에는 체육복만 입으세요. 훈련 여부는 중요하지 않습니다. 장애물이 바뀌고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draag op trainingsdagen alleen je gymkleding. Het maakt niet uit of je traint of niet: de hindernis wordt steeds groter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W dni treningowe noś wyłącznie strój gimnastyczny. Nie ma znaczenia, czy trenujesz, czy nie – przeszkoda się zmienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos dias de treino, use apenas roupas de ginástica. Não importa se você treina ou não – o obstáculo está sendo mudado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надевай спортивную одежду только в дни тренировок. Будешь ли ты тогда тренироваться, не важно — главным препятствием является переодевание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman günlerinde sadece spor kıyafetlerinizi giyin. Antrenman yapıp yapmamanız önemli değil; engel değişiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在训练日只穿你的运动服。你是否真的训练无所谓——关键是换衣服这一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訓練日，只穿運動服。不管你是否訓練，障礙都會改變。"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Konsistenz. Die 1％-Methode beseitigt die Ausreden vor dem Sport, nicht den Sport selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No consistency. The 1％ method eliminates the excuses before exercise, not the exercise itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin coherencia. El método del 1％ elimina las excusas antes del ejercicio, no el ejercicio en sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune cohérence. La méthode 1％ élimine les excuses avant l’exercice, pas l’exercice lui-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई स्थिरता नहीं. 1％ विधि व्यायाम से पहले के बहानों को ख़त्म करती है, व्यायाम को नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna coerenza. Il metodo dell’1％ elimina le scuse prima dell’esercizio, non l’esercizio stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一貫性がない。 1％ メソッドは、運動そのものではなく、運動前の言い訳を排除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일관성이 없습니다. 1％ 방법은 운동 자체가 아닌 운동 전 핑계를 없애줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen consistentie. De 1％-methode elimineert de excuses vóór het sporten, niet de oefening zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak konsekwencji. Metoda 1％ eliminuje wymówki przed ćwiczeniami, a nie same ćwiczenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem consistência. O método de 1％ elimina as desculpas antes do exercício, e não o exercício em si."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет последовательности. Метод 1％ устраняет оправдания перед тренировкой, а не саму тренировку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutarlılık yok. ％1 yöntemi egzersizin kendisini değil, egzersiz öncesi mazeretleri ortadan kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有一致性。1％ 方法消除了锻炼前的借口，而不是锻炼本身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有一致性。 1％方法消除的是運動前的藉口，而不是運動本身。"
          }
        }
      }
    },

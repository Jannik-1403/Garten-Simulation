    "assessment.health.profile.vergifter.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Körper läuft auf schlechtem Treibstoff. Baue eine bewusste Ernährung auf und versorge dein System mit echten Nährstoffen."

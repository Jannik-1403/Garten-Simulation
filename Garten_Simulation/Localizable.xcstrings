            "value": "Prepare refeições com antecedência (meal prep) para a semana que vem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительное приготовление еды (приготовление еды) на предстоящую неделю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki hafta için önceden yemek hazırla (meal prep)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为下周预先做饭（膳食准备）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為下週預先做飯（膳食準備）。"
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche: Was kostet eine Bestellung vs. selbst kochen – pro Monat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare: what does an order cost vs. cooking yourself – per month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara: ¿cuánto cuesta un pedido frente a cocinar tú mismo al mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare: combien coûte une commande par rapport à cuisiner soi-même – par mois ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना करें: एक ऑर्डर करने की लागत बनाम खुद खाना पकाने की – प्रति माह?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta: quanto costa un ordine rispetto a cucinare da soli – al mese?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較してみましょう。月ごとに注文と自炊のコストはどれくらい違いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교해 보세요: 월별 주문 비용 대 직접 요리 비용은?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk: wat kost een bestelling versus zelf koken – per maand?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównaj: ile kosztuje zamówienie w porównaniu z samodzielnym gotowaniem – miesięcznie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare: o que custa um pedido vs. cozinhar você mesmo – por mês?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare: o que custa um pedido vs. cozinhar você mesmo – por mês?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение: сколько стоит заказ и приготовление самостоятельно в месяц?"
          }

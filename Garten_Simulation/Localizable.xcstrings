    "plant.pilzkolonie.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knüpfe wertvolle Kontakte und baue dein Netzwerk auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make valuable contacts and build your network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz contactos valiosos y construye tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouez des contacts précieux et développez votre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea contatti preziosi e costruisci la tua rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貴重なコネクションを作り、ネットワークを構築しましょう。"

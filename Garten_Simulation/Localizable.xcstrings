    "prog_screentime_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte heute die Benachrichtigungen für alle Social-Media- und Shopping-Apps dauerhaft aus. Nur echte Menschen dürfen piepen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently turn off notifications for all social media and shopping apps today. Only real people are allowed to beep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactive permanentemente las notificaciones de todas las redes sociales y aplicaciones de compras hoy. Sólo las personas reales pueden emitir un pitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez définitivement les notifications pour tous les réseaux sociaux et applications d'achat dès aujourd'hui. Seules les vraies personnes sont autorisées à émettre un bip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज ही सभी सोशल मीडिया और शॉपिंग ऐप्स के लिए नोटिफिकेशन स्थायी रूप से बंद कर दें। केवल वास्तविक लोगों को ही बीप करने की अनुमति है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva permanentemente le notifiche per tutti i social media e le app per lo shopping oggi stesso. Solo le persone reali possono emettere un segnale acustico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐすべてのソーシャルメディアとショッピングアプリの通知を永久にオフにします。ビープ音を鳴らすことができるのは本物の人間だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 모든 소셜 미디어 및 쇼핑 앱에 대한 알림을 영구적으로 끄세요. 실제 사람에게만 경고음이 울릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel vandaag nog permanent meldingen uit voor alle sociale media en winkel-apps. Alleen echte mensen mogen piepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już dziś wyłącz na stałe powiadomienia we wszystkich mediach społecznościowych i aplikacjach zakupowych. Tylko prawdziwi ludzie mogą piszczeć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative permanentemente as notificações de todas as mídias sociais e aplicativos de compras hoje mesmo. Somente pessoas reais podem apitar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative permanentemente as notificações de todas as mídias sociais e aplicativos de compras hoje mesmo. Somente pessoas reais podem apitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня навсегда отключите уведомления для всех социальных сетей и приложений для покупок. Только реальным людям разрешено подавать звуковой сигнал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün tüm sosyal medya ve alışveriş uygulamalarına ilişkin bildirimleri kalıcı olarak kapatın. Yalnızca gerçek kişilerin bip sesi çıkarmasına izin verilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即永久关闭所有社交媒体和购物应用程序的通知。只有真人才能发出嘟嘟声。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即永久關閉所有社交媒體和購物應用程式的通知。只有真人才能發出嘟嘟聲。"
          }
        }
      }
    },

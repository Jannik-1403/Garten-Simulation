    "onboarding_willkommen_blase" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Ich bin dein Garten-Guide. Lass uns zusammen deinen persönlichen Garten anlegen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello! I'm your garden guide. Let's create your personal garden together!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Soy tu guía del jardín. ¡Curemos juntos tu jardín personal!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ! Je suis ton guide du jardin. Créons ton jardin personnel ensemble !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते! मैं आपका उद्यान मार्गदर्शक हूं। आइए मिलकर अपना निजी उद्यान बनाएं!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello! I'm your garden guide. Let's create your personal garden together!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！私はあなたの庭園ガイドです。あなただけのお庭を一緒に作りましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 나는 당신의 정원 가이드입니다. 나만의 정원을 함께 만들어 보세요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Ik ben jouw tuingids. Laten we samen uw persoonlijke tuin creëren!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć! Jestem twoim przewodnikiem po ogrodzie. Stwórzmy razem Twój osobisty ogród!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá! Sou o teu guia do jardim. Vamos criar o teu jardim pessoal juntos!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет! Я твой гид по саду. Давай вместе создадим твой личный сад!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba! Ben senin bahçe rehberinim. Gelin kişisel bahçenizi birlikte yaratalım!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我是你的花园向导。让我们一起创建你的专属花园吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我是你的花園導遊。讓我們一起打造您的私人花園吧！"
          }
        }
      }
    },

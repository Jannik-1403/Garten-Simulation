          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder bezorgservice-apps van je beginscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń aplikacje dostaw ze swojego ekranu głównego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova os apps de delivery da sua tela inicial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova os apps de delivery da sua tela inicial."
          }
        },
        "ru": {

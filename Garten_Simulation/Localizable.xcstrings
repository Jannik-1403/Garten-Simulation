    "tour_2_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Gewohnheiten können sich auf deinen Körper auswirken. Achte darauf so wenig wie möglich zu machen. Sei auch immer ehrlich zu dir selber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad habits can affect your body. Make sure to do as little as possible. Always be honest with yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los malos hábitos pueden afectar a tu cuerpo. Asegúrate de hacer lo menos posible. Sé siempre honesto contigo mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises habitudes peuvent affecter votre corps. Veillez à en faire le moins possible. Soyez toujours honnête avec vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुरी आदतें आपके शरीर को प्रभावित कर सकती हैं। सुनिश्चित करें कि आप जितना संभव हो उतना कम करें। हमेशा खुद के प्रति ईमानदार रहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cattive abitudini possono influire sul tuo corpo. Assicurati di farne il meno possibile. Sii sempre onesto con te stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪い習慣は体に影響を与える可能性があります。できるだけ少なくするようにしてください。常に自分に正直になってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁜 습관은 몸에 영향을 미칠 수 있습니다. 가능한 한 적게 하도록 하세요. 항상 자신에게 정직해지세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechte gewoonten kunnen je lichaam beïnvloeden. Zorg ervoor dat je zo min mogelijk doet. Wees altijd eerlijk tegen jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złe nawyki mogą wpływać na twoje ciało. Upewnij się, że robisz jak najmniej. Zawsze bądź ze sobą szczery."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os maus hábitos podem afetar o seu corpo. Certifique-se de fazer o mínimo possível. Seja sempre honesto consigo mesmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os maus hábitos podem afetar o seu corpo. Certifique-se de fazer o mínimo possível. Seja sempre honesto consigo mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плохие привычки могут сказаться на вашем теле. Старайтесь делать как можно меньше. Всегда будьте честны с собой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kötü alışkanlıklar vücudunuzu etkileyebilir. Mümkün olduğunca az yapmaya dikkat edin. Kendinize karşı her zaman dürüst olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坏习惯会影响你的身体。尽量少做。始终对自己诚实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壞習慣會影響你的身體。盡量少做。始終對自己誠實。"
          }
        }
      }
    },

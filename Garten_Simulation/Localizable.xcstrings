    "assessment.fitness.q4.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Körper ist das exakte Spiegelbild meiner Disziplin. Ich bekomme das, was ich verdiene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My body is the exact reflection of my discipline. I get what I deserve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

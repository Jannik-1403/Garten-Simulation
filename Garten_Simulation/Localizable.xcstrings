    "assessment.growth.profile.traeumer.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast tolle Pläne, aber keine Umsetzung. Beginne damit, tägliche Action-Steps zu definieren und diese bedingungslos auszuführen."

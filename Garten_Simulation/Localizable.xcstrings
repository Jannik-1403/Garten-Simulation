          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu ritmo. Una sesión enfocada hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve ton rythme. Une session concentrée aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova il tuo ritmo. Una sessione focalizzata oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のリズムを見つけてください。今日は集中的なセッションが 1 つあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 리듬을 찾아보세요. 오늘은 집중 세션입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind jouw ritme. Eén gerichte sessie vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź swój rytm. Dzisiaj jedna skupiona sesja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra o teu ritmo. Uma sessão focada hoje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritiminizi bulun. Bugün odaklanmış bir oturum."
          }
        }

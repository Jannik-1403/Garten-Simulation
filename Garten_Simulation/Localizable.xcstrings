    "tour_daily_ring_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ring zeigt deinen heutigen Fortschritt. Klicke darauf, um detaillierte Statistiken über deine Leistung zu sehen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ring shows your daily progress. Click on it to see detailed statistics about your performance!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anillo muestra tu progreso diario. ¡Haz clic en él para ver estadísticas detalladas sobre tu rendimiento!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet anneau montre votre progrès quotidien. Cliquez dessus pour voir des statistiques détaillées sur vos performances !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अंगूठी आपके आज की प्रगति को दिखाती है। अपनी उपलब्धियों के विस्तृत आंकड़े देखने के लिए इस पर क्लिक करें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo anello mostra il tuo progresso giornaliero. Cliccaci sopra per vedere statistiche dettagliate sulle tue prestazioni!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリングはあなたの毎日の進捗を示しています。クリックしてパフォーマンスに関する詳細な統計を確認してください！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링은 일일 진행 상황을 보여줍니다. 클릭하여 성과에 대한 자세한 통계를 확인하세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze ring toont je dagelijkse voortgang. Klik erop om gedetailleerde statistieken over je prestaties te zien!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten pierścień pokazuje twój codzienny postęp. Kliknij go, aby zobaczyć szczegółowe statystyki o swoich wynikach!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anel mostra seu progresso diário. Clique nele para ver estatísticas detalhadas sobre o seu desempenho!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anel mostra seu progresso diário. Clique nele para ver estatísticas detalhadas sobre o seu desempenho!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это кольцо показывает ваш сегодняшний прогресс. Нажмите на нее, чтобы увидеть подробную статистику о ваших выступлениях!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu halka günlük ilerlemenizi gösterir. Performansınız hakkında ayrıntılı istatistikleri görmek için üzerine tıklayın!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这枚戒指显示了您今天的进步。单击它即可查看有关您表现的详细统计数据！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這枚戒指顯示了您今天的進步。點擊它即可查看有關您表現的詳細統計數據！"
          }
        }
      }
    },

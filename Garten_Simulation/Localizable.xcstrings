        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune idée. Je tape simplement la carte et n'y pense pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अनुमान नहीं। मैं बस कार्ड टैप करता हूं और इसके बारे में नहीं सोचता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna idea. Tocco semplicemente la carta e non ci penso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わかりません。何も考えずにカードをタップするだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모르겠어요. 그냥 카드만 탭하고 아무 생각도 안 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen idee. Ik tik gewoon op de kaart en denk er niet over na."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie mam pojęcia. Po prostu dotykam karty i nie myślę o tym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não faço ideia. Eu apenas toco no cartão e não penso nisso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без понятия. Я просто нажимаю на карту и не думаю об этом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir fikrim yok. Sadece karta dokunuyorum ve bunu düşünmüyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不知道。我只是随便刷一下卡，不去想它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不知道。我只是輕拍卡片，沒有多想。"
          }
        }
      }
    },

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\uba74\uc758 \ud1b5\uc81c\ub85c \uaf43\uc744 \ud53c\uc6b0\ub2e4 - \uc790\uae30 \ud6c8\ub828"

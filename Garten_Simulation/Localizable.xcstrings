    "prog_water_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungesüßter Kräutertee zählt als Wasser. Baue heute eine Kanne Tee in deine Hydration ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsweetened herbal tea counts as water. Incorporate a pot of tea into your hydration today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El té de hierbas sin azúcar cuenta como agua. Incorpora hoy una taza de té a tu hidratación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tisanes non sucrées comptent comme de l’eau. Incorporez une théière à votre hydratation dès aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना चीनी वाली हर्बल चाय को पानी के समान माना जाता है। आज ही अपने हाइड्रेशन में चाय का एक बर्तन शामिल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tisana non zuccherata conta come acqua. Incorpora una tazza di tè nella tua idratazione oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無糖のハーブティーは水としてカウントされます。今日の水分補給にポットのお茶を取り入れてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무가당 허브티는 물로 간주됩니다. 오늘 수분 공급에 차 한 주전자를 추가해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongezoete kruidenthee telt als water. Voeg vandaag nog een pot thee toe aan je hydratatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niesłodzona herbata ziołowa liczy się jako woda. Już dziś włącz dzbanek herbaty do swojego nawodnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O chá de ervas sem açúcar conta como água. Incorpore um bule de chá em sua hidratação hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chá de ervas sem açúcar conta como água. Incorpore um bule de chá em sua hidratação hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несладкий травяной чай считается водой. Включите сегодня в свой питьевой режим чашку чая."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şekersiz bitki çayları su sayılır. Bugün sıvı alımınıza bir demlik çay ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不加糖的花草茶算作水。今天喝一壶茶来补充水分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不加糖的花草茶算水。今天喝一壺茶來補充水分。"
          }
        }
      }
    },

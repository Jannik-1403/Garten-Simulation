    "assessment.growth.profile.aufgeber.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf keine neuen Tools oder Kurse mehr, solange der alte Kurs nicht zu mindestens 10\uff05 abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not purchase any new tools or courses until the old course is at least 10\uff05 complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compre ninguna herramienta o curso nuevo hasta que el curso anterior est\u00e9 completo al menos en un 10 \uff05."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'achetez pas de nouveaux outils ou cours tant que l'ancien cours n'est pas termin\u00e9 \u00e0 au moins 10 \uff05."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u092c \u0924\u0915 \u092a\u0941\u0930\u093e\u0928\u093e \u0915\u094b\u0930\u094d\u0938 \u0915\u092e \u0938\u0947 \u0915\u092e 10\uff05 \u092a\u0942\u0930\u093e \u0928 \u0939\u094b \u091c\u093e\u090f \u0924\u092c \u0924\u0915 \u0915\u094b\u0908 \u0928\u092f\u093e \u091f\u0942\u0932 \u092f\u093e \u0915\u094b\u0930\u094d\u0938 \u0928 \u0916\u0930\u0940\u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non acquistare nuovi strumenti o corsi fino a quando il vecchio corso non avr\u00e0 completato almeno il 10\uff05."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53e4\u3044\u30b3\u30fc\u30b9\u304c\u5c11\u306a\u304f\u3068\u3082 10\uff05 \u5b8c\u4e86\u3059\u308b\u307e\u3067\u3001\u65b0\u3057\u3044\u30c4\u30fc\u30eb\u3084\u30b3\u30fc\u30b9\u3092\u8cfc\u5165\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\uc804 \uacfc\uc815\uc774 \ucd5c\uc18c 10\uff05 \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \uc0c8 \ub3c4\uad6c\ub098 \uacfc\uc815\uc744 \uad6c\uc785\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koop geen nieuwe tools of cursussen totdat de oude cursus voor minimaal 10\uff05 voltooid is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie kupuj \u017cadnych nowych narz\u0119dzi ani kurs\u00f3w, dop\u00f3ki stary kurs nie zostanie uko\u0144czony w co najmniej 10\uff05."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o compre nenhuma ferramenta ou curso novo at\u00e9 que o curso antigo esteja pelo menos 10\uff05 conclu\u00eddo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u043e\u043a\u0443\u043f\u0430\u0439 \u043d\u043e\u0432\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0438\u043b\u0438 \u043a\u0443\u0440\u0441\u044b, \u043f\u043e\u043a\u0430 \u0441\u0442\u0430\u0440\u044b\u0439 \u043a\u0443\u0440\u0441 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0439\u0434\u0435\u043d \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043d\u0430 10\uff05."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski kursun en az \uff0510'u tamamlanana kadar yeni ara\u00e7 veya kurs sat\u0131n almay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u65e7\u8bfe\u7a0b\u81f3\u5c11\u5b8c\u621010\uff05\u4e4b\u524d\uff0c\u4e0d\u8981\u518d\u8d2d\u4e70\u65b0\u7684\u5de5\u5177\u6216\u8bfe\u7a0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u820a\u8ab2\u7a0b\u81f3\u5c11\u5b8c\u6210 10\uff05 \u4e4b\u524d\uff0c\u8acb\u52ff\u8cfc\u8cb7\u4efb\u4f55\u65b0\u5de5\u5177\u6216\u8ab2\u7a0b\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.aufgeber.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache t\u00e4glich genau eine Liegest\u00fctze oder lies genau eine Seite. Die H\u00fcrde muss l\u00e4cherlich klein sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do exactly one push-up or read exactly one page every day. The hurdle has to be ridiculously small."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz exactamente una flexi\u00f3n o lee exactamente una p\u00e1gina todos los d\u00edas. El obst\u00e1culo tiene que ser rid\u00edculamente peque\u00f1o."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites exactement une pompe ou lisez exactement une page chaque jour. L\u2019obstacle doit \u00eatre ridiculement petit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0926\u093f\u0928 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u090f\u0915 \u092a\u0941\u0936-\u0905\u092a \u0915\u0930\u0947\u0902 \u092f\u093e \u0920\u0940\u0915 \u090f\u0915 \u092a\u0947\u091c \u092a\u0922\u093c\u0947\u0902\u0964 \u092c\u093e\u0927\u093e \u0939\u093e\u0938\u094d\u092f\u093e\u0938\u094d\u092a\u0926 \u0930\u0942\u092a \u0938\u0947 \u091b\u094b\u091f\u0940 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai esattamente una flessione o leggi esattamente una pagina ogni giorno. L\u2019ostacolo deve essere ridicolmente piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u3061\u3087\u3046\u3069 1 \u56de\u306e\u8155\u7acb\u3066\u4f0f\u305b\u3092\u3059\u308b\u304b\u3001\u3061\u3087\u3046\u3069 1 \u30da\u30fc\u30b8\u306e\u8aad\u66f8\u3092\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30cf\u30fc\u30c9\u30eb\u306f\u3068\u3093\u3067\u3082\u306a\u304f\u4f4e\u3044\u306f\u305a\u3060\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \uc815\ud655\ud788 \ud55c \ubc88\ub9cc \ud478\uc2dc\uc5c5\uc744 \ud558\uac70\ub098 \uc815\ud655\ud788 \ud55c \ud398\uc774\uc9c0\ub97c \uc77d\uc73c\uc138\uc694. \uc7a5\uc560\ubb3c\uc740 \uc5c4\uccad\ub098\uac8c \uc791\uc544\uc57c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe elke dag precies \u00e9\u00e9n push-up of lees precies \u00e9\u00e9n pagina. De hindernis moet belachelijk klein zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codziennie r\u00f3b dok\u0142adnie jedn\u0105 pompk\u0119 lub czytaj dok\u0142adnie jedn\u0105 stron\u0119. Przeszkoda musi by\u0107 \u015bmiesznie ma\u0142a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa\u00e7a exatamente uma flex\u00e3o ou leia exatamente uma p\u00e1gina todos os dias. O obst\u00e1culo deve ser ridiculamente pequeno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u043b\u0430\u0439 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0440\u043e\u0432\u043d\u043e \u043e\u0434\u0438\u043d \u043e\u0442\u0436\u0438\u043c \u0438\u043b\u0438 \u0447\u0438\u0442\u0430\u0439 \u0440\u043e\u0432\u043d\u043e \u043e\u0434\u043d\u0443 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443. \u041f\u043e\u0440\u043e\u0433 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0441\u043c\u0435\u0445\u043e\u0442\u0432\u043e\u0440\u043d\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her g\u00fcn tam olarak bir \u015f\u0131nav \u00e7ekin veya tam olarak bir sayfa okuyun. Engel g\u00fcl\u00fcn\u00e7 derecede k\u00fc\u00e7\u00fck olmal\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u53ea\u505a\u4e00\u4e2a\u4fef\u5367\u6491\u6216\u53ea\u8bfb\u4e00\u9875\u3002\u95e8\u69db\u5fc5\u987b\u975e\u5e38\u4f4e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u53ea\u505a\u4e00\u500b\u4f0f\u5730\u633a\u8eab\u6216\u95b1\u8b80\u4e00\u9801\u3002\u9019\u500b\u969c\u7919\u5fc5\u9808\u5c0f\u5f97\u96e2\u8b5c\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.aufgeber.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald es schwer wird, schmei\u00dft du hin. Wir machen die Einstiegsh\u00fcrde so absurd klein, dass du nicht aufgeben kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as it gets difficult, you give up. We make the barrier to entry so absurdly small that you can't give up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan pronto como se pone dif\u00edcil, te rindes. Hacemos que la barrera de entrada sea tan absurdamente peque\u00f1a que no puedes rendirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e8s que \u00e7a devient difficile, on abandonne. Nous rendons la barri\u00e8re \u00e0 l\u2019entr\u00e9e si absurdement petite que vous ne pouvez pas abandonner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0948\u0938\u0947 \u0939\u0940 \u092f\u0939 \u0915\u0920\u093f\u0928 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948, \u0906\u092a \u0939\u093e\u0930 \u092e\u093e\u0928 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0940 \u092c\u093e\u0927\u093e \u0915\u094b \u0907\u0924\u0928\u093e \u091b\u094b\u091f\u093e \u092c\u0928\u093e \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u0939\u093e\u0930 \u0928\u0939\u0940\u0902 \u092e\u093e\u0928 \u0938\u0915\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appena diventa difficile, ti arrendi. Rendiamo la barriera all'ingresso cos\u00ec assurdamente piccola che non puoi arrenderti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96e3\u3057\u304f\u306a\u308b\u3068\u3059\u3050\u306b\u8ae6\u3081\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u79c1\u305f\u3061\u306f\u53c2\u5165\u969c\u58c1\u3092\u975e\u5e38\u306b\u4f4e\u304f\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u3042\u306a\u305f\u306f\u8ae6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud798\ub4e4\uba74 \ubc14\ub85c \ud3ec\uae30\ud558\uc138\uc694. \uc6b0\ub9ac\ub294 \ud3ec\uae30\ud560 \uc218 \uc5c6\uc744 \uc815\ub3c4\ub85c \uc9c4\uc785 \uc7a5\ubcbd\uc744 \ub108\ubb34 \uc791\uac8c \ub9cc\ub4ed\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra het moeilijk wordt, geef je het op. Wij maken de toetredingsdrempel zo absurd klein dat je niet kunt opgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy tylko zrobi si\u0119 trudno, poddajesz si\u0119. Sprawiamy, \u017ce bariera wej\u015bcia jest tak absurdalnie ma\u0142a, \u017ce \u200b\u200bnie mo\u017cna si\u0119 podda\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que fica dif\u00edcil, voc\u00ea desiste. Tornamos a barreira de entrada t\u00e3o absurdamente pequena que voc\u00ea n\u00e3o consegue desistir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0442\u044f\u0436\u0435\u043b\u043e, \u0442\u044b \u0441\u0434\u0430\u0435\u0448\u044c\u0441\u044f. \u041c\u044b \u0434\u0435\u043b\u0430\u0435\u043c \u043f\u043e\u0440\u043e\u0433 \u0432\u0445\u043e\u0434\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c, \u0447\u0442\u043e \u0442\u044b \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0448\u044c \u0441\u0434\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorla\u015ft\u0131\u011f\u0131 anda vazge\u00e7iyorsun. Giri\u015f engelini o kadar k\u00fc\u00e7\u00fck yap\u0131yoruz ki vazge\u00e7emiyorsunuz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u65e6\u53d8\u5f97\u56f0\u96be\uff0c\u4f60\u5c31\u653e\u5f03\u3002\u6211\u4eec\u628a\u5165\u95e8\u95e8\u69db\u505a\u5f97\u975e\u5e38\u4f4e\uff0c\u4ee5\u81f3\u4e8e\u4f60\u65e0\u6cd5\u653e\u5f03\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u65e6\u8b8a\u5f97\u56f0\u96e3\uff0c\u4f60\u5c31\u6703\u653e\u68c4\u3002\u6211\u5011\u5c07\u9032\u5165\u9580\u6abb\u8a2d\u7f6e\u5f97\u5c0f\u5f97\u96e2\u8b5c\uff0c\u8b93\u60a8\u7121\u6cd5\u653e\u68c4\u3002"
          }
        }
      }
    },

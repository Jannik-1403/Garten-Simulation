    "trash.alkohol_flatrate.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere alle Alkohol-Vorräte aus dem Haus – was nicht da ist, wird nicht getrunken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty all alcohol supplies from home – what's not there won't be drunk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía todas las reservas de alcohol de casa: lo que no está no se bebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide toutes les réserves d'alcool à la maison – ce qui n'est pas là ne sera pas bu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से सभी शराब की भंडार साफ कर दें – जो मौजूद नहीं है, उसे कोई नहीं पीएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota tutte le scorte di alcolici da casa – quello che non c'è non viene bevuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家のアルコールの在庫をすべて処分しましょう。なければ飲めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집에서 모든 알코올 재고를 비우세요 – 없는 것은 마실 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak alle alcoholvoorraden thuis leeg – wat er niet is, wordt niet gedronken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opróżnij wszystkie zapasy alkoholu w domu – czego nie ma, nie zostanie wypite."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazie todos os estoques de álcool em casa – o que não está lá não será bebido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazie todos os estoques de álcool em casa – o que não está lá não será bebido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вылейте из дома все запасы алкоголя – если у вас его нет, не пейте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evdeki tüm alkol stoklarını boşalt – olmayan içilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空家里所有的酒精用品——如果没有，就不要喝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空家裡所有的酒精用品——如果沒有，就不要喝。"
          }
        }
      }
    },
    "trash.alkohol_flatrate.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol senkt kurzfristig Stress, erhöht ihn langfristig massiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol reduces stress short-term but massively increases it long-term."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alcohol reduce el estrés a corto plazo pero lo aumenta enormemente a largo plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alcool réduit le stress à court terme mais l'augmente massivement à long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शराब अल्पकाल में तनाव को कम करता है, लेकिन दीर्घकाल में इसे भारी रूप से बढ़ा देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alcol riduce lo stress a breve termine ma lo aumenta massicciamente a lungo termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルコールは短期的にストレスを下げますが、長期的には大幅に増加させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알코올은 단기적으로 스트레스를 줄이지만 장기적으로는 크게 증가시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol verlaagt stress op korte termijn maar verhoogt het op lange termijn enorm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol krótkoterminowo obniża stres, ale długoterminowo mocno go zwiększa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O álcool reduz o estresse a curto prazo, mas o aumenta massivamente a longo prazo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O álcool reduz o estresse a curto prazo, mas o aumenta massivamente a longo prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алкоголь снижает стресс в краткосрочной перспективе, но значительно увеличивает его в долгосрочной перспективе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkol kısa vadede stresi azaltır ama uzun vadede büyük ölçüde artırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酒精可以在短期内减轻压力，但从长远来看会大大增加压力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "酒精可以在短期內減輕壓力，但長期來看會大大增加壓力。"
          }
        }
      }
    },
    "trash.alkohol_flatrate.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere 'Dry Days': Plane feste alkoholfreie Tage pro Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try 'Dry Days': plan fixed alcohol-free days per week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba los 'Dry Days': planifica días fijos sin alcohol a la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie les 'Dry Days': planifie des jours sans alcool fixes par semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "‘ड्राई डेज़’ आज़माएँ: सप्ताह में निश्चित बिना शराब वाले दिन तय करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova i 'Dry Days': pianifica giorni fissi senza alcol a settimana."

    "prog_cooking_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integriere heute Hülsenfrüchte (Bohnen, Linsen) oder Haferflocken, um deine Darmbakterien zu füttern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorporate legumes (beans, lentils) or oatmeal today to feed your gut bacteria."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora hoy legumbres (frijoles, lentejas) o avena para alimentar tus bacterias intestinales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorporez dès aujourd’hui des légumineuses (haricots, lentilles) ou des flocons d’avoine pour nourrir vos bactéries intestinales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पेट के बैक्टीरिया को पोषण देने के लिए आज ही फलियां (बीन्स, दाल) या दलिया शामिल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora oggi legumi (fagioli, lenticchie) o farina d'avena per nutrire i tuoi batteri intestinali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腸内細菌の餌として、今日から豆類（豆、レンズ豆）やオートミールを取り入れましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 장내 세균의 먹이가 되도록 콩과 식물(콩, 렌즈콩)이나 오트밀을 첨가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg vandaag nog peulvruchten (bonen, linzen) of havermout toe om uw darmbacteriën te voeden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dziś rośliny strączkowe (fasola, soczewica) lub płatki owsiane, aby nakarmić bakterie jelitowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpore legumes (feijões, lentilhas) ou aveia hoje para alimentar as bactérias intestinais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpore legumes (feijões, lentilhas) ou aveia hoje para alimentar as bactérias intestinais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите сегодня бобовые (фасоль, чечевица) или овсянку, чтобы подкормить кишечные бактерии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağırsak bakterilerinizi beslemek için bugün baklagilleri (fasulye, mercimek) veya yulaf ezmesini ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天加入豆类（黄豆、扁豆）或燕麦片来喂养肠道细菌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天就加入豆類（黃豆、扁豆）或燕麥片來餵養腸道細菌。"
          }
        }
      }
    },

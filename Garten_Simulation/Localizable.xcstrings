          }
        }
      }
    },
    "assessment.health.q15.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehrlich gesagt? Ich habe gar keinen Antrieb, gesund zu sein, solange ich nicht krank bin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly? I have no motivation to be healthy unless I'm sick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Honestamente? No tengo ninguna motivación para estar sano a menos que esté enfermo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honnêtement? Je n'ai aucune motivation pour être en bonne santé à moins d'être malade."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमानदारी से? जब तक मैं बीमार न हो जाऊं, मुझे स्वस्थ रहने की कोई प्रेरणा नहीं मिलती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onestamente? Non ho alcuna motivazione per essere in salute a meno che non sia malato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正直に？病気でなければ健康でありたいという動機がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "솔직히? 아프지 않으면 건강할 의욕이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlijk gezegd? Ik heb geen motivatie om gezond te zijn tenzij ik ziek ben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczerze mówiąc? Nie mam motywacji, żeby być zdrowym, chyba że jestem chory."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestamente? Não tenho motivação para ser saudável, a menos que esteja doente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Честно говоря? У меня вообще нет желания быть здоровым, пока я не болею."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkçası? Hasta olmadığım sürece sağlıklı olmak için hiçbir motivasyonum yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说实话？只要我没生病，我完全没有动力去保持健康。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誠實地？除非我生病了，否則我沒有動力保持健康。"
          }
        }
      }
    },

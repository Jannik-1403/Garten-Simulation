    "verlauf.analysis.desc.fluctuating": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Routine bei dieser Gewohnheit ist noch unregelmäßig. Versuche, sie an eine bereits bestehende Gewohnheit zu koppeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your routine for this habit is still irregular. Try to anchor it to an existing habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rutina con este hábito aún es irregular. Intente vincularlo a un hábito existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine avec cette habitude est encore irrégulière. Essayez de le lier à une habitude existante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आदत से आपकी दिनचर्या अभी भी अनियमित है। इसे किसी मौजूदा आदत से जोड़ने का प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua routine con questa abitudine è ancora irregolare. Prova a collegarlo a un'abitudine esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣がついたあなたの日常は依然として不規則です。既存の習慣と結びつけるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 습관이 있는 당신의 일상은 여전히 ​​불규칙합니다. 기존 습관과 연결해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je routine met deze gewoonte is nog steeds onregelmatig. Probeer het te koppelen aan een bestaande gewoonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja rutyna związana z tym nawykiem jest nadal nieregularna. Spróbuj powiązać to z istniejącym nawykiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua rotina com esse hábito ainda é irregular. Tente vinculá-lo a um hábito existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua rotina com esse hábito ainda é irregular. Tente vinculá-lo a um hábito existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш распорядок дня с этой привычкой по-прежнему нерегулярен. Попробуйте связать это с существующей привычкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlıkla ilgili rutininiz hala düzensiz. Bunu mevcut bir alışkanlığa bağlamaya çalışın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的这个习惯仍然不规律。尝试将其与现有习惯联系起来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的這個習慣仍然不規則。嘗試將其與現有習慣聯繫起來。"
          }
        }
      }
    },
    "verlauf.analysis.desc.low": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit ist in letzter Zeit etwas eingeschlafen. Setze dir ein kleines, machbares Ziel für morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit has been neglected recently. Set a small, achievable goal for tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito ha disminuido un poco últimamente. Fíjese una meta pequeña y factible para mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude s’est un peu atténuée ces derniers temps. Fixez-vous un petit objectif réalisable pour demain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत हाल ही में थोड़ी कम हुई है। कल के लिए अपने लिए एक छोटा, साध्य लक्ष्य निर्धारित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimamente questa abitudine si è un po’ attenuata. Poniti un piccolo obiettivo fattibile per domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近はこの習慣も少し減りました。明日の小さな、実行可能な目標を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에는 이 습관이 조금 사라졌습니다. 내일을 위해 작고 실행 가능한 목표를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte is de laatste tijd een beetje afgenomen. Stel jezelf een klein, haalbaar doel voor morgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio ten zwyczaj nieco zanikł. Wyznacz sobie mały, wykonalny cel na jutro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito diminuiu um pouco ultimamente. Estabeleça uma meta pequena e factível para amanhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito diminuiu um pouco ultimamente. Estabeleça uma meta pequena e factível para amanhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В последнее время эта привычка немного угасла. Поставьте себе небольшую, достижимую цель на завтра."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık son zamanlarda biraz azaldı. Yarın için kendinize küçük, gerçekleştirilebilir bir hedef belirleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个习惯最近有点消失了。为明天给自己设定一个可行的小目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個習慣最近有點消失了。為明天給自己設定一個可行的小目標。"
          }
        }
      }
    },
    "verlauf.analysis.desc.new": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade erst angefangen! Bleib dran, um bald erste Trends zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just started! Keep it up to see your first trends soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Acabas de empezar! Estén atentos para ver las primeras tendencias pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de commencer ! Restez à l'écoute pour voir bientôt les premières tendances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी शुरुआत की है! जल्द ही पहला रुझान देखने के लिए हमारे साथ बने रहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai appena iniziato! Restate sintonizzati per vedere presto le prime tendenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ始まったばかりです!最初のトレンドをすぐに確認できるようご期待ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 막 시작했어요! 곧 첫 번째 트렌드를 확인하실 수 있도록 계속 지켜봐 주시기 바랍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent net begonnen! Blijf ons volgen om binnenkort de eerste trends te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie zacząłeś! Bądźcie czujni, już niedługo poznamy pierwsze trendy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você apenas começou! Fique ligado para ver as primeiras tendências em breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você apenas começou! Fique ligado para ver as primeiras tendências em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы только начали! Оставайтесь с нами, чтобы вскоре увидеть первые тенденции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni başladın! Yakında ilk trendleri görmek için bizi takip etmeye devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你才刚刚开始！请继续关注，很快就能看到第一个趋势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你才剛開始！請繼續關注，很快就能看到第一個趨勢。"
          }
        }
      }
    },
    "verlauf.analysis.desc.pro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahnsinn! Du ziehst diese Gewohnheit extrem konstant durch. Das ist eine tief verankerte Routine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazing! You are performing this habit extremely consistently. It's a deeply rooted routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Locura! Haces este hábito de manera extremadamente constante. Ésta es una rutina profundamente arraigada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folie! Vous prenez cette habitude de manière extrêmement cohérente. Il s’agit d’une routine profondément enracinée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पागलपन! आप इस आदत को बेहद लगातार करते हैं। यह एक गहरी जड़ें जमा चुकी दिनचर्या है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Follia! Fai questa abitudine in modo estremamente coerente. Questa è una routine profondamente radicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "狂気！あなたはこの習慣を非常に一貫して行っています。これは深く根付いたルーチンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발광! 당신은 이 습관을 매우 지속적으로 수행합니다. 이것은 깊이 뿌리박힌 루틴입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekheid! Je voert deze gewoonte uiterst consequent uit. Dit is een diepgewortelde routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szaleństwo! Wykonujesz ten nawyk niezwykle konsekwentnie. To głęboko zakorzeniona rutyna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Loucura! Você pratica esse hábito de forma extremamente consistente. Esta é uma rotina profundamente arraigada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Loucura! Você pratica esse hábito de forma extremamente consistente. Esta é uma rotina profundamente arraigada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумасшествие! Вы практикуете эту привычку чрезвычайно последовательно. Это глубоко укоренившаяся рутина."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delilik! Bu alışkanlığı son derece tutarlı bir şekilde yapıyorsunuz. Bu derinlere yerleşmiş bir rutindir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疯狂！你非常坚持这个习惯。这是一个根深蒂固的惯例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瘋狂！你非常堅持這個習慣。這是一個根深蒂固的慣例。"
          }
        }
      }
    },
    "verlauf.analysis.desc.stable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist stetig dabei, auch wenn du nicht jeden Tag perfekt bist. Das ist genau der richtige Weg!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are making steady progress, even if you are not perfect every day. This is exactly the right path!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre estás ahí, incluso si no eres perfecto todos los días. ¡Esta es exactamente la manera correcta!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es toujours là, même si tu n'es pas parfait tous les jours. C'est exactement la bonne façon !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हमेशा वहाँ हैं, भले ही आप हर दिन परिपूर्ण न हों। यह बिल्कुल सही तरीका है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sempre lì, anche se non sei perfetto tutti i giorni. Questo è esattamente il modo giusto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たとえ毎日が完璧でなくても、あなたはいつもそこにいます。これはまさに正しい方法です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비록 당신이 매일 완벽하지는 않더라도 당신은 항상 거기에 있습니다. 이것이 바로 올바른 방법입니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent er altijd, ook al ben je niet elke dag perfect. Dit is precies de juiste manier!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze tam jesteś, nawet jeśli nie jesteś idealny na co dzień. To jest dokładnie właściwa droga!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está sempre presente, mesmo que não seja perfeito todos os dias. Este é exatamente o caminho certo!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está sempre presente, mesmo que não seja perfeito todos os dias. Este é exatamente o caminho certo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты всегда рядом, даже если ты не идеален каждый день. Это совершенно правильный путь!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün mükemmel olmasan bile her zaman oradasın. Bu tam olarak doğru yoldur!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使你每天并不完美，你始终都在。这才是正确的做法！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使你每天並不完美，你始終都在。這才是正確的做法！"
          }
        }
      }
    },

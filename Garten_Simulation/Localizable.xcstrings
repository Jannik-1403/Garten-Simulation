        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naci\u015bnij klawisz, aby z niego skorzysta\u0107!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca na chave para a usares!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043a\u043b\u044e\u0447, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak i\u00e7in tu\u015fa dokunun!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u94a5\u5319\u5373\u53ef\u4f7f\u7528\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u64ca\u6309\u9375\u5373\u53ef\u4f7f\u7528\u5b83\uff01"
          }
        }
      }
    },

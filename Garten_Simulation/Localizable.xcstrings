    "assessment.mental.profile.spiegel.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entkopple deinen Wert von der Meinung anderer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decouple your value from the opinions of others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacopla tu valor de las opiniones de los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découplez votre valeur des opinions des autres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने मूल्य को दूसरों की राय से अलग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disaccoppia il tuo valore dalle opinioni degli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の価値を他人の意見から切り離してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 가치를 다른 사람들의 의견과 분리하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontkoppel uw waarde van de mening van anderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddziel swoją wartość od opinii innych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe o seu valor das opiniões dos outros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдели свою ценность от мнения других."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerinizi başkalarının görüşlerinden ayırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的价值与他人的意见分开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將你的價值與他人的意見脫鉤。"
          }
        }
      }
    },

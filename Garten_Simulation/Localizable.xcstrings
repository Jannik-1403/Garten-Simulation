          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪い習慣"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁜 습관"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechte gewoonten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złe nawyki"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maus hábitos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kötü Alışkanlıklar"
          }
        }
      }
    },
    "tour_3_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze deine Coins für hilfreiche Power-Ups. Du findest hier Trash-Items für schlechte Gewohnheiten, aber du kannst dort auch Pflanzen kaufen, die deine normalen Gewohnheiten widerspiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your coins for helpful power-ups. You'll find trash items for bad habits here, but you can also buy plants that reflect your normal habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tus monedas para obtener potenciadores útiles. Encontrarás artículos de basura para los malos hábitos, pero también puedes comprar plantas que reflejen tus hábitos normales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez vos pièces pour des power-ups. Vous trouverez des déchets pour les mauvaises habitudes, mais vous pouvez aussi acheter des plantes pour vos bonnes habitudes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le tue monete per i power-up. Troverai spazzatura per le cattive abitudini, ma puoi anche comprare piante che riflettono le tue normali abitudini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コインを使って便利なパワーアップを手に入れましょう。悪い習慣のゴミアイテムもありますが、通常の習慣を反映した植物も買えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인을 사용하여 유용한 파워업을 얻으세요. 나쁜 습관을 위한 쓰레기 아이템도 있지만, 평소 습관을 반영하는 식물도 살 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je munten voor power-ups. Je vindt hier afval voor slechte gewoonten, maar je kunt ook planten kopen die je normale gewoonten weerspiegelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystaj swoje monety na ulepszenia. Znajdziesz tu śmieci dla złych nawyków, ale możesz też kupić rośliny odzwierciedlające twoje normalne nawyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use suas moedas para power-ups. Você encontrará lixo para maus hábitos, mas também pode comprar plantas que refletem seus hábitos normais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paralarınızı güçlendiriciler için kullanın. Kötü alışkanlıklar için çöp bulacaksınız, ancak normal alışkanlıklarınızı yansıtan bitkiler de satın alabilirsiniz."
          }
        }
      }
    },

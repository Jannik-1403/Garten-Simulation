    "assessment.lifestyle.q13": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du sprichst, was machen die Leute in deinem Umfeld?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you speak, what do the people around you do?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hablas, ¿qué hacen las personas que te rodean?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous parlez, que font les gens autour de vous ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando parli, cosa fanno le persone intorno a te?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが話しているとき、あなたの周りの人たちは何をしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 말할 때, 주변 사람들은 무엇을 합니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat doen de mensen om je heen als je spreekt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy mówisz, co robią ludzie wokół ciebie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você fala, o que as pessoas ao seu redor fazem?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz konuşurken çevrenizdeki insanlar ne yapıyor?"
          }
        }
      }
    },
    "assessment.lifestyle.q13.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie unterbrechen mich ständig oder schauen aufs Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They constantly interrupt me or look at my cell phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me interrumpen constantemente o miran mi celular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils m'interrompent constamment ou regardent mon téléphone portable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi interrompono costantemente o guardano il mio cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らは常に私の邪魔をしたり、私の携帯電話を見たりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들은 끊임없이 나를 방해하거나 내 휴대폰을 봅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze onderbreken me voortdurend of kijken naar mijn mobiele telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciągle mi przerywają lub patrzą na mój telefon komórkowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles constantemente me interrompem ou olham para o meu celular."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli sözümü kesiyorlar ya da cep telefonuma bakıyorlar."
          }
        }
      }
    },
    "assessment.lifestyle.q13.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hören halb zu, aber meine Meinung hat wenig Gewicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're half-listening, but my opinion carries little weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás escuchando a medias, pero mi opinión tiene poco peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous m'écoutez à moitié, mais mon avis n'a que peu de poids."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai ascoltando a metà, ma la mia opinione ha poco peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは半分聞いているようですが、私の意見にはほとんど重みがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 반만 듣고 있지만 내 의견은 별로 중요하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je luistert maar half, maar mijn mening heeft weinig gewicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częściowo słuchasz, ale moja opinia nie ma większego znaczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está ouvindo pela metade, mas minha opinião tem pouco peso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarı dinliyorsunuz ama benim fikrimin pek bir önemi yok."
          }
        }
      }
    },
    "assessment.lifestyle.q13.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hören normal zu, wie bei jedem anderen auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They listen normally, like everyone else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchan normalmente, como todos los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils écoutent normalement, comme tout le monde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascoltano normalmente, come tutti gli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らは他のみんなと同じように、普通に話を聞いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들은 다른 사람들처럼 정상적으로 듣습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze luisteren normaal, net als iedereen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchają normalnie, jak wszyscy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles ouvem normalmente, como todo mundo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes gibi normal bir şekilde dinlerler."
          }
        }
      }
    },
    "assessment.lifestyle.q13.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raum wird still und man achtet auf das, was ich sage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room becomes quiet and people pay attention to what I say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La habitación se queda en silencio y la gente presta atención a lo que digo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce devient silencieuse et les gens font attention à ce que je dis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stanza diventa silenziosa e le persone prestano attenzione a ciò che dico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋は静かになり、人々は私の言うことに注意を払います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방은 조용해지고 사람들은 내가 말하는 것에 주의를 기울입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt stil in de kamer en mensen letten op wat ik zeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pokoju robi się cicho i ludzie zwracają uwagę na to, co mówię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala fica silenciosa e as pessoas prestam atenção ao que eu digo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oda sessizleşiyor ve insanlar söylediklerime dikkat ediyor."
          }
        }
      }
    },
    "assessment.lifestyle.q14": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst eine mittelmäßige Note, schließt ein Projekt 'nur okay' ab oder bist mit deiner Form unzufrieden. Deine Reaktion?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get a mediocre grade, complete a project just okay, or are dissatisfied with your form. Your reaction?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtienes una calificación mediocre, completas un proyecto sin problemas o no estás satisfecho con tu formulario. ¿Tu reacción?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous obtenez une note médiocre, terminez un projet sans problème ou n'êtes pas satisfait de votre formulaire. Votre réaction ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un voto mediocre, completi un progetto senza problemi o sei insoddisfatto del tuo modulo. La tua reazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平凡な成績しか得られなかったり、プロジェクトをまあまあで完了したり、自分の成績に不満があったりします。あなたの反応は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 평범한 성적을 받았거나, 프로젝트를 괜찮게 완료했거나, 당신의 양식에 만족하지 못했습니다. 당신의 반응은?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je haalt een middelmatig cijfer, voltooit een project prima, of bent ontevreden over je formulier. Jouw reactie?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostajesz przeciętną ocenę, udaje Ci się ukończyć projekt albo jesteś niezadowolony ze swojej formy. Twoja reakcja?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você obtém uma nota medíocre, conclui um projeto corretamente ou está insatisfeito com seu formulário. Sua reação?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasat bir not alıyorsunuz, bir projeyi gayet iyi tamamlıyorsunuz veya formunuzdan memnun değilsiniz. Tepkiniz?"
          }
        }
      }
    },
    "assessment.lifestyle.q14.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich vergleiche mich mit denen, die noch schlechter waren, um mich besser zu fühlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I compare myself to those who were even worse in order to feel better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me comparo con aquellos que estaban aún peor para sentirme mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me compare à ceux qui ont été encore pires pour me sentir mieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi paragono a chi stava ancora peggio per sentirmi meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分を良くするために、さらに悪い人と自分を比較します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 기분이 나아지기 위해 더 나쁜 사람들과 나를 비교합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om me beter te voelen, vergelijk ik mezelf met degenen die nog slechter waren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównuję się do tych, którzy byli jeszcze gorsi, żeby poczuć się lepiej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me comparo com aqueles que foram ainda piores para me sentir melhor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha iyi hissetmek için kendimi daha da kötü olanlarla karşılaştırıyorum."
          }
        }
      }
    },
    "assessment.lifestyle.q14.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage 'Hauptsache bestanden' und vergesse es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say 'mainly passed' and forget about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo \"mayormente aprobado\" y lo olvido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dis « essentiellement réussi » et j’oublie ça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico \"principalmente superato\" e me ne dimentico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「主に合格しました」と言って忘れてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'주로 합격'이라고 말하고 잊어버립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg 'grotendeels geslaagd' en vergeet het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówię „głównie zdało” i zapominam o tym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu digo 'aprovado principalmente' e esqueço isso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Çoğunlukla geçti' diyorum ve unutuyorum."
          }
        }
      }
    },
    "assessment.lifestyle.q14.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ärgere mich kurz, belasse es aber dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get annoyed for a moment, but leave it at that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me enojo por un momento, pero déjalo así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'énerve un instant, mais reste-en là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un attimo mi arrabbio, ma lasciamo perdere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一瞬イラつきますが、そのままにしておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 짜증이 나지만 그만 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik irriteer me even, maar laat het daarbij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez chwilę się denerwuję, ale zostawmy to."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fico irritado por um momento, mas deixo por isso mesmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir an sinirleniyorum ama bırakalım."
          }
        }
      }
    },
    "assessment.lifestyle.q14.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich akzeptiere es absolut nicht. Ich analysiere den Fehler und erzwinge beim nächsten Mal Dominanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I absolutely do not accept it. I analyze the mistake and enforce dominance next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No lo acepto en absoluto. Analizo el error y hago cumplir el dominio la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne l'accepte absolument pas. J’analyse l’erreur et impose la domination la prochaine fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lo accetto assolutamente. Analizzo l'errore e impongo il dominio la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絶対に認めません。ミスを分析して、次回は優位性を強化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저는 절대 받아들이지 않습니다. 실수를 분석하고 다음 번에는 우위를 점합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik accepteer het absoluut niet. Ik analyseer de fout en dwing de volgende keer dominantie af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutnie tego nie akceptuję. Analizuję błąd i następnym razem wymuszam dominację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu absolutamente não aceito isso. Eu analiso o erro e imponho o domínio na próxima vez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle kabul etmiyorum. Hatayı analiz ediyorum ve bir dahaki sefere hakimiyeti uyguluyorum."
          }
        }
      }
    },
    "assessment.lifestyle.q15": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast große Pläne. Du erzählst deiner Familie/deinen Freunden davon. Wie reagieren sie?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have big plans. You tell your family/friends about it. How do they react?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes grandes planes. Se lo cuentas a tu familia/amigos. ¿Cómo reaccionan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez de grands projets. Vous en parlez à votre famille/amis. Comment réagissent-ils ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai grandi progetti. Ne parli alla tua famiglia/ai tuoi amici. Come reagiscono?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな計画があるのですね。あなたは家族や友人にそれについて話します。彼らはどう反応するでしょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 큰 계획을 가지고 있습니다. 당신은 당신의 가족/친구들에게 그것에 대해 이야기합니다. 그들은 어떻게 반응합니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt grootse plannen. Je vertelt het aan je familie/vrienden. Hoe reageren ze?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz wielkie plany. Mówisz o tym rodzinie/przyjaciołom. Jak reagują?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem grandes planos. Você conta para sua família/amigos sobre isso. Como eles reagem?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük planların var. Bunu ailenize/arkadaşlarınıza anlatırsınız. Nasıl tepki veriyorlar?"
          }
        }
      }
    },
    "assessment.lifestyle.q15.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie lachen mich aus oder sagen mir, ich soll realistisch bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They laugh at me or tell me to be realistic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ríen de mí o me dicen que sea realista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils se moquent de moi ou me disent d'être réaliste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridono di me o mi dicono di essere realistico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らは私を笑ったり、現実的になるように言います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들은 나를 비웃거나 나에게 현실적이라고 말합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze lachen me uit of zeggen dat ik realistisch moet zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śmieją się ze mnie lub mówią, żebym był realistą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles riem de mim ou me dizem para ser realista."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana gülüyorlar ya da gerçekçi olmamı söylüyorlar."
          }
        }
      }
    },
    "assessment.lifestyle.q15.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind gleichgültig und wechseln das Thema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are indifferent and change the subject."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran indiferentes y cambian de tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont indifférents et changent de sujet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono indifferenti e cambiano argomento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らは無関心で話題を変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들은 무관심하고 주제를 바꿉니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze zijn onverschillig en veranderen van onderwerp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są obojętni i zmieniają temat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles ficam indiferentes e mudam de assunto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtsız kalırlar ve konuyu değiştirirler."
          }
        }
      }
    },
    "assessment.lifestyle.q15.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wünschen mir viel Glück, helfen aber nicht aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They wish me good luck, but don't actively help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me desean buena suerte, pero no me ayudan activamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils me souhaitent bonne chance, mais ne m'aident pas activement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi augurano buona fortuna, ma non mi aiutano attivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らは私の幸運を祈っていますが、積極的には助けてくれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들은 나에게 행운을 빌지만 적극적으로 도와주지는 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze wensen me veel succes, maar helpen niet actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Życzą mi powodzenia, ale nie pomagają aktywnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles me desejam boa sorte, mas não ajudam ativamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana iyi şanslar diliyorlar ama aktif olarak yardım etmiyorlar."
          }
        }
      }
    },
    "assessment.lifestyle.q15.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie fragen sofort 'Wie können wir dir dabei helfen?' oder challengen den Plan konstruktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They immediately ask 'How can we help you with this?' or challenge the plan constructively."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente preguntan: '¿Cómo podemos ayudarle con esto?' o desafiar el plan de manera constructiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils demandent immédiatement : « Comment pouvons-nous vous aider ? » ou contester le plan de manière constructive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedono immediatamente \"Come possiamo aiutarti in questo?\" o sfidare il piano in modo costruttivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らはすぐに「これについてどうお手伝いできますか?」と尋ねます。または建設的に計画に異議を唱えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들은 즉시 '어떻게 도와드릴까요?'라고 묻습니다. 또는 건설적으로 계획에 도전하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze vragen meteen: 'Hoe kunnen we je hiermee helpen?' of daag het plan constructief uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast pytają: „Jak możemy Ci w tym pomóc?”. lub konstruktywnie kwestionuj plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles imediatamente perguntam 'Como podemos ajudá-lo com isso?' ou desafiar o plano de forma construtiva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen 'Bu konuda size nasıl yardımcı olabiliriz?' diye soruyorlar. veya plana yapıcı bir şekilde meydan okuyun."
          }
        }
      }
    },

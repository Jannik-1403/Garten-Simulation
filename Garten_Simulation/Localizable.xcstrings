    "assessment.health.q15.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich will eigentlich nur gut aussehen. Der Rest ist mir egal."
          }

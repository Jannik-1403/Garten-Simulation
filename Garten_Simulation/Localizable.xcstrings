    "prog_saving_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den heutigen Betrag physisch oder per Dauerauftrag beiseite. Behandle diese Einzahlung wie eine feste Rechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set aside today's amount physically or via standing order. Treat this deposit like a fixed invoice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve el monto de hoy físicamente o mediante orden permanente. Trate este depósito como una factura fija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez de côté le montant du jour physiquement ou par ordre permanent. Traitez cet acompte comme une facture fixe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की राशि भौतिक रूप से या स्थायी आदेश के माध्यम से अलग रखें। इस जमा राशि को एक निश्चित चालान की तरह समझें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti da parte l'importo odierno fisicamente o tramite ordine permanente. Tratta questo deposito come una fattura fissa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の金額を物理的に、またはスタンディングオーダーによって確保しておきます。このデポジットは定期請求書と同様に扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 금액을 물리적으로 또는 상시 명령을 통해 따로 보관해 두십시오. 이 보증금을 고정 송장처럼 취급하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het bedrag van vandaag fysiek of via een doorlopende opdracht opzij. Behandel deze aanbetaling als een vaste factuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłóż dzisiejszą kwotę fizycznie lub poprzez zlecenie stałe. Traktuj tę kaucję jak stałą fakturę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve o valor de hoje fisicamente ou por meio de ordem permanente. Trate este depósito como uma fatura fixa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve o valor de hoje fisicamente ou por meio de ordem permanente. Trate este depósito como uma fatura fixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложите сегодняшнюю сумму физически или посредством постоянного поручения. Относитесь к этому депозиту как к фиксированному счету."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün tutarını fiziki olarak veya emir yoluyla ayırın. Bu depozitoyu sabit bir fatura gibi değerlendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际或通过定期订单留出今天的金额。将这笔押金视为固定发票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際或透過定期訂單留出今天的金額。將這筆押金視為固定發票。"
          }
        }
      }
    },

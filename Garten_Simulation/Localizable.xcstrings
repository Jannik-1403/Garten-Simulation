    "settings.reset.final.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du dir GANZ sicher?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you absolutely sure?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfEst\u00e1s completamente seguro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Es-tu absolument s\u00fbr?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0924\u0941\u092e \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 ch\u1eafc\u0920\u0940\u0915 \u0939\u094b?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei assolutamente sicuro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d76\u5bfe\u306b\u9593\u9055\u3044\u3042\u308a\u307e\u305b\u3093\u304b\uff1f"

        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我今天休息。听从身体的声音也很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我今天休息一下。傾聽身體的聲音也很重要。"
          }
        }
      }
    },

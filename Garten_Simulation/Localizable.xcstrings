        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमानदारी से कहूं तो, मैं केवल इसलिए प्रशिक्षण लेता हूं ताकि अन्य लोगों को मैं आकर्षक लगें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad essere sincero, mi alleno solo perché gli altri mi trovino attraente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正直に言うと、私は他人に魅力的に思われるためにトレーニングしているだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "솔직히 말해서 나는 다른 사람들이 나를 매력적으로 느끼도록 훈련합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlijk gezegd train ik alleen zodat andere mensen mij aantrekkelijk vinden."

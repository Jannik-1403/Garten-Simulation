        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍 서비스는 노트북에서만 사용하세요 – 침대에 있는 TV에서는 안 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat streamingdiensten alleen op de laptop draaien – niet op de tv in bed."

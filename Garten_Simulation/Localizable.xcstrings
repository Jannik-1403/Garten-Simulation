    "trash.luxus_auto.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6sche Shopping-Apps und deaktiviere gespeicherte Zahlungsmethoden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete shopping apps and disable saved payment methods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las apps de compras y desactiva los m\u00e9todos de pago guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les applications de shopping et d\u00e9sactive les m\u00e9thodes de paiement enregistr\u00e9es."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0949\u092a\u093f\u0902\u0917 \u0910\u092a\u094d\u0938 \u0915\u094b \u0939\u091f\u093e\u090f\u0902 \u0914\u0930 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina le app di shopping e disabilita i metodi di pagamento salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u30a2\u30d7\u30ea\u3092\u524a\u9664\u3057\u3001\u4fdd\u5b58\u3055\u308c\u305f\u652f\u6255\u3044\u65b9\u6cd5\u3092\u7121\u52b9\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc1fc\ud551 \uc571\uc744 \uc0ad\uc81c\ud558\uace0 \uc800\uc7a5\ub41c \uacb0\uc81c \uc218\ub2e8\uc744 \ube44\ud65c\uc131\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder winkel-apps en schakel opgeslagen betaalmethoden uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usu\u0144 aplikacje zakupowe i wy\u0142\u0105cz zapisane metody p\u0142atno\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua apps de compras e desative m\u00e9todos de pagamento salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043e\u043a\u0443\u043f\u043e\u043a \u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043e\u043f\u043b\u0430\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Al\u0131\u015fveri\u015f uygulamalar\u0131n\u0131 sil ve kay\u0131tl\u0131 \u00f6deme y\u00f6ntemlerini devre d\u0131\u015f\u0131 b\u0131rak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5220\u9664\u8d2d\u7269\u5e94\u7528\u7a0b\u5e8f\u5e76\u7981\u7528\u5df2\u4fdd\u5b58\u7684\u4ed8\u6b3e\u65b9\u5f0f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u522a\u9664\u8cfc\u7269\u61c9\u7528\u7a0b\u5f0f\u4e26\u505c\u7528\u5df2\u5132\u5b58\u7684\u4ed8\u6b3e\u65b9\u5f0f\u3002"
          }
        }
      }
    },
    "trash.luxus_auto.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage dich: Kaufe ich das f\u00fcr mich \u2013 oder um anderen zu imponieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask yourself: am I buying this for me \u2013 or to impress others?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preg\u00fantate: \u00bfcompro esto para m\u00ed o para impresionar a los dem\u00e1s?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande-toi : est-ce que j'ach\u00e8te \u00e7a pour moi \u2013 ou pour impressionner les autres ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0947 \u092a\u0942\u091b\u094b: \u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u092f\u0939 \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0916\u0930\u0940\u0926 \u0930\u0939\u093e \u0939\u0942\u0901 \u2013 \u092f\u093e \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiediti: sto comprando questo per me \u2013 o per fare colpo sugli altri?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u554f\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306f\u81ea\u5206\u306e\u305f\u3081\u306b\u8cb7\u3046\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u4ed6\u4eba\u306b\u611f\u9298\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u8cb7\u3046\u306e\u304b\u3092\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\uc2a4\ub85c\uc5d0\uac8c \ubb3c\uc5b4\ubcf4\uc138\uc694: \ub098\ub97c \uc704\ud574 \uc0ac\ub294 \uac74\uac00\uc694 \u2013 \uc544\ub2c8\uba74 \ub0a8\uc5d0\uac8c \ubcf4\uc774\uae30 \uc704\ud574\uc11c\uc778\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag jezelf: koop ik dit voor mezelf \u2013 of om anderen onder de indruk te brengen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj siebie: czy kupuj\u0119 to dla siebie \u2013 czy \u017ceby zaimponowa\u0107 innym?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-se: estou comprando isso para mim \u2013 ou para impressionar os outros?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u0441\u0435\u0431\u044f: \u044f \u043f\u043e\u043a\u0443\u043f\u0430\u044e \u044d\u0442\u043e \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u0438\u043b\u0438 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendine sor: bunu kendim i\u00e7in mi al\u0131yorum \u2013 yoksa ba\u015fkalar\u0131n\u0131 etkilemek i\u00e7in mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95ee\u95ee\u81ea\u5df1\uff1a\u6211\u4e70\u8fd9\u4e2a\u662f\u4e3a\u4e86\u81ea\u5df1\uff0c\u8fd8\u662f\u4e3a\u4e86\u7ed9\u522b\u4eba\u7559\u4e0b\u6df1\u523b\u7684\u5370\u8c61\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u554f\u554f\u81ea\u5df1\uff1a\u6211\u8cb7\u9019\u500b\u662f\u70ba\u4e86\u81ea\u5df1\uff0c\u9084\u662f\u70ba\u4e86\u7d66\u5225\u4eba\u7559\u4e0b\u6df1\u523b\u7684\u5370\u8c61\uff1f"
          }
        }
      }
    },
    "trash.luxus_auto.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel: 72 Stunden warten bei jedem Kauf \u00fcber 50 Euro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule: wait 72 hours for every purchase over 50 euros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regla: espera 72 horas para cada compra superior a 50 euros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e8gle : attendre 72 heures pour tout achat de plus de 50 euros."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u092f\u092e: 50 \u092f\u0942\u0930\u094b \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u092a\u0930 72 \u0918\u0902\u091f\u0947 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola: aspetta 72 ore per ogni acquisto superiore a 50 euro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30eb\u30fc\u30eb\uff1a50\u30e6\u30fc\u30ed\u4ee5\u4e0a\u306e\u8cfc\u5165\u306f\u3059\u3079\u306672\u6642\u9593\u5f85\u3061\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uaddc\uce59: 50\uc720\ub85c \uc774\uc0c1 \uad6c\ub9e4 \uc2dc 72\uc2dc\uac04 \uae30\ub2e4\ub9ac\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel: 72 uur wachten bij elke aankoop boven de 50 euro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasada: czekaj 72 godziny przy ka\u017cdym zakupie powy\u017cej 50 euro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regra: espere 72 horas para cada compra acima de 50 euros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0430\u0432\u0438\u043b\u043e: \u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435 72 \u0447\u0430\u0441\u0430 \u043f\u0440\u0438 \u043f\u043e\u043a\u0443\u043f\u043a\u0435 \u043d\u0430 \u0441\u0443\u043c\u043c\u0443 \u0431\u043e\u043b\u0435\u0435 50 \u0435\u0432\u0440\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural: 50 euronun \u00fczerindeki her al\u0131\u015fveri\u015f i\u00e7in 72 saat bekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89c4\u5219\uff1a\u8d2d\u4e70\u8d85\u8fc7 50 \u6b27\u5143\u7684\u5546\u54c1\u9700\u7b49\u5f85 72 \u5c0f\u65f6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u898f\u5247\uff1a\u8cfc\u8cb7\u8d85\u904e 50 \u6b50\u5143\u7684\u5546\u54c1\u9700\u7b49\u5f85 72 \u5c0f\u6642\u3002"
          }
        }
      }
    },
    "trash.luxus_auto.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere jeden Luxuskauf \u2013 was hattest du davon nach einem Monat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down every luxury purchase \u2013 what did you get from it after a month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota cada compra de lujo: \u00bfqu\u00e9 obtuviste de ella despu\u00e9s de un mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note chaque achat de luxe \u2013 qu'est-ce que \u00e7a t'a apport\u00e9 apr\u00e8s un mois ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0932\u0915\u094d\u091c\u093c\u0930\u0940 \u0916\u0930\u0940\u0926 \u0915\u094b \u0928\u094b\u091f \u0915\u0930\u0947\u0902 \u2013 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u092c\u093e\u0926 \u0906\u092a\u0915\u094b \u0909\u0938\u0938\u0947 \u0915\u094d\u092f\u093e \u092e\u093f\u0932\u093e?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota ogni acquisto di lusso \u2013 cosa ne hai ottenuto dopo un mese?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u9ad8\u7d1a\u54c1\u306e\u8cfc\u5165\u3092\u66f8\u304d\u7559\u3081\u307e\u3057\u3087\u3046\u30021\u30f6\u6708\u5f8c\u3001\u305d\u308c\u306f\u4f55\u3092\u3082\u305f\u3089\u3057\u3066\u304f\u308c\u307e\u3057\u305f\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uba85\ud488 \uad6c\ub9e4\ub97c \uc801\uc5b4\ub450\uc138\uc694 \u2013 \ud55c \ub2ec \ud6c4\uc5d0 \ubb34\uc5c7\uc744 \uc5bb\uc5c8\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer elke luxe aankoop \u2013 wat heb je er na een maand van gehad?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj ka\u017cdy zakup luksusowy \u2013 co z tego mia\u0142e\u015b po miesi\u0105cu?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote cada compra de luxo \u2013 o que voc\u00ea obteve disso depois de um m\u00eas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0439\u0442\u0435 \u043a\u0430\u0436\u0434\u0443\u044e \u043f\u043e\u043a\u0443\u043f\u043a\u0443 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0440\u043e\u0441\u043a\u043e\u0448\u0438 \u2013 \u0447\u0442\u043e \u0432\u044b \u043e\u0442 \u043d\u0435\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u0441\u044f\u0446?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her l\u00fcks al\u0131\u015fveri\u015fi yaz \u2013 bir ay sonra bundan ne elde ettin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5199\u4e0b\u6bcf\u4e00\u6b21\u8d2d\u4e70\u7684\u5962\u4f88\u54c1\u2014\u2014\u4e00\u4e2a\u6708\u540e\u4f60\u4ece\u4e2d\u5f97\u5230\u4e86\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5beb\u4e0b\u6bcf\u4e00\u6b21\u8cfc\u8cb7\u7684\u5962\u4f88\u54c1\uff0d\u4e00\u500b\u6708\u5f8c\u5f9e\u4e2d\u5f97\u5230\u4e86\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "trash.luxus_auto.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Sinnlose Autofahrten)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Spazieren gehen)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u090f\u0902 (\u092c\u0947\u0915\u093e\u0930 \u0915\u0940 \u0917\u093e\u0921\u093c\u0940 \u091a\u0932\u093e\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0937\u094d\u091f\u093f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947, \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u090f\u0902, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0947\u0902)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0940 \u0938\u091c\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 (\u091a\u0932\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0932\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947, \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0418\u0437\u0431\u0430\u0432\u044c\u0442\u0435\u0441\u044c \u043e\u0442 \u0432\u0440\u0435\u0434\u043d\u043e\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 (\u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u043f\u043e\u0435\u0437\u0434\u043a\u0438 \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0435)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438: \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u044b \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043d\u0435\u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u041f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0445. \n3. \u0423\u0441\u043b\u043e\u0436\u043d\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0443: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0438\u0445 \u043e\u0442 \u0441\u0435\u0442\u0438). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0435\u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c: \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043a \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u044e. \n\n**\u0412\u044b\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 (\u043f\u043e\u0439\u0442\u0438 \u043d\u0430 \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0443)**\n1. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c: \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \n2. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u044d\u0442\u043e \u0441 \u0447\u0435\u043c-\u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \n3. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e: \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0441\u0435\u0433\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b). \n4. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u043c: \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0441\u0435\u0431\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Sinnlose Autofahrten)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Spazieren gehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u574f\u4e60\u60ef\uff08\u65e0\u610f\u4e49\u7684\u4e58\u8f66\uff09**\n1. \u9690\u5f62\uff1a\u5c06\u89e6\u53d1\u56e0\u7d20\u79fb\u51fa\u89c6\u91ce\u3002\n2. \u8ba9\u81ea\u5df1\u53d8\u5f97\u6ca1\u6709\u5438\u5f15\u529b\uff1a\u610f\u8bc6\u5230\u8d1f\u9762\u540e\u679c\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u56f0\u96be\uff1a\u8bbe\u7f6e\u969c\u788d\uff08\u4f8b\u5982\u5220\u9664\u5e94\u7528\u7a0b\u5e8f\u3001\u62d4\u6389\u63d2\u5934\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6ee1\u610f\uff1a\u9644\u52a0\u5211\u7f5a\u6267\u884c\u3002\n\n**\u5efa\u7acb\u4e00\u4e2a\u597d\u4e60\u60ef\uff08\u6563\u6b65\uff09**\n1. \u4f7f\u5176\u663e\u800c\u6613\u89c1\uff1a\u5c06\u89e6\u53d1\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u89c1\u7684\u4f4d\u7f6e\u3002\n2. \u8ba9\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c06\u5b83\u4e0e\u4f60\u559c\u6b22\u7684\u4e1c\u897f\u8054\u7cfb\u8d77\u6765\u3002\n3. \u8ba9\u5b83\u53d8\u5f97\u7b80\u5355\uff1a\u5c06\u969c\u788d\u51cf\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u949f\uff09\u3002\n4. \u8ba9\u5b83\u4ee4\u4eba\u6ee1\u610f\uff1a\u4e8b\u540e\u7acb\u5373\u5956\u52b1\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u6539\u6389\u58de\u7fd2\u6163\uff08\u7121\u610f\u7fa9\u7684\u4e58\u8eca\uff09**\n1. \u96b1\u5f62\uff1a\u5c07\u89f8\u767c\u56e0\u7d20\u79fb\u51fa\u8996\u91ce\u3002\n2. \u8b93\u81ea\u5df1\u8b8a\u5f97\u6c92\u6709\u5438\u5f15\u529b\uff1a\u610f\u8b58\u5230\u8ca0\u9762\u5f8c\u679c\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u56f0\u96e3\uff1a\u8a2d\u5b9a\u969c\u7919\uff08\u4f8b\u5982\u522a\u9664\u61c9\u7528\u7a0b\u5f0f\u3001\u62d4\u6389\u63d2\u982d\uff09\u3002\n4. \u4f7f\u5176\u4e0d\u4ee4\u4eba\u6eff\u610f\uff1a\u9644\u52a0\u5211\u7f70\u57f7\u884c\u3002\n\n**\u5efa\u7acb\u4e00\u500b\u597d\u7fd2\u6163\uff08\u6563\u6b65\uff09**\n1. \u4f7f\u5176\u986f\u800c\u6613\u898b\uff1a\u5c07\u89f8\u767c\u5668\u653e\u7f6e\u5728\u6e05\u6670\u53ef\u898b\u7684\u4f4d\u7f6e\u3002\n2. \u8b93\u5b83\u6709\u5438\u5f15\u529b\uff1a\u5c07\u5b83\u8207\u4f60\u559c\u6b61\u7684\u6771\u897f\u9023\u7d50\u8d77\u4f86\u3002\n3. \u8b93\u5b83\u8b8a\u5f97\u7c21\u55ae\uff1a\u5c07\u969c\u7919\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\uff08\u4f8b\u5982\u53ea\u9700 2 \u5206\u9418\uff09\u3002\n4. \u8b93\u5b83\u4ee4\u4eba\u6eff\u610f\uff1a\u4e8b\u5f8c\u7acb\u5373\u734e\u52f5\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "trash.luxus_uhr.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahre Klasse braucht keine Statussymbole \u2013 investiere lieber in Erlebnisse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True class needs no status symbols \u2013 invest in experiences instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verdadera clase no necesita s\u00edmbolos de estatus: invierte en experiencias en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vraie classe n'a pas besoin de symboles de statut - investissez plut\u00f4t dans des exp\u00e9riences."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u091a\u094d\u091a\u0940 \u0936\u093e\u0928 \u0915\u094b \u0915\u093f\u0938\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u092a\u094d\u0930\u0924\u0940\u0915\u094b\u0902 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940 \u2013 \u092c\u0947\u0939\u0924\u0930 \u0939\u0948 \u0915\u093f \u0905\u0928\u0941\u092d\u0935\u094b\u0902 \u092e\u0947\u0902 \u0928\u093f\u0935\u0947\u0936 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vera classe non ha bisogno di simboli di status: investi invece in esperienze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u7269\u306e\u54c1\u683c\u306b\u30b9\u30c6\u30fc\u30bf\u30b9\u30b7\u30f3\u30dc\u30eb\u306f\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u3002\u4ee3\u308f\u308a\u306b\u7d4c\u9a13\u306b\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\uc815\ud55c \ud488\uaca9\uc5d0\ub294 \uc9c0\uc704 \uc0c1\uc9d5\uc774 \ud544\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub300\uc2e0 \uacbd\ud5d8\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ware klasse heeft geen statussymbolen nodig - investeer in plaats daarvan in ervaringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawdziwa klasa nie potrzebuje symboli statusu \u2013 inwestuj raczej w prze\u017cycia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verdadeira classe n\u00e3o precisa de s\u00edmbolos de status \u2013 invista em experi\u00eancias em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0442\u0438\u043d\u043d\u043e\u043c\u0443 \u043a\u043b\u0430\u0441\u0441\u0443 \u043d\u0435 \u043d\u0443\u0436\u043d\u044b \u0441\u0438\u043c\u0432\u043e\u043b\u044b \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u2014 \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0432 \u043e\u043f\u044b\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger\u00e7ek s\u0131n\u0131f stat\u00fc sembollerine ihtiya\u00e7 duymaz - bunun yerine deneyimlere yat\u0131r\u0131m yap\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u771f\u6b63\u7684\u9636\u7ea7\u4e0d\u9700\u8981\u5730\u4f4d\u8c61\u5f81\u2014\u2014\u800c\u662f\u6295\u8d44\u4e8e\u4f53\u9a8c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u771f\u6b63\u7684\u968e\u7d1a\u4e0d\u9700\u8981\u5730\u4f4d\u8c61\u5fb5\u2500\u2500\u800c\u662f\u6295\u8cc7\u65bc\u9ad4\u9a57\u3002"
          }
        }
      }
    },
    "trash.luxus_uhr.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Statussymbole kaufen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u0938\u094d\u0925\u093f\u0924\u093f \u092a\u094d\u0930\u0924\u0940\u0915 \u0916\u0930\u0940\u0926\u0928\u093e) \u0906\u092a\u0915\u094b \u0932\u0902\u092c\u0940 \u0905\u0935\u0927\u093f \u092e\u0947\u0902 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u043f\u043e\u043a\u0443\u043f\u043a\u0430 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432 \u0441\u0442\u0430\u0442\u0443\u0441\u0430) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Statussymbole kaufen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u8d2d\u4e70\u5730\u4f4d\u8c61\u5f81\uff09\u4f1a\u8017\u8d39\u4f60\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u8cfc\u8cb7\u5730\u4f4d\u8c61\u5fb5\uff09\u6703\u8017\u8cbb\u4f60\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },

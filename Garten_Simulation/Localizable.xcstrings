    "plant.sonnenblume.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte früh und voller Energie in den neuen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start early and full of energy into the new day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza temprano y lleno de energía el nuevo día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez tôt et plein d'énergie dans la nouvelle journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए दिन की शुरुआत जल्दी और ऊर्जा से करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia presto e pieno di energia la nuova giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早く、エネルギーに満ちた新しい一日を始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 일어나 에너지 넘치는 새로운 하루를 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin vroeg en vol energie aan de nieuwe dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij wcześnie i pełen energii nowy dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece cedo e cheio de energia no novo dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece cedo e cheio de energia no novo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинай новый день рано и с полным энергией."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni güne erken ve enerji dolu başlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早起，充满活力地开始新的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早點開始新的一天，充滿活力。"
          }
        }

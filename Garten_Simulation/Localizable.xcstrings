    "assessment.growth.profile.traeumer.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich 24 Stunden lang mit niemandem über eine neue Idee, bevor du nicht den allerersten Schritt getan hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't talk to anyone about a new idea for 24 hours until you've taken the very first step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hables con nadie sobre una nueva idea durante 24 horas hasta que hayas dado el primer paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne parlez à personne d'une nouvelle idée pendant 24 heures jusqu'à ce que vous ayez fait le tout premier pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी नए विचार के बारे में 24 घंटे तक किसी से बात न करें जब तक कि आप पहला कदम न उठा लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non parlare con nessuno di una nuova idea per 24 ore finché non hai fatto il primo passo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の一歩を踏み出すまで、24 時間は新しいアイデアについて誰にも話さないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 단계를 밟을 때까지 24시간 동안 누구에게도 새로운 아이디어에 대해 이야기하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praat 24 uur lang met niemand over een nieuw idee voordat je de allereerste stap hebt gezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie rozmawiaj z nikim o nowym pomyśle przez 24 godziny, dopóki nie zrobisz pierwszego kroku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não fale com ninguém sobre uma nova ideia por 24 horas antes de dar o primeiro passo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не говори ни с кем о новой идее в течение 24 часов, пока не сделаешь первый шаг."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk adımı atana kadar 24 saat boyunca yeni bir fikir hakkında kimseyle konuşmayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你迈出第一步之前，不要与任何人谈论一个新想法，持续24小时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在踏出第一步之前，24 小時內不要與任何人談論新想法。"
          }
        }
      }
    },
    "assessment.growth.profile.traeumer.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe jeden Abend nur EINE einzige kleine Aufgabe für den nächsten Tag auf ein Post-it."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every evening, write just ONE small task for the next day on a post-it note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las noches, escribe solo UNA pequeña tarea para el día siguiente en una nota adhesiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque soir, écrivez UNE seule petite tâche pour le lendemain sur un post-it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर शाम, पोस्ट-इट नोट पर अगले दिन के लिए केवल एक छोटा सा कार्य लिखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni sera, scrivi solo UNA piccola attività per il giorno successivo su un post-it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎晩、ポストイットに翌日の小さなタスクを 1 つだけ書きます。"

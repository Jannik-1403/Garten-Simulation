    "prog_sleep_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies ein Buch (Fiction, kein Business-Buch) oder höre ruhige Musik in der letzten Stunde vor dem Bett. Kein Screen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a book (fiction, not a business book) or listen to calm music in the last hour before bed. No screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lea un libro (de ficción, no de negocios) o escuche música tranquila en la última hora antes de acostarse. Sin pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez un livre (de fiction, pas un livre d'affaires) ou écoutez de la musique calme la dernière heure avant de vous coucher. Pas d'écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले आखिरी घंटे में कोई किताब पढ़ें (काल्पनिक, व्यावसायिक किताब नहीं) या शांत संगीत सुनें। कोई स्क्रीन नहीं."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi un libro (narrativa, non un libro di affari) o ascolta musica tranquilla nell'ultima ora prima di andare a letto. Nessuno schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝前の最後の 1 時間には、本 (ビジネス書ではなくフィクション) を読むか、穏やかな音楽を聴きます。画面がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자리에 들기 전 마지막 시간에는 책(비즈니스 서적이 아닌 소설)을 읽거나 차분한 음악을 들어보세요. 화면이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees een boek (fictie, geen zakelijk boek) of luister naar rustige muziek in het laatste uur voor het slapengaan. Geen scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ostatniej godzinie przed snem przeczytaj książkę (beletrystyczną, nie biznesową) lub posłuchaj spokojnej muzyki. Brak ekranu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia um livro (ficção, não um livro de negócios) ou ouça uma música calma na última hora antes de dormir. Sem tela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia um livro (ficção, não um livro de negócios) ou ouça uma música calma na última hora antes de dormir. Sem tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В последний час перед сном почитайте книгу (художественную, а не бизнес-книгу) или послушайте спокойную музыку. Нет экрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan önceki son saatte bir kitap okuyun (kurgu, iş kitabı değil) veya sakin müzik dinleyin. Ekran yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在睡前的最后一个小时读一本书（小说，而不是商业书籍）或听平静的音乐。没有屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在睡前的最後一小時讀一本書（小說，而不是商業書籍）或聽平靜的音樂。沒有螢幕。"
          }
        }
      }
    },

    "trash.lootbox_zockerabo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere In-App-Käufe in den Einstellungen deines Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable in-app purchases in your phone's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las compras dentro de la aplicación en los ajustes de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive les achats intégrés dans les paramètres de ton téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फोन की सेटिंग्स में इन-ऐप खरीदारी अक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabilita gli acquisti in-app nelle impostazioni del tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯のアプリ内購入を設定でオフにしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 설정에서 인앱 구매를 비활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel in-app-aankopen uit in de instellingen van je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz zakupy w aplikacji w ustawieniach telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative as compras no aplicativo nas configurações do seu celular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative as compras no aplicativo nas configurações do seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите встроенные покупки в настройках телефона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ayarlarından uygulama içi satın alımları devre dışı bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机设置中禁用应用内购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機設定中停用應用程式內購買。"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lootboxen sind psychologisch Glücksspiel – und du verlierst langfristig immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot boxes are psychologically gambling – and you always lose in the long run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cajas de botín son psicológicamente juego de azar: y siempre pierdes a largo plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les loot boxes sont psychologiquement des jeux de hasard – et tu perds toujours à long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लूटबॉक्स मनोवैज्ञानिक जुआ हैं – और आप लंबी अवधि में हमेशा हारते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le loot box sono psicologicamente gioco d'azzardo – e a lungo termine perdi sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートボックスは心理的にギャンブルです。長期的には常に負けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트박스는 심리적으로 도박입니다 – 장기적으로는 항상 집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lootboxen zijn psychologisch gezien gokken – en op de lange termijn verlies je altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lootboxy są psychologicznie hazardem – i długoterminowo zawsze przegrywasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot boxes são psicologicamente um jogo de azar – e você sempre perde a longo prazo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot boxes são psicologicamente um jogo de azar – e você sempre perde a longo prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лутбоксы психологически азартны, и в долгосрочной перспективе вы всегда проигрываете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loot box'lar psikolojik olarak kumardır – ve uzun vadede her zaman kaybedersiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "战利品箱在心理上是赌博——从长远来看你总是会输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戰利品箱在心理上是賭博——從長遠來看你總是會輸。"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze dir ein monatliches Gaming-Budget – und halte es schriftlich fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set yourself a monthly gaming budget – and put it in writing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece un presupuesto mensual para juegos y ponlo por escrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe-toi un budget mensuel de jeu – et mets-le par écrit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लिए एक मासिक गेमिंग बजट तय करें – और इसे लिखित रूप में रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisci un budget mensile per il gaming – e mettilo per iscritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月々のゲームの予算を決めましょう。それを書面にしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 게임 예산을 설정하세요 – 그리고 서면으로 기록하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een maandelijks gamingbudget in – en leg dit schriftelijk vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustal miesięczny budżet na gaming – i zapisz go na piśmie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um orçamento mensal para jogos – e coloque por escrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um orçamento mensal para jogos – e coloque por escrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите ежемесячный игровой бюджет и запишите его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık oyun bütçesi belirle – ve bunu yazılı olarak kaydet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定每月游戏预算 - 并将其写下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定每月遊戲預算 - 並將其寫下來。"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechne aus: Was hast du dieses Jahr für In-App-Käufe ausgegeben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate: how much have you spent on in-app purchases this year?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula: ¿cuánto has gastado en compras dentro de la aplicación este año?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule: combien as-tu dépensé en achats intégrés cette année ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गणना करो: इस साल आपने इन-एप खरीदारी पर कितना खर्च किया?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola: quanto hai speso in acquisti in-app quest'anno?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算してみましょう。今年のアプリ内購入にいくら使いましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산해 보세요: 올해 인앱 구매에 얼마를 썼나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken: hoeveel heb je dit jaar uitgegeven aan in-app-aankopen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblicz: ile wydałeś w tym roku na zakupy w aplikacji?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule: quanto você gastou em compras no aplicativo este ano?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule: quanto você gastou em compras no aplicativo este ano?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитайте: сколько вы потратили на внутриигровые покупки в этом году?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapla: bu yıl uygulama içi satın alımlara ne kadar harcadın?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算：今年您在应用内购买上花了多少钱？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算：今年您在應用程式內購買上花了多少錢？"
          }
        }
      }
    },
    "trash.lootbox_zockerabo.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Glücksspiel/Lootboxen)**\n1. Unsichtbar machen: Entferne die Auslöser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue Hürden ein (z.B. Apps löschen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausführung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Sparen)**\n1. Offensichtlich machen: Platziere den Auslöser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die Hürden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Gambling/Lootboxes)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Saving)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina el mal hábito (Apuestas/cajas de botín)**\n1. Hazlo invisible: Elimina los desencadenantes de tu campo de visión.\n2. Hazlo poco atractivo: Sé consciente de las consecuencias negativas.\n3. Hazlo difícil: Añade obstáculos (p. ej. elimina apps, desconecta el enchufe).\n4. Hazlo insatisfactorio: Vincula la acción a un castigo.\n\n**Establece el buen hábito (Ahorrar)**\n1. Hazlo evidente: Coloca el desencadenante bien visible.\n2. Hazlo atractivo: Asócialo con algo que te guste.\n3. Hazlo fácil: Reduce los obstáculos al mínimo (p. ej. solo 2 minutos).\n4. Hazlo satisfactorio: Recompénsate justo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Se débarrasser de la mauvaise habitude (Jeux d'argent/Loot boxes)**\n1. La rendre invisible : Retire les déclencheurs de ton champ de vision.\n2. La rendre peu attirante : Prends conscience des conséquences négatives.\n3. La rendre difficile : Ajoute des obstacles (par ex. supprime des applis, débranche la prise).\n4. La rendre insatisfaisante : Associe l'action à une sanction.\n\n**Mettre en place la bonne habitude (Épargner)**\n1. La rendre évidente : Place le déclencheur bien en vue.\n2. La rendre attirante : Associe-la à quelque chose que tu aimes.\n3. La rendre facile : Réduis les obstacles au minimum (par ex. seulement 2 minutes).\n4. La rendre satisfaisante : Récompense-toi juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**खराब आदत समाप्त करना (जुआ/लूटबॉक्स)**\n1. अदृश्य बनाएं: अपने दृश्य क्षेत्र से ट्रिगर्स हटा दें।\n2. अप्रिय बनाएं: नकारात्मक परिणामों से अवगत हों।\n3. कठिन बनाएं: बाधाएं डालें (जैसे ऐप्स हटाना, प्लग निकालना)।\n4. असंतोषजनक बनाएं: क्रियान्वयन को दंड से जोड़ें।\n\n**अच्छी आदत स्थापित करना (बचत करना)**\n1. स्पष्ट बनाएं: ट्रिगर को अच्छी तरह से दिखाई देने वाले स्थान पर रखें।\n2. आकर्षक बनाएं: इसे किसी ऐसी चीज से जोड़ें जो आपको पसंद हो।\n3. आसान बनाएं: बाधाओं को न्यूनतम तक घटाएं (जैसे केवल 2 मिनट)।\n4. संतोषजनक बनाएं: इसके तुरंत बाद स्वयं को पुरस्कार दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina la cattiva abitudine (Gioco d'azzardo/Lootbox)**\n1. Rendila invisibile: Rimuovi i trigger dal tuo campo visivo.\n2. Rendila poco attraente: Prendi consapevolezza delle conseguenze negative.\n3. Rendila difficile: Aggiungi ostacoli (es. elimina le app, stacca la spina).\n4. Rendila insoddisfacente: Collega l'azione a una punizione.\n\n**Stabilisci la buona abitudine (Risparmiare)**\n1. Rendila evidente: Posiziona il trigger ben visibile.\n2. Rendila attraente: Associala a qualcosa che ti piace.\n3. Rendila facile: Riduci gli ostacoli al minimo (es. solo 2 minuti).\n4. Rendila soddisfacente: Premiati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**悪い習慣（ギャンブル/戦利品ボックス）を取り除く**\n1. 目に見えないようにする: トリガーを視界から取り除きます。\n2. 自分自身を魅力的でなくする: マイナスの結果に注意してください。\n3. 難しくする: ハードルを設定します (例: アプリを削除する、プラグを抜く)。\n4. 満足できないものにする: 処刑にペナルティを付けます。\n\n**良い習慣（節約）を確立する**\n1. わかりやすいようにする: トリガーをはっきりと見えるように配置します。\n2. 魅力的にする: 好きなものと関連付けます。\n3. シンプルにする: ハードルを最小限に抑えます (例: わずか 2 分)。\n4. 満足のいくものにする: 終わったらすぐに自分にご褒美をあげましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**나쁜 습관 버리기(도박/전리품 상자)**\n1. 보이지 않게 만들기: 시야에서 트리거를 제거합니다.\n2. 자신을 매력적이지 않게 만드세요. 부정적인 결과를 염두에 두세요.\n3. 어렵게 만들기: 장애물을 설정합니다(예: 앱 삭제, 플러그 뽑기).\n4. 불만족스럽게 만들기: 처형에 벌금을 부과합니다.\n\n**좋은 습관을 들이세요(절약)**\n1. 명확하게 만드십시오: 트리거를 명확하게 보이도록 배치하십시오.\n2. 매력적으로 만드십시오: 당신이 좋아하는 것과 연관시키십시오.\n3. 단순하게 만드세요. 장애물을 최소한으로 줄이세요(예: 단 2분).\n4. 만족스러운 일을 하십시오: 직후에 자신에게 보상하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slechte gewoonte afleren (Gokken/Loot boxes)**\n1. Onzichtbaar maken: Verwijder de triggers uit je blikveld.\n2. Onaantrekkelijk maken: Word je bewust van de negatieve gevolgen.\n3. Moeilijk maken: Bouw obstakels in (bijv. apps verwijderen, stekker eruit trekken).\n4. Onbevredigend maken: Koppel de handeling aan een straf.\n\n**Goede gewoonte opbouwen (Sparen)**\n1. Duidelijk maken: Plaats de trigger goed zichtbaar.\n2. Aantrekkelijk maken: Koppel het aan iets wat je leuk vindt.\n3. Makkelijk maken: Beperk de obstakels tot een minimum (bijv. slechts 2 minuten).\n4. Bevredigend maken: Beloon jezelf direct daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pozbądź się złego nawyku (hazard/skrzynki z łupami)**\n1. Uczyń niewidzialnym: Usuń wyzwalacze z pola widzenia.\n2. Stań się nieatrakcyjny: bądź świadomy negatywnych konsekwencji.\n3. Utrudnij to: ustaw przeszkody (np. usuń aplikacje, odłącz).\n4. Spraw, aby było to niezadowalające: Połącz egzekucję z karą.\n\n**Wypracuj dobry nawyk (oszczędzanie)**\n1. Spraw, aby było to oczywiste: umieść spust w dobrze widocznym miejscu.\n2. Spraw, aby było atrakcyjne: skojarz to z czymś, co lubisz.\n3. Uprość sprawę: ogranicz przeszkody do minimum (np. tylko 2 minuty).\n4. Spraw, aby było to satysfakcjonujące: natychmiast po tym nagradzaj siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Livre-se de um mau hábito (jogos/caixas de saque)**\n1. Tornar invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-se pouco atraente: Esteja ciente das consequências negativas.\n3. Dificulte: estabeleça obstáculos (por exemplo, excluir aplicativos, desconectar).\n4. Torne-o insatisfatório: anexe a execução a uma penalidade.\n\n**Estabeleça um bom hábito (economizar)**\n1. Deixe isso óbvio: coloque o gatilho claramente visível.\n2. Torne-o atraente: associe-o a algo que você gosta.\n3. Simplifique: reduza os obstáculos ao mínimo (por exemplo, apenas 2 minutos).\n4. Torne-o satisfatório: recompense-se imediatamente depois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimine o mau hábito (Apostas/Loot boxes)**\n1. Torne-o invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-o pouco atraente: Conscientize-se das consequências negativas.\n3. Torne-o difícil: Crie obstáculos (ex.: exclua apps, desligue a tomada).\n4. Torne-o insatisfatório: Associe a ação a uma punição.\n\n**Estabeleça o bom hábito (Economizar)**\n1. Torne-o evidente: Coloque o gatilho bem visível.\n2. Torne-o atraente: Associe-o a algo que você gosta.\n3. Torne-o fácil: Reduza os obstáculos ao mínimo (ex.: apenas 2 minutos).\n4. Torne-o satisfatório: Recompense-se logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Избавьтесь от вредной привычки (азартные игры/лутбоксы)**\n1. Сделайте невидимыми: уберите триггеры из поля зрения. \n2. Сделайте себя непривлекательным. Помните о негативных последствиях. \n3. Усложните задачу: установите препятствия (например, удалите приложения, отключите их от сети). \n4. Сделайте его неудовлетворительным: прикрепите исполнение к наказанию. \n\n**Выработайте хорошую привычку (экономия)**\n1. Сделайте это очевидным: разместите триггер на видном месте. \n2. Сделайте это привлекательным. Свяжите это с чем-то, что вам нравится. \n3. Сделайте это просто: сократите препятствия до минимума (например, всего 2 минуты). \n4. Сделайте это приятным: вознаградите себя сразу после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kötü bir alışkanlıktan kurtulun (kumar/ganimet kutuları)**\n1. Görünmez kılın: Tetikleyicileri görüş alanınızdan kaldırın.\n2. Kendinizi çekici olmaktan çıkarın: Olumsuz sonuçların farkında olun.\n3. Zorlaştırın: Engeller koyun (ör. uygulamaları silin, fişi çekin).\n4. Yetersiz hale getirin: İnfazı cezaya ekleyin.\n\n**İyi bir alışkanlık edinin (tasarruf)**\n1. Açıkça belirtin: Tetiği açıkça görülebilecek şekilde yerleştirin.\n2. Çekici hale getirin: Onu sevdiğiniz bir şeyle ilişkilendirin.\n3. Basitleştirin: Engelleri en aza indirin (örneğin sadece 2 dakika).\n4. Tatmin edici hale getirin: Hemen ardından kendinizi ödüllendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉坏习惯（赌博/战利品箱）**\n1. 隐形：将触发因素移出视野。\n2. 让自己变得没有吸引力：意识到负面后果。\n3. 让它变得困难：设置障碍（例如删除应用程序、拔掉插头）。\n4. 使其不令人满意：附加刑罚执行。\n\n**建立一个好习惯（储蓄）**\n1. 使其显而易见：将触发器放置在清晰可见的位置。\n2. 让它有吸引力：将它与你喜欢的东西联系起来。\n3. 让它变得简单：将障碍减少到最低限度（例如只需 2 分钟）。\n4. 让它令人满意：事后立即奖励自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉壞習慣（賭博/戰利品箱）**\n1. 隱形：將觸發因素移出視野。\n2. 讓自己變得沒有吸引力：意識到負面後果。\n3. 讓它變得困難：設定障礙（例如刪除應用程式、拔掉插頭）。\n4. 使其不令人滿意：附加刑罰執行。\n\n**建立一個好習慣（儲蓄）**\n1. 使其顯而易見：將觸發器放置在清晰可見的位置。\n2. 讓它有吸引力：將它與你喜歡的東西連結起來。\n3. 讓它變得簡單：將障礙減少到最低限度（例如只需 2 分鐘）。\n4. 讓它令人滿意：事後立即獎勵自己。"
          }
        }
      }
    },
    "trash.luxus_auto.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescheidenheit zahlt sich aus: Spare dein Geld statt es für Status zu verschwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modesty pays off: Save your money instead of wasting it on status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La modestia vale la pena: Ahorra tu dinero en lugar de desperdiciarlo en estatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modestie paie: Économise ton argent au lieu de le gaspiller pour le statut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विनम्रता का फल मिलता है: अपने पैसे बचाओ बजाय इसे स्थिति के लिए व्यर्थ खर्च करने के।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modestia ripaga: Risparmia i tuoi soldi invece di sprecarli per lo status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "謙虚さは報われます。ステータスの無駄遣いをやめて、お金を節約しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겸손함은 보상을 받습니다. 지위에 돈을 낭비하지 말고 저축하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescheidenheid loont: Bespaar je geld in plaats van het te verspillen aan status."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skromność popłaca: Oszczędzaj pieniądze zamiast marnować je na status."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A modéstia compensa: Economize seu dinheiro em vez de desperdiçá-lo com status."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A modéstia compensa: Economize seu dinheiro em vez de desperdiçá-lo com status."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смирение окупается: экономьте свои деньги, а не тратьте их на статус."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tevazu kazandırır: Paranı statü için harcamak yerine biriktir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谦逊是有回报的：省钱而不是把钱浪费在地位上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謙遜是有回報的：省錢而不是把錢浪費在地位上。"
          }
        }
      }
    },
    "trash.luxus_auto.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Sinnlose Autofahrten) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Pointless drives) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Viajes en coche sin sentido) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Trajets en voiture inutiles) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (बेकार की गाड़ी चलाना) आपको दीर्घकाल में ऊर्जा, समय और पैसा खर्च कराती है। यह आपको अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Giri in auto senza scopo) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（無意味な車の移動）は、長期的にはエネルギー、時間、お金を費やします。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(무의미한 자동차 여행)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (Zinloze autoritjes) kost je op lange termijn energie, tijd en geld. Het weerhoudt je ervan je volledige potentieel te benutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (bezsensowne podróże samochodem) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Viagens de carro sem sentido) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Passeios de carro sem sentido) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (бессмысленные поездки на автомобиле) в долгосрочной перспективе отнимает у вас энергию, время и деньги. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (anlamsız araba yolculukları) uzun vadede enerjiye, zamana ve paraya mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（毫无意义的汽车旅行）会消耗您的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，這種習慣（毫無意義的汽車旅行）會消耗您的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

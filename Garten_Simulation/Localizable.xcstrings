    "settings.reset.final.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ist dann unwiderruflich weg. Die App startet danach komplett neu mit dem Onboarding."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything will be gone forever. The app will restart from the onboarding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo desaparecer\u00e1 para siempre. La aplicaci\u00f3n se reiniciar\u00e1 desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout dispara\u00eetra pour toujours. L'application red\u00e9marrera depuis le d\u00e9but."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092c \u0915\u0941\u091b \u0924\u092c \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u091a\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0910\u092a \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0928\u090f \u0938\u093f\u0930\u0947 \u0938\u0947 \u0911\u0928\u092c\u094b\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u0947 \u0938\u093e\u0925 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto andr\u00e0 perso per sempre. L'app si riavvier\u00e0 dall'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306f\u6c38\u9060\u306b\u6d88\u3048\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u30a2\u30d7\u30ea\u306f\u30aa\u30f3\u30dc\u30fc\u30c7\u30a3\u30f3\u30b0\u304b\u3089\u518d\u8d77\u52d5\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uac83\uc774 \uc601\uc6d0\ud788 \uc0ac\ub77c\uc9c8 \uac83\uc785\ub2c8\ub2e4. \uc628\ubcf4\ub529\ubd80\ud130 \uc571\uc774 \ub2e4\uc2dc \uc2dc\uc791\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles zal voor altijd verdwenen zijn. De app wordt opnieuw opgestart vanaf de onboarding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zniknie na zawsze. Aplikacja uruchomi si\u0119 ponownie po wej\u015bciu na pok\u0142ad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo desaparecer\u00e1 para sempre. A aplica\u00e7\u00e3o ser\u00e1 reiniciada desde o in\u00edcio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0437\u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043d\u043e \u043f\u043e\u0442\u0435\u0440\u044f\u043d\u043e. \u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0441\u044f \u0441 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her \u015fey sonsuza dek yok olacak. Uygulama, kat\u0131l\u0131mdan sonra yeniden ba\u015flat\u0131lacakt\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

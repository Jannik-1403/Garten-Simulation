          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完璧主義を避けてください。80%完成は0%完璧より優れています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽주의를 피하세요. 80% 완성이 0% 완벽보다 낫습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd perfectionisme. 80% gedaan is beter dan 0% perfect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj perfekcjonizmu. 80% zrobione jest lepsze niż 0% perfekcyjne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita o perfeccionismo. 80% feito é melhor do que 0% perfeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita o perfeccionismo. 80% feito é melhor do que 0% perfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегай перфекционизма. 80% сделано лучше, чем 0% идеально."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

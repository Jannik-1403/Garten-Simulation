    "trash.binge_streaming.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Streaming-Dienste nur auf dem Laptop laufen \u2013 nicht auf dem TV im Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only run streaming services on the laptop \u2013 not on the TV in bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza los servicios de streaming solo en el port\u00e1til, no en la televisi\u00f3n en la cama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fais tourner les services de streaming que sur l'ordinateur portable \u2013 pas sur la TV au lit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u091f\u094d\u0930\u0940\u092e\u093f\u0902\u0917 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u094b \u0915\u0947\u0935\u0932 \u0932\u0948\u092a\u091f\u0949\u092a \u092a\u0930 \u091a\u0932\u093e\u090f\u0902 \u2013 \u092c\u093f\u0938\u094d\u0924\u0930 \u092e\u0947\u0902 \u091f\u0940\u0935\u0940 \u092a\u0930 \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i servizi di streaming solo sul laptop \u2013 non sulla TV a letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u306f\u30e9\u30c3\u30d7\u30c8\u30c3\u30d7\u3060\u3051\u3067\u898b\u307e\u3057\u3087\u3046\u3002\u30d9\u30c3\u30c9\u306e\u30c6\u30ec\u30d3\u3067\u306f\u898b\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud2b8\ub9ac\ubc0d \uc11c\ube44\uc2a4\ub294 \ub178\ud2b8\ubd81\uc5d0\uc11c\ub9cc \uc0ac\uc6a9\ud558\uc138\uc694 \u2013 \uce68\ub300\uc5d0 \uc788\ub294 TV\uc5d0\uc11c\ub294 \uc548 \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat streamingdiensten alleen op de laptop draaien \u2013 niet op de tv in bed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj serwisy streamingowe tylko na laptopie \u2013 nie na telewizorze w \u0142\u00f3\u017cku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use servi\u00e7os de streaming apenas no laptop \u2013 n\u00e3o na TV na cama."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0439\u0442\u0435 \u043f\u043e\u0442\u043e\u043a\u043e\u0432\u044b\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0441\u0432\u043e\u0435\u043c \u043d\u043e\u0443\u0442\u0431\u0443\u043a\u0435, \u0430 \u043d\u0435 \u043d\u0430 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440\u0435 \u0432 \u043f\u043e\u0441\u0442\u0435\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u0131\u015f hizmetlerini yaln\u0131zca diz\u00fcst\u00fc bilgisayarda \u00e7al\u0131\u015ft\u0131r \u2013 yataktaki TV'de de\u011fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5728\u7b14\u8bb0\u672c\u7535\u8111\u4e0a\u8fd0\u884c\u6d41\u5a92\u4f53\u670d\u52a1\uff0c\u800c\u4e0d\u662f\u5728\u5e8a\u4e0a\u7684\u7535\u89c6\u4e0a\u8fd0\u884c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u5728\u7b46\u8a18\u578b\u96fb\u8166\u4e0a\u904b\u884c\u4e32\u6d41\u5a92\u9ad4\u670d\u52d9\uff0c\u800c\u4e0d\u662f\u5728\u5e8a\u4e0a\u7684\u96fb\u8996\u4e0a\u904b\u884c\u3002"
          }
        }
      }
    },
    "trash.binge_streaming.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien-Marathon-Abende lassen dich tagelang unproduktiv und leer f\u00fchlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Series marathon evenings leave you feeling unproductive and empty for days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las noches de marat\u00f3n de series te dejan sinti\u00e9ndote improductivo y vac\u00edo durante d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soir\u00e9es marathon de s\u00e9ries te laissent improductif et vide pendant des jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0940\u0930\u0940\u091c \u092e\u0948\u0930\u093e\u0925\u0928 \u0915\u0940 \u0936\u093e\u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0915\u0908 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0917\u0948\u0930-\u0909\u0924\u094d\u092a\u093e\u0926\u0915 \u0914\u0930 \u0916\u093e\u0932\u0940 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0935\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serate maratona di serie ti lasciano improduttivo e vuoto per giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30ea\u30fc\u30ba\u30de\u30e9\u30bd\u30f3\u306e\u591c\u306f\u3001\u6570\u65e5\u9593\u4e0d\u751f\u7523\u7684\u3067\u7a7a\u865a\u306a\u6c17\u5206\u306b\u3055\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\ub9ac\uc988 \ub9c8\ub77c\ud1a4 \uc800\ub141\uc740 \uba70\uce60 \ub3d9\uc548 \ube44\uc0dd\uc0b0\uc801\uc774\uace0 \uacf5\ud5c8\ud55c \uae30\ubd84\uc744 \ub0a8\uae41\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriesmarathonavonden maken je dagenlang onproductief en leeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maratony serialowe sprawiaj\u0105, \u017ce przez wiele dni czujesz si\u0119 nieproduktywny i pusty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maratonas de s\u00e9ries te deixam se sentindo improdutivo e vazio por dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0447\u0435\u0440\u043d\u0438\u0435 \u043c\u0430\u0440\u0430\u0444\u043e\u043d\u0441\u043a\u0438\u0435 \u0441\u0435\u0440\u0438\u0438 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0432\u0430\u0441 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u043d\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438 \u0438 \u043e\u043f\u0443\u0441\u0442\u043e\u0448\u0435\u043d\u043d\u044b\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizi maraton geceleri, g\u00fcnlerce verimsiz ve bo\u015f hissettirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cfb\u5217\u9a6c\u62c9\u677e\u4e4b\u591c\u4f1a\u8ba9\u4f60\u8fde\u7eed\u51e0\u5929\u611f\u5230\u6548\u7387\u4f4e\u4e0b\u548c\u7a7a\u865a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cfb\u5217\u99ac\u62c9\u677e\u4e4b\u591c\u6703\u8b93\u4f60\u9023\u7e8c\u5e7e\u5929\u611f\u5230\u6548\u7387\u4f4e\u4e0b\u548c\u7a7a\u865b\u3002"
          }
        }
      }
    },
    "trash.binge_streaming.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Folge erlaubt \u2013 aber Auto-Play deaktivieren!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One episode allowed \u2013 but disable auto-play!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un episodio permitido, \u00a1pero desactiva la reproducci\u00f3n autom\u00e1tica!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un \u00e9pisode autoris\u00e9 \u2013 mais d\u00e9sactive la lecture automatique !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u090f\u092a\u093f\u0938\u094b\u0921 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0939\u0948 \u2013 \u0932\u0947\u0915\u093f\u0928 \u0911\u091f\u094b-\u092a\u094d\u0932\u0947 \u0915\u094b \u0905\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un episodio consentito \u2013 ma disabilita l'avvio automatico!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u8a71\u306f\u8a31\u53ef \u2013 \u305f\u3060\u3057\u81ea\u52d5\u518d\u751f\u306f\u30aa\u30d5\u306b\u3057\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud55c \ud3b8\uc740 \ud5c8\uc6a9 \u2013 \ud558\uc9c0\ub9cc \uc790\ub3d9 \uc7ac\uc0dd\uc744 \ube44\ud65c\uc131\ud654\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u00e9n aflevering is toegestaan \u2013 maar automatisch afspelen deactiveren!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden odcinek dozwolony \u2013 ale wy\u0142\u0105cz automatyczne odtwarzanie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um epis\u00f3dio permitido \u2013 mas desative a reprodu\u00e7\u00e3o autom\u00e1tica!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0430 \u043e\u0434\u043d\u0430 \u0441\u0435\u0440\u0438\u044f, \u043d\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0430\u0432\u0442\u043e\u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir b\u00f6l\u00fcm izlenebilir \u2013 ama otomatik oynatmay\u0131 devre d\u0131\u015f\u0131 b\u0131rak!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u64ad\u653e\u4e00\u96c6 - \u4f46\u7981\u7528\u81ea\u52a8\u64ad\u653e\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8a31\u64ad\u653e\u4e00\u96c6 - \u4f46\u505c\u7528\u81ea\u52d5\u64ad\u653e\uff01"
          }
        }
      }
    },
    "trash.binge_streaming.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Z\u00e4hle, wie viele Stunden du letzte Woche gestreamt hast. In was h\u00e4ttest du die Zeit investieren k\u00f6nnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count how many hours you streamed last week. What could you have invested the time in?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta cu\u00e1ntas horas transmitiste la semana pasada. \u00bfEn qu\u00e9 podr\u00edas haber invertido ese tiempo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte combien d'heures tu as regard\u00e9 en streaming la semaine derni\u00e8re. Dans quoi aurais-tu pu investir ce temps ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u093f\u0928\u094b \u0915\u093f \u0924\u0941\u092e\u0928\u0947 \u092a\u093f\u091b\u0932\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u093f\u0924\u0928\u0947 \u0918\u0902\u091f\u0947 \u0938\u094d\u091f\u094d\u0930\u0940\u092e\u093f\u0902\u0917 \u0915\u0940\u0964 \u0909\u0938 \u0938\u092e\u092f \u0915\u094b \u0924\u0941\u092e \u0915\u093f\u0938\u092e\u0947\u0902 \u0928\u093f\u0935\u0947\u0936 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0925\u0947?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta quante ore hai guardato in streaming la settimana scorsa. In cosa avresti potuto investire il tempo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5148\u9031\u306e\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u6642\u9593\u3092\u6570\u3048\u307e\u3057\u3087\u3046\u3002\u305d\u306e\u6642\u9593\u3092\u4f55\u306b\u6295\u8cc7\u3067\u304d\u305f\u3067\u3057\u3087\u3046\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\ub09c\uc8fc\uc5d0 \uba87 \uc2dc\uac04\uc744 \uc2a4\ud2b8\ub9ac\ubc0d\ud588\ub294\uc9c0 \uc138\uc5b4\ubcf4\uc138\uc694. \uadf8 \uc2dc\uac04\uc744 \ubb34\uc5c7\uc5d0 \ud22c\uc790\ud560 \uc218 \uc788\uc5c8\uc744\uae4c\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel hoeveel uur je vorige week hebt gestreamd. Waar had je die tijd in kunnen investeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Policz, ile godzin streamowa\u0142e\u015b w zesz\u0142ym tygodniu. W co m\u00f3g\u0142by\u015b zainwestowa\u0107 ten czas?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte quantas horas voc\u00ea transmitiu na semana passada. Em que voc\u00ea poderia ter investido o tempo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435, \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0447\u0430\u0441\u043e\u0432 \u0432\u044b \u0441\u0442\u0440\u0438\u043c\u0438\u043b\u0438 \u043d\u0430 \u043f\u0440\u043e\u0448\u043b\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435. \u0412\u043e \u0447\u0442\u043e \u0432\u044b \u043c\u043e\u0433\u043b\u0438 \u0431\u044b \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0432\u0440\u0435\u043c\u044f?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7en hafta ka\u00e7 saat yay\u0131n izledi\u011fini say. Bu zaman\u0131 neye yat\u0131rabilirdin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba1\u7b97\u60a8\u4e0a\u5468\u76f4\u64ad\u4e86\u591a\u5c11\u5c0f\u65f6\u3002\u4f60\u53ef\u4ee5\u628a\u65f6\u95f4\u6295\u5165\u5230\u4ec0\u4e48\u4e8b\u60c5\u4e0a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a08\u7b97\u60a8\u4e0a\u9031\u76f4\u64ad\u4e86\u591a\u5c11\u5c0f\u6642\u3002\u4f60\u53ef\u4ee5\u628a\u6642\u9593\u6295\u5165\u5728\u4ec0\u9ebc\u4e8b\u60c5\u4e0a\uff1f"
          }
        }
      }
    },
    "trash.binge_streaming.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Binge Streaming)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Hobby nachgehen)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Binge Streaming)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Hobby nachgehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Binge Streaming)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Hobby nachgehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Binge Streaming)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Hobby nachgehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u092c\u0941\u0930\u0940 \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u092c\u093f\u0902\u091c \u0938\u094d\u091f\u094d\u0930\u0940\u092e\u093f\u0902\u0917)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u094d\u0930\u092d\u093e\u0935\u094b\u0902 \u0938\u0947 \u0905\u0935\u0917\u0924 \u0939\u094b\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0902 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0936\u094c\u0915 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0938\u0930\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Binge Streaming)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Hobby nachgehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Binge Streaming)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Hobby nachgehen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },

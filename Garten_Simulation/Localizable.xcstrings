    "assessment.health.profile.optimierer.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein System l\u00e4uft sauber. Halte die Standards und skaliere weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your system is running clean. Maintain the standards and keep scaling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sistema est\u00e1 funcionando limpio. Mantener los est\u00e1ndares y seguir escalando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre syst\u00e8me fonctionne proprement. Maintenir les normes et continuer \u00e0 \u00e9voluer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u093e\u092b\u093c \u091a\u0932 \u0930\u0939\u093e \u0939\u0948. \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u094b \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902 \u0914\u0930 \u0938\u094d\u0915\u0947\u0932\u093f\u0902\u0917 \u0915\u0930\u0924\u0947 \u0930\u0939\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo sistema funziona in modo pulito. Mantieni gli standard e continua a crescere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30b9\u30c6\u30e0\u306f\u6b63\u5e38\u306b\u52d5\u4f5c\u3057\u3066\u3044\u307e\u3059\u3002\u6a19\u6e96\u3092\u7dad\u6301\u3057\u3001\u898f\u6a21\u3092\u62e1\u5927\u3057\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc2a4\ud15c\uc774 \uae68\ub057\ud558\uac8c \uc2e4\ud589\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud45c\uc900\uc744 \uc720\uc9c0\ud558\uace0 \uacc4\uc18d\ud574\uc11c \ud655\uc7a5\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw systeem werkt schoon. Handhaaf de normen en blijf opschalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j system dzia\u0142a czysto. Utrzymuj standardy i kontynuuj skalowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu sistema est\u00e1 funcionando limpo. Mantenha os padr\u00f5es e continue aumentando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0447\u0438\u0441\u0442\u043e. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0439 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u044b \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisteminiz temiz \u00e7al\u0131\u015f\u0131yor. Standartlar\u0131 koruyun ve \u00f6l\u00e7eklendirmeye devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u7cfb\u7edf\u8fd0\u884c\u826f\u597d\u3002\u4fdd\u6301\u6807\u51c6\u5e76\u7ee7\u7eed\u6269\u5c55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u7cfb\u7d71\u904b\u4f5c\u4e7e\u6de8\u3002\u7dad\u6301\u6a19\u6e96\u4e26\u6301\u7e8c\u64f4\u5927\u898f\u6a21\u3002"
          }
        }
      }
    },
    "assessment.health.profile.optimierer.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwing dich nicht zu 100\uff05 Perfektion an einem Reisetag \u2013 akzeptiere 80\uff05 als ausreichend, um Stresshormone niedrig zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't force yourself to be 100\uff05 perfect on a travel day - accept 80\uff05 as enough to keep stress hormones low."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te fuerces a ser 100 \uff05 perfecto en un d\u00eda de viaje; acepta el 80 \uff05 como suficiente para mantener bajas las hormonas del estr\u00e9s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous forcez pas \u00e0 \u00eatre parfait \u00e0 100 \uff05 lors d\u2019une journ\u00e9e de voyage \u2013 acceptez 80 \uff05 comme suffisant pour maintenir les hormones de stress \u00e0 un niveau bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0926\u093f\u0928 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b 100\uff05 \u092a\u0930\u092b\u0947\u0915\u094d\u091f \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u091c\u092c\u0942\u0930 \u0928 \u0915\u0930\u0947\u0902 - \u0924\u0928\u093e\u0935 \u0939\u093e\u0930\u094d\u092e\u094b\u0928 \u0915\u094b \u0915\u092e \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 80\uff05 \u0915\u094b \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u092e\u093e\u0928\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non forzarti a essere perfetto al 100\uff05 durante una giornata di viaggio: accetta l'80\uff05 come sufficiente per mantenere bassi gli ormoni dello stress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65c5\u884c\u5f53\u65e5\u306b 100\uff05 \u5b8c\u74a7\u306b\u306a\u308d\u3046\u3068\u7121\u7406\u3092\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30b9\u30c8\u30ec\u30b9 \u30db\u30eb\u30e2\u30f3\u3092\u6291\u3048\u308b\u306b\u306f 80\uff05 \u3067\u5341\u5206\u3060\u3068\u53d7\u3051\u5165\u308c\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ec\ud589 \ub2f9\uc77c \uc790\uc2e0\uc5d0\uac8c 100\uff05 \uc644\ubcbd\ud558\ub2e4\uace0 \uac15\uc694\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uc2a4\ud2b8\ub808\uc2a4 \ud638\ub974\ubaac\uc744 \ub0ae\uac8c \uc720\uc9c0\ud558\uae30\uc5d0 \ucda9\ubd84\ud55c 80\uff05\ub97c \ubc1b\uc544\ub4e4\uc774\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forceer jezelf niet om 100\uff05 perfect te zijn op een reisdag; accepteer 80\uff05 als voldoende om de stresshormonen laag te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zmuszaj si\u0119 do bycia w 100\uff05 perfekcyjnym w dniu podr\u00f3\u017cy \u2013 zaakceptuj 80\uff05 jako wystarczaj\u0105ce, aby utrzyma\u0107 niski poziom hormon\u00f3w stresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o se force a ser 100\uff05 perfeito em um dia de viagem \u2013 aceite 80\uff05 como suficiente para manter baixos os horm\u00f4nios do estresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0439 \u0441\u0435\u0431\u044f \u0431\u044b\u0442\u044c \u043d\u0430 100\uff05 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u043c \u0432 \u0434\u0435\u043d\u044c \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u2014 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0439 80\uff05 \u043a\u0430\u043a \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0441\u0442\u0440\u0435\u0441\u0441\u043e\u0432\u044b\u0445 \u0433\u043e\u0440\u043c\u043e\u043d\u043e\u0432 \u043d\u0438\u0437\u043a\u0438\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seyahat g\u00fcn\u00fcnde kendinizi \uff05100 m\u00fckemmel olmaya zorlamay\u0131n; \uff0580'in stres hormonlar\u0131n\u0131 d\u00fc\u015f\u00fck tutmaya yetece\u011fini kabul edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5f3a\u8feb\u81ea\u5df1\u5728\u65c5\u884c\u65e5\u8ffd\u6c42100\uff05\u7684\u5b8c\u7f8e\u2014\u2014\u63a5\u53d780\uff05\u5c31\u8db3\u591f\uff0c\u4ee5\u4fdd\u6301\u538b\u529b\u6fc0\u7d20\u7684\u4f4e\u6c34\u5e73\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5f37\u8feb\u81ea\u5df1\u5728\u65c5\u884c\u7576\u5929\u505a\u5230 100\uff05 \u5b8c\u7f8e - \u63a5\u53d7 80\uff05 \u5c31\u8db3\u4ee5\u4fdd\u6301\u8f03\u4f4e\u7684\u58d3\u529b\u8377\u723e\u8499\u3002"
          }
        }
      }
    },
    "assessment.health.profile.optimierer.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcge deinem morgendlichen Wasser eine kleine Prise Himalaya-Salz hinzu, um deine Elektrolyte aufzuf\u00fcllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a small pinch of Himalayan salt to your morning water to replenish your electrolytes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega una peque\u00f1a pizca de sal del Himalaya al agua de la ma\u00f1ana para reponer tus electrolitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une petite pinc\u00e9e de sel de l'Himalaya \u00e0 votre eau du matin pour reconstituer vos \u00e9lectrolytes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u094b\u0932\u093e\u0907\u091f\u094d\u0938 \u0915\u0940 \u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u092c\u0939 \u0915\u0947 \u092a\u093e\u0928\u0940 \u092e\u0947\u0902 \u090f\u0915 \u091b\u094b\u091f\u0940 \u091a\u0941\u091f\u0915\u0940 \u0939\u093f\u092e\u093e\u0932\u092f\u0928 \u0928\u092e\u0915 \u092e\u093f\u0932\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un piccolo pizzico di sale dell'Himalaya all'acqua del mattino per ricostituire i tuoi elettroliti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96fb\u89e3\u8cea\u3092\u88dc\u7d66\u3059\u308b\u305f\u3081\u306b\u3001\u671d\u306e\u6c34\u306b\u30d2\u30de\u30e9\u30e4\u5869\u3092\u5c11\u91cf\u52a0\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uce68 \ubb3c\uc5d0 \ud788\ub9d0\ub77c\uc57c \uc18c\uae08\uc744 \uc870\uae08 \ub123\uc5b4 \uc804\ud574\uc9c8\uc744 \ubcf4\ucda9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een klein snufje Himalayazout toe aan je ochtendwater om je elektrolyten aan te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj niewielk\u0105 szczypt\u0119 soli himalajskiej do porannej wody, aby uzupe\u0142ni\u0107 elektrolity."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pequena pitada de sal do Himalaia \u00e0 \u00e1gua da manh\u00e3 para repor os eletr\u00f3litos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0431\u0430\u0432\u044c \u0449\u0435\u043f\u043e\u0442\u043a\u0443 \u0433\u0438\u043c\u0430\u043b\u0430\u0439\u0441\u043a\u043e\u0439 \u0441\u043e\u043b\u0438 \u0432 \u0443\u0442\u0440\u0435\u043d\u043d\u044e\u044e \u0432\u043e\u0434\u0443, \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043b\u0438\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elektrolitlerinizi yenilemek i\u00e7in sabah suyunuza k\u00fc\u00e7\u00fck bir tutam Himalaya tuzu ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684\u65e9\u6668\u6c34\u4e2d\u52a0\u5165\u5c11\u91cf\u559c\u9a6c\u62c9\u96c5\u76d0\uff0c\u4ee5\u8865\u5145\u7535\u89e3\u8d28\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u65e9\u6668\u7684\u6c34\u4e2d\u52a0\u5165\u4e00\u5c0f\u64ae\u559c\u99ac\u62c9\u96c5\u9e7d\u4f86\u88dc\u5145\u96fb\u89e3\u8cea\u3002"
          }
        }
      }
    },
    "assessment.health.profile.optimierer.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein K\u00f6rper ist bestens eingestellt. Um die letzten 1\uff05 Biohacking herauszuholen, musst du Details perfektionieren und Verbissenheit abbauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is perfectly adjusted. To get the last 1\uff05 of biohacking out, you have to perfect details and reduce stubbornness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo est\u00e1 perfectamente ajustado. Para sacar el \u00faltimo 1\uff05 del biohacking, hay que perfeccionar los detalles y reducir la terquedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps est parfaitement ajust\u00e9. Pour \u00e9liminer le dernier 1\uff05 de biohacking, il faut perfectionner les d\u00e9tails et r\u00e9duire l\u2019ent\u00eatement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0939\u0948\u0964 \u092c\u093e\u092f\u094b\u0939\u0948\u0915\u093f\u0902\u0917 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 1\uff05 \u0915\u094b \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b \u0935\u093f\u0935\u0930\u0923 \u0938\u0939\u0940 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u0914\u0930 \u091c\u093f\u0926 \u0915\u092e \u0915\u0930\u0928\u0940 \u0939\u094b\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo \u00e8 perfettamente adattato. Per ottenere l'ultimo 1\uff05 di biohacking, devi perfezionare i dettagli e ridurre la testardaggine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u4f53\u306f\u5b8c\u74a7\u306b\u8abf\u6574\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30d0\u30a4\u30aa\u30cf\u30c3\u30ad\u30f3\u30b0\u306e\u6700\u5f8c\u306e 1\uff05 \u3092\u5f15\u304d\u51fa\u3059\u306b\u306f\u3001\u7d30\u90e8\u3092\u5b8c\u74a7\u306b\u3057\u3001\u9811\u56fa\u3055\u3092\u8efd\u6e1b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \ubab8\uc740 \uc644\ubcbd\ud558\uac8c \uc870\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ubc14\uc774\uc624\ud574\ud0b9\uc758 \ub9c8\uc9c0\ub9c9 1\uff05\ub97c \uc5c6\uc560\ub824\uba74 \uc138\ubd80 \uc0ac\ud56d\uc744 \uc644\ubcbd\ud558\uac8c \ud558\uace0 \uace0\uc9d1\uc744 \uc904\uc5ec\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lichaam is perfect aangepast. Om de laatste 1\uff05 van het biohacking eruit te halen, moet je de details perfectioneren en de koppigheid verminderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje cia\u0142o jest doskonale dostosowane. Aby wydoby\u0107 ostatni 1\uff05 biohackingu, musisz dopracowa\u0107 szczeg\u00f3\u0142y i zmniejszy\u0107 up\u00f3r."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo est\u00e1 perfeitamente ajustado. Para obter o \u00faltimo 1\uff05 do biohacking, voc\u00ea precisa aperfei\u00e7oar os detalhes e reduzir a teimosia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u043e \u043d\u0430\u0438\u043b\u0443\u0447\u0448\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c. \u0427\u0442\u043e\u0431\u044b \u0432\u044b\u0436\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 1\uff05 \u0431\u0438\u043e\u0445\u0430\u043a\u0438\u043d\u0433\u0430, \u0442\u0435\u0431\u0435 \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0434\u0435\u0442\u0430\u043b\u0438 \u0438 \u0438\u0437\u0431\u0430\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043e\u0442 \u0443\u043f\u0435\u0440\u0442\u043e\u0441\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuz m\u00fckemmel bir \u015fekilde ayarlanm\u0131\u015ft\u0131r. Biyolojik hacklemenin son \uff051'ini ortadan kald\u0131rmak i\u00e7in ayr\u0131nt\u0131lar\u0131 m\u00fckemmelle\u015ftirmeniz ve inat\u00e7\u0131l\u0131\u011f\u0131 azaltman\u0131z gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u8eab\u4f53\u72b6\u6001\u6700\u4f73\u3002\u4e3a\u4e86\u6316\u6398\u6700\u540e1\uff05\u7684\u751f\u7269\u9ed1\u5ba2\u6f5c\u529b\uff0c\u4f60\u5fc5\u987b\u5b8c\u5584\u7ec6\u8282\u5e76\u51cf\u5c11\u6267\u7740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u8eab\u9ad4\u5df2\u7d93\u5b8c\u7f8e\u8abf\u6574\u3002\u70ba\u4e86\u89e3\u6c7a\u6700\u5f8c 1\uff05 \u7684\u751f\u7269\u99ed\u5ba2\u653b\u64ca\uff0c\u4f60\u5fc5\u9808\u5b8c\u5584\u7d30\u7bc0\u4e26\u6e1b\u5c11\u56fa\u57f7\u3002"
          }
        }
      }
    },

    "%@": {
      "comment": "A label inside the timer row showing the time of the next active reminder for a plant.",
      "isCommentAutoGenerated": true
    },
    "%@ (+%lld %@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (+%2$lld %3$@)"
          }
        }
      }
    },
    "%@ (Gratis)": {
      "comment": "A button that allows the user to revive a plant using \"Wonder Water\". The argument is the string “item.wunder_wasser.name”.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true
    },
    "%@ %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld"
          }
        }
      }
    },
    "%lld": {},

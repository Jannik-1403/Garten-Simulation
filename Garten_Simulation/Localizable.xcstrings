    "assessment.lifestyle.q11.a": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konsumiere zu 100%. Ich scrolle nur durch die Leben anderer Leute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I consume 100%. I just scroll through other people's lives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumo el 100%. Simplemente me desplazo por la vida de otras personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je consomme à 100%. Je fais juste défiler la vie des autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं 100% उपभोग करता हूँ। मैं बस अन्य लोगों के जीवन का अवलोकन करता हूँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumo il 100%. Scorro semplicemente le vite degli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100%消費してます。他の人の人生をスクロールするだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 100% 소비한다. 나는 단지 다른 사람들의 삶을 스크롤할 뿐입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik consumeer 100%. Ik scroll gewoon door de levens van anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsumuję na 100%. Po prostu przeglądam życie innych ludzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu consumo 100%. Eu apenas folheio a vida de outras pessoas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu consumo 100%. Eu apenas folheio a vida de outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я потребляю на 100%. Я только прокручиваю жизни других людей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100 tüketiyorum. Başkalarının hayatlarına göz atıyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我百分之百在消费。我只是浏览别人的生活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我消耗100%。我只是瀏覽別人的生活。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.mental.profile.glaeserner.break": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies morgens in den ersten 10 Minuten nach dem Aufwachen keine Nachrichten. Schütze diese 1% des Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't read the news for the first 10 minutes after you wake up in the morning. Protect that 1% of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No leas las noticias durante los primeros 10 minutos después de despertarte por la mañana. Protege ese 1% del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne lisez pas les informations pendant les 10 premières minutes après votre réveil le matin. Protégez ce 1% de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह उठने के बाद पहले 10 मिनट तक समाचार न पढ़ें। दिन के उस 1% को सुरक्षित रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non leggere le notizie per i primi 10 minuti dopo esserti svegliato al mattino. Proteggi quell'1% della giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝起きてから最初の10分間はニュースを読まないでください。一日の 1% を守りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 일어나서 처음 10분 동안은 뉴스를 읽지 마세요. 하루의 1%를 보호하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees het nieuws de eerste tien minuten nadat u 's ochtends wakker wordt niet. Bescherm die 1% van de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie czytaj wiadomości przez pierwsze 10 minut po przebudzeniu się rano. Chroń ten 1% dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não leia as notícias nos primeiros 10 minutos depois de acordar pela manhã. Proteja esse 1% do dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não leia as notícias nos primeiros 10 minutos depois de acordar pela manhã. Proteja esse 1% do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не читай новости утром в первые 10 минут после пробуждения. Защищай этот 1% дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah uyandıktan sonraki ilk 10 dakika haber okumayın. Günün %1’ini koruyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早上醒来的前10分钟不要看新闻。保护这一天的1%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早上起床後的前 10 分鐘不要閱讀新聞。保護一天中的那 1%。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.mental.profile.unerschuetterlicher.break": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide es, in Diskussionen immer das letzte Wort haben zu wollen – überlass den 1% Raum dem anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid always wanting to have the last word in discussions - leave the 1% space to the other person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite querer siempre tener la última palabra en las discusiones: deje el 1% de espacio a la otra persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez de toujours vouloir avoir le dernier mot dans les discussions - laissez l'espace de 1% à l'autre personne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चर्चाओं में हमेशा अंतिम शब्द बोलने की चाहत से बचें - 1% स्थान दूसरे व्यक्ति के लिए छोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita di voler avere sempre l'ultima parola nelle discussioni: lascia lo spazio dell'1% all'altra persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "議論の中で常に最後の言葉を言いたいと思うのは避けてください。1% のスペースは他の人に任せてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토론에서 항상 마지막 말을 하고 싶어하지 마십시오. 1%의 공간을 다른 사람에게 남겨두십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd altijd het laatste woord te willen hebben in discussies; laat de ruimte van 1% aan de ander over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj chęci posiadania zawsze ostatniego słowa w dyskusjach – zostaw 1% miejsca drugiej osobie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite sempre querer ter a última palavra nas discussões – deixe o espaço de 1% para a outra pessoa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite sempre querer ter a última palavra nas discussões – deixe o espaço de 1% para a outra pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегай стремления всегда иметь последнее слово в обсуждениях – оставь 1% пространства другому."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartışmalarda her zaman son sözü söylemekten kaçının; %1'lik alanı diğer kişiye bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免在讨论中总是想要说最后一句话——把1%的空间留给对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免總是想在討論中擁有最後發言權——把 1% 的空間留給對方。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.mental.profile.unerschuetterlicher.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist extrem mental stark. Um die letzten 1% herauszuholen, musst du sicherstellen, dass du nicht arrogant oder abgestumpft wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are extremely mentally strong. To get that last 1%, you need to make sure you don't become arrogant or jaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres extremadamente fuerte mentalmente. Para obtener ese último 1%, debes asegurarte de no volverte arrogante ni hastiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes extrêmement fort mentalement. Pour obtenir ce dernier 1%, vous devez vous assurer de ne pas devenir arrogant ou blasé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप मानसिक रूप से बेहद मजबूत हैं. उस अंतिम 1% को पाने के लिए, आपको यह सुनिश्चित करना होगा कि आप अहंकारी या थके हुए न बनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei estremamente forte mentalmente. Per ottenere quell'ultimo 1%, devi assicurarti di non diventare arrogante o stanco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは非常に精神的に強いです。最後の 1% を獲得するには、傲慢になったり、うんざりしたりしないようにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 정신적으로 매우 강합니다. 마지막 1%를 얻으려면 교만하거나 지치지 않도록 해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent mentaal enorm sterk. Om die laatste 1% te krijgen, moet je ervoor zorgen dat je niet arrogant of afgemat wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś niezwykle silny psychicznie. Aby zdobyć ten ostatni 1%, musisz uważać, aby nie stać się aroganckim ani zblazowanym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é extremamente forte mentalmente. Para obter o último 1%, você precisa ter certeza de não se tornar arrogante ou cansado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é extremamente forte mentalmente. Para obter o último 1%, você precisa ter certeza de não se tornar arrogante ou cansado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты экстремально психологически сильный. Чтобы выжать последние 1%, ты должен убедиться, что не станешь высокомерным или черствым."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihinsel olarak son derece güçlüsünüz. Son %1'i elde etmek için kibirli veya bitkin olmadığınızdan emin olmalısınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你精神非常强大。为了挖掘最后的1%，你必须确保自己不变得傲慢或麻木。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心理素質非常強大。為了獲得最後 1%，您需要確保自己不會變得傲慢或厭倦。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.mental.q10.c": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stoppe sofort. 95% reichen völlig. Schlaf und Fokus für morgen sind strategisch wichtiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll stop immediately. 95% is completely sufficient. Sleep and focus for tomorrow are strategically more important."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pararé inmediatamente. El 95% es completamente suficiente. Dormir y concentrarse para el mañana son estratégicamente más importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais arrêter immédiatement. 95% est tout à fait suffisant. Le sommeil et la concentration pour demain sont stratégiquement plus importants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं तुरंत रुक जाऊंगा. 95% पूर्णतः पर्याप्त है। नींद और कल पर ध्यान केंद्रित करना रणनीतिक रूप से अधिक महत्वपूर्ण है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi fermerò immediatamente. Il 95% è completamente sufficiente. Dormire e concentrarsi per il domani sono strategicamente più importanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにやめます。 95% あれば完全に十分です。明日への睡眠と集中力は戦略的により重要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 중지하겠습니다. 95%면 충분합니다. 내일을 위한 수면과 집중이 전략적으로 더 중요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik stop onmiddellijk. 95% is volledig voldoende. Slaap en focus voor morgen zijn strategisch belangrijker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast przestanę. 95% w zupełności wystarczy. Sen i koncentracja na jutro są strategicznie ważniejsze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou parar imediatamente. 95% é completamente suficiente. O sono e o foco para amanhã são estrategicamente mais importantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou parar imediatamente. 95% é completamente suficiente. O sono e o foco para amanhã são estrategicamente mais importantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я останавливаюсь немедленно. 95% вполне достаточно. Сон и концентрация на завтра стратегически важнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen duracağım. %95 tamamen yeterli. Uyku ve yarına odaklanmak stratejik olarak daha önemlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我立刻停止。95%已经完全足够。为了明天的睡眠和专注更具战略意义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我會立即停下來。 95%就完全足夠了。睡眠和明天的注意力在策略上更為重要。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.mental.q13": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist in einer hitzigen Diskussion. Fünf Leute vertreten lautstark Meinung A. Du weißt zu 100%, dass Meinung B richtig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in a heated discussion. Five people loudly support opinion A. You know 100% that opinion B is correct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en una acalorada discusión. Cinco personas apoyan en voz alta la opinión A. Usted sabe al 100% que la opinión B es correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes dans une discussion animée. Cinq personnes soutiennent haut et fort l’opinion A. Vous savez à 100 % que l’opinion B est correcte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप गरमागरम चर्चा में हैं. पांच लोग जोर-शोर से राय ए का समर्थन करते हैं। आप 100% जानते हैं कि राय बी सही है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in una discussione accesa. Cinque persone sostengono fortemente l'opinione A. Sai al 100% che l'opinione B è corretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは白熱した議論をしています。 5 人が意見 A を声高に支持します。あなたは意見 B が正しいことを 100% 知っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 열띤 토론을 벌이고 있습니다. 5명이 A의견을 큰 소리로 지지합니다. 당신은 B의견이 옳다는 것을 100% 알고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent verwikkeld in een verhitte discussie. Vijf mensen steunen luidkeels mening A. Je weet 100% dat mening B juist is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś w gorącej dyskusji. Pięć osób głośno popiera opinię A. Wiesz na 100%, że opinia B jest słuszna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em uma discussão acalorada. Cinco pessoas apoiam veementemente a opinião A. Você sabe 100% que a opinião B está correta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em uma discussão acalorada. Cinco pessoas apoiam veementemente a opinião A. Você sabe 100% que a opinião B está correta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты участвуешь в горячей дискуссии. Пять человек громко отстаивают мнение A. Ты на 100% уверен, что мнение B правильно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hararetli bir tartışmanın içindesiniz. Beş kişi yüksek sesle A fikrini destekliyor. B görüşünün doğru olduğunu %100 biliyorsunuz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正处于一场激烈的讨论中。五个人大声表达意见A。你百分之百确定意见B是正确的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你們正在進行激烈的討論。五個人大聲支持觀點A。你知道觀點B是100%正確的。"
          }

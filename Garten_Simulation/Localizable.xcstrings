    "iap_restore_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle bestehende Pro-Abonnements und Lifetime-Käufe über deinen Apple-Account wieder her. Frühere Münz- und Kosmetikkäufe werden separat geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore existing Pro subscriptions and lifetime purchases through your Apple account. Historical currency and cosmetic purchases are handled separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Restaurar compras' SOLO funciona para compras no consumibles (como las gafas de sol). Las monedas no se pueden restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANT: 'Restaurer les achats' fonctionne UNIQUEMENT pour les achats non consommables (comme les lunettes). Les pièces ne peuvent pas être restaurées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्वपूर्ण: Apple की 'रिस्टोर परचेज़' केवल एक बार की खरीदारी (जैसे धूप का चश्मा) के लिए काम करती है। Apple के नियमों के अनुसार, सिक्के (उपभोग्य वस्तुएं) कभी भी पुनर्प्राप्त नहीं किए जा सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Ripristina acquisti' funziona SOLO per articoli non di consumo (come gli occhiali da sole). Le monete non possono essere ripristinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 重要: 「購入の復元」は、非消耗品（サングラスなど）にのみ機能します。コインは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 중요: '구매 복원'은 비소모품(선글라스 등)에만 적용됩니다. 코인은 복원할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " BELANGRIJK: 'Aankopen herstellen' werkt ALLEEN voor niet-verbruiksartikelen (zoals zonnebrillen). Munten kunnen niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " WAŻNE: 'Przywróć zakupy' działa TYLKO dla przedmiotów jednorazowych (jak okulary). Monet nie można przywrócić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Restaurar Compras' funciona APENAS para não consumíveis (como óculos de sol). Moedas nunca podem ser restauradas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Restaurar Compras' funciona APENAS para não consumíveis (como óculos de sol). Moedas nunca podem ser restauradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВАЖНО: «Восстановить покупки» у Apple работает ТОЛЬКО для одноразовых покупок (например, очки от солнца). Монеты (расходные материалы) согласно правилам Apple никогда не могут быть восстановлены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " ÖNEMLİ: 'Satın Alınanları Geri Yükle' SADECE güneş gözlüğü gibi kalıcı öğeler için çalışır. Jetonlar geri yüklenemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 重要提示：在 Apple 设备上，'恢复购买'仅适用于一次性购买（如太阳镜）。根据 Apple 规则，金币（消耗品）永远无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重要提示：Apple 的「恢復購買」僅適用於一次性購買（例如太陽眼鏡）。根據蘋果規定，金幣（消耗品）永遠無法恢復。"
          }
        }
      }
    },

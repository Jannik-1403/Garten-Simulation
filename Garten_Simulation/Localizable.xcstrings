    "assessment.lifestyle.q8.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sage eiskalt: 'Über Leute, die nicht da sind, reden wir nicht.' und beende das Gespräch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I say coldly: 'We don't talk about people who aren't there.' and end the conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le digo con frialdad: \"No hablamos de gente que no está\". y terminar la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dis froidement : « On ne parle pas des gens qui ne sont pas là. et mettre fin à la conversation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं रुखाई से कहता हूं: 'हम उन लोगों के बारे में बात नहीं करते जो वहां नहीं हैं।' और बातचीत ख़त्म करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dico freddamente: \"Non parliamo di gente che non c'è\". e terminare la conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は冷たく言います、「その場にいない人のことは話さない」。そして会話を終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 차갑게 말했다. '우리는 거기에 없는 사람들에 대해 이야기하지 않습니다.' 그리고 대화를 종료합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik zeg koel: 'We praten niet over mensen die er niet zijn.' en beëindig het gesprek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówię chłodno: „Nie rozmawiamy o ludziach, których nie ma”. i zakończ rozmowę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digo friamente: 'Não falamos de pessoas que não estão lá'. e encerrar a conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я говорю холодно: «О людях, которых нет, мы не говорим.» и заканчиваю разговор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soğuk bir tavırla şunu söylüyorum: 'Orada olmayan insanlar hakkında konuşmayız.' ve konuşmayı sonlandırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我冷冷地说：‘我们不谈论不在场的人。’然后结束了谈话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我冷冷地說：「我們不會談論不在場的人。」並結束談話。"
          }
        }
      }
    },
    "assessment.lifestyle.q9" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand bittet dich um einen Gefallen, auf den du absolut keine Lust und keine Zeit hast. Was sagst du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone asks you to do a favor that you have absolutely no desire or time for. What do you say?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien te pide que le hagas un favor para el que no tienes ningún deseo ni tiempo. ¿Qué dices?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un vous demande de rendre un service pour lequel vous n’avez absolument aucune envie ni le temps. Que dites-vous?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई आपसे ऐसा उपकार करने के लिए कहता है जिसके लिए आपके पास बिल्कुल भी इच्छा या समय नहीं है। आप क्या कहते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno ti chiede di fare un favore per il quale non hai assolutamente desiderio o tempo. Che ne dici?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがあなたに、まったく望んでいない、または時間がないお願いをするように頼みます。あなたは何と言いますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가가 당신에게 전혀 원하지도 않고 시간도 없는 부탁을 해달라고 부탁합니다. 당신은 무엇을 말합니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand vraagt ​​je om een ​​gunst waar je absoluut geen zin of tijd voor hebt. Wat zeg je?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś prosi Cię o przysługę, na którą zupełnie nie masz ochoty ani czasu. Co powiesz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém lhe pede para fazer um favor para o qual você não tem absolutamente nenhum desejo ou tempo. O que você diz?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то просит тебя об одолжении, на которое у тебя абсолютно нет ни желания, ни времени. Что ты скажешь?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birisi sizden kesinlikle arzulamadığınız veya zamanınızın olmadığı bir iyilik yapmanızı istiyor. Sen ne diyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人向你请求帮忙，而你根本没有兴趣也没有时间。你会怎么说？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人請你幫忙做一件你絕對不想做或沒有時間做的事。你怎麼說？"
          }
        }
      }
    },
    "assessment.lifestyle.q9.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sage sofort 'Ja', um keinen Konflikt zu riskieren, und hasse mich danach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I say 'yes' straight away so as not to risk conflict, and then I hate myself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digo \"sí\" de inmediato para no correr el riesgo de entrar en conflicto, y luego me odio a mí mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dis « oui » tout de suite pour ne pas risquer un conflit, et puis je me déteste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं तुरंत 'हां' कहता हूं ताकि टकराव का खतरा न हो, और फिर मुझे खुद से नफरत होने लगती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dico subito sì per non rischiare il conflitto, e poi mi odio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衝突の危険を避けるためにすぐに「はい」と言うと、自分が嫌いになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갈등을 겪지 않으려고 바로 '예'라고 대답하고 나면 내 자신이 싫어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik zeg meteen 'ja' om geen conflicten te riskeren, en dan haat ik mezelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od razu mówię „tak”, żeby nie narażać się na konflikt, i wtedy siebie nienawidzę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digo 'sim' imediatamente para não correr o risco de conflito, e então me odeio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я сразу же говорю 'да', чтобы не рисковать конфликтом, а потом ненавижу себя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çatışma riskine girmemek için hemen 'evet' diyorum ve sonra kendimden nefret ediyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我立刻说“是”，以免冒险引发冲突，然后恨自己。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我立即說“是”，以免發生衝突，然後我討厭自己。"
          }
        }
      }
    },
    "assessment.lifestyle.q9.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

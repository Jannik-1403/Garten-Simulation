    "plant.lavendel.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigt und entspannt den Geist \u2013 besserer Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calms and relaxes the mind \u2013 better sleep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calma y relaja la mente \u2013 mejor sue\u00f1o"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme et d\u00e9tend l'esprit \u2013 meilleur sommeil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0928 \u0915\u094b \u0936\u093e\u0902\u0924 \u0914\u0930 \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915 \u0915\u0930\u0924\u093e \u0939\u0948 \u2013 \u092c\u0947\u0939\u0924\u0930 \u0928\u0940\u0902\u0926"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calms and relaxes the mind \u2013 better sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc3\u3092\u843d\u3061\u7740\u304b\u305b\u3066\u30ea\u30e9\u30c3\u30af\u30b9\u3055\u305b\u3001\u3088\u308a\u826f\u3044\u7761\u7720\u3092\u3082\u305f\u3089\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc74c\uc744 \uc9c4\uc815\uc2dc\ud0a4\uace0 \uc774\uc644\uc2dc\ud0b5\ub2c8\ub2e4 \u2013 \ub354 \ub098\uc740 \uc7a0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalmeert en ontspant de geest \u2013 betere slaap"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspokaja i relaksuje umys\u0142 \u2013 lepszy sen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acalma e relaxa a mente \u2013 melhor sono"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u043f\u043e\u043a\u0430\u0438\u0432\u0430\u0435\u0442 \u0438 \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u044f\u0435\u0442 \u0443\u043c \u2013 \u043b\u0443\u0447\u0448\u0438\u0439 \u0441\u043e\u043d"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihni sakinle\u015ftirir ve rahatlat\u0131r \u2013 daha iyi uyku"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9547\u9759\u5e76\u653e\u677e\u5fc3\u7075 \u2013 \u66f4\u597d\u7684\u7761\u7720"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u975c\u8207\u653e\u9b06\u5fc3\u9748\uff0d\u66f4\u597d\u7684\u7761\u7720"
          }
        }
      }
    },

        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás de vacaciones o de viaje escolar durante una semana. No hay gimnasio y no tienes equipamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

    "assessment.finance.profile.impulsiver.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe die 24-Stunden-Regel ein: Jede ungeplante Ausgabe über 50€ wird erst einen Tag später getätigt. Ohne Ausnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce the 24-hour rule: Any unplanned expense over €50 will only be made one day later. Without exception."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la regla de las 24 horas: Cualquier gasto no planificado superior a 50€ sólo se realizará un día después. Sin excepción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduisez la règle des 24 heures : toute dépense imprévue supérieure à 50 € ne sera effectuée qu'un jour plus tard. Sans exception."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 घंटे का नियम लागू करें: €50 से अधिक का कोई भी अनियोजित खर्च केवल एक दिन बाद किया जाएगा। अपवाद के बिना।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducete la regola delle 24 ore: qualsiasi spesa non pianificata superiore a 50 € verrà effettuata solo un giorno dopo. Senza eccezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 時間ルールを導入します。50 ユーロを超える予定外の出費は 1 日後にのみ発生します。例外なく。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24시간 규칙을 도입하세요. €50를 초과하는 계획되지 않은 비용은 하루 후에만 발생합니다. 예외없이."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de 24-uursregel in: ongeplande uitgaven boven € 50,- worden pas een dag later gedaan. Zonder uitzondering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadź zasadę 24 godzin: każdy nieplanowany wydatek przekraczający 50 euro zostanie zrealizowany dopiero dzień później. Bezwyjątkowo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza a regra das 24 horas: Qualquer despesa não planeada superior a 50€ só será feita um dia depois. Sem exceção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введи правило 24 часов: каждая незапланированная трата свыше 50€ осуществляется только на следующий день. Без исключений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 saat kuralını getirin: 50 €'yu aşan planlanmamış harcamalar yalnızca bir gün sonra yapılacaktır. İstisnasız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引入24小时规则：每一笔超过50欧元的未计划支出都要推迟一天进行。没有例外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引入 24 小時規則：任何超過 50 歐元的計劃外費用只能在一天後支付。無一例外。"
          }
        }
      }
    },
    "assessment.finance.profile.impulsiver.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe nie hungrig oder extrem gestresst einkaufen – das 1％ extra Stress führt zu 50％ mehr Ausgaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never go shopping hungry or extremely stressed - that 1％ extra stress leads to 50％ more spending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca vayas de compras con hambre o muy estresado: ese 1 ％ de estrés adicional genera un 50 ％ más de gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne faites jamais vos courses le ventre vide ou extrêmement stressé : 1 ％ de stress supplémentaire entraîne 50 ％ de dépenses en plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी भी भूखे पेट या अत्यधिक तनाव में खरीदारी करने न जाएं - 1％ अतिरिक्त तनाव 50％ अधिक खर्च का कारण बनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non andare mai a fare shopping affamato o estremamente stressato: quell'1％ di stress in più porta a una spesa maggiore del 50％."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空腹や極度のストレスを抱えた状態で買い物に行くのは絶対にやめてください。1％ の余分なストレスが 50％ の支出増加につながります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배고프거나 극심한 스트레스를 받으며 쇼핑하지 마세요. 1％의 추가 스트레스로 인해 50％ 더 많은 지출이 발생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga nooit hongerig of extreem gestresst winkelen: 1％ extra stress leidt tot 50％ meer bestedingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy nie chodź na zakupy głodny ani bardzo zestresowany – 1％ dodatkowego stresu prowadzi do 50％ większych wydatków."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca vá às compras com fome ou extremamente estressado – esse 1％ de estresse extra leva a 50％ mais gastos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не ходите за покупками голодным или в состоянии крайнего стресса – 1％ дополнительного стресса приводит к 50％ большим расходам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asla aç veya aşırı stresli bir şekilde alışverişe gitmeyin; ％1 ekstra stres ％50 daha fazla harcamaya yol açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿在饥饿或极度压力下购物——额外1％的压力会导致50％的额外支出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永遠不要餓著肚子或壓力過大去購物 - 1％ 的額外壓力會導致 50％ 的額外支出。"
          }
        }
      }
    },
    "assessment.finance.profile.impulsiver.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche deine Kreditkartendaten aus der Auto-Fill-Funktion deines Browsers. Die 10 Sekunden, um die Karte zu holen, stoppen 80％ deiner Impulskäufe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete your credit card information from your browser's autofill feature. The 10 seconds to get the card stops 80％ of your impulse purchases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimine la información de su tarjeta de crédito de la función de autocompletar de su navegador. Los 10 segundos para conseguir la tarjeta frenan el 80％ de tus compras impulsivas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez les informations de votre carte de crédit de la fonction de saisie automatique de votre navigateur. Les 10 secondes pour obtenir la carte stoppent 80％ de vos achats impulsifs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ब्राउज़र की ऑटोफ़िल सुविधा से अपने क्रेडिट कार्ड की जानकारी हटाएँ। कार्ड प्राप्त करने के 10 सेकंड में आपकी 80％ खरीदारी रुक जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina i dati della tua carta di credito dalla funzione di compilazione automatica del browser. I 10 secondi per ottenere la carta bloccano l'80％ dei tuoi acquisti d'impulso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザの自動入力機能からクレジット カード情報を削除します。カードを取得するまでの 10 秒で、衝動買いの 80％ が阻止されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저의 자동완성 기능에서 신용카드 정보를 삭제하세요. 카드를 받는 데 10초가 걸리면 충동 구매의 80％가 중단됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder uw creditcardgegevens uit de functie voor automatisch aanvullen van uw browser. De 10 seconden om de kaart te krijgen, stopt 80％ van uw impulsaankopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń informacje o karcie kredytowej z funkcji automatycznego uzupełniania w przeglądarce. 10 sekund na otrzymanie karty zatrzymuje 80％ zakupów impulsywnych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua as informações do seu cartão de crédito do recurso de preenchimento automático do seu navegador. Os 10 segundos para obter o cartão interrompem 80％ de suas compras por impulso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите данные своей кредитной карты из функции автозаполнения вашего браузера. Те 10 секунд, чтобы достать карту, останавливают 80％ ваших импульсивных покупок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcınızın otomatik doldurma özelliğinden kredi kartı bilgilerinizi silin. Kartı almak için 10 saniye, anlık alışverişlerinizin ％80'ini durdurur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从你浏览器的自动填写功能中删除你的信用卡信息。花10秒钟去拿信用卡可以阻止你80％的冲动购物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從瀏覽器的自動填入功能中刪除您的信用卡資訊。辦卡的 10 秒可以阻止您 80％ 的衝動購買。"
          }
        }
      }
    },

    "prog_strength_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Zeit! Absolviere %lld Runden so schnell wie möglich mit sauberer Form. Ziel: Bei hohem Puls Technik beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For time! Complete %lld rounds as fast as possible with clean form. Goal: Maintain technique at high heart rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡A tiempo! Completa %lld rondas lo más rápido posible con una forma limpia. Objetivo: Mantener la técnica con pulso alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'heure ! Terminez les tours %lld le plus rapidement possible avec un formulaire propre. Objectif : Maintenir la technique avec un pouls élevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय पर! यथाशीघ्र स्वच्छ फॉर्म के साथ %lld राउंड पूरे करें। लक्ष्य: उच्च पल्स के साथ तकनीक बनाए रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In tempo! Completa %lld round il più velocemente possibile con una forma pulita. Obiettivo: mantenere la tecnica con un polso elevato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムトライアル！きれいなフォームで %lld ラウンドをできるだけ早く完了してください。目標: 高い心拍数でもテクニックを維持する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 기록! 깔끔한 자세로 가능한 한 빨리 %lld 라운드를 완료하세요. 목표: 높은 심박수에서도 기술 유지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op tijd! Voltooi %lld rondes zo snel mogelijk met een goede vorm. Doel: Techniek behouden bij een hoge hartslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na czas! Wykonaj %lld rund jak najszybciej, zachowując dobrą formę. Cel: Utrzymanie techniki przy wysokim tętnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tempo! Conclua %lld rodadas o mais rápido possível com boa forma. Objetivo: Manter a técnica com frequência cardíaca alta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tempo! Conclua %lld rodadas o mais rápido possível com boa forma. Objetivo: Manter a técnica com frequência cardíaca alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На время! Выполните %lld раундов как можно быстрее с чистой формой. Цель: Сохранять технику при высоком пульсе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanında! Temiz formla %ll turları mümkün olduğunca çabuk tamamlayın. Hedef: Tekniği yüksek nabızla sürdürmek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计时！以标准姿势尽可能快地完成 %lld 轮。目标：在高心率下保持技巧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時！以標準姿勢盡可能快地完成 %lld 輪。目標：在高心率下保持技巧。"
          }
        }
      }
    },

    "prog_cleaning_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasche deine Bettwäsche oder beziehe das Bett neu. Ein frisches Bett verbessert die Schlafqualität enorm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash your bedding or remake the bed. A fresh bed improves the quality of sleep enormously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava tu ropa de cama o rehace la cama. Una cama limpia mejora enormemente la calidad del sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavez votre literie ou refaites le lit. Un lit frais améliore énormément la qualité du sommeil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बिस्तर धोएं या बिस्तर का पुनर्निर्माण करें। ताजा बिस्तर नींद की गुणवत्ता में काफी सुधार करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava la biancheria da letto o rifai il letto. Un letto fresco migliora enormemente la qualità del sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寝具を洗濯したり、ベッドをリメイクしたりしてください。新鮮なベッドは睡眠の質を大幅に向上させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침구를 세탁하거나 침대를 새로 만드세요. 깨끗한 침대는 수면의 질을 엄청나게 향상시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Was uw beddengoed of maak het bed opnieuw op. Een fris bed verbetert de slaapkwaliteit enorm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umyj pościel lub przerób łóżko. Świeże łóżko ogromnie poprawia jakość snu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave sua roupa de cama ou refaça a cama. Uma cama limpa melhora enormemente a qualidade do sono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave sua roupa de cama ou refaça a cama. Uma cama limpa melhora enormemente a qualidade do sono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постирайте постельное белье или перестелите постель. Свежая постель значительно улучшает качество сна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatağınızı yıkayın veya yatağı yeniden yapın. Temiz bir yatak, uyku kalitesini büyük ölçüde artırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清洗床上用品或重新整理床铺。一张干净的床可以极大地提高睡眠质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清洗寢具或重新整理床鋪。一張乾淨的床可以大大提高睡眠品質。"
          }
        }
      }
    },

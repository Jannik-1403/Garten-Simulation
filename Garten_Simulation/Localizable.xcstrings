        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई अपने हेजहोग का नाम बदलकर '%@' करना चाहते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi davvero rinominare il tuo riccio in '%@'?"

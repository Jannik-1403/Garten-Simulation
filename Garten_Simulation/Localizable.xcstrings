    "body.tracking.status.cutting.perfect.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fettabbau läuft sauber. Makros beibehalten. Training intensiv fortführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat loss is clean. Maintain macros. Continue intensive training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pérdida de grasa es limpia. Mantén los macros. Continúa el entrenamiento intensivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La perte de graisse se déroule sans problème. Maintenir les macros. Continuez à vous entraîner de manière intensive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वसा हानि सुचारू रूप से होती है। मैक्रोज़ बनाए रखें. गहनता से प्रशिक्षण जारी रखें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La perdita di grasso procede senza intoppi. Mantenere le macro. Continua ad allenarti intensamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat loss goes smoothly.マクロを保守します。集中的にトレーニングを続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체지방 감량은 순조롭게 진행됩니다. 매크로를 유지합니다. 집중적으로 훈련을 계속하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetverlies verloopt soepel. Macro's onderhouden. Blijf intensief trainen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrata tkanki tłuszczowej przebiega gładko. Utrzymuj makra. Kontynuuj intensywne treningi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A perda de gordura ocorre sem problemas. Manter macros. Continue treinando intensamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perda de gordura ocorre sem problemas. Manter macros. Continue treinando intensamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеря жира проходит гладко. Поддерживать макросы. Продолжайте интенсивно тренироваться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağ kaybı sorunsuz bir şekilde gerçekleşir. Makroları koruyun. Yoğun bir şekilde eğitime devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减脂进展顺利。维护宏。继续强化训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減脂進展順利。維護宏。繼續強化訓練。"
          }
        }
      }
    },

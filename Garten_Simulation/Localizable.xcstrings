        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0436\u0430\u0436\u0434\u0430 \u0437\u043d\u0430\u043d\u0438\u0439"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgiye Susuzluk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c42\u77e5\u6b32"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0d\u77e5\u8b58\u7684\u6e34\u6c42"
          }
        }
      }
    },
    "pfad_lernen_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze 7 Tage Lesen. Dein Wissen w\u00e4chst wie dein Garten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full 7 days of reading. Your knowledge grows like your garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "7 d\u00edas enteros de lectura. Tu conocimiento crece como tu jard\u00edn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 jours entiers de lecture. Ton savoir grandit comme ton jardin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u092a\u0942\u0930\u0947 7 \u0926\u093f\u0928\u0964 \u0906\u092a\u0915\u093e \u091c\u094d\u091e\u093e\u0928 \u0906\u092a\u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u0940 \u0924\u0930\u0939 \u092c\u0922\u093c\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interi 7 giorni di lettura. La tua conoscenza cresce come il tuo giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u308b\u307e\u308b7\u65e5\u9593\u306e\u8aad\u66f8\u3002\u3042\u306a\u305f\u306e\u77e5\u8b58\u306f\u3042\u306a\u305f\u306e\u5ead\u306e\u3088\u3046\u306b\u6210\u9577\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7\uc77c\uac04\uc758 \ub3c5\uc11c. \ub2f9\uc2e0\uc758 \uc9c0\uc2dd\uc740 \uc815\uc6d0\ucc98\ub7fc \uc790\ub78d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 volle dagen leesplezier. Je kennis groeit als je tuin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe\u0142ne 7 dni czytania. Twoja wiedza ro\u015bnie jak Tw\u00f3j ogr\u00f3d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dias inteiros de leitura. O teu conhecimento cresce como o teu jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u043b\u044b\u0445 7 \u0434\u043d\u0435\u0439 \u0447\u0442\u0435\u043d\u0438\u044f. \u0422\u0432\u043e\u0438 \u0437\u043d\u0430\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0443\u0442, \u043a\u0430\u043a \u0442\u0432\u043e\u0439 \u0441\u0430\u0434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam 7 g\u00fcn okuma. Bilginiz bah\u00e7eniz gibi b\u00fcy\u00fcr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6574\u65747\u5929\u9605\u8bfb\u3002\u4f60\u7684\u77e5\u8bc6\u50cf\u4f60\u7684\u82b1\u56ed\u4e00\u6837\u6210\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "7\u5929\u7684\u95b1\u8b80\u6642\u9593\u3002\u4f60\u7684\u77e5\u8b58\u5c31\u50cf\u4f60\u7684\u82b1\u5712\u4e00\u6a23\u6210\u9577\u3002"
          }
        }
      }
    },

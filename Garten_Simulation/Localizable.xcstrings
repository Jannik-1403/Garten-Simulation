    "tour_plant_streak_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du den aktuellen Streak und die XP dieser spezifischen Pflanze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see the current streak and XP of this specific plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes ver la racha actual y los XP de esta planta en específico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, vous pouvez voir la séquence actuelle et l'XP de cette plante spécifique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ आप इस विशिष्ट पौधे की वर्तमान स्ट्रीक और एक्सपी देख सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi vedere la serie attuale e l'XP di questa pianta specifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで、この特定の植物の現在の連続記録とXPを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 이 특정 식물의 현재 연속 기록과 XP를 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zie je de huidige streak en XP van deze specifieke plant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj możesz zobaczyć obecną passę i XP tej konkretnej rośliny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui você pode ver a sequência atual e o XP desta planta específica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui você pode ver a sequência atual e o XP desta planta específica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь вы можете увидеть текущую серию и опыт этого конкретного растения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bu belirli bitkinin mevcut serisini ve XP'sini görebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里您可以看到该特定植物的当前连胜和 XP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡您可以看到該特定植物的當前連勝和 XP。"
          }

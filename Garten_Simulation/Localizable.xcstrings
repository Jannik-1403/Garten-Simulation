    "prog_selfcare_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh 20 Minuten spazieren. Ohne Musik, ohne Podcast, ohne Begleitung. Nur du und deine Gedanken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go for a 20 minute walk. Without music, without podcast, without accompaniment. Just you and your thoughts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realice una caminata de 20 minutos. Sin música, sin podcast, sin acompañamiento. Sólo tú y tus pensamientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une promenade de 20 minutes. Sans musique, sans podcast, sans accompagnement. Juste vous et vos pensées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "20 मिनट की सैर पर जाएं. बिना संगीत के, बिना पॉडकास्ट के, बिना संगत के। बस आप और आपके विचार."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una passeggiata di 20 minuti. Senza musica, senza podcast, senza accompagnamento. Solo tu e i tuoi pensieri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "20分ほど歩いてみましょう。音楽なし、ポッドキャストなし、伴奏なし。ただあなたとあなたの考えだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "20분 정도 걸어보세요. 음악도 없고, 팟캐스트도 없고, 반주도 없습니다. 당신과 당신의 생각뿐입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga een wandeling van 20 minuten maken. Zonder muziek, zonder podcast, zonder begeleiding. Alleen jij en je gedachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idź na 20-minutowy spacer. Bez muzyki, bez podcastu, bez akompaniamentu. Tylko ty i twoje myśli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma caminhada de 20 minutos. Sem música, sem podcast, sem acompanhamento. Só você e seus pensamentos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma caminhada de 20 minutos. Sem música, sem podcast, sem acompanhamento. Só você e seus pensamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьтесь на 20-минутную прогулку. Без музыки, без подкаста, без сопровождения. Только ты и твои мысли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "20 dakikalık bir yürüyüşe çıkın. Müziksiz, podcastsiz, eşliksiz. Sadece sen ve düşüncelerin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行20分钟。没有音乐，没有播客，没有伴奏。只有你和你的想法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "步行20分鐘。沒有音樂，沒有播客，沒有伴奏。只有你和你的想法。"
          }
        }
      }
    },

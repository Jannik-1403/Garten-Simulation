    "plant.erdbeerpflanze.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versorge deinen Körper täglich mit wichtigen Vitaminen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide your body with important vitamins every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciona a tu cuerpo vitaminas importantes todos los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournissez à votre corps des vitamines importantes tous les jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शरीर को रोज़ाना महत्वपूर्ण विटामिनों से पोषण दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornisci al tuo corpo vitamine importanti ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、体に重要なビタミンを補給しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 중요한 비타민을 몸에 공급하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorzie je lichaam elke dag van belangrijke vitamines."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarczaj organizmowi ważnych witamin każdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Forneça ao seu corpo vitaminas importantes todos os dias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forneça ao seu corpo vitaminas importantes todos os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневно снабжайте свой организм важными витаминами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuza her gün önemli vitaminler sağlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天为你的身体提供重要的维生素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天為您的身體提供重要的維生素。"
          }
        }
      }
    },
    "plant.eukalyptus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinigt die Luft von innen – Atemübungen & Breathwork"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleans the air from within – Breathing exercises & Breathwork"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia el aire desde dentro – Respiración y Breathwork"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifie l'air de l'intérieur – exercices de respiration"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंदर से हवा को साफ करता है – श्वास अभ्यास और ब्रेथवर्क"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifica l'aria dall'interno – esercizi di respirazione e respirazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内側から空気をきれいにする – 呼吸法とブレスワーク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 공기를 정화합니다 – 호흡 운동 & 호흡법"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinigt de lucht van binnenuit – Ademhalingsoefeningen & Ademwerk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczyszcza powietrze od wewnątrz – ćwiczenia oddechowe i praca oddechowa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifica o ar por dentro – exercícios de respiração"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifica o ar por dentro – exercícios de respiração"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищает воздух изнутри – дыхательные упражнения и пранаяма"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Havayı içeriden temizler – Nefes egzersizleri ve Nefes Çalışması"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从内而外净化空气——呼吸练习与呼吸法"
          }

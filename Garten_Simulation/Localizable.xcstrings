    "prog_screentime_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Handy bleibt draußen, wenn du aufs Klo gehst oder duschst. Das Badezimmer ist eine No-Phone-Zone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cell phone stays outside when you go to the toilet or shower. The bathroom is a no-phone zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El móvil se queda afuera cuando vas al baño o te duchas. El baño es una zona sin teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone portable reste à l'extérieur lorsque vous allez aux toilettes ou à la douche. La salle de bain est une zone sans téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप शौचालय या स्नान के लिए जाते हैं तो सेल फ़ोन बाहर ही रह जाता है। बाथरूम नो-फ़ोन ज़ोन है."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cellulare resta fuori quando si va in bagno o si fa la doccia. Il bagno è una zona senza telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トイレやシャワーに行くとき、携帯電話は外に置いておきます。浴室は電話禁止ゾーンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화장실에 가거나 샤워할 때 휴대폰은 밖에 둡니다. 화장실은 전화 금지 구역입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mobiele telefoon blijft buiten als u naar het toilet of de douche gaat. De badkamer is een telefoonvrije zone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon komórkowy pozostaje na zewnątrz, kiedy idziesz do toalety lub pod prysznic. Łazienka to strefa bez telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular fica do lado de fora quando você vai ao banheiro ou ao banho. O banheiro é uma zona sem telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular fica do lado de fora quando você vai ao banheiro ou ao banho. O banheiro é uma zona sem telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мобильный телефон остается снаружи, когда вы идете в туалет или душ. Ванная комната — зона без телефона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvalete veya duşa gittiğinizde cep telefonu dışarıda kalıyor. Banyo telefonsuz bir bölgedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你上厕所或淋浴时，手机放在外面。浴室是禁止打电话的区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你上廁所或淋浴時，手機放在外面。浴室是禁止打電話的區域。"
          }
        }
      }
    },

    "weather.rule.duerre": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fcrre-Alarm: Heute zweimal gie\u00dfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drought alert: Water twice today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarma de sequ\u00eda: Hoy riegue dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerte s\u00e9cheresse : arrose deux fois aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0942\u0916\u0947 \u0915\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940: \u0906\u091c \u0926\u094b \u092c\u093e\u0930 \u092a\u093e\u0928\u0940 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Drought alert: Water twice today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e72\u3070\u3064\u8b66\u5831: \u4eca\u65e5\u306f2\u56de\u6c34\u3092\u4e0e\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac00\ubb44 \uacbd\ubcf4: \uc624\ub298 \ubb3c\uc744 \ub450 \ubc88 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Droogtewaarschuwing: vandaag twee keer water geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrze\u017cenie o suszy: dzisiaj podlewaj dwa razy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerta de seca: rega duas vezes hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435 \u043e \u0437\u0430\u0441\u0443\u0445\u0435: \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u043e\u043b\u0435\u0439\u0442\u0435 \u0434\u0432\u0430\u0436\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurakl\u0131k uyar\u0131s\u0131: Bug\u00fcn iki kez su verilecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e72\u65f1\u8b66\u62a5\uff1a\u4eca\u5929\u6d47\u6c34\u4e24\u6b21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e7e\u65f1\u8b66\u5831\uff1a\u4eca\u5929\u6f86\u6c34\u5169\u6b21\u3002"
          }
        }
      }
    },

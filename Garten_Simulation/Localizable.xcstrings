    "igel_name_edit_hint_free": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Namens\u00e4nderung ist v\u00f6llig kostenlos!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first name change is completely free!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1El primer cambio de nombre es totalmente gratis!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier changement de nom est enti\u00e8rement gratuit !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0925\u092e \u0928\u093e\u092e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo cambio di nome \u00e8 completamente gratuito!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u521d\u306e\u540d\u524d\u5909\u66f4\u306f\u5b8c\u5168\u306b\u7121\u6599\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ub984 \ubcc0\uacbd\uc740 \uc644\uc804 \ubb34\ub8cc\uc785\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voornaamswijziging is geheel gratis!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana imienia jest ca\u0142kowicie bezp\u0142atna!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira altera\u00e7\u00e3o de nome \u00e9 totalmente gratuita!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0432\u043e\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0438\u043c\u0435\u043d\u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lk isim de\u011fi\u015fikli\u011fi tamamen \u00fccretsizdir!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b2c\u4e00\u6b21\u66f4\u6539\u540d\u79f0\u662f\u5b8c\u5168\u514d\u8d39\u7684\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b2c\u4e00\u6b21\u66f4\u540d\u662f\u5b8c\u5168\u514d\u8cbb\u7684\uff01"
          }
        }
      }
    },
    "igel_name_edit_hint_paid": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede weitere Namens\u00e4nderung kostet M\u00fcnzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each subsequent name change costs coins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio de nombre adicional cuesta monedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque changement de nom suppl\u00e9mentaire co\u00fbte des pi\u00e8ces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0928\u093e\u092e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u093f\u0915\u094d\u0915\u0947 \u0916\u0930\u094d\u091a \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni successivo cambio di nome costa monete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u306e\u5f8c\u306e\u540d\u524d\u5909\u66f4\u306b\u306f\u30b3\u30a4\u30f3\u304c\u304b\u304b\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ud6c4\uc758 \uc774\ub984 \ubcc0\uacbd\uc5d0\ub294 \ucf54\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke volgende naamswijziging kost munten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cda kolejna zmiana nazwy kosztuje monety."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada altera\u00e7\u00e3o de nome adicional custa moedas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u043e\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0438\u043c\u0435\u043d\u0438 \u0441\u0442\u043e\u0438\u0442 \u043c\u043e\u043d\u0435\u0442\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki her isim de\u011fi\u015fikli\u011finin maliyeti jetondur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u989d\u5916\u7684\u540d\u79f0\u66f4\u6539\u90fd\u9700\u8981\u82b1\u8d39\u91d1\u5e01\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u66f4\u6539\u540d\u7a31\u90fd\u9700\u8981\u82b1\u8cbb\u91d1\u5e63\u3002"
          }
        }
      }
    },

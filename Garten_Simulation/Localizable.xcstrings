    "focus.session.cancelled.app_left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die App zu lange verlassen. Dein Fokus-Timer wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the app for too long. Your focus timer was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaste la app demasiado tiempo. Tu temporizador de enfoque fue cancelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez quitt\u00e9 l'application trop longtemps. Votre minuteur de concentration a \u00e9t\u00e9 annul\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092c\u0939\u0941\u0924 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0938\u0947 \u0910\u092a \u0938\u0947 \u0926\u0942\u0930 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0915\u0938 \u091f\u093e\u0907\u092e\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai lasciato l'app troppo a lungo. Il tuo timer di concentrazione \u00e8 stato annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30d7\u30ea\u3092\u9577\u6642\u9593\u96e2\u308c\u3066\u3044\u307e\u3057\u305f\u3002\u30d5\u30a9\u30fc\u30ab\u30b9\u30bf\u30a4\u30de\u30fc\u304c\u30ad\u30e3\u30f3\u30bb\u30eb\u3055\u308c\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571\uc744 \ub108\ubb34 \uc624\ub798 \ubc97\uc5b4\ub0ac\uc2b5\ub2c8\ub2e4. \ud3ec\ucee4\uc2a4 \ud0c0\uc774\uba38\uac00 \ucde8\uc18c\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verliet de app te lang. Je focustimer is geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By\u0142e\u015b poza aplikacj\u0105 zbyt d\u0142ugo. Tw\u00f3j timer skupienia zosta\u0142 anulowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficaste fora da app durante tempo demais. O teu temporizador de foco foi cancelado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0434\u043e\u043b\u0433\u043e \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u0412\u0430\u0448 \u0442\u0430\u0439\u043c\u0435\u0440 \u0444\u043e\u043a\u0443\u0441\u0430 \u0431\u044b\u043b \u043e\u0442\u043c\u0435\u043d\u0435\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamay\u0131 \u00e7ok uzun s\u00fcre terk ettiniz. Odak zamanlay\u0131c\u0131n\u0131z iptal edildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u79bb\u5f00\u5e94\u7528\u592a\u4e45\u4e86\u3002\u4f60\u7684\u4e13\u6ce8\u8ba1\u65f6\u5668\u5df2\u53d6\u6d88\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u96e2\u958b\u8a72\u61c9\u7528\u7a0b\u5f0f\u7684\u6642\u9593\u592a\u9577\u4e86\u3002\u60a8\u7684\u5c08\u6ce8\u8a08\u6642\u5668\u5df2\u88ab\u53d6\u6d88\u3002"
          }
        }
      }
    },

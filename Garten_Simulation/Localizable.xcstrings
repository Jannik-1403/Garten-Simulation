    "assessment.fitness.q8.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sage ihnen, dass ich in 60 Minuten komme, und ziehe mein Workout vorher in Rekordzeit durch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tell them I'll be there in 60 minutes and do my workout beforehand in record time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les digo que estaré allí en 60 minutos y haré mi entrenamiento antes en un tiempo récord."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je leur dis que je serai là dans 60 minutes et que je ferai mon entraînement à l'avance en un temps record."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं उनसे कहता हूं कि मैं 60 मिनट में वहां पहुंच जाऊंगा और रिकॉर्ड समय में अपना वर्कआउट पहले ही कर लूंगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dico loro che sarò lì tra 60 minuti e che farò il mio allenamento in anticipo a tempo di record."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は彼らに60分以内に到着することを伝え、事前に記録的な速さでトレーニングをしておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 그들에게 60분 후에 도착할 것이라고 말하고 기록적인 시간 내에 미리 운동을 할 것이라고 말했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik vertel ze dat ik er over 60 minuten ben en doe mijn training vooraf in recordtijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówię im, że będę na miejscu za 60 minut i wykonam trening wcześniej w rekordowym czasie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digo a eles que estarei lá em 60 minutos e farei meu treino antes em tempo recorde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я говорю им, что приду через 60 минут, и провожу свою тренировку раньше в рекордные сроки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onlara 60 dakika içinde orada olacağımı ve rekor sürede antrenmanımı yapacağımı söylüyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我告诉他们我60分钟后到，并在之前以创纪录的速度完成我的锻炼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我告訴他們我會在 60 分鐘內到達那裡，並以創紀錄的時間提前做好鍛鍊。"
          }
        }
      }
    },
    "assessment.fitness.q8.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {

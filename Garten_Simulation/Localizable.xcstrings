    "prog_teeth_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahnseide ist wichtiger als das Putzen der Kauflächen. Reinige heute jeden einzelnen Zahnzwischenraum penibel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flossing is more important than brushing the chewing surfaces. Clean every single space between your teeth meticulously today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar hilo dental es más importante que cepillar las superficies de masticación. Limpie meticulosamente cada espacio entre sus dientes hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utilisation de la soie dentaire est plus importante que le brossage des surfaces à mâcher. Nettoyez méticuleusement chaque espace entre vos dents aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चबाने वाली सतहों को ब्रश करने की तुलना में फ्लॉसिंग अधिक महत्वपूर्ण है। आज ही अपने दांतों के बीच की हर जगह को सावधानीपूर्वक साफ करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usare il filo interdentale è più importante che spazzolare le superfici masticatorie. Pulisci meticolosamente ogni singolo spazio tra i denti oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フロスは咀嚼面を磨くよりも重要です。今日は歯と歯の間を隅々まで丁寧に掃除しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "씹는 표면을 닦는 것보다 치실을 사용하는 것이 더 중요합니다. 오늘은 치아 사이의 공간 하나하나 꼼꼼하게 닦아주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flossen is belangrijker dan het poetsen van de kauwvlakken. Maak vandaag nog elke ruimte tussen uw tanden zorgvuldig schoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitkowanie jest ważniejsze niż szczotkowanie powierzchni żujących. Już dziś dokładnie wyczyść każdą przestrzeń między zębami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar fio dental é mais importante do que escovar as superfícies de mastigação. Limpe meticulosamente cada espaço entre os dentes hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar fio dental é mais importante do que escovar as superfícies de mastigação. Limpe meticulosamente cada espaço entre os dentes hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование нити более важно, чем чистка жевательных поверхностей. Сегодня тщательно очистите каждое пространство между зубами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diş ipi kullanmak çiğneme yüzeylerini fırçalamaktan daha önemlidir. Bugün dişlerinizin arasındaki her boşluğu titizlikle temizleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用牙线比刷咀嚼面更重要。今天仔细清洁牙齿之间的每一个空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用牙線比刷咀嚼面更重要。今天仔細清潔牙齒之間的每個空間。"
          }
        }
      }
    },
    "prog_teeth_d1_t1": {
      "extractionState": "manual",
      "localizations": {

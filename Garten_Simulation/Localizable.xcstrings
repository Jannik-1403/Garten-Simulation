    "effekt.sturm.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak-Schutz aktiv \u2014 kein Streak-Verlust heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak protection active \u2014 no streak loss today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protecci\u00f3n de racha activa \u2014 sin p\u00e9rdida de racha hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection de s\u00e9rie active \u2014 pas de perte de s\u00e9rie aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0915\u094d\u0930\u093f\u092f - \u0906\u091c \u0915\u094b\u0908 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0939\u093e\u0928\u093f \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak protection active \u2014 no streak loss today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30ea\u30fc\u30af\u4fdd\u8b77\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u3067\u3059 - \u4eca\u65e5\u306f\u30b9\u30c8\u30ea\u30fc\u30af\u640d\u5931\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5f0\uc18d \ubc29\uc9c0\uac00 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc624\ub298\uc740 \uc5f0\uc18d \uc190\uc2e4\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherming tegen strepen actief - vandaag geen verlies van strepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrona przed smugami aktywna \u2014 dzisiaj nie ma utraty serii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prote\u00e7\u00e3o de sequ\u00eancia ativa \u2014 sem perda de sequ\u00eancia hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0449\u0438\u0442\u0430 \u0441\u0435\u0440\u0438\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0430 \u2014 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u043e\u0442\u0435\u0440\u044f \u0441\u0435\u0440\u0438\u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7izgi korumas\u0131 etkin \u2014 bug\u00fcn \u00e7izgi kayb\u0131 yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fde\u7eed\u5956\u52b1\u4fdd\u62a4\u5df2\u6fc0\u6d3b\u2014\u2014\u4eca\u5929\u4e0d\u4f1a\u5931\u53bb\u8fde\u7eed\u5956\u52b1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9023\u52dd\u4fdd\u8b77\u5df2\u555f\u52d5\u2014\u2014\u4eca\u5929\u6c92\u6709\u9023\u52dd\u3002"
          }
        }
      }
    },

    "onboarding_tutorial_powerup_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gebe dir verschiedene Effekte für den Garten. Benutze sie um schöne Fortschritte zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll give you various effects for the garden. Use them to make beautiful progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te daré varios efectos para el jardín. Úsalos para lograr un progreso hermoso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais te donner divers effets pour le jardin. Utilise-les pour faire de beaux progrès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं आपको बगीचे के लिए अलग-अलग प्रभाव देता हूं। अच्छी प्रगति करने के लिए उनका उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti darò vari effetti per il giardino. Usali per fare bei progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お庭にさまざまな効果を与えます。それらを使用して、美しい進歩を遂げましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원에 다양한 효과를 드려요. 이를 사용하여 아름다운 발전을 이루세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik geef je verschillende effecten voor de tuin. Gebruik ze om mooie vooruitgang te boeken."
          }

    "trash.doener_dauerkarte.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4nge deinen liebsten gesunden Snack gut sichtbar in der K\u00fcche auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display your favorite healthy snack prominently in the kitchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca tu snack saludable favorito bien visible en la cocina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place ton en-cas sain pr\u00e9f\u00e9r\u00e9 bien en vue dans la cuisine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0938\u092c\u0938\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f\u0935\u0930\u094d\u0927\u0915 \u0938\u094d\u0928\u0948\u0915 \u0915\u094b \u0930\u0938\u094b\u0908 \u092e\u0947\u0902 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0932\u091f\u0915\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esponi il tuo snack sano preferito ben in vista in cucina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u6c17\u306b\u5165\u308a\u306e\u5065\u5eb7\u7684\u306a\u30b9\u30ca\u30c3\u30af\u3092\u30ad\u30c3\u30c1\u30f3\u3067\u76ee\u7acb\u3064\u3068\u3053\u308d\u306b\u98fe\u308a\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc88b\uc544\ud558\ub294 \uac74\uac15\ud55c \uac04\uc2dd\uc744 \uc8fc\ubc29\uc5d0 \ub208\uc5d0 \ub744\uac8c \uc804\uc2dc\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang je favoriete gezonde snack goed zichtbaar op in de keuken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powie\u015b sw\u00f3j ulubiony zdrowy przek\u0105sek dobrze widoczny w kuchni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponha seu lanche saud\u00e1vel favorito em destaque na cozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0435\u0441\u044c\u0442\u0435 \u0441\u0432\u043e\u044e \u043b\u044e\u0431\u0438\u043c\u0443\u044e \u0437\u0434\u043e\u0440\u043e\u0432\u0443\u044e \u0437\u0430\u043a\u0443\u0441\u043a\u0443 \u043d\u0430 \u0432\u0438\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u043d\u0430 \u043a\u0443\u0445\u043d\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En sevdi\u011fin sa\u011fl\u0131kl\u0131 at\u0131\u015ft\u0131rmal\u0131\u011f\u0131 mutfakta g\u00f6ze \u00e7arpan bir yere koy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u60a8\u6700\u559c\u6b22\u7684\u5065\u5eb7\u96f6\u98df\u6302\u5728\u53a8\u623f\u7684\u663e\u7740\u4f4d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u60a8\u6700\u559c\u6b61\u7684\u5065\u5eb7\u96f6\u98df\u639b\u5728\u5eda\u623f\u7684\u986f\u773c\u4f4d\u7f6e\u3002"
          }
        }
      }
    },
    "trash.doener_dauerkarte.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastfood t\u00e4glich erh\u00f6ht Entz\u00fcndungen im K\u00f6rper \u2013 das sp\u00fcrst du nach Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily fast food increases inflammation in the body \u2013 you feel it after weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El consumo diario de comida r\u00e1pida aumenta la inflamaci\u00f3n en el cuerpo: lo notas despu\u00e9s de semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration rapide quotidienne augmente les inflammations dans le corps \u2013 tu le ressens apr\u00e8s des semaines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0948\u0928\u093f\u0915 \u092b\u093e\u0938\u094d\u091f\u092b\u0942\u0921 \u0936\u0930\u0940\u0930 \u092e\u0947\u0902 \u0938\u0942\u091c\u0928 \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948 \u2013 \u0906\u092a \u0907\u0938\u0947 \u0939\u092b\u094d\u0924\u094b\u0902 \u092c\u093e\u0926 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0947\u0902\u0917\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fast food quotidiano aumenta le infiammazioni nel corpo \u2013 lo senti dopo settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u30d5\u30a1\u30b9\u30c8\u30d5\u30fc\u30c9\u3092\u98df\u3079\u308b\u3068\u4f53\u5185\u306e\u708e\u75c7\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u6570\u9031\u9593\u5f8c\u306b\u306f\u305d\u308c\u3092\u611f\u3058\u308b\u3067\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \ud328\uc2a4\ud2b8\ud478\ub4dc\ub97c \uba39\uc73c\uba74 \uccb4\ub0b4 \uc5fc\uc99d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4 \u2013 \uba87 \uc8fc \ud6c4\uc5d0 \ub290\ub084 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijks fastfood verhoogt ontstekingen in het lichaam \u2013 dat voel je na weken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codzienne fast foody zwi\u0119kszaj\u0105 stany zapalne w ciele \u2013 czujesz to po tygodniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food di\u00e1rio aumenta inflama\u00e7\u00f5es no corpo \u2013 voc\u00ea sente isso ap\u00f3s semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0441\u0442\u0444\u0443\u0434 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u0435\u0442 \u0432\u043e\u0441\u043f\u0430\u043b\u0435\u043d\u0438\u0435 \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0435 \u2013 \u0432\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u0442\u0435 \u044d\u0442\u043e \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck fast food v\u00fccuttaki iltihab\u0131 art\u0131r\u0131r \u2013 bunu haftalar sonra hissedersiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u5403\u5feb\u9910\u4f1a\u589e\u52a0\u4f53\u5185\u7684\u708e\u75c7\u2014\u2014\u51e0\u5468\u540e\u4f60\u5c31\u4f1a\u6ce8\u610f\u5230\u8fd9\u4e00\u70b9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u5403\u5feb\u9910\u6703\u589e\u52a0\u9ad4\u5167\u7684\u767c\u708e\u2014\u2014\u5e7e\u9031\u5f8c\u4f60\u5c31\u6703\u6ce8\u610f\u5230\u9019\u4e00\u9ede\u3002"
          }
        }
      }
    },
    "trash.doener_dauerkarte.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereite dein Mittagessen vor \u2013 dann ist der D\u00f6ner-Reflex gar nicht n\u00f6tig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare your lunch in advance \u2013 then the kebab reflex isn't necessary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara tu almuerzo con antelaci\u00f3n: as\u00ed no necesitar\u00e1s el reflejo del d\u00f6ner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9pare ton d\u00e9jeuner \u00e0 l'avance \u2013 l'envie de kebab ne sera alors plus n\u00e9cessaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u0926\u094b\u092a\u0939\u0930 \u0915\u093e \u0916\u093e\u0928\u093e \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u094b \u2013 \u0924\u092c \u0921\u094b\u0928\u0947\u0930 \u0930\u093f\u092b\u094d\u0932\u0947\u0915\u094d\u0938 \u0915\u0940 \u0915\u094b\u0908 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara il tuo pranzo in anticipo \u2013 cos\u00ec il riflesso del kebab non \u00e8 necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u663c\u98df\u3092\u4e8b\u524d\u306b\u6e96\u5099\u3057\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002\u305d\u3046\u3059\u308c\u3070\u3001\u30b1\u30d0\u30d6\u3078\u306e\u53cd\u5c04\u7684\u306a\u6b32\u6c42\u306f\u306a\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc810\uc2ec\uc744 \ubbf8\ub9ac \uc900\ube44\ud558\uc138\uc694 \u2013 \uadf8\ub7ec\uba74 \ub3c4\ub108 \ucf00\ubc25 \ubc18\uc751\uc774 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereid je middageten voor \u2013 dan is de kebab-reflex helemaal niet nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj sw\u00f3j lunch z wyprzedzeniem \u2013 wtedy odruch kebabowy nie b\u0119dzie konieczny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare seu almo\u00e7o com anteced\u00eancia \u2013 ent\u00e3o o reflexo do d\u00f6ner n\u00e3o \u00e9 necess\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u0441\u0435\u0431\u0435 \u043e\u0431\u0435\u0434 \u2013 \u0442\u043e\u0433\u0434\u0430 \u0440\u0435\u0444\u043b\u0435\u043a\u0441 \u043d\u0430 \u0448\u0430\u0448\u043b\u044b\u043a \u043d\u0435 \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u0438\u0442\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6\u011fle yeme\u011fini \u00f6nceden haz\u0131rla \u2013 o zaman d\u00f6ner refleksine gerek kalmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51c6\u5907\u597d\u4f60\u7684\u5348\u9910\u2014\u2014\u90a3\u4e48\u70e4\u8089\u4e32\u53cd\u5c04\u5c31\u6ca1\u6709\u5fc5\u8981\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e96\u5099\u597d\u4f60\u7684\u5348\u9910\u2014\u2014\u90a3\u9ebc\u70e4\u8089\u4e32\u53cd\u5c04\u5c31\u6c92\u6709\u5fc5\u8981\u4e86\u3002"
          }
        }
      }
    },
    "trash.doener_dauerkarte.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechne: Wie oft kaufst du Fastfood pro Monat und was kostet es dich?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate: how often do you buy fast food per month and what does it cost you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula: \u00bfcon qu\u00e9 frecuencia compras comida r\u00e1pida al mes y cu\u00e1nto te cuesta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule : \u00e0 quelle fr\u00e9quence ach\u00e8tes-tu de la restauration rapide par mois et combien \u00e7a te co\u00fbte ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0923\u0928\u093e \u0915\u0930\u0947\u0902: \u0906\u092a \u092e\u0939\u0940\u0928\u0947 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u092b\u093e\u0938\u094d\u091f\u092b\u0942\u0921 \u0916\u0930\u0940\u0926\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0907\u0938\u0915\u0940 \u0932\u093e\u0917\u0924 \u0906\u092a\u0915\u094b \u0915\u093f\u0924\u0928\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola: quanto spesso acquisti fast food al mese e quanto ti costa?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a08\u7b97\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u6708\u306b\u4f55\u56de\u30d5\u30a1\u30b9\u30c8\u30d5\u30fc\u30c9\u3092\u8cfc\u5165\u3057\u3001\u3044\u304f\u3089\u304b\u304b\u3063\u3066\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacc4\uc0b0\ud574 \ubcf4\uc138\uc694: \ud55c \ub2ec\uc5d0 \ud328\uc2a4\ud2b8\ud478\ub4dc\ub97c \uba87 \ubc88 \uc0ac\uace0 \ube44\uc6a9\uc774 \uc5bc\ub9c8\ub098 \ub4dc\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken: hoe vaak koop je fastfood per maand en wat kost het je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblicz: jak cz\u0119sto kupujesz fast food miesi\u0119cznie i ile ci\u0119 to kosztuje?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule: com que frequ\u00eancia voc\u00ea compra fast food por m\u00eas e quanto isso te custa?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435: \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u043e \u0432\u044b \u043f\u043e\u043a\u0443\u043f\u0430\u0435\u0442\u0435 \u0444\u0430\u0441\u0442\u0444\u0443\u0434 \u0432 \u043c\u0435\u0441\u044f\u0446 \u0438 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044d\u0442\u043e \u0432\u0430\u043c \u0441\u0442\u043e\u0438\u0442?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesapla: ayda ka\u00e7 kez fast food al\u0131yorsun ve bu sana ne kadara mal oluyor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba1\u7b97\uff1a\u60a8\u6bcf\u6708\u8d2d\u4e70\u5feb\u9910\u7684\u9891\u7387\u4ee5\u53ca\u82b1\u8d39\u662f\u591a\u5c11\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a08\u7b97\uff1a\u60a8\u6bcf\u500b\u6708\u8cfc\u8cb7\u5feb\u9910\u7684\u983b\u7387\u4ee5\u53ca\u82b1\u8cbb\u662f\u591a\u5c11\uff1f"
          }
        }
      }
    },
    "trash.doener_dauerkarte.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Zu viel Fast Food)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Gesunder Snack)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesunder Snack)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesunder Snack)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesunder Snack)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u092c\u0941\u0930\u0940 \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e \u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0926\u0902\u0921 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0938\u094d\u0935\u0938\u094d\u0925 \u0938\u094d\u0928\u0948\u0915)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0924\u0915 \u0915\u092e \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesunder Snack)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zu viel Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesunder Snack)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },

    "assessment.health.profile.optimierer.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behandelst deinen Körper wie das Präzisionsinstrument, das er ist. Guter Schlaf, saubere Ernährung, proaktive Körperpflege — dein biologisches Fundament ist stabil. Das ist der Unterschied zwischen Potenzial und Ergebnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You treat your body like the precision instrument it is. Good sleep, clean nutrition, proactive body care — your biological foundation is stable. That's the difference between potential and results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratas tu cuerpo como el instrumento de precisión que es. Buen sueño, nutrición sana, cuidado corporal proactivo: su base biológica es estable. Esa es la diferencia entre potencial y resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous traitez votre corps comme un instrument de précision. Un bon sommeil, une alimentation saine, des soins corporels proactifs : vos fondations biologiques sont stables. C'est la différence entre le potentiel et les résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tratti il ​​tuo corpo come lo strumento di precisione che è. Buon sonno, alimentazione sana, cura proattiva del corpo: le tue basi biologiche sono stabili. Questa è la differenza tra potenziale e risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の体を精密機械のように扱います。良質な睡眠、清潔な栄養、積極的なボディケア - あなたの生物学的基盤は安定しています。それが可能性と結果の違いです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 당신의 몸을 정밀 기기처럼 대합니다. 좋은 수면, 깨끗한 영양, 적극적인 신체 관리 - 생물학적 기반이 안정적입니다. 그것이 바로 가능성과 결과의 차이입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je behandelt je lichaam als het precisie-instrument dat het is. Goede slaap, schone voeding, proactieve lichaamsverzorging – uw biologische basis is stabiel. Dat is het verschil tussen potentieel en resultaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traktujesz swoje ciało jak precyzyjne narzędzie, którym jest. Dobry sen, czyste odżywianie, proaktywna pielęgnacja ciała – Twoje biologiczne podstawy są stabilne. Na tym polega różnica między potencjałem a wynikami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você trata seu corpo como o instrumento de precisão que ele é. Bom sono, nutrição limpa, cuidados proativos com o corpo – sua base biológica é estável. Essa é a diferença entre potencial e resultados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuza sanki hassas bir aletmiş gibi davranıyorsunuz. İyi uyku, temiz beslenme, proaktif vücut bakımı; biyolojik temeliniz sağlamdır. Potansiyel ile sonuçlar arasındaki fark budur."
          }
        }
      }
    },

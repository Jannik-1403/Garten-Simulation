        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u092b\u094b\u0915\u0938 \u0938\u0924\u094d\u0930 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0906\u0901\u0915\u0921\u093c\u0947 \u0926\u0947\u0916 \u0938\u0915\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la tua prima sessione di focus per vedere le statistiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d71\u8a08\u3092\u8868\u793a\u3059\u308b\u306b\u306f\u3001\u6700\u521d\u306e\u30d5\u30a9\u30fc\u30ab\u30b9\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud1b5\uacc4\ub97c \ubcf4\ub824\uba74 \uccab \ubc88\uc9f8 \ud3ec\ucee4\uc2a4 \uc138\uc158\uc744 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start je eerste focussessie om statistieken te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij pierwsz\u0105 sesj\u0119 skupienia, aby zobaczy\u0107 statystyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia a tua primeira sess\u00e3o de foco para ver as estat\u00edsticas."

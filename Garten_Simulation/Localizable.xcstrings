    "assessment.health.q9.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich google meine Symptome, gerate in Panik, tue aber praktisch nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I google my symptoms, panic, but do practically nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busco en Google mis síntomas, me entra el pánico, pero no hago prácticamente nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recherche mes symptômes sur Google, je panique, mais je ne fais pratiquement rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerco su Google i miei sintomi, panico, ma non faccio praticamente nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の症状をグーグルで検索してパニックになりますが、実際には何もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 내 증상을 검색하고 당황하지만 사실상 아무것도 하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik google mijn symptomen, raak in paniek, maar doe vrijwel niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuję w Google swoje objawy, wpadam w panikę, ale praktycznie nic nie robię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procuro meus sintomas no Google, entro em pânico, mas praticamente não faço nada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirtilerimi Google'da araştırıyorum, paniğe kapılıyorum ama neredeyse hiçbir şey yapmıyorum."
          }
        }
      }
    },
    "assessment.health.q9.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich analysiere meine Haltung, fange an mich zu dehnen und mache einen Arzttermin, falls es nicht besser wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I analyze my posture, start stretching and make a doctor's appointment if it doesn't get better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizo mi postura, empiezo a estirarme y pido cita con el médico si no mejora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'analyse ma posture, commence à m'étirer et prends rendez-vous chez le médecin si ça ne s'améliore pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizzo la mia postura, inizio a fare stretching e prendo un appuntamento dal medico se non migliora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の姿勢を分析し、ストレッチを始め、改善しない場合は医師の診察を受けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자세를 분석하고 스트레칭을 시작해도 나아지지 않으면 병원에 가보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik analyseer mijn houding, begin met stretchen en maak een afspraak bij de dokter als het niet beter wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizuję swoją postawę, zaczynam się rozciągać i umawiam wizytę u lekarza, jeśli nie będzie poprawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiso minha postura, começo o alongamento e marco consulta médica se não melhorar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duruşumu analiz ediyorum, esnemeye başlıyorum ve iyileşmezse doktor randevusu alıyorum."
          }
        }
      }
    },
    "assessment.health.q9.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wechsle den Stuhl, sitze aber weiterhin 10 Stunden am Stück ohne Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I change chairs, but continue to sit for 10 hours straight without moving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de silla, pero sigo sentado durante 10 horas seguidas sin moverme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je change de chaise, mais je reste assis 10 heures d'affilée sans bouger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio sedia, ma continuo a stare seduto per 10 ore di fila senza muovermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "椅子を変えますが、10時間は動かずに座り続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의자를 바꿔도 10시간 동안 움직이지 않고 계속 앉아있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wissel van stoel, maar blijf 10 uur achter elkaar zitten zonder te bewegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniam krzesło, ale nadal siedzę bez ruchu przez 10 godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Troco de cadeira, mas continuo sentado por 10 horas seguidas, sem me mover."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandalyeleri değiştiriyorum ama 10 saat boyunca hareket etmeden oturmaya devam ediyorum."
          }
        }
      }
    },
    "assessment.health.q10": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stellst du sicher, dass dein Körper genug Vitamine und Nährstoffe bekommt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you make sure your body gets enough vitamins and nutrients?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se asegura de que su cuerpo obtenga suficientes vitaminas y nutrientes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment vous assurer que votre corps reçoit suffisamment de vitamines et de nutriments ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come puoi assicurarti che il tuo corpo riceva abbastanza vitamine e sostanze nutritive?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体に十分なビタミンや栄養素を確実に摂取するにはどうすればよいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸에 충분한 비타민과 영양소가 공급되도록 하려면 어떻게 해야 합니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe zorg je ervoor dat je lichaam voldoende vitamines en voedingsstoffen binnenkrijgt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak zapewnić organizmowi wystarczającą ilość witamin i składników odżywczych?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você garante que seu corpo receba vitaminas e nutrientes suficientes?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuzun yeterli miktarda vitamin ve besin aldığından nasıl emin olursunuz?"
          }
        }
      }
    },
    "assessment.health.q10.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich esse einfach das, worauf ich Lust habe. Bisher lebe ich ja noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I just eat what I feel like. So far I'm still alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo como lo que tengo ganas. Hasta ahora sigo vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mange juste ce que je ressens. Jusqu'à présent, je suis toujours en vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangio solo quello che mi va. Finora sono ancora vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食べたいものをただ食べたいだけです。今のところ私はまだ生きています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 기분대로 먹습니다. 지금까지 나는 아직 살아있다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik eet gewoon waar ik zin in heb. Tot nu toe leef ik nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po prostu jem to, na co mam ochotę. Póki co jeszcze żyję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu apenas como o que tenho vontade. Até agora ainda estou vivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece canım ne isterse onu yiyorum. Şu ana kadar hâlâ hayattayım."
          }
        }
      }
    },
    "assessment.health.q10.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ernähre mich schlecht, aber werfe jeden Morgen eine Multivitamin-Tablette ein."

        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your partner tells you, \"If you go to this training instead of spending time with me, I'll be extremely upset.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pareja te dice: \"Si vas a esta capacitación en lugar de pasar tiempo conmigo, me enojaré mucho\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre partenaire vous dit : « Si vous allez à cette formation au lieu de passer du temps avec moi, je serai extrêmement contrarié. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका साथी आपसे कहता है, \"यदि आप मेरे साथ समय बिताने के बजाय इस प्रशिक्षण में जाएंगे, तो मैं बहुत परेशान हो जाऊंगा।\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo partner ti dice: \"Se partecipi a questo corso di formazione invece di passare del tempo con me, sarò estremamente turbato\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのパートナーはあなたに、「あなたが私と一緒に時間を過ごす代わりにこのトレーニングに参加したら、私は非常に腹を立てるでしょう。」と言います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 파트너는 \"당신이 나와 함께 시간을 보내지 않고 이 훈련에 참석한다면 나는 매우 속상할 것입니다.\"라고 말합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je partner zegt tegen je: \"Als je naar deze training gaat in plaats van tijd met mij door te brengen, zal ik erg overstuur zijn.\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój partner powie Ci: „Jeśli pójdziesz na to szkolenie zamiast spędzać czas ze mną, będę bardzo zdenerwowany”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu parceiro lhe dirá: “Se você for a esse treinamento em vez de ficar comigo, ficarei extremamente chateado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой партнёр говорит тебе: «Если ты сейчас пойдёшь на эту тренировку вместо того, чтобы проводить время со мной, я буду крайне зол.»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partneriniz size \"Benimle vakit geçirmek yerine bu eğitime giderseniz çok üzülürüm\" diyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的伴侣对你说：'如果你现在去参加这个培训，而不是和我共度时光，我会非常生气。'"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的伴侶告訴你，“如果你去參加這個培訓而不是花時間和我在一起，我會非常沮喪。”"
          }
        }
      }
    },
    "assessment.mental.q12.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

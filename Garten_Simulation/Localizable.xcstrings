    "trash.binge_streaming.tip.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Streaming-Dienste nur auf dem Laptop laufen – nicht auf dem TV im Bett."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only run streaming services on the laptop – not on the TV in bed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza los servicios de streaming solo en el portátil, no en la televisión en la cama."

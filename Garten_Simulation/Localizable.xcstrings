          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0441\u0438\u043a\u043e\u0432\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e"

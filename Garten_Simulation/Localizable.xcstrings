        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017byje 1000 lat \u2013 czysta wytrwa\u0142o\u015b\u0107 \u2013 \u015br\u00f3dziemnomorski styl \u017cycia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1.000 anos \u2013 pura persist\u00eancia \u2013 Estilo de vida mediterr\u00e2neo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0416\u0438\u0432\u0438\u0442\u0435 1000 \u043b\u0435\u0442 \u2013 \u0447\u0438\u0441\u0442\u0430\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0441\u0442\u044c \u2013 \u0441\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c\u043e\u0440\u0441\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 y\u0131l ya\u015far \u2013 saf dayan\u0131kl\u0131l\u0131k \u2013 Akdeniz ya\u015fam tarz\u0131"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bff\u547d\u5343\u5e74 \u2013 \u7eaf\u7cb9\u7684\u6301\u4e45 \u2013 \u5730\u4e2d\u6d77\u751f\u6d3b\u65b9\u5f0f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58fd\u547d 1000 \u5e74 \u2013 \u7d14\u7cb9\u7684\u8010\u7528\u6027 \u2013 \u5730\u4e2d\u6d77\u751f\u6d3b\u65b9\u5f0f"
          }
        }
      }
    },
    "plant.orchidee.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten, fragil, aber wundersch\u00f6n wenn gepflegt \u2013 Kunst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, but beautiful when cared for \u2013 Art"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, fr\u00e1gil, pero bella con cuidado \u2013 Arte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, mais magnifique quand soign\u00e9e \u2013 Art"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0930\u094d\u0932\u092d, \u0928\u093e\u091c\u0941\u0915, \u0932\u0947\u0915\u093f\u0928 \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0938\u0941\u0902\u0926\u0930 \u2013 \u0915\u0932\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, but beautiful when cared for \u2013 Art"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e0c\u5c11\u3067\u58ca\u308c\u3084\u3059\u3044\u304c\u3001\u5927\u5207\u306b\u6271\u3046\u3068\u7f8e\u3057\u3044 \u2013 \u30a2\u30fc\u30c8"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud76c\uadc0\ud558\uace0 \uae68\uc9c0\uae30 \uc26c\uc6b0\ub098 \uad00\ub9ac\ud558\uba74 \uc544\ub984\ub2e4\uc6b4 \u2013 \uc608\uc220"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeldzaam, kwetsbaar, maar mooi als je er voor zorgt \u2013 Art"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzadkie, delikatne, ale pi\u0119kne, gdy si\u0119 o nie dba \u2013 Art"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, fr\u00e1gil, mas bela quando cuidada \u2013 Arte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0434\u043a\u043e, \u0445\u0440\u0443\u043f\u043a\u043e, \u043d\u043e \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e, \u0435\u0441\u043b\u0438 \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044c \u2013 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadir, k\u0131r\u0131lgan ama bak\u0131m yap\u0131ld\u0131\u011f\u0131nda g\u00fczel - Sanat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a00\u6709\u3001\u8106\u5f31\uff0c\u4f46\u82e5\u7cbe\u5fc3\u7167\u6599\u5219\u7f8e\u4e3d\u975e\u51e1 \u2013 \u827a\u672f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a00\u6709\u3001\u8106\u5f31\uff0c\u4f46\u4fdd\u990a\u6642\u537b\u5f88\u7f8e\u9e97\u2500\u2500\u85dd\u8853"
          }
        }
      }
    },

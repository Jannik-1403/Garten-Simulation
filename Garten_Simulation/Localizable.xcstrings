    "assessment.finance.profile.prokrastinator.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst Probleme früh und klar. Du handelst nur nicht. Jede Woche, die du wartest, kostet dich konkret Geld – nicht metaphorisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see problems early and clearly. You just don't act. Every week you wait costs you money concretely – not metaphorically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves los problemas temprana y claramente. Simplemente no actúas. Cada semana de espera le cuesta dinero concretamente, no metafóricamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez les problèmes tôt et clairement. Vous n’agissez tout simplement pas. Chaque semaine d’attente vous coûte de l’argent concrètement – ​​pas métaphoriquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi i problemi in anticipo e chiaramente. Semplicemente non reciti. Ogni settimana che aspetti ti costa denaro concretamente, non metaforicamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を早い段階ではっきりと認識します。あなたはただ行動しないだけです。比喩ではなく、毎週待つと具体的にお金がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 조기에 명확하게 볼 수 있습니다. 당신은 행동하지 않습니다. 매주 기다리는 데는 은유적으로가 아니라 구체적으로 비용이 발생합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ziet problemen vroegtijdig en duidelijk. Je handelt gewoon niet. Elke week dat u wacht, kost u concreet geld – niet metaforisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Problemy widzisz wcześnie i wyraźnie. Po prostu nie działasz. Każdy tydzień oczekiwania kosztuje Cię konkretne pieniądze – a nie metaforyczne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vê os problemas cedo e claramente. Você simplesmente não age. Cada semana que você espera custa dinheiro concretamente – não metaforicamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunları erken ve net bir şekilde görürsünüz. Sadece harekete geçmiyorsun. Beklediğiniz her hafta size mecazi olarak değil, somut olarak paraya mal olur."
          }
        }
      }
    },

    "pfad_mental_day_7_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast 7 Tage lang bewusst geatmet. Spürst du die Ruhe?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have breathed consciously for 7 days. Do you feel the peace?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has respirado conscientemente durante 7 días. ¿Sientes la paz?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as respiré consciemment pendant 7 jours. Sens-tu le calme ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने 7 दिनों तक होशपूर्वक सांस ली। क्या आप शांति महसूस करते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai respirato consapevolmente per 7 giorni. Senti la pace?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは 7 日間意識的に呼吸しました。平和を感じていますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 7일 동안 의식적으로 호흡했습니다. 평화를 느끼시나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt 7 dagen bewust ademgehaald. Voel jij de vrede?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddychasz świadomie przez 7 dni. Czy czujesz spokój?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiraste conscientemente durante 7 dias. Sentes a paz?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты дышал сознательно в течение 7 дней. Чувствуешь ли ты покой?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 gün boyunca bilinçli nefes aldınız. Huzuru hissediyor musun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已刻意呼吸了7天。你感受到平静了吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您有意識地呼吸了 7 天。你感受到平靜了嗎？"
          }
        }
      }
    },

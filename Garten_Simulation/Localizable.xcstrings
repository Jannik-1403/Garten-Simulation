    "coin_shop_subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufe M\u00fcnzen f\u00fcr den Shop"

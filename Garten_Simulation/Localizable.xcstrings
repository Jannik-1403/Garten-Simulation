        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digo que sim porque tenho medo de que, caso contrário, ele não goste mais de mim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я соглашаюсь, потому что боюсь, что он больше меня не будет любить."
          }
        },
        "tr" : {
          "stringUnit" : {

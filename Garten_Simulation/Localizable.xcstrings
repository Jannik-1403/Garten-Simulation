    "trash.doener_dauerkarte.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knirscht so sch\u00f6n beim Dr\u00fcberlaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crunches nicely when walking over it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruje agradablemente al pisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Craque agr\u00e9ablement sous les pieds."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u0930 \u091a\u0932\u0928\u0947 \u092a\u0930 \u092f\u0939 \u0915\u093f\u0924\u0928\u0940 \u0938\u0941\u0902\u0926\u0930 \u0915\u094d\u0930\u093f\u0938\u094d\u092a\u0940 \u0906\u0935\u093e\u091c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crunches nicely when walking over it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0a\u3092\u6b69\u304f\u3068\u6c17\u6301\u3061\u3088\u304f\u30b3\u30ea\u30b3\u30ea\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8 \uc704\ub97c \uac78\uc744 \ub54c \uc798 \uc73c\uae68\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraakt lekker als je er overheen loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0141adnie chrupie podczas chodzenia po nim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Range agradavelmente ao passar por cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043d \u0442\u0430\u043a \u043f\u0440\u0438\u044f\u0442\u043d\u043e \u0445\u0440\u0443\u0441\u0442\u0438\u0442, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e \u043d\u0435\u043c\u0443 \u0445\u043e\u0434\u0438\u0448\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dczerinden y\u00fcr\u00fcrken \u00e7ok g\u00fczel \u00e7\u0131t\u0131rd\u0131yor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u4f60\u8d70\u8fc7\u5b83\u65f6\uff0c\u5b83\u560e\u5431\u4f5c\u54cd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7576\u4f60\u8d70\u904e\u5b83\u6642\uff0c\u5b83\u560e\u5431\u4f5c\u97ff\u3002"
          }
        }
      }
    },

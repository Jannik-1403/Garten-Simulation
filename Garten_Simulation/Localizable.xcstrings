        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소셜 미디어 피드에서 명품 브랜드를 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder luxemerken uit je socialemediafeeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń luksusowe marki ze swoich kanałów mediów społecznościowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova marcas de luxo dos seus feeds de redes sociais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova marcas de luxo dos seus feeds de redes sociais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите люксовые бренды из своих лент в социальных сетях."
          }
        },
        "tr": {
          "stringUnit": {

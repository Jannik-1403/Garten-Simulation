          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw kracht en veerkracht op door regelmatige training."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj siłę i odporność poprzez regularny trening."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa força e resiliência através de treinos regulares."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa força e resiliência através de treinos regulares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развивай силу и выносливость с помощью регулярных тренировок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

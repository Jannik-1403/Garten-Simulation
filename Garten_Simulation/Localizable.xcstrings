    "Alle ablenkenden Apps wurden über Screen Time für die Dauer der Routine blockiert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All distracting apps were blocked via Screen Time for the duration of the routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las aplicaciones que distraen se bloquearon a través de Screen Time durante la rutina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les applications distrayantes ont été bloquées via Screen Time pendant toute la durée de la routine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिनचर्या की अवधि के लिए सभी ध्यान भटकाने वाले ऐप्स को स्क्रीन टाइम के माध्यम से ब्लॉक कर दिया गया था।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le app che distraggono sono state bloccate tramite Screen Time per la durata della routine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーチンの間、気が散るアプリはすべてスクリーンタイム経由でブロックされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "루틴이 진행되는 동안 방해가 되는 모든 앱은 스크린 타임을 통해 차단되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle afleidende apps werden gedurende de hele routine via Screen Time geblokkeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie rozpraszające aplikacje zostały zablokowane przez funkcję Czas przed ekranem na czas trwania rutyny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os aplicativos que distraem foram bloqueados pelo Screen Time durante a rotina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все отвлекающие приложения были заблокированы через Screen Time на время выступления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutin süresince tüm dikkat dağıtıcı uygulamalar Ekran Süresi aracılığıyla engellendi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在例行程序期间，所有分散注意力的应用程序都会通过“屏幕时间”被阻止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在例行程序期間，所有分散注意力的應用程式都會透過「螢幕時間」被阻止。"
          }
        }
      }
    },

    "tour_5_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Timer ein, um konzentriert an deinen Zielen zu arbeiten und mehr XP zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set timers to work focused on your goals and earn more XP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure temporizadores para que funcionen enfocados en sus objetivos y gane más XP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez des minuteries pour qu'elles fonctionnent en vous concentrant sur vos objectifs et gagnez plus d'XP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i timer per lavorare concentrandoti sui tuoi obiettivi e guadagnare più XP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーを設定して目標に集中して取り組み、より多くの XP を獲得しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표에 집중하여 작업하고 더 많은 XP를 얻을 수 있도록 타이머를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel timers in om gefocust aan uw doelen te werken en meer XP te verdienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw liczniki czasu, aby pracować koncentrując się na swoich celach i zdobywać więcej XP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina cronômetros para trabalhar focado em seus objetivos e ganhe mais XP."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerinize odaklanarak çalışmak ve daha fazla XP kazanmak için zamanlayıcıları ayarlayın."
          }
        }
      }
    },

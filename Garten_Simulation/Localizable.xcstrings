    "plant.ingwerpflanze.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scharfe Alternative, nat\u00fcrliche Energie \u2013 Kein Koffein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharp alternative, natural energy \u2013 No caffeine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa picante, energ\u00eda natural \u2013 Sin cafe\u00edna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative \u00e9pic\u00e9e, \u00e9nergie naturelle \u2013 Sans caf\u00e9ine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0940\u0915\u094d\u0937\u094d\u0923 \u0935\u093f\u0915\u0932\u094d\u092a, \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u2013 \u0915\u094b\u0908 \u0915\u0948\u092b\u0940\u0928 \u0928\u0939\u0940\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharp alternative, natural energy \u2013 No caffeine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e3\u30fc\u30d7\u306a\u4ee3\u66ff\u81ea\u7136\u30a8\u30cd\u30eb\u30ae\u30fc \u2013 \u30ce\u30f3\u30ab\u30d5\u30a7\u30a4\u30f3"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0a0\uce74\ub85c\uc6b4 \ub300\uc548, \uc790\uc5f0 \uc5d0\ub108\uc9c0 \u2013 \uce74\ud398\uc778 \uc5c6\uc74c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scherp alternatief, natuurlijke energie \u2013 Geen cafe\u00efne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostra alternatywa, naturalna energia \u2013 Bez kofeiny"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa picante, energia natural \u2013 Sem cafe\u00edna"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0440\u0430\u044f \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430, \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u044f \u2013 \u0411\u0435\u0437 \u043a\u043e\u0444\u0435\u0438\u043d\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskin alternatif, do\u011fal enerji \u2013 Kafeinsiz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f9b\u8fa3\u66ff\u4ee3\u54c1\uff0c\u5929\u7136\u80fd\u91cf \u2013 \u4e0d\u542b\u5496\u5561\u56e0"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f9b\u8fa3\u66ff\u4ee3\u54c1\uff0c\u5929\u7136\u80fd\u91cf\uff0d\u4e0d\u542b\u5496\u5561\u56e0"
          }
        }
      }
    },

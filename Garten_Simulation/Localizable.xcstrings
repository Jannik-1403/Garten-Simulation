    "plant.minzpflanze.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge f\u00fcr eine frische und gesunde Zahnroutine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure a fresh and healthy dental routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegura una rutina dental fresca y saludable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous d'avoir une routine dentaire fra\u00eeche et saine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0926\u093e\u0902\u0924\u094b\u0902 \u0915\u0940 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u0924\u093e\u091c\u093c\u093e \u0914\u0930 \u0938\u094d\u0935\u0938\u094d\u0925 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati una routine dentale fresca e sana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u9bae\u3067\u5065\u5eb7\u7684\u306a\u6b6f\u79d1\u30eb\u30fc\u30c1\u30f3\u3092\u78ba\u4fdd\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\ucf8c\ud558\uace0 \uac74\uac15\ud55c \uce58\uc544 \ub8e8\ud2f4\uc744 \uc720\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg voor een frisse en gezonde tandheelkundige routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj o \u015bwie\u017c\u0105 i zdrow\u0105 rutyn\u0119 dentystyczn\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanta uma rotina odontol\u00f3gica fresca e saud\u00e1vel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0431\u043e\u0442\u044c\u0442\u0435\u0441\u044c \u043e \u0441\u0432\u0435\u0436\u0435\u0439 \u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u043e\u0439 \u0437\u0443\u0431\u043d\u043e\u0439 \u0433\u0438\u0433\u0438\u0435\u043d\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taze ve sa\u011fl\u0131kl\u0131 bir di\u015f rutini sa\u011flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u6e05\u65b0\u5065\u5eb7\u7684\u7259\u9f7f\u65e5\u5e38\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u65b0\u9bae\u5065\u5eb7\u7684\u7259\u79d1\u7fd2\u6163\u3002"
          }
        }
      }
    },
    "plant.mystic_seed.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein seltener Samen mit geheimnisvoller Kraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rare seed with mysterious power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semilla rara con un poder misterioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une graine rare au pouvoir myst\u00e9rieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0905\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092c\u0940\u091c \u091c\u093f\u0938\u092e\u0947\u0902 \u0930\u0939\u0938\u094d\u092f\u092e\u092f \u0936\u0915\u094d\u0924\u093f \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seme raro con un potere misterioso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u601d\u8b70\u306a\u529b\u3092\u6301\u3064\u73cd\u3057\u3044\u7a2e\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e0\ube44\ud55c \ud798\uc744 \uc9c0\ub2cc \ud76c\uadc0\ud55c \uc528\uc557\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zeldzaam zaadje met mysterieuze kracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzadkie nasiono o tajemniczej mocy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semente rara com um poder misterioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0434\u043a\u043e\u0435 \u0441\u0435\u043c\u044f \u0441 \u0437\u0430\u0433\u0430\u0434\u043e\u0447\u043d\u043e\u0439 \u0441\u0438\u043b\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizemli g\u00fcce sahip nadir bir tohum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u9897\u8574\u542b\u795e\u79d8\u529b\u91cf\u7684\u7a00\u6709\u79cd\u5b50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5177\u6709\u795e\u79d8\u529b\u91cf\u7684\u7a00\u6709\u7a2e\u5b50\u3002"
          }
        }
      }
    },

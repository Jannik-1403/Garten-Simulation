    "plant.mammutbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größter Baum der Welt – braucht alles – Jahresprojekt & Big Goal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest tree in the world – needs everything – Year project & Big Goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árbol más grande del mundo – Proyecto anual y Gran Objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbre le plus grand du monde – Projet annuel & Grand objectif"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया का सबसे बड़ा पेड़ – सब कुछ चाहिए – वार्षिक परियोजना और बड़ा लक्ष्य"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’albero più grande del mondo – ha bisogno di tutto – progetto annuale e grande obiettivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界最大の木 – すべてが必要 – 年間プロジェクトと大きな目標"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세계에서 가장 큰 나무 – 모든 것이 필요함 – 연도 프로젝트 및 큰 목표"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grootste boom ter wereld – heeft alles nodig – Jaarproject & Groot Doel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Największe drzewo na świecie – potrzebuje wszystkiego – projekt roczny i wielki cel"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior árvore do mundo – Projeto anual & Grande objetivo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior árvore do mundo – Projeto anual & Grande objetivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое большое дерево в мире – требует всего – годовой проект и большая цель"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın en büyük ağacı – her şeye ihtiyacı var – Yıl Projesi ve Büyük Hedef"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "世界上最大的树 – 需要一切 – 年度项目与大目标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "世界上最大的樹 - 需要一切 - 年度專案和大目標"
          }
        }
      }
    },

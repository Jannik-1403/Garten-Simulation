    "prog_gratitude_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Egal ob er wehtut oder perfekt funktioniert: Dein Körper hält dich am Leben. Wofür dankst du ihm heute?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matter whether it hurts or works perfectly: your body keeps you alive. What are you thanking him for today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No importa si duele o funciona perfectamente: tu cuerpo te mantiene vivo. ¿Por qué le estás agradeciendo hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu importe si cela fait mal ou si cela fonctionne parfaitement: votre corps vous maintient en vie. Pourquoi le remerciez-vous aujourd'hui ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे कोई फर्क नहीं पड़ता कि यह दर्द देता है या पूरी तरह से काम करता है: आपका शरीर आपको जीवित रखता है। आज आप उसे किस बात के लिए धन्यवाद दे रहे हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non importa se fa male o funziona perfettamente: il tuo corpo ti mantiene in vita. Per cosa lo ringrazi oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "痛くても、完璧に機能しても、体はあなたを生かし続けます。今日は彼に何を感謝していますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아프거나 완벽하게 작동하는지 여부에 관계없이 신체는 당신을 살아있게 해줍니다. 오늘은 그에게 무엇에 대해 감사합니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of het nu pijn doet of perfect werkt: je lichaam houdt je in leven. Waar bedank jij hem vandaag voor?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieważne, czy to boli, czy działa doskonale: Twoje ciało utrzymuje Cię przy życiu. Za co mu dzisiaj dziękujesz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não importa se dói ou funciona perfeitamente: seu corpo o mantém vivo. Pelo que você está agradecendo a ele hoje?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não importa se dói ou funciona perfeitamente: seu corpo o mantém vivo. Pelo que você está agradecendo a ele hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неважно, больно это или работает идеально: ваше тело сохраняет вам жизнь. За что вы его сегодня благодарите?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İster acıtıyor, ister mükemmel çalışıyor olsun: Vücudunuz sizi hayatta tutar. Bugün ona ne için teşekkür ediyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论它是否疼痛或是否有效：你的身体会让你活下去。今天你要感谢他什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論它是否疼痛或是否有效：你的身體會讓你活下去。今天你要感謝他什麼？"
          }
        }
      }
    },

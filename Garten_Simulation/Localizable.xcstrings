    },
    "assessment.finance.q5.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann mir das gerade nicht leisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't afford this right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedo permitirme esto ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas me le permettre pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non posso permettermelo adesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はそんな余裕がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 지금 이것을 감당할 여유가 없습니다."

    "assessment.fitness.q12" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während einer Übung spürst du ein starkes, brennendes Gefühl in den Muskeln, es ist extrem unangenehm. Was denkst du in dieser Millisekunde?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During an exercise you feel a strong, burning sensation in your muscles, it is extremely uncomfortable. What are you thinking in that millisecond?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un ejercicio sientes una fuerte sensación de ardor en los músculos, es sumamente incómodo. ¿Qué estás pensando en ese milisegundo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un exercice, vous ressentez une forte sensation de brûlure dans vos muscles, c'est extrêmement inconfortable. À quoi penses-tu pendant cette milliseconde ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यायाम के दौरान आप अपनी मांसपेशियों में तेज़, जलन महसूस करते हैं, यह बेहद असुविधाजनक होता है। आप उस मिलीसेकंड में क्या सोच रहे हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un esercizio avverti una forte sensazione di bruciore nei muscoli, è estremamente fastidioso. Cosa stai pensando in quel millisecondo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動中に筋肉に強い灼熱感を感じますが、これは非常に不快です。そのミリ秒の間に何を考えていますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동하는 동안 근육에 강하고 타는듯한 느낌이 들며 매우 불편합니다. 그 밀리초 동안 당신은 무슨 생각을 하고 있나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens een oefening voel je een sterk, branderig gevoel in je spieren, dit is uiterst oncomfortabel. Wat denk jij in die milliseconde?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas ćwiczeń odczuwasz silne, pieczenie w mięśniach, jest to niezwykle nieprzyjemne. O czym myślisz w ciągu tej milisekundy?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante um exercício você sente uma forte sensação de queimação nos músculos, é extremamente desconfortável. O que você está pensando naquele milissegundo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время упражнения ты ощущаешь сильное, жгучее чувство в мышцах, это чрезвычайно неприятно. О чём ты думаешь в эту миллисекунду?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egzersiz sırasında kaslarınızda güçlü bir yanma hissi hissedersiniz, bu son derece rahatsız edicidir. O milisaniyede ne düşünüyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一次锻炼中，你感到肌肉有一种强烈的灼烧感，非常不舒服。在这一毫秒你会想什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在運動過程中，你會感覺到肌肉有強烈的灼熱感，這是非常不舒服的。那一毫秒你在想什麼？"
          }
        }
      }
    },
    "assessment.fitness.q12.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Das tut weh, ich muss sofort aufhören, bevor ich kaputt gehe.'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'This hurts, I have to stop now before I break.'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Esto duele, tengo que parar ahora antes de que me rompa\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ça fait mal, je dois arrêter maintenant avant de craquer.\""
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'यह दुखदायी है, मुझे टूटने से पहले अब रुकना होगा।'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Fa male, devo fermarmi adesso prima di rompermi.\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「これは痛い、壊れる前に今すぐやめなければなりません。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'아프다. 깨지기 전에 이제 그만둬야겠다.'"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Dit doet pijn, ik moet nu stoppen voordat ik breek.'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„To boli. Muszę teraz przestać, zanim się złamię”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Isso dói, tenho que parar agora antes de quebrar.'"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Это больно, мне нужно немедленно остановиться, прежде чем я сломаюсь.»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Bu acıtıyor, kırılmadan önce durmam lazım.'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“这很痛，我必须立刻停止，免得我崩溃。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「這很痛，我必須在摔斷之前停下來。”"
          }
        }
      }
    },

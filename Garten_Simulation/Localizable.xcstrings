          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4chst im Verborgenen, verbindet alles \u2013 Networking"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows in hiding, connects everything \u2013 Networking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece en secreto, connects todo \u2013 Networking"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse en secret, relie tout \u2013 Networking"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u093f\u092a\u0915\u0930 \u092c\u0922\u093c\u0924\u093e \u0939\u0948, \u0938\u092c \u0915\u0941\u091b \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948 \u2013 \u0928\u0947\u091f\u0935\u0930\u094d\u0915\u093f\u0902\u0917"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows in hiding, connects everything \u2013 Networking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96a0\u308c\u3066\u6210\u9577\u3057\u3001\u3059\u3079\u3066\u3092\u63a5\u7d9a \u2013 \u30cd\u30c3\u30c8\u30ef\u30fc\u30ad\u30f3\u30b0"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc228\uc5b4\uc11c \uc131\uc7a5\ud558\uace0 \ubaa8\ub4e0 \uac83\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4 \u2013 \ub124\ud2b8\uc6cc\ud0b9"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit ondergedoken, verbindt alles \u2013 Netwerken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015bnie w ukryciu, \u0142\u0105czy wszystko \u2013 Networking"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce em segredo, conecta tudo \u2013 Networking"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u0442 \u0442\u0430\u0439\u043d\u043e, \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \u0432\u0441\u0435 \u2013 \u043d\u0435\u0442\u0432\u043e\u0440\u043a\u0438\u043d\u0433"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanarak b\u00fcy\u00fcr, her \u015feyi birbirine ba\u011flar \u2013 A\u011f Olu\u015fturma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9690\u79d8\u4e2d\u751f\u957f\uff0c\u8fde\u63a5\u4e07\u7269 \u2013 \u4eba\u9645\u7f51\u7edc"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79d8\u5bc6\u751f\u9577\uff0c\u9023\u7d50\u4e00\u5207\uff0d\u7db2\u7d61"
          }
        }
      }
    },

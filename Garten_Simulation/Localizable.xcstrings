    "assessment.fitness.profile.schoenwetter_sportler.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsistenz ist alles. Trainiere heute, auch wenn du absolut keine Lust hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency is everything. Train today, even if you absolutely don't feel like it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coherencia lo es todo. Entrena hoy, incluso si no te apetece en absoluto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La coh\u00e9rence est primordiale. Entra\u00eenez-vous aujourd\u2019hui, m\u00eame si vous n\u2019en avez absolument pas envie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0917\u0924\u093f \u0939\u0940 \u0938\u092c \u0915\u0941\u091b \u0939\u0948. \u0906\u091c \u0939\u0940 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947\u0902, \u092d\u0932\u0947 \u0939\u0940 \u0906\u092a\u0915\u093e \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092e\u0928 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La coerenza \u00e8 tutto. Allenati oggi, anche se non ne hai assolutamente voglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u8cab\u6027\u304c\u3059\u3079\u3066\u3067\u3059\u3002\u305f\u3068\u3048\u6c17\u5206\u304c\u4e57\u3089\u306a\u304f\u3066\u3082\u3001\u4eca\u65e5\u306f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uad00\uc131\uc774 \uc804\ubd80\uc785\ub2c8\ub2e4. \uc804\ud600 \uae30\ubd84\uc774 \uc88b\uc9c0 \uc54a\ub354\ub77c\ub3c4 \uc624\ub298 \ud6c8\ub828\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistentie is alles. Train vandaag nog, ook als je absoluut geen zin hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sp\u00f3jno\u015b\u0107 jest wszystkim. Trenuj ju\u017c dzi\u015b, nawet je\u015bli zupe\u0142nie nie masz na to ochoty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consist\u00eancia \u00e9 tudo. Treine hoje, mesmo que voc\u00ea n\u00e3o tenha vontade alguma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u2014 \u044d\u0442\u043e \u0432\u0441\u0451. \u0422\u0440\u0435\u043d\u0438\u0440\u0443\u0439\u0441\u044f \u0441\u0435\u0433\u043e\u0434\u043d\u044f, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0443 \u0442\u0435\u0431\u044f \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435\u0442 \u0436\u0435\u043b\u0430\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarl\u0131l\u0131k her \u015feydir. Can\u0131n\u0131z hi\u00e7 istemese bile bug\u00fcn antrenman yap\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u575a\u6301\u5c31\u662f\u4e00\u5207\u3002\u5373\u4f7f\u4f60\u4e00\u70b9\u90fd\u4e0d\u60f3\uff0c\u4e5f\u8981\u4eca\u5929\u8bad\u7ec3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u81f4\u6027\u5c31\u662f\u4e00\u5207\u3002\u4eca\u5929\u5c31\u8a13\u7df4\uff0c\u5373\u4f7f\u4f60\u7d55\u5c0d\u4e0d\u559c\u6b61\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.break": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Checke nie wieder den Wetterbericht, bevor du entscheidest, ob du trainieren gehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never again check the weather forecast before deciding whether to exercise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca m\u00e1s consultes el pron\u00f3stico del tiempo antes de decidir si hacer ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne v\u00e9rifiez plus jamais les pr\u00e9visions m\u00e9t\u00e9orologiques avant de d\u00e9cider de faire de l'exercice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0930\u0928\u093e \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902, \u0907\u0938\u0915\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u092d\u0940 \u092d\u0940 \u092e\u094c\u0938\u092e \u0915\u0947 \u092a\u0942\u0930\u094d\u0935\u093e\u0928\u0941\u092e\u093e\u0928 \u0915\u0940 \u091c\u093e\u0901\u091a \u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non controllare mai pi\u00f9 le previsioni del tempo prima di decidere se fare attivit\u00e0 fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u904b\u52d5\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u6c7a\u3081\u308b\u524d\u306b\u5929\u6c17\u4e88\u5831\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b\u5fc5\u8981\u306f\u3082\u3046\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b4\ub3d9\ud560\uc9c0 \uc5ec\ubd80\ub97c \uacb0\uc815\ud558\uae30 \uc804\uc5d0 \ub2e4\uc2dc\ub294 \uc77c\uae30\uc608\ubcf4\ub97c \ud655\uc778\ud558\uc9c0 \ub9c8\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer nooit meer de weersvoorspelling voordat u besluit of u gaat sporten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy wi\u0119cej nie sprawdzaj prognozy pogody przed podj\u0119ciem decyzji o \u0107wiczeniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca mais verifique a previs\u00e3o do tempo antes de decidir se vai fazer exerc\u00edcios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0438\u043a\u043e\u0433\u0434\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439 \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u043f\u043e\u0433\u043e\u0434\u044b, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0440\u0435\u0448\u0438\u0448\u044c, \u0438\u0434\u0442\u0438 \u043b\u0438 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz yap\u0131p yapmayaca\u011f\u0131n\u0131za karar vermeden \u00f6nce bir daha asla hava durumunu kontrol etmeyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u51b3\u5b9a\u662f\u5426\u53bb\u8bad\u7ec3\u4e4b\u524d\uff0c\u6c38\u8fdc\u4e0d\u8981\u518d\u67e5\u770b\u5929\u6c14\u9884\u62a5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6c7a\u5b9a\u662f\u5426\u904b\u52d5\u4e4b\u524d\uff0c\u4e0d\u8981\u518d\u67e5\u770b\u5929\u6c23\u9810\u5831\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.build": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh an Trainingstagen nur deine Sportkleidung an. Ob du dann trainierst, ist egal \u2013 die H\u00fcrde ist das Umziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On training days, wear only your gym clothes. It doesn't matter whether you train or not - the hurdle is getting changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los d\u00edas de entrenamiento, usa s\u00f3lo tu ropa de gimnasia. No importa si entrenas o no: los obst\u00e1culos cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours d\u2019entra\u00eenement, portez uniquement vos v\u00eatements de sport. Peu importe que vous vous entra\u00eeniez ou non, les obstacles sont en train de changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u0905\u092a\u0928\u0947 \u091c\u093f\u092e \u0915\u0947 \u0915\u092a\u0921\u093c\u0947 \u0939\u0940 \u092a\u0939\u0928\u0947\u0902\u0964 \u0907\u0938\u0938\u0947 \u0915\u094b\u0908 \u092b\u0930\u094d\u0915 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0924\u093e \u0915\u093f \u0906\u092a \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0928\u0939\u0940\u0902 - \u092c\u093e\u0927\u093e \u092c\u0926\u0932 \u0930\u0939\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei giorni di allenamento indossa solo l'abbigliamento da palestra. Non importa se ti alleni o meno: l'ostacolo sta cambiando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7df4\u7fd2\u65e5\u306f\u4f53\u64cd\u670d\u306e\u307f\u3092\u7740\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u3059\u308b\u304b\u3057\u306a\u3044\u304b\u306f\u95a2\u4fc2\u3042\u308a\u307e\u305b\u3093\u3002\u30cf\u30fc\u30c9\u30eb\u306f\u5909\u308f\u308a\u3064\u3064\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud6c8\ub828\uc77c\uc5d0\ub294 \uccb4\uc721\ubcf5\ub9cc \uc785\uc73c\uc138\uc694. \ud6c8\ub828 \uc5ec\ubd80\ub294 \uc911\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc7a5\uc560\ubb3c\uc774 \ubc14\ub00c\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draag op trainingsdagen alleen je gymkleding. Het maakt niet uit of je traint of niet: de hindernis wordt steeds groter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dni treningowe no\u015b wy\u0142\u0105cznie str\u00f3j gimnastyczny. Nie ma znaczenia, czy trenujesz, czy nie \u2013 przeszkoda si\u0119 zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos dias de treino, use apenas roupas de gin\u00e1stica. N\u00e3o importa se voc\u00ea treina ou n\u00e3o \u2013 o obst\u00e1culo est\u00e1 sendo mudado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0434\u0435\u0432\u0430\u0439 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u0443\u044e \u043e\u0434\u0435\u0436\u0434\u0443 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0434\u043d\u0438 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043e\u043a. \u0411\u0443\u0434\u0435\u0448\u044c \u043b\u0438 \u0442\u044b \u0442\u043e\u0433\u0434\u0430 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f, \u043d\u0435 \u0432\u0430\u0436\u043d\u043e \u2014 \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0435\u043c \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u043e\u0434\u0435\u0432\u0430\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman g\u00fcnlerinde sadece spor k\u0131yafetlerinizi giyin. Antrenman yap\u0131p yapmaman\u0131z \u00f6nemli de\u011fil; engel de\u011fi\u015fiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8bad\u7ec3\u65e5\u53ea\u7a7f\u4f60\u7684\u8fd0\u52a8\u670d\u3002\u4f60\u662f\u5426\u771f\u7684\u8bad\u7ec3\u65e0\u6240\u8c13\u2014\u2014\u5173\u952e\u662f\u6362\u8863\u670d\u8fd9\u4e00\u6b65\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a13\u7df4\u65e5\uff0c\u53ea\u7a7f\u904b\u52d5\u670d\u3002\u4e0d\u7ba1\u4f60\u662f\u5426\u8a13\u7df4\uff0c\u969c\u7919\u90fd\u6703\u6539\u8b8a\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konsistenz. Die 1\uff05-Methode beseitigt die Ausreden vor dem Sport, nicht den Sport selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No consistency. The 1\uff05 method eliminates the excuses before exercise, not the exercise itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin coherencia. El m\u00e9todo del 1\uff05 elimina las excusas antes del ejercicio, no el ejercicio en s\u00ed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune coh\u00e9rence. La m\u00e9thode 1\uff05 \u00e9limine les excuses avant l\u2019exercice, pas l\u2019exercice lui-m\u00eame."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u0928\u0939\u0940\u0902. 1\uff05 \u0935\u093f\u0927\u093f \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0947 \u092c\u0939\u093e\u0928\u094b\u0902 \u0915\u094b \u0916\u093c\u0924\u094d\u092e \u0915\u0930\u0924\u0940 \u0939\u0948, \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u094b \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna coerenza. Il metodo dell\u20191\uff05 elimina le scuse prima dell\u2019esercizio, non l\u2019esercizio stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u8cab\u6027\u304c\u306a\u3044\u3002 1\uff05 \u30e1\u30bd\u30c3\u30c9\u306f\u3001\u904b\u52d5\u305d\u306e\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u904b\u52d5\u524d\u306e\u8a00\u3044\u8a33\u3092\u6392\u9664\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uad00\uc131\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. 1\uff05 \ubc29\ubc95\uc740 \uc6b4\ub3d9 \uc790\uccb4\uac00 \uc544\ub2cc \uc6b4\ub3d9 \uc804 \ud551\uacc4\ub97c \uc5c6\uc560\uc90d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen consistentie. De 1\uff05-methode elimineert de excuses v\u00f3\u00f3r het sporten, niet de oefening zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak konsekwencji. Metoda 1\uff05 eliminuje wym\u00f3wki przed \u0107wiczeniami, a nie same \u0107wiczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem consist\u00eancia. O m\u00e9todo de 1\uff05 elimina as desculpas antes do exerc\u00edcio, e n\u00e3o o exerc\u00edcio em si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u041c\u0435\u0442\u043e\u0434 1\uff05 \u0443\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u043e\u0439, \u0430 \u043d\u0435 \u0441\u0430\u043c\u0443 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarl\u0131l\u0131k yok. \uff051 y\u00f6ntemi egzersizin kendisini de\u011fil, egzersiz \u00f6ncesi mazeretleri ortadan kald\u0131r\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u4e00\u81f4\u6027\u30021\uff05 \u65b9\u6cd5\u6d88\u9664\u4e86\u953b\u70bc\u524d\u7684\u501f\u53e3\uff0c\u800c\u4e0d\u662f\u953b\u70bc\u672c\u8eab\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u4e00\u81f4\u6027\u3002 1\uff05\u65b9\u6cd5\u6d88\u9664\u7684\u662f\u904b\u52d5\u524d\u7684\u85c9\u53e3\uff0c\u800c\u4e0d\u662f\u904b\u52d5\u672c\u8eab\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.schoenwetter_sportler.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sch\u00f6nwetter-Sportler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fair-weather athlete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atleta del buen tiempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'athl\u00e8te des beaux jours"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u091a\u094d\u091b\u0947 \u092e\u094c\u0938\u092e \u0935\u093e\u0932\u093e \u090f\u0925\u0932\u0940\u091f"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'atleta del bel tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6674\u5929\u306e\u30a2\u30b9\u30ea\u30fc\u30c8"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0a0\uc528\uac00 \uc88b\uc740 \uc6b4\ub3d9\uc120\uc218"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mooiweeratleet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sportowiec na pi\u0119kn\u0105 pogod\u0119"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O atleta do bom tempo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u043e\u0440\u0442\u0441\u043c\u0435\u043d \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u043f\u043e\u0433\u043e\u0434\u044b"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fczel hava sporcusu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u597d\u5929\u6c14\u8fd0\u52a8\u5458"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5929\u6c23\u597d\u7684\u904b\u52d5\u54e1"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erh\u00f6he die Intensit\u00e4t. Das Workout beginnt erst, wenn es wehtut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the intensity. The workout only starts when it hurts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la intensidad. El entrenamiento s\u00f3lo comienza cuando duele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez l\u2019intensit\u00e9. L'entra\u00eenement ne commence que lorsque \u00e7a fait mal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0940\u0935\u094d\u0930\u0924\u093e \u092c\u0922\u093c\u093e\u090f\u0901. \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0924\u092d\u0940 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u092c \u0926\u0930\u094d\u0926 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta l'intensit\u00e0. L'allenamento inizia solo quando fa male."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f37\u5ea6\u3092\u4e0a\u3052\u307e\u3059\u3002\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306f\u75db\u307f\u304c\u51fa\u305f\u3068\u304d\u306b\u306e\u307f\u59cb\u307e\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac15\ub3c4\ub97c \ub192\uc774\uc138\uc694. \uc6b4\ub3d9\uc740 \uc544\ud50c \ub54c\ub9cc \uc2dc\uc791\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoog de intensiteit. De training begint pas als het pijn doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwi\u0119ksz intensywno\u015b\u0107. Trening rozpoczyna si\u0119 dopiero wtedy, gdy zaczyna bole\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente a intensidade. O treino s\u00f3 come\u00e7a quando d\u00f3i."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0432\u0435\u043b\u0438\u0447\u044c \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c. \u0422\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0431\u043e\u043b\u044c\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo\u011funlu\u011fu art\u0131r\u0131n. Antrenman ancak can\u0131n ac\u0131d\u0131\u011f\u0131nda ba\u015flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u9ad8\u5f3a\u5ea6\u3002\u953b\u70bc\u53ea\u6709\u5728\u611f\u5230\u75bc\u75db\u65f6\u624d\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u589e\u52a0\u5f37\u5ea6\u3002\u904b\u52d5\u53ea\u6709\u5728\u75bc\u75db\u6642\u624d\u958b\u59cb\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dein Handy f\u00fcr die n\u00e4chsten 3 Workouts im Spind. Das verhindert endlose Pausen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave your phone in the locker for the next 3 workouts. This prevents endless breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja tu tel\u00e9fono en el casillero durante los pr\u00f3ximos 3 entrenamientos. Esto evita pausas interminables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez votre t\u00e9l\u00e9phone dans le casier pour les 3 prochaines s\u00e9ances d'entra\u00eenement. Cela \u00e9vite des pauses interminables."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0917\u0932\u0947 \u0924\u0940\u0928 \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u094b \u0932\u0949\u0915\u0930 \u092e\u0947\u0902 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964 \u092f\u0939 \u0905\u0902\u0924\u0939\u0940\u0928 \u092c\u094d\u0930\u0947\u0915 \u0915\u094b \u0930\u094b\u0915\u0924\u093e \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia il telefono nell'armadietto per i prossimi 3 allenamenti. Ci\u00f2 impedisce pause infinite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b21\u306e 3 \u3064\u306e\u30ef\u30fc\u30af\u30a2\u30a6\u30c8\u306e\u9593\u3001\u643a\u5e2f\u96fb\u8a71\u3092\u30ed\u30c3\u30ab\u30fc\u306b\u4fdd\u7ba1\u3057\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u7121\u9650\u306e\u4f11\u61a9\u304c\u9632\u6b62\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c 3\ubc88\uc758 \uc6b4\ub3d9\uc744 \uc704\ud574 \ud734\ub300\ud3f0\uc744 \uc0ac\ubb3c\ud568\uc5d0 \ub123\uc5b4\ub450\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \ub05d\uc5c6\ub294 \uc911\ub2e8\uc774 \ubc29\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je telefoon de komende 3 trainingen in het kluisje. Dit voorkomt eindeloze pauzes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw telefon w szafce na kolejne 3 treningi. Zapobiega to nieko\u0144cz\u0105cym si\u0119 przerwom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe seu telefone no arm\u00e1rio para os pr\u00f3ximos 3 treinos. Isso evita pausas intermin\u00e1veis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u044c \u0441\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432 \u0448\u043a\u0430\u0444\u0447\u0438\u043a\u0435 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 3 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438. \u042d\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0440\u044b\u0432\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki 3 antrenman i\u00e7in telefonunuzu dolab\u0131n\u0131zda b\u0131rak\u0131n. Bu sonsuz molalar\u0131 \u00f6nler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u628a\u4f60\u7684\u624b\u673a\u5728\u63a5\u4e0b\u6765\u76843\u6b21\u953b\u70bc\u4e2d\u653e\u5728\u50a8\u7269\u67dc\u91cc\u3002\u8fd9\u53ef\u4ee5\u9632\u6b62\u65e0\u4f11\u6b62\u7684\u4f11\u606f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u624b\u6a5f\u7559\u5728\u5132\u7269\u6ac3\u4e2d\u4ee5\u4f9b\u63a5\u4e0b\u4f86 3 \u6b21\u935b\u934a\u4f7f\u7528\u3002\u9019\u53ef\u4ee5\u9632\u6b62\u7121\u4f11\u6b62\u7684\u4e2d\u65b7\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erh\u00f6he das Gewicht bei deiner Lieblings\u00fcbung heute um die allerkleinste Scheibe (1kg / 1.25kg)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase the weight of your favorite exercise today by the smallest disc (1kg / 1.25kg)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta hoy el peso de tu ejercicio favorito con el disco m\u00e1s peque\u00f1o (1kg/1,25kg)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez le poids de votre exercice pr\u00e9f\u00e9r\u00e9 aujourd'hui du plus petit disque (1 kg / 1,25 kg)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0947 \u092a\u0938\u0902\u0926\u0940\u0926\u093e \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u093e \u0935\u091c\u0928 \u0938\u092c\u0938\u0947 \u091b\u094b\u091f\u0940 \u0921\u093f\u0938\u094d\u0915 (1 \u0915\u093f\u0917\u094d\u0930\u093e / 1.25 \u0915\u093f\u0917\u094d\u0930\u093e) \u0924\u0915 \u092c\u0922\u093c\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta oggi il peso del tuo esercizio preferito con il disco pi\u00f9 piccolo (1 kg/1,25 kg)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306e\u304a\u6c17\u306b\u5165\u308a\u306e\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u306e\u91cd\u91cf\u3092\u6700\u5c0f\u30c7\u30a3\u30b9\u30af (1kg / 1.25kg) \u305a\u3064\u5897\u3084\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \uac00\uc7a5 \uc791\uc740 \ub514\uc2a4\ud06c(1kg/1.25kg)\ub85c \uc88b\uc544\ud558\ub294 \uc6b4\ub3d9\uc758 \ubb34\uac8c\ub97c \ub298\ub824\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoog vandaag nog het gewicht van uw favoriete oefening met de kleinste schijf (1 kg / 1,25 kg)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwi\u0119ksz ju\u017c dzi\u015b ci\u0119\u017car swojego ulubionego \u0107wiczenia o najmniejszy kr\u0105\u017cek (1kg / 1,25kg)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente hoje o peso do seu exerc\u00edcio favorito no menor disco (1kg / 1,25kg)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u044c \u0432\u0435\u0441 \u0432 \u0442\u0432\u043e\u0435\u043c \u043b\u044e\u0431\u0438\u043c\u043e\u043c \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0438 \u043d\u0430 \u0441\u0430\u043c\u0443\u044e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u0443 (1 \u043a\u0433 / 1,25 \u043a\u0433)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En sevdi\u011finiz egzersizin a\u011f\u0131rl\u0131\u011f\u0131n\u0131 bug\u00fcn en k\u00fc\u00e7\u00fck disk (1kg / 1,25kg) kadar art\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u5728\u4f60\u6700\u559c\u6b22\u7684\u7ec3\u4e60\u4e2d\u589e\u52a0\u6700\u5c0f\u7684\u91cd\u91cf\u7247\uff081\u516c\u65a4 / 1.25\u516c\u65a4\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u60a8\u4eca\u5929\u6700\u559c\u6b61\u7684\u904b\u52d5\u7684\u91cd\u91cf\u589e\u52a0\u6700\u5c0f\u7684\u690e\u9593\u76e4\uff081 \u516c\u65a4/1.25 \u516c\u65a4\uff09\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du weichst dem Schmerz aus. Wir erh\u00f6hen die Intensit\u00e4t unmerklich, um deinen K\u00f6rper auszutricksen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You avoid the pain. We increase the intensity subtly to trick your body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitas el dolor. Aumentamos la intensidad sutilmente para enga\u00f1ar a tu cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00e9vitez la douleur. Nous augmentons subtilement l\u2019intensit\u00e9 pour tromper votre corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0926\u0930\u094d\u0926 \u0938\u0947 \u092c\u091a\u0947\u0902. \u0939\u092e \u0906\u092a\u0915\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u0927\u094b\u0916\u093e \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0940\u0935\u094d\u0930\u0924\u093e \u0915\u094b \u0938\u0942\u0915\u094d\u0937\u094d\u092e\u0924\u093e \u0938\u0947 \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eviti il \u200b\u200bdolore. Aumentiamo leggermente l'intensit\u00e0 per ingannare il tuo corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u75db\u307f\u3092\u907f\u3051\u307e\u3059\u3002\u8eab\u4f53\u3092\u3060\u307e\u3059\u3088\u3046\u306b\u3001\u5fae\u5999\u306b\u5f37\u5ea6\u3092\u4e0a\u3052\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uace0\ud1b5\uc744 \ud53c\ud569\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 \ub2f9\uc2e0\uc758 \ubab8\uc744 \uc18d\uc774\uae30 \uc704\ud574 \ubbf8\ubb18\ud558\uac8c \uac15\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vermijdt de pijn. We verhogen de intensiteit subtiel om je lichaam voor de gek te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikasz b\u00f3lu. Subtelnie zwi\u0119kszamy intensywno\u015b\u0107, aby oszuka\u0107 Twoje cia\u0142o."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea evita a dor. Aumentamos a intensidade sutilmente para enganar seu corpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0443\u0445\u043e\u0434\u0438\u0448\u044c \u043e\u0442 \u0431\u043e\u043b\u0438. \u041c\u044b \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u043c \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u043e\u0431\u043c\u0430\u043d\u0443\u0442\u044c \u0442\u0432\u043e\u0451 \u0442\u0435\u043b\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ac\u0131dan ka\u00e7\u0131n\u0131rs\u0131n. V\u00fccudunuzu kand\u0131rmak i\u00e7in yo\u011funlu\u011fu ustaca art\u0131r\u0131yoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u9003\u907f\u75bc\u75db\u3002\u6211\u4eec\u5fae\u5999\u5730\u589e\u52a0\u5f3a\u5ea6\uff0c\u4ee5\u6b3a\u9a97\u4f60\u7684\u8eab\u4f53\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u907f\u514d\u4e86\u75db\u82e6\u3002\u6211\u5011\u5de7\u5999\u5730\u589e\u52a0\u5f37\u5ea6\u4f86\u6b3a\u9a19\u60a8\u7684\u8eab\u9ad4\u3002"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.title": {

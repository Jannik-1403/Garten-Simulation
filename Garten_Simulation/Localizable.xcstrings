        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30ec\u30fc\u30b8\u304b\u3089 .gartensave \u30d5\u30a1\u30a4\u30eb\u3092\u9078\u629e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\uc18c\uc5d0\uc11c .gartensave \ud30c\uc77c\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een .gartensave-bestand uit uw opslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plik .gartensave ze swojej pami\u0119ci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um ficheiro .gartensave do teu armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043b .gartensave \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043e \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depolama alan\u0131n\u0131zdan bir .gartensave dosyas\u0131 se\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u4f60\u7684\u5b58\u50a8\u4e2d\u9009\u62e9\u4e00\u4e2a .gartensave \u6587\u4ef6\u3002"

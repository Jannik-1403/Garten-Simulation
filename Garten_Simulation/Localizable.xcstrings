    "pfad_activation_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was passiert nach 90 Tagen?\nDu erreichst die Meisterschaft! Deine Pflanze wird sich vollständig entfalten und du baust eine starke, langfristige Gewohnheit auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happens after 90 days?\nYou achieve mastery! Your plant will fully bloom and you'll build a strong, long-lasting habit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasa después de 90 días?\n¡Alcanzas la maestría! Tu planta florecerá completamente y crearás un hábito fuerte y duradero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que se passe-t-il après 90 jours ?\nTu atteins la maîtrise ! Ta plante va complètement s'épanouir et tu vas créer une habitude forte et durable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 दिनों के बाद क्या होगा? \nआप चैम्पियनशिप तक पहुँचें! आपका पौधा पूरी तरह से विकसित हो जाएगा और आप एक मजबूत, दीर्घकालिक आदत बना लेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa succede dopo 90 giorni?\nRaggiungi la maestria! La tua pianta fiorirà completamente e costruirai un'abitudine forte e duratura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90日後はどうなりますか?\nあなたはマスタリーを達成します！あなたの植物は完全に開花し、強力で長く続く習慣を築くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90일 후에는 어떻게 되나요?\n당신은 숙달을 달성합니다! 식물이 완전히 꽃을 피우고 강하고 오래 지속되는 습관을 갖게 될 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat gebeurt er na 90 dagen?\nJij bereikt meesterschap! Je plant zal volledig bloeien en je zult een sterke, langdurige gewoonte opbouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co się stanie po 90 dniach?\nOsiągasz mistrzostwo! Twoja roślina zakwitnie w pełni, a Ty zbudujesz silny, długotrwały nawyk."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que acontece após 90 dias?\nAlcanças a mestria! A tua planta vai florescer completamente e vais construir um hábito forte e duradouro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что происходит через 90 дней? Ты достигаешь мастерства! Твое растение полностью раскроется, и ты вырабатываешь сильную, долгосрочную привычку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 gün sonra ne olur?\nUstalığa ulaşırsınız! Bitkiniz tamamen çiçek açacak ve güçlü, uzun süreli bir alışkanlık geliştireceksiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90天后会发生什么？\n您将达到精通！您的植物将完全绽放，您将养成一个强大而长期的习惯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 天後會發生什麼事？\n你拿到了冠軍！您的植物將完全發育，您將養成強大的長期習慣。"
          }
        }
      }
    },
    "pfad_activation_diff_change_title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ ausgewählt. Bist du noch immer %@ oder willst du das jetzt höher machen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You selected %@. Are you still %@ or do you want to change it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has seleccionado %@. ¿Sigues siendo %@ o quieres cambiarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as sélectionné %@. Es-tu toujours %@ ou veux-tu le changer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने%@का चयन किया. क्या आप अभी भी%@हैं या आप इसे अभी और ऊपर ले जाना चाहते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato %@. Sei ancora %@ o vuoi cambiarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を選択しました。まだ %@ のままですか? それとも変更しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 선택하셨습니다. 아직 %@ 상태인가요, 아니면 변경하시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U heeft %@ geselecteerd. Bent u nog steeds %@ of wilt u dit wijzigen?"
          }
        },
        "pl" : {

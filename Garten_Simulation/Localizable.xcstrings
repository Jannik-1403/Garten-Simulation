    "settings.export.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f6chten Sie alle Ihre Daten exportieren? Sie erhalten eine Datei mit allen Ihren Pflanzen und Fortschritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to export all your data? You will receive a file with all your plants and progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQuieres exportar todos tus datos? Recibir\u00e1s un archivo con todas tus plantas y progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu exporter toutes tes donn\u00e9es ? Tu recevras un fichier avec toutes tes plantes et progressions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0905\u092a\u0928\u0940 \u0938\u092d\u0940 \u0921\u0947\u091f\u093e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947? \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u0938\u092d\u0940 \u092a\u094c\u0927\u094b\u0902 \u0914\u0930 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u092b\u093c\u093e\u0907\u0932 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to export all your data? You will receive a file with all your plants and progress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u30c7\u30fc\u30bf\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3057\u307e\u3059\u304b?\u3059\u3079\u3066\u306e\u690d\u7269\u3068\u9032\u6357\u72b6\u6cc1\u304c\u8a18\u8f09\u3055\u308c\u305f\u30d5\u30a1\u30a4\u30eb\u3092\u53d7\u3051\u53d6\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \ub370\uc774\ud130\ub97c \ub0b4\ubcf4\ub0b4\uc2dc\uaca0\uc2b5\ub2c8\uae4c? \ubaa8\ub4e0 \uc2dd\ubb3c\uacfc \uc9c4\ud589 \uc0c1\ud669\uc774 \ud3ec\ud568\ub41c \ud30c\uc77c\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u al uw gegevens exporteren? U ontvangt een bestand met al uw planten en de voortgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz wyeksportowa\u0107 wszystkie swoje dane? Otrzymasz plik ze wszystkimi swoimi ro\u015blinami i post\u0119pami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres exportar todos os teus dados? Receber\u00e1s um ficheiro com todas as tuas plantas e progresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0425\u043e\u0442\u0438\u0442\u0435 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u0432\u0430\u0448\u0438 \u0434\u0430\u043d\u043d\u044b\u0435? \u0412\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435 \u0444\u0430\u0439\u043b \u0441\u043e \u0432\u0441\u0435\u043c\u0438 \u0432\u0430\u0448\u0438\u043c\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f\u043c\u0438 \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00fcm verilerinizi d\u0131\u015fa aktarmak istiyor musunuz? T\u00fcm bitkilerinizi ve ilerlemenizi i\u00e7eren bir dosya alacaks\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u60f3\u5bfc\u51fa\u6240\u6709\u6570\u636e\u5417\uff1f\u60a8\u5c06\u6536\u5230\u4e00\u4efd\u5305\u542b\u6240\u6709\u690d\u7269\u548c\u8fdb\u5ea6\u7684\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u60f3\u532f\u51fa\u6240\u6709\u6578\u64da\u55ce\uff1f\u60a8\u5c07\u6536\u5230\u4e00\u4efd\u5305\u542b\u6240\u6709\u690d\u7269\u548c\u9032\u5ea6\u7684\u6587\u4ef6\u3002"
          }
        }
      }
    },

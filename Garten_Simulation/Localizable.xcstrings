    "assessment.growth.q15" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du reflektierst dein letztes Jahr. Du hast keines deiner großen Ziele erreicht. Was ist deine ehrliche Diagnose?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You reflect on your last year. You haven't achieved any of your big goals. What is your honest diagnosis?"

    "plant.lavendel.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine entspannte Routine für tiefen und erholsamen Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relaxed routine for deep and restful sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rutina relajada para un sueño profundo y reparador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une routine détendue pour un sommeil profond et réparateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गहरे और आरामदायक नींद के लिए एक आसान दिनचर्या।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una routine rilassata per un sonno profondo e ristoratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深く安らかな睡眠のためのリラックスしたルーチン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊고 편안한 수면을 위한 편안한 루틴."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ontspannen routine voor een diepe en rustgevende slaap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaksująca rutyna dla głębokiego i spokojnego snu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma rotina relaxada para um sono profundo e reparador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma rotina relaxada para um sono profundo e reparador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расслабляющий распорядок для глубокого и восстанавливающего сна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derin ve dinlendirici bir uyku için rahatlatıcı bir rutin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个放松的日常，带来深度和恢复性睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種放鬆的習慣，讓您獲得深度、安寧的睡眠。"
          }
        }
      }
    },
    "plant.lotus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blüht im Schlamm – Ruhe trotz Stress"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blooms in mud – peace despite stress"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Florece en el barro – paz a pesar del estrés"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleurit dans la boue – paix malgré le stress"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचड़ में खिलता है – तनाव के बावजूद शांति"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiorisce nel fango – calma nonostante lo stress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "泥の中で咲く – ストレスにもかかわらず平和"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진흙 속에서 피어나는 꽃 – 스트레스에도 불구하고 평화"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeit in de modder – vrede ondanks stress"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwitnie w błocie – spokój pomimo stresu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce na lama – paz apesar do stress"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Floresce na lama – paz apesar do stress"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цветёт в грязи – спокойствие несмотря на стресс"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çamurda çiçek açar – strese rağmen huzur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在泥泞中绽放 – 压力下的平静"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "泥濘中綻放－儘管有壓力仍保持平靜"
          }
        }
      }
    },

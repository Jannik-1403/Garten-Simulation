    "item.gluecks_segen.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und segnet deinen Garten mit schnellem Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and blesses your garden with rapid growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und segnet deinen Garten mit schnellem Wachstum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active imm\u00e9diatement et b\u00e9nit ton jardin d'une croissance rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0930\u0902\u0924 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u094b \u0924\u0947\u091c\u0940 \u0938\u0947 \u0935\u093f\u0915\u093e\u0938 \u0915\u093e \u0906\u0936\u0940\u0930\u094d\u0935\u093e\u0926 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and blesses your garden with rapid growth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u6d3b\u767a\u306b\u306a\u308a\u3001\u5ead\u3092\u6025\u901f\u306b\u6210\u9577\u3055\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uc5b4 \uc815\uc6d0\uc774 \ube60\ub974\uac8c \uc131\uc7a5\ud558\ub3c4\ub85d \ucd95\ubcf5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en zegent uw tuin met snelle groei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast staje si\u0119 aktywny i b\u0142ogos\u0142awi Tw\u00f3j ogr\u00f3d szybkim wzrostem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e aben\u00e7oa o teu jardim com crescimento r\u00e1pido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0441\u0440\u0430\u0437\u0443 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u043b\u043e\u0432\u043b\u044f\u0435\u0442 \u0432\u0430\u0448 \u0441\u0430\u0434 \u0431\u044b\u0441\u0442\u0440\u044b\u043c \u0440\u043e\u0441\u0442\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve bah\u00e7enize h\u0131zl\u0131 bir b\u00fcy\u00fcme sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u4e3a\u4f60\u7684\u82b1\u56ed\u5e26\u6765\u5feb\u901f\u751f\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u63a1\u53d6\u884c\u52d5\uff0c\u795d\u798f\u60a8\u7684\u82b1\u5712\u5feb\u901f\u751f\u9577\u3002"
          }
        }
      }
    },
    "item.goldener_schluessel.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wertvoller Schl\u00fcssel, der das volle Wachstumspotenzial deines Gartens f\u00fcr eine Woche entriegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A valuable key that unlocks the full growth potential of your garden for one week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valiosa llave que desbloquea el potencial de crecimiento completo de tu jard\u00edn durante una semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pr\u00e9cieuse cl\u00e9 qui d\u00e9verrouille le plein potentiel de croissance de ton jardin pendant une semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092e\u0942\u0932\u094d\u092f\u0935\u093e\u0928 \u0915\u0941\u0902\u091c\u0940 \u091c\u094b \u090f\u0915 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u0940 \u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u0915\u093e\u0938 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u094b \u0916\u094b\u0932 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A valuable key that unlocks the full growth potential of your garden for one week."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u306e\u6f5c\u5728\u7684\u306a\u6210\u9577\u306e\u53ef\u80fd\u6027\u3092 1 \u9031\u9593\u89e3\u653e\u3059\u308b\u8cb4\u91cd\u306a\u9375\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc8fc\uc77c \ub3d9\uc548 \uc815\uc6d0\uc758 \uc131\uc7a5 \uc7a0\uc7ac\ub825\uc744 \ucd5c\ub300\ud55c \ubc1c\ud718\ud560 \uc218 \uc788\ub294 \uadc0\uc911\ud55c \uc5f4\uc1e0\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een waardevolle sleutel die gedurende \u00e9\u00e9n week het volledige groeipotentieel van uw tuin ontsluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cenny klucz, kt\u00f3ry odblokowuje pe\u0142ny potencja\u0142 wzrostu Twojego ogrodu na tydzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave valiosa que desbloqueia todo o potencial de crescimento do teu jardim durante uma semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u043d\u043d\u044b\u0439 \u043a\u043b\u044e\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0432\u0435\u0441\u044c \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b \u0440\u043e\u0441\u0442\u0430 \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u0430\u0434\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7enizin bir hafta boyunca tam b\u00fcy\u00fcme potansiyelini ortaya \u00e7\u0131karacak de\u011ferli bir anahtar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u628a\u73cd\u8d35\u7684\u94a5\u5319\uff0c\u53ef\u5728\u4e00\u5468\u5185\u89e3\u9501\u4f60\u82b1\u56ed\u7684\u5168\u90e8\u751f\u957f\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u628a\u5bf6\u8cb4\u7684\u9470\u5319\uff0c\u53ef\u4ee5\u8b93\u60a8\u7684\u82b1\u5712\u5728\u4e00\u5468\u5167\u5145\u5206\u767c\u63ee\u751f\u9577\u6f5b\u529b\u3002"
          }
        }
      }
    },

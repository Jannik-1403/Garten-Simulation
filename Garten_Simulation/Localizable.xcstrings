        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez un nom pour votre traqueur de progression personnalis\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0938\u094d\u0935\u092f\u0902 \u0915\u0947 \u092a\u094d\u0930\u0917\u0924\u093f \u091f\u094d\u0930\u0948\u0915\u0930 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome per il tuo tracker di progressi personalizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ab\u30b9\u30bf\u30e0\u9032\u6357\u30c8\u30e9\u30c3\u30ab\u30fc\u306e\u540d\u524d\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc9c4\ud589\ub960 \ud2b8\ub798\ucee4\uc758 \uc774\ub984\uc744 \uc785\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een naam in voor uw aangepaste voortgangstracker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nazw\u0119 dla swojego niestandardowego trackera post\u0119p\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um nome para o seu rastreador de progresso personalizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0440\u0435\u043a\u0435\u0440\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6zel ilerleme izleyiciniz i\u00e7in bir ad girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u4f60\u81ea\u5df1\u7684\u8fdb\u5ea6\u8ddf\u8e2a\u5668\u8f93\u5165\u4e00\u4e2a\u540d\u79f0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f38\u5165\u60a8\u81ea\u5df1\u7684\u9032\u5ea6\u8ffd\u8e64\u5668\u7684\u540d\u7a31\u3002"
          }
        }
      }
    },

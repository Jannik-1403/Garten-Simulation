    "prog_deepwork_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dein Handy in den Flugmodus und schließe alle Mail/Chat-Programme auf dem Desktop. Volle Isolation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch your phone to airplane mode and close all email/chat programs on the desktop. Complete isolation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie su teléfono al modo avión y cierre todos los programas de correo electrónico/chat en el escritorio. Aislamiento completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez votre téléphone en mode avion et fermez tous les programmes de messagerie/chat sur le bureau. Isolement complet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ोन को एयरप्लेन मोड पर स्विच करें और डेस्कटॉप पर सभी ईमेल/चैट प्रोग्राम बंद करें। पूर्ण अलगाव."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il telefono alla modalità aereo e chiudi tutti i programmi di posta elettronica/chat sul desktop. Isolamento completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話を機内モードに切り替え、デスクトップ上のすべての電子メール/チャット プログラムを閉じます。完全な隔離。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 비행기 모드로 전환하고 데스크톱의 모든 이메일/채팅 프로그램을 닫습니다. 완전한 격리."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet uw telefoon op vliegtuigmodus en sluit alle e-mail-/chatprogramma's op het bureaublad. Volledige isolatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącz telefon w tryb samolotowy i zamknij wszystkie programy do obsługi poczty/czatu na pulpicie. Całkowita izolacja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude seu telefone para o modo avião e feche todos os programas de e-mail/chat na área de trabalho. Isolamento completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude seu telefone para o modo avião e feche todos os programas de e-mail/chat na área de trabalho. Isolamento completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите телефон в режим полета и закройте все программы электронной почты и чата на рабочем столе. Полная изоляция."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzu uçak moduna alın ve masaüstündeki tüm e-posta/sohbet programlarını kapatın. Tam izolasyon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机切换到飞行模式并关闭桌面上的所有电子邮件/聊天程序。完全隔离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將手機切換到飛航模式並關閉桌面上的所有電子郵件/聊天程式。完全隔離。"
          }
        }
      }
    },

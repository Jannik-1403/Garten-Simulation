          }
        }
      }
    },
    "assessment.lifestyle.profile.chaot.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Kleidung abends nicht auf dem Stuhl liegen \u2013 h\u00e4ng sie sofort an den Haken (dauert 3 Sekunden)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't leave your clothes on the chair in the evening - hang them on the hook immediately (takes 3 seconds)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dejes tu ropa en la silla por la noche; cu\u00e9lgala inmediatamente en el gancho (tarda 3 segundos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laissez pas vos v\u00eatements sur la chaise le soir \u2013 accrochez-les imm\u00e9diatement au crochet (cela prend 3 secondes)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0915\u094b \u0905\u092a\u0928\u0947 \u0915\u092a\u0921\u093c\u0947 \u0915\u0941\u0930\u094d\u0938\u0940 \u092a\u0930 \u0928 \u091b\u094b\u0921\u093c\u0947\u0902 - \u0909\u0928\u094d\u0939\u0947\u0902 \u0924\u0941\u0930\u0902\u0924 \u0939\u0941\u0915 \u092a\u0930 \u0932\u091f\u0915\u093e \u0926\u0947\u0902 (3 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902)\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera non lasciare i vestiti sulla sedia: appendili subito al gancio (ci vogliono 3 secondi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5915\u65b9\u306b\u306f\u8863\u670d\u3092\u6905\u5b50\u306e\u4e0a\u306b\u6b8b\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u3059\u3050\u306b\u30d5\u30c3\u30af\u306b\u639b\u3051\u3066\u304f\u3060\u3055\u3044\uff083\u79d2\u304b\u304b\u308a\u307e\u3059\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub141\uc5d0\ub294 \uc637\uc744 \uc758\uc790 \uc704\uc5d0 \ub450\uc9c0 \ub9c8\uc138\uc694. \uc989\uc2dc \uc637\uac78\uc774\uc5d0 \uac78\uc5b4\uc8fc\uc138\uc694(3\ucd08 \uc18c\uc694)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je kleding 's avonds niet op de stoel liggen, maar hang ze meteen aan het haakje (duurt 3 seconden)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zostawiaj ubra\u0144 na krze\u015ble wieczorem \u2013 od razu powie\u015b je na wieszaku (trwa to 3 sekundy)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o deixe suas roupas na cadeira \u00e0 noite - pendure-as no gancho imediatamente (leva 3 segundos)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439 \u043e\u0434\u0435\u0436\u0434\u0443 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u043d\u0430 \u0441\u0442\u0443\u043b\u0435 \u2013 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u0432\u0435\u0441\u044c \u0435\u0451 \u043d\u0430 \u043a\u0440\u044e\u0447\u043e\u043a (\u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 3 \u0441\u0435\u043a\u0443\u043d\u0434\u044b)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u015famlar\u0131 k\u0131yafetlerinizi sandalyenin \u00fczerinde b\u0131rakmay\u0131n; hemen kancaya as\u0131n (3 saniye s\u00fcrer)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u4e0d\u8981\u628a\u8863\u670d\u653e\u5728\u6905\u5b50\u4e0a\u2014\u2014\u7acb\u5373\u628a\u5b83\u6302\u5230\u94a9\u5b50\u4e0a\uff08\u53ea\u97003\u79d2\u949f\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u665a\u4e0a\u4e0d\u8981\u628a\u8863\u670d\u7559\u5728\u6905\u5b50\u4e0a - \u7acb\u5373\u5c07\u5b83\u5011\u639b\u5728\u639b\u9264\u4e0a\uff08\u9700\u8981 3 \u79d2\u9418\uff09\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.profile.chaot.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlasse keinen Raum mit leeren H\u00e4nden. Nimm immer eine Sache mit, die an ihren Platz geh\u00f6rt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't leave a room empty-handed. Always take one thing with you that belongs in its place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dejes una habitaci\u00f3n con las manos vac\u00edas. Lleva siempre contigo algo que pertenezca a su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne quittez pas une pi\u00e8ce les mains vides. Emportez toujours avec vous une chose qui doit \u00eatre \u00e0 sa place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u0915\u092e\u0930\u0947 \u0915\u094b \u0916\u093e\u0932\u0940 \u0939\u093e\u0925 \u0928 \u091b\u094b\u0921\u093c\u0947\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0947 \u0938\u093e\u0925 \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c \u0932\u0947 \u091c\u093e\u090f\u0902 \u091c\u094b \u0905\u092a\u0928\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lasciare una stanza a mani vuote. Porta sempre con te una cosa che appartiene al suo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u624b\u3076\u3089\u3067\u90e8\u5c4b\u3092\u51fa\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u5e38\u306b\u305d\u306e\u5834\u6240\u306b\u3075\u3055\u308f\u3057\u3044\u3082\u306e\u3092 1 \u3064\u6301\u3061\u6b69\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube48\uc190\uc73c\ub85c \ubc29\uc744 \ub5a0\ub098\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \ud56d\uc0c1 \uadf8 \uc790\ub9ac\uc5d0 \uc18d\ud55c \uac83 \ud55c \uac00\uc9c0\ub97c \uac00\uc9c0\uace0 \uac00\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een kamer niet met lege handen achter. Neem altijd \u00e9\u00e9n ding mee dat op zijn plaats hoort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wychod\u017a z pokoju z pustymi r\u0119kami. Zawsze zabieraj ze sob\u0105 jedn\u0105 rzecz, kt\u00f3ra nale\u017cy na swoje miejsce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o saia de uma sala de m\u00e3os vazias. Sempre leve com voc\u00ea algo que perten\u00e7a ao seu lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u043e\u043a\u0438\u0434\u0430\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0443 \u0441 \u043f\u0443\u0441\u0442\u044b\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438. \u0412\u0441\u0435\u0433\u0434\u0430 \u0431\u0435\u0440\u0438 \u0441 \u0441\u043e\u0431\u043e\u0439 \u0432\u0435\u0449\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0441\u0432\u043e\u0451\u043c \u043c\u0435\u0441\u0442\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oday\u0131 eliniz bo\u015f b\u0131rakmay\u0131n. Her zaman yan\u0131n\u0131za onun yerine ait olan bir \u015fey al\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u7a7a\u624b\u79bb\u5f00\u4efb\u4f55\u623f\u95f4\u3002\u603b\u662f\u5e26\u8d70\u4e00\u4ef6\u653e\u56de\u539f\u4f4d\u7684\u4e1c\u897f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u7a7a\u624b\u96e2\u958b\u623f\u9593\u3002\u96a8\u6642\u96a8\u8eab\u651c\u5e36\u4e00\u4ef6\u5c6c\u65bc\u5176\u4f4d\u7f6e\u7684\u6771\u897f\u3002"
          }
        }
      }
    },

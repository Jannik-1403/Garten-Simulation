    "export.bad_habits.max_streak": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4ngster Streak ohne R\u00fcckfall: %lld Tage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longest Streak Without Relapse: %lld Days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racha m\u00e1s larga sin recaer: %lld d\u00edas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus longue s\u00e9rie sans rechute : %lld jours"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u093e\u0935\u0943\u0924\u094d\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0938\u092c\u0938\u0947 \u0932\u0902\u092c\u0940 \u0932\u0915\u0940\u0930:%lld \u0926\u093f\u0928"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie pi\u00f9 lunga senza ricadute: %lld giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u518d\u767a\u306a\u3057\u306e\u6700\u9577\u30b9\u30c8\u30ea\u30fc\u30af: %lld\u65e5"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7ac\ubc1c \uc5c6\ub294 \ucd5c\uc7a5 \uc2a4\ud2b8\ub9ad: %lld\uc77c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Langste streak zonder terugval: %lld dagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najd\u0142u\u017csza seria bez nawrotu: %lld dni"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maior Sequ\u00eancia Sem Reca\u00edda: %lld Dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0430\u043c\u0430\u044f \u0434\u043b\u0438\u043d\u043d\u0430\u044f \u043f\u043e\u043b\u043e\u0441\u0430 \u0431\u0435\u0437 \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430:%lld \u0434\u043d\u0435\u0439"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00fcksetmeden En Uzun Seri: %lld G\u00fcn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u957f\u672a\u590d\u53d1\u8fde\u7eed\u5929\u6570\uff1a%lld \u5929"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u9577\u9023\u7e8c\u7121\u5fa9\u767c\uff1a%lld \u5929"

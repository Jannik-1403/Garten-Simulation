    "trash.zigaretten_automat.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass kein Feuerzeug im Haus – jeder Zündungsmoment kostet Willenskraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't keep a lighter in the house – every ignition moment costs willpower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No guardes un encendedor en casa: cada momento de encendido cuesta fuerza de voluntad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laisse pas de briquet dans la maison – chaque moment d'allumage coûte de la volonté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर में कोई लाइटर मत छोड़ो – हर अराजकता का क्षण इच्छाशक्ति की लागत देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tenere un accendino in casa – ogni momento di accensione costa forza di volontà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家にライターを置かないようにしましょう。火をつける瞬間に意志の力が消耗されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집에 라이터를 두지 마세요 – 불을 붙이는 순간마다 의지력이 소모됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat geen aansteker in huis – elk ontstekkingsmoment kost wilskracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie trzymaj zapalniczki w domu – każdy moment zapalenia kosztuje siłę woli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deixe isqueiro em casa – cada momento de acender custa força de vontade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deixe isqueiro em casa – cada momento de acender custa força de vontade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не оставляйте зажигалку в доме – каждое мгновение зажигания требует силы воли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde çakmak bulundurma – her ateşleme anı irade gücü harcar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把打火机留在家里——每一次点火都需要意志力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把打火機留在家裡——每一次點火都需要意志力。"
          }
        }
      }
    },
    "trash.zigaretten_automat.tip.2": {
      "extractionState": "manual",

    "body.tracking.status.bulking.fat.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewichtszunahme zu aggressiv. Du baust unnötig Fett auf. Kalorien um 200 kcal senken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight gain is too aggressive. You are building unnecessary fat. Reduce calories by 200 kcal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aumento de peso es demasiado agresivo. Estás acumulando grasa innecesaria. Reduce las calorías en 200 kcal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de poids trop agressive. Vous gagnez de la graisse inutilement. Réduisez les calories de 200 kcal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन बहुत आक्रामक तरीके से बढ़ना। आप अनावश्यक वसा प्राप्त कर रहे हैं। कैलोरी को 200 किलो कैलोरी कम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumento di peso troppo aggressivo. Stai ingrassando inutilmente. Ridurre le calorie di 200 kcal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重増加が激しすぎる。不必要な脂肪が増えてしまいます。カロリーを200kcalカット。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 증가가 너무 공격적입니다. 불필요한 지방이 늘어나고 있습니다. 칼로리를 200kcal 줄입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewichtstoename te agressief. Je krijgt onnodig vet. Verminder het aantal calorieën met 200 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt agresywny przyrost masy ciała. Przybierasz niepotrzebny tłuszcz. Zmniejsz kalorie o 200 kcal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganho de peso muito rápido. Reduza 200 kcal para evitar acúmulo de gordura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganho de peso muito agressivo. Você está ganhando gordura desnecessária. Reduza as calorias em 200 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор веса слишком агрессивный. Вы набираете ненужный жир. Уменьшите калорийность на 200 ккал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo alımı çok agresif. Gereksiz yağ kazanıyorsun. Kalorileri 200 kcal azaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体重增长过于激进。你正在增加不必要的脂肪。减少热量200大卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體重增長過於激進。你正在增加不必要的脂肪。減少熱量200大卡。"
          }
        }
      }

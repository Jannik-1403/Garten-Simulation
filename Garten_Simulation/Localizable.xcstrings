    "settings.display.mode.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob der Name der Pflanze/Schlechte Gewohnheit oder die verknüpfte Gewohnheit im Garten angezeigt werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether to display the plant/item name or the linked habit in the garden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si quieres ver el nombre de la planta o el hábito vinculado en el jardín."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis si le nom de la plante ou l'habitude liée doit être affiché dans le jardin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि पौधे/खराब आदत का नाम या बगीचे में जुड़ी हुई आदत दिखाई दे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether to display the plant name or the linked habit in the garden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "庭内の植物の名前またはリンクされた習性を表示するかどうかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정원에 식물 이름을 표시할지, 연결된 습관을 표시할지 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of u de plantnaam of de daaraan gekoppelde gewoonte in de tuin wilt weergeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy chcesz wyświetlać nazwę rośliny, czy powiązany zwyczaj w ogrodzie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe se o nome da planta ou o hábito associado deve ser exibido no jardim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, должно ли отображаться название растения/плохой привычки или связанная привычка в саду."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahçede bitki adının mı yoksa bağlantılı alışkanlığın mı görüntüleneceğini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择是否显示植物名称/坏习惯或花园中的相关习惯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇是否顯示植物名稱/壞習慣或花園中的相關習慣。"
          }
        }
      }
    },

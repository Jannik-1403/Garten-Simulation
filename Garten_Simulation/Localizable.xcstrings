    "assessment.fitness.profile.ausreden_sucher.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akzeptiere die Realität. Dein Körper ist das exakte Resultat deiner Entscheidungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept reality. Your body is the exact result of your decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepta la realidad. Tu cuerpo es el resultado exacto de tus decisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptez la réalité. Votre corps est le résultat exact de vos décisions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वास्तविकता को स्वीकार करें. आपका शरीर आपके निर्णयों का सटीक परिणाम है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetta la realtà. Il tuo corpo è il risultato esatto delle tue decisioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現実を受け入れてください。あなたの体はあなたの決断の正確な結果です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현실을 받아들이세요. 당신의 몸은 당신이 내린 결정의 정확한 결과입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepteer de realiteit. Je lichaam is het exacte resultaat van je beslissingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaakceptuj rzeczywistość. Twoje ciało jest dokładnym rezultatem Twoich decyzji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceite a realidade. Seu corpo é o resultado exato de suas decisões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прими реальность. Твое тело — это точный результат твоих решений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçekliği kabul edin. Vücudunuz kararlarınızın kesin sonucudur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受现实。你的身体是你决定的确切结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受現實。你的身體是你的決定的確切結果。"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.break" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutze niemals die Worte 'keine Zeit'. Sag stattdessen laut: 'Sport hat für mich heute keine Priorität'."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never use the words 'no time'. Instead, say out loud: 'Exercise is not a priority for me today.'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca utilices las palabras \"no hay tiempo\". En lugar de eso, diga en voz alta: \"El ejercicio no es una prioridad para mí hoy\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'utilisez jamais les mots « pas le temps ». Dites plutôt à voix haute : « L'exercice n'est pas une priorité pour moi aujourd'hui. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी भी 'समय नहीं' शब्द का प्रयोग न करें। इसके बजाय, ज़ोर से कहें: 'व्यायाम आज मेरे लिए प्राथमिकता नहीं है।'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non usare mai le parole \"non c'è tempo\". Invece, dì ad alta voce: \"L'esercizio fisico non è una priorità per me oggi\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「時間がない」という言葉は決して使わないでください。代わりに、「今日は運動は私にとって優先事項ではありません」と声に出して言ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'시간이 없다'는 말은 절대 사용하지 마세요. 대신 '오늘은 운동이 우선순위가 아니다'라고 큰 소리로 말해보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik nooit de woorden ‘geen tijd’. Zeg in plaats daarvan hardop: 'Bewegen heeft vandaag geen prioriteit voor mij.'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigdy nie używaj słów „nie ma czasu”. Zamiast tego powiedz na głos: „Ćwiczenia nie są dziś dla mnie priorytetem”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca use as palavras 'sem tempo'. Em vez disso, diga em voz alta: 'O exercício não é uma prioridade para mim hoje.'"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не используй слова 'нет времени'. Скажи вместо этого вслух: 'Спорт для меня сегодня не является приоритетом'."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asla 'zaman yok' kelimesini kullanmayın. Bunun yerine yüksek sesle şunu söyleyin: 'Egzersiz bugün benim için bir öncelik değil.'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远不要使用'没有时间'这几个词。取而代之，大声说：'今天运动对我来说不是优先事项'。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永遠不要使用“沒有時間”這個詞。相反，大聲說：“今天鍛煉不是我的首要任務。”"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.build" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite deine Sporttasche abends vor und stelle sie exakt vor die Haustür, sodass du darüber stolperst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare your sports bag in the evening and place it exactly in front of the front door so that you can trip over it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare su bolsa de deporte por la noche y colóquela exactamente delante de la puerta de entrada para que pueda tropezarse con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez votre sac de sport le soir et placez-le exactement devant la porte d'entrée pour pouvoir trébucher dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शाम को अपना स्पोर्ट्स बैग तैयार करें और उसे सामने वाले दरवाजे के ठीक सामने रखें ताकि आप उस पर से फिसल सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparate la sera la vostra borsa sportiva e posizionatela esattamente davanti alla porta d'ingresso in modo da poterci inciampare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方にはスポーツバッグを準備し、つまずいても大丈夫なように玄関のすぐ前に置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁에 스포츠 가방을 준비하고 걸려 넘어질 수 있도록 정문 바로 앞에 놓아두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je sporttas 's avonds klaar en plaats deze precies voor de voordeur, zodat je erover kunt struikelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieczorem przygotuj torbę sportową i umieść ją dokładnie przed drzwiami wejściowymi, tak aby można było się o nią potknąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare sua bolsa esportiva à noite e coloque-a exatamente em frente à porta da frente para que você possa tropeçar nela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приготовь свою спортивную сумку вечером и поставь её прямо перед дверью, чтобы ты на неё споткнулся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam spor çantanızı hazırlayın ve takılıp düşebileceğiniz şekilde tam ön kapının önüne yerleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上准备好你的运动包，并将它准确地放在门前，以至于你会绊倒它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上準備好你的運動包，把它放在前門正前方，這樣你就不會被它絆倒。"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verwaltest Ausreden. Durch 1％ Vorbereitung am Vorabend eliminierst du die Option, abzusagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You manage excuses. By preparing 1％ the night before, you eliminate the option of canceling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú manejas las excusas. Al preparar el 1％ la noche anterior, eliminas la opción de cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gérez les excuses. En préparant 1％ la veille, vous éliminez la possibilité d’annuler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बहाने बनाते हैं. एक रात पहले 1％ तैयारी करके, आप रद्द करने का विकल्प समाप्त कर देते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisci le scuse. Preparando l'1％ la sera prima, elimini la possibilità di annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは言い訳を管理します。前日の夜に1％を準備しておけば、キャンセルの選択肢がなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 변명을 관리합니다. 전날 밤 1％를 준비하면 취소할 가능성이 없어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beheert excuses. Door de avond ervoor 1％ voor te bereiden, elimineert u de mogelijkheid om te annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarządzasz wymówkami. Przygotowując 1％ dzień wcześniej, eliminujesz możliwość rezygnacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você gerencia desculpas. Ao preparar 1％ na noite anterior, você elimina a opção de cancelamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты управляешь оправданиями. Всего 1％ подготовки накануне устраняет возможность отмены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahaneleri yönetiyorsun. ％1'i bir gece önceden hazırlayarak iptal seçeneğini ortadan kaldırırsınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在管理借口。通过前一晚 1％ 的准备，你可以消除取消的选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你管理藉口。透過前一天晚上準備 1％，您就無需取消預訂。"
          }
        }
      }
    },
    "assessment.fitness.profile.ausreden_sucher.title" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {

    "onboarding_tutorial_interactive_shop_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Shop kannst du deine Coins gegen tolle Gegenst\u00e4nde eintauschen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the shop, you can exchange your coins for great items!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1En la tienda puedes canjear tus monedas por objetos geniales!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la boutique, tu peux \u00e9changer tes pi\u00e8ces contre de superbes objets !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0915\u093e\u0928 \u092e\u0947\u0902 \u0906\u092a \u092c\u0922\u093c\u093f\u092f\u093e \u0935\u0938\u094d\u0924\u0941\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0938\u093f\u0915\u094d\u0915\u094b\u0902 \u0915\u093e \u0906\u0926\u093e\u0928-\u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In the shop, you can exchange your coins for great items!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e7\u30c3\u30d7\u3067\u306f\u30b3\u30a4\u30f3\u3092\u7d20\u6575\u306a\u30a2\u30a4\u30c6\u30e0\u3068\u4ea4\u63db\u3067\u304d\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\uc810\uc5d0\uc11c\ub294 \ucf54\uc778\uc744 \uba4b\uc9c4 \uc544\uc774\ud15c\uc73c\ub85c \uad50\ud658\ud560 \uc218 \uc788\uc5b4\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de winkel kun je je munten inwisselen voor leuke items!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sklepie mo\u017cesz wymieni\u0107 swoje monety na wspania\u0142e przedmioty!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na loja, podes trocar as tuas moedas por itens incr\u00edveis!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0442\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u043e\u0431\u043c\u0435\u043d\u044f\u0442\u044c \u0441\u0432\u043e\u0438 \u043c\u043e\u043d\u0435\u0442\u044b \u043d\u0430 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u011fazada paralar\u0131n\u0131z\u0131 harika e\u015fyalarla de\u011fi\u015ftirebilirsiniz!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5546\u5e97\u91cc\uff0c\u4f60\u53ef\u4ee5\u7528\u91d1\u5e01\u5151\u6362\u5f88\u68d2\u7684\u7269\u54c1\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5546\u5e97\u88e1\u60a8\u53ef\u4ee5\u7528\u91d1\u5e63\u514c\u63db\u7cbe\u7f8e\u7269\u54c1\uff01"
          }

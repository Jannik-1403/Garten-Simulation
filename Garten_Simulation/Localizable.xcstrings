    "pfad_fehlt_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage an deinem Ziel gearbeitet. Bleib dran!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked on your goal for 7 days. Keep it up!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash trabajado en tu meta por 7 d\u00edas. \u00a1Sigue as\u00ed!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as travaill\u00e9 sur ton objectif pendant 7 jours. Continue !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u094d\u092f \u092a\u0930 \u0915\u093e\u092e \u0915\u093f\u092f\u093e. \u092c\u0928\u0947 \u0930\u0939\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai lavorato al tuo obiettivo per 7 giorni. Continua cos\u00ec!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7\u65e5\u9593\u76ee\u6a19\u306b\u5411\u304b\u3063\u3066\u53d6\u308a\u7d44\u307f\u307e\u3057\u305f\u3002\u305d\u308c\u3092\u7dad\u6301\u3059\u308b\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7\uc77c \ub3d9\uc548 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ub178\ub825\ud588\uc2b5\ub2c8\ub2e4. \uacc4\uc18d\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagen lang aan je doel gewerkt. Ga zo door!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracowa\u0142em nad swoim celem przez 7 dni. Tak trzymaj!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhaste no teu objetivo por 7 dias. Continua assim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 \u0434\u043d\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u0430\u043b \u043d\u0430\u0434 \u0441\u0432\u043e\u0435\u0439 \u0446\u0435\u043b\u044c\u044e. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0432 \u0442\u043e\u043c \u0436\u0435 \u0434\u0443\u0445\u0435!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 g\u00fcn boyunca hedefiniz \u00fczerinde \u00e7al\u0131\u015ft\u0131m. Aynen b\u00f6yle devam!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4e3a\u60a8\u7684\u76ee\u6807\u52aa\u529b\u4e867\u5929\u3002\u575a\u6301\u4e0b\u53bb\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u4f60\u7684\u76ee\u6a19\u52aa\u529b\u4e86 7 \u5929\u3002\u656c\u8acb\u95dc\u6ce8\uff01"
          }
        }
      }
    },

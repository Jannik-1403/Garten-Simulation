    "assessment.finance.profile.impulsiver.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest – aber fast immer zu schnell. Dein größtes finanzielles Risiko sitzt nicht im Markt. Es sitzt in den 10 Sekunden zwischen Impuls und Handlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide – but almost always too quickly. Your biggest financial risk is not in the market. It sits in the 10 seconds between impulse and action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú decides, pero casi siempre demasiado rápido. Su mayor riesgo financiero no está en el mercado. Se sitúa en los 10 segundos entre el impulso y la acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous décidez – mais presque toujours trop vite. Votre plus gros risque financier ne réside pas dans le marché. Il se situe dans les 10 secondes entre l’impulsion et l’action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei tu a decidere, ma quasi sempre troppo in fretta. Il tuo più grande rischio finanziario non è nel mercato. Si trova nei 10 secondi tra impulso e azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決めるのはあなたですが、ほとんどの場合、早すぎます。最大の財務リスクは市場にありません。それは衝動と行動の間の10秒間にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 결정하지만 거의 항상 너무 빠릅니다. 가장 큰 재정적 위험은 시장에 있지 않습니다. 충동과 행동 사이의 10초 사이에 위치합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij beslist – maar bijna altijd te snel. Uw grootste financiële risico ligt niet in de markt. Het bevindt zich in de 10 seconden tussen impuls en actie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty decydujesz – ale prawie zawsze za szybko. Największe ryzyko finansowe nie leży na rynku. Znajduje się w 10 sekundach między impulsem a działaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você decide – mas quase sempre rápido demais. Seu maior risco financeiro não está no mercado. Ele fica nos 10 segundos entre o impulso e a ação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz karar verin; ancak neredeyse her zaman çok çabuk. En büyük finansal riskiniz piyasada değil. Dürtü ve eylem arasındaki 10 saniye içinde oturur."
          }
        }
      }
    },

    "assessment.finance.q12" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand bietet dir ein brandneues Investment an, das dir 'garantiert 15％ Rendite pro Jahr ohne Risiko' bringt. Deine Reaktion?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone offers you a brand new investment that gives you a 'guaranteed 15％ return per year with no risk'. Your reaction?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien le ofrece una nueva inversión que le ofrece un \"rendimiento garantizado del 15％ anual sin riesgo\". ¿Tu reacción?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu'un vous propose un tout nouvel investissement qui vous offre un « rendement garanti de 15 ％ par an sans risque ». Votre réaction ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई आपको बिल्कुल नए निवेश की पेशकश करता है जो आपको 'बिना किसी जोखिम के प्रति वर्ष 15％ रिटर्न की गारंटी' देता है। आपकी प्रतिक्रिया?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno ti offre un investimento nuovo di zecca che ti dà un \"rendimento garantito del 15％ annuo senza rischi\". La tua reazione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがあなたに「リスクなしで年間 15％ のリターンを保証」するまったく新しい投資を提案します。あなたの反応は？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 당신에게 '위험 없이 연간 15％ 수익 보장'을 제공하는 새로운 투자를 제안합니다. 당신의 반응은?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand biedt u een gloednieuwe investering aan die u een 'gegarandeerd rendement van 15％ per jaar zonder risico' oplevert. Jouw reactie?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś oferuje Ci zupełnie nową inwestycję, która zapewni Ci „gwarantowany zwrot w wysokości 15％ rocznie bez ryzyka”. Twoja reakcja?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém lhe oferece um investimento totalmente novo que lhe dá um “retorno garantido de 15％ ao ano, sem risco”. Sua reação?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то предлагает тебе совершенно новое инвестирование, которое 'гарантированно приносит 15％ годовых без риска'. Какова твоя реакция?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birisi size 'hiçbir risk olmadan yılda ％15 garantili getiri' sağlayacak yepyeni bir yatırım teklif ediyor. Tepkiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人向你提供一个全新的投资，‘保证每年无风险收益15％’。你的反应是什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人向您提供一項全新的投資，「保證每年 15％ 的回報，無風險」。你的反應？"
          }
        }
      }
    },

    "prog_meditation_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe gedanklich von den Zehen bis zum Scheitel durch deinen Körper. Fühle Spannungen und lasse sie los."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentally walk through your body from your toes to the top of your head. Feel tension and let it go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camine mentalmente por su cuerpo desde los dedos de los pies hasta la parte superior de la cabeza. Siente la tensión y déjala ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez mentalement votre corps, de vos orteils jusqu'au sommet de votre tête. Ressentez la tension et laissez tomber."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मानसिक रूप से अपने शरीर के माध्यम से अपने पैर की उंगलियों से लेकर अपने सिर के ऊपर तक चलें। तनाव महसूस करें और इसे जाने दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cammina mentalmente attraverso il tuo corpo dalle dita dei piedi fino alla sommità della testa. Senti la tensione e lasciala andare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心の中でつま先から頭のてっぺんまで自分の体を歩き回ります。緊張を感じて、それを手放してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발끝부터 머리 꼭대기까지 몸 전체를 정신적으로 걷습니다. 긴장감을 느끼고 놓아주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop mentaal door je lichaam, van je tenen naar de bovenkant van je hoofd. Voel spanning en laat het los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentalnie przejdź przez całe ciało od palców u stóp po czubek głowy. Poczuj napięcie i pozwól mu odejść."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhe mentalmente pelo corpo, dos dedos dos pés ao topo da cabeça. Sinta a tensão e deixe-a ir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhe mentalmente pelo corpo, dos dedos dos pés ao topo da cabeça. Sinta a tensão e deixe-a ir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мысленно пройдитесь по своему телу от пальцев ног до макушки головы. Почувствуйте напряжение и отпустите его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayak parmaklarınızdan başınızın üstüne kadar vücudunuzda zihinsel olarak yürüyün. Gerginliği hissedin ve bırakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精神上从脚趾到头顶走遍你的身体。感到紧张并释放它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精神上從腳趾到頭頂走遍你的身體。感到緊張並釋放它。"
          }
        }
      }
    },

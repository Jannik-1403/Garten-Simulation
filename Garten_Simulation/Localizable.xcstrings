    "assessment.finance.q12.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich lehne sofort ab. Rendite ohne Risiko existiert nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I refuse immediately. There is no return without risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me niego inmediatamente. No hay retorno sin riesgo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je refuse immédiatement. Il n'y a pas de retour sans risque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने तुरंत मना कर दिया. बिना जोखिम के कोई वापसी नहीं है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

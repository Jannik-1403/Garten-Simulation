    "notification.evening.1.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch %d %@! Komm vorbei, bevor der Tag endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still have %d %@! Stop by before the day ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1A\u00fan tienes %d %@! Pasa por aqu\u00ed antes de que acabe el d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as encore %d %@ ! Viens avant la fin de la journ\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0905\u092d\u0940 \u092d\u0940%d%@\u0939\u0948! \u0926\u093f\u0928 \u0916\u093c\u0924\u094d\u092e \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906 \u091c\u093e\u0913."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ancora %d %@! Passa prima che finisca la giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060 %d %@ \u304c\u6b8b\u3063\u3066\u3044\u307e\u3059!\u4e00\u65e5\u304c\u7d42\u308f\u308b\u524d\u306b\u304a\u7acb\u3061\u5bc4\u308a\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 %d%@\uc774 \uc788\uc2b5\ub2c8\ub2e4! \ud558\ub8e8\uac00 \ub05d\ub098\uae30 \uc804\uc5d0 \ub4e4\ub7ec\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog steeds %d %@! Kom langs voordat de dag voorbij is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal masz %d %@! Zatrzymaj si\u0119, zanim dzie\u0144 si\u0119 sko\u0144czy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda tens %d %@! Aparece antes que o dia acabe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0442\u0435\u0431\u044f \u0435\u0449\u0451 \u0435\u0441\u0442\u044c%d%@! \u0417\u0430\u0433\u043b\u044f\u043d\u0438, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0434\u0435\u043d\u044c \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hala %d %@'\u0131n\u0131z var! G\u00fcn bitmeden u\u011fray\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u8fd8\u6709 %d %@\uff01\u5728\u4e00\u5929\u7ed3\u675f\u524d\u8fc7\u6765\u770b\u770b\u5427\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u9084\u6709%d%@\uff01\u5728\u9019\u4e00\u5929\u7d50\u675f\u4e4b\u524d\u904e\u4f86\u3002"
          }
        }
      }
    },

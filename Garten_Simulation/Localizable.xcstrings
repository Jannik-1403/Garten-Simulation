    "plant.apfelbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4hre deinen K\u00f6rper mit gesunden, selbstgekochten Mahlzeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourish your body with healthy, home-cooked meals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutre tu cuerpo con comidas caseras y saludables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nourrissez votre corps avec des repas sains faits maison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u0938\u094d\u0925, \u0918\u0930 \u092a\u0930 \u092c\u0928\u0947 \u092d\u094b\u091c\u0928 \u0938\u0947 \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u092a\u094b\u0937\u0923 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutri il tuo corpo con pasti sani cucinati in casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u624b\u4f5c\u308a\u306e\u5065\u5eb7\u7684\u306a\u98df\u4e8b\u3067\u4f53\u306b\u6804\u990a\u3092\u4e0e\u3048\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac74\uac15\ud55c \uac00\uc815\uc2dd\uc73c\ub85c \ubab8\uc5d0 \uc601\uc591\uc744 \uacf5\uae09\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voed je lichaam met gezonde, zelfgemaakte maaltijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od\u017cywiaj swoje cia\u0142o zdrowymi, domowymi posi\u0142kami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutra seu corpo com refei\u00e7\u00f5es saud\u00e1veis e caseiras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0438\u0442\u0430\u0439 \u0441\u0432\u043e\u0451 \u0442\u0435\u043b\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u043e\u0439, \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0438\u0449\u0435\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuzu sa\u011fl\u0131kl\u0131, ev yap\u0131m\u0131 yemeklerle besleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u5065\u5eb7\u7684\u81ea\u5236\u9910\u98df\u6ecb\u517b\u4f60\u7684\u8eab\u4f53\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u5065\u5eb7\u7684\u5bb6\u5e38\u98ef\u83dc\u6ecb\u990a\u60a8\u7684\u8eab\u9ad4\u3002"
          }
        }
      }
    },
    "plant.bambus_schilf.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexibel aber unzerbrechlich \u2013 Journaling"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible but unbreakable \u2013 Journaling"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible pero irrompible \u2013 Journaling"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible mais incassable \u2013 Journaling"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u091a\u0940\u0932\u093e \u0932\u0947\u0915\u093f\u0928 \u0905\u091f\u0942\u091f - \u091c\u0930\u094d\u0928\u0932\u093f\u0902\u0917"

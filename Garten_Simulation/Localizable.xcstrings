        }
      }
    },
    "trash.luxus_auto.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spendet sanftes Licht am Abend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provides soft light in the evening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporciona luz suave por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournit une lumi\u00e8re douce le soir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0915\u094b \u0915\u094b\u092e\u0932 \u092a\u094d\u0930\u0915\u093e\u0936 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provides soft light in the evening."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5915\u65b9\u306b\u306f\u67d4\u3089\u304b\u306a\u5149\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub141\uc5d0\ub294 \uc740\uc740\ud55c \uc870\uba85\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft 's avonds zacht licht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapewnia delikatne \u015bwiat\u0142o wieczorem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornece luz suave \u00e0 noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043c\u044f\u0433\u043a\u0438\u0439 \u0441\u0432\u0435\u0442 \u0432 \u0432\u0435\u0447\u0435\u0440\u043d\u0435\u0435 \u0432\u0440\u0435\u043c\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u015famlar\u0131 yumu\u015fak \u0131\u015f\u0131k sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u665a\u4e0a\u63d0\u4f9b\u67d4\u548c\u7684\u5149\u7ebf\u3002"
          }
        },
        "zh-Hant": {

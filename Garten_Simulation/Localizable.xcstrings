    "assessment.lifestyle.q7.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bleibe vollkommen ruhig und höflich. Wie ich andere behandle, ist ein Spiegel *meines* Standards."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I remain completely calm and polite. How I treat others is a reflection of *my* standards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanezco completamente tranquilo y educado. La forma en que trato a los demás es un reflejo de *mis* estándares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reste complètement calme et poli. La façon dont je traite les autres est le reflet de *mes* normes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं पूरी तरह शांत और विनम्र रहता हूं.' मैं दूसरों के साथ कैसा व्यवहार करता हूँ यह *मेरे* मानकों का प्रतिबिंब है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimango completamente calmo ed educato. Il modo in cui tratto gli altri riflette i *miei* standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は完全に冷静かつ礼儀正しい態度を保っています。私が他人をどのように扱うかは、*私の* 基準を反映しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 완전히 침착하고 예의바르게 행동합니다. 내가 다른 사람을 대하는 방식은 *나의* 기준을 반영합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik blijf volkomen kalm en beleefd. Hoe ik anderen behandel, is een weerspiegeling van *mijn* normen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuję całkowity spokój i grzeczność. To, jak traktuję innych, jest odzwierciedleniem *moich* standardów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permaneço completamente calmo e educado. A forma como trato os outros é um reflexo dos *meus* padrões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я остаюсь совершенно спокойным и вежливым. То, как я отношусь к другим, является отражением *моего* стандарта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamen sakin ve kibar kalıyorum. Başkalarına nasıl davrandığım *kendi* standartlarımın bir yansımasıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我保持完全的冷静和礼貌。我对待他人的方式，是我标准的反映。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我保持完全冷靜和禮貌。我如何對待他人反映了「我的」標準。"
          }
        }
      }
    },
    "assessment.lifestyle.q8" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Freunde fangen an, über jemanden herzuziehen, der nicht im Raum ist. Wie verhältst du dich?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

    "prog_strength_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus auf%@ Effort pro Sprint. Langsame Erholung beim Zurückgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on%@ effort per sprint. Slow recovery while walking back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concéntrese en %@ esfuerzo por sprint. Lenta recuperación al caminar de regreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez-vous sur %@ Effort par Sprint. Récupération lente au retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्प्रिंट पर %@ प्रयास पर ध्यान दें। वापस चलते समय धीमी रिकवरी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrati sull'impegno %@ per Sprint. Recupero lento quando si cammina indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スプリントあたりの %@ 作業量に注目します。歩いて戻るときの回復が遅い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 스프린트당 %@의 노력에 집중하세요. 돌아갈 때 천천히 회복하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus op %@ inspanning per sprint. Langzaam herstel tijdens het terugwandelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoncentruj się na %@ wysiłku na sprint. Powolna regeneracja podczas chodzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco em %@ de esforço por sprint. Recuperação lenta ao caminhar de volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco em %@ de esforço por sprint. Recuperação lenta ao caminhar de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус на %@ усилий за спринт. Медленное восстановление при возвращении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprint başına %@ Çabaya odaklanın. Geri yürürken yavaş iyileşme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次冲刺专注于 %@ 的努力。往回走时缓慢恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次衝刺專注於 %@ 的努力。往回走時緩慢恢復。"
          }
        }
      }
    },

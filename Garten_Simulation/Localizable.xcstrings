    "focus.session.goal_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was genau möchtest du in deiner Fokus-Zeit schaffen? Nimm dir einen Moment, um dich zu fokussieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What exactly do you want to accomplish in your focus time? Take a moment to focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué quieres lograr exactamente en tu tiempo de enfoque? Tómate un momento para enfocarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que voulez-vous accomplir exactement pendant votre temps de concentration ? Prenez un moment pour vous concentrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपने फोकस समय में वास्तव में क्या हासिल करना चाहते हैं? ध्यान केंद्रित करने के लिए कुछ समय निकालें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vuoi realizzare esattamente nel tuo tempo di focus? Prenditi un momento per concentrarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカス時間で正確に何を達成したいですか？ 集中するための時間を取ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 시간 동안 정확히 무엇을 성취하고 싶으신가요? 잠시 집중할 시간을 가지세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat wil je precies bereiken in je focustijd? Neem even de tijd om je te concentreren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co dokładnie chcesz osiągnąć w swoim czasie skupienia? Poświęć chwilę na koncentrację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que exatamente você quer realizar no seu tempo de foco? Reserve um momento para se concentrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что именно ты хочешь успеть сделать в своё время для концентрации? Найди момент, чтобы сосредоточиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaklanma zamanınızda tam olarak ne başarmak istiyorsunuz? Odaklanmak için bir an ayırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在专注时间内，你具体想完成什么？花点时间集中注意力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您到底想在專注時間內完成什麼？花點時間集中註意力。"
          }
        }
      }
    },

          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voed je lichaam met gezonde, zelfgemaakte maaltijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odżywiaj swoje ciało zdrowymi, domowymi posiłkami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutra seu corpo com refeições saudáveis e caseiras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutra seu corpo com refeições saudáveis e caseiras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Питай своё тело здоровой, приготовленной самостоятельно пищей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuzu sağlıklı, ev yapımı yemeklerle besleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用健康的自制餐食滋养你的身体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用健康的家常飯菜滋養您的身體。"
          }
        }
      }
    },

    "prog_selfcare_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff dich mit einer Person, die dir Energie gibt (Energiespender) und halte Abstand von Menschen, die nur meckern (Energiesauger)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang out with a person who gives you energy (energy givers) and stay away from people who just complain (energy suckers)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal con una persona que te dé energía (dadores de energía) y mantente alejado de las personas que simplemente se quejan (chupadores de energía)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez du temps avec une personne qui vous donne de l'énergie (donneurs d'énergie) et éloignez-vous des personnes qui se plaignent simplement (ventouses d'énergie)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे व्यक्ति के साथ घूमें जो आपको ऊर्जा देता है (ऊर्जा देने वाला) और उन लोगों से दूर रहें जो सिर्फ शिकायत करते हैं (ऊर्जा चूसने वाले)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci con una persona che ti dà energia (donatori di energia) e stai lontano dalle persone che si lamentano e basta (succhiatori di energia)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたにエネルギーを与えてくれる人（エネルギーを与える人）と付き合い、ただ不平を言うだけの人（エネルギーを吸い取る人）からは距離を置きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신에게 에너지를 주는 사람(에너지 주는 사람)과 어울리고 불평만 하는 사람(에너지를 빨아들이는 사람)과는 멀리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga om met iemand die je energie geeft (energiegevers) en blijf uit de buurt van mensen die alleen maar klagen (energiezuigers)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotykaj się z osobą, która dodaje Ci energii (dostawcy energii) i trzymaj się z daleka od ludzi, którzy tylko narzekają (wysysacze energii)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia com uma pessoa que lhe dá energia (doadores de energia) e fique longe de pessoas que apenas reclamam (sugadores de energia)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia com uma pessoa que lhe dá energia (doadores de energia) e fique longe de pessoas que apenas reclamam (sugadores de energia)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общайтесь с человеком, который дает вам энергию (дателями энергии), и держитесь подальше от людей, которые просто жалуются (пожиратели энергии)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size enerji veren (enerji veren) biriyle takılın ve sadece şikayet eden (enerji emici) insanlardan uzak durun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和一个能给你能量的人（能量给予者）一起出去玩，远离那些只会抱怨的人（能量吸盘者）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和一個能給你能量的人（能量給予者）一起出去玩，遠離那些只會抱怨的人（能量吸盤者）。"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uba85\uc774 0\uc774 \ub418\uba74 \ubaa8\ub4e0 \uc2dd\ubb3c\uc774 \uc0ad\uc81c\ub429\ub2c8\ub2e4."

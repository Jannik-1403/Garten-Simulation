    "onboarding_willkommen_untertitel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue Gewohnheiten auf, die wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build habits that grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea hábitos que crezcan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des habitudes qui grandissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Build habits that grow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成長する習慣を築きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성장하는 습관을 길러보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontwikkel gewoonten die groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj nawyki, które rosną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria hábitos que cresçam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyüyen alışkanlıklar oluşturun."
          }
        }
      }
    },
    "onboarding_xp_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jedem Gießen sammelst du XP. Deine Pflanzen wachsen von Bronze bis Diamant!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With every watering, you collect XP. Your plants grow from Bronze to Diamond!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cada riego, coleccionas XP. ¡Tus plantas crecen de bronce a diamante!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque arrosage, tu collectes de l'XP. Tes plantes poussent de Bronze à Diamant !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "With every watering, you collect XP. Your plants grow from Bronze to Diamond!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水やりをするたびにXPが集まります。あなたの植物はブロンズからダイヤモンドまで成長します!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물을 줄 때마다 XP를 수집합니다. 당신의 식물은 브론즈에서 다이아몬드로 성장합니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met elke bewatering verzamel je XP. Jouw planten groeien van Brons naar Diamant!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z każdym podlaniem zbierasz XP. Twoje rośliny rosną od brązu do diamentu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com cada rega, recolhes XP. As tuas plantas crescem de Bronze a Diamante!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sulamada XP toplarsınız. Bitkileriniz Bronz'dan Elmas'a kadar büyüyor!"
          }
        }
      }
    },
    "onboarding_zeit_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {

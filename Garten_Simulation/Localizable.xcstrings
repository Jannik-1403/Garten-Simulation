        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce em segredo, conecta tudo – Networking"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanarak büyür, her şeyi birbirine bağlar – Ağ Oluşturma"
          }
        }
      }
    },

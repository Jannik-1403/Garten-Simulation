    "assessment.mental.q15" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist für dich das Schlimmste, das dir am Ende deines Lebens passieren könnte?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do you think is the worst thing that could happen to you at the end of your life?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué crees que es lo peor que te podría pasar al final de tu vida?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon vous, quelle est la pire chose qui puisse vous arriver à la fin de votre vie ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अनुसार आपके जीवन के अंत में आपके साथ सबसे बुरी चीज़ क्या हो सकती है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale pensi sia la cosa peggiore che potrebbe accaderti alla fine della tua vita?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生の終わりにあなたに起こる可能性のある最悪のことは何だと思いますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인생의 마지막에 당신에게 일어날 수 있는 최악의 일은 무엇이라고 생각합니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat is volgens u het ergste dat u aan het einde van uw leven kan overkomen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak myślisz, co najgorszego może Cię spotkać pod koniec życia?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual você acha que é a pior coisa que poderia acontecer com você no final da sua vida?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что для тебя худшее, что могло бы с тобой случиться в конце твоей жизни?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizce hayatınızın sonunda başınıza gelebilecek en kötü şey nedir?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对你来说，在你生命的尽头可能发生的最糟糕的事情是什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您認為在您生命的最後階段可能發生的最糟糕的事情是什麼？"
          }
        }
      }
    },
    "assessment.mental.q15.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand erinnert sich an mich oder meine Leistungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody remembers me or my achievements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie se acuerda de mí ni de mis logros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne se souvient de moi ni de mes réalisations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी मुझे या मेरी उपलब्धियों को याद नहीं रखता."

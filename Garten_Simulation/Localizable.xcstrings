        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reines Wasser spült oft Mineralien aus. Gib heute eine Prise gutes Salz (Meer- oder Ursalz) in eine deiner Flaschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pure water often flushes out minerals. Add a pinch of good salt (sea or ancient salt) to one of your bottles today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agua pura a menudo elimina los minerales. Añade hoy una pizca de buena sal (marina o antigua) a una de tus botellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eau pure élimine souvent les minéraux. Ajoutez dès aujourd’hui une pincée de bon sel (sel de mer ou sel ancien) dans l’une de vos bouteilles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुद्ध पानी अक्सर खनिजों को बाहर निकाल देता है। आज ही अपनी किसी बोतल में एक चुटकी अच्छा नमक (समुद्री या प्राचीन नमक) डालें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acqua pura spesso elimina i minerali. Aggiungi oggi stesso un pizzico di sale buono (marino o sale antico) ad una delle tue bottiglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純粋な水はミネラルを洗い流してしまうことがよくあります。今すぐ、ボトルの 1 つに良質な塩 (海塩または古代の塩) をひとつまみ加えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순수한 물은 종종 미네랄을 씻어냅니다. 오늘 병 중 하나에 좋은 소금(바다 소금 또는 고대 소금)을 조금 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuiver water spoelt vaak mineralen weg. Voeg vandaag nog een snufje goed zout (zee- of oud zout) toe aan een van je flessen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysta woda często wypłukuje minerały. Już dziś dodaj szczyptę dobrej soli (morskiej lub starożytnej) do jednej ze swoich butelek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A água pura geralmente elimina minerais. Adicione uma pitada de sal bom (sal marinho ou antigo) a uma de suas garrafas hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A água pura geralmente elimina minerais. Adicione uma pitada de sal bom (sal marinho ou antigo) a uma de suas garrafas hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистая вода часто вымывает минералы. Добавьте сегодня щепотку хорошей соли (морской или древней) в одну из бутылочек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saf su genellikle mineralleri temizler. Bugün şişelerinizden birine bir tutam iyi tuz (deniz veya antik tuz) ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯净水经常会冲走矿物质。今天在您的一个瓶子中添加一小撮优质盐（海盐或古盐）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "純淨水常會沖走礦物質。今天在您的一個瓶子中添加一小撮優質鹽（海鹽或古鹽）。"
          }
        }
      }
    },

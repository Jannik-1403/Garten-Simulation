    "body.tracking.status.bulking.perfect.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbau läuft sauber. Makros beibehalten. Training progressiv im Gym steigern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulking is clean. Maintain macros. Progressively increase gym training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen limpio. Mantén los macros. Aumenta progresivamente el entrenamiento en el gimnasio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chantier se déroule sans problème. Maintenir les macros. Augmentez progressivement l’entraînement en salle de sport."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्माण सुचारू रूप से चलता है. मैक्रोज़ बनाए रखें. जिम में उत्तरोत्तर प्रशिक्षण बढ़ाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La costruzione procede senza intoppi. Mantenere le macro. Aumentare progressivamente l'allenamento in palestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "工事は順調に進みます。マクロを保守します。ジムでのトレーニングを徐々に増やしていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공사는 원활하게 진행됩니다. 매크로를 유지합니다. 체육관에서의 훈련을 점진적으로 늘리십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bouw verloopt vlot. Macro's onderhouden. Verhoog geleidelijk de training in de sportschool."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budowa przebiega sprawnie. Utrzymuj makra. Stopniowo zwiększaj intensywność treningów na siłowni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A construção decorre sem problemas. Manter macros. Aumente progressivamente o treino no ginásio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A construção decorre sem problemas. Manter macros. Aumente progressivamente o treino no ginásio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строительство идет гладко. Поддерживать макросы. Постепенно увеличивайте тренировки в тренажерном зале."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnşaat sorunsuz bir şekilde devam ediyor. Makroları koruyun. Spor salonundaki antrenmanı kademeli olarak artırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "施工进展顺利。维护宏。逐步增加健身房的训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "施工進展順利。維護宏。逐步增加健身房的訓練。"
          }
        }
      }
    },

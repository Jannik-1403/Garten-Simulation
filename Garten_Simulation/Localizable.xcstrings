    "gameover.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Pflanzen sind vertrocknet. Deine Coins und Items bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All plants have dried out. Your coins and items are safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las plantas se han secado. Tus monedas y objetos est\u00e1n a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les plantes ont s\u00e9ch\u00e9. Tes pi\u00e8ces et objets sont conserv\u00e9s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093e\u0930\u0947 \u092a\u094c\u0927\u0947 \u0938\u0942\u0916 \u0917\u092f\u0947 \u0939\u0948\u0902. \u0906\u092a\u0915\u0947 \u0938\u093f\u0915\u094d\u0915\u0947 \u0914\u0930 \u0935\u0938\u094d\u0924\u0941\u090f\u0902 \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0940 \u091c\u093e\u090f\u0902\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le piante si sono seccate. Le tue monete e i tuoi oggetti sono al sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u690d\u7269\u304c\u67af\u308c\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u3002\u30b3\u30a4\u30f3\u3084\u30a2\u30a4\u30c6\u30e0\u306f\u5b89\u5168\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uc2dd\ubb3c\uc774 \ub9d0\ub790\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ucf54\uc778\uacfc \uc544\uc774\ud15c\uc740 \uc548\uc804\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle planten zijn uitgedroogd. Uw munten en items zijn veilig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie ro\u015bliny usch\u0142y. Twoje monety i przedmioty s\u0105 bezpieczne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as plantas secaram. As tuas moedas e itens est\u00e3o seguros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0432\u044b\u0441\u043e\u0445\u043b\u0438. \u0422\u0432\u043e\u0438 \u043c\u043e\u043d\u0435\u0442\u044b \u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fct\u00fcn bitkiler kurudu. Madeni paralar\u0131n\u0131z ve e\u015fyalar\u0131n\u0131z g\u00fcvende."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u690d\u7269\u90fd\u67af\u840e\u4e86\u3002\u60a8\u7684\u91d1\u5e01\u548c\u7269\u54c1\u5c06\u4fdd\u7559\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u690d\u7269\u90fd\u4e7e\u67af\u4e86\u3002\u60a8\u7684\u786c\u5e63\u548c\u7269\u54c1\u5c07\u88ab\u4fdd\u7559\u3002"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0442\u0440\u044f\u0441\u0430\u044e\u0449\u0438\u0439! \u0412\u044b \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u043b\u0438 \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u043d\u0430%@\u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0439 \u043d\u0435\u0434\u0435\u043b\u0435\u0439. \u0412\u0430\u0448 \u0441\u0430\u043c\u044b\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0434\u0435\u043d\u044c \u0431\u044b\u043b%@. \u0422\u0430\u043a \u0434\u0435\u0440\u0436\u0430\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ola\u011fan\u00fcst\u00fc! Odaklanma s\u00fcrenizi ge\u00e7en haftaya g\u00f6re %@ art\u0131rd\u0131n\u0131z. En verimli g\u00fcn\u00fcn\u00fcz %@ oldu. B\u00f6yle devam edin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e86\u4e0d\u8d77\uff01\u4e0e\u4e0a\u5468\u76f8\u6bd4\uff0c\u60a8\u7684\u4e13\u6ce8\u65f6\u95f4\u589e\u52a0\u4e86%@\u3002\u60a8\u6548\u7387\u6700\u9ad8\u7684\u4e00\u5929\u662f%@\u3002\u7ee7\u7eed\u52aa\u529b\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e86\u4e0d\u8d77\uff01\u8207\u4e0a\u9031\u76f8\u6bd4\uff0c\u60a8\u7684\u5c08\u6ce8\u6642\u9593\u589e\u52a0\u4e86%@\u3002\u60a8\u6548\u7387\u6700\u9ad8\u7684\u4e00\u5929\u662f%@\u3002\u7e7c\u7e8c\u52aa\u529b\uff01"
          }
        }
      }
    },

    "trash.fast_food_abo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstecke Fast-Food-Apps auf dem letzten Bildschirm oder lösche sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide fast food apps on the last screen or delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las apps de comida rápida en la última pantalla o elimínalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache les applications de fast food sur le dernier écran ou supprime-les."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फास्ट-फूड ऐप्स को आखिरी स्क्रीन पर छुपाएं या उन्हें हटा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le app di fast food nell'ultima schermata o eliminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファストフードのアプリを最後の画面に隠すか削除しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스트푸드 앱을 마지막 화면에 숨기거나 삭제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg fastfood-apps op het laatste scherm of verwijder ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj aplikacje fast food na ostatnim ekranie lub usuń je."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esconda os apps de fast food na última tela ou exclua-os."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esconda os apps de fast food na última tela ou exclua-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скройте или удалите приложения быстрого питания с последнего экрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food uygulamalarını son ekrana gizle veya sil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从最后一个屏幕隐藏或删除快餐应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從最後一個畫面隱藏或刪除快餐應用程式。"
          }
        }
      }
    },
    "trash.fast_food_abo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnere dich: Fast Food macht träge und kostet langfristig Energie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember: fast food makes you sluggish and costs energy in the long run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda: la comida rápida te hace torpe y a largo plazo te cuesta energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappelle-toi: la restauration rapide te rend paresseux et te coûte de l'énergie à long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "याद रखें: फास्ट फूड सुस्ती लाता है और लंबे समय में ऊर्जा की लागत होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda: il fast food ti rende pigro e nel lungo periodo ti costa energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファストフードは疲れやすくなり、長期的にエネルギーを消耗することを覚えておきましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억하세요: 패스트푸드는 무기력하게 만들고 장기적으로 에너지를 소모합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedenk: fastfood maakt je traag en kost je op lange termijn energie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj: fast food sprawia, że jesteś ospały i długoterminowo kosztuje cię energię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembre-se: fast food te deixa preguiçoso e custa energia a longo prazo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembre-se: fast food te deixa preguiçoso e custa energia a longo prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помните: фаст-фуд делает вас вялыми и требует энергии в долгосрочной перспективе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unutma: fast food seni yavaşlatır ve uzun vadede enerji tüketir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请记住：从长远来看，快餐会让你变得迟钝并且消耗能量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請記住：從長遠來看，快餐會讓你變得遲鈍並且消耗能量。"
          }
        }
      }
    },
    "trash.fast_food_abo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche ein gesundes Gericht vor und stelle es in den Kühlschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook a healthy meal in advance and put it in the fridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina una comida saludable con antelación y ponla en el frigorífico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare un plat sain à l'avance et mets-le au réfrigérateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्वस्थ व्यंजन पहले से पकाएँ और उसे फ्रिज में रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina un piatto sano in anticipo e mettilo in frigo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康的な料理を事前に作って冷蔵庫に入れておきましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강한 식사를 미리 요리해서 냉장고에 넣어두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook een gezond gerecht van tevoren en zet het in de koelkast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugotuj zdrowe danie z wyprzedzeniem i włóż je do lodówki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe uma refeição saudável com antecedência e coloque na geladeira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe uma refeição saudável com antecedência e coloque na geladeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительно приготовьте здоровую еду и положите ее в холодильник."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceden sağlıklı bir yemek pişir ve buzdolabına koy."
          }
        },
        "zh-Hans": {

    "assessment.fitness.profile.wohlfuehler.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trainierst, aber ohne echten Reiz. Lerne, deine Grenzen zu pushen und progressiven Overload in dein Training einzubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[EN] Du trainierst, aber ohne echten Reiz. Lerne, deine Grenzen zu pushen und progressiven Overload in dein Training einzubauen."

    "pfad_schwierigkeit_titel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie fit bist du schon?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How fit are you already?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tan en forma estás ya?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point es-tu déjà en forme ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto sei già in forma?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはすでにどれくらい健康ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 이미 얼마나 건강합니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe fit ben jij al?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak sprawny już jesteś?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quão em forma já estás?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten ne kadar formdasın?"
          }
        }
      }
    },
    "pfad_schwierigkeit_untertitel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir passen deinen Pfad an dein Level an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We adapt your path to your level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptamos tu camino a tu nivel."
          }
        },

    "item.zeitkapsel.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und stoppt den Verfall aller Pflanzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and stops decay for all plants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa inmediatamente y detiene la descomposición de todas las plantas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active immédiatement et stoppe la dégradation de toutes les plantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत सक्रिय हो जाता है और सभी पौधों का क्षय रोक देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventa attivo immediatamente e blocca la decomposizione di tutte le piante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに活性化し、すべての植物の腐敗を止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 활성화되어 모든 식물의 부패를 멈춥니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en stopt het verval van alle planten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje się aktywny natychmiast i zatrzymuje rozkład wszystkich roślin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e para a degradação de todas as plantas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e para a degradação de todas as plantas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

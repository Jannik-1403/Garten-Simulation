      }
    },
    "trash.online_shopping_app.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterfrage: Brauchst du das wirklich – oder willst du nur den Dopamin-Kick?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Question it: do you really need this – or do you just want the dopamine kick?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuestiónatelo: ¿realmente lo necesitas o solo quieres el chute de dopamina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remets en question: as-tu vraiment besoin de ça – ou tu veux juste le coup de dopamine ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुछो: क्या तुम्हें यह सच में चाहिए – या तुम सिर्फ डोपामिन का उत्साह महसूस करना चाहते हो?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in discussione: ne hai davvero bisogno – o vuoi solo la scarica di dopamina?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自問しましょう。本当に必要なのか、それともドーパミンの刺激が欲しいだけなのか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자문해 보세요: 정말 필요한 건가요 – 아니면 도파민 자극이 필요한 건가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag jezelf af: heb je dit echt nodig – of wil je gewoon de dopaminestoot?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwestionuj to: czy naprawdę tego potrzebujesz – czy chcesz tylko zastrzyku dopaminy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Questione: você realmente precisa disso – ou só quer o pico de dopamina?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Questione: você realmente precisa disso – ou só quer o pico de dopamina?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопрос: Вам действительно это нужно – или вы просто хотите получить дофамин?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgula: buna gerçekten ihtiyacın var mı – yoksa sadece dopamin atışını mı istiyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题：你真的需要这个吗？还是你只是想要多巴胺？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問題：你真的需要這個嗎？還是你只是想要多巴胺？"
          }
        }
      }
    },
    "trash.online_shopping_app.tip.3": {

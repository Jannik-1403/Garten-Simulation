    "plant.weizenfeld.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite hochkonzentriert und ohne Ablenkungen an deinen Zielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work highly concentrated and without distractions on your goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja altamente concentrado y sin distracciones en tus metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez de mani\u00e8re tr\u00e8s concentr\u00e9e et sans distractions sur vos objectifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u094d\u092f\u094b\u0902 \u092a\u0930 \u092a\u0942\u0930\u0940 \u090f\u0915\u093e\u0917\u094d\u0930\u0924\u093e \u0914\u0930 \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u091a\u0932\u0928 \u0915\u0947 \u0915\u093e\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora molto concentrato e senza distrazioni sui tuoi obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6a19\u306b\u5411\u304b\u3063\u3066\u3001\u6c17\u3092\u6563\u3089\u3055\u305a\u306b\u96c6\u4e2d\u3057\u3066\u53d6\u308a\u7d44\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\uc758\uac00 \uc0b0\ub9cc\ud574\uc9c0\uc9c0 \uc54a\uace0 \uace0\ub3c4\ub85c \uc9d1\uc911\ud558\uc5ec \ubaa9\ud45c\ub97c \ud5a5\ud574 \uc77c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk zeer geconcentreerd en zonder afleidingen aan je doelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuj w du\u017cym skupieniu i bez rozpraszaczy nad swoimi celami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhe altamente concentrado e sem distra\u00e7\u00f5es em seus objetivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0431\u043e\u0442\u0430\u0439 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0435\u0439 \u0438 \u0431\u0435\u0437 \u043e\u0442\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439 \u043d\u0430\u0434 \u0441\u0432\u043e\u0438\u043c\u0438 \u0446\u0435\u043b\u044f\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerinize odaklan\u0131n ve dikkatiniz da\u011f\u0131lmadan \u00e7al\u0131\u015f\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u5ea6\u4e13\u6ce8\uff0c\u4e0d\u53d7\u5e72\u6270\u5730\u4e3a\u4f60\u7684\u76ee\u6807\u52aa\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u5ea6\u96c6\u4e2d\u7cbe\u529b\u3001\u5fc3\u7121\u65c1\u9a16\u5730\u5be6\u73fe\u60a8\u7684\u76ee\u6a19\u3002"
          }
        }
      }
    },

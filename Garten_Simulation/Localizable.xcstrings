        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 일어나 에너지 넘치는 새로운 하루를 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin vroeg en vol energie aan de nieuwe dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij wcześnie i pełen energii nowy dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece cedo e cheio de energia no novo dia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni güne erken ve enerji dolu başlayın."
          }
        }
      }
    },
    "plant.teestrauch.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfter, nachhaltiger Wachstum – Weniger Kaffee"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle, sustainable growth – Less coffee"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crecimiento suave y sostenible – Menos café"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croissance douce et durable – Moins de café"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle, sustainable growth – Less coffee"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかで持続可能な成長 – コーヒーの量を減らす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온화하고 지속 가능한 성장 – 커피 감소"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachte, duurzame groei – Minder koffie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatny, zrównoważony wzrost – Mniej kawy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crescimento suave e sustentável – Menos café"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik, sürdürülebilir büyüme – Daha az kahve"
          }
        }
      }
    },

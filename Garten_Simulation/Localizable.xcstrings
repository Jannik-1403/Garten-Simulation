    "assessment.growth.profile.aufgeber.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schwachpunkt ist die Disziplin. Ohne Motivation brichst du schnell ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weak point is discipline. Without motivation you quickly collapse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu punto débil es la disciplina. Sin motivación colapsas rápidamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre point faible est la discipline. Sans motivation, vous vous effondrez rapidement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo punto debole è la disciplina. Senza motivazione crolli rapidamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの弱点は規律です。モチベーションがないとすぐに倒れてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 약점은 규율입니다. 동기가 없으면 금방 무너집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zwakke punt is discipline. Zonder motivatie stort je snel in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoim słabym punktem jest dyscyplina. Bez motywacji szybko upadniesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ponto fraco é a disciplina. Sem motivação você entra em colapso rapidamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zayıf noktanız disiplindir. Motivasyon olmadan hızla çökersiniz."
          }
        }
      }
    },

    "item.wunder_wasser.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine vertrocknete Pflanze, um sie zu retten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap on a dried plant to rescue it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine vertrocknete Pflanze, um sie zu retten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur une plante dess\u00e9ch\u00e9e pour la sauver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u0938\u0942\u0916\u0947 \u092a\u094c\u0927\u0947 \u0915\u094b \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0938\u0947 \u0925\u092a\u0925\u092a\u093e\u090f\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap on a dried plant to rescue it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e7e\u3044\u305f\u690d\u7269\u3092\u30bf\u30c3\u30d7\u3057\u3066\u6551\u51fa\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9d0\ub9b0 \uc2dd\ubb3c\uc744 \ud0ed\ud558\uc5ec \uad6c\ucd9c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een gedroogde plant om hem te redden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij suszon\u0105 ro\u015blin\u0119, aby j\u0105 uratowa\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca numa planta ressecada para a salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u0437\u0430\u0441\u043e\u0445\u0448\u0435\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0441\u043f\u0430\u0441\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarmak i\u00e7in kurutulmu\u015f bir bitkiye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u4e00\u682a\u67af\u840e\u7684\u690d\u7269\u6765\u62ef\u6551\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u64ca\u4e7e\u71e5\u7684\u690d\u7269\u4f86\u4fdd\u5b58\u5b83\u3002"
          }
        }
      }
    },
    "item.xp_boost.description": {
      "comment": "",

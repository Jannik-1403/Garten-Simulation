        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno si ricorda di me o dei miei successi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰も私や私の業績を覚えていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무도 나나 나의 업적을 기억하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand herinnert zich mij of mijn prestaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nie pamięta mnie i moich osiągnięć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém se lembra de mim ou de minhas conquistas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никто не помнит меня или мои заслуги."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimse beni ya da başarılarımı hatırlamıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有人记得我或我的成就。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有人記得我或我的成就。"
          }
        }
      }
    },
    "assessment.mental.q15.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe mich zu Tode gearbeitet und das Leben nie genossen."

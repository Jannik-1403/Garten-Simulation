        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@तुम्हारा इंतजार कर रहा है। उसे आज ही थोड़ा पानी दो!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ti sta aspettando. Dagle un po' d'acqua oggi!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ があなたを待っています。今日は水をあげましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님이 당신을 기다리고 있습니다. 오늘은 물을 좀 주세요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wacht op je. Geef hem vandaag nog wat water!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ czeka na Ciebie. Daj mu dziś trochę wody!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está à tua espera. Dá-lhe um pouco de água hoje!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ждёт тебя. Дай ей сегодня немного воды!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sizi bekliyor. Bugün ona biraz su ver!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@正在等你。今天给她多喝点水吧！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@正在等你。今天給她多喝點水吧！"

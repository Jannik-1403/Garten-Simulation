    "assessment.lifestyle.q12.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Ich werde...' oder 'Ich mache...'"
          }
        },
        "en": {

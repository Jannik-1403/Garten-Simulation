    "assessment.mental.q13" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist in einer hitzigen Diskussion. Fünf Leute vertreten lautstark Meinung A. Du weißt zu 100％, dass Meinung B richtig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are in a heated discussion. Five people loudly support opinion A. You know 100％ that opinion B is correct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás en una acalorada discusión. Cinco personas apoyan en voz alta la opinión A. Usted sabe al 100％ que la opinión B es correcta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes dans une discussion animée. Cinq personnes soutiennent haut et fort l’opinion A. Vous savez à 100 ％ que l’opinion B est correcte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप गरमागरम चर्चा में हैं. पांच लोग जोर-शोर से राय ए का समर्थन करते हैं। आप 100％ जानते हैं कि राय बी सही है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in una discussione accesa. Cinque persone sostengono fortemente l'opinione A. Sai al 100％ che l'opinione B è corretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは白熱した議論をしています。 5 人が意見 A を声高に支持します。あなたは意見 B が正しいことを 100％ 知っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 열띤 토론을 벌이고 있습니다. 5명이 A의견을 큰 소리로 지지합니다. 당신은 B의견이 옳다는 것을 100％ 알고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent verwikkeld in een verhitte discussie. Vijf mensen steunen luidkeels mening A. Je weet 100％ dat mening B juist is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś w gorącej dyskusji. Pięć osób głośno popiera opinię A. Wiesz na 100％, że opinia B jest słuszna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está em uma discussão acalorada. Cinco pessoas apoiam veementemente a opinião A. Você sabe 100％ que a opinião B está correta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты участвуешь в горячей дискуссии. Пять человек громко отстаивают мнение A. Ты на 100％ уверен, что мнение B правильно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hararetli bir tartışmanın içindesiniz. Beş kişi yüksek sesle A fikrini destekliyor. B görüşünün doğru olduğunu ％100 biliyorsunuz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你正处于一场激烈的讨论中。五个人大声表达意见A。你百分之百确定意见B是正确的。"
          }
        },
        "zh-Hant" : {

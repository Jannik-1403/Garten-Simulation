    "shop.seeds.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle dir eigene Gewohnheiten. Für 10 Samen kannst du dir eigene Gewohnheiten erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your own habits. For 10 seeds you can create your own custom habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tus propios hábitos. Por 10 semillas puedes crear tus propios hábitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez vos propres habitudes. Pour 10 graines vous pouvez créer vos propres habitudes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी खुद की आदतें बनाएं. 10 बीजों के लिए आप अपनी आदतें बना सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea le tue abitudini. Per 10 semi puoi creare le tue abitudini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身の習慣を作りましょう。 10個のシードであなた自身の習慣を作ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신만의 습관을 만들어 보세요. 10개의 씨앗으로 나만의 습관을 만들 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Creëer je eigen gewoontes. Voor 10 zaden kun je je eigen gewoontes creëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stwórz własne nawyki. Za 10 nasion możesz stworzyć własne nawyki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie seus próprios hábitos. Por 10 sementes você pode criar seus próprios hábitos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie seus próprios hábitos. Por 10 sementes, você pode criar seus próprios hábitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте свои собственные привычки. За 10 семян вы сможете создать свои привычки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi alışkanlıklarınızı yaratın. 10 tohum karşılığında kendi alışkanlıklarınızı yaratabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建你自己的习惯。只需10颗种子，你就可以创建自己的专属习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創建你自己的習慣。只需10顆種子，你就可以創建自己的專屬習慣。"
          }
        }
      }
    },

      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gl\u00fcckwunsch! +%d M\u00fcnzen erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Congratulations! +%d Coins received."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Felicidades! +%d Monedas recibidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e9licitations ! +%d pi\u00e8ces re\u00e7ues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0927\u093e\u0908 \u0939\u094b! +%d\u0938\u093f\u0915\u094d\u0915\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Congratulations! +%d Coins received."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u3081\u3067\u3068\u3046\uff01 +%d \u30b3\u30a4\u30f3\u3092\u53d7\u3051\u53d6\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd95\ud558\ud574\uc694! +%d \ucf54\uc778\uc744 \ubc1b\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefeliciteerd! +%d Munten ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratulacje! +%d Otrzymane monety."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parab\u00e9ns! +%d moedas recebidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0437\u0434\u0440\u0430\u0432\u043b\u044f\u0435\u043c! +%d\u043c\u043e\u043d\u0435\u0442 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tebrikler! +%d Para al\u0131nd\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u606d\u559c\uff01+%d\u83b7\u5f97\u786c\u5e01\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u606d\u559c\uff01 + \u6536\u5230%d\u786c\u5e63\u3002"
          }
        }
      }
    },

    "settings.import.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie Daten importieren? Dies überschreibt Ihre aktuellen Fortschritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to import data? This will overwrite your current progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres importar datos? Esto sobreescribirá tu progreso actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu importer des données ? Cela écrasera ta progression actuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to import data? This will overwrite your current progress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データをインポートしますか?これにより、現在の進行状況が上書きされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 가져오시겠습니까? 현재 진행 상황을 덮어쓰게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u gegevens importeren? Hiermee wordt uw huidige voortgang overschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz zaimportować dane? Spowoduje to zastąpienie Twojego bieżącego postępu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres importar dados? Isto irá substituir o teu progresso atual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileri içe aktarmak istiyor musunuz? Bu, mevcut ilerlemenizin üzerine yazacaktır."
          }
        }
      }
    },

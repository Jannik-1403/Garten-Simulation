    "Erinnerungen und App-Blockierung richtest du ein, wenn du sie brauchst. Ziele sind freiwillig.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen und App-Blockierung richtest du ein, wenn du sie brauchst. Ziele sind freiwillig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up reminders and app blocking when you need them. Goals are optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura recordatorios y bloqueo de apps cuando los necesites. Las metas son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez des rappels et le blocage des apps selon vos besoins. Les objectifs sont facultatifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवश्यकता पड़ने पर अनुस्मारक और ऐप ब्लॉकिंग सेट करें। लक्ष्य वैकल्पिक हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta promemoria e blocco app quando ne hai bisogno. Gli obiettivi sono facoltativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときにリマインダーやアプリのブロックを設定できます。目標の設定は任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 알림 및 앱 차단을 설정하세요. 목표는 선택 사항입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel herinneringen en app-blokkering in wanneer je ze nodig hebt. Doelen zijn optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw przypomnienia i blokowanie aplikacji wtedy, gdy ich potrzebujesz. Cele są opcjonalne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura lembretes e bloqueio de apps quando precisares. As metas são opcionais."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure lembretes e bloqueio de apps quando precisar. As metas são opcionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настраивайте напоминания и блокировку приложений по мере необходимости. Цели не обязательны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcıları ve uygulama engellemeyi ihtiyacınız olduğunda ayarlayın. Hedefler isteğe bağlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需设置提醒和应用阻止。目标为选填项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按需設定提醒與應用程式封鎖。目標為選填項。"
          }
        }
      }
    },
    "Erinnerungen, Health-Anbindung und weitere Einstellungen findest du anschließend in den Details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen, Health-Anbindung und weitere Einstellungen findest du anschließend in den Details."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders, Health integration, and further settings can be found in the details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrarás recordatorios, sincronización con Salud y más ajustes en los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous trouverez ensuite les rappels, l'intégration Santé et d'autres réglages dans les détails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुस्मारक, स्वास्थ्य एकीकरण और अन्य सेटिंग्स बाद में विवरण में मिलेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troverai promemoria, integrazione Salute e altre impostazioni nei dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーやヘルスケア連携、その他の設定は詳細画面で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림, 건강 연동 및 추가 설정은 세부 정보에서 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen, Health-koppeling en verdere instellingen vind je in de details."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia, integrację z aplikacją Zdrowie i inne ustawienia znajdziesz w szczegółach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes, integração com Saúde e outras definições estarão nos detalhes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes, integração com Saúde e outras configurações estarão nos detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания, интеграцию со «Здоровьем» и другие настройки вы найдете в деталях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcıları, Sağlık entegrasyonunu ve diğer ayarları ayrıntılarda bulabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后可在详情中找到提醒、健康数据关联和其他设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後可在詳細資料中找到提醒、健康資料連結和其他設定。"
          }
        }
      }
    },

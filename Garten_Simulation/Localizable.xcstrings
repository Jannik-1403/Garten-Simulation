          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odżywiam się słabo, ale codziennie rano biorę multiwitaminę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mal, mas tomo um multivitamínico todas as manhãs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kötü besleniyorum ama her sabah multivitamin alıyorum."
          }
        }
      }
    },
    "assessment.health.q10.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens die Hälfte meiner Mahlzeiten besteht aus echtem, unverarbeitetem Essen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least half of my meals consist of real, unprocessed food."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos la mitad de mis comidas consisten en alimentos reales y no procesados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins la moitié de mes repas sont constitués de vrais aliments non transformés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno la metà dei miei pasti sono costituiti da cibo vero e non trasformato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の食事の少なくとも半分は、加工されていない本物の食べ物で構成されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 식사의 적어도 절반은 가공되지 않은 실제 음식으로 구성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens de helft van mijn maaltijden bestaat uit echte, onbewerkte voeding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przynajmniej połowa moich posiłków składa się z prawdziwej, nieprzetworzonej żywności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos metade das minhas refeições consiste em comida de verdade e não processada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğünlerimin en az yarısı gerçek, işlenmemiş yiyeceklerden oluşuyor."
          }
        }
      }
    },
    "assessment.health.q10.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich folge jedem neuen Ernährungs-Trend auf TikTok, breche ihn aber nach 2 Wochen wieder ab."
          }
        },
        "en": {
          "stringUnit": {

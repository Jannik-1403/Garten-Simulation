    },
    "pfad_gesund_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheit maximieren. Dein Körper dankt dir jeden Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximize health. Your body thanks you every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximiza la salud. Tu cuerpo te lo agradece cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximise ta santé. Ton corps te remercie chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massimizza la salute. Il tuo corpo ti ringrazia ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康を最大限に高めます。あなたの体は毎日あなたに感謝しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강을 극대화하세요. 당신의 몸은 매일 당신에게 감사합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaliseer de gezondheid. Je lichaam bedankt je elke dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalizuj zdrowie. Twoje ciało dziękuje Ci każdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximiza a saúde. O teu corpo agradece-te todos os dias."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlığı en üst düzeye çıkarın. Vücudunuz size her gün teşekkür ediyor."
          }
        }
      }
    },

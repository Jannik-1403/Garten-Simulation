    "assessment.mental.profile.getriebener.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaktiv und rastlos. Du hast keinen klaren Fokus und lässt dich von jedem neuen Impuls ablenken. Du bewegst dich viel, aber kommst nicht voran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactive and restless. You don't have a clear focus and allow yourself to be distracted by every new impulse. You move a lot, but you don't make any progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactivo e inquieto. No tienes un enfoque claro y te dejas distraer por cada nuevo impulso. Te mueves mucho, pero no progresas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réactif et agité. Vous n’avez pas une orientation claire et vous vous laissez distraire par chaque nouvelle impulsion. Vous bougez beaucoup, mais vous ne progressez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reattivo e irrequieto. Non hai un focus chiaro e ti lasci distrarre da ogni nuovo impulso. Ti muovi molto, ma non fai alcun progresso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応的で落ち着きがない。あなたは明確な焦点を持たず、あらゆる新しい衝動に気を取られてしまいます。かなり移動しているのに、何も進んでいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반응적이고 불안합니다. 당신은 명확한 초점을 갖고 있지 않으며 모든 새로운 충동에 주의가 산만해지게 됩니다. 많이 움직이지만 진전이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactief en rusteloos. Je hebt geen duidelijke focus en laat je afleiden door elke nieuwe impuls. Je beweegt veel, maar je boekt geen vooruitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaktywny i niespokojny. Nie masz jasnego skupienia i pozwalasz, aby każdy nowy impuls rozpraszał Cię. Dużo się ruszasz, ale nie robisz postępów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reativo e inquieto. Você não tem um foco claro e se permite ser distraído por cada novo impulso. Você se move muito, mas não faz nenhum progresso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaktif ve huzursuz. Net bir odağınız yok ve her yeni dürtünün dikkatinizin dağılmasına izin veriyorsunuz. Çok hareket ediyorsunuz ama hiçbir ilerleme kaydedemiyorsunuz."
          }
        }
      }
    },

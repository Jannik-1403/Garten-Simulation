    "prog_gratitude_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für wen bist du heute dankbar? Ein Freund, Kollege oder die Kassiererin, die gelächelt hat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who are you grateful for today? A friend, colleague or the cashier who smiled?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por quién estás agradecido hoy? ¿Un amigo, colega o el cajero que sonrió?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour qui es-tu reconnaissant aujourd’hui ? Un ami, un collègue ou le caissier qui a souri ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आप किसके लिए आभारी हैं? कोई मित्र, सहकर्मी या खजांची जो मुस्कुराया?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A chi sei grato oggi? Un amico, un collega o la cassiera che ha sorriso?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は誰に感謝していますか?笑顔を見せてくれた友人、同僚、それともレジ係?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 누구에게 감사하시나요? 친구, 동료 또는 미소를 지은 계산원?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor wie ben jij vandaag dankbaar? Een vriend, collega of de kassamedewerker die lachte?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komu jesteś dziś wdzięczny? Przyjaciel, kolega lub kasjer, który się uśmiechnął?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quem você é grato hoje? Um amigo, colega ou caixa que sorriu?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quem você é grato hoje? Um amigo, colega ou caixa que sorriu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кому вы благодарны сегодня? Друг, коллега или кассир, который улыбнулся?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kime minnettarsınız? Gülümseyen bir arkadaşınız mı, meslektaşınız mı yoksa kasiyer mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天你要感谢谁？微笑的朋友、同事还是收银员？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天你要感謝誰？微笑的朋友、同事還是收銀員？"
          }
        }
      }
    },
    "prog_gratitude_d2_t1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Personen oder Interaktionen aufgeschrieben"
          }

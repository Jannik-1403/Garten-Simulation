    "prog_wakeup_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platziere das Handy/den Wecker so weit weg vom Bett, dass du physisch aufstehen MUSST, um ihn auszumachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the phone/alarm clock so far away from the bed that you HAVE to physically get up to turn it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque el teléfono/despertador tan lejos de la cama que DEBE levantarse físicamente para apagarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le téléphone/réveil si loin du lit que vous DEVEZ vous lever physiquement pour l'éteindre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन/अलार्म घड़ी को बिस्तर से इतनी दूर रखें कि आपको उसे बंद करने के लिए उठना पड़े।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona il telefono/sveglia così lontano dal letto che DEVI alzarti fisicamente per spegnerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話や目覚まし時計をベッドから遠く離れた場所に置くと、電源を切るには物理的に起き上がらなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화/알람시계를 침대에서 너무 멀리 배치하여 끄려면 직접 일어나야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats de telefoon/wekker zo ver van het bed dat u fysiek MOET opstaan ​​om hem uit te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść telefon/budzik tak daleko od łóżka, że ​​MUSISZ fizycznie wstać, aby go wyłączyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o telefone/despertador tão longe da cama que você PRECISA se levantar fisicamente para desligá-lo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o telefone/despertador tão longe da cama que você PRECISA se levantar fisicamente para desligá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите телефон/будильник так далеко от кровати, что вам придется физически встать, чтобы его выключить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu/çalar saati yataktan o kadar uzağa yerleştirin ki, kapatmak için fiziksel olarak kalkmanız GEREKİR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将电话/闹钟放在离床太远的地方，您必须站起来才能将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將電話/鬧鐘放在離床太遠的地方，您必須站起來才能關閉。"
          }
        }
      }
    },

    "item.duenger_blitz.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdoppelt XP für die nächsten 3 Erledigungen."

    "prog_teeth_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls vorhanden, nutze Interdentalbürstchen für die größeren Lücken hinten. Dort kommt Zahnseide oft nicht richtig hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If available, use interdental brushes for the larger gaps at the back. Dental floss often doesn't get there properly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está disponible, utilice cepillos interdentales para los espacios más grandes en la parte posterior. El hilo dental a menudo no llega correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si disponible, utilisez des brossettes interdentaires pour les espaces plus grands à l'arrière. Souvent, le fil dentaire n’arrive pas correctement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि उपलब्ध हो, तो पीछे के बड़े अंतराल के लिए इंटरडेंटल ब्रश का उपयोग करें। डेंटल फ्लॉस अक्सर वहां तक ​​ठीक से नहीं पहुंच पाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponibile, utilizzare gli spazzolini interdentali per gli spazi più grandi sul retro. Il filo interdentale spesso non arriva correttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "可能であれば、奥の大きな隙間には歯間ブラシを使用します。デンタルフロスがうまく届かないことがよくあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능하다면 뒤쪽의 더 큰 틈을 위해 치간 브러시를 사용하십시오. 치실은 제대로 닿지 않는 경우가 많습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik indien beschikbaar interdentale ragers voor de grotere openingen aan de achterkant. Tandzijde komt vaak niet goed daar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli to możliwe, użyj szczoteczek międzyzębowych do większych szczelin z tyłu. Nić dentystyczna często nie dociera tam prawidłowo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponível, use escovas interdentais para os espaços maiores na parte posterior. O fio dental muitas vezes não chega lá corretamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disponível, use escovas interdentais para os espaços maiores na parte posterior. O fio dental muitas vezes não chega lá corretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если возможно, используйте межзубные щетки для больших промежутков сзади. Зубная нить часто не попадает туда должным образом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka tarafta daha büyük boşluklar için varsa diş arası fırçaları kullanın. Diş ipi genellikle oraya doğru şekilde ulaşmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果有的话，请使用齿间刷来清洁背面较大的缝隙。牙线经常无法正确到达那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果有的話，請使用齒間刷來清潔背面較大的縫隙。牙線經常無法正確到達那裡。"
          }
        }
      }
    },
    "prog_teeth_d6_t1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2 Min morgens & abends geputzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaned for 2 minutes in the morning and evening"
          }

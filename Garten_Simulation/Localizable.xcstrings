    "item.goldener_schluessel.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und \u00f6ffnet die T\u00fcr zu raschem Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and opens the door to rapid growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und \u00f6ffnet die T\u00fcr zu raschem Wachstum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active imm\u00e9diatement et ouvre la porte \u00e0 une croissance rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0924\u094d\u0915\u093e\u0932 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0924\u0947\u091c\u0940 \u0938\u0947 \u0935\u093f\u0915\u093e\u0938 \u0915\u093e \u0926\u094d\u0935\u093e\u0930 \u0916\u094b\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and opens the door to rapid growth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5373\u6226\u529b\u3068\u306a\u308a\u3001\u6025\u6210\u9577\u3078\u306e\u6249\u304c\u958b\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uc5b4 \uae09\uc18d\ud55c \uc131\uc7a5\uc758 \ubb38\uc744 \uc5f4\uc5b4\uc90d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en opent de deur naar snelle groei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje si\u0119 aktywny natychmiast i otwiera drzwi do szybkiego wzrostu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e abre a porta para o crescimento r\u00e1pido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0440\u0430\u0437\u0443 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u044c \u043a \u0431\u044b\u0441\u0442\u0440\u043e\u043c\u0443 \u0440\u043e\u0441\u0442\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve h\u0131zl\u0131 b\u00fcy\u00fcmeye kap\u0131 a\u00e7ar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u5f00\u542f\u5feb\u901f\u6210\u957f\u4e4b\u95e8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u63a1\u53d6\u884c\u52d5\uff0c\u6253\u958b\u5feb\u901f\u589e\u9577\u4e4b\u9580\u3002"
          }
        }
      }
    },
    "item.herz_auffueller.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcllt ein Leben auf. Ideal, um wieder auf maximale Lebenspunkte zu kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores one life. Ideal to get back to maximum health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una vida. Ideal para volver a la salud m\u00e1xima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure une vie. Id\u00e9al pour retrouver la sant\u00e9 maximale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u091c\u0940\u0935\u0928 \u092a\u0941\u0928\u0903 \u092d\u0930 \u0926\u0947\u0924\u093e \u0939\u0948. \u0905\u0927\u093f\u0915\u0924\u092e \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092c\u093f\u0902\u0926\u0941\u0913\u0902 \u092a\u0930 \u0935\u093e\u092a\u0938 \u091c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0926\u0930\u094d\u0936\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina una vita. Ideale per tornare alla salute massima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e9\u30a4\u30d5\u30921\u3064\u56de\u5fa9\u3057\u307e\u3059\u3002\u6700\u5927\u9650\u306e\u5065\u5eb7\u72b6\u614b\u3092\u53d6\u308a\u623b\u3059\u306e\u306b\u6700\u9069\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud55c \uc0dd\uba85\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4. \ucd5c\ub300 \uac74\uac15\uc73c\ub85c \ub3cc\uc544\uac00\ub294 \ub370 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt \u00e9\u00e9n leven. Ideaal om weer maximale gezondheid te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca jedno \u017cycie. Idealny, aby wr\u00f3ci\u0107 do maksymalnego zdrowia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura uma vida. Ideal para voltar \u00e0 sa\u00fade m\u00e1xima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0436\u0438\u0437\u043d\u044c. \u0418\u0434\u0435\u0430\u043b\u044c\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u0432\u043d\u043e\u0432\u044c \u0434\u043e\u0441\u0442\u0438\u0447\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043e\u0447\u043a\u043e\u0432 \u0436\u0438\u0437\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hayat\u0131 geri y\u00fckler. Maksimum sa\u011fl\u0131\u011fa geri d\u00f6nmek i\u00e7in idealdir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8865\u5145\u4e00\u4e2a\u751f\u547d\u3002\u975e\u5e38\u9002\u5408\u6062\u590d\u5230\u6700\u5927\u751f\u547d\u503c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u88dc\u5145\u4e00\u500b\u751f\u547d\u3002\u6062\u5fa9\u6700\u5927\u751f\u547d\u503c\u7684\u7406\u60f3\u9078\u64c7\u3002"
          }
        }
      }
    },

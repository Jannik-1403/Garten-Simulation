    "trash.luxus_uhr.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6sche Luxus-Marken aus deinen Social-Media-Feeds."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove luxury brands from your social media feeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las marcas de lujo de tus feeds de redes sociales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les marques de luxe de tes fils d'actualit\u00e9 des r\u00e9seaux sociaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u092b\u093c\u0940\u0921 \u0938\u0947 \u0932\u0915\u094d\u091c\u093c\u0930\u0940 \u092c\u094d\u0930\u093e\u0902\u0921\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi i marchi di lusso dai tuoi feed di social media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u306e\u30d5\u30a3\u30fc\u30c9\u304b\u3089\u9ad8\u7d1a\u30d6\u30e9\u30f3\u30c9\u3092\u524a\u9664\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc18c\uc15c \ubbf8\ub514\uc5b4 \ud53c\ub4dc\uc5d0\uc11c \uba85\ud488 \ube0c\ub79c\ub4dc\ub97c \uc81c\uac70\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder luxemerken uit je socialemediafeeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usu\u0144 luksusowe marki ze swoich kana\u0142\u00f3w medi\u00f3w spo\u0142eczno\u015bciowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova marcas de luxo dos seus feeds de redes sociais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0438\u0442\u0435 \u043b\u044e\u043a\u0441\u043e\u0432\u044b\u0435 \u0431\u0440\u0435\u043d\u0434\u044b \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u043b\u0435\u043d\u0442 \u0432 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0442\u044f\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosyal medya ak\u0131\u015flar\u0131ndan l\u00fcks markalar\u0131 kald\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u793e\u4ea4\u5a92\u4f53\u6e90\u4e2d\u5220\u9664\u5962\u4f88\u54c1\u724c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u793e\u7fa4\u5a92\u9ad4\u52d5\u614b\u4e2d\u522a\u9664\u5962\u4f88\u54c1\u724c\u3002"
          }
        }
      }
    },
    "trash.luxus_uhr.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxusg\u00fcter machen nach kurzer Zeit nicht mehr gl\u00fccklicher \u2013 das ist wissenschaftlich belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxury goods don't make you happier after a short time \u2013 scientifically proven."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bienes de lujo no hacen m\u00e1s feliz despu\u00e9s de poco tiempo: cient\u00edficamente probado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les biens de luxe ne rendent pas plus heureux apr\u00e8s peu de temps \u2013 c'est prouv\u00e9 scientifiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0915\u094d\u091c\u093c\u0930\u0940 \u0938\u093e\u092e\u093e\u0928 \u0925\u094b\u0921\u093c\u0947 \u0938\u092e\u092f \u0915\u0947 \u092c\u093e\u0926 \u0905\u0927\u093f\u0915 \u0916\u0941\u0936 \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u0924\u0947 \u2013 \u092f\u0939 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0938\u093f\u0926\u094d\u0927 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I beni di lusso non rendono pi\u00f9 felici dopo poco tempo \u2013 scientificamente provato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u7d1a\u54c1\u306f\u77ed\u6642\u9593\u5f8c\u306b\u306f\u5e78\u798f\u611f\u3092\u4e0e\u3048\u306a\u304f\u306a\u308a\u307e\u3059\u3002\u79d1\u5b66\u7684\u306b\u8a3c\u660e\u3055\u308c\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uba85\ud488\uc740 \uc9e7\uc740 \uc2dc\uac04 \ud6c4\uc5d0\ub294 \ub354 \uc774\uc0c1 \ud589\ubcf5\ud558\uac8c \ub9cc\ub4e4\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4 \u2013 \uacfc\ud559\uc801\uc73c\ub85c \uc99d\uba85\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Luxegoederen maken na korte tijd niet meer gelukkiger \u2013 dit is wetenschappelijk aangetoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobra luksusowe po kr\u00f3tkim czasie nie czyni\u0105 szcz\u0119\u015bliwszymi \u2013 naukowo udowodnione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bens de luxo n\u00e3o tornam mais feliz ap\u00f3s pouco tempo \u2013 comprovado cientificamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0440\u043e\u0441\u043a\u043e\u0448\u0438 \u0443\u0436\u0435 \u043d\u0435 \u0434\u0435\u043b\u0430\u044e\u0442 \u0432\u0430\u0441 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u0435\u0435 \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u2013 \u044d\u0442\u043e \u043d\u0430\u0443\u0447\u043d\u043e \u0434\u043e\u043a\u0430\u0437\u0430\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00fcks e\u015fyalar k\u0131sa s\u00fcre sonra art\u0131k mutlu etmiyor \u2013 bilimsel olarak kan\u0131tlanm\u0131\u015f."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5962\u4f88\u54c1\u5728\u77ed\u65f6\u95f4\u5185\u4e0d\u518d\u8ba9\u4f60\u66f4\u5feb\u4e50\u2014\u2014\u8fd9\u662f\u79d1\u5b66\u8bc1\u660e\u7684\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5962\u4f88\u54c1\u5728\u77ed\u6642\u9593\u5167\u4e0d\u518d\u8b93\u4f60\u66f4\u5feb\u6a02\u2014\u2014\u9019\u662f\u79d1\u5b78\u8b49\u660e\u7684\u3002"
          }
        }
      }
    },
    "trash.luxus_uhr.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine 'Wunschliste' \u2013 und \u00fcberpr\u00fcfe sie nach 3 Monaten erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a 'wish list' \u2013 and review it again after 3 months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una 'lista de deseos' y rev\u00edsala de nuevo despu\u00e9s de 3 meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cr\u00e9e une 'liste de souhaits' \u2013 et revois-la apr\u00e8s 3 mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 '\u0907\u091a\u094d\u091b\u093e \u0938\u0942\u091a\u0940' \u092c\u0928\u093e\u090f\u0902 \u2013 \u0914\u0930 \u0907\u0938\u0947 3 \u092e\u0939\u0940\u0928\u0947 \u092c\u093e\u0926 \u092b\u093f\u0930 \u0938\u0947 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una 'lista dei desideri' \u2013 e riesaminala dopo 3 mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u30a6\u30a3\u30c3\u30b7\u30e5\u30ea\u30b9\u30c8\u300d\u3092\u4f5c\u6210\u3057\u3066\u30013\u30f6\u6708\u5f8c\u306b\u518d\u5ea6\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc704\uc2dc\ub9ac\uc2a4\ud2b8'\ub97c \ub9cc\ub4e4\uace0 \u2013 3\uac1c\uc6d4 \ud6c4\uc5d0 \ub2e4\uc2dc \uac80\ud1a0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een 'verlanglijst' \u2013 en controleer deze na 3 maanden opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stw\u00f3rz 'list\u0119 \u017cycze\u0144' \u2013 i sprawd\u017a j\u0105 ponownie po 3 miesi\u0105cach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma 'lista de desejos' \u2013 e revise-a novamente ap\u00f3s 3 meses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u00ab\u0441\u043f\u0438\u0441\u043e\u043a \u0436\u0435\u043b\u0430\u043d\u0438\u0439\u00bb \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0435\u0433\u043e \u0441\u043d\u043e\u0432\u0430 \u0447\u0435\u0440\u0435\u0437 3 \u043c\u0435\u0441\u044f\u0446\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Dilek listesi' olu\u015ftur \u2013 ve 3 ay sonra tekrar g\u00f6zden ge\u00e7ir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u521b\u5efa\u4e00\u4e2a\u201c\u613f\u671b\u6e05\u5355\u201d - \u5e76\u5728 3 \u4e2a\u6708\u540e\u518d\u6b21\u68c0\u67e5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5efa\u7acb\u4e00\u500b\u300c\u9858\u671b\u6e05\u55ae\u300d - \u4e26\u5728 3 \u500b\u6708\u5f8c\u518d\u6b21\u6aa2\u67e5\u3002"
          }
        }
      }
    },
    "trash.luxus_uhr.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft tr\u00e4gst du teure Sachen wirklich? Rechne den Preis pro Nutzung aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often do you actually wear expensive things? Calculate the price per use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfCon qu\u00e9 frecuencia llevas realmente cosas caras? Calcula el precio por uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c0 quelle fr\u00e9quence portes-tu vraiment des choses ch\u00e8res ? Calcule le prix par utilisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u092e\u0939\u0902\u0917\u0947 \u0938\u093e\u092e\u093e\u0928 \u092a\u0939\u0928\u0924\u0947 \u0939\u094b? \u0909\u092a\u092f\u094b\u0917 \u092a\u094d\u0930\u0924\u093f \u0915\u0940\u092e\u0924 \u0928\u093f\u0915\u093e\u0932\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto spesso indossi davvero cose costose? Calcola il prezzo per utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u4fa1\u306a\u3082\u306e\u3092\u5b9f\u969b\u306b\u3069\u308c\u304f\u3089\u3044\u4f7f\u3063\u3066\u3044\u307e\u3059\u304b\uff1f\u4f7f\u7528\u56de\u6570\u3042\u305f\u308a\u306e\u30b3\u30b9\u30c8\u3092\u8a08\u7b97\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube44\uc2fc \uac83\uc744 \uc2e4\uc81c\ub85c \uc5bc\ub9c8\ub098 \uc790\uc8fc \uc0ac\uc6a9\ud558\ub098\uc694? \uc0ac\uc6a9\ub2f9 \uac00\uaca9\uc744 \uacc4\uc0b0\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vaak draag je dure spullen echt? Bereken de prijs per gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak cz\u0119sto naprawd\u0119 nosisz drogie rzeczy? Oblicz cen\u0119 za u\u017cycie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que frequ\u00eancia voc\u00ea usa coisas caras? Calcule o pre\u00e7o por uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0447\u0430\u0441\u0442\u043e \u0432\u044b \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u043e\u0441\u0438\u0442\u0435 \u0434\u043e\u0440\u043e\u0433\u0438\u0435 \u0432\u0435\u0449\u0438? \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahal\u0131 \u015feyleri ger\u00e7ekte ne s\u0131kl\u0131kla kullan\u0131yorsun? Kullan\u0131m ba\u015f\u0131na fiyat\u0131 hesapla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u771f\u6b63\u7a7f\u6602\u8d35\u8863\u670d\u7684\u9891\u7387\u662f\u591a\u5c11\uff1f\u8ba1\u7b97\u6bcf\u6b21\u4f7f\u7528\u7684\u4ef7\u683c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u771f\u6b63\u7a7f\u6602\u8cb4\u8863\u670d\u7684\u983b\u7387\u662f\u591a\u5c11\uff1f\u8a08\u7b97\u6bcf\u6b21\u4f7f\u7528\u7684\u50f9\u683c\u3002"
          }
        }
      }
    },
    "trash.luxus_uhr.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Statussymbole kaufen)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Dankbarkeit \u00fcben)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Statussymbole kaufen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Dankbarkeit \u00fcben)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Statussymbole kaufen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Dankbarkeit \u00fcben)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Statussymbole kaufen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Dankbarkeit \u00fcben)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u0938\u094d\u0925\u093f\u0924\u093f \u092a\u094d\u0930\u0924\u0940\u0915 \u0916\u0930\u0940\u0926\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0938\u0947 \u0905\u0935\u0917\u0924 \u0930\u0939\u0947\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0902 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0915\u0943\u0924\u091c\u094d\u091e\u0924\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0930\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0938\u0930\u0932 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u092a\u0941\u0930\u0938\u094d\u0915\u0943\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Statussymbole kaufen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Dankbarkeit \u00fcben)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Statussymbole kaufen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Dankbarkeit \u00fcben)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },

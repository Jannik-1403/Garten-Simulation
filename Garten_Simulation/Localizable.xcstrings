    "plant.sonnenblume.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht sich immer zur Sonne – Frühaufsteher-Energie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always turns to the sun – Early bird energy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre mira al sol – Energía madrugadora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tourne toujours vers le soleil – Énergie du lève-tôt"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा सूरज की ओर मुड़ता है – सुबह जल्दी उठने वालों की ऊर्जा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rivolge sempre verso il sole: l'energia del mattiniero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に太陽を向く – 早起きのエネルギー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제나 태양을 향한다 - 얼리버드 에너지"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait zich altijd naar de zon – Early bird-energie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze zwraca się ku słońcu – Energia wczesnego ptaka"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre voltado para o sol – Energia de madrugador"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre voltado para o sol – Energia de madrugador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда поворачивается к солнцу – энергия ранних пташек"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman güneşe döner – Erkenci kuş enerjisi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永远面向太阳 – 早起者的能量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠面向太陽－早起的能量"
          }
        }
      }
    },

    "psychology.fact.levelup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gehirn bildet gerade neue neuronale Bahnen! Jeder Fortschritt festigt deine neue Identität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brain is forming new neural pathways! Every step forward solidifies your new identity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tu cerebro está formando nuevas vías neuronales! Cada paso adelante consolida tu nueva identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton cerveau forme de nouvelles connexions neuronales ! Chaque pas en avant consolide ta nouvelle identité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमारा मस्तिष्क अभी नए तंत्रिका मार्ग बना रहा है! हर प्रगति तुम्हारी नई पहचान को मजबूत करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cervello sta formando nuovi percorsi neurali! Ogni passo avanti consolida la tua nuova identità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脳が新しい神経回路を形成しています！一歩前進するごとに、新しいアイデンティティが固まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 뇌가 새로운 신경 경로를 형성하고 있습니다! 앞으로 나아갈 때마다 새로운 정체성이 확고해집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je brein vormt nieuwe neurale paden! Elke stap vooruit verstevigt je nieuwe identiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój mózg tworzy nowe ścieżki neuronowe! Każdy krok naprzód umacnia twoją nową tożsamość."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu cérebro está formando novas vias neurais! Cada passo adiante solidifica sua nova identidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu cérebro está formando novas vias neurais! Cada passo adiante solidifica sua nova identidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой мозг сейчас формирует новые нейронные пути! Каждый успех укрепляет твою новую личность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beynin yeni sinir yolları oluşturuyor! İleriye doğru atılan her adım yeni kimliğini sağlamlaştırıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的大脑正在形成新的神经通路！每一次进步都巩固了你的新身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的大腦目前正在形成新的神經通路！每一個進步都會鞏固你的新身分。"
          }
        }
      }
    },

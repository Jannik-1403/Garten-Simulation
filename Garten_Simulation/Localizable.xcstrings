    "math_challenge.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6se die folgende Matheaufgabe, um deine Fokus-Session abzubrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve the following math problem to cancel your focus session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve el siguiente problema de matem\u00e1ticas para cancelar tu sesi\u00f3n de enfoque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9solvez le probl\u00e8me math\u00e9matique suivant pour annuler votre session de concentration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u092b\u094b\u0915\u0938 \u0938\u0924\u094d\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0917\u0923\u093f\u0924 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b \u0939\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi il seguente problema di matematica per annullare la tua sessione di concentrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a9\u30fc\u30ab\u30b9\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u6570\u5b66\u306e\u554f\u984c\u3092\u89e3\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3ec\ucee4\uc2a4 \uc138\uc158\uc744 \ucde8\uc18c\ud558\ub824\uba74 \ub2e4\uc74c \uc218\ud559 \ubb38\uc81c\ub97c \ud478\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los het volgende wiskundige probleem op om je focussessie te annuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwi\u0105\u017c poni\u017csze zadanie matematyczne, aby anulowa\u0107 sesj\u0119 skupienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva o seguinte problema matem\u00e1tico para cancelar sua sess\u00e3o de foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0448\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0440\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u0441\u0435\u0441\u0441\u0438\u044e \u0444\u043e\u043a\u0443\u0441\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanma oturumunuzu iptal etmek i\u00e7in a\u015fa\u011f\u0131daki matematik problemini \u00e7\u00f6z\u00fcn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89e3\u51b3\u4ee5\u4e0b\u6570\u5b66\u9898\u4ee5\u53d6\u6d88\u4f60\u7684\u4e13\u6ce8\u4f1a\u8bdd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89e3\u6c7a\u4ee5\u4e0b\u6578\u5b78\u554f\u984c\u4ee5\u53d6\u6d88\u60a8\u7684\u7126\u9ede\u8ab2\u7a0b\u3002"
          }
        }
      }
    },
    "math_challenge.error": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsches Ergebnis! Versuch es noch einmal."
          }
        },
        "en": {

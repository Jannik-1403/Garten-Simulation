        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici la boutique ! Cliquez sur Suivant pour y jeter un \u0153il."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939\u093e\u0901 \u0926\u0941\u0915\u093e\u0928 \u0939\u0948! \u0907\u0938\u0947 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0917\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco il negozio! Clicca su Avanti per dare un'occhiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u3053\u306f\u30b7\u30e7\u30c3\u30d7\u3067\u3059\uff01\u6b21\u3078\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u30c1\u30a7\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ec\uae30\uac00 \uc0c1\uc810\uc785\ub2c8\ub2e4! \ub2e4\uc74c\uc744 \ud074\ub9ad\ud558\uc5ec \ud655\uc778\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is de winkel! Klik op Volgende om het te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto sklep! Kliknij Dalej, aby go sprawdzi\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui est\u00e1 a loja! Clique em Pr\u00f3ximo para conferir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0442 \u043c\u0430\u0433\u0430\u0437\u0438\u043d! \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0414\u0430\u043b\u0435\u0435\u00bb, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0435\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u015fte ma\u011faza! G\u00f6z atmak i\u00e7in Sonraki'ye t\u0131klay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u91cc\u662f\u5546\u5e97\uff01\u5355\u51fb\u201c\u4e0b\u4e00\u6b65\u201d\u89c2\u770b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u88e1\u662f\u5546\u5e97\uff01\u6309\u4e00\u4e0b\u201c\u4e0b\u4e00\u6b65\u201d\u89c0\u770b\u3002"
          }
        }
      }
    },
    "tour_streak_header_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Streak erh\u00f6ht sich, wenn du jeden Tag alle deine Pflanzen einmal gie\u00dft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your streak increases when you water all your plants once every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha aumenta cuando riegas todas tus plantas una vez al d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre s\u00e9quence augmente lorsque vous arrosez toutes vos plantes une fois par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0917\u0930 \u0906\u092a \u0939\u0930 \u0926\u093f\u0928 \u0905\u092a\u0928\u0940 \u0938\u092d\u0940 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u090f\u0915 \u092c\u093e\u0930 \u092a\u093e\u0928\u0940 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0906\u092a\u0915\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u092c\u0922\u093c \u091c\u093e\u090f\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua serie aumenta quando annaffi tutte le tue piante una volta al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u3059\u3079\u3066\u306e\u690d\u7269\u306b\u4e00\u5ea6\u6c34\u3092\u3084\u308b\u3068\u9023\u7d9a\u8a18\u9332\u304c\u5897\u52a0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \ubaa8\ub4e0 \uc2dd\ubb3c\uc5d0 \ud55c \ubc88\uc529 \ubb3c\uc744 \uc8fc\uba74 \uc5f0\uc18d \uae30\ub85d\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je streak neemt toe wanneer je al je planten \u00e9\u00e9n keer per dag water geeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja passa ro\u015bnie, gdy codziennie raz podlewasz wszystkie swoje ro\u015bliny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequ\u00eancia aumenta quando voc\u00ea rega todas as suas plantas uma vez por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0430\u0448\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0432\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u043f\u043e\u043b\u0438\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her g\u00fcn t\u00fcm bitkilerinizi bir kez sulad\u0131\u011f\u0131n\u0131zda seriniz artar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u60a8\u6bcf\u5929\u7ed9\u6240\u6709\u690d\u7269\u6d47\u6c34\u4e00\u6b21\uff0c\u60a8\u7684\u8fde\u7eed\u6d47\u6c34\u6b21\u6570\u5c06\u4f1a\u589e\u52a0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u60a8\u6bcf\u5929\u7d66\u6240\u6709\u690d\u7269\u6f86\u6c34\u4e00\u6b21\uff0c\u60a8\u7684\u9023\u7e8c\u6f86\u6c34\u6b21\u6578\u5c07\u6703\u589e\u52a0\u3002"
          }
        }
      }
    },

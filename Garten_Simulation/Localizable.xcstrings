          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiet 10 magicznych nasion. Użyj ich, aby stworzyć własną unikalną roślinę!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pacote de 10 sementes mágicas. Usa-as para criar a tua própria planta única!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет с 10 магическими семенами. С их помощью ты сможешь создать своё собственное уникальное растение!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

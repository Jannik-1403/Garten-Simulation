    "paywall.feature.focus_sounds.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend den Alltag aus. Wissenschaftlich fundierte Kl\u00e4nge bringen dein Gehirn sofort in den Flow-State."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune out the everyday. Scientifically backed sounds instantly bring your brain into a flow state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descon\u00e9ctate del d\u00eda a d\u00eda. Sonidos respaldados por la ciencia llevan tu cerebro al instante al estado de flow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais abstraction du quotidien. Des sons scientifiquement prouv\u00e9s plongent ton cerveau dans un \u00e9tat de flow."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u094b\u091c\u092e\u0930\u094d\u0930\u093e \u0915\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u0915\u094b \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0915\u0930\u0947\u0902\u0964 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0906\u0927\u093e\u0930\u093f\u0924 \u0927\u094d\u0935\u0928\u093f\u092f\u093e\u0901 \u0906\u092a\u0915\u0947 \u092e\u0938\u094d\u0924\u093f\u0937\u094d\u0915 \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u092a\u094d\u0930\u0935\u093e\u0939 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0932\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludi la quotidianit\u00e0. Suoni scientificamente provati portano il tuo cervello direttamente nel flow state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e5\u5e38\u3092\u906e\u65ad\u3057\u307e\u3057\u3087\u3046\u3002\u79d1\u5b66\u7684\u306b\u88cf\u4ed8\u3051\u3089\u308c\u305f\u97f3\u304c\u3001\u8133\u3092\u5373\u5ea7\u306b\u30d5\u30ed\u30fc\u72b6\u614b\u306b\u5c0e\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc0c1\uc744 \ucc28\ub2e8\ud558\uc138\uc694. \uacfc\ud559\uc801\uc73c\ub85c \uc785\uc99d\ub41c \uc18c\ub9ac\uac00 \ub2f9\uc2e0\uc758 \ub1cc\ub97c \uc989\uc2dc \ud50c\ub85c\uc6b0 \uc0c1\ud0dc\ub85c \uc774\ub055\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de dagelijkse drukte buiten. Wetenschappelijk onderbouwde geluiden brengen je brein direct in een flowstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od\u0142\u0105cz si\u0119 od codzienno\u015bci. D\u017awi\u0119ki oparte na nauce natychmiast wprowadzaj\u0105 tw\u00f3j m\u00f3zg w stan flow."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue-se do cotidiano. Sons com base cient\u00edfica trazem seu c\u00e9rebro instantaneamente para o estado de flow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0433\u043e\u0440\u043e\u0434\u0438\u0441\u044c \u043e\u0442 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438. \u041d\u0430\u0443\u0447\u043d\u043e \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0437\u0432\u0443\u043a\u0438 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u044e\u0442 \u0442\u0432\u043e\u0439 \u043c\u043e\u0437\u0433 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u043e\u0442\u043e\u043a\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcndelik hayat\u0131 d\u0131\u015far\u0131da b\u0131rak. Bilimsel olarak desteklenen sesler beynini an\u0131nda ak\u0131\u015f durumuna getirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6446\u8131\u65e5\u5e38\u55a7\u56a3\u3002\u79d1\u5b66\u7684\u58f0\u97f3\u80fd\u7acb\u5373\u8ba9\u60a8\u7684\u5927\u8111\u8fdb\u5165\u5fc3\u6d41\u72b6\u6001\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c01\u9396\u65e5\u5e38\u751f\u6d3b\u3002\u57fa\u65bc\u79d1\u5b78\u7684\u8072\u97f3\u7acb\u5373\u8b93\u60a8\u7684\u5927\u8166\u9032\u5165\u6d41\u52d5\u72c0\u614b\u3002"
          }
        }
      }
    },

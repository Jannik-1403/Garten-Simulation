        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente hoje o peso do seu exercício favorito no menor disco (1kg / 1,25kg)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня увеличь вес в твоем любимом упражнении на самую маленькую пластину (1 кг / 1,25 кг)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sevdiğiniz egzersizin ağırlığını bugün en küçük disk (1kg / 1,25kg) kadar artırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在你最喜欢的练习中增加最小的重量片（1公斤 / 1.25公斤）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將您今天最喜歡的運動的重量增加最小的椎間盤（1 公斤/1.25 公斤）。"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du weichst dem Schmerz aus. Wir erhöhen die Intensität unmerklich, um deinen Körper auszutricksen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You avoid the pain. We increase the intensity subtly to trick your body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitas el dolor. Aumentamos la intensidad sutilmente para engañar a tu cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous évitez la douleur. Nous augmentons subtilement l’intensité pour tromper votre corps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप दर्द से बचें. हम आपके शरीर को धोखा देने के लिए तीव्रता को सूक्ष्मता से बढ़ाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eviti il ​​dolore. Aumentiamo leggermente l'intensità per ingannare il tuo corpo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは痛みを避けます。身体をだますように、微妙に強度を上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 고통을 피합니다. 우리는 당신의 몸을 속이기 위해 미묘하게 강도를 높입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vermijdt de pijn. We verhogen de intensiteit subtiel om je lichaam voor de gek te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikasz bólu. Subtelnie zwiększamy intensywność, aby oszukać Twoje ciało."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você evita a dor. Aumentamos a intensidade sutilmente para enganar seu corpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты уходишь от боли. Мы незаметно увеличиваем интенсивность, чтобы обмануть твоё тело."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acıdan kaçınırsın. Vücudunuzu kandırmak için yoğunluğu ustaca artırıyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在逃避疼痛。我们微妙地增加强度，以欺骗你的身体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你避免了痛苦。我們巧妙地增加強度來欺騙您的身體。"
          }
        }
      }
    },

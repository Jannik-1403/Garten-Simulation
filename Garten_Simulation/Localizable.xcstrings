            "value": "Come\u00e7ar aventura"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maceraya Ba\u015fla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f00\u59cb\u5192\u9669"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5192\u96aa\u958b\u59cb"
          }
        }
      }
    },
    "pfad_schwierigkeit_titel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie fit bist du schon?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How fit are you already?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQu\u00e9 tan en forma est\u00e1s ya?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c0 quel point es-tu d\u00e9j\u00e0 en forme ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u093f\u0924\u0928\u0947 \u092b\u093f\u091f \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto sei gi\u00e0 in forma?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u3059\u3067\u306b\u3069\u308c\u304f\u3089\u3044\u5065\u5eb7\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc774\ubbf8 \uc5bc\ub9c8\ub098 \uac74\uac15\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe fit ben jij al?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak sprawny ju\u017c jeste\u015b?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u00e3o em forma j\u00e1 est\u00e1s?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u044b \u0443\u0436\u0435 \u0432 \u0444\u043e\u0440\u043c\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten ne kadar formdas\u0131n?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u6709\u591a\u719f\u7ec3\u4e86\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u73fe\u5728\u7684\u5065\u5eb7\u72c0\u6cc1\u5982\u4f55\uff1f"
          }
        }
      }
    },
    "pfad_schwierigkeit_untertitel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir passen deinen Pfad an dein Level an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We adapt your path to your level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptamos tu camino a tu nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous adaptons ton parcours \u00e0 ton niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u092e \u0906\u092a\u0915\u0947 \u092a\u0925 \u0915\u094b \u0906\u092a\u0915\u0947 \u0938\u094d\u0924\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adattiamo il tuo percorso al tuo livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u305f\u3061\u306f\u3042\u306a\u305f\u306e\u30ec\u30d9\u30eb\u306b\u5408\u308f\u305b\u3066\u3042\u306a\u305f\u306e\u9053\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b0\ub9ac\ub294 \uadc0\ud558\uc758 \uc218\uc900\uc5d0 \ub9de\uac8c \uacbd\ub85c\ub97c \uc870\uc815\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wij passen uw traject aan uw niveau aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

    "assessment.finance.profile.kontrolleur.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimiere eine laufende Ausgabe oder richte einen automatischen Sparplan ein. Du hast die Disziplin – nutze sie aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimize a current expense or set up an automatic savings plan. You have the discipline – use it actively."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimiza un gasto actual o configura un plan de ahorro automático. Tienes la disciplina: úsala activamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimisez une dépense courante ou mettez en place un plan d’épargne automatique. Vous avez la discipline – utilisez-la activement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा व्यय को अनुकूलित करें या एक स्वचालित बचत योजना स्थापित करें। आपके पास अनुशासन है - इसका सक्रिय रूप से उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottimizza una spesa corrente o imposta un piano di risparmio automatico. Hai la disciplina: usala attivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の出費を最適化するか、自動貯蓄計画を設定します。あなたには規律があり、それを積極的に活用しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 비용을 최적화하거나 자동 저축 계획을 설정하세요. 당신에게는 규율이 있습니다. 이를 적극적으로 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimaliseer een huidige uitgave of stel een automatisch spaarplan op. Je hebt de discipline – gebruik die actief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoptymalizuj bieżące wydatki lub skonfiguruj automatyczny plan oszczędnościowy. Masz dyscyplinę – korzystaj z niej aktywnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otimize uma despesa atual ou configure um plano de poupança automático. Você tem disciplina – use-a ativamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимизируй текущие расходы или настрой автоматический план сбережений. У тебя есть дисциплина – используй её активно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut bir gideri optimize edin veya otomatik bir tasarruf planı oluşturun. Disiplininiz var; onu aktif olarak kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优化一个正在进行的支出或设立一个自动储蓄计划。你有自律——积极利用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優化目前支出或設定自動儲蓄計劃。你有紀律——積極運用它。"
          }
        }
      }
    },
    "assessment.finance.profile.kontrolleur.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisiere 1％ mehr deines Einkommens direkt per Dauerauftrag auf ein Anlagekonto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automate 1％ more of your income directly into an investment account via standing order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatice un 1％ más de sus ingresos directamente en una cuenta de inversión mediante orden permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisez 1 ％ de plus de vos revenus directement sur un compte d'investissement via un ordre permanent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थायी आदेश के माध्यम से अपनी आय का 1％ अधिक सीधे निवेश खाते में स्वचालित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatizza l'1％ in più del tuo reddito direttamente su un conto di investimento tramite ordine permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収入の 1％ を追加して、スタンディング注文を通じて直接投資口座に自動入金します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정기 주문을 통해 수입의 1％ 이상을 직접 투자 계좌로 자동화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiseer 1％ meer van uw inkomsten rechtstreeks naar een beleggingsrekening via een doorlopende opdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zautomatyzuj 1％ więcej swoich dochodów bezpośrednio na rachunku inwestycyjnym za pomocą zlecenia stałego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatize 1％ a mais de sua receita diretamente em uma conta de investimento por meio de ordem permanente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматизируй 1％ своего дохода напрямую через постоянное поручение на инвестиционный счет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelirinizin ％1 daha fazlasını sabit emir yoluyla doğrudan bir yatırım hesabına aktarın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你收入的1％通过自动转账直接存入投资账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過定期訂單自動將 1％ 的收入直接存入投資帳戶。"
          }
        }
      }
    },
    "assessment.finance.profile.kontrolleur.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine Finanzen im Griff, aber du kannst dein System noch reibungsloser gestalten. Mikromanagement raubt dir Zeit für echtes Wachstum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have your finances under control, but you can make your system even smoother. Micromanagement robs you of time for real growth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes tus finanzas bajo control, pero puedes hacer que tu sistema sea aún más fluido. La microgestión le roba tiempo para un crecimiento real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous maîtrisez vos finances, mais vous pouvez rendre votre système encore plus fluide. La microgestion vous fait perdre du temps pour une véritable croissance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी वित्तीय स्थिति आपके नियंत्रण में है, लेकिन आप अपने सिस्टम को और भी बेहतर बना सकते हैं। सूक्ष्म प्रबंधन वास्तविक विकास के लिए आपका समय छीन लेता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai le tue finanze sotto controllo, ma puoi rendere il tuo sistema ancora più fluido. La microgestione ti ruba il tempo necessario per una crescita reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "財務を管理できますが、システムをさらにスムーズにすることもできます。マイクロマネジメントは真の成長のための時間を奪います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재정을 통제하면서 시스템을 더욱 원활하게 만들 수 있습니다. 세세한 관리는 진정한 성장을 위한 시간을 빼앗아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U heeft uw financiën onder controle, maar u kunt uw systeem nog soepeler maken. Micromanagement berooft je van tijd voor echte groei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz swoje finanse pod kontrolą, ale możesz sprawić, że Twój system będzie jeszcze płynniejszy. Mikrozarządzanie pozbawia Cię czasu na prawdziwy rozwój."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem suas finanças sob controle, mas pode tornar seu sistema ainda mais tranquilo. O microgerenciamento rouba seu tempo para um crescimento real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя под контролем финансы, но ты можешь сделать свою систему ещё более гладкой. Микроменеджмент отнимает у тебя время для настоящего роста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mali durumunuz kontrol altında ama sisteminizi daha da sorunsuz hale getirebilirsiniz. Mikro yönetim, gerçek büyüme için gereken zamanı çalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你掌握了自己的财务，但你可以让你的系统更加顺畅。微观管理会夺走你真正增长的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的財務盡在掌控之中，但您也可以讓您的系統更加順暢。微觀管理會剝奪你真正成長的時間。"
          }
        }
      }
    },

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои друзья начинают обсуждать кого-то за спиной, кто не находится в комнате. Как ты себя ведёшь?"
          }
        },
        "tr" : {

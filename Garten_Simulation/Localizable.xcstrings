    "trash.doomscrolling_handy.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege das Handy weg und befreie deinen Geist von ständigen Reizen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the phone down and free your mind from constant stimuli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el teléfono y libera tu mente de los estímulos constantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ton téléphone et libère ton esprit des stimuli constants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti giù il telefono e libera la tua mente dai continui stimoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話を置いて、絶え間ない刺激から心を解放してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 내려놓고 끊임없는 자극에서 마음을 자유롭게 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg je telefoon weg en bevrijd je geest van voortdurende prikkels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłóż telefon i uwolnij umysł od ciągłych bodźców."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Largue o telefone e liberte a sua mente de estímulos constantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu bırakın ve zihninizi sürekli uyarılardan arındırın."
          }
        }
      }
    },

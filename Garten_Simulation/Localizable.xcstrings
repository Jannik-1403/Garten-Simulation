    "assessment.fitness.q5.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich gehe hin und zerstöre das Hass-Workout exakt nach Plan. Kopfschmerzen sind keine Ausrede."

    "assessment.mental.q1" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein größtes, lang ersehntes Projekt scheitert am allerletzten Tag durch eine Formalität. Was passiert in deinem Kopf?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your biggest, long-awaited project fails on the very last day due to a technicality. What's happening in your head?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su proyecto más grande y tan esperado fracasa el último día debido a un tecnicismo. ¿Qué está pasando en tu cabeza?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre projet le plus important et tant attendu échoue le tout dernier jour en raison d’un problème technique. Que se passe-t-il dans ta tête ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सबसे बड़ी, लंबे समय से प्रतीक्षित परियोजना तकनीकी कारणों से आखिरी दिन विफल हो जाती है। आपके दिमाग में क्या चल रहा है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo progetto più grande e tanto atteso fallisce proprio l'ultimo giorno a causa di un cavillo. Cosa sta succedendo nella tua testa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待望の最大のプロジェクトが、技術的な問題により最終日に失敗します。頭の中で何が起こっているのですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오랫동안 기다려온 가장 큰 프로젝트가 기술 문제로 인해 마지막 날 실패했습니다. 머리 속에서 무슨 일이 일어나고 있는 걸까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je grootste, langverwachte project mislukt op de allerlaatste dag vanwege een technisch probleem. Wat gebeurt er in je hoofd?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój największy, długo oczekiwany projekt kończy się niepowodzeniem ostatniego dnia ze względów technicznych. Co się dzieje w Twojej głowie?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu maior e mais esperado projeto falha no último dia devido a um detalhe técnico. O que está acontecendo na sua cabeça?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой самый большой, долгожданный проект терпит неудачу в самый последний день из-за формальности. Что происходит у тебя в голове?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun zamandır beklediğiniz en büyük projeniz teknik bir sorun nedeniyle son günde başarısız oldu. Kafanın içinde neler oluyor?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最大的、期待已久的项目在最后一天因为一个形式问题而失败。你脑子里会发生什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您期待已久的最大專案在最後一天由於技術原因失敗了。你腦子裡發生了什麼事？"
          }
        }
      }
    },
    "assessment.mental.q1.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war’s. Ich fasse so etwas nie wieder an, das Schicksal ist gegen mich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's it. I'll never touch something like that again, fate is against me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso es todo. Nunca volveré a tocar algo así, el destino está en mi contra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est ça. Je ne toucherai plus jamais à quelque chose comme ça, le destin est contre moi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतना ही। मैं ऐसी किसी चीज़ को दोबारा कभी नहीं छूऊंगा, भाग्य मेरे ख़िलाफ़ है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è tutto. Non toccherò mai più una cosa del genere, il destino è contro di me."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それでおしまい。あんなものには二度と触れない、運命は私に敵対している。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그게 다야. 나는 다시는 그런 것을 만지지 않을 것입니다. 운명은 나를 반대합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat is het. Zoiets raak ik nooit meer aan, het lot is tegen mij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wszystko. Nigdy więcej nie dotknę czegoś takiego, los jest przeciwko mnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É isso. Nunca mais tocarei em algo assim, o destino está contra mim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вот и всё. Я больше никогда не возьмусь за такое, судьба против меня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşte bu. Bir daha asla böyle bir şeye dokunmayacağım, kader bana karşı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就这样。我再也不会碰这种东西了，命运对我不利。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就是這樣。我再也不會碰這樣的東西了，命運對我不利。"
          }
        }
      }
    },
    "assessment.mental.q1.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich betäube mich tagelang mit Netflix/Social Media, um nicht daran zu denken."

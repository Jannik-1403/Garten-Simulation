            "value" : "मैं अक्सर तभी पीता हूं जब मुझे सिरदर्द होता है या बहुत ज्यादा प्यास लगती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesso bevo solo quando ho mal di testa o ho molta sete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は頭が痛くなったとき、または喉がひどく渇いたときにのみお酒を飲むことがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나는 두통이 있거나 극도로 목이 마를 때만 술을 마시는 경우가 많다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

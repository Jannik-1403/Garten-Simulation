    "prog_cooking_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze heute absolut keine Lebensmittel, die mehr als 3 Zutaten auf der Verpackung stehen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, absolutely do not use any food that has more than 3 ingredients on the packaging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en día, no utilices en absoluto ningún alimento que tenga más de 3 ingredientes en el envase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, n’utilisez absolument aucun aliment contenant plus de 3 ingrédients sur l’emballage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज ऐसे किसी भी खाद्य पदार्थ का उपयोग बिल्कुल न करें जिसकी पैकेजिंग पर 3 से अधिक सामग्रियां हों।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi è assolutamente vietato utilizzare alimenti che contengano più di 3 ingredienti sulla confezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、パッケージに3つ以上の原材料が記載されている食品は絶対に使用しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘날에는 포장에 3가지 이상의 성분이 포함된 식품은 절대 사용하지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik tegenwoordig absoluut geen voedsel met meer dan 3 ingrediënten op de verpakking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś absolutnie nie używaj żadnej żywności, która ma więcej niż 3 składniki na opakowaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, absolutamente não utilize nenhum alimento que tenha mais de 3 ingredientes na embalagem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, absolutamente não utilize nenhum alimento que tenha mais de 3 ingredientes na embalagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня категорически не употребляйте продукты, на упаковке которых содержится более 3 ингредиентов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günümüzde ambalajında ​​3'ten fazla bileşen bulunan hiçbir gıdayı kesinlikle kullanmayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如今，绝对不要使用包装上含有 3 种以上成分的任何食品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如今，絕對不要使用包裝上含有 3 種以上成分的任何食品。"
          }
        }
      }
    },

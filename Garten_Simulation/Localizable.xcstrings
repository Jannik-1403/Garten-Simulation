          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento evitar isso o tempo todo, mas desisto várias vezes por semana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я постоянно стараюсь этого избегать, но срываюсь несколько раз в неделю."
          }
        },

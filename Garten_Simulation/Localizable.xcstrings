    "assessment.growth.q1" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag 1 deines neuen Plans lief perfekt. An Tag 2 regnet es, du bist extrem müde und hast absolut null Motivation. Was tust du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Day 1 of your new plan went perfectly. On day 2 it's raining, you're extremely tired and have absolutely zero motivation. What are you doing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El día 1 de tu nuevo plan salió perfecto. El día 2 llueve, estás extremadamente cansado y no tienes ninguna motivación. ¿Qué estás haciendo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier jour de votre nouveau plan s'est parfaitement déroulé. Le deuxième jour, il pleut, vous êtes extrêmement fatigué et n'avez absolument aucune motivation. Que fais-tu?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी नई योजना का पहला दिन बढ़िया रहा। दूसरे दिन बारिश हो रही है, आप बेहद थके हुए हैं और आपकी प्रेरणा बिल्कुल शून्य है। आप क्या कर रहे हो?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo giorno del tuo nuovo piano è andato perfettamente. Il secondo giorno piove, sei estremamente stanco e hai assolutamente zero motivazione. Cosa fai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい計画の 1 日目は完璧に進みました。 2日目は雨が降っていて、極度に疲れていてやる気がまったくありません。何してるの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 계획의 첫 번째 날은 완벽하게 진행되었습니다. 둘째 날에는 비가 와서 극도로 피곤하고 의욕이 전혀 없습니다. 뭐하세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag 1 van je nieuwe plan verliep perfect. Op dag 2 regent het, ben je extreem moe en heb je absoluut geen motivatie. Wat ben je aan het doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszy dzień nowego planu poszedł doskonale. Drugiego dnia pada deszcz, jesteś bardzo zmęczony i nie masz absolutnie żadnej motywacji. Co robisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro dia do seu novo plano correu perfeitamente. No segundo dia está chovendo, você está extremamente cansado e sem motivação. O que você está fazendo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День 1 твоего нового плана прошёл идеально. На день 2 идёт дождь, ты крайне устал и у тебя абсолютно ноль мотивации. Что ты делаешь?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni planınızın 1. günü mükemmel geçti. 2. günde yağmur yağıyor, son derece yorgunsunuz ve motivasyonunuz kesinlikle sıfır. Ne yapıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你新计划的第一天进行得很完美。第二天却下雨，你非常疲惫，完全没有动力。你会怎么做？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的新計畫的第一天進行得很順利。第二天下著雨，你非常疲倦，動力完全為零。你在幹什麼？"
          }
        }
      }
    },
    "assessment.growth.q1.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {

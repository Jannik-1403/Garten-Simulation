    "grovy_story_scene1_sub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Benachrichtigung, jeder Like und jedes Video schüttet Dopamin aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every notification, every like, and every video releases dopamine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificación, cada me gusta y cada video libera dopamina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque notification, chaque like et chaque vidéo libère de la dopamine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अधिसूचना, हर लाइक और हर वीडियो डोपामाइन जारी करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notifica, ogni like e ogni video rilascia dopamina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての通知、いいね、ビデオがドーパミンを放出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 알림, 좋아요, 비디오는 도파민을 분비합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke melding, elke like en elke video maakt dopamine vrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde powiadomienie, polubienie i wideo uwalnia dopaminę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificação, like e vídeo liberta dopamina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificação, like e vídeo libera dopamina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое уведомление, лайк и видео высвобождают дофамин."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bildirim, her beğeni ve her video dopamin salgılar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个通知、每个赞和每个视频都会释放多巴胺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個通知、每個讚和每個視頻都會釋放多巴胺。"
          }
        }
      }
    },
    "grovy_story_scene1_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gehirn liebt\nschnelle Kicks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brain loves\nquick kicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cerebro ama\nlos estímulos rápidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton cerveau adore\nles sensations rapides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मस्तिष्क को\nत्वरित किक पसंद हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cervello ama\ngli stimoli veloci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脳は\n素早い刺激が好き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 뇌는\n빠른 자극을 좋아합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je brein houdt\nvan snelle kicks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój mózg uwielbia\nszybkie pobudzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu cérebro adora\nestímulos rápidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu cérebro adora\nestímulos rápidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой мозг любит\nбыстрые стимулы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beynin hızlı\nuyarıcıları sever."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的大脑喜欢\n快速刺激。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的大腦喜歡\n快速刺激。"
          }
        }
      }
    },
    "grovy_story_scene2_sub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Kick senkt dein Normal-Level – du brauchst immer mehr, um dich gut zu fühlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every kick lowers your normal level – you need more and more to feel good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estímulo baja tu nivel normal – necesitas cada vez más para sentirte bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque sensation abaisse ton niveau normal – tu en as de plus en plus besoin pour te sentir bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर किक आपके सामान्य स्तर को कम करता है - आपको अच्छा महसूस करने के लिए और अधिक की आवश्यकता होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni stimolo abbassa il tuo livello normale – hai bisogno di sempre di più per sentirti bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "刺激ごとに通常のレベルが下がり、気分を良くするにはもっと必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자극을 받을 때마다 정상 수준이 낮아져, 기분이 좋아지려면 점점 더 많은 자극이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke kick verlaagt je normale niveau – je hebt steeds meer nodig om je goed te voelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy kop obniża twój normalny poziom – potrzebujesz coraz więcej, by czuć się dobrze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estímulo baixa o teu nível normal – precisas cada vez de mais para te sentires bem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada estímulo baixa o seu nível normal – você precisa de cada vez mais para se sentir bem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый стимул снижает твой нормальный уровень – тебе нужно все больше, чтобы чувствовать себя хорошо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uyarıcı normal seviyeni düşürür – iyi hissetmek için giderek daha fazlasına ihtiyacın olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次刺激都会降低你的正常水平——你需要越来越多才能感觉良好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次刺激都會降低你的正常水平——你需要越來越多才能感覺良好。"
          }
        }
      }
    },
    "grovy_story_scene2_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kick. Crash.\nWiederholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kick. Crash.\nRepeat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estímulo. Caída.\nRepetir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensation. Chute.\nRépéter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किक. दुर्घटना.\nदोहराएं."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimolo. Crollo.\nRipeti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "刺激。クラッシュ。\n繰り返す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자극. 추락.\n반복."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kick. Crash.\nHerhalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kop. Spadek.\nPowtórz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estímulo. Queda.\nRepetir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estímulo. Queda.\nRepetir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стимул. Спад.\nПовторить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarıcı. Düşüş.\nTekrar et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刺激。崩溃。\n重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刺激。崩潰。\n重複。"
          }
        }
      }
    },
    "grovy_story_scene3_sub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ständige Reize machen es schwer, dranzubleiben – gute Gewohnheiten gehen unter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Constant stimuli make it hard to stick with it – good habits get lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estímulos constantes dificultan la perseverancia – los buenos hábitos se pierden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stimuli constants rendent difficile la persévérance – les bonnes habitudes se perdent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निरंतर उत्तेजनाओं से बने रहना मुश्किल हो जाता है - अच्छी आदतें खो जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stimoli costanti rendono difficile la costanza – le buone abitudini si perdono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絶え間ない刺激は続けることを難しくし、良い習慣が失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지속적인 자극은 인내하기 어렵게 만들며, 좋은 습관을 잃게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Constante prikkels maken het moeilijk om vol te houden – goede gewoonten gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciągłe bodźce utrudniają wytrwałość – dobre nawyki zanikają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estímulos constantes dificultam a perseverança – os bons hábitos perdem-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estímulos constantes dificultam a perseverança – os bons hábitos se perdem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянные стимулы затрудняют постоянство – хорошие привычки теряются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli uyarıcılar tutarlı olmayı zorlaştırır – iyi alışkanlıklar kaybolur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续的刺激让你很难坚持下去——好习惯逐渐消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持續的刺激讓你很難堅持下去——好習慣逐漸消失。"
          }
        }
      }
    },
    "grovy_story_scene3_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und dein Fokus\nwelkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And your focus\nwilts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y tu enfoque\nse marchita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ton attention\nse fane."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और आपका ध्यान\nकमजोर हो जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E il tuo focus\nappassisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そして集中力が\n枯れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리고 집중력이\n시듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "En je focus\nverwelkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "A twój focus\nwiędnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "E o teu foco\nmurcha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E o seu foco\nmurcha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "А твой фокус\nвянет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve odağın\nsolar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的注意力\n也会枯萎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的注意力\n也會枯萎。"
          }
        }
      }
    },
    "grovy_story_scene4_sub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede erledigte Gewohnheit lässt deinen Garten wachsen – echter Fortschritt statt Scroll-Kick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every completed habit makes your garden grow – real progress instead of a scroll kick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hábito completado hace crecer tu jardín – progreso real en lugar de un estímulo de scroll."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque habitude complétée fait grandir ton jardin – de vrais progrès au lieu d'une sensation de scroll."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पूरी हुई आदत से आपका बगीचा बढ़ता है - स्क्रॉल किक के बजाय वास्तविक प्रगति।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni abitudine completata fa crescere il tuo giardino – progressi reali invece di uno stimolo da scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣を完了するごとに庭が成長します。スクロール刺激ではなく、本当の進歩です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 완료할 때마다 정원이 자라납니다. 스크롤 자극이 아닌 진정한 발전입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke voltooide gewoonte laat je tuin groeien – echte vooruitgang in plaats van een scroll-kick."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy ukończony nawyk sprawia, że twój ogród rośnie – prawdziwy postęp zamiast kopu z przewijania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hábito concluído faz o teu jardim crescer – progresso real em vez de um estímulo de scroll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hábito concluído faz o seu jardim crescer – progresso real em vez de um estímulo de scroll."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая выполненная привычка заставляет твой сад расти – настоящий прогресс вместо стимула от скроллинга."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan her alışkanlık bahçeni büyütür – kaydırma uyarıcısı yerine gerçek ilerleme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的每个习惯都会让你的花园成长——这是真正的进步，而不是刷屏带来的刺激。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的每個習慣都會讓你的花園成長——這是真正的進步，而不是刷屏帶來的刺激。"
          }
        }
      }
    },

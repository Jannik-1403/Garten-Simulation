          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9593\u9055\u3063\u305f\u7d50\u679c\uff01\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc798\ubabb\ub41c \uacb0\uacfc! \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624."

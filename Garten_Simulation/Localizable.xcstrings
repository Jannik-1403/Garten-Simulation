    "notification.wait.3.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss \"%@\" nicht!"
          }
        },
        "en": {

        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oto twoje monety. Kliknij na nie, jeśli chcesz kupić więcej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui estão suas moedas. Clique nelas se quiser comprar mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь вы можете увидеть свои монеты. Нажмите на это, если вы хотите приобрести больше при необходимости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

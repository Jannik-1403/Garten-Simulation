        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "습관이 필요한 시간! 가장 높은 연속 기록은 %d입니다. 계속 성장하자!"
          }
        },
        "nl" : {
          "stringUnit" : {

          "stringUnit": {
            "state": "translated",
            "value": "Por favor, habilita el Tiempo en pantalla para Zalimo Habits en los Ajustes de iOS para poder bloquear aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez activer Temps d'écran pour Zalimo Habits dans les Réglages iOS afin de pouvoir bloquer des applications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया iOS सेटिंग्स में ग्रोवी के लिए स्क्रीन टाइम सक्षम करें ताकि आप ऐप्स को ब्लॉक कर सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, abilita Tempo di utilizzo per Zalimo Habits nelle Impostazioni di iOS per bloccare le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティン中にアプリをブロックするには、iOSの設定でZalimo Habitsのスクリーンタイムを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴 중 앱을 차단하려면 iOS 설정에서 Zalimo Habits의 스크린 타임을 활성화해주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Schermtijd voor Zalimo Habits in bij de iOS-instellingen om apps te kunnen blokkeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę, włącz Czas przed ekranem dla Zalimo Habits w Ustawieniach iOS, aby móc blokować aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, ative o Tempo de Uso para o Zalimo Habits nos Ajustes do iOS para bloquear aplicativos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Tempo de Uso para o Zalimo Habits nos Ajustes do iOS para poder bloquear apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, включите Экранное время для Zalimo Habits в настройках iOS, чтобы блокировать приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaları engelleyebilmek için lütfen iOS Ayarlarından Zalimo Habits için Ekran Süresi'ni etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中为 Zalimo Habits 启用屏幕使用时间，以便您能够阻止应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 iOS 設定中為 Zalimo Habits 啟用螢幕使用時間，以便您能夠封鎖應用程式。"
          }
        }
      }
    },

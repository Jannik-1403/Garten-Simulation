    "plant.lotus.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deine innere Ruhe und Balance durch t\u00e4gliche Meditation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your inner peace and balance through daily meditation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu paz interior y equilibrio a trav\u00e9s de la meditaci\u00f3n diaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez votre paix int\u00e9rieure et votre \u00e9quilibre gr\u00e2ce \u00e0 la m\u00e9ditation quotidienne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0948\u0928\u093f\u0915 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u0906\u0902\u0924\u0930\u093f\u0915 \u0936\u093e\u0902\u0924\u093f \u0914\u0930 \u0938\u0902\u0924\u0941\u0932\u0928 \u0916\u094b\u091c\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova la tua pace interiore e il tuo equilibrio attraverso la meditazione quotidiana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u306e\u7791\u60f3\u3092\u901a\u3058\u3066\u3001\u5185\u306a\u308b\u5e73\u548c\u3068\u30d0\u30e9\u30f3\u30b9\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c\uc758 \uba85\uc0c1\uc744 \ud1b5\ud574 \ub0b4\uba74\uc758 \ud3c9\ud654\uc640 \uade0\ud615\uc744 \ucc3e\uc73c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je innerlijke rust en balans door dagelijkse meditatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajd\u017a wewn\u0119trzny spok\u00f3j i r\u00f3wnowag\u0119 poprzez codzienne medytacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre sua paz interior e equil\u00edbrio atrav\u00e9s da medita\u00e7\u00e3o di\u00e1ria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0439\u0434\u0438 \u0441\u0432\u043e\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u043f\u043e\u043a\u043e\u0439 \u0438 \u0431\u0430\u043b\u0430\u043d\u0441 \u0447\u0435\u0440\u0435\u0437 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0443\u044e \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck meditasyonla i\u00e7 huzurunuzu ve dengenizi bulun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u6bcf\u65e5\u51a5\u60f3\u627e\u5230\u5185\u5fc3\u7684\u5e73\u9759\u4e0e\u5e73\u8861\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u65e5\u5e38\u51a5\u60f3\u627e\u5230\u5167\u5fc3\u7684\u5e73\u975c\u8207\u5e73\u8861\u3002"
          }
        }
      }
    },

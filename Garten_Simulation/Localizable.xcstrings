    "plant.aloe_vera.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heilt und regeneriert still im Hintergrund \u2013 weniger Handy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heals and regenerates silently \u2013 less phone time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cura y regenera en silencio \u2013 menos tiempo de pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gu\u00e9rit et r\u00e9g\u00e9n\u00e8re silencieusement \u2013 moins de t\u00e9l\u00e9phone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0920\u0940\u0915 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u092e\u0947\u0902 \u091a\u0941\u092a\u091a\u093e\u092a \u092a\u0941\u0928\u0930\u094d\u091c\u0940\u0935\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 - \u0915\u092e \u0938\u0947\u0932 \u092b\u094b\u0928"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Heals and regenerates silently \u2013 less phone time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9759\u304b\u306b\u4fee\u5fa9\u3068\u518d\u751f \u2013 \u96fb\u8a71\u6642\u9593\u3092\u77ed\u7e2e"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc870\uc6a9\ud788 \uce58\ub8cc\ud558\uace0 \uc7ac\uc0dd\ud569\ub2c8\ub2e4. \ud1b5\ud654 \uc2dc\uac04\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geneest en regenereert in stilte \u2013 minder telefoontijd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leczy i regeneruje po cichu \u2013 mniej czasu na telefon"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cura e regenera silenciosamente \u2013 menos telem\u00f3vel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0446\u0435\u043b\u044f\u0435\u0442 \u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0442\u0438\u0445\u043e \u043d\u0430 \u0437\u0430\u0434\u043d\u0435\u043c \u043f\u043b\u0430\u043d\u0435 \u2014 \u043c\u0435\u043d\u044c\u0448\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessizce iyile\u015fir ve yenilenir; daha az telefon s\u00fcresi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u540e\u53f0\u9ed8\u9ed8\u6cbb\u6108\u548c\u518d\u751f \u2013 \u51cf\u5c11\u624b\u673a\u4f7f\u7528"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5f8c\u53f0\u9ed8\u9ed8\u5730\u6cbb\u7652\u548c\u518d\u751f\u2014\u2014\u7121\u9700\u624b\u6a5f"
          }
        }
      }
    },

        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você foi muito consistente esta semana e manteve seus tempos sólidos. Consistência é a chave para o sucesso a longo prazo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой неделе вы были очень последовательны и показали хорошие результаты. Последовательность – ключ к долгосрочному успеху!"

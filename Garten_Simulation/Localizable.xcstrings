    "assessment.mental.profile.glaeserner.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärke deine Resilienz durch kleine Rückschläge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your resilience through small setbacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece tu resiliencia a través de pequeños contratiempos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcez votre résilience face à de petits revers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforza la tua resilienza attraverso piccoli intoppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな挫折を通じて回復力を強化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 좌절을 통해 회복력을 강화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versterk je veerkracht bij kleine tegenslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmacniaj swoją odporność poprzez drobne niepowodzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortaleça sua resiliência através de pequenos contratempos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük aksiliklerle dayanıklılığınızı güçlendirin."
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.break": {

          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistrzostwo osi\u0105gni\u0119te!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mestria alcan\u00e7ada!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0435\u043c\u043f\u0438\u043e\u043d\u0430\u0442 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustal\u0131\u011fa ula\u015f\u0131ld\u0131!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fbe\u6210\u7cbe\u901a\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51a0\u8ecd\u9054\u6210\uff01"
          }
        }
      }
    },
    "pfad_fit_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gew\u00f6hne deinen K\u00f6rper an t\u00e4gliche Bewegung. Kleine Schritte f\u00fchren weit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get your body used to daily movement. Small steps go a long way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostumbra tu cuerpo al movimiento diario. Los peque\u00f1os pasos llevan lejos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitue ton corps \u00e0 une activit\u00e9 quotidienne. Les petits pas m\u00e8nent loin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u0930\u094b\u091c\u093e\u0928\u093e \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u0921\u093e\u0932\u0947\u0902\u0964 \u091b\u094b\u091f\u0947 \u0915\u0926\u092e \u092c\u0939\u0941\u0924 \u0906\u0917\u0947 \u0924\u0915 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitua il tuo corpo al movimento quotidiano. Piccoli passi portano lontano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e5\u3005\u306e\u52d5\u304d\u306b\u4f53\u3092\u6163\u308c\u3055\u305b\u307e\u3057\u3087\u3046\u3002\u5c0f\u3055\u306a\u4e00\u6b69\u304c\u5927\u304d\u304f\u524d\u9032\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc0c1\uc801\uc778 \uc6c0\uc9c1\uc784\uc5d0 \ubab8\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uc791\uc740 \ubc1c\uac78\uc74c\uc774 \uba3c \uae38\uc744 \uac11\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat uw lichaam wennen aan dagelijkse beweging. Met kleine stapjes kom je een heel eind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyzwyczajaj swoje cia\u0142o do codziennego ruchu. Ma\u0142ymi krokami mo\u017cna osi\u0105gn\u0105\u0107 d\u0142ug\u0105 drog\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitua o teu corpo ao movimento di\u00e1rio. Pequenos passos levam longe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0432\u044b\u043a\u0430\u0439 \u0441\u0432\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c \u043a \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u043c \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f\u043c. \u041c\u0430\u043b\u044b\u0435 \u0448\u0430\u0433\u0438 \u0432\u0435\u0434\u0443\u0442 \u0434\u0430\u043b\u0435\u043a\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuzu g\u00fcnl\u00fck hareketlere al\u0131\u015ft\u0131r\u0131n. K\u00fc\u00e7\u00fck ad\u0131mlar uzun bir yol kat eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba9\u4f60\u7684\u8eab\u4f53\u9002\u5e94\u65e5\u5e38\u8fd0\u52a8\u3002\u5c0f\u6b65\u4e5f\u80fd\u8d70\u8fdc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b93\u4f60\u7684\u8eab\u9ad4\u7fd2\u6163\u65e5\u5e38\u904b\u52d5\u3002\u5c0f\u6b65\u9a5f\u5927\u6709\u5e6b\u52a9\u3002"
          }
        }
      }
    },
    "pfad_fit_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein Fitness-Profi. Halte dieses Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a fitness pro. Maintain this level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un pro del fitness. Mant\u00e9n este nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un pro du fitness. Maintiens ce niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u090f\u0915 \u092b\u093f\u091f\u0928\u0947\u0938 \u092a\u0947\u0936\u0947\u0935\u0930 \u0939\u0948\u0902. \u0907\u0938 \u0938\u094d\u0924\u0930 \u0915\u094b \u092c\u0928\u093e\u090f \u0930\u0916\u0947\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un professionista del fitness. Mantieni questo livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u306e\u30d7\u30ed\u3067\u3059\u3002\u3053\u306e\u30ec\u30d9\u30eb\u3092\u7dad\u6301\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ud53c\ud2b8\ub2c8\uc2a4 \uc804\ubb38\uac00\uc785\ub2c8\ub2e4. \uc774 \uc218\uc900\uc744 \uc720\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een fitnessprofessional. Houd dit niveau aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b profesjonalist\u0105 w dziedzinie fitnessu. Utrzymuj ten poziom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9s um pro de fitness. Mant\u00e9m este n\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b \u0432 \u0444\u0438\u0442\u043d\u0435\u0441\u0435. \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 \u044d\u0442\u043e\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen bir fitness uzman\u0131s\u0131n. Bu seviyeyi koruyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u662f\u4e00\u4f4d\u5065\u8eab\u4e13\u5bb6\u3002\u4fdd\u6301\u8fd9\u4e2a\u6c34\u5e73\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u662f\u5065\u8eab\u5c08\u696d\u4eba\u58eb\u3002\u4fdd\u6301\u9019\u500b\u6c34\u5e73\u3002"
          }
        }
      }
    },
    "pfad_fit_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertiefe dein Training. Dein K\u00f6rper wird noch st\u00e4rker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deepen your training. Your body is getting even stronger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundiza tu entrenamiento. Tu cuerpo se est\u00e1 volviendo a\u00fan m\u00e1s fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approfondis ton entra\u00eenement. Ton corps devient encore plus fort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u094b \u0917\u0939\u0930\u093e \u0915\u0930\u0947\u0902. \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0914\u0930 \u092d\u0940 \u0924\u093e\u0915\u0924\u0935\u0930 \u0939\u094b \u091c\u093e\u090f\u0917\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approfondisci il tuo allenamento. Il tuo corpo sta diventando ancora pi\u00f9 forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u6df1\u3081\u3066\u304f\u3060\u3055\u3044\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u3055\u3089\u306b\u5f37\u304f\u306a\u3063\u3066\u3044\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud6c8\ub828\uc744 \uc2ec\ud654\ud558\uc138\uc694. \ub2f9\uc2e0\uc758 \ubab8\uc740 \ub354\uc6b1 \uac15\ud574\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiep je training. Je lichaam wordt nog sterker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pog\u0142\u0119biaj sw\u00f3j trening. Twoje cia\u0142o staje si\u0119 jeszcze silniejsze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprofunda o teu treino. O teu corpo est\u00e1 a ficar ainda mais forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0433\u043b\u0443\u0431\u043b\u044f\u0439 \u0441\u0432\u043e\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0443. \u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0441\u0442\u0430\u043d\u0435\u0442 \u0435\u0449\u0435 \u0441\u0438\u043b\u044c\u043d\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u011fitiminizi derinle\u015ftirin. V\u00fccudunuz daha da g\u00fc\u00e7leniyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6df1\u5316\u4f60\u7684\u8bad\u7ec3\u3002\u4f60\u7684\u8eab\u4f53\u4f1a\u53d8\u5f97\u66f4\u5f3a\u58ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u6df1\u4f60\u7684\u8a13\u7df4\u3002\u4f60\u7684\u8eab\u9ad4\u5c07\u6703\u8b8a\u5f97\u66f4\u5f37\u5927\u3002"
          }
        }
      }
    },
    "pfad_generic_description_fallback": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib konzentriert auf deine Aufgabe: [HABIT]. Jeder Tag z\u00e4hlt auf deiner Reise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay focused on your task: [HABIT]. Every day counts on your journey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente enfocado en tu tarea: [HABIT]. Cada d\u00eda cuenta en tu viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste concentr\u00e9 sur ta t\u00e2che : [HABIT]. Chaque jour compte dans ton voyage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0915\u093e\u0930\u094d\u092f \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0930\u0939\u0947\u0902: [\u0906\u0926\u0924]\u0964 \u0939\u0930 \u0926\u093f\u0928 \u0906\u092a\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u092a\u0930 \u0928\u093f\u0930\u094d\u092d\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta concentrato sul tuo compito: [HABIT]. Ogni giorno conta nel tuo viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30b9\u30af\u306b\u96c6\u4e2d\u3057\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044: [HABIT]\u3002\u3042\u306a\u305f\u306e\u65c5\u3067\u306f\u6bce\u65e5\u304c\u91cd\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc791\uc5c5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: [HABIT]. \ub2f9\uc2e0\uc758 \uc5ec\ud589\uc5d0\uc11c\ub294 \ub9e4\uc77c\ub9e4\uc77c\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf gefocust op je taak: [HABIT]. Elke dag telt op je reis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoncentruj si\u0119 na swoim zadaniu: [HABIT]. Ka\u017cdy dzie\u0144 w Twojej podr\u00f3\u017cy si\u0119 liczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9m o foco na tua tarefa: [HABIT]. Cada dia conta na tua jornada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u043c \u043d\u0430 \u0441\u0432\u043e\u0435\u0439 \u0437\u0430\u0434\u0430\u0447\u0435: [HABIT]. \u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0432\u0430\u0436\u0435\u043d \u043d\u0430 \u0442\u0432\u043e\u0435\u043c \u043f\u0443\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f6revinize odaklan\u0131n: [HABIT]. Yolculu\u011funuzun her g\u00fcn\u00fc \u00f6nemlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e13\u6ce8\u4e8e\u4f60\u7684\u4efb\u52a1\uff1a[HABIT]\u3002\u4f60\u65c5\u7a0b\u4e2d\u7684\u6bcf\u4e00\u5929\u90fd\u81f3\u5173\u91cd\u8981\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c08\u6ce8\u65bc\u4f60\u7684\u4efb\u52d9\uff1a[\u7fd2\u6163]\u3002\u6bcf\u4e00\u5929\u90fd\u5c0d\u60a8\u7684\u65c5\u7a0b\u81f3\u95dc\u91cd\u8981\u3002"
          }
        }
      }
    },
    "pfad_gesperrt_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufe diese Pflanze, um ihren Pfad freizuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy this plant to unlock its path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra esta planta para desbloquear su camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ach\u00e8te cette plante pour d\u00e9bloquer son chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0915\u093e \u0930\u093e\u0938\u094d\u0924\u093e \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u094c\u0927\u0947 \u0915\u094b \u0916\u0930\u0940\u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra questa pianta per sbloccare il suo percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u690d\u7269\u3092\u8cfc\u5165\u3057\u3066\u3001\u305d\u306e\u9053\u3092\u30ed\u30c3\u30af\u89e3\u9664\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc2dd\ubb3c\uc744 \uad6c\uc785\ud558\uc5ec \uacbd\ub85c\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koop deze plant om het pad te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kup t\u0119 ro\u015blin\u0119, aby odblokowa\u0107 jej \u015bcie\u017ck\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra esta planta para desbloquear o seu caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0443\u043f\u0438 \u044d\u0442\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u043f\u0443\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolunu a\u00e7mak i\u00e7in bu bitkiyi sat\u0131n al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d2d\u4e70\u6b64\u690d\u7269\u4ee5\u89e3\u9501\u5176\u8def\u5f84\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cfc\u8cb7\u8a72\u690d\u7269\u4ee5\u89e3\u9396\u5176\u9053\u8def\u3002"
          }
        }
      }
    },
    "pfad_gesperrt_titel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pflanze im Shop kaufen"
          }
        },
        "en": {

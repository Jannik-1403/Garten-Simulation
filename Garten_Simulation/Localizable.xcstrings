    "pfad_schwierigkeit_anfaenger_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal für Einsteiger. Kleine, einfache Schritte führen dich entspannt zum Erfolg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal for beginners. Small, simple steps lead you to success in a relaxed way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal para principiantes. Pasos pequeños y sencillos te llevan al éxito de forma relajada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idéal pour les débutants. De petites étapes simples te mènent au succès en toute sérénité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआती लोगों के लिए आदर्श. छोटे, सरल कदम आपको आराम से सफलता की ओर ले जाएंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideale per i principianti. Piccoli e semplici passi ti guidano verso il successo in totale relax."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初心者に最適です。小さくてシンプルなステップが、リラックスした方法であなたを成功に導きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초보자에게 이상적입니다. 작고 간단한 단계를 통해 편안한 방식으로 성공을 거둘 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideaal voor beginners. Kleine, eenvoudige stappen leiden je op een ontspannen manier naar succes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idealny dla początkujących. Małe, proste kroki prowadzą do sukcesu w zrelaksowany sposób."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal para iniciantes. Passos pequenos e simples levam-te ao sucesso de forma descontraída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеально для начинающих. Маленькие, простые шаги приведут тебя к успеху спокойно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni başlayanlar için idealdir. Küçük, basit adımlar sizi rahat bir şekilde başarıya götürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常适合初学者。简单的小步骤将轻松引导你走向成功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常適合初學者。小而簡單的步驟將引導您以輕鬆的方式走向成功。"
          }
        }
      }
    },

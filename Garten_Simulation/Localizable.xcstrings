    "prog_noalcohol_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Energie. Anstatt den halben Samstag im Bett zu liegen, mach etwas Produktives oder Sport."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the energy. Instead of lying in bed for half of Saturday, do something productive or exercise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la energía. En lugar de permanecer en la cama la mitad del sábado, haga algo productivo o haga ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'énergie. Au lieu de rester au lit pendant la moitié du samedi, faites quelque chose de productif ou faites de l'exercice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊर्जा का उपयोग करें. शनिवार की आधी रात बिस्तर पर पड़े रहने के बजाय, कुछ उत्पादक कार्य करें या व्यायाम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'energia. Invece di restare a letto per metà sabato, fai qualcosa di produttivo o fai esercizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギーを使いましょう。土曜日の半分はベッドで横になる代わりに、何か生産的なことや運動をしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지를 사용하십시오. 토요일의 절반 동안 침대에 누워 있는 대신 생산적인 일을 하거나 운동을 하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de energie. In plaats van de halve zaterdag in bed te liggen, doe iets productiefs of sport."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystaj energię. Zamiast leżeć w łóżku przez połowę soboty, zajmij się czymś produktywnym lub ćwicz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a energia. Em vez de ficar deitado na cama metade do sábado, faça algo produtivo ou faça exercícios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a energia. Em vez de ficar deitado na cama metade do sábado, faça algo produtivo ou faça exercícios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте энергию. Вместо того, чтобы лежать в постели половину субботы, займитесь чем-нибудь продуктивным или займитесь спортом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enerjiyi kullanın. Cumartesi gününün yarısını yatakta geçirmek yerine üretken bir şeyler yapın veya egzersiz yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用能量。周六不要躺在床上半天，而是做一些富有成效的事情或锻炼身体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用能量。週六不要躺在床上半天，而是做一些有生產力的事情或運動。"
          }
        }
      }
    },

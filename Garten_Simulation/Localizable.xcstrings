          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik druk drie keer op snooze en dwing mezelf op het laatste moment in paniek uit bed te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzykrotnie naciskam przycisk drzemki i w ostatniej chwili w panice zrywam się z łóżka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

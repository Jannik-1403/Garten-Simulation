        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы справились с заражением сорняками. За часы%2$dвы получите%1$@XP за отливку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "onboarding_fertig_blase" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Garten ist bereit! Viel Erfolg beim Wachsen deiner neuen Gewohnheiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your garden is ready! Good luck growing your new habits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Tu jardín está listo! Buena suerte cultivando tus nuevos hábitos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton jardin est prêt ! Bonne chance pour faire grandir tes nouvelles habitudes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका बगीचा तैयार है! आपकी नई आदतें विकसित करने के लिए शुभकामनाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your garden is ready! Good luck growing your new habits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの庭の準備は完了です！新しい習慣を身につけて頑張ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 정원이 준비되었습니다! 새로운 습관을 키우는 데 행운을 빕니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw tuin is klaar! Veel succes met het ontwikkelen van je nieuwe gewoontes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój ogród jest gotowy! Powodzenia w rozwijaniu nowych nawyków."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu jardim está pronto! Boa sorte a cultivar os teus novos hábitos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой сад готов! Удачи в выращивании твоих новых привычек."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahçeniz hazır! Yeni alışkanlıklarınızı geliştirmede iyi şanslar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的花园已准备就绪！祝你的新习惯茁壮成长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的花園準備好了！祝你養成新習慣好運。"
          }
        }
      }
    },

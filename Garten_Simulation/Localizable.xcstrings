    "plant.weizenfeld.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite hochkonzentriert und ohne Ablenkungen an deinen Zielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work highly concentrated and without distractions on your goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja altamente concentrado y sin distracciones en tus metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez de manière très concentrée et sans distractions sur vos objectifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लक्ष्यों पर पूरी एकाग्रता और बिना किसी विचलन के काम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavora molto concentrato e senza distrazioni sui tuoi obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標に向かって、気を散らさずに集中して取り組みましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주의가 산만해지지 않고 고도로 집중하여 목표를 향해 일하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk zeer geconcentreerd en zonder afleidingen aan je doelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuj w dużym skupieniu i bez rozpraszaczy nad swoimi celami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhe altamente concentrado e sem distrações em seus objetivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhe altamente concentrado e sem distrações em seus objetivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работай с высокой концентрацией и без отвлечений над своими целями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerinize odaklanın ve dikkatiniz dağılmadan çalışın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度专注，不受干扰地为你的目标努力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高度集中精力、心無旁騖地實現您的目標。"
          }
        }
      }
    },

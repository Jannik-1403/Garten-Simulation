    "habit.fruit_veg.tip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Füge deiner nächsten Mahlzeit eine Handvoll Beeren, einen Apfel oder Gemüsesticks als Snack hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Add a handful of berries, an apple, or veggie sticks as a snack to your next meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Añade un puñado de bayas, una manzana o palitos de verdura como aperitivo a tu próxima comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Ajoutez une poignée de baies, une pomme ou des bâtonnets de légumes comme collation à votre prochain repas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: अपने अगले भोजन में नाश्ते के रूप में एक मुट्ठी जामुन, एक सेब या वेजी स्टिक्स शामिल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Aggiungi una manciata di frutti di bosco, una mela o bastoncini di verdura come spuntino al tuo prossimo pasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：次の食事のおやつとして、ベリーを一掴み、リンゴ、または野菜スティックを追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 다음 식사에 베리 한 줌, 사과, 또는 채소 스틱을 간식으로 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Voeg een handje bessen, een appel of groentesticks toe als snack bij je volgende maaltijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Dodaj garść jagód, jabłko lub słupki warzywne jako przekąskę do następnego posiłku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Adicione um punhado de frutas vermelhas, uma maçã ou palitos de vegetais como lanche na sua próxima refeição."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Adicione um punhado de frutas vermelhas, uma maçã ou palitos de vegetais como lanche na sua próxima refeição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: Добавьте горсть ягод, яблоко или овощные палочки в качестве перекуса к следующему приему пищи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Bir sonraki öğününüze atıştırmalık olarak bir avuç orman meyvesi, bir elma veya sebze çubukları ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在您的下一餐中加入一把浆果、一个苹果或蔬菜条作为零食。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：在您的下一餐中加入一把漿果、一個蘋果或蔬菜條作為零食。"
          }
        }
      }
    },

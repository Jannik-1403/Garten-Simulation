    "goal.link.info.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewohnheiten bringen Punkte für dein 5-Jahresziel.\n\n20 Pkt: Enormer Fokus\n5 Pkt: Leichter Beitrag\n0 Pkt: Hat nichts mit dem Ziel zu tun"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Habits earn points for your 5-Year Goal.\n\n20 Pts: Massive Focus\n5 Pts: Light Contribution\n0 Pts: Unrelated to goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hábitos suman puntos para tu objetivo a 5 años.\n\n20 Pts: Enfoque masivo\n5 Pts: Contribución ligera\n0 Pts: No relacionado con el objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les habitudes rapportent des points pour votre objectif à 5 ans.\n\n20 Pts : Focus massif\n5 Pts : Légère contribution\n0 Pts : Sans rapport avec l'objectif"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आदतें आपके 5-वर्षीय लक्ष्य के लिए अंक अर्जित करती हैं।\n\n20 अंक: जबरदस्त फोकस\n5 अंक: हल्का योगदान\n0 पीटी: लक्ष्य से कोई लेना-देना नहीं है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abitudini guadagnano punti per il tuo obiettivo a 5 anni.\n\n20 Pti: Focus enorme\n5 Pti: Contributo leggero\n0 Pti: Non correlato all'obiettivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣は5年間の目標に向けてポイントを獲得します。\n\n20 Pt: 絶大な集中\n5 Pt: わずかな貢献\n0 Pt: 目標とは無関係"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관은 5년 목표에 대한 포인트를 획득합니다.\n\n20 Pt: 엄청난 집중\n5 Pt: 가벼운 기여\n0 Pt: 목표와 무관함"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewoonten verdienen punten voor uw vijfjarige doel.\n\n20 punten: enorme focus\n5 punten: Lichtbijdrage\n0 pt: Heeft niets met het doel te maken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawyki zdobywają punkty do osiągnięcia Twojego 5-letniego celu.\n\n20 punktów: Znakomita koncentracja\n5 punktów: Lekki wkład\n0 pkt: Nie ma nic wspólnego z celem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hábitos ganham pontos para sua meta de 5 anos.\n\n20 pontos: Foco tremendo\n5 pontos: Contribuição leve\n0 pt: Não tem nada a ver com o objetivo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hábitos ganham pontos para sua meta de 5 anos.\n\n20 pontos: Foco tremendo\n5 pontos: Contribuição leve\n0 pt: Não tem nada a ver com o objetivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычки приносят баллы для вашей цели на 5 лет.\n\n20 б.: Огромный фокус\n5 б.: Легкий вклад\n0 б.: Не связано с целью"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıklar 5 yıllık hedefinize yönelik puan kazandırır.\n\n20 puan: Muazzam odaklanma\n5 puan: Işık katkısı\n0 puan: Hedefle ilgisi yok"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯会为您赢得 5 年目标的积分。\n\n20 分：巨大专注\n5 分：轻微贡献\n0 分：与目标无关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣會為您贏得 5 年目標的積分。\n\n20 分：巨大專注\n5 分：輕微貢獻\n0 分：與目標無關"
          }
        }
      }
    },

    "prog_nutrition_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integriere heute zwingend etwas Grünes (Spinat, Brokkoli, Gurke, Salat) in eine deiner Mahlzeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be sure to include something green (spinach, broccoli, cucumber, lettuce) in one of your meals today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de incluir algo verde (espinacas, brócoli, pepino, lechuga) en una de tus comidas de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous d'inclure quelque chose de vert (épinards, brocoli, concombre, laitue) dans l'un de vos repas aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज अपने भोजन में कुछ हरा (पालक, ब्रोकोली, ककड़ी, सलाद) अवश्य शामिल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati di includere qualcosa di verde (spinaci, broccoli, cetrioli, lattuga) in uno dei tuoi pasti oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の食事には、必ず緑のもの（ほうれん草、ブロッコリー、キュウリ、レタス）を取り入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 식사에는 녹색 음식(시금치, 브로콜리, 오이, 양상추)을 꼭 포함하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat je vandaag iets groens (spinazie, broccoli, komkommer, sla) in je maaltijden opneemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj, aby do jednego z dzisiejszych posiłków włączyć coś zielonego (szpinak, brokuły, ogórek, sałata)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de incluir algo verde (espinafre, brócolis, pepino, alface) em uma de suas refeições hoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de incluir algo verde (espinafre, brócolis, pepino, alface) em uma de suas refeições hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обязательно включите сегодня в один из приемов пищи что-нибудь зеленое (шпинат, брокколи, огурец, салат)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün öğünlerinizden birine yeşil bir şeyler (ıspanak, brokoli, salatalık, marul) eklemeyi unutmayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请务必在今天的一顿饭中加入一些绿色食品（菠菜、西兰花、黄瓜、生菜）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請務必在今天的一餐中加入一些綠色食品（菠菜、綠花椰菜、黃瓜、生菜）。"
          }
        }
      }
    },

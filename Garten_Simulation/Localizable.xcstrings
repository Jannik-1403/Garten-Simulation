    "cleaning.empty.explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Aufgaben wie „Bett abziehen“ mit eigenem Rhythmus an. Die Gewohnheit ist dann nur an Tagen fällig, an denen etwas ansteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create tasks like \"Change bed sheets\" with their own rhythm. The habit is then only due on days when something is scheduled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tareas como \"Cambiar sábanas\" con su propio ritmo. El hábito solo vence en los días programados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des tâches comme « Changer les draps » avec leur propre rythme. L'habitude n'est due que les jours programmés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"बिस्तर की चादर बदलें\" जैसे कार्य अपनी लय के साथ बनाएं। आदत केवल उन दिनों पर देय होती है जब कुछ निर्धारित होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea attività come \"Cambia le lenzuola\" con il proprio ritmo. L'abitudine è dovuta solo nei giorni programmati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ベッドのシーツを替える」などのタスクを独自のリズムで作成します。この習慣は、予定がある日にのみ期限を迎えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"침대 시트 교체\"와 같은 작업을 자신만의 리듬으로 만드세요. 습관은 예정된 날에만 마감됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak taken zoals \"Bed verschonen\" met hun eigen ritme. De gewoonte is dan alleen verschuldigd op dagen dat er iets gepland is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz zadania takie jak \"Zmiana pościeli\" z własnym rytmem. Nawyk jest wymagalny tylko w zaplanowane dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie tarefas como \"Trocar lençóis\" com seu próprio ritmo. O hábito só é devido em dias programados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie tarefas como \"Trocar lençóis\" com seu próprio ritmo. O hábito só é devido em dias programados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте задачи, например, «Поменять постельное белье», в своем ритме. Привычка должна быть выполнена только в запланированные дни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Çarşafları değiştir\" gibi görevleri kendi ritimleriyle oluşturun. Alışkanlık yalnızca planlanan günlerde yapılmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以自己的节奏创建诸如“换床单”之类的任务。该习惯仅在有安排的日子到期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以自己的節奏創建諸如“換床單”之類的任務。該習慣僅在有安排的日子到期。"
          }
        }
      }
    },

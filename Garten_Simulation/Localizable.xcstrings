    "plant.lotus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blüht im Schlamm – Ruhe trotz Stress"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blooms in mud – peace despite stress"
          }
        },

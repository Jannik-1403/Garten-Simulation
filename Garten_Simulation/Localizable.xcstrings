    "routine.strict_mode.blocked.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können den strikten Modus erst verlassen, wenn die Routine abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot exit strict mode until the routine is complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede salir del modo estricto hasta que se complete la rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas quitter le mode strict tant que la routine n'est pas terminée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक दिनचर्या पूरी नहीं हो जाती, आप सख्त मोड से बाहर नहीं निकल सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile uscire dalla modalità rigorosa fino al completamento della routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーチンが完了するまで、厳密モードを終了することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴이 완료될 때까지 엄격 모드를 종료할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt de strikte modus pas verlaten als de routine is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wyjść z trybu ścisłego, dopóki procedura nie zostanie ukończona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode sair do modo estrito até que a rotina seja concluída."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode sair do modo estrito até que a rotina seja concluída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не можете выйти из строгого режима, пока процедура не будет завершена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutin tamamlanana kadar katı moddan çıkamazsınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在例程完成之前，您无法退出严格模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在例程完成之前，您無法退出嚴格模式。"
          }
        }
      }
    },

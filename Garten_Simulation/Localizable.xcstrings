    "notification.evening.1.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch %d %@! Komm vorbei, bevor der Tag endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still have %d %@! Stop by before the day ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Aún tienes %d %@! Pasa por aquí antes de que acabe el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as encore %d %@ ! Viens avant la fin de la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ancora %d %@! Passa prima che finisca la giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ %d %@ が残っています!一日が終わる前にお立ち寄りください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 %d%@이 있습니다! 하루가 끝나기 전에 들러보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog steeds %d %@! Kom langs voordat de dag voorbij is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal masz %d %@! Zatrzymaj się, zanim dzień się skończy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda tens %d %@! Aparece antes que o dia acabe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hala %d %@'ınız var! Gün bitmeden uğrayın."
          }
        }
      }
    },
    "notification.evening.1.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten wartet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is waiting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jardín te espera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton jardin t'attend"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino ti aspetta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの庭が待っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 정원이 기다리고 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tuin wacht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ogród czeka"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu jardim espera por ti"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz sizi bekliyor"
          }
        }
      }
    },
    "notification.evening.2.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht auf deine Pflanzen! %d %@ braucht heute noch Wasser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget your plants! %d %@ still needs water today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No olvides tus plantas! %d %@ todavía necesita agua hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oublie pas tes plantes ! %d %@ a encore besoin d'eau aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare le tue piante! %d %@ ha ancora bisogno d'acqua oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物も忘れずに！ %d %@ は今日も水が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 식물을 잊지 마세요! %d %@ 오늘도 여전히 물이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet je planten niet! %d %@ heeft vandaag nog steeds water nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapomnij o swoich roślinach! %d %@ nadal dzisiaj potrzebuje wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não te esqueças das tuas plantas! %d %@ ainda precisa de água hoje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkilerinizi unutmayın! %d %@ bugün hâlâ suya ihtiyaç duyuyor."
          }
        }
      }
    },
    "notification.evening.2.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein letzter Blick?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One last look?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Un último vistazo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dernier coup d'œil ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'ultima occhiata?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後にもう一度見てみましょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 살펴볼까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog een laatste blik?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie spojrzenie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um último olhar?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir bakış mı?"
          }
        }
      }
    },
    "notification.evening.3.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abend bricht an... und %d %@ rufen nach dir!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening falls... and %d %@ are calling for you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cae la noche... ¡y %d %@ te están llamando!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir tombe... et %d %@ t'appellent !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scende la sera... e %d %@ ti chiamano!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕方になります...そして %d %@ があなたを呼んでいます!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁이 되니... %d %@이(가) 당신을 부르고 있습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De avond valt... en %d %@ roept je!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapada wieczór... i %d %@ wzywa Cię!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A noite cai... e %d %@ chamam por ti!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam düşüyor... ve %d %@ sizi çağırıyor!"
          }
        }
      }
    },

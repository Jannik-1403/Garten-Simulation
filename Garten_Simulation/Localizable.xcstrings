    "prog_wakeup_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache sofort nach dem Aufstehen das Licht an oder öffne die Vorhänge. Helles Licht stoppt die Melatonin-Produktion schlagartig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the lights or open the curtains as soon as you get up. Bright light suddenly stops melatonin production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende las luces o abre las cortinas nada más levantarte. La luz brillante detiene repentinamente la producción de melatonina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez les lumières ou ouvrez les rideaux dès que vous vous levez. Une lumière vive arrête soudainement la production de mélatonine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही आप उठें, लाइटें जला दें या पर्दे खोल दें। तेज रोशनी अचानक मेलाटोनिन उत्पादन बंद कर देती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accendi le luci o apri le tende non appena ti alzi. La luce intensa interrompe improvvisamente la produzione di melatonina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きたらすぐに照明をつけるか、カーテンを開けてください。明るい光はメラトニンの生成を突然停止させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나자마자 불을 켜거나 커튼을 열어주세요. 밝은 빛이 갑자기 멜라토닌 생산을 중단합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe de lichten aan of open de gordijnen zodra je opstaat. Fel licht stopt plotseling de aanmaak van melatonine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz światło lub odsuń zasłony zaraz po wstaniu. Jasne światło nagle zatrzymuje produkcję melatoniny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acenda as luzes ou abra as cortinas assim que se levantar. A luz brilhante interrompe repentinamente a produção de melatonina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acenda as luzes ou abra as cortinas assim que se levantar. A luz brilhante interrompe repentinamente a produção de melatonina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите свет или откройте шторы, как только встанете. Яркий свет внезапно останавливает выработку мелатонина."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanır uyanmaz ışıkları açın veya perdeleri açın. Parlak ışık aniden melatonin üretimini durdurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床后立即打开灯或打开窗帘。强光突然停止褪黑激素的产生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起床後立即打開燈或打開窗簾。強光突然停止褪黑激素的產生。"
          }
        }
      }
    },

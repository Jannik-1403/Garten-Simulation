    "fitness.cleaning.detail.critical": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um immer sauber zu sein und dich frisch zu fühlen, musst du heute unbedingt aufräumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To always be clean and feel fresh, you absolutely must clean up today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para estar siempre limpio y sentirte fresco, hoy tienes que limpiar sin falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour être toujours propre et te sentir frais, tu dois absolument ranger aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा साफ रहने और तरोताजा महसूस करने के लिए, आपको आज जरूर सफाई करनी चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per essere sempre pulito e sentirti fresco, oggi devi assolutamente riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に清潔で新鮮な気分でいるために、今日は絶対に片付ける必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 깨끗하고 상쾌한 기분을 느끼려면, 오늘은 꼭 정리해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om altijd schoon te zijn en je fris te voelen, moet je vandaag echt opruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zawsze być czystym i czuć się świeżo, musisz dzisiaj koniecznie posprzątać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para estar sempre limpo e sentir-te fresco, hoje tens mesmo de arrumar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para estar sempre limpo e se sentir fresco, você precisa muito arrumar hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы всегда быть в чистоте и чувствовать себя свежо, сегодня обязательно нужно убраться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman temiz olmak ve taze hissetmek için bugün mutlaka ortalığı toplamalısın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了始终保持干净清爽，你今天必须打扫卫生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了始終保持乾淨清爽，你今天必須打掃衛生。"
          }
        }
      }
    },
    "fitness.cleaning.detail.good": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Toll, du hast heute schon alle fälligen Aufgaben erledigt!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great, you've already completed all due tasks today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Genial, ya has completado todas las tareas de hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super, tu as déjà terminé toutes les tâches du jour !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत बढ़िया, आपने आज के सभी काम पूरे कर लिए हैं!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo, hai già completato tutti i compiti di oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素晴らしい！今日のタスクをすべて完了しました！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘했어요! 오늘의 과제를 모두 완료했습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig, je hebt alle taken van vandaag al voltooid!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świetnie, wykonałeś już wszystkie dzisiejsze zadania!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo, já completaste todas as tarefas de hoje!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo, você já concluiu todas as tarefas de hoje!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично, вы уже выполнили все задачи на сегодня!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika, bugünkü tüm görevleri zaten tamamladın!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了，你今天已经完成了所有任务！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了，你今天已經完成了所有任務！"
          }
        }
      }
    },

    "stats.empty.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte deine erste Fokus-Session, um Statistiken zu sehen."
          }

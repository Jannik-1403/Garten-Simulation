    "assessment.mental.profile.getriebener.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist reaktiv statt proaktiv. Lerne, Fokus zu etablieren und Prioritäten zu setzen, anstatt nur Feuer zu löschen."
          }

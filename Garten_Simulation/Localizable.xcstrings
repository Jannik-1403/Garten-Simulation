        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc591\ud55c \uc815\uc6d0 \uc601\uc5ed\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4."

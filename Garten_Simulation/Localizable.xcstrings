    "plant.kirschbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir bewusst Zeit für dich selbst und dein Wohlbefinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consciously take time for yourself and your well-being."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate el tiempo conscientemente para ti y tu bienestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez consciemment du temps pour vous et votre bien-être."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लिए और अपनी भलाई के लिए जानबूझकर समय निकालें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi consapevolmente del tempo per te stesso e per il tuo benessere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意識的に自分の時間と幸福のために時間を取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의식적으로 자신과 웰빙을 위한 시간을 가지세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem bewust tijd voor jezelf en je welzijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świadomie poświęć czas dla siebie i swojego dobrego samopoczucia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedique conscientemente um tempo para si e para o seu bem-estar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedique conscientemente um tempo para si e para o seu bem-estar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяйте осознанно время для себя и своего благополучия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinçli olarak kendinize ve refahınıza zaman ayırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有意识地为自己和幸福留出时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有意識地為自己和自己的幸福花點時間。"
          }
        }
      }
    },
    "plant.klee.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleines Glück, täglich gefunden – Dankbarkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small luck, found daily – Gratitude"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeña suerte, encontrada cada día – Gratitud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petite chance, trouvée chaque jour – Gratitude"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी खुशियाँ, रोज़ पाई जाने वाली – आभार"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccola felicità trovata ogni giorno: gratitudine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日見つかる小さな幸運 – 感謝"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 발견되는 작은 행운 – 감사"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein geluk, dagelijks gevonden – Dankbaarheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Małe szczęście, które można znaleźć codziennie – Wdzięczność"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequena sorte, encontrada todos os dias – Gratidão"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequena sorte, encontrada todos os dias – Gratidão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Малое счастье, найденное ежедневно — благодарность"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün bulunan küçük şans – Şükran"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小小的幸福，每天都能找到 – 感恩"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天發現的小幸福－感恩"
          }
        }
      }
    },

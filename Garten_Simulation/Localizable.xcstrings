        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0447\u043d\u0438 \u0441\u0432\u043e\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u0435\u0441\u0441\u0438\u044e \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u043e\u0432\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443."

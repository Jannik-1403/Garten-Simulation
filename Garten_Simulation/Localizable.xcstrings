    "prog_gratitude_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere heute Dinge, die absolut alltäglich sind, die du aber oft für selbstverständlich hältst (z.B. fließend warmes Wasser)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, write down things that are absolutely everyday but that you often take for granted (e.g. warm running water)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, anota cosas que son absolutamente cotidianas pero que a menudo das por sentado (por ejemplo, agua corriente tibia)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, notez des choses qui sont absolument quotidiennes mais que vous considérez souvent comme allant de soi (par exemple l’eau chaude courante)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज, उन चीज़ों को लिखें जो बिल्कुल रोज़मर्रा की हैं लेकिन जिन्हें आप अक्सर हल्के में लेते हैं (उदाहरण के लिए गर्म बहता पानी)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi scrivi cose che sono assolutamente quotidiane ma che spesso dai per scontate (ad esempio l'acqua corrente calda)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は、まったく日常的なことですが、当たり前のことだと思っていること (例: 暖かい流水) を書き留めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 절대적으로 일상적이지만 종종 당연하게 여기는 것들(예: 흐르는 따뜻한 물)을 적어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf vandaag dingen op die absoluut alledaags zijn, maar die u vaak als vanzelfsprekend beschouwt (bijvoorbeeld warm stromend water)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś zapisz rzeczy, które są absolutnie codzienne, ale często bierzesz za oczywistość (np. ciepła bieżąca woda)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, anote coisas que são absolutamente cotidianas, mas que você muitas vezes dá como certas (por exemplo, água morna corrente)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, anote coisas que são absolutamente cotidianas, mas que você muitas vezes dá como certas (por exemplo, água morna corrente)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня запишите вещи, которые абсолютно повседневны, но которые вы часто воспринимаете как должное (например, теплая проточная вода)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün, kesinlikle gündelik olan ancak çoğu zaman hafife aldığınız şeyleri yazın (örneğin, akan sıcak su)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，写下那些绝对日常但您经常认为理所当然的事情（例如温暖的自来水）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，寫下那些絕對日常但您經常認為理所當然的事情（例如溫暖的自來水）。"
          }
        }
      }
    },

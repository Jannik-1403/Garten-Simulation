    "prog_wakeup_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, auch am Wochenende maximal 30-60 Minuten von deiner unter der Woche gewohnten Aufstehzeit abzuweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try to deviate from your usual get-up time during the week by a maximum of 30-60 minutes, even on the weekend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intente desviarse de su hora habitual de levantarse durante la semana entre 30 y 60 minutos como máximo, incluso los fines de semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de vous écarter de votre heure de lever habituelle pendant la semaine d'un maximum de 30 à 60 minutes, même le week-end."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह के दौरान अपने सामान्य उठने के समय से अधिकतम 30-60 मिनट का विचलन करने का प्रयास करें, यहाँ तक कि सप्ताहांत पर भी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca di deviare dal tuo orario abituale durante la settimana di un massimo di 30-60 minuti, anche nel fine settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末であっても、平日は通常の起床時間を最大 30 ～ 60 分ずらすようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말에도 주중에는 평소 기상 시간에서 최대 30~60분 정도 벗어나도록 노력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer doordeweeks maximaal 30-60 minuten af ​​te wijken van uw gebruikelijke opstatijd, ook in het weekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj odejść od zwykłej godziny wstawania w ciągu tygodnia o maksymalnie 30–60 minut, nawet w weekendy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente desviar-se do seu horário habitual de levantar durante a semana em no máximo 30-60 minutos, mesmo no fim de semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente desviar-se do seu horário habitual de levantar durante a semana em no máximo 30-60 minutos, mesmo no fim de semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старайтесь отклоняться от обычного времени подъема в течение недели максимум на 30–60 минут, даже в выходные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta içi her zamanki kalkma saatinizden, hatta hafta sonu bile maksimum 30-60 dakika sapmaya çalışın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试将一周中通常的起床时间最多偏离 30-60 分钟，即使在周末也是如此。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試著將一週中通常的起床時間偏離高達 30-60 分鐘，即使在週末也是如此。"
          }
        }
      }
    },

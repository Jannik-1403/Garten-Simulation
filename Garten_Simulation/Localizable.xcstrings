    "screenTime.adultFilter.desc1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert nicht jugendfreie Inhalte in Safari. Um Umgehungen zu verhindern, sperrt dieser Modus außerdem komplett:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks adult content in Safari. To prevent workarounds, this mode also completely locks:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea contenido para adultos en Safari. Para evitar elusiones, este modo también bloquea por completo:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque le contenu pour adultes dans Safari. Pour empêcher les contournements, ce mode verrouille également complètement :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari में वयस्क सामग्री को ब्लॉक करता है। वर्कअराउंड को रोकने के लिए, यह मोड पूरी तरह से लॉक कर देता है:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca i contenuti per adulti in Safari. Per evitare scappatoie, questa modalità blocca completamente anche:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariでアダルトコンテンツをブロックします。回避を防ぐため、このモードでは以下も完全にロックされます:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 성인 콘텐츠를 차단합니다. 우회를 방지하기 위해 이 모드는 다음도 완전히 잠급니다:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeert inhoud voor volwassenen in Safari. Om omzeilingen te voorkomen, vergrendelt deze modus ook volledig:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje treści dla dorosłych w Safari. Aby zapobiec obejściom, ten tryb również całkowicie blokuje:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia conteúdo para adultos no Safari. Para evitar contornos, este modo também bloqueia completamente:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia conteúdo para adultos no Safari. Para evitar contornos, este modo também bloqueia completamente:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует контент для взрослых в Safari. Чтобы предотвратить обход, этот режим также полностью блокирует:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari'de yetişkinlere yönelik içeriği engeller. Geçici çözümleri önlemek için bu mod şunları da tamamen kilitler:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中阻止成人内容。为防止绕过，此模式还会完全锁定："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中封鎖成人內容。為了防止繞過，此模式還會完全鎖定："
          }
        }
      }
    },
    "screenTime.adultFilter.desc2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit der Filter nicht ausgetrickst werden kann, wird gleichzeitig der Schutzmodus aktiviert. Dieser sperrt den App Store (verhindert VPN- & Browser-Downloads) und blockiert das Löschen dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To prevent circumvention, Strict Protection is activated simultaneously. This locks the App Store (preventing VPN & browser downloads) and blocks app deletion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar la elusión, se activa la Protección estricta simultáneamente. Esto bloquea la App Store y bloquea la eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter tout contournement, la protection stricte est activée simultanément. Cela verrouille l'App Store (empêchant les téléchargements de VPN) et bloque la suppression."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सुनिश्चित करने के लिए कि फ़िल्टर को धोखा नहीं दिया जा सकता है, सुरक्षा मोड उसी समय सक्रिय होता है। यह ऐप स्टोर को ब्लॉक कर देता है (वीपीएन और ब्राउज़र डाउनलोड को रोकता है) और इस ऐप को डिलीट होने से रोकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per evitare l'aggiramento, la Protezione severa viene attivata simultaneamente. Questo blocca l'App Store e l'eliminazione dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターがだまされないように、保護モードも同時に有効になります。これにより、App Store がブロックされ (VPN とブラウザのダウンロードが防止され)、このアプリの削除がブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터가 속일 수 없도록 보호 모드가 동시에 활성화됩니다. 이렇게 하면 App Store가 차단되고(VPN 및 브라우저 다운로드가 차단됨) 이 앱이 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om ervoor te zorgen dat het filter niet kan worden misleid, wordt tegelijkertijd de beveiligingsmodus geactiveerd. Dit blokkeert de App Store (voorkomt VPN- en browserdownloads) en blokkeert dat deze app wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zapobiec oszukaniu filtra, włącza się jednocześnie tryb ochrony. Spowoduje to zablokowanie App Store (zapobiega pobieraniu VPN i przeglądarki) oraz blokuje usunięcie tej aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para garantir que o filtro não possa ser enganado, o modo de proteção é ativado ao mesmo tempo. Isso bloqueia a App Store (impede downloads de VPN e do navegador) e impede que este aplicativo seja excluído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para garantir que o filtro não possa ser enganado, o modo de proteção é ativado ao mesmo tempo. Isso bloqueia a App Store (impede downloads de VPN e do navegador) e impede que este aplicativo seja excluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы фильтр невозможно было обмануть, одновременно активируется режим защиты. Это блокирует App Store (предотвращает загрузку VPN и браузера) и предотвращает удаление этого приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrenin aldatılmamasını sağlamak için aynı anda koruma modu da etkinleştirilir. Bu, App Store'u engeller (VPN ve tarayıcı indirmelerini engeller) ve bu uygulamanın silinmesini engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了确保过滤器不被欺骗，同时激活保护模式。这会阻止 App Store（阻止 VPN 和浏览器下载）并阻止删除该应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了確保過濾器不被欺騙，同時啟動保護模式。這會阻止 App Store（阻止 VPN 和瀏覽器下載）並阻止刪除該應用程式。"
          }
        }
      }
    },

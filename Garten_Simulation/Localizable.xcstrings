    "dopamine_story_s1_source": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prinzip-Grafik nach Berridge & Robinson (Wollen ≠ Mögen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Principle chart based on Berridge & Robinson (Wanting ≠ Liking)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gráfico conceptual según Berridge & Robinson (Querer ≠ Gustar)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphique de principe d'après Berridge & Robinson (Vouloir ≠ Aimer)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Berridge & Robinson पर आधारित सिद्धांत चार्ट (चाहना ≠ पसंद करना)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafico concettuale basato su Berridge & Robinson (Volere ≠ Piacere)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Berridge＆Robinsonに基づく原理図（Wanting ≠ Liking）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Berridge & Robinson을 바탕으로 한 원리 그래프 (원함 ≠ 좋음)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Principe-grafiek volgens Berridge & Robinson (Willen ≠ Leuk vinden)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykres na podstawie Berridge'a i Robinsona (Chcenie ≠ Lubienie)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gráfico conceptual segundo Berridge & Robinson (Querer ≠ Gostar)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gráfico conceitual segundo Berridge & Robinson (Querer ≠ Gostar)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принципиальный график по Берриджу и Робинсону (Желание ≠ Симпатия)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Berridge ve Robinson'a dayalı prensip grafiği (İsteme ≠ Beğenme)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 Berridge & Robinson 的原理图（想要 ≠ 喜欢）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 Berridge & Robinson 的原理圖（想要 ≠ 喜歡）"
          }
        }
      }
    },
    "dopamine_story_s1_sub": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es treibt vor allem das Wollen an – nicht den Genuss. Beides läuft im Gehirn getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It mainly drives wanting – not liking. Both run separately in the brain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalmente impulsa el deseo, no el placer. Ambos ocurren por separado en el cerebro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle stimule principalement l'envie – pas le plaisir. Les deux fonctionnent séparément dans le cerveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मुख्य रूप से चाहने को प्रेरित करता है - पसंद करने को नहीं। दोनों मस्तिष्क में अलग-अलग चलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guida principalmente il volere, non il piacere. Entrambi avvengono separatamente nel cervello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それは主に「欲求」を駆り立てます。「快楽」ではありません。脳内では両者は別々に働きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것은 주로 '즐거움'이 아닌 '원함'을 유도합니다. 두 가지는 뇌에서 분리되어 작용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het drijft vooral het willen aan – niet het genieten. Beide werken gescheiden in de hersenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napędza głównie pragnienie – nie przyjemność. Oba procesy zachodzą w mózgu oddzielnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impulsiona principalmente o desejo – não o prazer. Ambos ocorrem separadamente no cérebro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impulsiona principalmente o desejo – não o prazer. Ambos ocorrem separadamente no cérebro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он в основном стимулирует желание, а не удовольствие. Оба процесса в мозге протекают раздельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esas olarak zevki değil, istemeyi yönlendirir. İkisi beyinde ayrı ayrı çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它主要驱动欲望——而不是享受。两者在大脑中独立运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它主要驅動慾望——而不是享受。兩者在大腦中獨立運作。"
          }
        }
      }
    },
    "dopamine_story_s1_title": {

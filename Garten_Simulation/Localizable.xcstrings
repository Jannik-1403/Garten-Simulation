    "plant.seerose.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wächst im Wasser, ruhig und stark – Schwimmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grows in water, calm and strong – Swimming"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece en el agua, tranquilo y fuerte – Natación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse dans l'eau, calme et fort – Natation"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पानी में बढ़ता है, शांत और मजबूत – तैरना"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grows in water, calm and strong – Swimming"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水の中で育ち、穏やかで力強い - 泳ぐ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물속에서 자라며 조용하고 강함 – 수영"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groeit in water, kalm en sterk – Zwemmend"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rośnie w wodzie, spokojny i silny – Pływa"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce na água, calmo e forte – Natação"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растет в воде, спокойно и сильно – плавание"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suda büyür, sakin ve güçlüdür – Yüzme"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在水中生长，宁静而坚韧 – 游泳"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生長在水中，平靜而堅強——游泳"
          }
        }
      }
    },

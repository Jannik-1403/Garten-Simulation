    "weekly_report.feedback.desc.best_day_focus": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein produktivster Tag für Fokus war %@. Statistisch gesehen bist du an diesem Wochentag besonders leistungsfähig – vielleicht hattest du da am wenigsten Meetings oder eine besonders ruhige Umgebung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your most productive focus day was %@. Statistically, you're particularly high-performing on this weekday – maybe you had the fewest meetings or a particularly quiet environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu día más productivo para el enfoque fue el %@. Estadísticamente, rindes especialmente bien en este día de la semana – quizás tenías menos reuniones o un entorno más tranquilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton jour le plus productif pour la concentration était le %@. Statistiquement, tu es particulièrement performant ce jour de la semaine – peut-être avais-tu moins de réunions ou un environnement particulièrement calme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फोकस के लिए आपका सबसे उत्पादक दिन%@था। सांख्यिकीय रूप से देखा जाए तो आप इस सप्ताह के दिन विशेष रूप से अधिक सक्षम हैं – शायद उस दिन आपके कम से कम मीटिंग्स थे या वहां का माहौल विशेष रूप से शांत था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giorno più produttivo per la concentrazione è stato %@. Statisticamente sei particolarmente performante in questo giorno della settimana – forse avevi meno riunioni o un ambiente particolarmente tranquillo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中力が最も高かった日は%@でした。統計的に見ると、この曜日は特にパフォーマンスが高く、会議が少なかったり環境が静かだったりしたのかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 생산적인 집중 요일은 %@였습니다. 통계적으로 이 요일에 특히 높은 성과를 냅니다 – 아마 회의가 가장 적거나 조용한 환경이었을 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je meest productieve focusdag was %@. Statistisch gezien presteer je op deze weekdag bijzonder goed – misschien had je de minste vergaderingen of een bijzonder rustige omgeving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój najbardziej produktywny dzień skupienia to %@. Statystycznie w ten dzień tygodnia jesteś szczególnie wydajny – może miałeś wtedy najmniej spotkań lub szczególnie spokojne otoczenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

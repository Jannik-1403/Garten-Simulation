    "goal_date_unrealistic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei deinem aktuellen Trend ist es unwahrscheinlich, dass du %1$@ %2$@ bis %3$@ erreichst. Passe dein Zieldatum oder deine täglichen Kalorien an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your current trend, reaching %1$@ %2$@ by %3$@ looks unlikely. Consider adjusting your target date or your daily calories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tu tendencia actual, es poco probable que alcances %1$@ %2$@ antes del %3$@. Considera ajustar tu fecha objetivo o tus calorías diarias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au rythme actuel, atteindre %1$@ %2$@ d'ici le %3$@ semble peu probable. Envisage d'ajuster ta date cible ou tes calories quotidiennes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मौजूदा ट्रेंड के हिसाब से, %3$@ तक %1$@ %2$@ तक पहुँचना मुश्किल लग रहा है। अपनी लक्ष्य तिथि या दैनिक कैलोरी में बदलाव पर विचार करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la tendenza attuale, raggiungere %1$@ %2$@ entro il %3$@ sembra improbabile. Valuta di modificare la data obiettivo o le calorie giornaliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のトレンドでは、%3$@までに%1$@ %2$@に到達するのは難しそうです。目標日または1日の摂取カロリーの見直しをご検討ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 추세대로라면 %3$@까지 %1$@ %2$@에 도달하기 어려울 것 같습니다. 목표 날짜나 하루 섭취 칼로리 조정을 고려해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij je huidige trend is het onwaarschijnlijk dat je %1$@ %2$@ voor %3$@ haalt. Overweeg je streefdatum of je dagelijkse calorieën aan te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy obecnym trendzie osiągnięcie %1$@ %2$@ do %3$@ wygląda na mało prawdopodobne. Rozważ zmianę daty docelowej lub dziennych kalorii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com sua tendência atual, atingir %1$@ %2$@ até %3$@ parece improvável. Considere ajustar sua data meta ou suas calorias diárias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com sua tendência atual, atingir %1$@ %2$@ até %3$@ parece improvável. Considere ajustar sua data meta ou suas calorias diárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При текущем тренде достижение %1$@ %2$@ к %3$@ выглядит маловероятным. Рассмотрите изменение целевой даты или дневной калорийности."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut eğilimine göre, %3$@ tarihine kadar %1$@ %2$@ hedefine ulaşman pek olası görünmüyor. Hedef tarihini veya günlük kalorini gözden geçirmeyi düşün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照目前的趋势,在 %3$@ 前达到 %1$@ %2$@ 的可能性不大。可以考虑调整目标日期或每日热量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按照目前的趨勢,在 %3$@ 前達到 %1$@ %2$@ 的可能性不大。可以考慮調整目標日期或每日熱量。"
          }

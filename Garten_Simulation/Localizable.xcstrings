    "gameover.coinslost.beschreibung": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast alle deine Leben verloren. Zur Strafe wurden all deine Münzen entfernt. Deine Pflanzen bleiben dir aber erhalten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have lost all your lives. As a penalty, all your coins have been removed. However, you will keep your plants!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has perdido todas tus vidas. Como penalización, se han eliminado todas tus monedas. ¡Sin embargo, conservarás tus plantas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez perdu toutes vos vies. En guise de pénalité, toutes vos pièces ont été retirées. Cependant, vous gardez vos plantes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपने सभी जीवन खो दिए हैं। दंड के रूप में, आपके सभी सिक्के हटा दिए गए हैं। हालाँकि, आपके पौधे आपके पास रहेंगे!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai perso tutte le tue vite. Come penalità, tutte le tue monete sono state rimosse. Tuttavia, manterrai le tue piante!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのライフを失いました。ペナルティとして、すべてのコインが没収されました。ただし、植物はそのまま残ります！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 생명을 잃었습니다. 벌칙으로 모든 코인이 제거되었습니다. 하지만 식물은 그대로 유지됩니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al je levens verloren. Als straf zijn al je munten verwijderd. Je planten mag je echter houden!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Straciłeś wszystkie życia. W ramach kary wszystkie twoje monety zostały usunięte. Jednak zatrzymasz swoje rośliny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perdeu todas as suas vidas. Como penalidade, todas as suas moedas foram removidas. No entanto, você manterá suas plantas!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perdeu todas as suas vidas. Como penalidade, todas as suas moedas foram removidas. No entanto, você manterá suas plantas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы потеряли все свои жизни. В качестве штрафа все ваши монеты были удалены. Однако ваши растения останутся с вами!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm canlarını kaybettin. Ceza olarak tüm paraların silindi. Ancak bitkilerin sende kalacak!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你失去了所有的生命。作为惩罚，你所有的硬币都被移除了。不过，你的植物还会保留！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你失去了所有的生命。作為懲罰，你所有的硬幣都被移除了。不過，你的植物還會保留！"
          }
        }
      }
    },

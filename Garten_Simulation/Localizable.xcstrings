            "state": "translated",
            "value": "Beware of Weeds!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Cuidado mit Unkraut!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention aux mauvaises herbes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0938\u0947 \u0938\u093e\u0935\u0927\u093e\u0928 \u0930\u0939\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione alle erbacce!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96d1\u8349\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a1\ucd08\ub97c \uc870\uc2ec\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas op voor onkruid!"
          }
        },
        "pl": {

        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fcrt\u00fcsel olan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51b2\u52a8\u7684\u4eba"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u885d\u52d5\u7684\u90a3\u4e00\u985e"
          }
        }
      }
    },
    "assessment.finance.profile.kontrolleur.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimiere eine laufende Ausgabe oder richte einen automatischen Sparplan ein. Du hast die Disziplin \u2013 nutze sie aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimize a current expense or set up an automatic savings plan. You have the discipline \u2013 use it actively."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimiza un gasto actual o configura un plan de ahorro autom\u00e1tico. Tienes la disciplina: \u00fasala activamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimisez une d\u00e9pense courante ou mettez en place un plan d\u2019\u00e9pargne automatique. Vous avez la discipline \u2013 utilisez-la activement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u094c\u091c\u0942\u0926\u093e \u0935\u094d\u092f\u092f \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0947\u0902 \u092f\u093e \u090f\u0915 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u092c\u091a\u0924 \u092f\u094b\u091c\u0928\u093e \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0905\u0928\u0941\u0936\u093e\u0938\u0928 \u0939\u0948 - \u0907\u0938\u0915\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0942\u092a \u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimizza una spesa corrente o imposta un piano di risparmio automatico. Hai la disciplina: usala attivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u306e\u51fa\u8cbb\u3092\u6700\u9069\u5316\u3059\u308b\u304b\u3001\u81ea\u52d5\u8caf\u84c4\u8a08\u753b\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306b\u306f\u898f\u5f8b\u304c\u3042\u308a\u3001\u305d\u308c\u3092\u7a4d\u6975\u7684\u306b\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc7ac \ube44\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\uac70\ub098 \uc790\ub3d9 \uc800\ucd95 \uacc4\ud68d\uc744 \uc124\uc815\ud558\uc138\uc694. \ub2f9\uc2e0\uc5d0\uac8c\ub294 \uaddc\uc728\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc801\uadf9\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimaliseer een huidige uitgave of stel een automatisch spaarplan op. Je hebt de discipline \u2013 gebruik die actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoptymalizuj bie\u017c\u0105ce wydatki lub skonfiguruj automatyczny plan oszcz\u0119dno\u015bciowy. Masz dyscyplin\u0119 \u2013 korzystaj z niej aktywnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Otimize uma despesa atual ou configure um plano de poupan\u00e7a autom\u00e1tico. Voc\u00ea tem disciplina \u2013 use-a ativamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0439 \u0442\u0435\u043a\u0443\u0449\u0438\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u044b \u0438\u043b\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043b\u0430\u043d \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439. \u0423 \u0442\u0435\u0431\u044f \u0435\u0441\u0442\u044c \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430 \u2013 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0435\u0451 \u0430\u043a\u0442\u0438\u0432\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut bir gideri optimize edin veya otomatik bir tasarruf plan\u0131 olu\u015fturun. Disiplininiz var; onu aktif olarak kullan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f18\u5316\u4e00\u4e2a\u6b63\u5728\u8fdb\u884c\u7684\u652f\u51fa\u6216\u8bbe\u7acb\u4e00\u4e2a\u81ea\u52a8\u50a8\u84c4\u8ba1\u5212\u3002\u4f60\u6709\u81ea\u5f8b\u2014\u2014\u79ef\u6781\u5229\u7528\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u512a\u5316\u76ee\u524d\u652f\u51fa\u6216\u8a2d\u5b9a\u81ea\u52d5\u5132\u84c4\u8a08\u5283\u3002\u4f60\u6709\u7d00\u5f8b\u2014\u2014\u7a4d\u6975\u904b\u7528\u5b83\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.kontrolleur.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisiere 1\uff05 mehr deines Einkommens direkt per Dauerauftrag auf ein Anlagekonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automate 1\uff05 more of your income directly into an investment account via standing order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatice un 1\uff05 m\u00e1s de sus ingresos directamente en una cuenta de inversi\u00f3n mediante orden permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisez 1\u00a0\uff05 de plus de vos revenus directement sur un compte d'investissement via un ordre permanent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0925\u093e\u092f\u0940 \u0906\u0926\u0947\u0936 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u092a\u0928\u0940 \u0906\u092f \u0915\u093e 1\uff05 \u0905\u0927\u093f\u0915 \u0938\u0940\u0927\u0947 \u0928\u093f\u0935\u0947\u0936 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatizza l'1\uff05 in pi\u00f9 del tuo reddito direttamente su un conto di investimento tramite ordine permanente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ce\u5165\u306e 1\uff05 \u3092\u8ffd\u52a0\u3057\u3066\u3001\u30b9\u30bf\u30f3\u30c7\u30a3\u30f3\u30b0\u6ce8\u6587\u3092\u901a\u3058\u3066\u76f4\u63a5\u6295\u8cc7\u53e3\u5ea7\u306b\u81ea\u52d5\u5165\u91d1\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uae30 \uc8fc\ubb38\uc744 \ud1b5\ud574 \uc218\uc785\uc758 1\uff05 \uc774\uc0c1\uc744 \uc9c1\uc811 \ud22c\uc790 \uacc4\uc88c\ub85c \uc790\ub3d9\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiseer 1\uff05 meer van uw inkomsten rechtstreeks naar een beleggingsrekening via een doorlopende opdracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zautomatyzuj 1\uff05 wi\u0119cej swoich dochod\u00f3w bezpo\u015brednio na rachunku inwestycyjnym za pomoc\u0105 zlecenia sta\u0142ego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatize 1\uff05 a mais de sua receita diretamente em uma conta de investimento por meio de ordem permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0438\u0440\u0443\u0439 1\uff05 \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u043e\u0445\u043e\u0434\u0430 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0435 \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u0438\u0435 \u043d\u0430 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0441\u0447\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelirinizin \uff051 daha fazlas\u0131n\u0131 sabit emir yoluyla do\u011frudan bir yat\u0131r\u0131m hesab\u0131na aktar\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u4f60\u6536\u5165\u76841\uff05\u901a\u8fc7\u81ea\u52a8\u8f6c\u8d26\u76f4\u63a5\u5b58\u5165\u6295\u8d44\u8d26\u6237\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u5b9a\u671f\u8a02\u55ae\u81ea\u52d5\u5c07 1\uff05 \u7684\u6536\u5165\u76f4\u63a5\u5b58\u5165\u6295\u8cc7\u5e33\u6236\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.kontrolleur.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine Finanzen im Griff, aber du kannst dein System noch reibungsloser gestalten. Mikromanagement raubt dir Zeit f\u00fcr echtes Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have your finances under control, but you can make your system even smoother. Micromanagement robs you of time for real growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes tus finanzas bajo control, pero puedes hacer que tu sistema sea a\u00fan m\u00e1s fluido. La microgesti\u00f3n le roba tiempo para un crecimiento real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ma\u00eetrisez vos finances, mais vous pouvez rendre votre syst\u00e8me encore plus fluide. La microgestion vous fait perdre du temps pour une v\u00e9ritable croissance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0940 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u094d\u0925\u093f\u0924\u093f \u0906\u092a\u0915\u0947 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0947\u0902 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0905\u092a\u0928\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u094b \u0914\u0930 \u092d\u0940 \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0942\u0915\u094d\u0937\u094d\u092e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0935\u093f\u0915\u093e\u0938 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u0938\u092e\u092f \u091b\u0940\u0928 \u0932\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai le tue finanze sotto controllo, ma puoi rendere il tuo sistema ancora pi\u00f9 fluido. La microgestione ti ruba il tempo necessario per una crescita reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ca1\u52d9\u3092\u7ba1\u7406\u3067\u304d\u307e\u3059\u304c\u3001\u30b7\u30b9\u30c6\u30e0\u3092\u3055\u3089\u306b\u30b9\u30e0\u30fc\u30ba\u306b\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u30de\u30a4\u30af\u30ed\u30de\u30cd\u30b8\u30e1\u30f3\u30c8\u306f\u771f\u306e\u6210\u9577\u306e\u305f\u3081\u306e\u6642\u9593\u3092\u596a\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7ac\uc815\uc744 \ud1b5\uc81c\ud558\uba74\uc11c \uc2dc\uc2a4\ud15c\uc744 \ub354\uc6b1 \uc6d0\ud65c\ud558\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc138\uc138\ud55c \uad00\ub9ac\ub294 \uc9c4\uc815\ud55c \uc131\uc7a5\uc744 \uc704\ud55c \uc2dc\uac04\uc744 \ube7c\uc557\uc544\uac11\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft uw financi\u00ebn onder controle, maar u kunt uw systeem nog soepeler maken. Micromanagement berooft je van tijd voor echte groei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz swoje finanse pod kontrol\u0105, ale mo\u017cesz sprawi\u0107, \u017ce Tw\u00f3j system b\u0119dzie jeszcze p\u0142ynniejszy. Mikrozarz\u0105dzanie pozbawia Ci\u0119 czasu na prawdziwy rozw\u00f3j."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea tem suas finan\u00e7as sob controle, mas pode tornar seu sistema ainda mais tranquilo. O microgerenciamento rouba seu tempo para um crescimento real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0442\u0435\u0431\u044f \u043f\u043e\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0444\u0438\u043d\u0430\u043d\u0441\u044b, \u043d\u043e \u0442\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0435\u0449\u0451 \u0431\u043e\u043b\u0435\u0435 \u0433\u043b\u0430\u0434\u043a\u043e\u0439. \u041c\u0438\u043a\u0440\u043e\u043c\u0435\u043d\u0435\u0434\u0436\u043c\u0435\u043d\u0442 \u043e\u0442\u043d\u0438\u043c\u0430\u0435\u0442 \u0443 \u0442\u0435\u0431\u044f \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e \u0440\u043e\u0441\u0442\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali durumunuz kontrol alt\u0131nda ama sisteminizi daha da sorunsuz hale getirebilirsiniz. Mikro y\u00f6netim, ger\u00e7ek b\u00fcy\u00fcme i\u00e7in gereken zaman\u0131 \u00e7alar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u638c\u63e1\u4e86\u81ea\u5df1\u7684\u8d22\u52a1\uff0c\u4f46\u4f60\u53ef\u4ee5\u8ba9\u4f60\u7684\u7cfb\u7edf\u66f4\u52a0\u987a\u7545\u3002\u5fae\u89c2\u7ba1\u7406\u4f1a\u593a\u8d70\u4f60\u771f\u6b63\u589e\u957f\u7684\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u8ca1\u52d9\u76e1\u5728\u638c\u63a7\u4e4b\u4e2d\uff0c\u4f46\u60a8\u4e5f\u53ef\u4ee5\u8b93\u60a8\u7684\u7cfb\u7d71\u66f4\u52a0\u9806\u66a2\u3002\u5fae\u89c0\u7ba1\u7406\u6703\u525d\u596a\u4f60\u771f\u6b63\u6210\u9577\u7684\u6642\u9593\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.kontrolleur.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontrolleur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The controller"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el controlador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contr\u00f4leur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucee8\ud2b8\ub864\ub7ec"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De controleur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroler"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0434\u0443\u043a\u0442\u043e\u0440"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetleyici"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u68c0\u7968\u5458"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a7\u5236\u5668"
          }
        }
      }
    },
    "assessment.finance.profile.prokrastinator.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff heute eine kleine Finanzentscheidung, die du schon lange hinausz\u00f6gerst. Egal wie klein. Der Impuls z\u00e4hlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, make a small financial decision that you've been putting off for a long time. No matter how small. The impulse counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma hoy una peque\u00f1a decisi\u00f3n financiera que llevabas mucho tiempo postergando. No importa lo peque\u00f1o que sea. El impulso cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd\u2019hui, prenez une petite d\u00e9cision financi\u00e8re que vous reportiez depuis longtemps. Peu importe sa taille. L\u2019impulsion compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0906\u092a \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0938\u0947 \u091f\u093e\u0932 \u0930\u0939\u0947 \u0925\u0947\u0964 \u091a\u093e\u0939\u0947 \u0915\u093f\u0924\u0928\u093e \u092d\u0940 \u091b\u094b\u091f\u093e \u0915\u094d\u092f\u094b\u0902 \u0928 \u0939\u094b. \u0906\u0935\u0947\u0917 \u092e\u093e\u092f\u0928\u0947 \u0930\u0916\u0924\u093e \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi prendi una piccola decisione finanziaria che rimandavi da molto tempo. Non importa quanto piccolo. L'impulso conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u3001\u9577\u3044\u9593\u5148\u5ef6\u3070\u3057\u306b\u3057\u3066\u304d\u305f\u7d4c\u6e08\u7684\u306a\u5c0f\u3055\u306a\u6c7a\u65ad\u3092\u3057\u3066\u307f\u307e\u305b\u3093\u304b\u3002\u3069\u3093\u306a\u306b\u5c0f\u3055\u304f\u3066\u3082\u3002\u885d\u52d5\u306f\u91cd\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298, \uc624\ub7ab\ub3d9\uc548 \ubbf8\ub8e8\uc5b4 \uc654\ub358 \uc791\uc740 \uc7ac\uc815\uc801 \uacb0\uc815\uc744 \ub0b4\ub824\ubcf4\uc138\uc694. \uc544\ubb34\ub9ac \uc791\uc544\ub3c4. \ucda9\ub3d9\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem vandaag een kleine financi\u00eble beslissing die u al een hele tijd uitstelt. Hoe klein ook. De impuls telt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju\u017c dzi\u015b podejmij drobn\u0105 decyzj\u0119 finansow\u0105, kt\u00f3r\u0105 d\u0142ugo odk\u0142ada\u0142e\u015b. Niewa\u017cne, jak ma\u0142e. Liczy si\u0119 impuls."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, tome uma pequena decis\u00e3o financeira que voc\u00ea vem adiando h\u00e1 muito tempo. N\u00e3o importa qu\u00e3o pequeno seja. O impulso conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0438 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0442\u044b \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0448\u044c \u0443\u0436\u0435 \u0434\u043e\u043b\u0433\u043e. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0442\u043e\u0433\u043e, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043e\u043d\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0435. \u0412\u0430\u0436\u0435\u043d \u0441\u0430\u043c \u0438\u043c\u043f\u0443\u043b\u044c\u0441."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn, uzun zamand\u0131r erteledi\u011finiz k\u00fc\u00e7\u00fck bir mali karar verin. Ne kadar k\u00fc\u00e7\u00fck olursa olsun. D\u00fcrt\u00fc \u00f6nemlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u505a\u4e00\u4e2a\u4f60\u4e00\u76f4\u62d6\u5ef6\u7684\u5c0f\u8d22\u52a1\u51b3\u5b9a\u3002\u4e0d\u7ba1\u591a\u5c0f\uff0c\u51b2\u52a8\u662f\u91cd\u8981\u7684\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\uff0c\u505a\u51fa\u4e00\u500b\u4f60\u5df2\u7d93\u63a8\u9072\u5f88\u4e45\u7684\u5c0f\u8ca1\u52d9\u6c7a\u5b9a\u3002\u4e0d\u7ba1\u591a\u5c0f\u3002\u885d\u52d5\u5f88\u91cd\u8981\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.prokrastinator.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Tabs f\u00fcr Finanzrecherchen nicht \u00fcber Nacht offen. Schlie\u00dfe sie, wenn in 5 Minuten keine Entscheidung gefallen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don\u2019t leave financial research tabs open overnight. Close it if no decision has been made in 5 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No deje abiertas las pesta\u00f1as de investigaci\u00f3n financiera de la noche a la ma\u00f1ana. Ci\u00e9rrelo si no se ha tomado ninguna decisi\u00f3n en 5 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laissez pas les onglets de recherche financi\u00e8re ouverts du jour au lendemain. Fermez-le si aucune d\u00e9cision n'a \u00e9t\u00e9 prise dans les 5 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0905\u0928\u0941\u0938\u0902\u0927\u093e\u0928 \u091f\u0948\u092c \u0915\u094b \u0930\u093e\u0924 \u092d\u0930 \u0916\u0941\u0932\u093e \u0928 \u091b\u094b\u0921\u093c\u0947\u0902\u0964 \u092f\u0926\u093f 5 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0915\u094b\u0908 \u0928\u093f\u0930\u094d\u0923\u092f \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0924\u094b \u0907\u0938\u0947 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lasciare aperte le schede della ricerca finanziaria dall\u2019oggi al domani. Chiudetelo se non \u00e8 stata presa alcuna decisione entro 5 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91d1\u878d\u8abf\u67fb\u30bf\u30d6\u3092\u958b\u3044\u305f\u307e\u307e\u4e00\u6669\u653e\u7f6e\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002 5 \u5206\u4ee5\u5185\u306b\u6c7a\u5b9a\u304c\u306a\u3044\u5834\u5408\u306f\u9589\u3058\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae08\uc735 \uc870\uc0ac \ud0ed\uc744 \ubc24\uc0c8 \uc5f4\uc5b4\ub450\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. 5\ubd84 \uc774\ub0b4\uc5d0 \uacb0\uc815\uc774 \uc774\ub8e8\uc5b4\uc9c0\uc9c0 \uc54a\uc73c\uba74 \ub2eb\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat tabbladen voor financieel onderzoek niet van de ene op de andere dag openstaan. Sluit het als er binnen 5 minuten geen beslissing is genomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zostawiaj zak\u0142adek bada\u0144 finansowych otwartych na noc. Zamknij je, je\u015bli w ci\u0105gu 5 minut nie zostanie podj\u0119ta \u017cadna decyzja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o deixe as abas de pesquisa financeira abertas durante a noite. Feche-o se nenhuma decis\u00e3o for tomada em 5 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439 \u0432\u043a\u043b\u0430\u0434\u043a\u0438 \u0434\u043b\u044f \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c\u0438 \u043d\u0430 \u043d\u043e\u0447\u044c. \u0417\u0430\u043a\u0440\u044b\u0432\u0430\u0439 \u0438\u0445, \u0435\u0441\u043b\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5 \u043c\u0438\u043d\u0443\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finansal ara\u015ft\u0131rma sekmelerini gece boyunca a\u00e7\u0131k b\u0131rakmay\u0131n. 5 dakika i\u00e7inde herhangi bir karar al\u0131nmad\u0131ysa kapat\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u8ba9\u8d22\u52a1\u7814\u7a76\u7684\u6807\u7b7e\u9875\u8fc7\u591c\u6253\u5f00\u3002\u5982\u679c\u57285\u5206\u949f\u5185\u6ca1\u6709\u505a\u51fa\u51b3\u5b9a\uff0c\u5c31\u5173\u95ed\u5b83\u4eec\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u8b93\u91d1\u878d\u7814\u7a76\u9078\u9805\u5361\u904e\u591c\u3002\u5982\u679c 5 \u5206\u9418\u5167\u672a\u505a\u51fa\u6c7a\u5b9a\uff0c\u8acb\u95dc\u9589\u5b83\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.prokrastinator.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle jeden Sonntagabend nur eine einzige \u00dcberweisung oder K\u00fcndigung aus und lege das Formular oder den Link bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select just one transfer or cancellation every Sunday evening and provide the form or link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione solo una transferencia o cancelaci\u00f3n cada domingo por la noche y proporcione el formulario o enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionnez un seul transfert ou annulation chaque dimanche soir et fournissez le formulaire ou le lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0930\u0935\u093f\u0935\u093e\u0930 \u0936\u093e\u092e \u0915\u094b \u0915\u0947\u0935\u0932 \u090f\u0915 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u0923 \u092f\u093e \u0930\u0926\u094d\u0926\u0940\u0915\u0930\u0923 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092b\u0949\u0930\u094d\u092e \u092f\u093e \u0932\u093f\u0902\u0915 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un solo trasferimento o annullamento ogni domenica sera e fornisci il modulo o il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u9031\u65e5\u66dc\u65e5\u306e\u591c\u306b\u3001\u8ee2\u9001\u307e\u305f\u306f\u30ad\u30e3\u30f3\u30bb\u30eb\u3092 1 \u3064\u3060\u3051\u9078\u629e\u3057\u3001\u30d5\u30a9\u30fc\u30e0\u307e\u305f\u306f\u30ea\u30f3\u30af\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc8fc \uc77c\uc694\uc77c \uc800\ub141\uc5d0 \ud55c \ubc88\uc758 \ud658\uc2b9 \ub610\ub294 \ucde8\uc18c\ub97c \uc120\ud0dd\ud558\uace0 \uc591\uc2dd\uc774\ub098 \ub9c1\ud06c\ub97c \uc81c\uacf5\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer elke zondagavond slechts \u00e9\u00e9n overboeking of annulering en geef het formulier of de link door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tylko jeden transfer lub anulacj\u0119 w ka\u017cd\u0105 niedziel\u0119 wieczorem i podaj formularz lub link."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione apenas uma transfer\u00eancia ou cancelamento todos os domingos \u00e0 noite e forne\u00e7a o formul\u00e1rio ou link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043a\u0430\u0436\u0434\u043e\u0435 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u043d\u043e\u0435 \u0432\u0435\u0447\u0435\u0440\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u0438\u043d \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0438\u043b\u0438 \u0440\u0430\u0441\u0442\u043e\u0440\u0436\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u0444\u043e\u0440\u043c\u0443 \u0438\u043b\u0438 \u0441\u0441\u044b\u043b\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Pazar ak\u015fam\u0131 yaln\u0131zca bir transfer veya iptal se\u00e7in ve formu veya ba\u011flant\u0131y\u0131 sa\u011flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u4e2a\u661f\u671f\u5929\u665a\u4e0a\u53ea\u9009\u62e9\u4e00\u4e2a\u8f6c\u8d26\u6216\u53d6\u6d88\uff0c\u5e76\u51c6\u5907\u597d\u8868\u683c\u6216\u94fe\u63a5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u500b\u9031\u65e5\u665a\u4e0a\u50c5\u9078\u64c7\u4e00\u6b21\u63a5\u9001\u6216\u53d6\u6d88\uff0c\u4e26\u63d0\u4f9b\u8868\u683c\u6216\u9023\u7d50\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.prokrastinator.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wei\u00dft eigentlich, was finanziell zu tun ist, schiebst es aber ewig auf. Deine Unentschlossenheit kostet bares Geld. Die L\u00f6sung: Die Aufgabe auf ein l\u00e4cherliches Minimum reduzieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You actually know what needs to be done financially, but you keep putting it off. Your indecision costs money. The solution: reduce the task to a ridiculous minimum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realmente sabes lo que hay que hacer financieramente, pero sigues posponi\u00e9ndolo. Tu indecisi\u00f3n cuesta dinero. La soluci\u00f3n: reducir la tarea a un m\u00ednimo rid\u00edculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fait, vous savez ce qui doit \u00eatre fait financi\u00e8rement, mais vous continuez \u00e0 le reporter. Votre ind\u00e9cision co\u00fbte de l\u2019argent. La solution : r\u00e9duire la t\u00e2che \u00e0 un minimum ridicule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u091c\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0930\u0942\u092a \u0938\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092a \u0907\u0938\u0947 \u091f\u093e\u0932\u0924\u0947 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u0905\u0928\u093f\u0930\u094d\u0923\u092f \u0938\u0947 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0938\u092e\u093e\u0927\u093e\u0928: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0939\u093e\u0938\u094d\u092f\u093e\u0938\u094d\u092a\u0926 \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0924\u0915 \u0915\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In realt\u00e0 sai cosa \u00e8 necessario fare a livello finanziario, ma continui a rimandare. La tua indecisione costa denaro. La soluzione: ridurre il compito a un minimo ridicolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5f53\u306f\u7d4c\u6e08\u7684\u306b\u4f55\u3092\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u304b\u5206\u304b\u3063\u3066\u3044\u308b\u306e\u306b\u3001\u305d\u308c\u3092\u5148\u5ef6\u3070\u3057\u306b\u3057\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u3002\u3042\u306a\u305f\u306e\u512a\u67d4\u4e0d\u65ad\u306b\u306f\u304a\u91d1\u304c\u304b\u304b\u308a\u307e\u3059\u3002\u89e3\u6c7a\u7b56\u306f\u3001\u30bf\u30b9\u30af\u3092\u3070\u304b\u3070\u304b\u3057\u3044\u307b\u3069\u6700\u5c0f\u9650\u306b\u6e1b\u3089\u3059\u3053\u3068\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\uc81c\ub85c \uc7ac\uc815\uc801\uc73c\ub85c \ubb34\uc5c7\uc744 \ud574\uc57c \ud558\ub294\uc9c0 \uc54c\uace0 \uc788\uc9c0\ub9cc \uacc4\uc18d \ubbf8\ub8e8\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc6b0\uc720\ubd80\ub2e8\ud568\uc740 \ube44\uc6a9\uc774 \ub4ed\ub2c8\ub2e4. \ud574\uacb0\ucc45: \uc791\uc5c5\uc744 \ub9d0\ub3c4 \uc548\ub418\ub294 \ucd5c\uc18c \uc218\uc900\uc73c\ub85c \uc904\uc774\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigenlijk weet je wel wat er financieel moet gebeuren, maar je stelt het steeds uit. Jouw besluiteloosheid kost geld. De oplossing: reduceer de taak tot een belachelijk minimum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142a\u015bciwie wiesz, co nale\u017cy zrobi\u0107 finansowo, ale ci\u0105gle to odk\u0142adasz. Twoje niezdecydowanie kosztuje. Rozwi\u0105zanie: zredukuj zadanie do absurdalnego minimum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na verdade, voc\u00ea sabe o que precisa ser feito financeiramente, mas continua adiando. Sua indecis\u00e3o custa dinheiro. A solu\u00e7\u00e3o: reduzir a tarefa a um m\u00ednimo rid\u00edculo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0437\u043d\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0441 \u0444\u0438\u043d\u0430\u043d\u0441\u0430\u043c\u0438, \u043d\u043e \u0432\u0441\u0451 \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0448\u044c \u044d\u0442\u043e. \u0422\u0432\u043e\u044f \u043d\u0435\u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u0442\u043e\u0438\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u0434\u0435\u043d\u0435\u0433. \u0420\u0435\u0448\u0435\u043d\u0438\u0435: \u0441\u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u0434\u0430\u0447\u0443 \u043a \u0441\u043c\u0435\u0445\u043e\u0442\u0432\u043e\u0440\u043d\u043e\u043c\u0443 \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asl\u0131nda maddi olarak ne yap\u0131lmas\u0131 gerekti\u011fini biliyorsunuz ama s\u00fcrekli erteliyorsunuz. Karars\u0131zl\u0131\u011f\u0131n\u0131z paraya mal olur. \u00c7\u00f6z\u00fcm: G\u00f6revi g\u00fcl\u00fcn\u00e7 bir minimuma indirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5176\u5b9e\u77e5\u9053\u5728\u8d22\u52a1\u4e0a\u8be5\u505a\u4ec0\u4e48\uff0c\u4f46\u5374\u603b\u662f\u62d6\u5ef6\u3002\u4f60\u7684\u72b9\u8c6b\u4e0d\u51b3\u4f1a\u8ba9\u4f60\u635f\u5931\u771f\u91d1\u767d\u94f6\u3002\u89e3\u51b3\u65b9\u6cd5\uff1a\u5c06\u4efb\u52a1\u7f29\u51cf\u5230\u4e00\u4e2a\u53ef\u7b11\u7684\u6700\u5c0f\u7a0b\u5ea6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5be6\u969b\u4e0a\u77e5\u9053\u5728\u8ca1\u52d9\u4e0a\u9700\u8981\u505a\u4ec0\u9ebc\uff0c\u4f46\u4f60\u7e3d\u662f\u62d6\u5ef6\u3002\u4f60\u7684\u7336\u8c6b\u4e0d\u6c7a\u6703\u4ed8\u51fa\u91d1\u9322\u7684\u4ee3\u50f9\u3002\u89e3\u6c7a\u65b9\u6848\uff1a\u5c07\u4efb\u52d9\u6e1b\u5c11\u5230\u6700\u4f4e\u9650\u5ea6\u3002"
          }
        }
      }
    },

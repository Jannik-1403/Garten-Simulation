    "trash.binge_streaming.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Streaming-Dienste nur auf dem Laptop laufen – nicht auf dem TV im Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only run streaming services on the laptop – not on the TV in bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza los servicios de streaming solo en el portátil, no en la televisión en la cama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fais tourner les services de streaming que sur l'ordinateur portable – pas sur la TV au lit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रीमिंग सेवाओं को केवल लैपटॉप पर चलाएं – बिस्तर में टीवी पर नहीं।"
          }
        },
        "it": {
          "stringUnit": {

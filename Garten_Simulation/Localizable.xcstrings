    "pfad_fit_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "20 Liegest\u00fctze heute. Du hast bewiesen dass du es kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 pushups today. You've proven that you can do it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "20 flexiones hoy. Has demostrado que puedes hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "20 pompes aujourd'hui. Tu as prouv\u00e9 que tu en es capable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c 20 \u092a\u0941\u0936-\u0905\u092a\u094d\u0938\u0964 \u0906\u092a\u0928\u0947 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u092f\u0939 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "20 flessioni oggi. Hai dimostrato di potercela fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u8155\u7acb\u3066\u4f0f\u305b20\u56de\u3002\u3042\u306a\u305f\u306f\u305d\u308c\u304c\u3067\u304d\u308b\u3053\u3068\u3092\u8a3c\u660e\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 \ud314\uad7d\ud600\ud3b4\uae30 20\uac1c. \ub2f9\uc2e0\uc740 \uadf8\uac83\uc744 \ud560 \uc218 \uc788\ub2e4\ub294 \uac83\uc744 \uc99d\uba85\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag 20 push-ups. Je hebt bewezen dat je het kunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj 20 pompek. Udowodni\u0142e\u015b, \u017ce mo\u017cesz to zrobi\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "20 flex\u00f5es hoje. Provaste que consegues faz\u00ea-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "20 \u043e\u0442\u0436\u0438\u043c\u0430\u043d\u0438\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f. \u0422\u044b \u0434\u043e\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0448\u044c \u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn 20 \u015f\u0131nav. Bunu yapabilece\u011fini kan\u0131tlad\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u505a20\u4e2a\u4fef\u5367\u6491\u3002\u4f60\u5df2\u8bc1\u660e\u81ea\u5df1\u80fd\u505a\u5230\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u592920\u500b\u4fef\u81e5\u6490\u3002\u4f60\u5df2\u7d93\u8b49\u660e\u4f60\u80fd\u505a\u5230\u3002"
          }
        }
      }
    },

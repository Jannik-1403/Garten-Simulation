    "plant.wildgras.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zäh, regeneriert sich blitzschnell, bedeckt das Spielfeld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tough, regenerates lightning fast, covers the field"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistente, se regenera rapidísimo, cubre el campo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coriace, se régénère à la vitesse de l'éclair, couvre le terrain"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मजबूत, तीव्र गति से पुनर्जीवित होता है, खेल के मैदान को ढकता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Robusto, si rigenera velocemente, copre il campo da gioco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タフで電光石火の速さで回復し、フィールドをカバーする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "견고하고 번개처럼 빠르게 재생되며 필드를 덮습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterk, regenereert razendsnel, dekt het veld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytrzymały, błyskawicznie się regeneruje, osłania pole"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistente, regenera-se com velocidade relâmpago, cobre o terreno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistente, regenera-se com velocidade relâmpago, cobre o terreno"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесткий, восстанавливается мгновенно, покрывает игровое поле"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlamdır, yıldırım hızında yenilenir, alanı kaplar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坚韧，快速再生，覆盖整个场地"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "堅韌，快速再生，覆蓋比賽場地"
          }
        }
      }
    },

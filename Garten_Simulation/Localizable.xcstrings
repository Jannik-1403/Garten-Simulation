    "pfad_mental_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Auszeiten für den Geist. Lerne bewusstes Atmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short breaks for the mind. Learn conscious breathing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeños descansos para la mente. Aprende a respirar conscientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courtes pauses pour l'esprit. Apprends la respiration consciente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brevi pause per la mente. Impara la respirazione consapevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心の短い休憩。意識的な呼吸法を学びましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음을 위한 짧은 휴식. 의식적인 호흡을 배우십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte pauzes voor de geest. Leer bewust ademen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótkie przerwy dla umysłu. Naucz się świadomego oddychania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Curta pausa para a mente. Aprende a respiração consciente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihin için kısa molalar. Bilinçli nefes almayı öğrenin."
          }
        }
      }
    },
    "pfad_mental_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe Gelassenheit. Du bist eins mit dir selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep serenity. You are at one with yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Serenidad profunda. Eres uno contigo mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sérénité profonde. Tu ne fais qu'un avec toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profonda serenità. Sei in armonia con te stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深い静けさ。あなたは自分自身と一つになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊은 평온함. 당신은 자신과 하나입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diepe sereniteit. Je bent één met jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głęboki spokój. Jesteś jednością ze sobą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serenidade profunda. Estás em harmonia contigo mesmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derin huzur. Sen kendinle birsin."
          }
        }
      }
    },
    "pfad_mental_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Innere Stärke kultivieren. Frieden findest du in dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultivate inner strength. You find peace within yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva la fuerza interior. Encuentras la paz dentro de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultive ta force intérieure. Tu trouves la paix en toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coltiva la forza interiore. Trovi la pace dentro di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内なる強さを養いましょう。あなたは自分自身の中に平和を見出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내면의 힘을 키우세요. 당신은 자신 안에서 평화를 찾습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiveer innerlijke kracht. Je vindt rust in jezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pielęgnuj wewnętrzną siłę. Odnajdujesz spokój w sobie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultiva a força interior. Encontras a paz dentro de ti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçsel gücü geliştirin. Huzuru kendi içinde bulursun."
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "Sadece çok çalıştıktan sonra tatlı – Ödülü kazanın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有辛勤工作后才甜美 – 赢得奖励"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辛勞之後才甜蜜－值得回報"
          }
        }
      }
    },
    "plant.kaktus.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlebt extremste Bedingungen – Kalt duschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Survives extreme conditions – Cold showers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive condiciones extremas – Duchas frías"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survit dans des conditions extrêmes – Douches froides"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अत्यंत कठिन परिस्थितियों में जीवित रहें – ठंडे पानी से नहाना"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopravvive alle condizioni più estreme: fai una doccia fredda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "極端な条件 – 冷水シャワーにも耐える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "극한 상황에서도 생존 – 찬물 샤워"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overleeft extreme omstandigheden – Koude douches"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytrzymuje ekstremalne warunki – zimne prysznice"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive em condições extremas – Duches frios"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive em condições extremas – Duches frios"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выживает в экстремальных условиях – холодный душ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşırı koşullarda hayatta kalır – Soğuk duşlar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在极端条件下生存 – 冷水淋浴"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最極端的條件下生存－洗冷水澡"
          }
        }
      }
    },

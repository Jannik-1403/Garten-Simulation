          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u30c4\u30fc\u30eb\u3092\u53ce\u7d0d\u3067\u304d\u308b\u5341\u5206\u306a\u30b9\u30da\u30fc\u30b9\u3002"

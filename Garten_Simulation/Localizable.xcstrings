    "screenTime.info.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Shield-Block zeigt einen Warn-Overlay über Apps. Die betroffenen Apps werden nicht gelöscht und können vom Nutzer weiterhin geöffnet werden (mit Bestätigung). Der Erwachsenen-Filter gilt nur in Safari."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shield block shows a warning overlay over apps. Affected apps are not deleted and can still be opened (with confirmation). The adult filter only applies in Safari."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo escudo muestra una superposición de advertencia sobre las apps. Las apps no se eliminan y aún pueden abrirse (con confirmación). El filtro adulto solo aplica en Safari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage shield affiche une superposition d'avertissement sur les apps. Les apps ne sont pas supprimées et peuvent toujours être ouvertes (avec confirmation). Le filtre adulte ne s'applique qu'à Safari."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शील्ड ब्लॉक ऐप्स पर चेतावनी ओवरले दिखाता है। प्रभावित ऐप्स हटाए नहीं जाते हैं और अभी भी (पुष्टि के साथ) खोले जा सकते हैं। वयस्क फ़िल्टर केवल सफारी में लागू होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco shield mostra una sovrapposizione di avviso sulle app. Le app non vengono eliminate e possono ancora essere aperte (con conferma). Il filtro adulti si applica solo in Safari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シールドブロックはアプリ上に警告を表示します。対象アプリは削除されず、確認後に開くことができます。アダルトフィルターはSafariのみ有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉴드 차단은 앱 위에 경고를 표시합니다. 앱은 삭제되지 않으며 확인 후 열 수 있습니다. 성인 필터는 Safari에만 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het shield-blok toont een waarschuwing over apps. Apps worden niet verwijderd en kunnen nog worden geopend (met bevestiging). Het volwassenenfilter geldt alleen in Safari."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokada shield wyświetla ostrzeżenie nad aplikacjami. Aplikacje nie są usuwane i nadal można je otworzyć (z potwierdzeniem). Filtr dla dorosłych działa tylko w Safari."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio shield mostra um aviso sobre os apps. Os apps não são eliminados e ainda podem ser abertos (com confirmação). O filtro adulto aplica-se apenas no Safari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блок щита показывает предупреждение поверх приложений. Пострадавшие приложения не удаляются и все еще могут быть открыты (с подтверждением). Фильтр для взрослых применяется только в Safari."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalkan bloğu uygulamalar üzerinde uyarı gösterir. Uygulamalar silinmez ve onay ile açılabilir. Yetişkin filtresi yalnızca Safari'de geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏蔽阻止在应用程序上显示警告覆盖。受影响的应用程序不会被删除，并且仍然可以（确认后）打开。成人内容过滤器仅适用于Safari。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封鎖會在應用程式上顯示警告覆蓋。受影響的應用程式不會被刪除，並且仍然可以（確認後）打開。成人內容過濾器僅適用於Safari。"
          }
        }
      }
    },

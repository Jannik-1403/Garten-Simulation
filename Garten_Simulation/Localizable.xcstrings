    "prog_noalcohol_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde ein Premium-Ersatzgetränk. Kombucha, alkoholfreies IPA oder ein Mocktail. Es muss sich nach 'Feierabend' anfühlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a premium replacement drink. Kombucha, non-alcoholic IPA or a mocktail. It has to feel like 'after work'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre una bebida de reemplazo premium. Kombucha, IPA sin alcohol o cóctel sin alcohol. Tiene que sentirse como \"después del trabajo\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez une boisson de remplacement premium. Kombucha, IPA sans alcool ou cocktail sans alcool. Il faut que ce soit comme « après le travail »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रीमियम प्रतिस्थापन पेय खोजें। कोम्बुचा, गैर अल्कोहलिक आईपीए या मॉकटेल। इसे 'काम के बाद' जैसा महसूस करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova una bevanda sostitutiva premium. Kombucha, IPA analcolica o mocktail. Deve sembrare \"dopo il lavoro\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムな代替ドリンクを見つけてください。コンブチャ、ノンアルコールIPA、またはモクテル。それは「仕事の後」のように感じなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리미엄 대체 음료를 찾아보세요. 콤부차, 무알콜 IPA 또는 목테일. '퇴근 후' 같은 느낌이어야 해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek een premium vervangend drankje. Kombucha, alcoholvrije IPA of een mocktail. Het moet voelen als 'na het werk'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź napój zastępczy premium. Kombucha, bezalkoholowe IPA lub mocktail. Trzeba poczuć się jak „po pracy”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre uma bebida substituta premium. Kombuchá, IPA sem álcool ou mocktail. Tem que parecer 'depois do trabalho'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre uma bebida substituta premium. Kombuchá, IPA sem álcool ou mocktail. Tem que parecer 'depois do trabalho'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите напиток-заменитель премиум-класса. Чайный гриб, безалкогольный IPA или коктейль. Это должно быть ощущение «после работы»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinci sınıf bir yedek içecek bulun. Kombucha, alkolsüz IPA veya kokteyl. 'İşten sonra' gibi hissettirmeli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寻找优质替代饮料。康普茶、不含酒精的 IPA 或无酒精鸡尾酒。它必须感觉像“下班后”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找優質替代飲料。康普茶、不含酒精的 IPA 或無酒精雞尾酒。它必須感覺像“下班後”。"
          }
        }
      }
    },

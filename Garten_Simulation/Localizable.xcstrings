          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de place pour tous tes outils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u0938\u092d\u0940 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u091c\u0917\u0939\u0964"

          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0430\u0439\u043c\u0435\u0440 \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u043e\u0432\u043a\u0438"
          }
        },
        "tr": {

    "plant.weinrebe.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je länger nüchtern, desto reicher die Ernte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer sober, the richer the harvest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más sobrio, más rica la cosecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus on est sobre longtemps, plus riche est la récolte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer sober, the richer the harvest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断酒期間が長ければ長いほど、より豊かな収穫が得られる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "냉정한 시간이 길어질수록 수확량이 많아집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe langer nuchter, hoe rijker de oogst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Im dłużej trzeźwy, tym bogatsze zbiory"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais sóbrio por mais tempo, mais rica a colheita"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar ayık olursa, hasat o kadar zengin olur"
          }
        }
      }
    },

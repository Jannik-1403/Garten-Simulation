    "tour_inventory_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier findest du all deine Power-Ups, Schlechte Gewohnheiten und Pflanzen. Außerdem kannst du hier deine ganz eigenen Pflanzen und Gewohnheiten erstellen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here you will find all your power-ups, bad habits, and plants. You can also create your very own plants and habits here!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí encontrarás todos tus potenciadores, decoraciones y plantas. ¡También puedes crear tus propias plantas y hábitos aquí!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous trouverez ici tous vos power-ups, décorations et plantes. Vous pouvez également créer vos propres plantes et habitudes ici !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ आप अपने सभी पावर-अप, बुरी आदतें और पौधों को पाएंगे। इसके अलावा, आप यहाँ अपने खुद के पौधे और आदतें भी बना सकते हैं!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui troverai tutti i tuoi power-up, decorazioni e piante. Puoi anche creare le tue piante e abitudini qui!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここには、すべてのパワーアップ、装飾、植物があります。また、ここで独自の植物や習慣を作成することもできます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에서 모든 파워업, 장식 및 식물을 찾을 수 있습니다. 여기서 나만의 식물과 습관을 만들 수도 있습니다!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier vind je al je power-ups, decoraties en planten. Je kunt hier ook je eigen planten en gewoonten creëren!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj znajdziesz wszystkie swoje ulepszenia, dekoracje i rośliny. Możesz tutaj również tworzyć własne rośliny i nawyki!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui você encontrará todos os seus power-ups, decorações e plantas. Você também pode criar suas próprias plantas e hábitos aqui!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь вы найдете все свои бонусы, вредные привычки и растения. Кроме того, здесь вы можете создавать свои собственные растения и привычки!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada tüm güçlendiricilerinizi, dekorasyonlarınızı ve bitkilerinizi bulacaksınız. Ayrıca burada kendi bitkilerinizi ve alışkanlıklarınızı oluşturabilirsiniz!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里你会找到所有的能量、坏习惯和植物。另外，您可以在这里创造自己的植物和习惯！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡你會找到所有的能量、壞習慣和植物。另外，您可以在這裡創造自己的植物和習慣！"
          }
        }
      }
    },

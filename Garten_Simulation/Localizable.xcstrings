            "value" : "Evet diyorum çünkü aksi halde artık beni sevmeyeceğinden korkuyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我答应了，因为我害怕他会不再喜欢我。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我說是的，因為我擔心否則他不會再喜歡我了。"
          }
        }
      }
    },

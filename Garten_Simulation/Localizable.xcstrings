    "onboarding_benachrichtigung_status_abgelehnt": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Du hast Mitteilungen bereits deaktiviert. Um sie zu nutzen, musst du sie in den iOS-Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: You have already disabled notifications. To use them, you must re-enable them in the iOS settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Ya has desactivado las notificaciones. Para usarlas, debes volver a activarlas en los ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note : tu as d\u00e9j\u00e0 d\u00e9sactiv\u00e9 les notifications. Pour les utiliser, tu dois les r\u00e9activer dans les r\u00e9glages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902: \u0906\u092a\u0928\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0905\u0915\u094d\u0937\u092e \u0915\u0930 \u0926\u0940 \u0939\u0948\u0902. \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b \u0907\u0938\u0947 iOS \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: You have already disabled notifications. To use them, you must re-enable them in the iOS settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8: \u901a\u77e5\u306f\u3059\u3067\u306b\u7121\u52b9\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001iOS \u8a2d\u5b9a\u3067\u518d\u5ea6\u6709\u52b9\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc38\uace0: \uc774\ubbf8 \uc54c\ub9bc\uc744 \ube44\ud65c\uc131\ud654\ud588\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc0ac\uc6a9\ud558\ub824\uba74 iOS \uc124\uc815\uc5d0\uc11c \ub2e4\uc2dc \ud65c\uc131\ud654\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opmerking: je hebt meldingen al uitgeschakeld. Om ze te gebruiken, moet je ze opnieuw inschakelen in de iOS-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: wy\u0142\u0105czy\u0142e\u015b ju\u017c powiadomienia. Aby z nich skorzysta\u0107, nale\u017cy je ponownie w\u0142\u0105czy\u0107 w ustawieniach iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: J\u00e1 desativaste as notifica\u00e7\u00f5es. Para as usares, tens de as reativar nas defini\u00e7\u00f5es do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0432\u044b \u0443\u0436\u0435 \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u043b\u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f. \u0427\u0442\u043e\u0431\u044b \u0438\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c, \u0432\u0430\u043c \u043d\u0443\u0436\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u0445 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not: Bildirimleri zaten devre d\u0131\u015f\u0131 b\u0131rakt\u0131n\u0131z. Bunlar\u0131 kullanmak i\u00e7in iOS ayarlar\u0131nda yeniden etkinle\u015ftirmeniz gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u4f60\u5df2\u7981\u7528\u901a\u77e5\u3002\u8981\u4f7f\u7528\u5b83\u4eec\uff0c\u4f60\u9700\u8981\u5728iOS\u8bbe\u7f6e\u4e2d\u542f\u7528\u5b83\u4eec\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\uff1a\u60a8\u5df2\u7d93\u7981\u7528\u4e86\u901a\u77e5\u3002\u8981\u4f7f\u7528\u5b83\uff0c\u60a8\u9700\u8981\u5728 iOS \u8a2d\u5b9a\u4e2d\u555f\u52d5\u5b83\u3002"
          }
        }
      }
    },
    "onboarding_benachrichtigung_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen, um deinen Garten am Leben zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications to keep your garden alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones para mantener vivo tu jard\u00edn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les notifications pour garder ton jardin en vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u094b \u091c\u0940\u0935\u093f\u0924 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications to keep your garden alive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u77e5\u3092\u6709\u52b9\u306b\u3057\u3066\u5ead\u3092\u751f\u304d\u751f\u304d\u3068\u3055\u305b\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc5d0 \uc0dd\uae30\ub97c \ubd88\uc5b4\ub123\uc73c\ub824\uba74 \uc54c\ub9bc\uc744 \ud65c\uc131\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel meldingen in om uw tuin levend te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142\u0105cz powiadomienia, aby Tw\u00f3j ogr\u00f3d \u017cy\u0142."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa as notifica\u00e7\u00f5es para manter o teu jardim vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0432\u0430\u0448 \u0441\u0430\u0434 \u0432 \u0436\u0438\u0432\u043e\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7enizi canl\u0131 tutmak i\u00e7in bildirimleri etkinle\u015ftirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u542f\u7528\u901a\u77e5\uff0c\u8ba9\u4f60\u7684\u82b1\u56ed\u4fdd\u6301\u751f\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u555f\u7528\u901a\u77e5\u8b93\u60a8\u7684\u82b1\u5712\u4fdd\u6301\u6d3b\u529b\u3002"
          }
        }
      }
    },

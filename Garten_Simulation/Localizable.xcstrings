    "assessment.finance.profile.kontrolleur.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Basics sitzen. Aber 'keine Schulden' ist kein Ziel – das ist nur die Ausgangslage. Die nächste Stufe beginnt jetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The basics are in place. But 'no debt' is not a goal - that's just the starting point. The next stage begins now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los conceptos básicos están en su lugar. Pero \"no endeudarse\" no es un objetivo: es sólo el punto de partida. La siguiente etapa comienza ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bases sont en place. Mais « pas de dette » n’est pas un objectif, c’est juste le point de départ. La prochaine étape commence maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le basi sono a posto. Ma “nessun debito” non è un obiettivo: è solo il punto di partenza. La fase successiva inizia ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本は整っています。しかし、「借金ゼロ」はゴールではなく、それは単なる出発点にすぎません。次のステージが今始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 사항은 갖추어져 있습니다. 그러나 '빚 없음'은 목표가 아닙니다. 그것은 단지 출발점일 뿐입니다. 이제 다음 단계가 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De basis is aanwezig. Maar ‘geen schulden’ is geen doel; dat is slechts het uitgangspunt. De volgende fase begint nu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podstawy są na swoim miejscu. Jednak „brak długów” nie jest celem – to dopiero punkt wyjścia. Następny etap zaczyna się teraz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O básico está pronto. Mas “sem dívidas” não é um objectivo – é apenas o ponto de partida. A próxima etapa começa agora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temeller yerli yerinde. Ancak 'borç yok' bir hedef değildir; bu sadece başlangıç ​​noktasıdır. Bir sonraki aşama şimdi başlıyor."
          }
        }
      }
    },

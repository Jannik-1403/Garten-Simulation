    "item.unkraut_schild.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Unkraut: Schild auf 1, 2 und 3 ziehen. Danach 24 h kein neues Unkraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When weeds appear: drag the shield onto 1, 2, and 3. Then 24 h without new weeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con malas hierbas: arrastra el escudo a 1, 2 y 3. Luego 24 h sin nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec des mauvaises herbes : glisse le bouclier sur 1, 2 et 3. Puis 24 h sans nouvelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0930\u092a\u0924\u0935\u093e\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f: \u0922\u093e\u0932 \u0915\u094b 1, 2 \u0914\u0930 3 \u092a\u0930 \u0932\u0947 \u091c\u093e\u090f\u0901\u0964 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 24 \u0918\u0902\u091f\u094b\u0902 \u0924\u0915 \u0915\u094b\u0908 \u0928\u092f\u093e \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con erbacce: trascina lo scudo su 1, 2 e 3. Poi 24 h senza nuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96d1\u8349\u304c\u73fe\u308c\u305f\u3089\u3001\u30b7\u30fc\u30eb\u30c9\u3092 1\u30012\u30013 \u306b\u30c9\u30e9\u30c3\u30b0\u3057\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u65b0\u3057\u3044\u96d1\u8349\u304c\u767a\u751f\u3057\u306a\u3044\u72b6\u614b\u3067 24 \u6642\u9593\u653e\u7f6e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a1\ucd08\uac00 \ub098\ud0c0\ub098\uba74 \ubc29\ud328\ub97c 1, 2, 3\uc73c\ub85c \ub4dc\ub798\uadf8\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c 24\uc2dc\uac04 \ub3d9\uc548 \uc0c8\ub85c\uc6b4 \uc7a1\ucd08\uac00 \ub098\uc624\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er onkruid verschijnt: sleep het schild naar 1, 2 en 3. Daarna 24 uur zonder nieuw onkruid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy pojawi\u0105 si\u0119 chwasty: przeci\u0105gnij tarcz\u0119 na 1, 2 i 3. Nast\u0119pnie 24 godziny bez nowych chwast\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ervas: arrasta o escudo para 1, 2 e 3. Depois 24 h sem novas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 \u0441\u043e\u0440\u043d\u044f\u043a\u0430\u0445: \u043f\u043e\u0442\u044f\u043d\u0438\u0442\u0435 \u0449\u0438\u0442 \u043d\u0430 1, 2 \u0438 3. \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e 24 \u0447\u0430\u0441\u0430 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u043d\u043e\u0432\u043e\u0439 \u0442\u0440\u0430\u0432\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabani otlar g\u00f6r\u00fcnd\u00fc\u011f\u00fcnde: kalkan\u0131 1, 2 ve 3'e s\u00fcr\u00fckleyin. Ard\u0131ndan 24 saat boyunca yeni yabani otlar olmadan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u6742\u8349\u65f6\uff1a\u5c06\u62a4\u76fe\u62d6\u52301\u30012\u548c3\u3002\u4e4b\u540e24\u5c0f\u65f6\u5185\u4e0d\u4f1a\u6709\u65b0\u6742\u8349\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0d\u65bc\u96dc\u8349\uff1a\u5c07\u9632\u8b77\u7f69\u79fb\u81f31\u30012\u30013\u3002\u4e4b\u5f8c24\u5c0f\u6642\u5167\u6c92\u6709\u65b0\u7684\u96dc\u8349\u3002"
          }
        }
      }
    },
    "item.waechter_turm.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettet eine Pflanze einmalig vor dem Austrocknen und dem sicheren Tod."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a plant once from drying out and certain death."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una planta una vez de secarse y de una muerte segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauve une plante une fois du dess\u00e8chement et d'une mort certaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092c\u093e\u0930 \u092a\u094c\u0927\u0947 \u0915\u094b \u0938\u0942\u0916\u0928\u0947 \u0914\u0930 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u092e\u0943\u0924\u094d\u092f\u0941 \u0938\u0947 \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una pianta una volta dall'essiccazione e da morte certa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u3092\u4e7e\u71e5\u3068\u78ba\u5b9f\u306a\u6b7b\u304b\u3089\u4e00\u5ea6\u6551\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dd\ubb3c\uc774 \ub9c8\ub974\uace0 \uc8fd\ub294 \uac83\uc744 \ud55c \ubc88\ub9cc \ubc29\uc9c0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt een plant \u00e9\u00e9n keer uitdrogen en een zekere dood."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz ratuje ro\u015blin\u0119 przed wysychaniem i pewn\u0105 \u015bmierci\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva uma planta uma vez de secar e de morte certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0430\u0441\u0430\u0435\u0442 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0435\u0434\u0438\u043d\u043e\u0436\u0434\u044b \u043e\u0442 \u0432\u044b\u0441\u044b\u0445\u0430\u043d\u0438\u044f \u0438 \u0432\u0435\u0440\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkiyi bir kez kurumaktan ve kesin \u00f6l\u00fcmden kurtar\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6b21\u6027\u62ef\u6551\u4e00\u682a\u690d\u7269\uff0c\u4f7f\u5176\u514d\u4e8e\u67af\u840e\u548c\u6b7b\u4ea1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u690d\u7269\u514d\u65bc\u4e7e\u71e5\u548c\u6b7b\u4ea1\u4e00\u6b21\u3002"
          }
        }
      }
    },

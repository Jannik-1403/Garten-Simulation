          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitkilerinizi unutmayın! %2$d %1$@ bugün hâlâ suya ihtiyaç duyuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别忘了你的植物！%2$d %1$@ 今天还需要浇水。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要忘記你的植物！%2$d%1$@今天仍然需要水。"
          }
        }
      }

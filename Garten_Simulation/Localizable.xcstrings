        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u0928\u0947 \u0910\u092a \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u093e \u0915\u094d\u092f\u094b\u0902 \u092c\u0902\u0926 \u0915\u0930 \u0926\u093f\u092f\u093e?"

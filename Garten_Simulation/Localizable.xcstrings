    "prog_cleaning_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 10-Minuten-Runde durch die ganze Wohnung. Bring alles dorthin zurück, wo es eigentlich wohnt. Bereite den Raum für die neue Woche vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 10-minute walk through the entire apartment. Bring everything back to where it actually lives. Prepare the room for the new week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paseo de 10 minutos por todo el apartamento. Devuelve todo a donde realmente vive. Prepara la habitación para la nueva semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La promenade de 10 minutes à travers tout l’appartement. Ramenez tout là où il vit réellement. Préparez la salle pour la nouvelle semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे अपार्टमेंट में 10 मिनट की पैदल दूरी। हर चीज़ को वहीं वापस लाएँ जहाँ वह वास्तव में रहती है। नए सप्ताह के लिए कमरा तैयार करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passeggiata di 10 minuti attraverso l'intero appartamento. Riporta tutto dove vive realmente. Preparare la stanza per la nuova settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アパート全体を歩いて10分。すべてのものを実際に住んでいる場所に戻します。新しい週に向けて部屋の準備をします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아파트 전체를 도보로 10분 거리에 있습니다. 모든 것을 실제로 살고 있는 곳으로 되돌려 놓습니다. 새로운 주를 위해 방을 준비하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10 minuten lopen door het gehele appartement. Breng alles terug naar waar het werkelijk leeft. Maak de kamer klaar voor de nieuwe week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spacer po całym mieszkaniu zajmuje 10 minut. Przywróć wszystko tam, gdzie faktycznie żyje. Przygotuj pokój na nowy tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A caminhada de 10 minutos por todo o apartamento. Traga tudo de volta para onde realmente mora. Prepare o quarto para a nova semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A caminhada de 10 minutos por todo o apartamento. Traga tudo de volta para onde realmente mora. Prepare o quarto para a nova semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10 минут ходьбы по всей квартире. Верните все туда, где оно есть на самом деле. Подготовьте комнату к новой неделе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm daire boyunca 10 dakikalık yürüyüş. Her şeyi gerçekte yaşadığı yere geri getirin. Odanızı yeni haftaya hazırlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行10分钟即可穿过整个公寓。把一切带回它真正存在的地方。为新的一周准备好房间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "步行10分鐘即可穿過整間公寓。把一切帶回它真正存在的地方。為新的一周準備好房間。"
          }
        }
      }
    },

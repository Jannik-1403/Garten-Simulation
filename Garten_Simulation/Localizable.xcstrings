    "onboarding_shop_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Shop findest du neue Pflanzen und nützliche Gegenstände für deine Reise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the shop, you'll find new plants and useful items for your journey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la tienda encontrarás nuevas plantas y objetos útiles para tu viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la boutique, tu trouveras de nouvelles plantes et des objets utiles pour ton voyage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुकान में आपको नए पौधे और आपकी यात्रा के लिए उपयोगी वस्तुएं मिलेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel negozio troverai nuove piante e oggetti utili per il tuo viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

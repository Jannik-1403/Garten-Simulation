    "prog_saving_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau dir deine Kontoauszüge an. Gibt es ein Abo (Netflix, Gym, App), das du nicht nutzt? Kündige es HEUTE."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at your bank statements. Is there a subscription (Netflix, Gym, app) that you don't use? Cancel TODAY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire sus extractos bancarios. ¿Hay alguna suscripción (Netflix, Gym, app) que no utilizas? Cancelar HOY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez vos relevés bancaires. Y a-t-il un abonnement (Netflix, Gym, appli) que vous n'utilisez pas ? Annuler AUJOURD'HUI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बैंक विवरण देखें. क्या कोई सदस्यता (नेटफ्लिक्स, जिम, ऐप) है जिसका आप उपयोग नहीं करते हैं? आज रद्द करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda i tuoi estratti conto bancari. C'è un abbonamento (Netflix, Palestra, app) che non usi? Annulla OGGI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行取引明細書を見てください。使用していないサブスクリプション (Netflix、ジム、アプリ) はありますか?今すぐキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 명세서를 살펴보세요. 사용하지 않는 구독(Netflix, Gym, 앱)이 있나요? 오늘 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar uw bankafschriften. Is er een abonnement (Netflix, Gym, app) waar je geen gebruik van maakt? Annuleer VANDAAG."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spójrz na swoje wyciągi bankowe. Czy jest jakaś subskrypcja (Netflix, Gym, aplikacja), z której nie korzystasz? Anuluj DZIŚ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seus extratos bancários. Existe alguma assinatura (Netflix, Academia, aplicativo) que você não usa? Cancele HOJE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seus extratos bancários. Existe alguma assinatura (Netflix, Academia, aplicativo) que você não usa? Cancele HOJE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите на свои банковские выписки. Есть ли подписка (Netflix, Gym, приложение), которой вы не пользуетесь? Отмените СЕГОДНЯ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka ekstrelerinize bakın. Kullanmadığınız bir abonelik (Netflix, Gym, uygulama) var mı? BUGÜN iptal edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看您的银行对账单。是否有您不使用的订阅（Netflix、Gym、应用程序）？今天取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視您的銀行對帳單。是否有您不使用的訂閱（Netflix、Gym、應用程式）？今天取消。"
          }
        }
      }
    },

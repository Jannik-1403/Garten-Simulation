    "focus.giveup.walkofshame.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe diesen Text exakt und fehlerfrei ab, um zu bestätigen, dass du die Sperre aufheben willst:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type this text exactly and without errors to confirm that you want to remove the ban:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe este texto exactamente y sin errores para confirmar que deseas eliminar la prohibición:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez ce texte exactement et sans erreur pour confirmer que vous souhaitez lever le ban :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पुष्टि करने के लिए कि आप प्रतिबंध हटाना चाहते हैं, इस पाठ को सटीक और त्रुटियों के बिना टाइप करें:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita questo testo esattamente e senza errori per confermare che desideri rimuovere il divieto:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止を解除することを確認するには、次のテキストをエラーなく正確に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 해제를 확인하려면 다음 텍스트를 오류 없이 정확하게 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ deze tekst precies en zonder fouten om te bevestigen dat je de ban wilt opheffen:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz ten tekst dokładnie i bez błędów, aby potwierdzić, że chcesz usunąć ban:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite este texto exatamente e sem erros para confirmar que deseja remover o banimento:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite este texto exatamente e sem erros para confirmar que deseja remover o banimento:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите этот текст точно и без ошибок, чтобы подтвердить, что вы хотите снять бан:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yasağı kaldırmak istediğinizi onaylamak için bu metni aynen ve hatasız olarak yazın:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确无误地输入此文本以确认您要删除禁令："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準確無誤地輸入此文字以確認您要刪除禁令："
          }
        }
      }
    },

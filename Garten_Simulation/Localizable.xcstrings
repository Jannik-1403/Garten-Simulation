        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0941\u0902\u0921\u0930\u0935\u0938\u094d\u0938\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902?"

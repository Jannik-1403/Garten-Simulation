    "assessment.fitness.profile.maschine.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respekt. Behalte diesen unaufhaltsamen Fokus bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respect. Maintain that unstoppable focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respeto. Mantenga ese enfoque imparable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respect. Maintenez cette concentration imparable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आदर करना। उस अजेय फोकस को बनाए रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

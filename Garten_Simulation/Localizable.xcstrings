    "tour_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Fortschritte im Auge und versuche, deine Streak nicht abreißen zu lassen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep an eye on your progress and try not to break your streak!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Esté atento a su progreso y trate de no romper su racha!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un œil sur vos progrès et essayez de ne pas interrompre votre séquence !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni d'occhio i tuoi progressi e cerca di non interrompere la tua serie di vittorie consecutive!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の進歩に注目して、連続記録を途切れないようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황을 주시하고 연속 기록을 깨뜨리지 않도록 노력하세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je voortgang in de gaten en probeer je streak niet te breken!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj swoje postępy i staraj się nie przerwać swojej passy!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique de olho no seu progresso e tente não quebrar sua seqüência!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemenize dikkat edin ve serinizi bozmamaya çalışın!"
          }
        }
      }
    },

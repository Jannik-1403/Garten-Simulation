    "trash.schlaf_killer_koffein.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Koffein nach 14 Uhr – stelle einen festen Alarm als Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No caffeine after 2pm – set a fixed alarm as a reminder."
          }
        },
        "es": {

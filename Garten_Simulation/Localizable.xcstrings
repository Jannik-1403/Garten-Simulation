          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plant unfortunately died due to a lack of water."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この植物は残念ながら水不足で枯れてしまいました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안타깝게도 이 식물은 물 부족으로 인해 죽었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze plant is helaas gestorven door gebrek aan water."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roślina ta niestety uschła z powodu braku wody."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta planta infelizmente morreu por falta de água."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это растение, к сожалению, слишком долго не поливали и оно погибло."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bitki ne yazık ki susuzluktan dolayı öldü."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这株植物很遗憾因为长时间未浇水而枯萎了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不幸的是，這棵植物沒有澆水太久，就死了。"
          }
        }
      }

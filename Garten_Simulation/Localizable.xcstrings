    "prog_gratitude_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei dankbar für dich selbst. Welche Fähigkeit oder Eigenschaft hat dir heute oder in der Vergangenheit geholfen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be grateful for yourself. What skill or quality has helped you today or in the past?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé agradecido por ti mismo. ¿Qué habilidad o cualidad te ha ayudado hoy o en el pasado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez reconnaissant envers vous-même. Quelle compétence ou qualité vous a aidé aujourd’hui ou dans le passé ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने प्रति आभारी रहें. किस कौशल या गुणवत्ता ने आज या अतीत में आपकी सहायता की है?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii grato per te stesso. Quale abilità o qualità ti ha aiutato oggi o in passato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身に感謝しましょう。現在または過去にどのようなスキルや資質が役立っていますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신에게 감사하십시오. 현재 또는 과거에 어떤 기술이나 자질이 귀하에게 도움이 되었습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees dankbaar voor jezelf. Welke vaardigheid of kwaliteit heeft u vandaag of in het verleden geholpen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź wdzięczny za siebie. Jaka umiejętność lub cecha pomogła Ci dzisiaj lub w przeszłości?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja grato por si mesmo. Que habilidade ou qualidade o ajudou hoje ou no passado?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja grato por si mesmo. Que habilidade ou qualidade o ajudou hoje ou no passado?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будьте благодарны себе. Какой навык или качество помогли вам сегодня или в прошлом?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinize minnettar olun. Bugün veya geçmişte hangi beceri veya nitelik size yardımcı oldu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对自己心存感激。哪些技能或品质在今天或过去对您有帮助？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對自己心存感激。哪些技能或特質在今天或過去對您有幫助？"
          }
        }
      }
    },

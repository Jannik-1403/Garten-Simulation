    "plant.pilzkolonie.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kn\u00fcpfe wertvolle Kontakte und baue dein Netzwerk auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make valuable contacts and build your network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz contactos valiosos y construye tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouez des contacts pr\u00e9cieux et d\u00e9veloppez votre r\u00e9seau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0942\u0932\u094d\u092f\u0935\u093e\u0928 \u0938\u0902\u092a\u0930\u094d\u0915 \u092c\u0928\u093e\u090f\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea contatti preziosi e costruisci la tua rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cb4\u91cd\u306a\u30b3\u30cd\u30af\u30b7\u30e7\u30f3\u3092\u4f5c\u308a\u3001\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3092\u69cb\u7bc9\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc18c\uc911\ud55c \uc778\ub9e5\uc744 \ub9cc\ub4e4\uace0 \ub124\ud2b8\uc6cc\ud06c\ub97c \uad6c\ucd95\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg waardevolle contacten en bouw je netwerk op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawi\u0105zuj cenne kontakty i buduj swoj\u0105 sie\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa\u00e7a contatos valiosos e construa sua rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u043e\u0434\u0438 \u0446\u0435\u043d\u043d\u044b\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u044b \u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0439 \u0441\u0432\u043e\u044e \u0441\u0435\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "De\u011ferli ba\u011flant\u0131lar kurun ve a\u011f\u0131n\u0131z\u0131 olu\u015fturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5efa\u7acb\u5b9d\u8d35\u7684\u8054\u7cfb\uff0c\u6784\u5efa\u4f60\u7684\u4eba\u9645\u7f51\u7edc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5efa\u7acb\u6709\u50f9\u503c\u7684\u806f\u7e6b\u4e26\u5efa\u7acb\u60a8\u7684\u4eba\u8108\u3002"
          }
        }
      }
    },
    "plant.rosmarin.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00fcrzt das Leben, braucht t\u00e4gliche Pflege \u2013 Meal Prep"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spices up life, needs daily care \u2013 Meal Prep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazona la vida, necesita cuidado diario \u2013 Meal Prep"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne du go\u00fbt \u00e0 la vie, n\u00e9cessite des soins quotidiens \u2013 Meal Prep"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u093c\u093f\u0902\u0926\u0917\u0940 \u0915\u094b \u092e\u0938\u093e\u0932\u0947\u0926\u093e\u0930 \u092c\u0928\u093e\u0907\u090f, \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948 \u2013 \u092e\u0940\u0932 \u092a\u094d\u0930\u0947\u092a"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spices up life, needs daily care \u2013 Meal Prep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6d3b\u306b\u30b9\u30d1\u30a4\u30b9\u3092\u52a0\u3048\u308b\u306b\u306f\u6bce\u65e5\u306e\u30b1\u30a2\u304c\u5fc5\u8981 \u2013 \u98df\u4e8b\u306e\u6e96\u5099"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0b6\uc5d0 \ud65c\ub825\uc744 \ubd88\uc5b4\ub123\uace0 \uc77c\uc0c1\uc801\uc778 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4 \u2013 \uc2dd\uc0ac \uc900\ube44"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft meer pit aan het leven, heeft dagelijkse verzorging nodig \u2013 Maaltijdbereiding"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyprawia \u017cycie, wymaga codziennej piel\u0119gnacji \u2013 Meal Prep"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempera a vida, precisa de cuidados di\u00e1rios \u2013 Meal Prep"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0436\u0438\u0437\u043d\u044c, \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e \u0443\u0445\u043e\u0434\u0430 \u2013 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u0435\u0434\u044b"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayata renk katar, g\u00fcnl\u00fck bak\u0131ma ihtiya\u00e7 duyar \u2013 Yemek Haz\u0131rl\u0131\u011f\u0131"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u751f\u6d3b\u589e\u6dfb\u98ce\u5473\uff0c\u9700\u8981\u65e5\u5e38\u7167\u6599 \u2013 \u81b3\u98df\u51c6\u5907"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u751f\u6d3b\u589e\u6dfb\u60c5\u8da3\uff0c\u9700\u8981\u65e5\u5e38\u7167\u9867\uff0d\u81b3\u98df\u6e96\u5099"
          }
        }
      }
    },

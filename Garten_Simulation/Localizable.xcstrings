        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie wszystko wygląda dobrze! Tak trzymaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo parece bem no momento! Fique atento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo parece bem no momento! Fique atento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На данный момент все выглядит отлично! Так держать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an her şey yolunda görünüyor! Devam et."
          }
        },
        "zh-Hans": {
          "stringUnit": {

    "prog_cooking_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte heute bei deiner Hauptmahlzeit darauf, dass sie eine adäquate Menge an Protein (20-40g) enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure your main meal today contains an adequate amount of protein (20-40g)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrese de que su comida principal de hoy contenga una cantidad adecuada de proteínas (20-40 g)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que votre repas principal du jour contienne une quantité adéquate de protéines (20 à 40 g)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनिश्चित करें कि आज आपके मुख्य भोजन में पर्याप्त मात्रा में प्रोटीन (20-40 ग्राम) हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che il tuo pasto principale oggi contenga una quantità adeguata di proteine ​​(20-40 g)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の主食には適切な量のタンパク質（20〜40g）が含まれていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 주요 식사에는 적절한 양의 단백질(20-40g)이 포함되어 있는지 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat uw hoofdmaaltijd vandaag voldoende eiwitten bevat (20-40 g)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że Twój dzisiejszy główny posiłek zawiera odpowiednią ilość białka (20-40 g)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que a sua refeição principal de hoje contém uma quantidade adequada de proteínas (20-40g)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que a sua refeição principal de hoje contém uma quantidade adequada de proteínas (20-40g)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что ваш основной прием пищи сегодня содержит достаточное количество белка (20–40 г)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü ana öğününüzün yeterli miktarda protein (20-40g) içerdiğinden emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保您今天的主餐含有足够的蛋白质（20-40 克）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保您今天的主餐含有足夠的蛋白質（20-40 克）。"
          }
        }
      }
    },

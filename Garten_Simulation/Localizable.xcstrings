    "routine.edit.habits.empty": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast aktuell keine freien Gewohnheiten ohne Routine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You currently have no free habits without a routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no tienes h\u00e1bitos libres sin rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez actuellement aucune habitude libre sans routine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092d\u0940 \u0910\u0938\u0940 \u0906\u0926\u0924\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902 \u091c\u093f\u0928\u0915\u0940 \u0915\u094b\u0908 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attualmente non hai abitudini libere senza routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u3001\u30eb\u30fc\u30c1\u30f3\u306e\u306a\u3044\u7121\u6599\u306e\u7fd2\u6163\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc7ac \ub8e8\ud2f4\uc774 \uc5c6\ub294 \ubb34\ub8cc \uc2b5\uad00\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt momenteel geen vrije gewoonten zonder routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecnie nie masz wolnych nawyk\u00f3w bez rutyny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente n\u00e3o tem h\u00e1bitos livres sem rotina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a \u0431\u0435\u0437 \u0440\u0443\u0442\u0438\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eu anda rutini olmayan bo\u015f al\u0131\u015fkanl\u0131\u011f\u0131n\u0131z yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u76ee\u524d\u6ca1\u6709\u672a\u5206\u914d\u5230\u4f8b\u884c\u4e8b\u9879\u7684\u7a7a\u95f2\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u76ee\u524d\u6c92\u6709\u6c92\u6709\u4f8b\u884c\u516c\u4e8b\u7684\u81ea\u7531\u7fd2\u6163\u3002"
          }
        }
      }
    },

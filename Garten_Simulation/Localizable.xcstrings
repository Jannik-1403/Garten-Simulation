        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan dit nu niet betalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogę sobie na to teraz pozwolić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não posso permitir isso agora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda bunu karşılayamam."
          }
        }
      }
    },
    "assessment.finance.q5.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "10 Jahre ist mir zu weit weg – das Jetzt zählt mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 years is too far away for me – the now counts more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10 años es demasiado para mí; el ahora cuenta más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 ans, c’est trop loin pour moi – le moment présent compte plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "10 anni sono troppo lontani per me, il presente conta di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私にとって 10 年は遠すぎます。今はもっと重要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10년은 나에게 너무 멀다. 지금이 더 중요하다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 jaar is voor mij te ver weg – het nu telt meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 lat to dla mnie za daleko – teraz liczy się bardziej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "10 anos está muito longe para mim – o agora conta mais."
          }
        },
        "tr": {

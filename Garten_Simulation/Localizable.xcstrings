    "trash.nacht_snack_box.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzt deinen Garten sicher ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secures your garden boundaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Delimita las fronteras de tu jard\u00edn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9limite ton jardin en toute s\u00e9curit\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947 \u0938\u0940\u092e\u093e \u0924\u092f \u0915\u0930\u0947\u0902\u0964"

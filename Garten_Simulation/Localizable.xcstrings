    "weed.comeback.overlay.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine Unkraut-Plage gemeistert. Für %2$d Stunden erhältst du %1$@ XP pro Gießen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You conquered the weed crisis. For %2$d hours you earn %1$@ XP per watering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superaste la crisis de malas hierbas. Durante %2$d horas ganas %1$@ de XP por riego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as surmonté la crise d'herbes. Pendant %2$d heures: %1$@ d'XP par arrosage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपनी खरपतवार की समस्या पर काबू पा लिया है।%2$dघंटों के लिए आपको हर पानी देने पर%1$@XP मिलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai superato la crisi delle erbacce. Per %2$d ore: %1$@ XP per annaffiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは雑草の危機を克服しました。 %2$d 時間、水やりごとに %1$@ XP を獲得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대마초 위기를 극복하셨습니다. %2$d시간 동안 물을 주면 %1$@ XP를 얻습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de wietcrisis overwonnen. Gedurende %2$d uur verdien je %1$@ XP per gietbeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokonałeś kryzys chwastów. Przez %2$d godzin zdobywasz %1$@ XP za podlewanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Superaste a crise de ervas. Durante %2$d horas: %1$@ XP por rega."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Superaste a crise de ervas. Durante %2$d horas: %1$@ XP por rega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы справились с заражением сорняками. За часы%2$dвы получите%1$@XP за отливку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ot krizini yendin. %2$d saat boyunca sulama başına %1$@ XP kazanırsınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经控制了杂草的侵扰。对于%2$d小时，每次铸造您将获得%1$@XP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經控制了雜草的侵擾。對於%2$d小時，每次鑄造您將獲得%1$@XP。"
          }
        }
      }
    },

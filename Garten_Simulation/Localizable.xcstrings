          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0940 \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u092a\u0930 \u0915\u093e\u092c\u0942 \u092a\u093e \u0932\u093f\u092f\u093e \u0939\u0948\u0964%d\u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0939\u0930 \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u0947 \u092a\u0930%@XP \u092e\u093f\u0932\u0947\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai superato la crisi delle erbacce. Per %d ore: %@ XP per annaffiatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u96d1\u8349\u306e\u5371\u6a5f\u3092\u514b\u670d\u3057\u307e\u3057\u305f\u3002 %d \u6642\u9593\u3001\u6c34\u3084\u308a\u3054\u3068\u306b %@ XP \u3092\u7372\u5f97\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\ub9c8\ucd08 \uc704\uae30\ub97c \uadf9\ubcf5\ud558\uc168\uc2b5\ub2c8\ub2e4. %d\uc2dc\uac04 \ub3d9\uc548 \ubb3c\uc744 \uc8fc\uba74 %@ XP\ub97c \uc5bb\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de wietcrisis overwonnen. Gedurende %d uur verdien je %@ XP per gietbeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokona\u0142e\u015b kryzys chwast\u00f3w. Przez %d godzin zdobywasz %@ XP za podlewanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Superaste a crise de ervas. Durante %d horas: %@ XP por rega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b \u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0438\u0441\u044c \u0441 \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u043e\u0440\u043d\u044f\u043a\u0430\u043c\u0438. \u0417\u0430 \u0447\u0430\u0441\u044b%d\u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0435%@XP \u0437\u0430 \u043e\u0442\u043b\u0438\u0432\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ot krizini yendin. %d saat boyunca sulama ba\u015f\u0131na %@ XP kazan\u0131rs\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u63a7\u5236\u4e86\u6742\u8349\u7684\u4fb5\u6270\u3002\u5bf9\u4e8e%d\u5c0f\u65f6\uff0c\u6bcf\u6b21\u94f8\u9020\u60a8\u5c06\u83b7\u5f97%@XP\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7d93\u63a7\u5236\u4e86\u96dc\u8349\u7684\u4fb5\u64fe\u3002\u5c0d\u65bc%d\u5c0f\u6642\uff0c\u6bcf\u6b21\u9444\u9020\u60a8\u5c07\u7372\u5f97%@XP\u3002"
          }
        }
      }
    },

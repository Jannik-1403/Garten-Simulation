    "notification.streak.1.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohje! Wenn du jetzt nachlässt, stirbt die Pflanze und du verlierst %d Tage Streak."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh dear! If you slack now, the plant dies and you lose a %d-day streak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Oh no! Si aflojas ahora, la planta muere y pierdes una racha de %d días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh là là ! Si tu relâches maintenant, la plante meurt et tu perds %d jours de série."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओ प्यारे! यदि आप अभी हार मान लेते हैं, तो पौधा मर जाएगा और आप%dदिनों की श्रृंखला खो देंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh no! Se ti arrendi ora, la pianta muore e perdi %d giorni di serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まあ！ここで怠けると、植物は枯れてしまい、%d 日連続で損失が発生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이런! 지금 느슨해지면 식물이 죽고 %d일 연속 기록을 잃게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O lief! Als je nu verslapt, sterft de plant en verlies je een streak van %d dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Och kochanie! Jeśli teraz zwolnisz, roślina umrze i stracisz passę %d-dniową."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh não! Se vacilares agora, a planta morre e perdes um streak de %d dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ой-ой! Если ты сейчас ослабишь, растение умрёт, и ты потеряешь%dдней подряд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah hayatım! Şimdi gevşerseniz, bitki ölür ve %d günlük seriyi kaybedersiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哦不！如果你现在放弃，植物就会枯萎，你将失去 %d 天的连击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

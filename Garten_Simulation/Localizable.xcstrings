    "grovy_story_scene5_sub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit einer kleinen Gewohnheit. Der Rest wächst von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a small habit. The rest grows by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza con un pequeño hábito. El resto crece por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence avec une petite habitude. Le reste pousse tout seul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटी सी आदत से शुरू करें। बाकी खुद बढ़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con una piccola abitudine. Il resto cresce da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな習慣から始めましょう。残りは自然に成長します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 습관부터 시작하세요. 나머지는 저절로 자라납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met een kleine gewoonte. De rest groeit vanzelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od małego nawyku. Reszta rośnie sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa com um pequeno hábito. O resto cresce por si só."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um pequeno hábito. O resto cresce por si só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни с маленькой привычки. Остальное вырастет само."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir alışkanlıkla başla. Gerisi kendiliğinden büyür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从小习惯开始。其余的会自然生长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從小習慣開始。其餘的會自然生長。"
          }
        }
      }
    },

    "plant.weinrebe.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein klarer Kopf und mehr Energie durch den Verzicht auf Alkohol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clear head and more energy by avoiding alcohol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente clara y m\u00e1s energ\u00eda evitando el alcohol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esprit clair et plus d'\u00e9nergie en \u00e9vitant l'alcool."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0930\u093e\u092c \u0915\u093e \u0924\u094d\u092f\u093e\u0917 \u0915\u0930\u0915\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u094b\u091a \u0914\u0930 \u0905\u0927\u093f\u0915 \u090a\u0930\u094d\u091c\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente chiara e pi\u00f9 energia evitando l'alcol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30eb\u30b3\u30fc\u30eb\u3092\u907f\u3051\u308b\u3053\u3068\u3067\u3001\u982d\u304c\u3059\u3063\u304d\u308a\u3057\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u5897\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc220\uc744 \ud53c\ud568\uc73c\ub85c\uc368 \ub9d1\uc740 \uba38\ub9ac\uc640 \ub354 \ub9ce\uc740 \uc5d0\ub108\uc9c0\ub97c \uc5bb\uc73c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een helder hoofd en meer energie door alcohol te vermijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasny umys\u0142 i wi\u0119cej energii dzi\u0119ki unikaniu alkoholu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mente clara e mais energia evitando o \u00e1lcool."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u0441\u043d\u0430\u044f \u0433\u043e\u043b\u043e\u0432\u0430 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043e\u0442\u043a\u0430\u0437\u0443 \u043e\u0442 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkol almayarak berrak bir zihin ve daha fazla enerji elde edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6212\u9152\u5e26\u6765\u6e05\u9192\u7684\u5934\u8111\u548c\u66f4\u591a\u7684\u7cbe\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u98f2\u9152\uff0c\u982d\u8166\u6e05\u9192\uff0c\u7cbe\u529b\u5145\u6c9b\u3002"
          }
        }
      }
    },
    "plant.weizenfeld.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele kleine \u00c4hren = gro\u00dfe Ernte \u2013 Deep Work"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many small ears = big harvest \u2013 Deep Work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchas espigas = gran cosecha \u2013 Trabajo profundo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de petits \u00e9pis = grande r\u00e9colte \u2013 Travail profond"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0908 \u091b\u094b\u091f\u0947 \u092c\u093e\u0932\u093f\u092f\u093e\u0901 = \u092c\u0921\u093c\u0940 \u092b\u0938\u0932 \u2013 \u0921\u0940\u092a \u0935\u0930\u094d\u0915"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Many small ears = big harvest \u2013 Deep Work"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305f\u304f\u3055\u3093\u306e\u5c0f\u3055\u306a\u7a42 = \u5927\u304d\u306a\u53ce\u7a6b \u2013 Deep Work"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9ce\uc740 \uc791\uc740 \uadc0 = \ud070 \uc218\ud655 \u2013 Deep Work"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel kleine oren = grote oogst \u2013 Diep werk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele ma\u0142ych k\u0142os\u00f3w = du\u017ce zbiory \u2013 G\u0142\u0119boka praca"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas espigas pequenas = grande colheita \u2013 Trabalho profundo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043d\u043e\u0433\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u043a\u043e\u043b\u043e\u0441\u044c\u0435\u0432 = \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0443\u0440\u043e\u0436\u0430\u0439 \u2013 Deep Work"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7ok say\u0131da k\u00fc\u00e7\u00fck kulak = b\u00fcy\u00fck hasat \u2013 Derin \u00c7al\u0131\u015fma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bb8\u591a\u5c0f\u9ea6\u7a57 = \u4e30\u6536 \u2013 \u6df1\u5ea6\u5de5\u4f5c"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a31\u591a\u5c0f\u7a57=\u5927\u6536\u7a6b-\u6df1\u8015"
          }
        }
      }
    },

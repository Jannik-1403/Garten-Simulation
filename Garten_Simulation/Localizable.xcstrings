    "notification.evening.2.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergiss nicht auf deine Pflanzen! %2$d %1$@ braucht heute noch Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't forget your plants! %2$d %1$@ still needs water today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡No olvides tus plantas! %2$d %1$@ todavía necesita agua hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'oublie pas tes plantes ! %2$d %1$@ a encore besoin d'eau aujourd'hui."

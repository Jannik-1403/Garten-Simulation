    "onboarding_legal_bubble_title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast geschafft! Nur noch eine kleine Formsache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost done! Just a small formality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Casi listo! Solo un peque\u00f1o tr\u00e1mite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque fini ! Juste une petite formalit\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0939\u093e\u0901 \u0932\u0917\u092d\u0917! \u092c\u0938 \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0940 \u0914\u092a\u091a\u093e\u0930\u093f\u0915\u0924\u093e \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi finito! Solo una piccola formalit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3082\u3046\u3059\u3050\u5b8c\u6210\u3067\u3059\uff01\u3061\u3087\u3063\u3068\u3057\u305f\u5f62\u5f0f\u7684\u306a\u3082\u306e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac70\uc758 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4! \uadf8\ub0e5 \uc791\uc740 \ud615\uc2dd\uc774\uc5d0\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna klaar! Gewoon een kleine formaliteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie gotowe! To tylko ma\u0142a formalno\u015b\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase l\u00e1! Apenas uma pequena formalidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0447\u0442\u0438 \u0433\u043e\u0442\u043e\u0432\u043e! \u041e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0444\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse bitti! Sadece k\u00fc\u00e7\u00fck bir formalite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5feb\u5b8c\u6210\u4e86\uff01\u53ea\u5269\u4e00\u70b9\u70b9\u624b\u7eed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5feb\u5230\u4e86\uff01\u53ea\u662f\u4e00\u500b\u5c0f\u5f62\u5f0f\u800c\u5df2\u3002"
          }
        }
      }
    },

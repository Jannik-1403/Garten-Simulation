    "trash.endlos_scroll_tv.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege die Fernbedienung in eine Schublade – nicht griffbereit auf dem Sofa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the remote control in a drawer – not within easy reach on the sofa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el mando a distancia en un cajón, no al alcance de la mano en el sofá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range la télécommande dans un tiroir – pas à portée de main sur le canapé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट को ड्रा में रखो – सोफ़े पर आसानी से पहुँच में न हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il telecomando in un cassetto – non a portata di mano sul divano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモコンを引き出しに入れておきましょう。ソファの手の届くところには置かないようにしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리모컨을 서랍에 넣어두세요 – 소파에서 쉽게 닿을 수 있는 곳에 두지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg de afstandsbediening in een la – niet binnen handbereik op de bank."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włóż pilota do szuflady – nie w zasięgu ręki na kanapie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o controle remoto em uma gaveta – não ao alcance fácil no sofá."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o controle remoto em uma gaveta – não ao alcance fácil no sofá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите пульт дистанционного управления в дальний ящик дивана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan kumandayı bir çekmeceye koy – koltukta kolayca ulaşılabilir bir yerde değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将遥控器放在抽屉里，放在沙发上够不到的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將遙控器放在抽屜裡，放在沙發上搆不到的地方。"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle bewusst: Frage dich vor dem Einschalten, ob es sich lohnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll consciously: ask yourself before turning it on if it's worth it."
          }
        },
        "es": {

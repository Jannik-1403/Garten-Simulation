    "stats.coach.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichgewicht: Versuche, alle Lebensbereiche gleichm\u00e4\u00dfig zu pflegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance: Try to nurture all life areas equally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio: Intenta cultivar todas las \u00e1reas de la vida por igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9quilibre : Essaie de cultiver tous les aspects de ta vie de mani\u00e8re \u00e9gale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0924\u0941\u0932\u0928: \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902 \u0915\u093f \u091c\u0940\u0935\u0928 \u0915\u0947 \u0938\u092d\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0940 \u0938\u092e\u093e\u0928 \u0930\u0942\u092a \u0938\u0947 \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0940 \u091c\u093e\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio: Cerca di coltivare tutte le aree della vita in modo uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d0\u30e9\u30f3\u30b9\uff1a\u3059\u3079\u3066\u306e\u751f\u6d3b\u9818\u57df\u3092\u5e73\u7b49\u306b\u80b2\u3080\u3088\u3046\u306b\u52aa\u3081\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uade0\ud615: \ubaa8\ub4e0 \uc0b6\uc758 \uc601\uc5ed\uc744 \ub3d9\ub4f1\ud558\uac8c \uc721\uc131\ud558\ub824\uace0 \ub178\ub825\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans: Probeer alle levensgebieden in gelijke mate te koesteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00f3wnowaga: Staraj si\u0119 jednakowo piel\u0119gnowa\u0107 wszystkie obszary \u017cycia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Equil\u00edbrio: Tenta cultivar todas as \u00e1reas da vida igualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435: \u0421\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e\u0431\u043e \u0432\u0441\u0435\u0445 \u0441\u0444\u0435\u0440\u0430\u0445 \u0436\u0438\u0437\u043d\u0438 \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denge: Ya\u015fam\u0131n t\u00fcm alanlar\u0131n\u0131 e\u015fit \u015fekilde beslemeye \u00e7al\u0131\u015f\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u8861\uff1a\u5c1d\u8bd5\u5728\u751f\u6d3b\u7684\u5404\u4e2a\u65b9\u9762\u4fdd\u6301\u540c\u7b49\u7684\u5173\u6ce8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u8861\uff1a\u5617\u8a66\u5728\u751f\u6d3b\u7684\u5404\u500b\u65b9\u9762\u4fdd\u6301\u540c\u7b49\u7684\u95dc\u6ce8\u3002"
          }
        }
      }
    },
    "stats.coach.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontinuit\u00e4t: T\u00e4gliche kleine Schritte f\u00fchren zu gro\u00dfem Erfolg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency: Daily small steps lead to great success."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistencia: Los peque\u00f1os pasos diarios llevan a un gran \u00e9xito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9gularit\u00e9 : De petits pas quotidiens m\u00e8nent \u00e0 un grand succ\u00e8s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0924\u0924\u0924\u093e: \u0926\u0948\u0928\u093f\u0915 \u091b\u094b\u091f\u0947-\u091b\u094b\u091f\u0947 \u0915\u0926\u092e \u092c\u0921\u093c\u0947 \u0938\u092b\u0932\u0924\u093e \u0915\u0940 \u0913\u0930 \u0932\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costanza: Piccoli passi quotidiani portano a un grande successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u8cab\u6027: \u6bce\u65e5\u306e\u5c0f\u3055\u306a\u4e00\u6b69\u304c\u5927\u304d\u306a\u6210\u529f\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uad00\uc131: \ub9e4\uc77c\uc758 \uc791\uc740 \ubc1c\uac78\uc74c\uc774 \ud070 \uc131\uacf5\uc744 \uac00\uc838\uc635\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistentie: Dagelijkse kleine stapjes leiden tot groot succes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsekwencja: codzienne ma\u0142e kroki prowadz\u0105 do wielkiego sukcesu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consist\u00eancia: Pequenos passos di\u00e1rios levam a um grande sucesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u044c: \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0435 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0448\u0430\u0433\u0438 \u043f\u0440\u0438\u0432\u043e\u0434\u044f\u0442 \u043a \u0431\u043e\u043b\u044c\u0448\u043e\u043c\u0443 \u0443\u0441\u043f\u0435\u0445\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarl\u0131l\u0131k: G\u00fcnl\u00fck k\u00fc\u00e7\u00fck ad\u0131mlar b\u00fcy\u00fck ba\u015far\u0131ya yol a\u00e7ar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fde\u7eed\u6027\uff1a\u6bcf\u5929\u7684\u5c0f\u6b65\u9aa4\u4f1a\u5e26\u6765\u5de8\u5927\u7684\u6210\u529f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9023\u7e8c\u6027\uff1a\u6bcf\u5929\u7684\u5c0f\u6b65\u9a5f\u6703\u5e36\u4f86\u5de8\u5927\u7684\u6210\u529f\u3002"
          }
        }
      }
    },
    "stats.coach.bullet3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtsamkeit: H\u00f6re auf deine Bed\u00fcrfnisse und passe deine Ziele an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness: Listen to your needs and adjust your goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenci\u00f3n plena: Escucha tus necesidades y ajusta tus metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pleine conscience : \u00c9coute tes besoins et ajuste tes objectifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u091c\u0917\u0924\u093e: \u0905\u092a\u0928\u0940 \u091c\u093c\u0930\u0942\u0930\u0924\u094b\u0902 \u0915\u094b \u0938\u0941\u0928\u094b \u0914\u0930 \u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u094d\u092f\u094b\u0902 \u0915\u094b \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consapevolezza: Ascolta i tuoi bisogni e adatta i tuoi obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30de\u30a4\u30f3\u30c9\u30d5\u30eb\u30cd\u30b9: \u81ea\u5206\u306e\u30cb\u30fc\u30ba\u306b\u8033\u3092\u50be\u3051\u3001\u76ee\u6a19\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc74c\ucc59\uae40: \uadc0\ud558\uc758 \ud544\uc694 \uc0ac\ud56d\uc744 \ub4e3\uace0 \ubaa9\ud45c\ub97c \uc870\uc815\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness: Luister naar uw behoeften en pas uw doelen aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwa\u017cno\u015b\u0107: s\u0142uchaj swoich potrzeb i dostosowuj swoje cele."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mente alerta: Ouve as tuas necessidades e ajusta os teus objetivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e\u0441\u0442\u044c: \u041f\u0440\u0438\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u043a \u0441\u0432\u043e\u0438\u043c \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u044f\u043c \u0438 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0438 \u0446\u0435\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark\u0131ndal\u0131k: \u0130htiya\u00e7lar\u0131n\u0131z\u0131 dinleyin ve hedeflerinizi ayarlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5ff5\uff1a\u503e\u542c\u60a8\u7684\u9700\u6c42\u5e76\u8c03\u6574\u60a8\u7684\u76ee\u6807\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5ff5\uff1a\u50be\u807d\u60a8\u7684\u9700\u6c42\u4e26\u8abf\u6574\u60a8\u7684\u76ee\u6a19\u3002"
          }
        }
      }
    },
    "stats.coach.bullet4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt: Feiere jeden Meilenstein, egal wie klein er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress: Celebrate every milestone, no matter how small."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso: Celebra cada hito, no importa lo peque\u00f1o que sea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progr\u00e8s : C\u00e9l\u00e8bre chaque \u00e9tape, aussi petite soit-elle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0917\u0924\u093f: \u0939\u0930 \u092e\u0940\u0932 \u0915\u093e \u092a\u0924\u094d\u0925\u0930 \u092e\u0928\u093e\u0913, \u091a\u093e\u0939\u0947 \u0935\u0939 \u0915\u093f\u0924\u0928\u093e \u092d\u0940 \u091b\u094b\u091f\u093e \u0915\u094d\u092f\u094b\u0902 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso: Festeggia ogni traguardo, non importa quanto piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9032\u6b69: \u3069\u3093\u306a\u306b\u5c0f\u3055\u304f\u3066\u3082\u3001\u3059\u3079\u3066\u306e\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u3092\u795d\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ud589 \uc0c1\ud669: \uc544\ubb34\ub9ac \uc791\ub354\ub77c\ub3c4 \ubaa8\ub4e0 \uc774\uc815\ud45c\ub97c \ucd95\ud558\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooruitgang: Vier elke mijlpaal, hoe klein ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post\u0119p: \u015bwi\u0119tuj ka\u017cdy kamie\u0144 milowy, bez wzgl\u0119du na to, jak ma\u0142y."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso: Celebra cada marco, n\u00e3o importa qu\u00e3o pequeno seja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441: \u043f\u0440\u0430\u0437\u0434\u043d\u0443\u0439 \u043a\u0430\u0436\u0434\u044b\u0439 \u044d\u0442\u0430\u043f, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0442\u043e\u0433\u043e, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043e\u043d \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lerleme: Ne kadar k\u00fc\u00e7\u00fck olursa olsun her d\u00f6n\u00fcm noktas\u0131n\u0131 kutlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fdb\u6b65\uff1a\u5e86\u795d\u6bcf\u4e00\u4e2a\u91cc\u7a0b\u7891\uff0c\u65e0\u8bba\u591a\u4e48\u5c0f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9032\u6b65\uff1a\u6176\u795d\u6bcf\u4e00\u500b\u91cc\u7a0b\u7891\uff0c\u7121\u8ad6\u591a\u9ebc\u5c0f\u3002"
          }
        }
      }
    },

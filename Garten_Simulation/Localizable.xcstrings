          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten niewzruszony"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O inabal\u00e1vel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043f\u043e\u043a\u043e\u043b\u0435\u0431\u0438\u043c\u044b\u0439"
          }
        },
        "tr": {

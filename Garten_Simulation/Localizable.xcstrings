        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota cómo te sientes después de una noche sin dormir. ¿Te ayuda la próxima vez?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note comment tu te sens après une nuit blanche. Est-ce que ça aide la prochaine fois ?"

    "assessment.lifestyle.q1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand kommt in 5 Minuten unerwartet zu dir nach Hause. Wie sieht dein Zimmer/deine Wohnung aus?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone comes to your house unexpectedly in 5 minutes. What does your room/apartment look like?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien llega inesperadamente a tu casa en 5 minutos. \u00bfC\u00f3mo es tu habitaci\u00f3n/apartamento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un arrive chez vous \u00e0 l'improviste dans 5 minutes. A quoi ressemble votre chambre/appartement ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0915\u094b\u0908 \u0906\u092a\u0915\u0947 \u0918\u0930 \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0906 \u091c\u093e\u0924\u093e \u0939\u0948. \u0906\u092a\u0915\u093e \u0915\u092e\u0930\u093e/\u0905\u092a\u093e\u0930\u094d\u091f\u092e\u0947\u0902\u091f \u0915\u0948\u0938\u093e \u0926\u093f\u0916\u0924\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno viene a casa tua inaspettatamente tra 5 minuti. Come \u00e8 la tua stanza/appartamento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5\u5206\u4ee5\u5185\u306b\u8ab0\u304b\u304c\u7a81\u7136\u3042\u306a\u305f\u306e\u5bb6\u306b\u3084\u3063\u3066\u6765\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u90e8\u5c4b/\u30a2\u30d1\u30fc\u30c8\u306f\u3069\u3093\u306a\u611f\u3058\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5\ubd84 \ub4a4\uc5d0 \uac11\uc790\uae30 \ub204\uad70\uac00 \ub2f9\uc2e0\uc758 \uc9d1\uc5d0 \ucc3e\uc544\uc635\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ubc29/\uc544\ud30c\ud2b8\ub294 \uc5b4\ub5a4 \ubaa8\uc2b5\uc778\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnen 5 minuten komt er onverwacht iemand bij je thuis. Hoe ziet jouw kamer/appartement eruit?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za 5 minut kto\u015b niespodziewanie przyjdzie do Twojego domu. Jak wygl\u0105da Tw\u00f3j pok\u00f3j/mieszkanie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algu\u00e9m chega inesperadamente \u00e0 sua casa em 5 minutos. Como \u00e9 o seu quarto/apartamento?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0442\u043e-\u0442\u043e \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442 \u043a \u0442\u0435\u0431\u0435 \u0434\u043e\u043c\u043e\u0439 \u0447\u0435\u0440\u0435\u0437 5 \u043c\u0438\u043d\u0443\u0442. \u041a\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0442\u0432\u043e\u044f \u043a\u043e\u043c\u043d\u0430\u0442\u0430/\u0442\u0432\u043e\u044f \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0430?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 dakika i\u00e7inde beklenmedik bir \u015fekilde evinize biri geliyor. Odan\u0131z/daireniz nas\u0131l g\u00f6r\u00fcn\u00fcyor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u4eba\u4e94\u5206\u949f\u540e\u4f1a\u610f\u5916\u5730\u6765\u4f60\u5bb6\u3002\u4f60\u7684\u623f\u95f4/\u516c\u5bd3\u770b\u8d77\u6765\u600e\u4e48\u6837\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 \u5206\u9418\u5f8c\u6709\u4eba\u610f\u5916\u4f86\u5230\u4f60\u5bb6\u3002\u60a8\u7684\u623f\u9593/\u516c\u5bd3\u662f\u4ec0\u9ebc\u6a23\u5b50\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q1.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein absolutes Chaos. Ich sch\u00e4me mich und lasse ihn nicht rein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An absolute mess. I'm ashamed and won't let him in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desastre absoluto. Me da verg\u00fcenza y no lo dejar\u00e9 entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un g\u00e2chis absolu. J'ai honte et je ne le laisse pas entrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915\u0926\u092e \u0917\u0921\u093c\u092c\u0921\u093c. \u092e\u0948\u0902 \u0936\u0930\u094d\u092e\u093f\u0902\u0926\u093e \u0939\u0942\u0902 \u0914\u0930 \u0909\u0938\u0947 \u0905\u0902\u0926\u0930 \u0928\u0939\u0940\u0902 \u0906\u0928\u0947 \u0926\u0942\u0902\u0917\u0940."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vero disastro. Mi vergogno e non lo lascio entrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3063\u305f\u304f\u306e\u6df7\u4e71\u3060\u3002\u6065\u305a\u304b\u3057\u304f\u3066\u5f7c\u3092\u5165\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc808\ub300 \uc5c9\ub9dd\uc785\ub2c8\ub2e4. \ubd80\ub044\ub7ec\uc6cc\uc11c \uadf8\ub97c \ub4e4\uc5ec\ubcf4\ub0b4\uc9c0 \uc54a\uc744 \uac70\uc608\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een absolute puinhoop. Ik schaam me en laat hem niet binnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutny ba\u0142agan. Wstydz\u0119 si\u0119 i nie wpuszcz\u0119 go."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma bagun\u00e7a absoluta. Tenho vergonha e n\u00e3o deixo ele entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u0439 \u0445\u0430\u043e\u0441. \u041c\u043d\u0435 \u0441\u0442\u044b\u0434\u043d\u043e, \u0438 \u044f \u043d\u0435 \u043f\u0443\u0441\u043a\u0430\u044e \u0435\u0433\u043e \u0432\u043d\u0443\u0442\u0440\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam bir karma\u015fa. Utan\u0131yorum ve onu i\u00e7eri almayaca\u011f\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u56e2\u7cdf\u3002\u6211\u611f\u5230\u7f9e\u6127\uff0c\u4e0d\u8ba9\u4ed6\u8fdb\u6765\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d55\u5c0d\u662f\u4e00\u5718\u7cdf\u3002\u6211\u5f88\u7f9e\u6127\uff0c\u4e0d\u8b93\u4ed6\u9032\u4f86\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q1.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werfe panisch alles in den Schrank und schiebe Sachen unters Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a panic, I throw everything in the closet and shove things under the bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presa del p\u00e1nico, tiro todo en el armario y meto cosas debajo de la cama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paniqu\u00e9, je jette tout dans le placard et je glisse les affaires sous le lit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0918\u092c\u0930\u093e\u0939\u091f \u092e\u0947\u0902, \u092e\u0948\u0902 \u0938\u092c \u0915\u0941\u091b \u0915\u094b\u0920\u0930\u0940 \u092e\u0947\u0902 \u092b\u0947\u0902\u0915 \u0926\u0947\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u091a\u0940\u091c\u094b\u0902 \u0915\u094b \u092c\u093f\u0938\u094d\u0924\u0930 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0930\u0916 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In preda al panico, butto tutto nell'armadio e ficco le cose sotto il letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d1\u30cb\u30c3\u30af\u306b\u306a\u3063\u3066\u3001\u3059\u3079\u3066\u3092\u30af\u30ed\u30fc\u30bc\u30c3\u30c8\u306b\u653e\u308a\u8fbc\u307f\u3001\u30d9\u30c3\u30c9\u306e\u4e0b\u306b\u7269\u3092\u62bc\u3057\u8fbc\u307f\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\ud669\ud55c \ub098\ub294 \ubaa8\ub4e0 \uac83\uc744 \uc637\uc7a5\uc5d0 \ub358\uc9c0\uace0 \uce68\ub300 \ubc11\uc5d0 \ubb3c\uac74\uc744 \ubc00\uc5b4 \ub123\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In paniek gooi ik alles in de kast en schuif ik spullen onder het bed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W panice wrzucam wszystko do szafy i chowam pod \u0142\u00f3\u017ckiem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em p\u00e2nico, jogo tudo no arm\u00e1rio e enfio as coisas debaixo da cama."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0430\u043d\u0438\u043a\u0443\u044e \u0438 \u0431\u0440\u043e\u0441\u0430\u044e \u0432\u0441\u0435 \u0432 \u0448\u043a\u0430\u0444, \u0430 \u0432\u0435\u0449\u0438 \u0437\u0430\u0434\u0432\u0438\u0433\u0430\u044e \u043f\u043e\u0434 \u043a\u0440\u043e\u0432\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panik i\u00e7inde her \u015feyi dolaba at\u0131yorum ve e\u015fyalar\u0131 yata\u011f\u0131n alt\u0131na itiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u614c\u4e71\u5730\u628a\u6240\u6709\u4e1c\u897f\u6254\u8fdb\u8863\u67dc\uff0c\u628a\u6742\u7269\u585e\u5230\u5e8a\u5e95\u4e0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9a5a\u614c\u5931\u63aa\u4e2d\uff0c\u6211\u628a\u6240\u6709\u6771\u897f\u90fd\u4e1f\u9032\u8863\u6ac3\u88e1\uff0c\u7136\u5f8c\u628a\u6771\u897f\u585e\u5230\u5e8a\u5e95\u4e0b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q1.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist okay. Ein bisschen unordentlich, aber vorzeigbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay. A bit messy but presentable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1 bien. Un poco desordenado pero presentable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est bon. Un peu brouillon mais pr\u00e9sentable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902\u0964 \u0925\u094b\u0921\u093c\u093e \u0917\u0928\u094d\u0926\u093e \u0932\u0947\u0915\u093f\u0928 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u092f\u094b\u0917\u094d\u092f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene. Un po' disordinato ma presentabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5927\u4e08\u592b\u3002\u5c11\u3057\u4e71\u96d1\u3067\u3059\u304c\u3001\u898b\u6804\u3048\u306f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad1c\ucc2e\uc544\uc694. \uc870\uae08 \uc9c0\uc800\ubd84\ud558\uc9c0\ub9cc \ud45c\ud604 \uac00\ub2a5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is ok\u00e9. Een beetje rommelig maar toonbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest w porz\u0105dku. Troch\u0119 niechlujnie, ale reprezentacyjnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo bem. Um pouco bagun\u00e7ado, mas apresent\u00e1vel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043f\u043e\u0440\u044f\u0434\u043a\u0435. \u041d\u0435\u043c\u043d\u043e\u0433\u043e \u043d\u0435\u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e, \u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun de\u011fil. Biraz da\u011f\u0131n\u0131k ama prezentabl."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd8\u53ef\u4ee5\u3002\u6709\u70b9\u4e71\uff0c\u4f46\u80fd\u89c1\u4eba\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u95dc\u4fc2\u3002\u6709\u70b9\u4e71\u4f46\u8fd8\u7b97\u5f97\u4f53\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q1.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Makellos. Meine Umgebung ist immer geordnet, weil Chaos meinen Geist schw\u00e4cht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flawless. My surroundings are always orderly because chaos weakens my mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impecable. Mi entorno siempre est\u00e1 ordenado porque el caos debilita mi mente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impeccable. Mon environnement est toujours ordonn\u00e9 car le chaos affaiblit mon esprit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0947\u0926\u093e\u0917\u0964 \u092e\u0947\u0930\u093e \u092a\u0930\u093f\u0935\u0947\u0936 \u0939\u092e\u0947\u0936\u093e \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0930\u0939\u0924\u093e \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0905\u0930\u093e\u091c\u0915\u0924\u093e \u092e\u0947\u0930\u0947 \u0926\u093f\u092e\u093e\u0917 \u0915\u094b \u0915\u092e\u091c\u094b\u0930 \u0915\u0930 \u0926\u0947\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impeccabile. Ci\u00f2 che mi circonda \u00e8 sempre ordinato perch\u00e9 il caos indebolisce la mia mente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u74a7\u3002\u6df7\u4e71\u306f\u79c1\u306e\u7cbe\u795e\u3092\u5f31\u3081\u308b\u306e\u3067\u3001\u79c1\u306e\u5468\u56f2\u306f\u5e38\u306b\u6574\u7136\u3068\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc644\ubcbd\ud569\ub2c8\ub2e4. \ud63c\ub3c8\uc774 \ub0b4 \ub9c8\uc74c\uc744 \uc57d\ud654\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc5d0 \ub0b4 \uc8fc\ubcc0\uc740 \ud56d\uc0c1 \uc9c8\uc11c\uc815\uc5f0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlekkeloos. Mijn omgeving is altijd ordelijk omdat chaos mijn geest verzwakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doskona\u0142y. Moje otoczenie jest zawsze uporz\u0105dkowane, poniewa\u017c chaos os\u0142abia m\u00f3j umys\u0142."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfeito. Meu entorno est\u00e1 sempre ordenado porque o caos enfraquece minha mente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e. \u041c\u043e\u0435 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0445\u0430\u043e\u0441 \u043e\u0441\u043b\u0430\u0431\u043b\u044f\u0435\u0442 \u043c\u043e\u0439 \u0440\u0430\u0437\u0443\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusursuz. \u00c7evrem her zaman d\u00fczenli \u00e7\u00fcnk\u00fc kaos zihnimi zay\u0131flat\u0131yor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u5c18\u4e0d\u67d3\u3002\u6211\u7684\u73af\u5883\u603b\u662f\u4e95\u4e95\u6709\u6761\uff0c\u56e0\u4e3a\u6df7\u4e71\u4f1a\u524a\u5f31\u6211\u7684\u7cbe\u795e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u7f8e\u7121\u7455\u3002\u6211\u7684\u5468\u570d\u7e3d\u662f\u79e9\u5e8f\u4e95\u7136\uff0c\u56e0\u70ba\u6df7\u4e82\u524a\u5f31\u4e86\u6211\u7684\u601d\u60f3\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist der Durchschnitt der 5 Menschen, mit denen du die meiste Zeit verbringst. Schau sie dir an. Wer sind sie?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the average of the 5 people you spend the most time with. Look at her. Who are they?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el promedio de las 5 personas con las que pasas m\u00e1s tiempo. M\u00edrala. \u00bfQui\u00e9nes son?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates la moyenne des 5 personnes avec qui vous passez le plus de temps. Regardez-la. Qui sont-ils ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0909\u0928 5 \u0932\u094b\u0917\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0914\u0938\u0924 \u0939\u0948\u0902 \u091c\u093f\u0928\u0915\u0947 \u0938\u093e\u0925 \u0906\u092a \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u0938\u0947 \u0926\u0947\u0916\u094b\u0964 \u0915\u094c\u0928 \u0939\u0948\u0902 \u0935\u0947?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei la media delle 5 persone con cui trascorri pi\u00f9 tempo. Guardala. Chi sono?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u3001\u6700\u3082\u591a\u304f\u306e\u6642\u9593\u3092\u4e00\u7dd2\u306b\u904e\u3054\u3059 5 \u4eba\u306e\u5e73\u5747\u3067\u3059\u3002\u5f7c\u5973\u3092\u898b\u3066\u304f\u3060\u3055\u3044\u3002\u5f7c\u3089\u306f\u8ab0\u306a\u306e\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uac00\uc7a5 \ub9ce\uc740 \uc2dc\uac04\uc744 \ud568\uaed8 \ubcf4\ub0b4\ub294 5\uba85\uc758 \ud3c9\uade0\uc785\ub2c8\ub2e4. \uadf8\ub140\ub97c\ubcf4\uc138\uc694. \uadf8\ub4e4\uc740 \ub204\uad6c\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij bent het gemiddelde van de 5 mensen met wie je de meeste tijd doorbrengt. Kijk naar haar. Wie zijn zij?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b \u015bredni\u0105 5 os\u00f3b, z kt\u00f3rymi sp\u0119dzasz najwi\u0119cej czasu. Sp\u00f3jrz na ni\u0105. Kim oni s\u0105?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea \u00e9 a m\u00e9dia das 5 pessoas com quem passa mais tempo. Olhe para ela. Quem s\u00e3o eles?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0442\u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0441 \u043a\u0435\u043c \u0442\u044b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0440\u0435\u0434\u0438 \u043f\u044f\u0442\u0438 \u043b\u044e\u0434\u0435\u0439. \u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u043d\u0430 \u043d\u0438\u0445. \u041a\u0442\u043e \u043e\u043d\u0438?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En \u00e7ok vakit ge\u00e7irdi\u011finiz 5 ki\u015finin ortalamas\u0131s\u0131n\u0131z. Ona bak. Onlar kim?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u662f\u4f60\u82b1\u6700\u591a\u65f6\u95f4\u5728\u4e00\u8d77\u7684\u4e94\u4e2a\u4eba\u7684\u5e73\u5747\u503c\u3002\u770b\u770b\u4ed6\u4eec\u3002\u4ed6\u4eec\u662f\u8c01\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u662f\u8207\u60a8\u76f8\u8655\u6642\u9593\u6700\u591a\u7684 5 \u500b\u4eba\u7684\u5e73\u5747\u503c\u3002\u770b\u770b\u5979\u3002\u4ed6\u5011\u662f\u8ab0\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q2.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leute ohne Ziele, die sich nur beschweren, zocken oder Party machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People without goals who just complain, gamble or party."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gente sin objetivos que s\u00f3lo se queja, juega o se divierte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des gens sans objectifs qui se contentent de se plaindre, de jouer ou de faire la f\u00eate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093f\u0928\u093e \u0932\u0915\u094d\u0937\u094d\u092f \u0935\u093e\u0932\u0947 \u0932\u094b\u0917 \u091c\u094b \u0938\u093f\u0930\u094d\u092b \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u0941\u0906 \u0916\u0947\u0932\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persone senza obiettivi che si limitano a lamentarsi, a giocare d'azzardo o a festeggiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6a19\u3092\u6301\u305f\u305a\u3001\u305f\u3060\u4e0d\u5e73\u3092\u8a00\u3063\u305f\u308a\u3001\u30ae\u30e3\u30f3\u30d6\u30eb\u3057\u305f\u308a\u3001\u30d1\u30fc\u30c6\u30a3\u30fc\u3092\u3057\u305f\u308a\u3059\u308b\u3060\u3051\u306e\u4eba\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubd88\ud3c9\ub9cc \ud558\uace0, \ub3c4\ubc15\uc744 \ud558\uace0, \ud30c\ud2f0\ub9cc \ud558\ub294 \ubaa9\ud45c \uc5c6\ub294 \uc0ac\ub78c\ub4e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen zonder doelen die alleen maar klagen, gokken of feesten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ludzie bez cel\u00f3w, kt\u00f3rzy po prostu narzekaj\u0105, uprawiaj\u0105 hazard lub imprezuj\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas sem objetivos que s\u00f3 reclamam, jogam ou festejam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u044e\u0434\u0438 \u0431\u0435\u0437 \u0446\u0435\u043b\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0430\u043b\u0443\u044e\u0442\u0441\u044f, \u0438\u0433\u0440\u0430\u044e\u0442 \u0432 \u0438\u0433\u0440\u044b \u0438\u043b\u0438 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044e\u0442 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefi olmayan, sadece \u015fikayet eden, kumar oynayan veya parti yapan insanlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u76ee\u6807\u7684\u4eba\uff0c\u53ea\u4f1a\u62b1\u6028\u3001\u73a9\u6e38\u620f\u6216\u53c2\u52a0\u6d3e\u5bf9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u76ee\u6a19\u7684\u4eba\u53ea\u6703\u62b1\u6028\u3001\u8ced\u535a\u6216\u805a\u6703\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q2.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nette Leute, aber niemand von ihnen fordert mich wirklich heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice people, but none of them really challenge me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena gente, pero ninguno de ellos realmente me desaf\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des gens sympas, mais aucun d\u2019entre eux ne me d\u00e9fie vraiment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u091a\u094d\u091b\u0947 \u0932\u094b\u0917, \u0932\u0947\u0915\u093f\u0928 \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u094b\u0908 \u092d\u0940 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u092e\u0941\u091d\u0947 \u091a\u0941\u0928\u094c\u0924\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persone simpatiche, ma nessuna di loro mi sfida davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3044\u3044\u4eba\u305f\u3061\u3067\u3059\u304c\u3001\u79c1\u306b\u672c\u6c17\u3067\u6311\u6226\u3059\u308b\u4eba\u306f\u4e00\u4eba\u3082\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc88b\uc740 \uc0ac\ub78c\ub4e4\uc774\uc9c0\ub9cc \uadf8\ub4e4 \uc911 \ub204\uad6c\ub3c4 \ub098\uc5d0\uac8c \ub3c4\uc804\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aardige mensen, maar geen van hen daagt mij echt uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mili ludzie, ale \u017caden z nich nie stanowi dla mnie wyzwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas legais, mas nenhuma delas realmente me desafia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u044f\u0442\u043d\u044b\u0435 \u043b\u044e\u0434\u0438, \u043d\u043e \u043d\u0438\u043a\u0442\u043e \u0438\u0437 \u043d\u0438\u0445 \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u043c\u0435\u043d\u044f \u043d\u0435 \u0431\u0440\u043e\u0441\u0430\u0435\u0442 \u0432\u044b\u0437\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho\u015f insanlar ama hi\u00e7biri bana meydan okumuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f88\u597d\u7684\u4eba\uff0c\u4f46\u4ed6\u4eec\u4e2d\u6ca1\u6709\u4e00\u4e2a\u771f\u6b63\u6311\u6218\u6211\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eba\u5f88\u597d\uff0c\u4f46\u6c92\u6709\u4eba\u771f\u6b63\u6311\u6230\u6211\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q2.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mischung. Ein paar gute Leute, ein paar Zeitverschwender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mix. A few good people, a few time wasters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mezcla. Algunas buenas personas, algunas p\u00e9rdidas de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un m\u00e9lange. Quelques bonnes personnes, quelques pertes de temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092e\u093f\u0936\u094d\u0930\u0923. \u0915\u0941\u091b \u0905\u091a\u094d\u091b\u0947 \u0932\u094b\u0917, \u0915\u0941\u091b \u0938\u092e\u092f \u092c\u0930\u094d\u092c\u093e\u0926 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un miscuglio. Poche brave persone, poche perditempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30df\u30c3\u30af\u30b9\u3002\u826f\u3044\u4eba\u3082\u6570\u4eba\u3001\u6642\u9593\u3092\u7121\u99c4\u306b\u3059\u308b\u4eba\u3082\u6570\u4eba\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubbf9\uc2a4. \uc18c\uc218\uc758 \uc88b\uc740 \uc0ac\ub78c\ub4e4, \uc18c\uc218\uc758 \uc2dc\uac04 \ub0ad\ube44\uc790."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een mix. Een paar goede mensen, een paar tijdverspillers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieszanka. Kilku dobrych ludzi, kilku marnuj\u0105cych czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mistura. Algumas pessoas boas, algumas perdas de tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043c\u0435\u0448\u0435\u043d\u0438\u0435. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0445\u043e\u0440\u043e\u0448\u0438\u0445 \u043b\u044e\u0434\u0435\u0439, \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u0445, \u043a\u0442\u043e \u0442\u0440\u0430\u0442\u0438\u0442 \u0432\u0440\u0435\u043c\u044f \u0437\u0440\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kar\u0131\u015f\u0131m. Birka\u00e7 iyi insan, birka\u00e7 zaman kayb\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u4e2a\u6df7\u5408\u4f53\u3002\u4e00\u4e9b\u597d\u4eba\uff0c\u4e00\u4e9b\u6d6a\u8d39\u65f6\u95f4\u7684\u4eba\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6df7\u5408\u3002\u5e7e\u500b\u597d\u4eba\uff0c\u5e7e\u500b\u6d6a\u8cbb\u6642\u9593\u7684\u4eba\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q2.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leute, die ehrgeiziger, kl\u00fcger oder fitter sind als ich. Sie zwingen mich zu wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who are more ambitious, smarter or fitter than me. They force me to grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas que son m\u00e1s ambiciosas, m\u00e1s inteligentes o m\u00e1s en forma que yo. Me obligan a crecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des gens plus ambitieux, plus intelligents ou plus en forme que moi. Ils me forcent \u00e0 grandir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u094b \u0932\u094b\u0917 \u092e\u0941\u091d\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092e\u0939\u0924\u094d\u0935\u093e\u0915\u093e\u0902\u0915\u094d\u0937\u0940, \u0939\u094b\u0936\u093f\u092f\u093e\u0930 \u092f\u093e \u092b\u093f\u091f \u0939\u0948\u0902\u0964 \u0935\u0947 \u092e\u0941\u091d\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u091c\u092c\u0942\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persone che sono pi\u00f9 ambiziose, pi\u00f9 intelligenti o pi\u00f9 in forma di me. Mi costringono a crescere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u3088\u308a\u91ce\u5fc3\u7684\u3067\u3001\u8ce2\u304f\u3066\u3001\u5065\u5eb7\u306a\u4eba\u305f\u3061\u3002\u5f7c\u3089\u306f\u79c1\u306b\u6210\u9577\u3092\u5f37\u5236\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ubcf4\ub2e4 \ub354 \uc57c\uc2ec \ucc28\uace0, \ub354 \ub611\ub611\ud558\uace0, \ub354 \uac74\uac15\ud55c \uc0ac\ub78c\ub4e4. \uadf8\ub4e4\uc740 \ub098\uc5d0\uac8c \uc131\uc7a5\uc744 \uac15\uc694\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen die ambitieuzer, slimmer of fitter zijn dan ik. Ze dwingen mij om te groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ludzi, kt\u00f3rzy s\u0105 bardziej ambitni, m\u0105drzejsi i sprawniejsi ode mnie. Zmuszaj\u0105 mnie do rozwoju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas que s\u00e3o mais ambiciosas, mais inteligentes ou mais aptas do que eu. Eles me for\u00e7am a crescer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u044e\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u043e\u043b\u0435\u0435 \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u044b, \u0443\u043c\u043d\u044b \u0438\u043b\u0438 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u044b, \u0447\u0435\u043c \u044f. \u041e\u043d\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u043c\u0435\u043d\u044f \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benden daha h\u0131rsl\u0131, daha ak\u0131ll\u0131 veya daha fit olan insanlar. Beni b\u00fcy\u00fcmeye zorluyorlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bd4\u6211\u66f4\u6709\u91ce\u5fc3\u3001\u66f4\u806a\u660e\u6216\u66f4\u5065\u5eb7\u7684\u4eba\u3002\u4ed6\u4eec\u8feb\u4f7f\u6211\u6210\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90a3\u4e9b\u6bd4\u6211\u66f4\u6709\u91ce\u5fc3\u3001\u66f4\u8070\u660e\u3001\u66f4\u5065\u5eb7\u7684\u4eba\u3002\u4ed6\u5011\u8feb\u4f7f\u6211\u6210\u9577\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gehst an einem normalen Dienstag aus dem Haus (Schule/Arbeit/Stadt). Wie bist du gekleidet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You leave the house (school/work/city) on a normal Tuesday. How are you dressed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sales de casa (escuela/trabajo/ciudad) un martes normal. \u00bfC\u00f3mo est\u00e1s vestido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous quittez la maison (\u00e9cole/travail/ville) un mardi normal. Comment es-tu habill\u00e9 ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092e\u0902\u0917\u0932\u0935\u093e\u0930 \u0915\u094b \u0918\u0930 (\u0938\u094d\u0915\u0942\u0932/\u0915\u093e\u0930\u094d\u092f/\u0936\u0939\u0930) \u091b\u094b\u0921\u093c\u0947\u0902\u0964 \u0906\u092a\u0928\u0947 \u0915\u0948\u0938\u0947 \u0915\u092a\u0921\u093c\u0947 \u092a\u0939\u0928\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci di casa (scuola/lavoro/citt\u00e0) in un normale marted\u00ec. Come sei vestito?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u901a\u5e38\u306e\u706b\u66dc\u65e5\u306b\u5bb6\uff08\u5b66\u6821\u3001\u8077\u5834\u3001\u8857\uff09\u3092\u51fa\u767a\u3057\u307e\u3059\u3002\u670d\u88c5\u306f\u3069\u3046\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf4\ud1b5 \ud654\uc694\uc77c\uc5d0 \uc9d1(\ud559\uad50/\uc9c1\uc7a5/\ub3c4\uc2dc)\uc744 \ub5a0\ub0a9\ub2c8\ub2e4. \uc637\uc740 \uc5b4\ub5bb\uac8c \uc785\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verlaat het huis (school/werk/stad) op een normale dinsdag. Hoe ben je gekleed?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wychodzisz z domu (szko\u0142y/pracy/miasta) w normalny wtorek. Jak jeste\u015b ubrany?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea sai de casa (escola/trabalho/cidade) em uma ter\u00e7a-feira normal. Como voc\u00ea est\u00e1 vestido?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u0448\u044c \u0438\u0437 \u0434\u043e\u043c\u0430 \u0432 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0432\u0442\u043e\u0440\u043d\u0438\u043a (\u0448\u043a\u043e\u043b\u0430/\u0440\u0430\u0431\u043e\u0442\u0430/\u0433\u043e\u0440\u043e\u0434). \u0412\u043e \u0447\u0442\u043e \u0442\u044b \u043e\u0434\u0435\u0442?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal bir Sal\u0131 g\u00fcn\u00fc evden (okul/i\u015f/\u015fehir) \u00e7\u0131k\u0131yorsunuz. Nas\u0131l giyiniyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u4e2a\u666e\u901a\u7684\u5468\u4e8c\uff0c\u4f60\u51fa\u95e8\uff08\u4e0a\u5b66/\u4e0a\u73ed/\u901b\u8857\uff09\u3002\u4f60\u7a7f\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5728\u6b63\u5e38\u7684\u661f\u671f\u4e8c\u96e2\u958b\u5bb6\uff08\u5b78\u6821/\u5de5\u4f5c/\u57ce\u5e02\uff09\u3002\u4f60\u7a7f\u5f97\u600e\u9ebc\u6a23\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q3.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogginghose, dreckige Schuhe, Haare nicht gemacht. Ist doch eh egal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweatpants, dirty shoes, hair not done. It doesn't matter anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalones de ch\u00e1ndal, zapatos sucios, pelo sin peinar. No importa de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalons de surv\u00eatement, chaussures sales, cheveux mal coiff\u00e9s. De toute fa\u00e7on, cela n'a pas d'importance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u0947\u091f\u092a\u0948\u0902\u091f, \u0917\u0902\u0926\u0947 \u091c\u0942\u0924\u0947, \u092c\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u091f\u0947\u0964 \u0935\u0948\u0938\u0947 \u092d\u0940 \u0907\u0938\u0938\u0947 \u0915\u094b\u0908 \u092b\u0930\u094d\u0915 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0924\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaloni della tuta, scarpe sporche, capelli non pettinati. Non importa comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30a6\u30a7\u30c3\u30c8\u30d1\u30f3\u30c4\u3001\u6c5a\u308c\u305f\u9774\u3001\u6574\u3063\u3066\u3044\u306a\u3044\u9aea\u3002\u3068\u306b\u304b\u304f\u95a2\u4fc2\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\uc6e8\ud2b8\ud32c\uce20, \ub354\ub7ec\uc6b4 \uc2e0\ubc1c, \ub2e4\ub4ec\uc9c0 \uc54a\uc740 \uba38\ub9ac. \uc5b4\uca0c\ub4e0 \uadf8\uac83\uc740 \uc911\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Joggingbroek, vuile schoenen, haar niet gedaan. Het maakt toch niet uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spodnie dresowe, brudne buty, nieuczesana fryzura. To i tak nie ma znaczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal\u00e7a de moletom, sapatos sujos, cabelo n\u00e3o penteado. N\u00e3o importa de qualquer maneira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0433\u043e\u0432\u044b\u0435 \u0448\u0442\u0430\u043d\u044b, \u0433\u0440\u044f\u0437\u043d\u0430\u044f \u043e\u0431\u0443\u0432\u044c, \u0432\u043e\u043b\u043e\u0441\u044b \u043d\u0435 \u0443\u043b\u043e\u0436\u0435\u043d\u044b. \u0414\u0430 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u015fofman alt\u0131, kirli ayakkab\u0131lar, yap\u0131lmam\u0131\u015f sa\u00e7lar. Zaten \u00f6nemli de\u011fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd0\u52a8\u88e4\uff0c\u810f\u978b\uff0c\u5934\u53d1\u6ca1\u6253\u7406\u3002\u53cd\u6b63\u65e0\u6240\u8c13\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd0\u52a8\u88e4\uff0c\u810f\u978b\u5b50\uff0c\u5934\u53d1\u6ca1\u6253\u7406\u3002\u53cd\u6b63\u6c92\u95dc\u4fc2\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q3.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ziehe einfach das Erstbeste aus dem Schrank an, um nicht aufzufallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I just wear the first thing I see in the closet so as not to attract attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3lo uso lo primero que veo en el armario para no llamar la atenci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je porte juste la premi\u00e8re chose que je vois dans le placard pour ne pas attirer l'attention."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u0932\u092e\u093e\u0930\u0940 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u091c\u094b \u091a\u0940\u091c\u093c \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0902, \u0935\u0939\u0940 \u092a\u0939\u0928\u0924\u093e \u0939\u0942\u0902 \u0924\u093e\u0915\u093f \u0927\u094d\u092f\u093e\u0928 \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indosso semplicemente la prima cosa che vedo nell'armadio per non attirare l'attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u7acb\u305f\u306a\u3044\u3088\u3046\u306b\u3001\u30af\u30ed\u30fc\u30bc\u30c3\u30c8\u306e\u4e2d\u3067\u6700\u521d\u306b\u76ee\u306b\u3064\u3044\u305f\u3082\u306e\u3092\u7740\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uad00\uc2ec\uc744 \ub04c\uc9c0 \uc54a\uae30 \uc704\ud574 \uc637\uc7a5\uc5d0\uc11c \uac00\uc7a5 \uba3c\uc800 \ubcf4\uc774\ub294 \uac83\uc744 \uc785\ub294\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik draag gewoon het eerste wat ik in de kast zie, om geen aandacht te trekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosz\u0119 po prostu pierwsz\u0105 rzecz, kt\u00f3r\u0105 widz\u0119 w szafie, \u017ceby nie przyci\u0105ga\u0107 uwagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3 visto a primeira coisa que vejo no arm\u00e1rio para n\u00e3o chamar a aten\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0434\u0435\u0432\u0430\u044e \u043f\u0435\u0440\u0432\u0443\u044e \u043f\u043e\u043f\u0430\u0432\u0448\u0443\u044e\u0441\u044f \u0432\u0435\u0449\u044c \u0438\u0437 \u0448\u043a\u0430\u0444\u0430, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0432\u044b\u0434\u0435\u043b\u044f\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat \u00e7ekmemek i\u00e7in dolapta ilk g\u00f6rd\u00fc\u011f\u00fcm \u015feyi giyiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u662f\u968f\u4fbf\u4ece\u8863\u67dc\u91cc\u62ff\u6700\u5148\u770b\u5230\u7684\u8863\u670d\u7a7f\u4e0a\uff0c\u4ee5\u514d\u5f15\u4eba\u6ce8\u610f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u7a7f\u8863\u6ac3\u88e1\u7b2c\u4e00\u773c\u770b\u5230\u7684\u8863\u670d\uff0c\u4ee5\u514d\u5f15\u8d77\u6ce8\u610f\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q3.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauber, ordentlich und passend zur Situation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean, tidy and suitable for the situation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpio, ordenado y adecuado a la situaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propre, bien rang\u00e9 et adapt\u00e9 \u00e0 la situation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093e\u092b\u093c \u0938\u0941\u0925\u0930\u093e \u0914\u0930 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u0941\u0915\u094d\u0924."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulito, ordinato e adatto alla situazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e05\u6f54\u3067\u6574\u9813\u3055\u308c\u3066\u3044\u3066\u3001\u72b6\u6cc1\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae68\ub057\ud558\uace0 \uae54\ub054\ud558\uba70 \uc0c1\ud669\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schoon, netjes en geschikt voor de situatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysto, schludnie i adekwatnie do sytuacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpo, arrumado e adequado \u00e0 situa\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0438\u0441\u0442\u043e, \u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e \u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temiz, d\u00fczenli ve duruma uygun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e72\u51c0\u3001\u6574\u6d01\u5e76\u4e14\u9002\u5408\u573a\u5408\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e7e\u6de8\u3001\u6574\u6f54\u3001\u9069\u5408\u72c0\u6cc1\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q3.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin immer minimal besser angezogen als der Raum es erfordert. Kleidung ist Respekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am always slightly better dressed than the room requires. Clothing is respect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre estoy un poco mejor vestido de lo que requiere la habitaci\u00f3n. La ropa es respeto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis toujours un peu mieux habill\u00e9 que ce que la pi\u00e8ce exige. L'habillement, c'est le respect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0939\u092e\u0947\u0936\u093e \u0915\u092e\u0930\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0938\u0947 \u0925\u094b\u0921\u093c\u093e \u092c\u0947\u0939\u0924\u0930 \u0915\u092a\u0921\u093c\u0947 \u092a\u0939\u0928\u0924\u093e \u0939\u0942\u0902\u0964 \u0935\u0938\u094d\u0924\u094d\u0930 \u0938\u092e\u094d\u092e\u093e\u0928 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono sempre vestito leggermente meglio di quanto richiede la stanza. L'abbigliamento \u00e8 rispetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3044\u3064\u3082\u3001\u90e8\u5c4b\u304c\u5fc5\u8981\u3068\u3059\u308b\u3088\u308a\u5c11\u3057\u826f\u3044\u670d\u3092\u7740\u3066\u3044\u307e\u3059\u3002\u670d\u88c5\u306f\u656c\u610f\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud56d\uc0c1 \ubc29\uc5d0\uc11c \uc694\uad6c\ud558\ub294 \uac83\ubcf4\ub2e4 \uc57d\uac04 \ub354 \ub098\uc740 \uc637\uc744 \uc785\uc2b5\ub2c8\ub2e4. \uc637\uc740 \uc874\uc911\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben altijd iets beter gekleed dan de kamer vereist. Kleding is respect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze jestem troch\u0119 lepiej ubrany, ni\u017c wymaga tego pok\u00f3j. Ubi\u00f3r to szacunek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou sempre um pouco melhor vestido do que o quarto exige. Roupa \u00e9 respeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0434\u0435\u0442 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u043b\u0443\u0447\u0448\u0435, \u0447\u0435\u043c \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0435. \u041e\u0434\u0435\u0436\u0434\u0430 \u2014 \u044d\u0442\u043e \u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman odan\u0131n gerektirdi\u011finden biraz daha iyi giyinirim. Giyim sayg\u0131d\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u603b\u662f\u7a7f\u5f97\u6bd4\u573a\u5408\u8981\u6c42\u7a0d\u5fae\u597d\u4e00\u70b9\u3002\u7740\u88c5\u662f\u5c0a\u91cd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u7a7f\u8457\u7e3d\u662f\u6bd4\u623f\u9593\u8981\u6c42\u7684\u8981\u597d\u4e00\u9ede\u3002\u8457\u88dd\u5c31\u662f\u5c0a\u91cd\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast jemandem eine unwichtige Kleinigkeit versprochen (z.B. ein Video zu schicken). Du hast es vergessen und f\u00e4llst abends totm\u00fcde ins Bett. Was tust du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You promised someone an unimportant little thing (e.g. sending a video). You've forgotten it and fall into bed dead tired in the evening. What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prometiste a alguien una cosita sin importancia (por ejemplo, enviar un v\u00eddeo). Lo has olvidado y por la noche te acuestas muy cansado. \u00bfQu\u00e9 est\u00e1s haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez promis \u00e0 quelqu'un une petite chose sans importance (par exemple envoyer une vid\u00e9o). Vous l'avez oubli\u00e9 et vous vous couchez mort de fatigue le soir. Que fais-tu?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947 \u0915\u093f\u0938\u0940 \u0938\u0947 \u090f\u0915 \u092e\u0939\u0924\u094d\u0935\u0939\u0940\u0928 \u091b\u094b\u091f\u0940 \u091a\u0940\u091c\u093c \u0915\u093e \u0935\u093e\u0926\u093e \u0915\u093f\u092f\u093e \u0925\u093e (\u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0935\u0940\u0921\u093f\u092f\u094b \u092d\u0947\u091c\u0928\u093e)\u0964 \u0906\u092a \u0907\u0938\u0947 \u092d\u0942\u0932 \u0917\u090f \u0939\u0948\u0902 \u0914\u0930 \u0936\u093e\u092e \u0915\u094b \u0925\u0915\u0915\u0930 \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u0938\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai promesso a qualcuno una piccola cosa non importante (ad esempio inviare un video). Te ne sei dimenticato e la sera cadi a letto stanco morto. Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u8ab0\u304b\u306b\u91cd\u8981\u3067\u306a\u3044\u5c0f\u3055\u306a\u3053\u3068\uff08\u30d3\u30c7\u30aa\u3092\u9001\u308b\u306a\u3069\uff09\u3092\u7d04\u675f\u3057\u307e\u3057\u305f\u3002\u3042\u306a\u305f\u306f\u305d\u308c\u3092\u5fd8\u308c\u3066\u3001\u5915\u65b9\u306b\u306a\u308b\u3068\u75b2\u308c\u679c\u3066\u3066\u30d9\u30c3\u30c9\u306b\u843d\u3061\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u4f55\u3057\u3066\u308b\u306e\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub204\uad70\uac00\uc5d0\uac8c \uc911\uc694\ud558\uc9c0 \uc54a\uc740 \uc791\uc740 \uc77c(\uc608: \ube44\ub514\uc624 \ubcf4\ub0b4\uae30)\uc744 \uc57d\uc18d\ud588\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uadf8\uac83\uc744 \uc78a\uc5b4\ubc84\ub9ac\uace0 \uc800\ub141\uc5d0 \uc9c0\uccd0\uc11c \uce68\ub300\uc5d0 \uc4f0\ub7ec\uc84c\uc2b5\ub2c8\ub2e4. \ubb50\ud558\uc138\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt iemand een onbelangrijk kleinigheidje beloofd (bijvoorbeeld een video sturen). Je bent het vergeten en valt 's avonds doodmoe in bed. Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obieca\u0142e\u015b komu\u015b nieistotn\u0105 drobnostk\u0119 (np. przes\u0142anie filmu). Zapomnia\u0142e\u015b o tym i wieczorem k\u0142adziesz si\u0119 do \u0142\u00f3\u017cka \u015bmiertelnie zm\u0119czony. Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea prometeu a algu\u00e9m uma coisinha sem import\u00e2ncia (por exemplo, enviar um v\u00eddeo). Voc\u00ea esqueceu e cai na cama morto de cansa\u00e7o \u00e0 noite. O que voc\u00ea est\u00e1 fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043e\u0431\u0435\u0449\u0430\u043b \u043a\u043e\u043c\u0443-\u0442\u043e \u043d\u0435\u0432\u0430\u0436\u043d\u0443\u044e \u043c\u0435\u043b\u043e\u0447\u044c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u0438\u0441\u043b\u0430\u0442\u044c \u0432\u0438\u0434\u0435\u043e). \u0422\u044b \u0437\u0430\u0431\u044b\u043b \u043e\u0431 \u044d\u0442\u043e\u043c \u0438 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u043f\u0430\u0434\u0430\u0435\u0448\u044c \u0432 \u043a\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043c. \u0427\u0442\u043e \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birine \u00f6nemsiz k\u00fc\u00e7\u00fck bir \u015fey s\u00f6z\u00fc verdiniz (\u00f6rne\u011fin video g\u00f6ndermek). Bunu unutuyorsunuz ve ak\u015famlar\u0131 yorgun bir \u015fekilde yata\u011fa d\u00fc\u015f\u00fcyorsunuz. Ne yap\u0131yorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7b54\u5e94\u4e86\u67d0\u4eba\u4e00\u4ef6\u65e0\u5173\u7d27\u8981\u7684\u5c0f\u4e8b\uff08\u4f8b\u5982\uff0c\u53d1\u9001\u4e00\u4e2a\u89c6\u9891\uff09\u3002\u4f60\u5fd8\u8bb0\u4e86\uff0c\u665a\u4e0a\u7b4b\u75b2\u529b\u5c3d\u5730\u5012\u5728\u5e8a\u4e0a\u3002\u4f60\u4f1a\u600e\u4e48\u529e\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5411\u67d0\u4eba\u627f\u8afe\u4e86\u4e00\u4ef6\u4e0d\u91cd\u8981\u7684\u5c0f\u4e8b\uff08\u4f8b\u5982\u767c\u9001\u5f71\u7247\uff09\u3002\u4f60\u5fd8\u4e86\u9019\u4ef6\u4e8b\uff0c\u665a\u4e0a\u75b2\u618a\u4e0d\u582a\u5730\u5012\u5728\u5e8a\u4e0a\u3002\u4f60\u5728\u5e79\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q4.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Egal. Ich mache es einfach gar nicht mehr, f\u00e4llt eh nicht auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't matter. I just don't do it anymore, it's not noticeable anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No importa. Simplemente ya no lo hago, de todos modos no se nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n'a pas d'importance. Je ne le fais plus, ce n'est pas perceptible de toute fa\u00e7on."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u092b\u0930\u094d\u0915 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0924\u093e\u0964 \u092e\u0948\u0902 \u0905\u092c \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e, \u0935\u0948\u0938\u0947 \u092d\u0940 \u092f\u0939 \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non importa. Semplicemente non lo faccio pi\u00f9, comunque non si nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95a2\u4fc2\u306a\u3044\u3002\u3082\u3046\u3084\u3089\u306a\u3044\u3060\u3051\u3067\u76ee\u7acb\u305f\u306a\u3044\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\uad00\uc5c6\uc5b4\uc694. \ub098\ub294 \ub354 \uc774\uc0c1 \uadf8\uac83\uc744\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc5b4\ucc28\ud53c \ub208\uc5d0 \ub744\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt niet uit. Ik doe het gewoon niet meer, het valt sowieso niet op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma znaczenia. Po prostu ju\u017c tego nie robi\u0119, i tak nie jest to zauwa\u017calne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o importa. Eu simplesmente n\u00e3o fa\u00e7o mais isso, n\u00e3o \u00e9 percept\u00edvel de qualquer maneira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u0440\u0430\u0432\u043d\u043e. \u042f \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u044d\u0442\u043e\u0433\u043e \u043d\u0435 \u0434\u0435\u043b\u0430\u044e, \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u044f\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6nemli de\u011fil. Art\u0131k yapm\u0131yorum, zaten fark edilmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6240\u8c13\u3002\u6211\u5e72\u8106\u4e0d\u505a\u4e86\uff0c\u53cd\u6b63\u4e5f\u6ca1\u4eba\u6ce8\u610f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u95dc\u4fc2\u3002\u6211\u53ea\u662f\u4e0d\u518d\u9019\u9ebc\u505a\u4e86\uff0c\u53cd\u6b63\u4e5f\u4e0d\u5f15\u4eba\u6ce8\u76ee\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q4.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schreibe morgen, dass ich eingeschlafen bin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll write tomorrow that I fell asleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u00f1ana escribir\u00e9 que me qued\u00e9 dormido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'\u00e9crirai demain que je me suis endormi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u0932 \u0932\u093f\u0916\u0942\u0902\u0917\u093e \u0915\u093f \u092e\u0948\u0902 \u0938\u094b \u0917\u092f\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domani scriver\u00f2 che mi sono addormentato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u660e\u65e5\u306f\u7720\u3063\u305f\u3053\u3068\u3092\u66f8\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\uc77c \uc7a0\ub4e4\uc5c8\ub2e4\uace0 \uc4f0\uaca0\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik schrijf morgen dat ik in slaap ben gevallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jutro napisz\u0119, \u017ce zasn\u0105\u0142em."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreverei amanh\u00e3 que adormeci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0430\u043f\u0438\u0448\u0443 \u0437\u0430\u0432\u0442\u0440\u0430, \u0447\u0442\u043e \u0437\u0430\u0441\u043d\u0443\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yar\u0131n uyuyakald\u0131\u011f\u0131m\u0131 yazaca\u011f\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u660e\u5929\u5199\uff0c\u6211\u7761\u7740\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u660e\u5929\u6211\u6703\u5beb\u6211\u7761\u8457\u4e86\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q4.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe liegen und mache es als Allererstes am n\u00e4chsten Morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I stay in bed and do it first thing the next morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me quedo en la cama y lo hago a primera hora de la ma\u00f1ana siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reste au lit et je le fais d\u00e8s le lendemain matin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u0939\u0940 \u0930\u0939\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u0917\u0932\u0940 \u0938\u0941\u092c\u0939 \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 \u092f\u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resto a letto e lo faccio per prima cosa la mattina dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u30d9\u30c3\u30c9\u306b\u3044\u3066\u3001\u7fcc\u671d\u4e00\u756a\u306b\u305d\u308c\u3092\u884c\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uce68\ub300\uc5d0 \ub204\uc6cc\uc11c \ub2e4\uc74c\ub0a0 \uc544\uce68\uc5d0 \uac00\uc7a5 \uba3c\uc800 \uadf8\uac83\uc744 \ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf in bed en doe het de volgende ochtend als eerste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Le\u017c\u0119 w \u0142\u00f3\u017cku i robi\u0119 to od razu nast\u0119pnego ranka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu fico na cama e fa\u00e7o isso logo na manh\u00e3 seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0441\u0442\u0430\u044e\u0441\u044c \u043b\u0435\u0436\u0430\u0442\u044c \u0438 \u0434\u0435\u043b\u0430\u044e \u044d\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0443\u0442\u0440\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatakta kal\u0131yorum ve ertesi sabah ilk i\u015f bunu yap\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8eba\u4e0b\uff0c\u7b2c\u4e8c\u5929\u65e9\u4e0a\u9996\u5148\u53bb\u505a\u8fd9\u4ef6\u4e8b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8eba\u5728\u5e8a\u4e0a\uff0c\u9694\u5929\u65e9\u4e0a\u7b2c\u4e00\u4ef6\u4e8b\u5c31\u662f\u505a\u9019\u4ef6\u4e8b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q4.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stehe wieder auf, schalte den Laptop an und schicke es. Mein Wort ist absolutes Gesetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get back up, turn on the laptop and send it. My word is absolute law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me levanto, enciendo el port\u00e1til y lo env\u00edo. Mi palabra es ley absoluta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me rel\u00e8ve, allume l'ordinateur portable et l'envoie. Ma parole est une loi absolue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0935\u093e\u092a\u0938 \u0909\u0920\u0924\u093e \u0939\u0942\u0902, \u0932\u0948\u092a\u091f\u0949\u092a \u091a\u093e\u0932\u0942 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092d\u0947\u091c \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964 \u092e\u0947\u0930\u093e \u0936\u092c\u094d\u0926 \u092a\u0942\u0930\u094d\u0923 \u0915\u093e\u0928\u0942\u0928 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alzo, accendo il portatile e lo invio. La mia parola \u00e8 legge assoluta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u3061\u4e0a\u304c\u3063\u3066\u30e9\u30c3\u30d7\u30c8\u30c3\u30d7\u306e\u96fb\u6e90\u3092\u5165\u308c\u3066\u9001\u4fe1\u3057\u307e\u3059\u3002\u79c1\u306e\u8a00\u8449\u306f\u7d76\u5bfe\u6cd5\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub2e4\uc2dc \uc77c\uc5b4\ub098 \ub178\ud2b8\ubd81\uc744 \ucf1c\uace0 \ubcf4\ub0b8\ub2e4. \ub0b4 \ub9d0\uc740 \uc808\ub300\uc801\uc778 \ubc95\uce59\uc774\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sta weer op, zet de laptop aan en verstuur het. Mijn woord is absolute wet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wracam, w\u0142\u0105czam laptopa i wysy\u0142am. Moje s\u0142owo jest prawem absolutnym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me levanto, ligo o laptop e envio. Minha palavra \u00e9 lei absoluta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043d\u043e\u0432\u0430 \u0432\u0441\u0442\u0430\u044e, \u0432\u043a\u043b\u044e\u0447\u0430\u044e \u043d\u043e\u0443\u0442\u0431\u0443\u043a \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e \u044d\u0442\u043e. \u041c\u043e\u0451 \u0441\u043b\u043e\u0432\u043e \u2014 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u044b\u0439 \u0437\u0430\u043a\u043e\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aya\u011fa kalk\u0131yorum, diz\u00fcst\u00fc bilgisayar\u0131 a\u00e7\u0131yorum ve g\u00f6nderiyorum. Benim s\u00f6z\u00fcm mutlak kanundur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53c8\u7ad9\u8d77\u6765\uff0c\u6253\u5f00\u7b14\u8bb0\u672c\u7535\u8111\u5e76\u53d1\u9001\u5b83\u3002\u6211\u7684\u8bdd\u5c31\u662f\u7edd\u5bf9\u7684\u6cd5\u5f8b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7ad9\u8d77\u4f86\uff0c\u6253\u958b\u7b46\u8a18\u578b\u96fb\u8166\u4e26\u767c\u9001\u5b83\u3002\u6211\u7684\u8a71\u5c31\u662f\u7d55\u5c0d\u7684\u6cd5\u5f8b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q5": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du betrittst einen Raum voller Fremder (z.B. ein Klassenzimmer oder ein Event). Wie ist deine K\u00f6rpersprache?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You enter a room full of strangers (e.g. a classroom or an event). How is your body language?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entras en una habitaci\u00f3n llena de extra\u00f1os (por ejemplo, un sal\u00f3n de clases o un evento). \u00bfC\u00f3mo es tu lenguaje corporal?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous entrez dans une pi\u00e8ce pleine d'\u00e9trangers (par exemple une salle de classe ou un \u00e9v\u00e9nement). Comment est votre langage corporel ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u091c\u0928\u092c\u093f\u092f\u094b\u0902 \u0938\u0947 \u092d\u0930\u0947 \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 (\u091c\u0948\u0938\u0947 \u0915\u094b\u0908 \u0915\u0915\u094d\u0937\u093e \u092f\u093e \u0915\u094b\u0908 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e)\u0964 \u0906\u092a\u0915\u0940 \u092c\u0949\u0921\u0940 \u0932\u0948\u0902\u0917\u094d\u0935\u0947\u091c \u0915\u0948\u0938\u0940 \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entri in una stanza piena di estranei (ad esempio un'aula o un evento). Com'\u00e8 il tuo linguaggio del corpo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u898b\u77e5\u3089\u306c\u4eba\u304c\u305f\u304f\u3055\u3093\u3044\u308b\u90e8\u5c4b (\u6559\u5ba4\u3084\u30a4\u30d9\u30f3\u30c8\u306a\u3069) \u306b\u5165\u308a\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30dc\u30c7\u30a3\u30fc\u30e9\u30f3\u30b2\u30fc\u30b8\u306f\u3069\u3046\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ub0af\uc120 \uc0ac\ub78c\ub4e4\ub85c \uac00\ub4dd \ucc2c \ubc29(\uc608: \uad50\uc2e4\uc774\ub098 \ud589\uc0ac)\uc5d0 \ub4e4\uc5b4\uac11\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc2e0\uccb4 \uc5b8\uc5b4\ub294 \uc5b4\ub5bb\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je komt een ruimte binnen vol vreemden (bijvoorbeeld een klaslokaal of een evenement). Hoe is jouw lichaamstaal?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wchodzisz do pokoju pe\u0142nego nieznajomych (np. do klasy lub na wydarzenie). Jaka jest Twoja mowa cia\u0142a?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea entra em uma sala cheia de estranhos (por exemplo, uma sala de aula ou um evento). Como est\u00e1 sua linguagem corporal?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0432\u0445\u043e\u0434\u0438\u0448\u044c \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0443, \u043f\u043e\u043b\u043d\u0443\u044e \u043d\u0435\u0437\u043d\u0430\u043a\u043e\u043c\u0446\u0435\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432 \u043a\u043b\u0430\u0441\u0441 \u0438\u043b\u0438 \u043d\u0430 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0435). \u041a\u0430\u043a\u043e\u0432 \u0442\u0432\u043e\u0439 \u044f\u0437\u044b\u043a \u0442\u0435\u043b\u0430?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabanc\u0131larla dolu bir odaya giriyorsunuz (\u00f6rne\u011fin bir s\u0131n\u0131fa veya bir etkinli\u011fe). Beden diliniz nas\u0131l?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u8d70\u8fdb\u4e00\u4e2a\u5145\u6ee1\u964c\u751f\u4eba\u7684\u623f\u95f4\uff08\u4f8b\u5982\u6559\u5ba4\u6216\u6d3b\u52a8\u73b0\u573a\uff09\u3002\u4f60\u7684\u80a2\u4f53\u8bed\u8a00\u662f\u4ec0\u4e48\u6837\u7684\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u9032\u5165\u4e00\u500b\u5145\u6eff\u964c\u751f\u4eba\u7684\u623f\u9593\uff08\u4f8b\u5982\u6559\u5ba4\u6216\u6d3b\u52d5\uff09\u3002\u4f60\u7684\u80a2\u9ad4\u8a9e\u8a00\u600e\u9ebc\u6a23\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q5.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schaue auf den Boden, mache mich klein und suche mir schnell einen Platz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I look at the floor, make myself small and quickly look for a place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miro al suelo, me hago peque\u00f1o y r\u00e1pidamente busco un lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je regarde le sol, me fais petit et cherche rapidement une place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092b\u0930\u094d\u0936 \u0915\u094b \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0902, \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b \u091b\u094b\u091f\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u091c\u0932\u094d\u0926\u0940 \u0938\u0947 \u091c\u0917\u0939 \u0922\u0942\u0902\u0922\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardo il pavimento, mi rimpicciolisco e cerco velocemente un posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5e8a\u3092\u898b\u3066\u3001\u8eab\u3092\u5c0f\u3055\u304f\u3057\u3001\u6025\u3044\u3067\u5834\u6240\u3092\u63a2\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ubc14\ub2e5\uc744\ubcf4\uace0 \ubab8\uc744 \uc791\uac8c \ub9cc\ub4e4\uace0 \ube60\ub974\uac8c \uc7a5\uc18c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kijk naar de vloer, maak mezelf klein en zoek snel een plekje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz\u0119 w pod\u0142og\u0119, robi\u0119 si\u0119 ma\u0142y i szybko szukam miejsca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olho para o ch\u00e3o, fico pequeno e rapidamente procuro um lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043c\u043e\u0442\u0440\u044e \u043d\u0430 \u043f\u043e\u043b, \u0434\u0435\u043b\u0430\u044e \u0441\u0435\u0431\u044f \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c \u0438 \u0431\u044b\u0441\u0442\u0440\u043e \u0438\u0449\u0443 \u043c\u0435\u0441\u0442\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yere bak\u0131yorum, kendimi k\u00fc\u00e7\u00fclt\u00fcyorum ve h\u0131zla bir yer ar\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4f4e\u5934\u770b\u5730\uff0c\u7f29\u5c0f\u81ea\u5df1\uff0c\u5feb\u901f\u627e\u4e2a\u4f4d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u770b\u8457\u5730\u677f\uff0c\u628a\u81ea\u5df1\u7e2e\u5c0f\uff0c\u8fc5\u901f\u5c0b\u627e\u5730\u65b9\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q5.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schaue auf mein Handy, um besch\u00e4ftigt auszusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I look at my phone to look busy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miro mi tel\u00e9fono para parecer ocupado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je regarde mon t\u00e9l\u00e9phone pour avoir l'air occup\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0935\u094d\u092f\u0938\u094d\u0924 \u0926\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0928 \u0915\u094b \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardo il telefono per sembrare occupato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u643a\u5e2f\u96fb\u8a71\u3092\u898b\u308b\u3068\u5fd9\u3057\u305d\u3046\u306b\u898b\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc14\uc05c \ud45c\uc815\uc73c\ub85c \ud734\ub300\ud3f0\uc744 \ubcf8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kijk naar mijn telefoon en zie dat het druk is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz\u0119 na telefon i wygl\u0105dam na zaj\u0119tego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu olho para o meu telefone para parecer ocupado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043c\u043e\u0442\u0440\u044e \u043d\u0430 \u0441\u0432\u043e\u0439 \u0442\u0435\u043b\u0435\u0444\u043e\u043d, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u0442\u044c \u0437\u0430\u043d\u044f\u0442\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me\u015fgul g\u00f6r\u00fcnmek i\u00e7in telefonuma bak\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u770b\u7740\u624b\u673a\uff0c\u4ee5\u663e\u5f97\u81ea\u5df1\u5f88\u5fd9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u770b\u8457\u624b\u6a5f\uff0c\u770b\u8d77\u4f86\u5f88\u5fd9\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q5.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe normal rein und nicke ein paar Leuten zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I go in normally and nod to a few people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro normalmente y asiento con la cabeza hacia algunas personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'entre normalement et je fais un signe de t\u00eate \u00e0 quelques personnes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0905\u0902\u0926\u0930 \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0915\u0941\u091b \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u0913\u0930 \u0938\u093f\u0930 \u0939\u093f\u0932\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro normalmente e annuisco ad alcune persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u666e\u901a\u306b\u5165\u3063\u3066\u4f55\u4eba\u304b\u306b\u3046\u306a\u305a\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud3c9\uc18c\ub300\ub85c \ub4e4\uc5b4\uac00\uc11c \uba87 \uc0ac\ub78c\uc5d0\uac8c \uace0\uac1c\ub97c \ub044\ub355\uc778\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga normaal naar binnen en knik naar een paar mensen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wchodz\u0119 normalnie i kiwam g\u0142ow\u0105 kilku osobom."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entro normalmente e aceno para algumas pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u0445\u043e\u0436\u0443 \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u043e \u0438 \u043a\u0438\u0432\u0430\u044e \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c \u043b\u044e\u0434\u044f\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal bir \u015fekilde i\u00e7eri girip birka\u00e7 ki\u015fiye ba\u015f\u0131m\u0131 sallad\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6b63\u5e38\u5730\u8d70\u8fdb\u53bb\uff0c\u5411\u51e0\u4e2a\u4eba\u70b9\u5934\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7167\u5e38\u9032\u53bb\uff0c\u5411\u5e7e\u500b\u4eba\u9ede\u982d\u81f4\u610f\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q5.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schultern zur\u00fcck, Kopf hoch, Augenkontakt. Ich nehme den Raum ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders back, head up, eye contact. I take up the space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombros hacia atr\u00e1s, cabeza erguida, contacto visual. Ocupo el espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9paules en arri\u00e8re, t\u00eate haute, contact visuel. Je prends de la place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0902\u0927\u0947 \u092a\u0940\u091b\u0947, \u0938\u093f\u0930 \u090a\u092a\u0930, \u0906\u0901\u0916 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915\u0964 \u092e\u0948\u0902 \u091c\u0917\u0939 \u0932\u0947\u0924\u093e \u0939\u0942\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalle indietro, testa alta, contatto visivo. Occupo lo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u80a9\u3092\u5f8c\u308d\u306b\u623b\u3057\u3001\u982d\u3092\u4e0a\u3052\u3001\u30a2\u30a4\u30b3\u30f3\u30bf\u30af\u30c8\u3092\u3057\u307e\u3059\u3002\u5834\u6240\u3092\u53d6\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\uae68\ub97c \ub4a4\ub85c \uc816\ud788\uace0, \uace0\uac1c\ub97c \ub4e4\uace0, \ub208\uc744 \ub9c8\uc8fc\uce58\uc138\uc694. \ub098\ub294 \uacf5\uac04\uc744 \ucc28\uc9c0\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schouders naar achteren, hoofd omhoog, oogcontact. Ik neem de ruimte in beslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramiona do ty\u0142u, g\u0142owa do g\u00f3ry, kontakt wzrokowy. Zajmuj\u0119 przestrze\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombros para tr\u00e1s, cabe\u00e7a erguida, contato visual. Eu ocupo o espa\u00e7o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043b\u0435\u0447\u0438 \u043d\u0430\u0437\u0430\u0434, \u0433\u043e\u043b\u043e\u0432\u0430 \u0432\u044b\u0441\u043e\u043a\u043e, \u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0430\u043a\u0442. \u042f \u0437\u0430\u043d\u0438\u043c\u0430\u044e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuzlar geride, ba\u015f yukar\u0131da, g\u00f6z temas\u0131. Ben yer kapl\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u80a9\u8180\u5411\u540e\uff0c\u62ac\u5934\uff0c\u773c\u795e\u4ea4\u6d41\u3002\u6211\u5360\u636e\u8fd9\u4e2a\u7a7a\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u80a9\u8180\u5411\u5f8c\uff0c\u982d\u90e8\u62ac\u8d77\uff0c\u76ee\u5149\u63a5\u89f8\u3002\u6211\u4f54\u4e86\u7a7a\u9593\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q6": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ffne Instagram/TikTok und schau dir an, wem du folgst. Was dominiert deinen Feed?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instagram/TikTok and look at who you follow. What dominates your feed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Instagram/TikTok y mira a qui\u00e9n sigues. \u00bfQu\u00e9 domina tu feed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Instagram/TikTok et regardez qui vous suivez. Qu'est-ce qui domine votre flux\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0902\u0938\u094d\u091f\u093e\u0917\u094d\u0930\u093e\u092e/\u091f\u093f\u0915\u091f\u0949\u0915 \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0926\u0947\u0916\u0947\u0902 \u0915\u093f \u0906\u092a \u0915\u093f\u0938\u0947 \u092b\u093c\u0949\u0932\u094b \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u092b\u093c\u0940\u0921 \u092a\u0930 \u0915\u094d\u092f\u093e \u0939\u093e\u0935\u0940 \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Instagram/TikTok e guarda chi segui. Cosa domina il tuo feed?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram/TikTok \u3092\u958b\u3044\u3066\u3001\u30d5\u30a9\u30ed\u30fc\u3057\u3066\u3044\u308b\u4eba\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30d5\u30a3\u30fc\u30c9\u3092\u652f\u914d\u3057\u3066\u3044\u308b\u3082\u306e\u306f\u4f55\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram/TikTok\uc744 \uc5f4\uace0 \ub2f9\uc2e0\uc774 \ud314\ub85c\uc6b0\ud558\ub294 \uc0ac\ub78c\uc744 \uc0b4\ud3b4\ubcf4\uc138\uc694. \ub2f9\uc2e0\uc758 \ud53c\ub4dc\ub97c \uc9c0\ubc30\ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instagram/TikTok en kijk wie je volgt. Wat domineert jouw feed?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otw\u00f3rz Instagram/TikTok i zobacz, kogo obserwujesz. Co dominuje w Twoim kanale?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Instagram/TikTok e veja quem voc\u00ea segue. O que domina seu feed?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u043e\u0439 Instagram/TikTok \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438, \u043a\u043e\u043c\u0443 \u0442\u044b \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d. \u0427\u0442\u043e \u0434\u043e\u043c\u0438\u043d\u0438\u0440\u0443\u0435\u0442 \u0432 \u0442\u0432\u043e\u0435\u0439 \u043b\u0435\u043d\u0442\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram/TikTok'u a\u00e7\u0131n ve kimi takip etti\u011finize bak\u0131n. Feed'inize ne hakim?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u5f00 Instagram/TikTok \u770b\u770b\u4f60\u5173\u6ce8\u4e86\u8c01\u3002\u4ec0\u4e48\u5185\u5bb9\u5728\u4f60\u7684\u52a8\u6001\u4e2d\u5360\u4e3b\u5bfc\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u958b Instagram/TikTok \u4e26\u67e5\u770b\u60a8\u95dc\u6ce8\u7684\u4eba\u3002\u4ec0\u9ebc\u5728\u4f60\u7684\u98fc\u6599\u4e2d\u5360\u4e3b\u5c0e\u5730\u4f4d\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q6.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meme-Seiten, Trash-TV, Drama und oberfl\u00e4chliche Influencer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meme pages, trash TV, drama and superficial influencers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u00e1ginas de memes, televisi\u00f3n basura, dramas e influencers superficiales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages m\u00e8mes, trash TV, drames et influenceurs superficiels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0940\u092e \u092a\u0947\u091c, \u0915\u091a\u0930\u093e \u091f\u0940\u0935\u0940, \u0928\u093e\u091f\u0915 \u0914\u0930 \u0938\u0924\u0939\u0940 \u092a\u094d\u0930\u092d\u093e\u0935\u0936\u093e\u0932\u0940 \u0932\u094b\u0917\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagine di meme, TV spazzatura, drammi e influencer superficiali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30df\u30fc\u30e0\u30da\u30fc\u30b8\u3001\u30b4\u30df\u30c6\u30ec\u30d3\u3001\u30c9\u30e9\u30de\u3001\u8868\u9762\u7684\u306a\u30a4\u30f3\u30d5\u30eb\u30a8\u30f3\u30b5\u30fc\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc08 \ud398\uc774\uc9c0, \uc4f0\ub808\uae30 TV, \ub4dc\ub77c\ub9c8, \ud53c\uc0c1\uc801\uc778 \uc601\ud5a5\ub825 \uc788\ub294 \uc0ac\ub78c\ub4e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Memepagina's, trash-tv, drama en oppervlakkige influencers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony z memami, \u015bmieciowa telewizja, dramaty i powierzchowne wp\u0142ywowe osoby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u00e1ginas de meme, trash TV, drama e influenciadores superficiais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0435\u043c-\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b, \u0442\u0440\u044d\u0448-\u0422\u0412, \u0434\u0440\u0430\u043c\u0430 \u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u044b\u0435 \u0438\u043d\u0444\u043b\u044e\u0435\u043d\u0441\u0435\u0440\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meme sayfalar\u0131, \u00e7\u00f6p TV, drama ve y\u00fczeysel etkileyiciler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ff7\u56e0\u9875\u9762\u3001\u5783\u573e\u7535\u89c6\u3001\u620f\u5267\u548c\u80a4\u6d45\u7684\u7f51\u7ea2\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ff7\u56e0\u9801\u9762\u3001\u5783\u573e\u96fb\u8996\u3001\u6232\u5287\u548c\u819a\u6dfa\u7684\u5f71\u97ff\u8005\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q6.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haupts\u00e4chlich Freunde, Bekannte und ein bisschen Entertainment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainly friends, acquaintances and a bit of entertainment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalmente amigos, conocidos y un poco de entretenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalement des amis, des connaissances et un peu de divertissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0941\u0916\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0926\u094b\u0938\u094d\u0924, \u092a\u0930\u093f\u091a\u093f\u0924 \u0914\u0930 \u0925\u094b\u0921\u093c\u093e \u092e\u0928\u094b\u0930\u0902\u091c\u0928\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalmente amici, conoscenti e un po' di intrattenimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3b\u306b\u53cb\u4eba\u3001\u77e5\u4eba\u3001\u305d\u3057\u3066\u3061\u3087\u3063\u3068\u3057\u305f\u5a2f\u697d\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\ub85c \uce5c\uad6c, \uc9c0\uc778 \ubc0f \uc57d\uac04\uc758 \uc624\ub77d\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voornamelijk vrienden, kennissen en een beetje entertainment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u0142\u00f3wnie przyjaciele, znajomi i troch\u0119 rozrywki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Principalmente amigos, conhecidos e um pouco de divers\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0434\u0440\u0443\u0437\u044c\u044f, \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0435 \u0438 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7o\u011funlukla arkada\u015flar, tan\u0131d\u0131klar ve biraz e\u011flence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3b\u8981\u662f\u670b\u53cb\u3001\u719f\u4eba\u548c\u4e00\u4e9b\u5a31\u4e50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3b\u8981\u662f\u670b\u53cb\u3001\u719f\u4eba\u4ee5\u53ca\u4e00\u4e9b\u5a1b\u6a02\u6d3b\u52d5\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q6.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 Entertainment, 50\uff05 Leute, von denen ich etwas lernen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 entertainment, 50\uff05 people I can learn something from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 entretenimiento, 50\uff05 gente de la que puedo aprender algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "50\u00a0\uff05 de divertissement, 50\u00a0\uff05 de personnes aupr\u00e8s desquelles je peux apprendre quelque chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 \u092e\u0928\u094b\u0930\u0902\u091c\u0928, 50\uff05 \u0932\u094b\u0917 \u091c\u093f\u0928\u0938\u0947 \u092e\u0948\u0902 \u0915\u0941\u091b \u0938\u0940\u0916 \u0938\u0915\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 intrattenimento, 50\uff05 persone da cui posso imparare qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 \u30a8\u30f3\u30bf\u30fc\u30c6\u30a4\u30e1\u30f3\u30c8\u300150\uff05 \u4f55\u304b\u3092\u5b66\u3079\u308b\u4eba\u3005\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05\ub294 \uc5d4\ud130\ud14c\uc778\uba3c\ud2b8\uc774\uace0, 50\uff05\ub294 \ub0b4\uac00 \ubc30\uc6b8 \uc218 \uc788\ub294 \uc0ac\ub78c\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 entertainment, 50\uff05 mensen van wie ik iets kan leren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 rozrywki, 50\uff05 ludzi, od kt\u00f3rych mog\u0119 si\u0119 czego\u015b nauczy\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 entretenimento, 50\uff05 pessoas com quem posso aprender algo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439, 50\uff05 \u043b\u044e\u0434\u0435\u0439, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044f \u043c\u043e\u0433\u0443 \u0447\u0435\u043c\u0443-\u0442\u043e \u043d\u0430\u0443\u0447\u0438\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%50 e\u011flence, \uff0550 bir \u015feyler \u00f6\u011frenebilece\u011fim insanlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05\u7684\u5a31\u4e50\uff0c50\uff05\u7684\u4eba\uff0c\u6211\u80fd\u4ece\u4e2d\u5b66\u5230\u4e1c\u897f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "50\uff05 \u7684\u5a1b\u6a02\uff0c50\uff05 \u7684\u4eba\u6211\u53ef\u4ee5\u5b78\u5230\u6771\u897f\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q6.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Feed ist extrem kuratiert. Ich folge fast nur Accounts, die mich inspirieren oder weiterbilden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My feed is extremely curated. I almost only follow accounts that inspire or educate me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi feed est\u00e1 extremadamente curado. Casi solo sigo cuentas que me inspiran o me educan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mon flux est extr\u00eamement organis\u00e9. Je ne suis presque que les comptes qui m'inspirent ou m'\u00e9duquent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0947\u0930\u093e \u092b\u093c\u0940\u0921 \u092c\u0947\u0939\u0926 \u0915\u094d\u092f\u0942\u0930\u0947\u091f\u0947\u0921 \u0939\u0948\u0964 \u092e\u0948\u0902 \u0932\u0917\u092d\u0917 \u0915\u0947\u0935\u0932 \u0909\u0928\u094d\u0939\u0940\u0902 \u0916\u093e\u0924\u094b\u0902 \u0915\u094b \u092b\u093c\u0949\u0932\u094b \u0915\u0930\u0924\u093e \u0939\u0942\u0901 \u091c\u094b \u092e\u0941\u091d\u0947 \u092a\u094d\u0930\u0947\u0930\u093f\u0924 \u092f\u093e \u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mio feed \u00e8 estremamente curato. Seguo quasi solo account che mi ispirano o mi istruiscono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306e\u30d5\u30a3\u30fc\u30c9\u306f\u975e\u5e38\u306b\u53b3\u9078\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u79c1\u306f\u307b\u3068\u3093\u3069\u3001\u81ea\u5206\u306b\u30a4\u30f3\u30b9\u30d4\u30ec\u30fc\u30b7\u30e7\u30f3\u3092\u4e0e\u3048\u305f\u308a\u3001\u52c9\u5f37\u3055\u305b\u305f\u308a\u3059\u308b\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u307f\u3092\u30d5\u30a9\u30ed\u30fc\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4 \ud53c\ub4dc\ub294 \ub9e4\uc6b0 \uc120\ubcc4\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub098\ub294 \ub098\uc5d0\uac8c \uc601\uac10\uc744 \uc8fc\uac70\ub098 \uad50\uc721\uc744 \uc8fc\ub294 \uacc4\uc815\ub9cc \uac70\uc758 \ud314\ub85c\uc6b0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn feed is uiterst samengesteld. Ik volg bijna alleen accounts die mij inspireren of onderwijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3j kana\u0142 jest niezwykle wyselekcjonowany. Prawie \u015bledz\u0119 tylko konta, kt\u00f3re mnie inspiruj\u0105 lub edukuj\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meu feed \u00e9 extremamente selecionado. Quase s\u00f3 sigo relatos que me inspiram ou me educam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u044f \u043b\u0435\u043d\u0442\u0430 \u0441\u0442\u0440\u043e\u0433\u043e \u043a\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0430. \u042f \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d \u043f\u043e\u0447\u0442\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0435\u043d\u044f \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0442 \u0438\u043b\u0438 \u043e\u0431\u0443\u0447\u0430\u044e\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed'im son derece se\u00e7ilmi\u015f. Neredeyse yaln\u0131zca bana ilham veren veya beni e\u011fiten hesaplar\u0131 takip ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u52a8\u6001\u4fe1\u606f\u6d41\u7ecf\u8fc7\u7cbe\u5fc3\u7b5b\u9009\u3002\u6211\u51e0\u4e4e\u53ea\u5173\u6ce8\u90a3\u4e9b\u80fd\u6fc0\u52b1\u6211\u6216\u8ba9\u6211\u6709\u6240\u5b66\u4e60\u7684\u8d26\u53f7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u63d0\u8981\u7d93\u904e\u7cbe\u5fc3\u7b56\u5283\u3002\u6211\u5e7e\u4e4e\u53ea\u5c08\u6ce8\u65bc\u90a3\u4e9b\u6fc0\u52f5\u6216\u6559\u80b2\u6211\u7684\u5e33\u6236\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q7": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kellner oder Kassierer macht einen extrem dummen Fehler, der dich Zeit kostet. Wie reagierst du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A waiter or cashier makes an extremely stupid mistake that costs you time. How do you react?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un camarero o cajero comete un error extremadamente est\u00fapido que le cuesta tiempo. \u00bfC\u00f3mo reaccionas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur ou un caissier commet une erreur extr\u00eamement stupide qui vous co\u00fbte du temps. Comment r\u00e9agissez-vous ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0935\u0947\u091f\u0930 \u092f\u093e \u0915\u0948\u0936\u093f\u092f\u0930 \u090f\u0915 \u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0942\u0930\u094d\u0916\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u0917\u0932\u0924\u0940 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0906\u092a\u0915\u093e \u0938\u092e\u092f \u092c\u0930\u094d\u092c\u093e\u0926 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0940 \u0915\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cameriere o un cassiere commette un errore estremamente stupido che ti fa perdere tempo. Come reagisci?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a6\u30a7\u30a4\u30bf\u30fc\u3084\u30ec\u30b8\u4fc2\u304c\u975e\u5e38\u306b\u611a\u304b\u306a\u9593\u9055\u3044\u3092\u72af\u3057\u3001\u6642\u9593\u3092\u8cbb\u3084\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u3069\u3046\u53cd\u5fdc\u3057\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6e8\uc774\ud130\ub098 \ucd9c\ub0a9\uc6d0\uc740 \uc2dc\uac04\uc744 \ub0ad\ube44\ud558\uac8c \ub9cc\ub4dc\ub294 \ub9e4\uc6b0 \uc5b4\ub9ac\uc11d\uc740 \uc2e4\uc218\ub97c \ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc5b4\ub5bb\uac8c \ubc18\uc751\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ober of kassier maakt een uiterst domme fout die u tijd kost. Hoe reageer je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelner lub kasjer pope\u0142nia wyj\u0105tkowo g\u0142upi b\u0142\u0105d, kt\u00f3ry kosztuje Ci\u0119 czas. Jak reagujesz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um gar\u00e7om ou caixa comete um erro extremamente est\u00fapido que lhe custa tempo. Como voc\u00ea reage?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0444\u0438\u0446\u0438\u0430\u043d\u0442 \u0438\u043b\u0438 \u043a\u0430\u0441\u0441\u0438\u0440 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043a\u0440\u0430\u0439\u043d\u0435 \u0433\u043b\u0443\u043f\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0442\u043d\u0438\u043c\u0430\u0435\u0442 \u0443 \u0442\u0435\u0431\u044f \u0432\u0440\u0435\u043c\u044f. \u041a\u0430\u043a \u0442\u044b \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir garson ya da kasiyer, zaman\u0131n\u0131za mal olacak son derece aptalca bir hata yapar. Nas\u0131l tepki verirsiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u4e2a\u670d\u52a1\u5458\u6216\u6536\u94f6\u5458\u72af\u4e86\u4e00\u4e2a\u6781\u5176\u611a\u8822\u7684\u9519\u8bef\uff0c\u6d6a\u8d39\u4e86\u4f60\u7684\u65f6\u95f4\u3002\u4f60\u4f1a\u5982\u4f55\u53cd\u5e94\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u670d\u52d9\u751f\u6216\u6536\u9280\u54e1\u72af\u4e86\u4e00\u500b\u6975\u5176\u611a\u8822\u7684\u932f\u8aa4\uff0c\u6d6a\u8cbb\u4e86\u4f60\u7684\u6642\u9593\u3002\u4f60\u6709\u4f55\u53cd\u61c9\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q7.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werde laut, pflaume ihn an und lasse meine schlechte Laune an ihm aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get loud, shout at him and take out my bad mood on him."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hago ruido, le grito y descargo mi mal humor con \u00e9l."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je fais du bruit, je lui crie dessus et je lui fais subir ma mauvaise humeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u094b\u0930 \u0938\u0947 \u091a\u093f\u0932\u094d\u0932\u093e\u0924\u093e \u0939\u0942\u0902, \u0909\u0938 \u092a\u0930 \u091a\u093f\u0932\u094d\u0932\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e \u092c\u0941\u0930\u093e \u092e\u0942\u0921 \u0909\u0938 \u092a\u0930 \u0928\u093f\u0915\u093e\u0932\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alzo ad alta voce, gli grido contro e sfogo il mio cattivo umore su di lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5927\u58f0\u3067\u6012\u9cf4\u3063\u305f\u308a\u3001\u5f7c\u306e\u6a5f\u5acc\u3092\u60aa\u304f\u3057\u305f\u308a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud070 \uc18c\ub9ac\ub85c \uadf8\uc5d0\uac8c \uc18c\ub9ac\ub97c \uc9c0\ub974\uace0 \uadf8\uc5d0\uac8c \ub098\uc05c \uae30\ubd84\uc744 \ud138\uc5b4 \ub193\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik word luid, schreeuw tegen hem en reageer mijn slechte humeur op hem af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Robi\u0119 si\u0119 g\u0142o\u015bno, krzycz\u0119 na niego i wy\u0142adowuj\u0119 na nim sw\u00f3j z\u0142y humor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa\u00e7o barulho, grito com ele e desconto meu mau humor nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0441\u044c \u0433\u0440\u043e\u043c\u043a\u0438\u043c, \u043e\u0442\u0440\u0443\u0433\u0430\u044e \u0435\u0433\u043e \u0438 \u0432\u044b\u043c\u0435\u0449\u0430\u044e \u043d\u0430 \u043d\u0451\u043c \u0441\u0432\u043e\u0451 \u043f\u043b\u043e\u0445\u043e\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesimi y\u00fckseltiyorum, ona ba\u011f\u0131r\u0131yorum ve k\u00f6t\u00fc ruh halimi ondan \u00e7\u0131kar\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4f1a\u5927\u58f0\u558a\uff0c\u6279\u8bc4\u4ed6\uff0c\u5e76\u628a\u6211\u7684\u574f\u60c5\u7eea\u53d1\u6cc4\u5728\u4ed6\u8eab\u4e0a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5927\u8072\u5730\u5c0d\u4ed6\u5927\u558a\u5927\u53eb\uff0c\u628a\u6211\u7684\u58de\u5fc3\u60c5\u767c\u6d29\u5728\u4ed6\u8eab\u4e0a\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q7.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich rolle offensichtlich mit den Augen und seufze laut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I obviously roll my eyes and sigh loudly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obviamente pongo los ojos en blanco y suspiro ruidosamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je l\u00e8ve \u00e9videmment les yeux au ciel et soupire bruyamment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0905\u092a\u0928\u0940 \u0906\u0901\u0916\u0947\u0902 \u0918\u0941\u092e\u093e\u0924\u093e \u0939\u0942\u0901 \u0914\u0930 \u091c\u094b\u0930 \u0938\u0947 \u0906\u0939\u0947\u0902 \u092d\u0930\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovviamente alzo gli occhi al cielo e sospiro forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u660e\u3089\u304b\u306b\u76ee\u3092\u4e38\u304f\u3057\u3001\u5927\u304d\u306a\u305f\u3081\u606f\u3092\u3064\u304d\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ubd84\uba85\ud788 \ub208\uc744 \uad74\ub9ac\uace0 \ud06c\uac8c \ud55c\uc228\uc744 \uc26c\uc5c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik rol duidelijk met mijn ogen en zucht luid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczywi\u015bcie przewracam oczami i g\u0142o\u015bno wzdycham."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obviamente reviro os olhos e suspiro alto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u044f\u0432\u043d\u043e \u0437\u0430\u043a\u0430\u0442\u044b\u0432\u0430\u044e \u0433\u043b\u0430\u0437\u0430 \u0438 \u0433\u0440\u043e\u043c\u043a\u043e \u0432\u0437\u0434\u044b\u0445\u0430\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00e7\u0131k\u00e7as\u0131 g\u00f6zlerimi deviriyorum ve y\u00fcksek sesle i\u00e7 \u00e7ekiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u663e\u7136\u5728\u7ffb\u767d\u773c\u5e76\u5927\u58f0\u53f9\u6c14\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u986f\u7136\u7ffb\u4e86\u500b\u767d\u773c\uff0c\u5927\u8072\u5606\u4e86\u53e3\u6c23\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q7.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage nichts und \u00e4rgere mich still."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say nothing and am silently annoyed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No digo nada y estoy silenciosamente molesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne dis rien et suis silencieusement ennuy\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u093e \u0914\u0930 \u091a\u0941\u092a\u091a\u093e\u092a \u0928\u093e\u0930\u093e\u091c\u093c \u0930\u0939\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dico nulla e sono silenziosamente infastidito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u4f55\u3082\u8a00\u308f\u305a\u3001\u9759\u304b\u306b\u30a4\u30e9\u30a4\u30e9\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc544\ubb34 \ub9d0\ub3c4 \ud558\uc9c0 \uc54a\uace0 \uc870\uc6a9\ud788 \uc9dc\uc99d\uc744 \ub0b8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg niets en ben stilletjes ge\u00efrriteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie m\u00f3wi\u0119 i cicho jestem zirytowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o digo nada e fico silenciosamente irritado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044e \u0438 \u0442\u0438\u0445\u043e \u0437\u043b\u044e\u0441\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u00e7bir \u015fey s\u00f6ylemiyorum ve sessizce sinirleniyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4ec0\u4e48\u4e5f\u4e0d\u8bf4\uff0c\u9ed8\u9ed8\u751f\u6c14\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4ec0\u9ebc\u4e5f\u6c92\u8aaa\uff0c\u9ed8\u9ed8\u5730\u751f\u6c23\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q7.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe vollkommen ruhig und h\u00f6flich. Wie ich andere behandle, ist ein Spiegel *meines* Standards."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I remain completely calm and polite. How I treat others is a reflection of *my* standards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanezco completamente tranquilo y educado. La forma en que trato a los dem\u00e1s es un reflejo de *mis* est\u00e1ndares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reste compl\u00e8tement calme et poli. La fa\u00e7on dont je traite les autres est le reflet de *mes* normes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0936\u093e\u0902\u0924 \u0914\u0930 \u0935\u093f\u0928\u092e\u094d\u0930 \u0930\u0939\u0924\u093e \u0939\u0942\u0902.' \u092e\u0948\u0902 \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0915\u0948\u0938\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0942\u0901 \u092f\u0939 *\u092e\u0947\u0930\u0947* \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0924\u093f\u092c\u093f\u0902\u092c \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimango completamente calmo ed educato. Il modo in cui tratto gli altri riflette i *miei* standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5b8c\u5168\u306b\u51b7\u9759\u304b\u3064\u793c\u5100\u6b63\u3057\u3044\u614b\u5ea6\u3092\u4fdd\u3063\u3066\u3044\u307e\u3059\u3002\u79c1\u304c\u4ed6\u4eba\u3092\u3069\u306e\u3088\u3046\u306b\u6271\u3046\u304b\u306f\u3001*\u79c1\u306e* \u57fa\u6e96\u3092\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc644\uc804\ud788 \uce68\ucc29\ud558\uace0 \uc608\uc758\ubc14\ub974\uac8c \ud589\ub3d9\ud569\ub2c8\ub2e4. \ub0b4\uac00 \ub2e4\ub978 \uc0ac\ub78c\uc744 \ub300\ud558\ub294 \ubc29\uc2dd\uc740 *\ub098\uc758* \uae30\uc900\uc744 \ubc18\uc601\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf volkomen kalm en beleefd. Hoe ik anderen behandel, is een weerspiegeling van *mijn* normen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuj\u0119 ca\u0142kowity spok\u00f3j i grzeczno\u015b\u0107. To, jak traktuj\u0119 innych, jest odzwierciedleniem *moich* standard\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permane\u00e7o completamente calmo e educado. A forma como trato os outros \u00e9 um reflexo dos *meus* padr\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0441\u0442\u0430\u044e\u0441\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b\u043c \u0438 \u0432\u0435\u0436\u043b\u0438\u0432\u044b\u043c. \u0422\u043e, \u043a\u0430\u043a \u044f \u043e\u0442\u043d\u043e\u0448\u0443\u0441\u044c \u043a \u0434\u0440\u0443\u0433\u0438\u043c, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c *\u043c\u043e\u0435\u0433\u043e* \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen sakin ve kibar kal\u0131yorum. Ba\u015fkalar\u0131na nas\u0131l davrand\u0131\u011f\u0131m *kendi* standartlar\u0131m\u0131n bir yans\u0131mas\u0131d\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4fdd\u6301\u5b8c\u5168\u7684\u51b7\u9759\u548c\u793c\u8c8c\u3002\u6211\u5bf9\u5f85\u4ed6\u4eba\u7684\u65b9\u5f0f\uff0c\u662f\u6211\u6807\u51c6\u7684\u53cd\u6620\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4fdd\u6301\u5b8c\u5168\u51b7\u975c\u548c\u79ae\u8c8c\u3002\u6211\u5982\u4f55\u5c0d\u5f85\u4ed6\u4eba\u53cd\u6620\u4e86\u300c\u6211\u7684\u300d\u6a19\u6e96\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q8": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Freunde fangen an, \u00fcber jemanden herzuziehen, der nicht im Raum ist. Wie verh\u00e4ltst du dich?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your friends start making fun of someone who isn't in the room. How are you behaving?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos empiezan a burlarse de alguien que no est\u00e1 en la sala. \u00bfC\u00f3mo te comportas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos amis commencent \u00e0 se moquer de quelqu'un qui n'est pas dans la pi\u00e8ce. Comment vous comportez-vous ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u0926\u094b\u0938\u094d\u0924 \u0915\u093f\u0938\u0940 \u0910\u0938\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u092e\u091c\u093c\u093e\u0915 \u0909\u0921\u093c\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0906\u092a \u0915\u0948\u0938\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi amici iniziano a prendere in giro qualcuno che non \u00e8 nella stanza. Come ti stai comportando?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53cb\u9054\u304c\u305d\u306e\u90e8\u5c4b\u306b\u3044\u306a\u3044\u4eba\u3092\u304b\u3089\u304b\u3044\u59cb\u3081\u307e\u3059\u3002\u8abf\u5b50\u306f\u3069\u3046\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce5c\uad6c\ub4e4\uc740 \ubc29\uc5d0 \uc5c6\ub294 \uc0ac\ub78c\uc744 \ub180\ub9ac\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc5b4\ub5bb\uac8c \ud589\ub3d9\ud558\uace0 \uc788\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vrienden beginnen iemand uit te lachen die niet in de kamer is. Hoe gedraag jij je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoi przyjaciele zaczynaj\u0105 na\u015bmiewa\u0107 si\u0119 z kogo\u015b, kogo nie ma w pokoju. Jak si\u0119 zachowujesz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus amigos come\u00e7am a zombar de algu\u00e9m que n\u00e3o est\u00e1 na sala. Como voc\u00ea est\u00e1 se comportando?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0438 \u0434\u0440\u0443\u0437\u044c\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044c \u043a\u043e\u0433\u043e-\u0442\u043e \u0437\u0430 \u0441\u043f\u0438\u043d\u043e\u0439, \u043a\u0442\u043e \u043d\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043a\u043e\u043c\u043d\u0430\u0442\u0435. \u041a\u0430\u043a \u0442\u044b \u0441\u0435\u0431\u044f \u0432\u0435\u0434\u0451\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkada\u015flar\u0131n\u0131z odada olmayan biriyle dalga ge\u00e7meye ba\u015flar. Nas\u0131l davran\u0131yorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u670b\u53cb\u4eec\u5f00\u59cb\u8bf4\u4e0d\u5728\u573a\u7684\u4eba\u7684\u574f\u8bdd\u3002\u4f60\u4f1a\u600e\u4e48\u505a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u670b\u53cb\u958b\u59cb\u53d6\u7b11\u4e0d\u5728\u623f\u9593\u88e1\u7684\u4eba\u3002\u4f60\u8868\u73fe\u5f97\u600e\u9ebc\u6a23\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q8.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich mache sofort mit und erz\u00e4hle die schlimmsten Ger\u00fcchte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll join in immediately and tell the worst rumors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me unir\u00e9 de inmediato y contar\u00e9 los peores rumores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me joindrai imm\u00e9diatement et raconterai les pires rumeurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u090a\u0902\u0917\u093e \u0914\u0930 \u0938\u092c\u0938\u0947 \u092c\u0941\u0930\u0940 \u0905\u092b\u0935\u093e\u0939\u0947\u0902 \u092c\u0924\u093e\u090a\u0902\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi unir\u00f2 immediatamente e racconter\u00f2 le voci peggiori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u53c2\u52a0\u3057\u3066\u6700\u60aa\u306e\u5642\u3092\u4f1d\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc989\uc2dc \ud569\ub958\ud558\uc5ec \ucd5c\uc545\uc758 \uc18c\ubb38\uc744 \uc804\ud560 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik doe meteen mee en vertel de ergste geruchten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaraz si\u0119 do\u0142\u0105cz\u0119 i b\u0119d\u0119 opowiada\u0142 najgorsze plotki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou participar imediatamente e contar os piores rumores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0440\u0430\u0437\u0443 \u043f\u0440\u0438\u0441\u043e\u0435\u0434\u0438\u043d\u044e\u0441\u044c \u0438 \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0443 \u0441\u0430\u043c\u044b\u0435 \u0443\u0436\u0430\u0441\u043d\u044b\u0435 \u0441\u043b\u0443\u0445\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen kat\u0131laca\u011f\u0131m ve en k\u00f6t\u00fc s\u00f6ylentileri anlataca\u011f\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u9a6c\u4e0a\u52a0\u5165\u5e76\u8bb2\u51fa\u6700\u53ef\u6015\u7684\u4f20\u8a00\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u7acb\u5373\u52a0\u5165\u4e26\u8aaa\u51fa\u6700\u7cdf\u7cd5\u7684\u8b20\u8a00\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q8.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage nichts, h\u00f6re aber neugierig zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't say anything, but I listen curiously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No digo nada, pero escucho con curiosidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne dis rien, mais j'\u00e9coute avec curiosit\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u093e, \u0932\u0947\u0915\u093f\u0928 \u0909\u0924\u094d\u0938\u0941\u0915\u0924\u093e \u0938\u0947 \u0938\u0941\u0928\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dico niente, ma ascolto con curiosit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u4f55\u3082\u8a00\u3044\u307e\u305b\u3093\u304c\u3001\u8208\u5473\u6df1\u304f\u805e\u3044\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc544\ubb34 \ub9d0\ub3c4 \ud558\uc9c0 \uc54a\uc9c0\ub9cc \ud638\uae30\uc2ec\uc744 \uac16\uace0 \ub4e3\ub294\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg niets, maar luister nieuwsgierig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie m\u00f3wi\u0119, ale s\u0142ucham z zaciekawieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o digo nada, mas ou\u00e7o com curiosidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044e, \u043d\u043e \u0441\u043b\u0443\u0448\u0430\u044e \u0441 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u00e7bir \u015fey s\u00f6ylemiyorum ama merakla dinliyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4ec0\u4e48\u4e5f\u4e0d\u8bf4\uff0c\u4f46\u597d\u5947\u5730\u542c\u7740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4ec0\u9ebc\u4e5f\u6c92\u8aaa\uff0c\u4f46\u6211\u597d\u5947\u5730\u807d\u8457\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q8.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich klinke mich mental aus oder wechsle unauff\u00e4llig das Thema."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I mentally disengage or subtly change the subject."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me desconecto mentalmente o cambio sutilmente de tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me d\u00e9sengage mentalement ou je change subtilement de sujet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092e\u093e\u0928\u0938\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0935\u093f\u0937\u092f \u0915\u094b \u0905\u0932\u0917 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902 \u092f\u093e \u0938\u0942\u0915\u094d\u0937\u094d\u092e\u0924\u093e \u0938\u0947 \u092c\u0926\u0932 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi disimpegno mentalmente o cambio sottilmente argomento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u7cbe\u795e\u7684\u306b\u8a71\u984c\u3092\u5207\u308a\u96e2\u3057\u305f\u308a\u3001\u5fae\u5999\u306b\u8a71\u984c\u3092\u5909\u3048\u305f\u308a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc815\uc2e0\uc801\uc73c\ub85c \uc8fc\uc81c\ub97c \ubd84\ub9ac\ud558\uac70\ub098 \ubbf8\ubb18\ud558\uac8c \uc8fc\uc81c\ub97c \ubc14\uafc9\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik trek me mentaal terug of verander subtiel van onderwerp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofuj\u0119 si\u0119 mentalnie lub subtelnie zmieniam temat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu me desligo mentalmente ou mudo sutilmente de assunto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e \u0432\u044b\u0445\u043e\u0436\u0443 \u0438\u0437 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0438\u043b\u0438 \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e \u043c\u0435\u043d\u044f\u044e \u0442\u0435\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zihinsel olarak konuyu kapat\u0131yorum veya konuyu ustaca de\u011fi\u015ftiriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u5fc3\u7406\u4e0a\u9000\u51fa\uff0c\u6216\u8005\u6084\u6084\u5730\u6362\u4e2a\u8bdd\u9898\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u5fc3\u88e1\u8ff4\u907f\u6216\u5de7\u5999\u5730\u6539\u8b8a\u8a71\u984c\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q8.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage eiskalt: '\u00dcber Leute, die nicht da sind, reden wir nicht.' und beende das Gespr\u00e4ch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say coldly: 'We don't talk about people who aren't there.' and end the conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le digo con frialdad: \"No hablamos de gente que no est\u00e1\". y terminar la conversaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dis froidement : \u00ab On ne parle pas des gens qui ne sont pas l\u00e0. et mettre fin \u00e0 la conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0930\u0941\u0916\u093e\u0908 \u0938\u0947 \u0915\u0939\u0924\u093e \u0939\u0942\u0902: '\u0939\u092e \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u093e\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u091c\u094b \u0935\u0939\u093e\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964' \u0914\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0916\u093c\u0924\u094d\u092e \u0915\u0930\u0947\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico freddamente: \"Non parliamo di gente che non c'\u00e8\". e terminare la conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u51b7\u305f\u304f\u8a00\u3044\u307e\u3059\u3001\u300c\u305d\u306e\u5834\u306b\u3044\u306a\u3044\u4eba\u306e\u3053\u3068\u306f\u8a71\u3055\u306a\u3044\u300d\u3002\u305d\u3057\u3066\u4f1a\u8a71\u3092\u7d42\u4e86\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ucc28\uac11\uac8c \ub9d0\ud588\ub2e4. '\uc6b0\ub9ac\ub294 \uac70\uae30\uc5d0 \uc5c6\ub294 \uc0ac\ub78c\ub4e4\uc5d0 \ub300\ud574 \uc774\uc57c\uae30\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.' \uadf8\ub9ac\uace0 \ub300\ud654\ub97c \uc885\ub8cc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg koel: 'We praten niet over mensen die er niet zijn.' en be\u00ebindig het gesprek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3wi\u0119 ch\u0142odno: \u201eNie rozmawiamy o ludziach, kt\u00f3rych nie ma\u201d. i zako\u0144cz rozmow\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo friamente: 'N\u00e3o falamos de pessoas que n\u00e3o est\u00e3o l\u00e1'. e encerrar a conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u043e\u0432\u043e\u0440\u044e \u0445\u043e\u043b\u043e\u0434\u043d\u043e: \u00ab\u041e \u043b\u044e\u0434\u044f\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435\u0442, \u043c\u044b \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043c.\u00bb \u0438 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u044e \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "So\u011fuk bir tav\u0131rla \u015funu s\u00f6yl\u00fcyorum: 'Orada olmayan insanlar hakk\u0131nda konu\u015fmay\u0131z.' ve konu\u015fmay\u0131 sonland\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u51b7\u51b7\u5730\u8bf4\uff1a\u2018\u6211\u4eec\u4e0d\u8c08\u8bba\u4e0d\u5728\u573a\u7684\u4eba\u3002\u2019\u7136\u540e\u7ed3\u675f\u4e86\u8c08\u8bdd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u51b7\u51b7\u5730\u8aaa\uff1a\u300c\u6211\u5011\u4e0d\u6703\u8ac7\u8ad6\u4e0d\u5728\u5834\u7684\u4eba\u3002\u300d\u4e26\u7d50\u675f\u8ac7\u8a71\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q9": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand bittet dich um einen Gefallen, auf den du absolut keine Lust und keine Zeit hast. Was sagst du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone asks you to do a favor that you have absolutely no desire or time for. What do you say?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien te pide que le hagas un favor para el que no tienes ning\u00fan deseo ni tiempo. \u00bfQu\u00e9 dices?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu\u2019un vous demande de rendre un service pour lequel vous n\u2019avez absolument aucune envie ni le temps. Que dites-vous?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0906\u092a\u0938\u0947 \u0910\u0938\u093e \u0909\u092a\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u092d\u0940 \u0907\u091a\u094d\u091b\u093e \u092f\u093e \u0938\u092e\u092f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno ti chiede di fare un favore per il quale non hai assolutamente desiderio o tempo. Che ne dici?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ab0\u304b\u304c\u3042\u306a\u305f\u306b\u3001\u307e\u3063\u305f\u304f\u671b\u3093\u3067\u3044\u306a\u3044\u3001\u307e\u305f\u306f\u6642\u9593\u304c\u306a\u3044\u304a\u9858\u3044\u3092\u3059\u308b\u3088\u3046\u306b\u983c\u307f\u307e\u3059\u3002\u3042\u306a\u305f\u306f\u4f55\u3068\u8a00\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub204\uad70\uac00\uac00 \ub2f9\uc2e0\uc5d0\uac8c \uc804\ud600 \uc6d0\ud558\uc9c0\ub3c4 \uc54a\uace0 \uc2dc\uac04\ub3c4 \uc5c6\ub294 \ubd80\ud0c1\uc744 \ud574\ub2ec\ub77c\uace0 \ubd80\ud0c1\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ubb34\uc5c7\uc744 \ub9d0\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand vraagt \u200b\u200bje om een \u200b\u200bgunst waar je absoluut geen zin of tijd voor hebt. Wat zeg je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto\u015b prosi Ci\u0119 o przys\u0142ug\u0119, na kt\u00f3r\u0105 zupe\u0142nie nie masz ochoty ani czasu. Co powiesz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algu\u00e9m lhe pede para fazer um favor para o qual voc\u00ea n\u00e3o tem absolutamente nenhum desejo ou tempo. O que voc\u00ea diz?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0442\u043e-\u0442\u043e \u043f\u0440\u043e\u0441\u0438\u0442 \u0442\u0435\u0431\u044f \u043e\u0431 \u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0438, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0443 \u0442\u0435\u0431\u044f \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435\u0442 \u043d\u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u044f, \u043d\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0427\u0442\u043e \u0442\u044b \u0441\u043a\u0430\u0436\u0435\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi sizden kesinlikle arzulamad\u0131\u011f\u0131n\u0131z veya zaman\u0131n\u0131z\u0131n olmad\u0131\u011f\u0131 bir iyilik yapman\u0131z\u0131 istiyor. Sen ne diyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u4eba\u5411\u4f60\u8bf7\u6c42\u5e2e\u5fd9\uff0c\u800c\u4f60\u6839\u672c\u6ca1\u6709\u5174\u8da3\u4e5f\u6ca1\u6709\u65f6\u95f4\u3002\u4f60\u4f1a\u600e\u4e48\u8bf4\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u4eba\u8acb\u4f60\u5e6b\u5fd9\u505a\u4e00\u4ef6\u4f60\u7d55\u5c0d\u4e0d\u60f3\u505a\u6216\u6c92\u6709\u6642\u9593\u505a\u7684\u4e8b\u3002\u4f60\u600e\u9ebc\u8aaa\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q9.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage sofort 'Ja', um keinen Konflikt zu riskieren, und hasse mich danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say 'yes' straight away so as not to risk conflict, and then I hate myself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo \"s\u00ed\" de inmediato para no correr el riesgo de entrar en conflicto, y luego me odio a m\u00ed mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dis \u00ab oui \u00bb tout de suite pour ne pas risquer un conflit, et puis je me d\u00e9teste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0924\u0941\u0930\u0902\u0924 '\u0939\u093e\u0902' \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0924\u093e\u0915\u093f \u091f\u0915\u0930\u093e\u0935 \u0915\u093e \u0916\u0924\u0930\u093e \u0928 \u0939\u094b, \u0914\u0930 \u092b\u093f\u0930 \u092e\u0941\u091d\u0947 \u0916\u0941\u0926 \u0938\u0947 \u0928\u092b\u0930\u0924 \u0939\u094b\u0928\u0947 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico subito s\u00ec per non rischiare il conflitto, e poi mi odio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u885d\u7a81\u306e\u5371\u967a\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3059\u3050\u306b\u300c\u306f\u3044\u300d\u3068\u8a00\u3046\u3068\u3001\u81ea\u5206\u304c\u5acc\u3044\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac08\ub4f1\uc744 \uacaa\uc9c0 \uc54a\uc73c\ub824\uace0 \ubc14\ub85c '\uc608'\ub77c\uace0 \ub300\ub2f5\ud558\uace0 \ub098\uba74 \ub0b4 \uc790\uc2e0\uc774 \uc2eb\uc5b4\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg meteen 'ja' om geen conflicten te riskeren, en dan haat ik mezelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od razu m\u00f3wi\u0119 \u201etak\u201d, \u017ceby nie nara\u017ca\u0107 si\u0119 na konflikt, i wtedy siebie nienawidz\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo 'sim' imediatamente para n\u00e3o correr o risco de conflito, e ent\u00e3o me odeio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u044e '\u0434\u0430', \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u043c, \u0430 \u043f\u043e\u0442\u043e\u043c \u043d\u0435\u043d\u0430\u0432\u0438\u0436\u0443 \u0441\u0435\u0431\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7at\u0131\u015fma riskine girmemek i\u00e7in hemen 'evet' diyorum ve sonra kendimden nefret ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u8bf4\u201c\u662f\u201d\uff0c\u4ee5\u514d\u5192\u9669\u5f15\u53d1\u51b2\u7a81\uff0c\u7136\u540e\u6068\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u5373\u8aaa\u201c\u662f\u201d\uff0c\u4ee5\u514d\u767c\u751f\u885d\u7a81\uff0c\u7136\u5f8c\u6211\u8a0e\u53ad\u81ea\u5df1\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q9.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage 'Vielleicht' und hoffe, dass er es wieder vergisst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say 'Maybe' and hope he forgets about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo \"Quiz\u00e1s\" y espero que lo olvide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dis \u00abPeut-\u00eatre\u00bb et j'esp\u00e8re qu'il l'oubliera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 '\u0936\u093e\u092f\u0926' \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0906\u0936\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u0935\u0939 \u0907\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092d\u0942\u0932 \u091c\u093e\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico \"Forse\" e spero che se ne dimentichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u300c\u305f\u3076\u3093\u300d\u3068\u8a00\u3044\u3001\u5f7c\u304c\u305d\u306e\u3053\u3068\u3092\u5fd8\u308c\u308b\u3053\u3068\u3092\u671b\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 '\uc5b4\uca4c\uba74'\uc774\ub77c\uace0 \ub9d0\ud558\uace0 \uadf8\uac00 \uadf8\uac83\uc744 \uc78a\uc5b4\ubc84\ub9ac\uae30\ub97c \ubc14\ub78d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg 'Misschien' en hoop dat hij het vergeet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3wi\u0119 \u201emo\u017ce\u201d i mam nadziej\u0119, \u017ce o tym zapomni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu digo 'Talvez' e espero que ele esque\u00e7a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u043e\u0432\u043e\u0440\u044e '\u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c' \u0438 \u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u0447\u0442\u043e \u043e\u043d \u0441\u043d\u043e\u0432\u0430 \u044d\u0442\u043e \u0437\u0430\u0431\u0443\u0434\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Belki' diyorum ve umar\u0131m bunu unutur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8bf4\u2018\u4e5f\u8bb8\u2019\uff0c\u5e76\u5e0c\u671b\u4ed6\u53c8\u4f1a\u5fd8\u8bb0\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8aaa\u201c\u4e5f\u8a31\u201d\u4e26\u5e0c\u671b\u4ed6\u5fd8\u8a18\u9019\u4ef6\u4e8b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q9.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich erfinde eine Notl\u00fcge, warum ich keine Zeit habe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I make up a white lie about why I don't have time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invento una mentira piadosa sobre por qu\u00e9 no tengo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'invente un pieux mensonge sur la raison pour laquelle je n'ai pas le temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u092b\u093c\u0947\u0926 \u091d\u0942\u0920 \u092c\u094b\u0932\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0938\u092e\u092f \u0915\u094d\u092f\u094b\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invento una bugia bianca sul motivo per cui non ho tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6642\u9593\u304c\u306a\u3044\u7406\u7531\u306b\u3064\u3044\u3066\u771f\u3063\u767d\u306a\u5618\u3092\u3064\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc65c \uc2dc\uac04\uc774 \uc5c6\ub290\ub0d0\uace0 \uc120\uc758\uc758 \uac70\uc9d3\ub9d0\uc744 \ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik verzin een leugentje om bestwil over waarom ik geen tijd heb."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymy\u015blam bia\u0142e k\u0142amstwo na temat tego, dlaczego nie mam czasu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Invento uma mentira inocente sobre por que n\u00e3o tenho tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043e\u0447\u0438\u043d\u044f\u044e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e \u043b\u043e\u0436\u044c \u043e \u0442\u043e\u043c, \u043f\u043e\u0447\u0435\u043c\u0443 \u0443 \u043c\u0435\u043d\u044f \u043d\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden zaman\u0131m olmad\u0131\u011f\u0131na dair beyaz bir yalan uyduruyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7f16\u4e86\u4e00\u4e2a\u5584\u610f\u7684\u8c0e\u8a00\uff0c\u8bf4\u6211\u6ca1\u6709\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7de8\u9020\u4e86\u4e00\u500b\u5584\u610f\u7684\u8b0a\u8a00\uff0c\u8aaa\u6211\u70ba\u4ec0\u9ebc\u6c92\u6709\u6642\u9593\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q9.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schaue ihm in die Augen und sage 'Nein', ohne mich zu rechtfertigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I look him in the eyes and say 'No' without justifying myself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo miro a los ojos y digo 'No' sin justificarme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je le regarde dans les yeux et dis \u00ab Non \u00bb sans me justifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0909\u0938\u0915\u0940 \u0906\u0902\u0916\u094b\u0902 \u092e\u0947\u0902 \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0916\u0941\u0926 \u0915\u094b \u0938\u0939\u0940 \u0920\u0939\u0930\u093e\u090f \u092c\u093f\u0928\u093e '\u0928\u0939\u0940\u0902' \u0915\u0939\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo guardo negli occhi e dico \"No\" senza giustificarmi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5f7c\u306e\u76ee\u3092\u898b\u3066\u3001\u81ea\u5206\u3092\u6b63\u5f53\u5316\u3059\u308b\u3053\u3068\u306a\u304f\u300c\u30ce\u30fc\u300d\u3068\u8a00\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uadf8\uc758 \ub208\uc744 \ubc14\ub77c\ubcf4\uba70 \ub0b4 \uc790\uc2e0\uc744 \uc815\ub2f9\ud654\ud558\uc9c0 \uc54a\uace0 '\uc544\ub2c8\uc694'\ub77c\uace0 \ub9d0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kijk hem in de ogen en zeg 'Nee' zonder mezelf te rechtvaardigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrz\u0119 mu w oczy i m\u00f3wi\u0119 \u201enie\u201d bez usprawiedliwiania si\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu olho nos olhos dele e digo 'N\u00e3o' sem me justificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043c\u043e\u0442\u0440\u044e \u0435\u043c\u0443 \u0432 \u0433\u043b\u0430\u0437\u0430 \u0438 \u0433\u043e\u0432\u043e\u0440\u044e '\u041d\u0435\u0442', \u043d\u0435 \u043e\u043f\u0440\u0430\u0432\u0434\u044b\u0432\u0430\u044f\u0441\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f6zlerinin i\u00e7ine bak\u0131p kendimi hakl\u0131 \u00e7\u0131karmadan 'Hay\u0131r' diyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u770b\u7740\u4ed6\u7684\u773c\u775b\uff0c\u8bf4\u201c\u4e0d\u8981\u201d\uff0c\u6ca1\u6709\u4e3a\u81ea\u5df1\u8fa9\u89e3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u770b\u8457\u4ed6\u7684\u773c\u775b\uff0c\u8aaa\u201c\u4e0d\u201d\uff0c\u4f46\u6c92\u6709\u70ba\u81ea\u5df1\u8faf\u89e3\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q10": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist Freitagabend. Welche Aktivit\u00e4t pr\u00e4gt dein Wochenende am meisten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's Friday evening. What activity shapes your weekend the most?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es viernes por la tarde. \u00bfQu\u00e9 actividad marca m\u00e1s tu fin de semana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est vendredi soir. Quelle activit\u00e9 fa\u00e7onne le plus votre week-end ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0941\u0915\u094d\u0930\u0935\u093e\u0930 \u0915\u0940 \u0936\u093e\u092e \u0939\u0948. \u0915\u094c\u0928 \u0938\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0906\u092a\u0915\u0947 \u0938\u092a\u094d\u0924\u093e\u0939\u093e\u0902\u0924 \u0915\u094b \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c8 venerd\u00ec sera. Quale attivit\u00e0 caratterizza di pi\u00f9 il tuo fine settimana?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91d1\u66dc\u65e5\u306e\u5915\u65b9\u3067\u3059\u3002\u3042\u306a\u305f\u306e\u9031\u672b\u3092\u6700\u3082\u5f62\u4f5c\u308b\u30a2\u30af\u30c6\u30a3\u30d3\u30c6\u30a3\u306f\u4f55\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae08\uc694\uc77c \uc800\ub141\uc774\uc5d0\uc694. \uc5b4\ub5a4 \ud65c\ub3d9\uc774 \uc8fc\ub9d0\uc5d0 \uac00\uc7a5 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is vrijdagavond. Welke activiteit vormt het meest uw weekend?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest pi\u0105tkowy wiecz\u00f3r. Jaka aktywno\u015b\u0107 najbardziej kszta\u0142tuje Tw\u00f3j weekend?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9 sexta-feira \u00e0 noite. Qual atividade molda mais o seu fim de semana?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u044f\u0442\u043d\u0438\u0447\u043d\u044b\u0439 \u0432\u0435\u0447\u0435\u0440. \u041a\u0430\u043a\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u0442\u0432\u043e\u0438 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma ak\u015fam\u0131. Hafta sonunuzu en \u00e7ok hangi aktivite \u015fekillendiriyor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73b0\u5728\u662f\u661f\u671f\u4e94\u665a\u4e0a\u3002\u54ea\u79cd\u6d3b\u52a8\u6700\u80fd\u5b9a\u4e49\u4f60\u7684\u5468\u672b\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u662f\u661f\u671f\u4e94\u665a\u4e0a\u3002\u4ec0\u9ebc\u6d3b\u52d5\u5c0d\u4f60\u7684\u9031\u672b\u5f71\u97ff\u6700\u5927\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q10.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saufen, Feiern, Kater auskurieren. Jedes verdammte Wochenende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink, party, cure a hangover. Every damn weekend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe, festeja, cura la resaca. Cada maldito fin de semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boire, faire la f\u00eate, soigner une gueule de bois. Chaque putain de week-end."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u093f\u092f\u0947\u0902, \u092a\u093e\u0930\u094d\u091f\u0940 \u0915\u0930\u0947\u0902, \u0939\u0948\u0902\u0917\u0913\u0935\u0930 \u0920\u0940\u0915 \u0915\u0930\u0947\u0902\u0964 \u0939\u0930 \u0938\u092a\u094d\u0924\u093e\u0939\u093e\u0902\u0924."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi, fai festa, cura i postumi di una sbornia. Ogni maledetto fine settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u98f2\u3093\u3067\u3001\u30d1\u30fc\u30c6\u30a3\u30fc\u3057\u3066\u3001\u4e8c\u65e5\u9154\u3044\u3092\u6cbb\u3057\u307e\u3057\u3087\u3046\u3002\u6bce\u9031\u672b\u306d\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc2dc\uace0, \ud30c\ud2f0\ud558\uace0, \uc219\ucde8\ub97c \uce58\ub8cc\ud558\uc138\uc694. \ube4c\uc5b4\uba39\uc744 \uc8fc\ub9d0\ub9c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drinken, feesten, een kater genezen. Elk verdomd weekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij, imprezuj, wylecz kaca. W ka\u017cdy cholerny weekend."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba, festeje, cure uma ressaca. Todo maldito fim de semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0438\u0442\u044c, \u0432\u0435\u0441\u0435\u043b\u0438\u0442\u044c\u0441\u044f, \u0437\u0430\u043b\u0438\u0437\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u0445\u043c\u0435\u043b\u044c\u0435. \u041a\u0430\u0436\u0434\u044b\u0435 \u0447\u0435\u0440\u0442\u043e\u0432\u044b \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u00e7, parti yap, ak\u015famdan kalma durumunu iyile\u015ftir. Her lanet hafta sonu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u559d\u9152\u3001\u5e86\u795d\u3001\u6cbb\u5bbf\u9189\u3002\u6bcf\u8be5\u6b7b\u7684\u5468\u672b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u559d\u9152\u3001\u805a\u6703\u3001\u89e3\u9152\u3002\u6bcf\u500b\u8a72\u6b7b\u7684\u5468\u672b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q10.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zocken und Binge-Watching bis tief in die Nacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaming and binge-watching until late into the night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juegos y atracones hasta altas horas de la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouer et regarder en boucle jusque tard dans la nuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0947\u0930 \u0930\u093e\u0924 \u0924\u0915 \u0917\u0947\u092e \u0916\u0947\u0932\u0928\u093e \u0914\u0930 \u091c\u092e\u0915\u0930 \u0926\u0947\u0916\u0928\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaming e binge-watching fino a tarda notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u591c\u9045\u304f\u307e\u3067\u30b2\u30fc\u30e0\u3084\u3069\u3093\u3061\u3083\u3093\u9a12\u304e\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc24 \ub2a6\uac8c\uae4c\uc9c0 \uac8c\uc784\uc744 \ud558\uace0 \ud3ed\uc2dd\uc744 \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamen en bingewatchen tot laat in de nacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Granie i ogl\u0105danie do p\u00f3\u017anych godzin nocnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogar e assistir compulsivamente at\u00e9 tarde da noite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0433\u0440\u0430\u0442\u044c \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u043e\u0434\u0440\u044f\u0434 \u0434\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0439 \u043d\u043e\u0447\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece ge\u00e7 saatlere kadar oyun oynamak ve art arda izlemek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u71ac\u591c\u4e00\u76f4\u73a9\u6e38\u620f\u548c\u72c2\u770b\u5267\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u904a\u6232\u3001\u770b\u5287\u5230\u6df1\u591c\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q10.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bisschen entspannen, aber auch ein paar Erledigungen machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relax a bit, but also do a few errands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rel\u00e1jate un poco, pero tambi\u00e9n haz algunos recados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9tendez-vous un peu, mais faites aussi quelques courses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0925\u094b\u0921\u093c\u093e \u0906\u0930\u093e\u092e \u0915\u0930\u0947\u0902, \u0932\u0947\u0915\u093f\u0928 \u0915\u0941\u091b \u0915\u093e\u092e \u092d\u0940 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilassati un po', ma fai anche qualche commissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c11\u3057\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u306a\u304c\u3089\u3001\u3044\u304f\u3064\u304b\u306e\u7528\u4e8b\u3092\u6e08\u307e\u305b\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc870\uae08 \uae34\uc7a5\uc744 \ud480\uace0 \uba87 \uac00\uc9c0 \uc2ec\ubd80\ub984\ub3c4 \ud574\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontspan een beetje, maar doe ook een paar boodschappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrelaksuj si\u0119 troch\u0119, ale tak\u017ce zajmij si\u0119 kilkoma sprawami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaxe um pouco, mas tamb\u00e9m fa\u00e7a algumas tarefas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u0438\u0442\u044c\u0441\u044f, \u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz rahatlay\u0131n ama ayn\u0131 zamanda birka\u00e7 ayak i\u015fi yap\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a0d\u5fae\u653e\u677e\u4e00\u4e0b\uff0c\u4f46\u4e5f\u8981\u505a\u4e00\u4e9b\u4e8b\u60c5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u653e\u9b06\u4e00\u4e0b\uff0c\u4f46\u4e5f\u505a\u4e00\u4e9b\u4e8b\u60c5\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q10.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Networking, Weiterbildung oder harte Arbeit an meinen Zielen. Das Wochenende ist ein Vorsprung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Networking, continuing education or working hard towards my goals. The weekend is a head start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Networking, educaci\u00f3n continua o trabajar duro para alcanzar mis objetivos. El fin de semana es un buen comienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9seautage, formation continue ou travail acharn\u00e9 pour atteindre mes objectifs. Le week-end est une longueur d'avance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0947\u091f\u0935\u0930\u094d\u0915\u093f\u0902\u0917, \u0938\u0924\u0924 \u0936\u093f\u0915\u094d\u0937\u093e \u092f\u093e \u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0915\u0921\u093c\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0930\u0928\u093e\u0964 \u0938\u092a\u094d\u0924\u093e\u0939\u093e\u0902\u0924 \u090f\u0915 \u0905\u091a\u094d\u091b\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Networking, formazione continua o lavoro duro per raggiungere i miei obiettivi. Il fine settimana \u00e8 un vantaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30cd\u30c3\u30c8\u30ef\u30fc\u30ad\u30f3\u30b0\u3001\u7d99\u7d9a\u7684\u306a\u6559\u80b2\u3001\u307e\u305f\u306f\u76ee\u6a19\u306b\u5411\u304b\u3063\u3066\u4e00\u751f\u61f8\u547d\u306b\u53d6\u308a\u7d44\u3080\u3053\u3068\u3002\u9031\u672b\u306f\u6709\u5229\u306a\u30b9\u30bf\u30fc\u30c8\u3060\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub124\ud2b8\uc6cc\ud0b9, \uc9c0\uc18d\uc801\uc778 \uad50\uc721 \ub610\ub294 \ubaa9\ud45c\ub97c \ud5a5\ud574 \uc5f4\uc2ec\ud788 \ub178\ub825\ud569\ub2c8\ub2e4. \uc8fc\ub9d0\uc774 \uc2dc\uc791\uc774\uad70\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerken, bijscholen of hard werken aan mijn doelen. Het weekend is een voorsprong."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Networking, kszta\u0142cenie ustawiczne lub ci\u0119\u017cka praca nad osi\u0105gni\u0119ciem moich cel\u00f3w. Weekend to dobry pocz\u0105tek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Networking, educa\u00e7\u00e3o continuada ou trabalho duro para atingir meus objetivos. O fim de semana \u00e9 um avan\u00e7o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442\u0432\u043e\u0440\u043a\u0438\u043d\u0433, \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0438\u043b\u0438 \u0443\u043f\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u043c\u043e\u0438\u043c\u0438 \u0446\u0435\u043b\u044f\u043c\u0438. \u0412\u044b\u0445\u043e\u0434\u043d\u044b\u0435 \u2014 \u044d\u0442\u043e \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u011f kurma, e\u011fitime devam etme veya hedeflerim do\u011frultusunda \u00e7ok \u00e7al\u0131\u015fma. Hafta sonu bir avantajd\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5efa\u7acb\u4eba\u8109\u3001\u7ee7\u7eed\u6559\u80b2\u6216\u52aa\u529b\u5b9e\u73b0\u6211\u7684\u76ee\u6807\u3002\u5468\u672b\u662f\u4e00\u4e2a\u4f18\u52bf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u793e\u4ea4\u3001\u6301\u7e8c\u6559\u80b2\u6216\u52aa\u529b\u5be6\u73fe\u6211\u7684\u76ee\u6a19\u3002\u9031\u672b\u662f\u4e00\u500b\u597d\u7684\u958b\u59cb\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q11": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie verbringst du die meiste Zeit online?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you spend most of your time online?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfC\u00f3mo pasas la mayor parte de tu tiempo en l\u00ednea?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment passez-vous la plupart de votre temps en ligne ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u093e \u0905\u0927\u093f\u0915\u093e\u0902\u0936 \u0938\u092e\u092f \u0911\u0928\u0932\u093e\u0907\u0928 \u0915\u0948\u0938\u0947 \u092c\u093f\u0924\u093e\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come trascorri la maggior parte del tuo tempo online?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307b\u3068\u3093\u3069\u306e\u6642\u9593\u3092\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u3069\u306e\u3088\u3046\u306b\u904e\u3054\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc628\ub77c\uc778\uc5d0\uc11c \ub300\ubd80\ubd84\uc758 \uc2dc\uac04\uc744 \uc5b4\ub5bb\uac8c \ubcf4\ub0b4\uc2dc\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe brengt u het grootste deel van uw tijd online door?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak sp\u0119dzasz wi\u0119kszo\u015b\u0107 czasu w Internecie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como voc\u00ea passa a maior parte do tempo online?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0442\u044b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0448\u044c \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman\u0131n\u0131z\u0131n \u00e7o\u011funu internette nas\u0131l ge\u00e7irirsiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5927\u90e8\u5206\u65f6\u95f4\u90fd\u5728\u7f51\u4e0a\u505a\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u4e0a\u7db2\u7684\u5927\u90e8\u5206\u6642\u9593\u662f\u600e\u9ebc\u904e\u7684\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q11.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konsumiere zu 100\uff05. Ich scrolle nur durch die Leben anderer Leute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I consume 100\uff05. I just scroll through other people's lives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumo el 100\uff05. Simplemente me desplazo por la vida de otras personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je consomme \u00e0 100\uff05. Je fais juste d\u00e9filer la vie des autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 100\uff05 \u0909\u092a\u092d\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964 \u092e\u0948\u0902 \u092c\u0938 \u0905\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u091c\u0940\u0935\u0928 \u0915\u093e \u0905\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumo il 100\uff05. Scorro semplicemente le vite degli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100\uff05\u6d88\u8cbb\u3057\u3066\u307e\u3059\u3002\u4ed6\u306e\u4eba\u306e\u4eba\u751f\u3092\u30b9\u30af\u30ed\u30fc\u30eb\u3059\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 100\uff05 \uc18c\ube44\ud55c\ub2e4. \ub098\ub294 \ub2e8\uc9c0 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \uc0b6\uc744 \uc2a4\ud06c\ub864\ud560 \ubfd0\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik consumeer 100\uff05. Ik scroll gewoon door de levens van anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsumuj\u0119 na 100\uff05. Po prostu przegl\u0105dam \u017cycie innych ludzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu consumo 100\uff05. Eu apenas folheio a vida de outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u044e \u043d\u0430 100\uff05. \u042f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u044e \u0436\u0438\u0437\u043d\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043b\u044e\u0434\u0435\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100 t\u00fcketiyorum. Ba\u015fkalar\u0131n\u0131n hayatlar\u0131na g\u00f6z at\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u767e\u5206\u4e4b\u767e\u5728\u6d88\u8d39\u3002\u6211\u53ea\u662f\u6d4f\u89c8\u522b\u4eba\u7684\u751f\u6d3b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6d88\u8017100\uff05\u3002\u6211\u53ea\u662f\u700f\u89bd\u5225\u4eba\u7684\u751f\u6d3b\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q11.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich poste hin und wieder Bilder, um Best\u00e4tigung (Likes) zu bekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I post pictures every now and then to get confirmation (likes)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publico fotos de vez en cuando para obtener confirmaci\u00f3n (me gusta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je poste des photos de temps en temps pour avoir une confirmation (j'aime)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092a\u0941\u0937\u094d\u091f\u093f (\u0932\u093e\u0907\u0915) \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0924\u0938\u094d\u0935\u0940\u0930\u0947\u0902 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblico foto di tanto in tanto per ottenere conferma (mi piace)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u78ba\u8a8d\uff08\u3044\u3044\u306d\uff09\u3092\u3082\u3089\u3046\u305f\u3081\u306b\u6642\u3005\u5199\u771f\u3092\u6295\u7a3f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud655\uc778(\uc88b\uc544\uc694)\uc744 \ubc1b\uae30 \uc704\ud574 \uac00\ub054\uc529 \uc0ac\uc9c4\uc744 \uc62c\ub824\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik post zo nu en dan foto's om bevestiging (likes) te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jaki\u015b czas zamieszczam zdj\u0119cia, \u017ceby uzyska\u0107 potwierdzenie (polubienia)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Posto fotos de vez em quando para obter confirma\u00e7\u00e3o (curtidas)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u043e\u0433\u0434\u0430 \u044f \u0432\u044b\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 (\u043b\u0430\u0439\u043a\u0438)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay (be\u011feni) almak i\u00e7in ara s\u0131ra resim yay\u0131nl\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u65f6\u4e0d\u65f6\u4f1a\u53d1\u4e00\u4e9b\u56fe\u7247\u6765\u83b7\u53d6\u8ba4\u540c\u611f\uff08\u70b9\u8d5e\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6642\u4e0d\u6642\u5730\u767c\u5e03\u7167\u7247\u4ee5\u7372\u5f97\u78ba\u8a8d\uff08\u559c\u6b61\uff09\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q11.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kommentiere und diskutiere viel mit, anstatt nur passiv zu sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I comment and discuss a lot instead of just being passive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comento y discuto mucho en lugar de ser simplemente pasivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je commente et discute beaucoup au lieu d'\u00eatre simplement passif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u0947 \u0915\u0947 \u092c\u091c\u093e\u092f \u0916\u0942\u092c \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0914\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commento e discuto molto invece di essere solo passivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305f\u3060\u53d7\u3051\u8eab\u306b\u306a\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u305f\u304f\u3055\u3093\u30b3\u30e1\u30f3\u30c8\u3057\u305f\u308a\u30c7\u30a3\u30b9\u30ab\u30c3\u30b7\u30e7\u30f3\u3057\u305f\u308a\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc218\ub3d9\uc801\uc73c\ub85c \ud589\ub3d9\ud558\uae30\ubcf4\ub2e4\ub294 \ub313\uae00\uacfc \ud1a0\ub860\uc744 \ub9ce\uc774 \ud574\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik geef veel commentaar en discussieer in plaats van alleen maar passief te zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du\u017co komentuj\u0119 i dyskutuj\u0119, zamiast pozosta\u0107 biernym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu comento e discuto muito em vez de apenas ser passivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u044e \u0438 \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u044e, \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0430\u0441\u0441\u0438\u0432\u043d\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasif olmak yerine \u00e7ok yorum yap\u0131yorum ve tart\u0131\u015f\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7ecf\u5e38\u53d1\u8868\u8bc4\u8bba\u548c\u8ba8\u8bba\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u88ab\u52a8\u5730\u53c2\u4e0e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u767c\u8868\u5f88\u591a\u8a55\u8ad6\u548c\u8a0e\u8ad6\uff0c\u800c\u4e0d\u662f\u6d88\u6975\u88ab\u52d5\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q11.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich baue Dinge auf. Ich kreiere Inhalte, Code, Netzwerke oder Wissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I build things. I create content, code, networks or knowledge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo construyo cosas. Creo contenido, c\u00f3digo, redes o conocimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je construis des choses. Je cr\u00e9e du contenu, du code, des r\u00e9seaux ou des connaissances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091a\u0940\u091c\u0947\u0902 \u092c\u0928\u093e\u0924\u093e \u0939\u0942\u0902. \u092e\u0948\u0902 \u0938\u093e\u092e\u0917\u094d\u0930\u0940, \u0915\u094b\u0921, \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u092f\u093e \u091c\u094d\u091e\u093e\u0928 \u092c\u0928\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisco cose. Creo contenuti, codice, reti o conoscenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u7269\u3092\u4f5c\u308a\u307e\u3059\u3002\u79c1\u306f\u30b3\u30f3\u30c6\u30f3\u30c4\u3001\u30b3\u30fc\u30c9\u3001\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3001\u77e5\u8b58\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ubb3c\uac74\uc744 \ub9cc\ub4e0\ub2e4. \ub098\ub294 \ucf58\ud150\uce20, \ucf54\ub4dc, \ub124\ud2b8\uc6cc\ud06c \ub610\ub294 \uc9c0\uc2dd\uc744 \ub9cc\ub4ed\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik bouw dingen. Ik cre\u00eber content, code, netwerken of kennis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj\u0119 rzeczy. Tworz\u0119 tre\u015bci, kod, sieci lub wiedz\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu construo coisas. Crio conte\u00fado, c\u00f3digo, redes ou conhecimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043e\u0437\u0434\u0430\u044e \u0432\u0435\u0449\u0438. \u042f \u0441\u043e\u0437\u0434\u0430\u044e \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u043a\u043e\u0434, \u0441\u0435\u0442\u0438 \u0438\u043b\u0438 \u0437\u043d\u0430\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir \u015feyler in\u015fa ediyorum. \u0130\u00e7erik, kod, a\u011flar veya bilgi yarat\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5efa\u7acb\u4e8b\u7269\u3002\u6211\u521b\u9020\u5185\u5bb9\u3001\u4ee3\u7801\u3001\u7f51\u7edc\u6216\u77e5\u8bc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5efa\u9020\u6771\u897f\u3002\u6211\u5275\u5efa\u5167\u5bb9\u3001\u7a0b\u5f0f\u78bc\u3001\u7db2\u8def\u6216\u77e5\u8b58\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.q12": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches dieser W\u00f6rter benutzt du am h\u00e4ufigsten in deinem Alltag?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which of these words do you use most often in your everyday life?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfCu\u00e1l de estas palabras usas con m\u00e1s frecuencia en tu vida diaria?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lequel de ces mots utilisez-vous le plus souvent dans votre vie de tous les jours\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u0947 \u0930\u094b\u091c\u092e\u0930\u094d\u0930\u093e \u0915\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938 \u0936\u092c\u094d\u0926 \u0915\u093e \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale di queste parole usi pi\u00f9 spesso nella tua vita quotidiana?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e5\u5e38\u751f\u6d3b\u3067\u6700\u3082\u983b\u7e41\u306b\u4f7f\u7528\u3059\u308b\u8a00\u8449\u306f\u6b21\u306e\u3046\u3061\u3069\u308c\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c \uc911 \uc77c\uc0c1\uc0dd\ud65c\uc5d0\uc11c \uac00\uc7a5 \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \ub2e8\uc5b4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke van deze woorden gebruikt u het vaakst in uw dagelijks leven?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kt\u00f3rego z tych s\u0142\u00f3w u\u017cywasz najcz\u0119\u015bciej w \u017cyciu codziennym?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual dessas palavras voc\u00ea usa com mais frequ\u00eancia no seu dia a dia?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a\u043e\u0435 \u0438\u0437 \u044d\u0442\u0438\u0445 \u0441\u043b\u043e\u0432 \u0442\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e \u0432 \u043f\u043e\u0432\u0441\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck ya\u015fam\u0131n\u0131zda bu kelimelerden hangisini en s\u0131k kullan\u0131yorsunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u4f60\u6700\u5e38\u4f7f\u7528\u8fd9\u4e9b\u8bcd\u4e2d\u7684\u54ea\u4e2a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\u6700\u5e38\u4f7f\u7528\u4e0b\u5217\u54ea\u4e00\u500b\u5b57\uff1f"
          }
        }
      }
    },
    "assessment.lifestyle.q12.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Man m\u00fcsste mal...' oder 'Ich versuche...'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'You should...' or 'I'll try...'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'Deber\u00edas...' o 'Lo intentar\u00e9...'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Tu devrais...' ou 'Je vais essayer...'"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u0906\u092a\u0915\u094b \u091a\u093e\u0939\u093f\u090f...' \u092f\u093e '\u092e\u0948\u0902 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0942\u0901\u0917\u093e...'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'Dovresti...' oppure 'Ci prover\u00f2...'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u3042\u306a\u305f\u306f...\u3059\u3079\u304d\u3067\u3059\u300d\u307e\u305f\u306f\u300c\u79c1\u306f...\u8a66\u3057\u3066\u307f\u307e\u3059\u300d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\ud574\uc57c \ud569\ub2c8\ub2e4...' \ub610\ub294 '\ub178\ub825\ud558\uaca0\uc2b5\ub2c8\ub2e4...'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Je moet...' of 'Ik zal het proberen...'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201ePowiniene\u015b\u2026\u201d lub \u201eSpr\u00f3buj\u0119\u2026\u201d"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'Voc\u00ea deveria...' ou 'Vou tentar...'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u041d\u0430\u0434\u043e \u0431\u044b...' \u0438\u043b\u0438 '\u042f \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u044e...'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Yapmal\u0131s\u0131n...' veya 'Deneyece\u011fim...'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u4eba\u4eec\u5e94\u8be5...' \u6216\u8005 '\u6211\u5c1d\u8bd5...'"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u4f60\u61c9\u8a72\u2026\u201d\u6216\u201c\u6211\u6703\u5617\u8a66\u2026\u201d"
          }
        }
      }
    },
    "assessment.lifestyle.q12.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'Ich kann das nicht, weil... (Ausrede)'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'I can't do this because... (excuse)'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'No puedo hacer esto porque... (excusa)'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Je ne peux pas faire \u00e7a parce que... (excuse)'"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'\u092e\u0948\u0902 \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f... (\u0915\u094d\u0937\u092e\u093e \u0915\u0930\u0947\u0902)'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'Non posso farlo perch\u00e9... (scusa)'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u305d\u308c\u306f\u3067\u304d\u306a\u3044\u306e\u3067\u2026\uff08\u8a00\u3044\u8a33\uff09\u300d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc774\uac74 \ud560 \uc218 \uc5c6\uc5b4\uc694 \uc65c\ub0d0\ud558\uba74... (\ubcc0\uba85)'"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'Ik kan dit niet doen omdat... (excuseer)'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201eNie mog\u0119 tego zrobi\u0107, poniewa\u017c... (przepraszam)\u201d"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'N\u00e3o posso fazer isso porque... (desculpa)'"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435 \u043c\u043e\u0433\u0443 \u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e... (\u041e\u0442\u0433\u043e\u0432\u043e\u0440\u043a\u0430)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Bunu yapamam \u00e7\u00fcnk\u00fc... (mazeret)'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u505a\u4e0d\u5230\uff0c\u56e0\u4e3a\u2026\u2026\uff08\u501f\u53e3\uff09"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u6211\u4e0d\u80fd\u9019\u6a23\u505a\uff0c\u56e0\u70ba\u2026\u2026\uff08\u62b1\u6b49\uff09\u201d"
          }
        }
      }
    },

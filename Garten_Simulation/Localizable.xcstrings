    "trash.alkohol_flatrate.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein klarer Kopf und ein gesunder K\u00f6rper durch ein alkoholfreies Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clear mind and a healthy body through an alcohol-free life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente clara y un cuerpo sano a trav\u00e9s de una vida sin alcohol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esprit clair et un corps sain gr\u00e2ce \u00e0 une vie sans alcool."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0938\u094d\u092a\u0937\u094d\u091f \u0926\u093f\u092e\u093e\u0917 \u0914\u0930 \u0938\u094d\u0935\u0938\u094d\u0925 \u0936\u0930\u0940\u0930 \u092c\u093f\u0928\u093e \u0936\u0930\u093e\u092c \u0935\u093e\u0932\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente lucida e un corpo sano attraverso una vita senza alcol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30eb\u30b3\u30fc\u30eb\u306e\u306a\u3044\u751f\u6d3b\u3092\u901a\u3058\u3066\u3001\u30af\u30ea\u30a2\u306a\u5fc3\u3068\u5065\u5eb7\u306a\u4f53\u3092\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb34\uc54c\ucf54\uc62c \uc0dd\ud65c\uc744 \ud1b5\ud55c \ub9d1\uc740 \uc815\uc2e0\uacfc \uac74\uac15\ud55c \ubab8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een heldere geest en een gezond lichaam door een alcoholvrij leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty umys\u0142 i zdrowe cia\u0142o dzi\u0119ki \u017cyciu wolnemu od alkoholu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mente clara e um corpo s\u00e3o atrav\u00e9s de uma vida sem \u00e1lcool."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u0441\u043d\u0430\u044f \u0433\u043e\u043b\u043e\u0432\u0430 \u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0447\u0435\u0440\u0435\u0437 \u0431\u0435\u0437\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u0443\u044e \u0436\u0438\u0437\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkols\u00fcz bir ya\u015famla berrak bir zihin ve sa\u011fl\u0131kl\u0131 bir v\u00fccut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u65e0\u9152\u7cbe\u7684\u751f\u6d3b\u4fdd\u6301\u6e05\u9192\u7684\u5934\u8111\u548c\u5065\u5eb7\u7684\u8eab\u4f53\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u7121\u9152\u7cbe\u7684\u751f\u6d3b\u4fdd\u6301\u6e05\u9192\u7684\u982d\u8166\u548c\u5065\u5eb7\u7684\u8eab\u9ad4\u3002"
          }
        }
      }
    },
    "trash.alkohol_flatrate.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Alkohol trinken) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszusch\u00f6pfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0906\u0926\u0924 (\u0936\u0930\u093e\u092c \u092a\u0940\u0928\u093e) \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u090a\u0930\u094d\u091c\u093e, \u0938\u092e\u092f \u0914\u0930 \u092a\u0948\u0938\u093e \u0916\u0930\u094d\u091a \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u0905\u092a\u0928\u0940 \u092a\u0942\u0930\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Alkohol trinken) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u996e\u9152\uff09\u4f1a\u6d88\u8017\u60a8\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u98f2\u9152\uff09\u6703\u6d88\u8017\u60a8\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },

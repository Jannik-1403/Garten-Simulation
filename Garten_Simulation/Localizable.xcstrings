    "prog_stretching_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotationen für die Wirbelsäule, um Bandscheiben zu nähren und die Mobilität des Rumpfes zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotations for the spine to nourish intervertebral discs and improve core mobility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotaciones de la columna para nutrir los discos intervertebrales y mejorar la movilidad central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotations pour la colonne vertébrale pour nourrir les disques intervertébraux et améliorer la mobilité centrale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरवर्टेब्रल डिस्क को पोषण देने और कोर गतिशीलता में सुधार करने के लिए रीढ़ की हड्डी को घुमाना।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotazioni della colonna vertebrale per nutrire i dischi intervertebrali e migliorare la mobilità del core."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脊椎を回転させることで椎間板に栄養を与え、体幹の可動性を向上させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "척추 회전은 추간판에 영양을 공급하고 코어 이동성을 향상시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotaties van de wervelkolom om de tussenwervelschijven te voeden en de kernmobiliteit te verbeteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotacje kręgosłupa w celu odżywienia krążków międzykręgowych i poprawy ruchomości rdzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotações da coluna para nutrir os discos intervertebrais e melhorar a mobilidade central."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotações da coluna para nutrir os discos intervertebrais e melhorar a mobilidade central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вращения позвоночника для питания межпозвоночных дисков и улучшения подвижности корпуса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omurga rotasyonları, omurlararası diskleri besler ve çekirdek hareketliliğini artırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脊柱旋转可滋养椎间盘并提高核心灵活性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "脊椎旋轉可滋養椎間盤並提高核心靈活性。"
          }
        }
      }
    },

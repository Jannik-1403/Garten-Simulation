    "plant.pfirsichbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht sanfte Pflege, keine Gewalt – Stressreduktion"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs gentle care, no violence – Stress reduction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita cuidado suave – Reducción del estrés"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A besoin de soins doux – Réduction du stress"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम देखभाल की आवश्यकता होती है, हिंसा नहीं – तनाव कम करना"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bisogno di cure gentili, non di violenza – riduzione dello stress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優しいケアが必要ですが、暴力は必要ありません – ストレスの軽減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭력이 아닌 부드러운 보살핌이 필요함 – 스트레스 감소"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft zachte zorg nodig, geen geweld – Stressvermindering"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga delikatnej opieki, bez przemocy – Redukcja stresu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de cuidados suaves – Redução do stress"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de cuidados suaves – Redução do stress"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуждается в мягком уходе, без насилия – снижение стресса"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik bakıma ihtiyaç var, şiddet yok – Stres azaltma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要温柔呵护，而非暴力 – 减压"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要溫柔的護理，而不是暴力－減輕壓力"
          }
        }
      }
    },

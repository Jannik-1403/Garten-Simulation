          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mili ludzie, ale żaden z nich nie stanowi dla mnie wyzwania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas legais, mas nenhuma delas realmente me desafia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приятные люди, но никто из них по-настоящему меня не бросает вызов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoş insanlar ama hiçbiri bana meydan okumuyor."

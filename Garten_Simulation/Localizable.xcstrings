            "value": "Nutri il tuo corpo con pasti sani cucinati in casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手作りの健康的な食事で体に栄養を与えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

    "trash.alkohol_flatrate.tip.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere alle Alkohol-Vorräte aus dem Haus – was nicht da ist, wird nicht getrunken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty all alcohol supplies from home – what's not there won't be drunk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacía todas las reservas de alcohol de casa: lo que no está no se bebe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide toutes les réserves d'alcool à la maison – ce qui n'est pas là ne sera pas bu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घर से सभी शराब की भंडार साफ कर दें – जो मौजूद नहीं है, उसे कोई नहीं पीएगा।"

    "assessment.finance.q1.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich überlege eine Woche lang, tue aber am Ende nichts damit."
          }
        },
        "en" : {

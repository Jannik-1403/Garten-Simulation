    "prog_strength_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KEIN Sofa-Tag. Aktive Regeneration für Muskeln und Nervensystem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NO couch day. Active regeneration for muscles and nervous system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NO hay día de sofá. Regeneración activa de músculos y sistema nervioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PAS de journée canapé. Régénération active des muscles et du système nerveux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सोफ़ा दिवस नहीं. मांसपेशियों और तंत्रिका तंत्र के लिए सक्रिय पुनर्जनन।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NESSUN giorno sul divano. Rigenerazione attiva per muscoli e sistema nervoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソファの日はありません。筋肉と神経系の活発な再生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소파 데이는 없습니다. 근육과 신경계의 활성 재생."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GEEN bankdag. Actieve regeneratie voor spieren en zenuwstelsel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ŻADNEGO dnia na sofie. Aktywna regeneracja mięśni i układu nerwowego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO é dia de sofá. Regeneração ativa para músculos e sistema nervoso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO é dia de sofá. Regeneração ativa para músculos e sistema nervoso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НЕТ диванного дня. Активная регенерация мышц и нервной системы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanepe günü YOK. Kaslar ve sinir sistemi için aktif rejenerasyon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有沙发日。肌肉和神经系统的主动再生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有沙發日。肌肉和神經系統的主動再生。"
          }
        }
      }
    },
    "prog_strength_d7_t1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Min Mobilitätsarbeit / Dehnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 min mobility work / stretching"
          }

    "body.tracking.tip.measurements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Körperumfänge verändern sich langsam. Wir empfehlen, sie nur einmal im Monat zu messen, um echte Fortschritte zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Body measurements change slowly. We recommend measuring them only once a month to see real progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Las medidas cambian lentamente. Recomendamos medirlas una vez al mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : Les mensurations changent lentement. Nous recommandons de les mesurer une fois par mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "युक्ति: शरीर का माप धीरे-धीरे बदलता है। हम महीने में केवल एक बार मापने की सलाह देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: Le misure cambiano lentamente. Si consiglia di misurare una volta al mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：体のサイズはゆっくりと変化します。月1回の測定をお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 신체 치수는 천천히 변합니다. 한 달에 한 번만 측정하는 것을 권장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Lichaamsmaten veranderen langzaam. We raden aan om één keer per maand te meten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Wymiary ciała zmieniają się powoli. Zalecamy mierzenie raz w miesiącu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: As medidas mudam lentamente. Recomendamos medi-las apenas uma vez por mês."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: As medidas mudam lentamente. Recomendamos medi-las apenas uma vez por mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: Размеры тела меняются медленно. Рекомендуем измерять их раз в месяц."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Vücut ölçüleri yavaş değişir. Ayda sadece bir kez ölçmenizi öneririz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：身体围度变化缓慢。我们建议每月仅测量一次以查看真正的进步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：身體圍度變化緩慢。我們建議每月僅測量一次以查看真正的進步。"
          }
        }
      }
    },
    "body.tracking.tip.weight": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Für beste Ergebnisse empfehlen wir, das Gewicht jeden Morgen zur selben Zeit, nüchtern und ohne vorher etwas zu essen, zu tracken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: For best results, we recommend tracking weight every morning at the same time, before eating or drinking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Para mejores resultados, recomendamos registrar el peso todas las mañanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : Pour de meilleurs résultats, recommandez de suivre le poids chaque matin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "युक्ति: सर्वोत्तम परिणामों के लिए, हम हर सुबह वजन को ट्रैक करने की सलाह देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: Per i migliori risultati, si consiglia di tracciare il peso ogni mattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：最良の結果を得るには、毎朝同じ時間に体重を記録することをお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 최상의 결과를 위해 매일 아침 같은 시간에 체중을 기록하는 것을 권장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Voor de beste resultaten raden we aan het gewicht elke ochtend bij te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Najlepsze wyniki daje ważenie się codziennie rano na czczo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Para melhores resultados, recomendamos registrar o peso todas as manhãs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Para melhores resultados, recomendamos registrar o peso todas as manhãs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: Для достижения наилучших результатов рекомендуем отслеживать вес каждое утро натощак."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: En iyi sonuçlar için her sabah aynı saatte kilonuzu izlemenizi öneririz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：为了获得最佳结果，我们建议每天早上在同一时间、空腹时记录体重。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：為了獲得最佳結果，我們建議每天早上在同一時間、空腹時記錄體重。"
          }
        }
      }
    },

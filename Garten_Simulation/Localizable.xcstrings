    "assessment.mental.profile.getriebener.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde deinen Fokus und lerne, Nein zu sagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find your focus and learn to say no."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra tu enfoque y aprende a decir no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez votre concentration et apprenez à dire non."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना ध्यान केंद्रित करें और ना कहना सीखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova la tua concentrazione e impara a dire di no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の焦点を見つけて、ノーと言う方法を学びましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초점을 찾고 거절하는 법을 배우십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind uw focus en leer nee zeggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź swoje skupienie i naucz się mówić nie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre seu foco e aprenda a dizer não."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найди свой фокус и научись говорить «нет»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak noktanızı bulun ve hayır demeyi öğrenin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到你的重点，并学会说不。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到你的焦點並學會說不。"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere die roten Benachrichtigungs-Badges auf deinem Home-Screen. Sie triggern dein Dopaminsystem künstlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable the red notification badges on your home screen. They artificially trigger your dopamine system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactive las insignias de notificación rojas en su pantalla de inicio. Activan artificialmente su sistema de dopamina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez les badges de notification rouges sur votre écran d'accueil. Ils déclenchent artificiellement votre système dopaminergique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी होम स्क्रीन पर लाल अधिसूचना बैज अक्षम करें। वे कृत्रिम रूप से आपके डोपामाइन सिस्टम को ट्रिगर करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva i badge di notifica rossi sulla schermata iniziale. Attivano artificialmente il tuo sistema dopaminergico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面の赤い通知バッジを無効にします。それらは人為的にドーパミンシステムを誘発します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면에서 빨간색 알림 배지를 비활성화합니다. 그들은 도파민 시스템을 인위적으로 유발합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel de rode meldingsbadges op uw startscherm uit. Ze activeren kunstmatig je dopaminesysteem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz czerwone plakietki powiadomień na ekranie głównym. Sztucznie uruchamiają układ dopaminowy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative os emblemas vermelhos de notificação na tela inicial. Eles acionam artificialmente o seu sistema de dopamina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключи красные значки уведомлений на своем главном экране. Они искусственно стимулируют твою дофаминовую систему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekranınızdaki kırmızı bildirim işaretlerini devre dışı bırakın. Dopamin sisteminizi yapay olarak tetiklerler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的主屏幕上关闭红色通知徽章。它们会人为触发你的多巴胺系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用主畫面上的紅色通知徽章。它們人為地觸發您的多巴胺系統。"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte dein Handy während der allerersten 15 Minuten deines Arbeitstages auf Flugmodus. Nur 15 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your phone on airplane mode for the very first 15 minutes of your work day. Only 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon tu teléfono en modo avión durante los primeros 15 minutos de tu jornada laboral. Sólo 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez votre téléphone en mode avion pendant les 15 premières minutes de votre journée de travail. Seulement 15 minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने कार्य दिवस के पहले 15 मिनट के लिए अपने फ़ोन को एयरप्लेन मोड पर रखें। सिर्फ 15 मिनट."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti il ​​telefono in modalità aereo per i primi 15 minuti della tua giornata lavorativa. Solo 15 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勤務時間の最初の 15 分間は、携帯電話を機内モードにしてください。たったの15分。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근무일 중 처음 15분 동안 휴대폰을 비행기 모드로 전환하세요. 단 15분."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet uw telefoon de eerste 15 minuten van uw werkdag in de vliegtuigmodus. Slechts 15 minuten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełącz telefon w tryb samolotowy na pierwsze 15 minut dnia pracy. Tylko 15 minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque seu telefone no modo avião durante os primeiros 15 minutos do seu dia de trabalho. Apenas 15 minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключи свой телефон в режим полета в первые 15 минут твоего рабочего дня. Всего 15 минут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İş gününüzün ilk 15 dakikasında telefonunuzu uçak moduna alın. Sadece 15 dakika."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你工作日的最初15分钟内，将你的手机切换到飞行模式。只需15分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在工作日的前 15 分鐘將手機調至飛航模式。只需要15分鐘。"
          }
        }
      }
    },
    "assessment.mental.profile.getriebener.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist extrem reaktiv und hast null mentalen Fokus. Wir trainieren den Fokus-Muskel nicht mit stundenlanger Meditation, sondern mit winzigen Intervallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are extremely reactive and have zero mental focus. We train the focus muscle not with hours of meditation, but with tiny intervals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres extremadamente reactivo y no tienes concentración mental. Entrenamos el músculo de enfoque no con horas de meditación, sino con pequeños intervalos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes extrêmement réactif et n’avez aucune concentration mentale. Nous entraînons le muscle de concentration non pas avec des heures de méditation, mais avec de petits intervalles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बेहद प्रतिक्रियाशील हैं और आपका मानसिक फोकस शून्य है। हम फोकस मांसपेशियों को घंटों ध्यान से नहीं, बल्कि छोटे-छोटे अंतरालों से प्रशिक्षित करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei estremamente reattivo e hai zero concentrazione mentale. Alleniamo il muscolo della concentrazione non con ore di meditazione, ma con piccoli intervalli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは非常に反応的で、精神的な集中力がゼロです。私たちは集中力の筋肉を何時間も瞑想するのではなく、小さな間隔でトレーニングします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 극도로 반응적이며 정신적 집중력이 전혀 없습니다. 우리는 몇 시간의 명상이 아니라 아주 짧은 간격으로 집중 근육을 훈련합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent extreem reactief en hebt geen enkele mentale focus. We trainen de focusspier niet met urenlange meditatie, maar met kleine tussenpozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś niezwykle reaktywny i masz zerową koncentrację mentalną. Trenujemy mięsień skupienia nie godzinami medytacji, ale małymi przerwami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é extremamente reativo e não tem foco mental. Treinamos o músculo do foco não com horas de meditação, mas com pequenos intervalos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты крайне реактивен и у тебя нулевой умственный фокус. Мы тренируем мышцу фокуса не часами медитацией, а маленькими интервалами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son derece reaktifsiniz ve zihinsel odaklanmanız sıfır. Odaklanma kasını saatlerce meditasyonla değil, küçük aralıklarla çalıştırıyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你反应极端且完全没有心理集中力。我们不是通过长时间的冥想来训练专注力肌肉，而是通过极短的时间间隔进行训练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的反應性極強，精神集中度為零。我們訓練焦點肌肉不是透過幾個小時的冥想，而是透過很小的間隔。"
          }
        }
      }
    },

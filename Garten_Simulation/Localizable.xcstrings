    "prog_meditation_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute gibt es keine Technik. Sitze einfach. Sei präsent mit dem, was ist. Absolute Stille."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today there is no technology. Just sit. Be present with what is. Absolute silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay tecnología. Sólo siéntate. Estar presente con lo que es. Silencio absoluto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, il n’existe pas de technologie. Asseyez-vous. Soyez présent avec ce qui est. Silence absolu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कोई तकनीक नहीं है. बस बैठो. जो है उसके साथ उपस्थित रहो. पूर्ण मौन."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non esiste la tecnologia. Siediti e basta. Sii presente con ciò che è. Silenzio assoluto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日ではテクノロジーはありません。ただ座ってください。ありのままに存在してください。絶対的な沈黙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘날에는 기술이 없습니다. 그냥 앉아. 있는 그대로 존재하십시오. 절대적인 침묵."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegenwoordig is er geen technologie. Gewoon zitten. Wees aanwezig bij wat is. Absolute stilte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś nie ma technologii. Po prostu usiądź. Bądź obecny w tym, co jest. Absolutna cisza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje não há tecnologia. Apenas sente-se. Esteja presente com o que é. Silêncio absoluto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje não há tecnologia. Apenas sente-se. Esteja presente com o que é. Silêncio absoluto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня нет технологий. Просто посиди. Присутствуйте с тем, что есть. Абсолютная тишина."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün teknoloji yok. Sadece otur. Olanla mevcut olun. Mutlak sessizlik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有技术。就坐吧。临在当下。绝对的沉默。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天沒有技術。就坐吧。臨在當下。絕對的沉默。"
          }
        }
      }
    },

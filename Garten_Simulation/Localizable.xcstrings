    "assessment.growth.q2" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast eine massive, komplexe Aufgabe vor dir, die diese Woche fertig werden muss. Du setzt dich an den Schreibtisch. Was ist deine allererste Handlung?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have a massive, complex task ahead of you that needs to be completed this week. You sit down at the desk. What is your very first action?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene una tarea enorme y compleja por delante que debe completarse esta semana. Te sientas en el escritorio. ¿Cuál es tu primera acción?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez une tâche énorme et complexe qui vous attend et qui doit être accomplie cette semaine. Vous vous asseyez au bureau. Quelle est votre toute première action ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सामने एक बड़ा, जटिल कार्य है जिसे इस सप्ताह पूरा करना होगा। आप डेस्क पर बैठ जाइये. आपकी सबसे पहली क्रिया क्या है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai davanti a te un compito enorme e complesso che deve essere completato questa settimana. Ti siedi alla scrivania. Qual è la tua primissima azione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたには、今週完了する必要がある大規模で複雑なタスクが待っています。あなたは机に座ります。あなたの最初のアクションは何ですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신 앞에는 이번 주에 완료해야 할 거대하고 복잡한 작업이 있습니다. 당신은 책상에 앉는다. 당신의 첫 번째 행동은 무엇입니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ligt een enorme, complexe taak voor u die deze week moet worden voltooid. Je gaat aan het bureau zitten. Wat is jouw allereerste actie?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed Tobą ogromne, złożone zadanie, które musisz wykonać w tym tygodniu. Siadasz przy biurku. Jaka jest Twoja pierwsza akcja?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem uma tarefa enorme e complexa pela frente que precisa ser concluída esta semana. Você se senta à mesa. Qual é a sua primeira ação?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя впереди огромная, сложная задача, которую нужно закончить на этой неделе. Ты садишься за письменный стол. Какое будет твоё первое действие?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önünüzde bu hafta tamamlanması gereken devasa, karmaşık bir görev var. Masaya oturuyorsun. İlk eyleminiz nedir?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你面前有一个庞大而复杂的任务，这周必须完成。你坐到书桌前。你的第一步行动是什么？"

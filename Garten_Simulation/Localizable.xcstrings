          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Często piję tylko wtedy, gdy boli mnie głowa lub jestem bardzo spragniony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muitas vezes só bebo quando tenho dor de cabeça ou muita sede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я часто пью только тогда, когда у меня начинаются головные боли или сильная жажда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğunlukla yalnızca başım ağrıdığında ya da aşırı susadığımda içiyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

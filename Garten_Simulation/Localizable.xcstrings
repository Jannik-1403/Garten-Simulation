    "streak.motivation.7": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten w\u00e4chst mit dir!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden grows with you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Tu jard\u00edn crece contigo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton jardin grandit avec toi !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0917\u0940\u091a\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u0922\u093c\u0924\u093e \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden grows with you!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u306f\u3042\u306a\u305f\u3068\u4e00\u7dd2\u306b\u6210\u9577\u3057\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc815\uc6d0\uc740 \ub2f9\uc2e0\uacfc \ud568\uaed8 \uc131\uc7a5\ud569\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw tuin groeit met u mee!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j ogr\u00f3d ro\u015bnie razem z Tob\u0105!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu jardim cresce contigo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u0441\u0430\u0434 \u0440\u0430\u0441\u0442\u0435\u0442 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0442\u043e\u0431\u043e\u0439!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7eniz sizinle birlikte b\u00fcy\u00fcyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u82b1\u56ed\u4e0e\u60a8\u4e00\u8d77\u6210\u957f\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u82b1\u5712\u8207\u60a8\u4e00\u8d77\u6210\u9577\uff01"
          }
        }
      }
    },

        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने अपनी खरपतवार की समस्या पर काबू पा लिया है।%2$dघंटों के लिए आपको हर पानी देने पर%1$@XP मिलेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai superato la crisi delle erbacce. Per %2$d ore: %1$@ XP per annaffiatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは雑草の危機を克服しました。 %2$d 時間、水やりごとに %1$@ XP を獲得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대마초 위기를 극복하셨습니다. %2$d시간 동안 물을 주면 %1$@ XP를 얻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de wietcrisis overwonnen. Gedurende %2$d uur verdien je %1$@ XP per gietbeurt."

    "shop.weed_blocks_planting": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unkraut blockiert das Anpflanzen! J\u00e4te es zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weed blocks planting! Remove it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las malas hierbas bloquean la plantaci\u00f3n. Qu\u00edtalas primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises herbes bloquent la plantation ! Retire-les d'abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0902\u0917\u0932\u0940 \u0918\u093e\u0938 \u092a\u094c\u0927\u094b\u0902 \u0915\u0940 \u0930\u094b\u092a\u093e\u0908 \u092e\u0947\u0902 \u092c\u093e\u0927\u093e \u0921\u093e\u0932 \u0930\u0939\u0940 \u0939\u0948! \u092a\u0939\u0932\u0947 \u0907\u0938\u0947 \u0928\u093f\u0915\u093e\u0932\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le erbacce bloccano la semina! Rimuovile prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96d1\u8349\u30d6\u30ed\u30c3\u30af\u690d\u3048\uff01\u307e\u305a\u305d\u308c\u3092\u53d6\u308a\u5916\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a1\ucd08 \ube14\ub85d \uc2ec\uae30! \uba3c\uc800 \uc81c\uac70\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wietblokken planten! Verwijder het eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwasty blokuj\u0105 sadzenie! Najpierw go usu\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas bloqueiam o plantio! Remove-as primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0440\u043d\u044f\u043a\u0438 \u043c\u0435\u0448\u0430\u044e\u0442 \u043f\u043e\u0441\u0430\u0434\u043a\u0435! \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0445 \u043f\u0440\u043e\u043f\u043e\u043b\u0438\u0442\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ot bloklar\u0131 ekimi! \u00d6nce onu kald\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6742\u8349\u963b\u788d\u79cd\u690d\uff01\u5148\u9664\u8349\u5427"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96dc\u8349\u963b\u7919\u7a2e\u690d\uff01\u5148\u9664\u8349\u5427"
          }
        }
      }
    },

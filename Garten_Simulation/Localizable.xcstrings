    "prog_stretching_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kombination aus allen Elementen dieser Woche in einem fließenden Ablauf."
          }
        },
        "en": {
          "stringUnit": {

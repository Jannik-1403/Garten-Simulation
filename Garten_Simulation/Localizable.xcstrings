    "paywall.feature.weekly_report.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne dich selbst besser kennen. Entdecke, wann du am produktivsten bist und feiere deinen Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get to know yourself better. Discover when you're most productive and celebrate your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conócete mejor. Descubre cuándo eres más productivo y celebra tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprends à mieux te connaître. Découvre quand tu es le plus productif et célèbre tes progrès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आप को बेहतर तरीके से जानें. जानें कि आप कब सर्वाधिक उत्पादक होते हैं और अपनी प्रगति का जश्न मनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impara a conoscerti meglio. Scopri quando sei più produttivo e festeggia i tuoi progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身をよりよく知りましょう。いつ最も生産的かを発見し、進歩を祝いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신을 더 잘 알아보세요. 언제가 가장 생산적인지 발견하고 진행 상황을 축하하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer jezelf beter kennen. Ontdek wanneer je het meest productief bent en vier je vooruitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj siebie lepiej. Odkryj, kiedy jesteś najbardziej produktywny i świętuj swoje postępy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça-se melhor. Descubra quando você é mais produtivo e celebre seu progresso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça-se melhor. Descubra quando você é mais produtivo e celebre seu progresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше узнай себя. Выясни, когда ты наиболее продуктивен, и отмечай свой прогресс."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendini daha iyi tanı. Ne zaman en üretken olduğunu keşfet ve ilerlemeni kutla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更好地了解自己。发现您何时效率最高，并庆祝您的进步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更了解自己。發現您何時最有生產力並慶祝您的進步。"
          }
        }
      }
    },

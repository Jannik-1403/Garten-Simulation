    "shop.insufficient_coins.message_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir fehlen noch %@ M\u00fcnzen, um diese Gewohnheit freizuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still need %@ coins to unlock this habit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan necesitas %@ monedas para desbloquear este h\u00e1bito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te manque %@ pi\u00e8ces pour d\u00e9bloquer cette habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u092a\u093e\u0938 \u0907\u0938 \u0906\u0926\u0924 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092d\u0940 \u092d\u0940%@\u0938\u093f\u0915\u094d\u0915\u0947 fehlen \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti mancano %@ monete per sbloccare questa abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u7fd2\u6163\u3092\u89e3\u653e\u3059\u308b\u306b\u306f\u3001\u3042\u3068%@\u30b3\u30a4\u30f3\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc2b5\uad00\uc744 \ud574\uc81c\ud558\ub824\uba74 \uc544\uc9c1 %@ \ucf54\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog %@ munten nodig om deze gewoonte te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebujesz jeszcze %@ monet, aby odblokowa\u0107 ten nawyk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea ainda precisa de %@ moedas para desbloquear este h\u00e1bito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u0431\u0435 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442%@\u043c\u043e\u043d\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u0443 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu al\u0131\u015fkanl\u0131\u011f\u0131n kilidini a\u00e7mak i\u00e7in hala %@ jetona ihtiyac\u0131n\u0131z var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4ecd\u7136\u9700\u8981%@\u5e01\u6765\u89e3\u9501\u8fd9\u4e2a\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4ecd\u7136\u9700\u8981%@\u5e63\u4f86\u89e3\u9396\u9019\u500b\u7fd2\u6163\u3002"
          }
        }
      }
    },

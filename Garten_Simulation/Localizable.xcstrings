            "value": "1週間夜のスナックを記録しましょう。合計カロリーに驚くはずです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일 동안 저녁 간식을 기록하세요 – 총 칼로리가 놀라울 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een week lang bij wat je 's avonds snackt – het totaal aan calorieën zal je verbazen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez tydzień zapisuj wieczorne przekąski – łączna liczba kalorii cię zaskoczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre os lanches noturnos por uma semana – o total de calorias vai te surpreender."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre os lanches noturnos por uma semana – o total de calorias vai te surpreender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите учет вечерних перекусов в течение недели – общая калорийность вас удивит."
          }

        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurige verlichting voor de nacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogniste o\u015bwietlenie na noc."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina\u00e7\u00e3o ardente para a noite."

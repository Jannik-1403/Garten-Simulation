    "Gewohnheiten, Routinen und Fokus an einem Ort. Beginne gern mit ein bis drei Gewohnheiten – du kannst jederzeit kostenlos weitere hinzufügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewohnheiten, Routinen und Fokus an einem Ort. Beginne gern mit ein bis drei Gewohnheiten – du kannst jederzeit kostenlos weitere hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Habits, routines, and focus in one place. Start with one to three habits — add more anytime for free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos, rutinas y enfoque en un solo lugar. Comienza con uno a tres hábitos; puedes añadir más gratis en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitudes, routines et focus au même endroit. Commencez par une à trois habitudes — vous pouvez en ajouter d'autres gratuitement à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आदतें, दिनचर्या और एकाग्रता एक ही स्थान पर। 1 से 3 आदतों से शुरुआत करें — आप कभी भी मुफ्त में और जोड़ सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitudini, routine e concentrazione in un unico posto. Inizia con una o tre abitudini: puoi aggiungerne altre gratis in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣、ルーティン、フォーカスを1つの場所に。まずは1〜3個の習慣から始めましょう。いつでも無料で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관, 루틴, 집중을 한 곳에서 관리하세요. 1~3개의 습관으로 시작해 보세요. 언제든 무료로 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewoonten, routines en focus op één plek. Begin gerust met één tot drie gewoonten — voeg er op elk gewenst moment gratis meer toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawyki, rutyny i skupienie w jednym miejscu. Zacznij od 1-3 nawyków — w każdej chwili możesz dodać kolejne za darmo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos, rotinas e foco num só lugar. Começa com um a três hábitos — podes adicionar mais gratuitamente a qualquer momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos, rotinas e foco em um só lugar. Comece com um a três hábitos — você pode adicionar mais gratuitamente a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычки, рутины и фокус в одном месте. Начните с одной-трех привычек — вы можете бесплатно добавить больше в любое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıklar, rutinler ve odak tek bir yerde. 1 ila 3 alışkanlıkla başlayın — istediğiniz zaman ücretsiz olarak daha fazlasını ekleyebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯、日常和专注融为一体。先从一到三个习惯开始——你可以随时免费添加更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣、日常和專注合而為一。先從一到三個習慣開始——您可以隨時免費新增更多。"
          }
        }
      }
    },
    "Gewohnheiten, Routinen, To-Dos und Fokus bleiben kostenlos und ohne Mengenlimit. Pro ergänzt Analysen, PDF-Berichte und Premium-Fokusklänge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewohnheiten, Routinen, To-Dos und Fokus bleiben kostenlos und ohne Mengenlimit. Pro ergänzt Analysen, PDF-Berichte und Premium-Fokusklänge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Habits, routines, to-dos, and focus remain free with unlimited capacity. Pro adds analytics, PDF reports, and premium focus sounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hábitos, rutinas, tareas y enfoque siguen siendo gratuitos e ilimitados. Pro añade analíticas, informes en PDF y sonidos de enfoque premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les habitudes, routines, tâches et le focus restent gratuits et illimités. Pro ajoute des analyses, des rapports PDF et des sons de concentration premium."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आदतें, दिनचर्या, कार्य और एकाग्रता असीमित रूप से निःशुल्क रहेंगी। प्रो उन्नत विश्लेषण, पीडीएफ रिपोर्ट और प्रीमियम फोकस ध्वनियाँ जोड़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitudini, routine, to-do e concentrazione restano gratuiti e senza limiti. Pro aggiunge analisi, report PDF e suoni di concentrazione premium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣、ルーティン、To-Do、フォーカスは無制限に無料でご利用いただけます。Proプランでは分析、PDFレポート、プレミアム集中サウンドが追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관, 루틴, 할 일, 집중 기능은 무제한 무료로 유지됩니다. Pro는 분석, PDF 보고서, 프리미엄 집중 사운드를 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewoonten, routines, to-do's en focus blijven gratis en onbeperkt. Pro voegt analyses, PDF-rapporten en premium focusgeluiden toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawyki, rutyny, zadania i skupienie pozostają darmowe i nielimitowane. Wersja Pro dodaje analitykę, raporty PDF i dźwięki skupienia premium."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos, rotinas, tarefas e foco continuam gratuitos e sem limites. O Pro adiciona análises, relatórios em PDF e sons de foco premium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hábitos, rotinas, tarefas e foco continuam gratuitos e sem limites. O Pro adiciona análises, relatórios em PDF e sons de foco premium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычки, рутины, задачи и фокус остаются бесплатными и без ограничений. Pro открывает аналитику, PDF-отчеты и премиум-звуки для фокуса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıklar, rutinler, yapılacaklar ve odak ücretsiz ve sınırsız kalır. Pro; analizler, PDF raporları ve premium odak sesleri ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯、日常、待办和专注功能完全免费且不限数量。Pro 提供深度分析、PDF 报告和高级专注白噪音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣、日常、待辦與專注功能完全免費且無數量限制。Pro 提供深度分析、PDF 報告與進階專注白噪音。"
          }
        }
      }
    },

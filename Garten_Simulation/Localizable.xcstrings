    "backup_export_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere deinen Fortschritt als .gartensave Datei. Du kannst sie auf anderen Ger\u00e4ten importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your progress as a .gartensave file. You can import it on other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu progreso como archivo .gartensave. Puedes importarlo en otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde ta progression dans un fichier .gartensave. Tu peux l'importer sur d'autres appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u094b .gartensave \u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0939\u0947\u091c\u0947\u0902\u0964 \u0906\u092a \u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0906\u092f\u093e\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your progress as a .gartensave file. You can import it on other devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9032\u884c\u72b6\u6cc1\u3092 .gartensave \u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u4fdd\u5b58\u3057\u307e\u3059\u3002\u4ed6\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30a4\u30f3\u30dd\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c4\ud589 \uc0c1\ud669\uc744 .gartensave \ud30c\uc77c\ub85c \uc800\uc7a5\ud558\uc138\uc694. \ub2e4\ub978 \uc7a5\uce58\ub85c \uac00\uc838\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla uw voortgang op als een .gartensave-bestand. U kunt het op andere apparaten importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz swoje post\u0119py jako plik .gartensave. Mo\u017cesz zaimportowa\u0107 go na inne urz\u0105dzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o teu progresso como ficheiro .gartensave. Podes import\u00e1-lo noutros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0438 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0432 \u0444\u0430\u0439\u043b .gartensave. \u0422\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lerlemenizi .gartensave dosyas\u0131 olarak kaydedin. Di\u011fer cihazlara aktarabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u4f60\u7684\u8fdb\u5ea6\u4fdd\u5b58\u4e3a .gartensave \u6587\u4ef6\u3002\u4f60\u53ef\u4ee5\u5728\u5176\u4ed6\u8bbe\u5907\u4e0a\u5bfc\u5165\u5b83\u4eec\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u60a8\u7684\u9032\u5ea6\u5132\u5b58\u70ba .gartensave \u6a94\u6848\u3002\u60a8\u53ef\u4ee5\u5c07\u5b83\u5011\u532f\u5165\u5230\u5176\u4ed6\u88dd\u7f6e\u3002"
          }
        }
      }
    },

    "prog_strength_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle einen Timer auf %lld Minuten. Absolviere so viele saubere Runden wie möglich. Bei unsauberer Technik abbrechen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a timer for %lld minutes. Complete as many clean rounds as possible. Stop if form breaks down!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure un temporizador para %lld minutos. Completa tantas vueltas limpias como puedas. ¡Cancelar si la técnica no está limpia!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez une minuterie sur %lld minutes. Effectuez autant de tours propres que possible. Annulez si la technique n'est pas propre !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld मिनट के लिए टाइमर सेट करें। यथासंभव अधिक से अधिक स्वच्छ लैप्स पूरे करें। अगर तकनीक साफ़ नहीं है तो रद्द करें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un timer per %lld minuti. Completa il maggior numero di giri puliti possibile. Annulla se la tecnica non è pulita!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーを %lld 分に設定します。できるだけ多くのきれいなラウンドを完了してください。フォームが崩れたら中止してください！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머를 %lld 분으로 설정하세요. 가능한 한 많은 깔끔한 라운드를 완료하세요. 자세가 흐트러지면 중단하세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een timer op %lld minuten. Voltooi zoveel mogelijk nette rondes. Stop als de techniek slordig wordt!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw timer na %lld minut. Wykonaj jak najwięcej czystych rund. Przerwij, jeśli technika stanie się niedbała!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um cronômetro para %lld minutos. Conclua o máximo de rodadas limpas possível. Pare se a técnica ficar ruim!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um cronômetro para %lld minutos. Conclua o máximo de rodadas limpas possível. Pare se a técnica ficar ruim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите таймер на %lld минут. Выполните как можно больше чистых раундов. Прекратите, если техника нарушится!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakika boyunca bir zamanlayıcı ayarlayın. Mümkün olduğu kadar çok temiz tur tamamlayın. Teknik temiz değilse iptal edin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将计时器设定为 %lld 分钟。尽可能多地完成标准轮次。如果动作不标准请停止！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將計時器設定為 %lld 分鐘。盡可能多地完成標準輪次。如果動作不標準請停止！"
          }
        }
      }
    },

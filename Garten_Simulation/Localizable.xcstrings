        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un motivo personalizzato per questa ricaduta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u518d\u767a\u306e\u30ab\u30b9\u30bf\u30e0\u7406\u7531\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc7ac\ubc1c\uc5d0 \ub300\ud55c \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc774\uc720\ub97c \uc785\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een aangepaste reden in voor deze terugval."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowad\u017a niestandardowy pow\u00f3d tego nawrotu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um motivo personalizado para esta reca\u00edda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0441\u0432\u043e\u044e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u044d\u0442\u043e\u0433\u043e \u0440\u0435\u0446\u0438\u0434\u0438\u0432\u0430."

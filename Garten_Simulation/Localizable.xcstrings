    "timer.preview.body.example": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wartet auf dich. Gib ihr heute noch etwas Wasser!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is waiting for you. Give it some water today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te espera. \u00a1Dale un poco de agua hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ t'attend. Donne-lui un peu d'eau aujourd'hui !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0907\u0902\u0924\u091c\u093e\u0930 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948\u0964 \u0909\u0938\u0947 \u0906\u091c \u0939\u0940 \u0925\u094b\u0921\u093c\u093e \u092a\u093e\u0928\u0940 \u0926\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ti sta aspettando. Dagle un po' d'acqua oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u304c\u3042\u306a\u305f\u3092\u5f85\u3063\u3066\u3044\u307e\u3059\u3002\u4eca\u65e5\u306f\u6c34\u3092\u3042\u3052\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\ub2d8\uc774 \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc624\ub298\uc740 \ubb3c\uc744 \uc880 \uc8fc\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wacht op je. Geef hem vandaag nog wat water!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ czeka na Ciebie. Daj mu dzi\u015b troch\u0119 wody!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est\u00e1 \u00e0 tua espera. D\u00e1-lhe um pouco de \u00e1gua hoje!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044f. \u0414\u0430\u0439 \u0435\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0432\u043e\u0434\u044b!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sizi bekliyor. Bug\u00fcn ona biraz su ver!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u6b63\u5728\u7b49\u4f60\u3002\u4eca\u5929\u7ed9\u5979\u591a\u559d\u70b9\u6c34\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u6b63\u5728\u7b49\u4f60\u3002\u4eca\u5929\u7d66\u5979\u591a\u559d\u9ede\u6c34\u5427\uff01"
          }
        }
      }
    },

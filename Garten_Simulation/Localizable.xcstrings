    "pfad_gesund_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte auf deine t\u00e4gliche Wasserzufuhr f\u00fcr mehr Lebensenergie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay attention to your daily water intake for more vital energy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presta atenci\u00f3n a tu ingesta diaria de agua para tener m\u00e1s energ\u00eda vital."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais attention \u00e0 ton apport quotidien en eau pour plus d'\u00e9nergie vitale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0927\u093f\u0915 \u091c\u0940\u0935\u0928 \u090a\u0930\u094d\u091c\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0926\u0948\u0928\u093f\u0915 \u092a\u093e\u0928\u0940 \u0915\u0947 \u0938\u0947\u0935\u0928 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai attenzione al tuo apporto giornaliero di acqua per pi\u00f9 energia vitale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3088\u308a\u591a\u304f\u306e\u751f\u547d\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u6bce\u65e5\u306e\u6c34\u5206\u6442\u53d6\u91cf\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub354 \ud65c\ub825 \uc788\ub294 \uc5d0\ub108\uc9c0\ub97c \uc5bb\uc73c\ub824\uba74 \uc77c\uc77c \ubb3c \uc12d\ucde8\ub7c9\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc774\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besteed aandacht aan uw dagelijkse waterinname voor meer vitale energie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwr\u00f3\u0107 uwag\u0119 na dzienne spo\u017cycie wody, aby uzyska\u0107 wi\u0119cej energii \u017cyciowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Presta aten\u00e7\u00e3o \u00e0 tua ingest\u00e3o di\u00e1ria de \u00e1gua para mais energia vital."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0440\u0430\u0449\u0430\u0439 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0432\u043e\u0451 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0434\u044b \u0434\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0439 \u044d\u043d\u0435\u0440\u0433\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hayati enerji i\u00e7in g\u00fcnl\u00fck su al\u0131m\u0131n\u0131za dikkat edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\u4f60\u7684\u65e5\u5e38\u996e\u6c34\u91cf\uff0c\u4ee5\u83b7\u5f97\u66f4\u591a\u751f\u547d\u80fd\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\u6bcf\u5929\u7684\u98f2\u6c34\u91cf\uff0c\u4ee5\u7372\u5f97\u66f4\u591a\u7684\u751f\u547d\u80fd\u91cf\u3002"
          }
        }
      }
    },
    "pfad_gesund_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldener Status. Dein K\u00f6rper ist dein Tempel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden status. Your body is your temple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado dorado. Tu cuerpo es tu templo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statut dor\u00e9. Ton corps est ton temple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u0930\u094d\u0923\u093f\u092e \u0938\u094d\u0925\u093f\u0924\u093f. \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0906\u092a\u0915\u093e \u092e\u0902\u0926\u093f\u0930 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Status d'oro. Il tuo corpo \u00e8 il tuo tempio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b4\u30fc\u30eb\u30c7\u30f3\u30b9\u30c6\u30fc\u30bf\u30b9\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u3042\u306a\u305f\u306e\u795e\u6bbf\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud669\uae08 \uc0c1\ud0dc. \ub2f9\uc2e0\uc758 \ubab8\uc740 \ub2f9\uc2e0\uc758 \uc0ac\uc6d0\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gouden status. Je lichaam is je tempel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z\u0142oty status. Twoje cia\u0142o jest Twoj\u0105 \u015bwi\u0105tyni\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de ouro. O teu corpo \u00e9 o teu templo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u043e\u043b\u043e\u0442\u043e\u0439 \u0441\u0442\u0430\u0442\u0443\u0441. \u0422\u0432\u043e\u0451 \u0442\u0435\u043b\u043e \u2014 \u0442\u0432\u043e\u0439 \u0445\u0440\u0430\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt\u0131n durumu. V\u00fccudunuz sizin tap\u0131na\u011f\u0131n\u0131zd\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ec4\u91d1\u72b6\u6001\u3002\u4f60\u7684\u8eab\u4f53\u662f\u4f60\u7684\u6bbf\u5802\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ec3\u91d1\u5730\u4f4d\u3002\u4f60\u7684\u8eab\u9ad4\u5c31\u662f\u4f60\u7684\u5bfa\u5edf\u3002"
          }
        }
      }
    },
    "pfad_gesund_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheit maximieren. Dein K\u00f6rper dankt dir jeden Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximize health. Your body thanks you every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximiza la salud. Tu cuerpo te lo agradece cada d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximise ta sant\u00e9. Ton corps te remercie chaque jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u094b \u0905\u0927\u093f\u0915\u0924\u092e \u0915\u0930\u0947\u0902. \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0939\u0930 \u0926\u093f\u0928 \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massimizza la salute. Il tuo corpo ti ringrazia ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5065\u5eb7\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u6bce\u65e5\u3042\u306a\u305f\u306b\u611f\u8b1d\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac74\uac15\uc744 \uadf9\ub300\ud654\ud558\uc138\uc694. \ub2f9\uc2e0\uc758 \ubab8\uc740 \ub9e4\uc77c \ub2f9\uc2e0\uc5d0\uac8c \uac10\uc0ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaliseer de gezondheid. Je lichaam bedankt je elke dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalizuj zdrowie. Twoje cia\u0142o dzi\u0119kuje Ci ka\u017cdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximiza a sa\u00fade. O teu corpo agradece-te todos os dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u043a\u0441\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0439 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435. \u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442 \u0442\u0435\u0431\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa\u011fl\u0131\u011f\u0131 en \u00fcst d\u00fczeye \u00e7\u0131kar\u0131n. V\u00fccudunuz size her g\u00fcn te\u015fekk\u00fcr ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u5927\u5316\u5065\u5eb7\u3002\u4f60\u7684\u8eab\u4f53\u6bcf\u5929\u90fd\u4f1a\u611f\u8c22\u4f60\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u5927\u5316\u5065\u5eb7\u3002\u4f60\u7684\u8eab\u9ad4\u6bcf\u5929\u90fd\u6703\u611f\u8b1d\u4f60\u3002"
          }
        }
      }
    },
    "pfad_leer_beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Pfad beginnt beim ersten Start der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your path starts when you first open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu camino comienza cuando abres la app por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton chemin commence quand tu ouvres l'application pour la premi\u00e8re fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u092c \u0906\u092a \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0910\u092a \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0906\u092a\u0915\u093e \u092a\u0925 \u0936\u0941\u0930\u0942 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo percorso inizia al primo avvio dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u521d\u3081\u3066\u30a2\u30d7\u30ea\u3092\u958b\u3044\u305f\u3068\u304d\u306b\u30d1\u30b9\u304c\u59cb\u307e\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571\uc744 \ucc98\uc74c \uc5f4\uba74 \uacbd\ub85c\uac00 \uc2dc\uc791\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw pad begint wanneer u de app voor het eerst opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja \u015bcie\u017cka zaczyna si\u0119, gdy po raz pierwszy otworzysz aplikacj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu caminho come\u00e7a quando abres a aplica\u00e7\u00e3o pela primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0439 \u043f\u0443\u0442\u044c \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043f\u0435\u0440\u0432\u043e\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolunuz uygulamay\u0131 ilk a\u00e7t\u0131\u011f\u0131n\u0131zda ba\u015flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u8def\u5f84\u5728\u9996\u6b21\u542f\u52a8\u5e94\u7528\u65f6\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7576\u60a8\u7b2c\u4e00\u6b21\u555f\u52d5\u61c9\u7528\u7a0b\u5f0f\u6642\uff0c\u60a8\u7684\u8def\u5f91\u5c31\u958b\u59cb\u4e86\u3002"
          }
        }
      }
    },

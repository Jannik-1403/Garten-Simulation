    "prog_saving_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du online etwas siehst, das du kaufen willst: Pack es in den Warenkorb, aber warte 72 Stunden. Meistens verfliegt der Drang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you see something online that you want to buy: Add it to your cart, but wait 72 hours. Most of the time the urge goes away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ves algo en línea que quieres comprar: agrégalo a tu carrito, pero espera 72 horas. La mayoría de las veces las ganas desaparecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous voyez quelque chose en ligne que vous souhaitez acheter: ajoutez-le à votre panier, mais attendez 72 heures. La plupart du temps, l’envie disparaît."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको कोई चीज़ ऑनलाइन दिखती है जिसे आप खरीदना चाहते हैं: उसे अपने कार्ट में जोड़ें, लेकिन 72 घंटे प्रतीक्षा करें। अधिकांश समय इच्छा दूर हो जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vedi qualcosa online che desideri acquistare: aggiungilo al carrello, ma attendi 72 ore. Nella maggior parte dei casi l'impulso scompare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入したい商品をオンラインで見つけた場合: カートに追加しますが、72 時間待ちます。ほとんどの場合、衝動は消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매하고 싶은 물건이 온라인에서 발견된 경우: 장바구니에 추가하고 72시간 동안 기다리세요. 대부분의 경우 충동이 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u online iets ziet dat u wilt kopen: voeg het toe aan uw winkelwagen, maar wacht 72 uur. Meestal verdwijnt de drang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zobaczysz w Internecie coś, co chcesz kupić: Dodaj to do koszyka, ale poczekaj 72 godziny. W większości przypadków chęć zanika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você vir algo online que deseja comprar: adicione ao carrinho, mas espere 72 horas. Na maioria das vezes a vontade vai embora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você vir algo online que deseja comprar: adicione ao carrinho, mas espere 72 horas. Na maioria das vezes a vontade vai embora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы видите в Интернете что-то, что хотите купить: добавьте это в корзину, но подождите 72 часа. В большинстве случаев желание проходит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternette satın almak istediğiniz bir şey görürseniz: Sepetinize ekleyin, ancak 72 saat bekleyin. Çoğu zaman dürtü kaybolur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您在网上看到想要购买的商品：将其添加到购物车，但等待 72 小时。大多数时候，这种冲动就会消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您在網上看到您想要購買的商品：將其添加到購物車，但等待 72 小時。大多數時候，這種衝動就會消失。"
          }
        }
      }
    },

    "backup_fehler_format": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden. Bitte stelle sicher, dass es sich um eine gültige .gartensave-Datei handelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read. Please make sure it is a valid .gartensave file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no pudo leerse. Asegúrate de que sea un archivo .gartensave válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être lu. Assure-toi qu'il s'agit d'un fichier .gartensave valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल पढ़ी नहीं जा सकी. कृपया सुनिश्चित करें कि यह एक वैध .gartensave फ़ाइल है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file. Assicurati che sia un file .gartensave valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み取れませんでした。有効な .gartensave ファイルであることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽을 수 없습니다. 유효한 .gartensave 파일인지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kon niet worden gelezen. Zorg ervoor dat het een geldig .gartensave-bestand is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać pliku. Upewnij się, że jest to prawidłowy plik .gartensave."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro não pôde ser lido. Certifica-te de que é um ficheiro .gartensave válido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro não pôde ser lido. Certifica-te de que é um ficheiro .gartensave válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не удалось прочитать. Пожалуйста, убедитесь, что это действительный файл .gartensave."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya okunamadı. Lütfen geçerli bir .gartensave dosyası olduğundan emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件。请确保这是一个有效的 .gartensave 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取該檔案。請確保它是有效的 .gartensave 檔案。"
          }
        }
      }
    },

    "iap_restore_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ WICHTIG: 'Käufe wiederherstellen' funktioniert bei Apple NUR für Einmalkäufe (wie die Sonnenbrille). Münzen (Consumables) können laut Apple-Regeln niemals wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ IMPORTANT: 'Restore Purchases' ONLY works for non-consumables (like the sunglasses). Coins (consumables) can never be restored according to Apple rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ IMPORTANTE: 'Restaurar compras' SOLO funciona para compras no consumibles (como las gafas de sol). Las monedas no se pueden restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ IMPORTANT : 'Restaurer les achats' fonctionne UNIQUEMENT pour les achats non consommables (comme les lunettes). Les pièces ne peuvent pas être restaurées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ IMPORTANTE: 'Ripristina acquisti' funziona SOLO per articoli non di consumo (come gli occhiali da sole). Le monete non possono essere ripristinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 重要: 「購入の復元」は、非消耗品（サングラスなど）にのみ機能します。コインは復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 중요: '구매 복원'은 비소모품(선글라스 등)에만 적용됩니다. 코인은 복원할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ BELANGRIJK: 'Aankopen herstellen' werkt ALLEEN voor niet-verbruiksartikelen (zoals zonnebrillen). Munten kunnen niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ WAŻNE: 'Przywróć zakupy' działa TYLKO dla przedmiotów jednorazowych (jak okulary). Monet nie można przywrócić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ IMPORTANTE: 'Restaurar Compras' funciona APENAS para não consumíveis (como óculos de sol). Moedas nunca podem ser restauradas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

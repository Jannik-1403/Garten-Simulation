    "plant.farn.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht kein Licht von Bildschirmen – Digital Detox"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs no light from screens – Digital Detox"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesita luz de pantallas – Desintoxicación digital"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'a pas besoin de la lumière des écrans – Détox numérique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन की रोशनी की ज़रूरत नहीं – डिजिटल डिटॉक्स"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha bisogno della luce degli schermi – Digital Detox"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面からの光は必要ありません – デジタル デトックス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 빛이 필요하지 않습니다 – Digital Detox"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft geen licht van schermen nodig – Digital Detox"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potrzebuje światła z ekranów – Digital Detox"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa de luz de ecrãs – Desintoxicação digital"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa de luz de ecrãs – Desintoxicação digital"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не нуждается в свете экранов – цифровой детокс"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranlardan gelen ışığa ihtiyaç duymaz – Dijital Detoks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要屏幕光——数字排毒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要螢幕的光線——數位排毒"
          }
        }
      }
    },

    "assessment.growth.profile.traeumer.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich 24 Stunden lang mit niemandem \u00fcber eine neue Idee, bevor du nicht den allerersten Schritt getan hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't talk to anyone about a new idea for 24 hours until you've taken the very first step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hables con nadie sobre una nueva idea durante 24 horas hasta que hayas dado el primer paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne parlez \u00e0 personne d'une nouvelle id\u00e9e pendant 24 heures jusqu'\u00e0 ce que vous ayez fait le tout premier pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u090f \u0935\u093f\u091a\u093e\u0930 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 24 \u0918\u0902\u091f\u0947 \u0924\u0915 \u0915\u093f\u0938\u0940 \u0938\u0947 \u092c\u093e\u0924 \u0928 \u0915\u0930\u0947\u0902 \u091c\u092c \u0924\u0915 \u0915\u093f \u0906\u092a \u092a\u0939\u0932\u093e \u0915\u0926\u092e \u0928 \u0909\u0920\u093e \u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non parlare con nessuno di una nuova idea per 24 ore finch\u00e9 non hai fatto il primo passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u521d\u306e\u4e00\u6b69\u3092\u8e0f\u307f\u51fa\u3059\u307e\u3067\u300124 \u6642\u9593\u306f\u65b0\u3057\u3044\u30a2\u30a4\u30c7\u30a2\u306b\u3064\u3044\u3066\u8ab0\u306b\u3082\u8a71\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uccab \ubc88\uc9f8 \ub2e8\uacc4\ub97c \ubc1f\uc744 \ub54c\uae4c\uc9c0 24\uc2dc\uac04 \ub3d9\uc548 \ub204\uad6c\uc5d0\uac8c\ub3c4 \uc0c8\ub85c\uc6b4 \uc544\uc774\ub514\uc5b4\uc5d0 \ub300\ud574 \uc774\uc57c\uae30\ud558\uc9c0 \ub9c8\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praat 24 uur lang met niemand over een nieuw idee voordat je de allereerste stap hebt gezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie rozmawiaj z nikim o nowym pomy\u015ble przez 24 godziny, dop\u00f3ki nie zrobisz pierwszego kroku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o fale com ningu\u00e9m sobre uma nova ideia por 24 horas antes de dar o primeiro passo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438 \u043d\u0438 \u0441 \u043a\u0435\u043c \u043e \u043d\u043e\u0432\u043e\u0439 \u0438\u0434\u0435\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24 \u0447\u0430\u0441\u043e\u0432, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u0435\u0448\u044c \u043f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lk ad\u0131m\u0131 atana kadar 24 saat boyunca yeni bir fikir hakk\u0131nda kimseyle konu\u015fmay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u8fc8\u51fa\u7b2c\u4e00\u6b65\u4e4b\u524d\uff0c\u4e0d\u8981\u4e0e\u4efb\u4f55\u4eba\u8c08\u8bba\u4e00\u4e2a\u65b0\u60f3\u6cd5\uff0c\u6301\u7eed24\u5c0f\u65f6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8e0f\u51fa\u7b2c\u4e00\u6b65\u4e4b\u524d\uff0c24 \u5c0f\u6642\u5167\u4e0d\u8981\u8207\u4efb\u4f55\u4eba\u8ac7\u8ad6\u65b0\u60f3\u6cd5\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.traeumer.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe jeden Abend nur EINE einzige kleine Aufgabe f\u00fcr den n\u00e4chsten Tag auf ein Post-it."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every evening, write just ONE small task for the next day on a post-it note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las noches, escribe solo UNA peque\u00f1a tarea para el d\u00eda siguiente en una nota adhesiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque soir, \u00e9crivez UNE seule petite t\u00e2che pour le lendemain sur un post-it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0936\u093e\u092e, \u092a\u094b\u0938\u094d\u091f-\u0907\u091f \u0928\u094b\u091f \u092a\u0930 \u0905\u0917\u0932\u0947 \u0926\u093f\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u093e \u0915\u093e\u0930\u094d\u092f \u0932\u093f\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sera, scrivi solo UNA piccola attivit\u00e0 per il giorno successivo su un post-it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u6669\u3001\u30dd\u30b9\u30c8\u30a4\u30c3\u30c8\u306b\u7fcc\u65e5\u306e\u5c0f\u3055\u306a\u30bf\u30b9\u30af\u3092 1 \u3064\u3060\u3051\u66f8\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \uc800\ub141 \ud3ec\uc2a4\ud2b8\uc787\uc5d0 \ub0b4\uc77c \ud560 \uc791\uc740 \uc77c \ud558\ub098\ub9cc \uc801\uc5b4\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf elke avond slechts EEN kleine taak voor de volgende dag op een post-it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cdego wieczoru zapisz na samoprzylepnej karteczce tylko JEDNE ma\u0142e zadanie na nast\u0119pny dzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as noites, escreva apenas UMA pequena tarefa para o dia seguinte em um post-it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u044b\u0439 \u0432\u0435\u0447\u0435\u0440 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0439\u0442\u0435 \u0432\u0441\u0435\u0433\u043e \u041e\u0414\u041d\u0423 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443 \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0435\u043d\u044c \u043d\u0430 \u0441\u0442\u0438\u043a\u0435\u0440\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ak\u015fam bir post-it notuna ertesi g\u00fcn i\u00e7in yaln\u0131zca B\u0130R k\u00fc\u00e7\u00fck g\u00f6rev yaz\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u665a\u4e0a\u53ea\u5728\u4fbf\u7b7e\u4e0a\u5199\u4e0b\u7b2c\u4e8c\u5929\u7684\u4e00\u4e2a\u5c0f\u4efb\u52a1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u665a\u4e0a\uff0c\u5728\u4fbf\u5229\u8cbc\u4e0a\u5beb\u4e0b\u7b2c\u4e8c\u5929\u7684\u5c0f\u4efb\u52d9\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.traeumer.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesige Visionen, aber keine Umsetzung. Wir reduzieren deine Pl\u00e4ne auf 1\uff05, damit die Ausf\u00fchrung unvermeidbar wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Huge visions but no implementation. We reduce your plans to 1\uff05 so that execution becomes unavoidable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes visiones pero ninguna implementaci\u00f3n. Reducimos tus planes al 1\uff05 para que la ejecuci\u00f3n sea inevitable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des visions \u00e9normes mais aucune mise en \u0153uvre. Nous r\u00e9duisons vos projets \u00e0 1\uff05 pour que leur ex\u00e9cution devienne in\u00e9vitable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092a\u0928\u0947 \u092c\u0921\u093c\u0947 \u0932\u0947\u0915\u093f\u0928 \u0915\u094d\u0930\u093f\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u0928\u0939\u0940\u0902. \u0939\u092e \u0906\u092a\u0915\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u094b \u0918\u091f\u093e\u0915\u0930 1\uff05 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u0905\u092a\u0930\u093f\u0939\u093e\u0930\u094d\u092f \u0939\u094b \u091c\u093e\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandi visioni ma nessuna attuazione. Riduciamo i tuoi piani all'1\uff05 in modo che l'esecuzione diventi inevitabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58ee\u5927\u306a\u30d3\u30b8\u30e7\u30f3\u306f\u3042\u308b\u304c\u3001\u5b9f\u884c\u306b\u306f\u81f3\u3063\u3066\u3044\u306a\u3044\u3002\u5b9f\u884c\u304c\u907f\u3051\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u3001\u8a08\u753b\u3092 1\uff05 \u306b\u524a\u6e1b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac70\ub300\ud55c \ube44\uc804\uc774\uc9c0\ub9cc \uad6c\ud604\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \uc2e4\ud589\uc774 \ubd88\uac00\ud53c\ud574\uc9c8 \uc218 \uc788\ub3c4\ub85d \uacc4\ud68d\uc744 1\uff05\ub85c \uc904\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enorme visies maar geen implementatie. Wij brengen uw plannen terug naar 1\uff05 zodat uitvoering onvermijdelijk wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogromne wizje, ale brak realizacji. Obni\u017camy Twoje plany do 1\uff05, aby realizacja sta\u0142a si\u0119 nieunikniona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes vis\u00f5es, mas nenhuma implementa\u00e7\u00e3o. Reduzimos seus planos para 1\uff05 para que a execu\u00e7\u00e3o se torne inevit\u00e1vel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0433\u0440\u043e\u043c\u043d\u044b\u0435 \u0432\u0438\u0434\u0435\u043d\u0438\u044f, \u043d\u043e \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438. \u041c\u044b \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u043c \u0442\u0432\u043e\u0438 \u043f\u043b\u0430\u043d\u044b \u0434\u043e 1\uff05, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u043b\u043e \u043d\u0435\u0438\u0437\u0431\u0435\u0436\u043d\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcy\u00fck vizyonlar var ama uygulama yok. Uygulaman\u0131n ka\u00e7\u0131n\u0131lmaz hale gelmesi i\u00e7in planlar\u0131n\u0131z\u0131 \uff051'e d\u00fc\u015f\u00fcr\u00fcyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5de8\u5927\u7684\u613f\u666f\uff0c\u4f46\u6ca1\u6709\u6267\u884c\u3002\u6211\u4eec\u5c06\u4f60\u7684\u8ba1\u5212\u7f29\u51cf\u52301\uff05\uff0c\u4ee5\u4f7f\u6267\u884c\u4e0d\u53ef\u907f\u514d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9858\u666f\u5b8f\u5049\u4f46\u6c92\u6709\u5be6\u65bd\u3002\u6211\u5011\u5c07\u60a8\u7684\u8a08\u5283\u6e1b\u5c11\u5230 1\uff05\uff0c\u4ee5\u4fbf\u57f7\u884c\u8b8a\u5f97\u4e0d\u53ef\u907f\u514d\u3002"
          }
        }
      }
    },

    "assessment.growth.profile.traeumer.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf, dich in Planung und Theorie zu verlieren. Vermeide die Illusion, dass 'Nachdenken' bereits 'Arbeiten' ist."
          }

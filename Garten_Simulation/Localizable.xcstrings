          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zniknęło – szczerze mówiąc, nie jestem pewien dlaczego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acabou - honestamente, não sei por quê."

    "prog_running_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplette Pause. Der Körper repariert das Gewebe und baut Muskeln auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete break. The body repairs tissue and builds muscle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descanso completo. El cuerpo repara tejidos y desarrolla músculos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause complète. Le corps répare les tissus et développe les muscles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण विराम. शरीर ऊतकों की मरम्मत करता है और मांसपेशियों का निर्माण करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa completa. Il corpo ripara i tessuti e costruisce i muscoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全休憩。体は組織を修復し、筋肉を構築します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전한 휴식. 신체는 조직을 복구하고 근육을 형성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige pauze. Het lichaam repareert weefsel en bouwt spieren op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompletna przerwa. Organizm naprawia tkanki i buduje mięśnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa completa. O corpo repara tecidos e constrói músculos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa completa. O corpo repara tecidos e constrói músculos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный перерыв. Организм восстанавливает ткани и наращивает мышцы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam mola. Vücut dokuyu onarır ve kas oluşturur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彻底休息。身体修复组织并增强肌肉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "徹底休息。身體修復組織並增強肌肉。"
          }
        }
      }
    },

    "trash.negativitaets_feed.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute oder entfolge alle Accounts, die du nach dem Lesen schlechter fühlst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute or unfollow all accounts that make you feel worse after reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia o deja de seguir todas las cuentas que te hacen sentir peor después de leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe le son ou ne suis plus tous les comptes qui te font te sentir moins bien après la lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी खातों को म्यूट या अनफॉलो करें, जिनसे आप पढ़ने के बाद बुरा महसूस करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenzia o smetti di seguire tutti gli account che ti fanno sentire peggio dopo la lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読んだ後に気分が悪くなるアカウントをすべてミュートまたはフォロー解除しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽은 후 기분이 나빠지는 모든 계정을 음소거하거나 팔로우를 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dempen of ontvolg alle accounts waarna je je na het lezen slechter voelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz lub przestań obserwować wszystkich, po których czujesz się gorzej po przeczytaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencie ou deixe de seguir todas as contas que te fazem sentir pior depois de ler."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencie ou deixe de seguir todas as contas que te fazem sentir pior depois de ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите звук или отмените подписку на любые аккаунты, которые заставляют вас чувствовать себя хуже после их прочтения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuduktan sonra kendini daha kötü hissettiren tüm hesapları sessize al veya takipten çık."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音或取消关注任何让您在阅读后感觉更糟的帐户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靜音或取消追蹤任何讓您在閱讀後感覺更糟的帳戶。"
          }
        }
      }
    },
    "trash.negativitaets_feed.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Negatives Nachrichten-Konsumieren erhöht Angstzustände messbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consuming negative news measurably increases anxiety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El consumo de noticias negativas aumenta de forma mensurable la ansiedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La consommation de nouvelles négatives augmente l'anxiété de manière mesurable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नकारात्मक समाचारों का उपभोग मापने योग्य रूप से चिंता बढ़ाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il consumo di notizie negative aumenta misurabilmente l'ansia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネガティブなニュースを消費することで、不安が測定可能なほど増加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부정적인 뉴스를 소비하면 불안이 측정 가능하게 증가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumptie van negatief nieuws verhoogt angststoornissen meetbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsumowanie negatywnych wiadomości mierzalnie zwiększa lęk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O consumo de notícias negativas aumenta visivelmente a ansiedade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O consumo de notícias negativas aumenta visivelmente a ansiedade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребление негативных новостей заметно увеличивает тревогу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olumsuz haber tüketimi kaygıyı ölçülebilir biçimde artırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受负面新闻会显着增加焦虑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受負面新聞會顯著增加焦慮。"
          }
        }
      }
    },
    "trash.negativitaets_feed.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimme 1 feste Zeit für Nachrichten – danach kein Nachrichten-Konsum mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set 1 fixed time for news – then no more news consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece 1 hora fija para las noticias: después, nada más de consumo de noticias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe 1 moment fixe pour les nouvelles – puis plus de consommation de nouvelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेशों के लिए एक निश्चित समय तय करें – इसके बाद कोई संदेश देखना नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisci 1 orario fisso per le notizie – poi niente più consumo di notizie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニュースのための固定時間を1つ決めましょう。その後はニュースを消費しないようにしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뉴스를 위한 고정된 시간 1개를 설정하세요 – 그 후에는 뉴스 소비 없이 지내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal 1 vast tijdstip voor nieuws – daarna geen nieuwsconsumptie meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyznacz 1 stały czas na wiadomości – potem żadnego konsumowania wiadomości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina 1 horário fixo para notícias – depois sem mais consumo de notícias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina 1 horário fixo para notícias – depois sem mais consumo de notícias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите 1 фиксированное время для новостей – после этого потребления новостей больше не будет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haberler için 1 sabit zaman belirle – sonra haber tüketimi yapma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 1 个固定的新闻时间 - 之后，不再消费新闻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 1 個固定的新聞時間 - 之後，不再消費新聞。"
          }
        }
      }
    },
    "trash.negativitaets_feed.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere: Wie hast du dich nach den letzten Nachrichten gefühlt? Und was hat es gebracht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: how did you feel after the last news? And what did it bring you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota: ¿cómo te sentiste después de las últimas noticias? ¿Y qué te aportó?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: comment t'es-tu senti après les dernières nouvelles ? Et qu'est-ce que ça t'a apporté ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखो: पिछली खबरों के बाद तुमने कैसा महसूस किया? और इससे क्या हासिल हुआ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: come ti sei sentito dopo le ultime notizie? E cosa ti ha portato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き留めましょう。最後のニュースの後、どのように感じましたか？そして何をもたらしてくれましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록하세요: 마지막 뉴스 후 어떤 기분이었나요? 그것이 무엇을 가져다 주었나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer: hoe voelde je je na het laatste nieuws? En wat heeft het opgeleverd?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz: jak się czułeś po ostatnich wiadomościach? I co ci to przyniosło?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote: como você se sentiu após as últimas notícias? E o que isso trouxe para você?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote: como você se sentiu após as últimas notícias? E o que isso trouxe para você?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание: Что вы почувствовали после недавних новостей? И чего это дало?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz: son haberlerden sonra nasıl hissettin? Ve bu sana ne getirdi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记：听到最近的消息后您有何感受？它取得了什么成果？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記：聽到最近的消息後您有何感受？它取得了什麼成果？"
          }
        }
      }
    },
    "trash.negativitaets_feed.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Negativer News Feed)**\n1. Unsichtbar machen: Entferne die Auslöser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue Hürden ein (z.B. Apps löschen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausführung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Positives Journaling)**\n1. Offensichtlich machen: Platziere den Auslöser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die Hürden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Negative news feed)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Positive journaling)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina el mal hábito (Feed de noticias negativas)**\n1. Hazlo invisible: Elimina los desencadenantes de tu campo de visión.\n2. Hazlo poco atractivo: Sé consciente de las consecuencias negativas.\n3. Hazlo difícil: Añade obstáculos (p. ej. elimina apps, desconecta el enchufe).\n4. Hazlo insatisfactorio: Vincula la acción a un castigo.\n\n**Establece el buen hábito (Diario positivo)**\n1. Hazlo evidente: Coloca el desencadenante bien visible.\n2. Hazlo atractivo: Asócialo con algo que te guste.\n3. Hazlo fácil: Reduce los obstáculos al mínimo (p. ej. solo 2 minutos).\n4. Hazlo satisfactorio: Recompénsate justo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Se débarrasser de la mauvaise habitude (Fil d'actualités négatif)**\n1. La rendre invisible : Retire les déclencheurs de ton champ de vision.\n2. La rendre peu attirante : Prends conscience des conséquences négatives.\n3. La rendre difficile : Ajoute des obstacles (par ex. supprime des applis, débranche la prise).\n4. La rendre insatisfaisante : Associe l'action à une sanction.\n\n**Mettre en place la bonne habitude (Journal positif)**\n1. La rendre évidente : Place le déclencheur bien en vue.\n2. La rendre attirante : Associe-la à quelque chose que tu aimes.\n3. La rendre facile : Réduis les obstacles au minimum (par ex. seulement 2 minutes).\n4. La rendre satisfaisante : Récompense-toi juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**खराब आदत को समाप्त करना (नकारात्मक न्यूज़ फ़ीड)**\n1. अदृश्य बनाना: ट्रिगर्स को अपनी दृश्य सीमा से हटा दें।\n2. अप्रिय बनाना: नकारात्मक परिणामों के प्रति जागरूक हो जाएँ।\n3. मुश्किल बनाना: बाधाएँ डालें (जैसे ऐप्स हटाना, प्लग निकालना)।\n4. असंतोषजनक बनाना: कार्य को किसी दंड के साथ जोड़ें।\n\n**अच्छी आदत स्थापित करना (सकारात्मक जर्नलिंग)**\n1. स्पष्ट बनाना: ट्रिगर को अच्छी तरह से दिखाई देने वाले स्थान पर रखें।\n2. आकर्षक बनाना: इसे किसी ऐसी चीज़ से जोड़ें जिसे आप पसंद करते हैं।\n3. सरल बनाना: बाधाओं को न्यूनतम पर घटाएँ (जैसे केवल 2 मिनट)।\n4. संतोषजनक बनाना: तुरंत इसके बाद खुद को इनाम दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina la cattiva abitudine (Feed di notizie negative)**\n1. Rendila invisibile: Rimuovi i trigger dal tuo campo visivo.\n2. Rendila poco attraente: Prendi consapevolezza delle conseguenze negative.\n3. Rendila difficile: Aggiungi ostacoli (es. elimina le app, stacca la spina).\n4. Rendila insoddisfacente: Collega l'azione a una punizione.\n\n**Stabilisci la buona abitudine (Diario positivo)**\n1. Rendila evidente: Posiziona il trigger ben visibile.\n2. Rendila attraente: Associala a qualcosa che ti piace.\n3. Rendila facile: Riduci gli ostacoli al minimo (es. solo 2 minuti).\n4. Rendila soddisfacente: Premiati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**悪い習慣を取り除く (ネガティブなニュースフィード)**\n1. 目に見えないようにする: トリガーを視界から取り除きます。\n2. 自分自身を魅力的でなくする: マイナスの結果に注意してください。\n3. 難しくする: ハードルを設定します (例: アプリを削除する、プラグを抜く)。\n4. 満足できないものにする: 処刑にペナルティを付けます。\n\n**良い習慣を確立する (ポジティブ ジャーナリング)**\n1. わかりやすいようにする: トリガーをはっきりと見えるように配置します。\n2. 魅力的にする: 好きなものと関連付けます。\n3. シンプルにする: ハードルを最小限に抑えます (例: わずか 2 分)。\n4. 満足のいくものにする: 終わったらすぐに自分にご褒美をあげましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**나쁜 습관 없애기(부정적인 뉴스피드)**\n1. 보이지 않게 만들기: 시야에서 트리거를 제거합니다.\n2. 자신을 매력적이지 않게 만드세요. 부정적인 결과를 염두에 두세요.\n3. 어렵게 만들기: 장애물을 설정합니다(예: 앱 삭제, 플러그 뽑기).\n4. 불만족스럽게 만들기: 처형에 벌금을 부과합니다.\n\n**좋은 습관 확립(긍정적 일기 쓰기)**\n1. 명확하게 만드십시오: 트리거를 명확하게 보이도록 배치하십시오.\n2. 매력적으로 만드십시오: 당신이 좋아하는 것과 연관시키십시오.\n3. 단순하게 만드세요. 장애물을 최소한으로 줄이세요(예: 단 2분).\n4. 만족스러운 일을 하십시오: 직후에 자신에게 보상하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slechte gewoonte afleren (Negatieve nieuwsfeed)**\n1. Onzichtbaar maken: Verwijder de triggers uit je blikveld.\n2. Onaantrekkelijk maken: Word je bewust van de negatieve gevolgen.\n3. Moeilijk maken: Bouw obstakels in (bijv. apps verwijderen, stekker eruit trekken).\n4. Onbevredigend maken: Koppel de handeling aan een straf.\n\n**Goede gewoonte opbouwen (Positief journaling)**\n1. Duidelijk maken: Plaats de trigger goed zichtbaar.\n2. Aantrekkelijk maken: Koppel het aan iets wat je leuk vindt.\n3. Makkelijk maken: Beperk de obstakels tot een minimum (bijv. slechts 2 minuten).\n4. Bevredigend maken: Beloon jezelf direct daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pozbądź się złego nawyku (negatywne wiadomości)**\n1. Uczyń niewidzialnym: Usuń wyzwalacze z pola widzenia.\n2. Stań się nieatrakcyjny: bądź świadomy negatywnych konsekwencji.\n3. Utrudnij to: ustaw przeszkody (np. usuń aplikacje, odłącz).\n4. Spraw, aby było to niezadowalające: Połącz egzekucję z karą.\n\n**Ustal dobre nawyki (pozytywne pisanie dziennika)**\n1. Spraw, aby było to oczywiste: umieść spust w dobrze widocznym miejscu.\n2. Spraw, aby było atrakcyjne: skojarz to z czymś, co lubisz.\n3. Uprość sprawę: ogranicz przeszkody do minimum (np. tylko 2 minuty).\n4. Spraw, aby było to satysfakcjonujące: natychmiast po tym nagradzaj siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Livra-te do mau hábito (Feed de notícias negativo)**\n1. Torná-lo invisível: Remove os gatilhos do teu campo de visão.\n2. Torná-lo pouco atrativo: Consciencializa-te das consequências negativas.\n3. Torná-lo difícil: Cria obstáculos (por ex. elimina apps, desliga a ficha).\n4. Torná-lo insatisfatório: Associa a ação a uma penalização.\n\n**Estabelece o bom hábito (Diário positivo)**\n1. Torná-lo evidente: Coloca o gatilho bem visível.\n2. Torná-lo atrativo: Associa-o a algo de que gostas.\n3. Torná-lo fácil: Reduz os obstáculos ao mínimo (por ex. apenas 2 minutos).\n4. Torná-lo satisfatório: Recompensa-te logo a seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimine o mau hábito (Feed de notícias negativo)**\n1. Torne-o invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-o pouco atraente: Conscientize-se das consequências negativas.\n3. Torne-o difícil: Crie obstáculos (ex.: exclua apps, desligue a tomada).\n4. Torne-o insatisfatório: Associe a ação a uma punição.\n\n**Estabeleça o bom hábito (Diário positivo)**\n1. Torne-o evidente: Coloque o gatilho bem visível.\n2. Torne-o atraente: Associe-o a algo que você gosta.\n3. Torne-o fácil: Reduza os obstáculos ao mínimo (ex.: apenas 2 minutos).\n4. Torne-o satisfatório: Recompense-se logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Избавьтесь от вредной привычки (лента негативных новостей)**\n1. Сделайте невидимыми: уберите триггеры из поля зрения. \n2. Сделайте себя непривлекательным. Помните о негативных последствиях. \n3. Усложните задачу: установите препятствия (например, удалите приложения, отключите их от сети). \n4. Сделайте его неудовлетворительным: прикрепите исполнение к наказанию. \n\n**Выработайте хорошие привычки (ведение позитивного журнала)**\n1. Сделайте это очевидным: разместите триггер на видном месте. \n2. Сделайте это привлекательным. Свяжите это с чем-то, что вам нравится. \n3. Сделайте это просто: сократите препятствия до минимума (например, всего 2 минуты). \n4. Сделайте это приятным: вознаградите себя сразу после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kötü Bir Alışkanlıktan Kurtulun (Olumsuz Haber Kaynağı)**\n1. Görünmez kılın: Tetikleyicileri görüş alanınızdan kaldırın.\n2. Kendinizi çekici olmaktan çıkarın: Olumsuz sonuçların farkında olun.\n3. Zorlaştırın: Engeller koyun (ör. uygulamaları silin, fişi çekin).\n4. Yetersiz hale getirin: İnfazı cezaya ekleyin.\n\n**İyi alışkanlıklar edinin (Pozitif Günlük Tutma)**\n1. Açıkça belirtin: Tetiği açıkça görülebilecek şekilde yerleştirin.\n2. Çekici hale getirin: Onu sevdiğiniz bir şeyle ilişkilendirin.\n3. Basitleştirin: Engelleri en aza indirin (örneğin sadece 2 dakika).\n4. Tatmin edici hale getirin: Hemen ardından kendinizi ödüllendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉坏习惯（负面新闻）**\n1. 隐形：将触发因素移出视野。\n2. 让自己变得没有吸引力：意识到负面后果。\n3. 让它变得困难：设置障碍（例如删除应用程序、拔掉插头）。\n4. 使其不令人满意：附加刑罚执行。\n\n**建立良好习惯（积极日记）**\n1. 使其显而易见：将触发器放置在清晰可见的位置。\n2. 让它有吸引力：将它与你喜欢的东西联系起来。\n3. 让它变得简单：将障碍减少到最低限度（例如只需 2 分钟）。\n4. 让它令人满意：事后立即奖励自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉壞習慣（負面新聞）**\n1. 隱形：將觸發因素移出視野。\n2. 讓自己變得沒有吸引力：意識到負面後果。\n3. 讓它變得困難：設定障礙（例如刪除應用程式、拔掉插頭）。\n4. 使其不令人滿意：附加刑罰執行。\n\n**建立良好習慣（積極日記）**\n1. 使其顯而易見：將觸發器放置在清晰可見的位置。\n2. 讓它有吸引力：將它與你喜歡的東西連結起來。\n3. 讓它變得簡單：將障礙減少到最低限度（例如只需 2 分鐘）。\n4. 讓它令人滿意：事後立即獎勵自己。"
          }
        }
      }
    },
    "trash.online_shopping_app.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere Online-Shopping, um Geld zu sparen und Impulskäufe zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce online shopping to save money and avoid impulse buys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce las compras en línea para ahorrar dinero y evitar compras compulsivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduis les achats en ligne pour économiser et éviter les achats impulsifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैसे बचाने और आवेग में खरीदारी से बचने के लिए ऑनलाइन शॉपिंग कम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci lo shopping online per risparmiare ed evitare acquisti d'impulso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインショッピングを減らして、お金を節約し、衝動買いを避けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 쇼핑을 줄여 돈을 절약하고 충동 구매를 피하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder online winkelen om geld te besparen en impulsaankopen te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicz zakupy online, aby zaoszczędzić pieniądze i uniknąć impulsywnych zakupów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza as compras online para poupar dinheiro e evitar compras por impulso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza as compras online para poupar dinheiro e evitar compras por impulso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сократите покупки в Интернете, чтобы сэкономить деньги и избежать импульсивных покупок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarruf etmek ve dürtüsel alışverişleri önlemek için çevrimiçi alışverişi azaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少网上购物以节省金钱并避免冲动购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少網上購物以節省金錢並避免衝動購買。"
          }
        }
      }
    },
    "trash.online_shopping_app.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Online Shopping) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Online shopping) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Compras online) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (achats en ligne) vous coûte de l’énergie, du temps et de l’argent à long terme. Cela vous empêche d’atteindre votre plein potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (ऑनलाइन शॉपिंग) आपको लंबे समय में ऊर्जा, समय और पैसा खर्च कराती है। यह आपको अपनी पूरी क्षमता को प्रयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Shopping online) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（オンラインショッピング）は、長期的にはエネルギー、時間、お金を費やします。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(온라인 쇼핑)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (online winkelen) kost je op de lange termijn energie, tijd en geld. Het verhindert dat je je volledige potentieel bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (zakupy online) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Compras online) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (compras online) custa-lhe energia, tempo e dinheiro a longo prazo. Isso o impede de atingir todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (покупки в Интернете) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (çevrimiçi alışveriş) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（网上购物）会消耗你的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長遠來看，這種習慣（網路購物）會消耗你的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

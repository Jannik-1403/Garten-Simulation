        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0909\u0926\u094d\u092f\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u093e \u092e\u0941\u0916\u094d\u092f \u0932\u0915\u094d\u0937\u094d\u092f \u0915\u094d\u092f\u093e \u0939\u0948?"

    "assessment.lifestyle.profile.mitlaeufer.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lache nicht mehr aus Höflichkeit über Witze, die du nicht lustig oder unpassend findest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop laughing out of politeness at jokes that you don't find funny or inappropriate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de reírte por cortesía de chistes que no te parezcan graciosos o inapropiados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez de rire par politesse des blagues que vous ne trouvez pas drôles ou inappropriées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन चुटकुलों पर विनम्रता से हंसना बंद करें जो आपको हास्यास्पद या अनुचित नहीं लगते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetti di ridere per educazione alle battute che non trovi divertenti o inappropriate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面白くも不適切でもないジョークを礼儀として笑うのはやめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재미없거나 부적절하다고 생각하지 않는 농담에 공손하게 웃지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop met lachen uit beleefdheid om grappen die u niet grappig of ongepast vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań śmiać się z grzeczności z dowcipów, które nie wydają ci się zabawne lub niestosowne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare de rir por educação de piadas que você não acha engraçadas ou inapropriadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше не смейся из вежливости над шутками, которые тебе не кажутся смешными или уместными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komik veya uygunsuz bulmadığınız şakalara nezaketen gülmeyi bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要再出于礼貌而对你觉得不有趣或不合适的笑话笑了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於您覺得不好笑或不恰當的笑話，不要出於禮貌而大笑。"
          }
        }
      }
    },
    "assessment.lifestyle.profile.mitlaeufer.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestelle im Restaurant als Erster. Das verhindert, dass du dich den Entscheidungen anderer anpasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be the first to order in the restaurant. This prevents you from conforming to other people's decisions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sé el primero en ordenar en el restaurante. Esto le impide conformarse con las decisiones de otras personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soyez le premier à commander au restaurant. Cela vous empêche de vous conformer aux décisions des autres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेस्तरां में ऑर्डर करने वाले पहले व्यक्ति बनें। यह आपको अन्य लोगों के निर्णयों के अनुरूप चलने से रोकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordina per primo al ristorante. Questo ti impedisce di conformarti alle decisioni degli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レストランで最初に注文してください。これにより、他の人の決定に従うことができなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레스토랑에서 가장 먼저 주문하세요. 이는 당신이 다른 사람의 결정을 따르는 것을 방해합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestel als eerste in het restaurant. Dit weerhoudt je ervan om je te conformeren aan de beslissingen van anderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bądź pierwszą osobą, która złoży zamówienie w restauracji. Uniemożliwia to dostosowywanie się do decyzji innych osób."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja o primeiro a fazer o pedido no restaurante. Isso impede que você se conforme com as decisões de outras pessoas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заказывай первым в ресторане. Это предотвращает то, чтобы ты подстраивался под решения других."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restoranda ilk sipariş veren siz olun. Bu da başkalarının kararlarına uymanızı engeller."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在餐厅里第一个下单。这可以防止你随别人的决定而改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成為餐廳裡第一個點餐的人。這會阻止您遵守其他人的決定。"
          }
        }
      }
    },

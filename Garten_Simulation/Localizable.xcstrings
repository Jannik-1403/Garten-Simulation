    "tour_plant_path_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge deinen Weg! Bleib 90 Tage am Ball, um diese Pflanze vollständig zu meistern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track your path! Keep it up for 90 days to fully master this plant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Sigue tu camino! Manténlo durante 90 días para dominar por completo esta planta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez votre chemin ! Continuez pendant 90 jours pour maîtriser complètement cette plante."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना रास्ता खोजो! इस पौधे में पूरी तरह महारत हासिल करने के लिए 90 दिन लगातार प्रयास करो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia il tuo percorso! Continua per 90 giorni per padroneggiare completamente questa pianta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの道筋をたどってください！この植物を完全にマスターするために90日間続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 길을 추적하세요! 이 식물을 완전히 마스터하려면 90일 동안 계속하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg je pad! Houd dit 90 dagen vol om deze plant volledig onder de knie te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź swoją ścieżkę! Utrzymaj to przez 90 dni, aby w pełni opanować tę roślinę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe seu caminho! Continue por 90 dias para dominar totalmente esta planta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следуй своим путем! Оставайтесь с нами в течение 90 дней, чтобы полностью освоить это растение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolunuzu takip edin! Bu bitkide tamamen ustalaşmak için 90 gün boyunca devam edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遵循你的道路！请继续关注 90 天，以完全掌握这种植物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遵循你的道路！請繼續關注 90 天，以完全掌握這種植物。"
          }
        }
      }
    },

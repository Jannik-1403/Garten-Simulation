    "shop.seeds.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Paket mit 10 magischen Samen. Damit kannst du dir deine eigene, einzigartige Pflanze erschaffen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A packet of 10 magical seeds. Use them to create your own unique plant!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquete de 10 semillas mágicas. ¡Úsalas para crear tu propia planta única!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquet de 10 graines magiques. Utilisez-les pour créer votre propre plante unique !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 जादुई बीजों का एक पैकेज। इसके साथ आप अपनी खुद की, अनोखी पौधा बना सकते हैं!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pacchetto di 10 semi magici. Usali per creare la tua pianta unica!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10個の魔法の種のパケット。これを使って自分だけのユニークな植物を作りましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10개의 마법 씨앗 패킷입니다. 이것으로 자신만의 독특한 식물을 만들어보세요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

    "tour_plant_health_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Apple Health, um den Fortschritt automatisch zu tracken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health to track progress automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Apple Health para seguir el progreso automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Santé Apple pour suivre les progrès automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रगति को स्वचालित रूप से ट्रैक करने के लिए Apple Health कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti Salute Apple per monitorare automaticamente i progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進捗状況を自動的に追跡するには、Appleヘルスケアを接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 상황을 자동으로 추적하려면 Apple 건강을 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind Apple Health om de voortgang automatisch bij te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz Apple Health, aby automatycznie śledzić postępy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte a Saúde Apple para monitorar o progresso automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte a Saúde Apple para monitorar o progresso automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Apple Health для автоматического отслеживания прогресса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi otomatik olarak izlemek için Apple Sağlık'ı bağlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Apple 健康以自动跟踪进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Apple 健康以自動跟踪進度。"
          }
        }
      }
    },

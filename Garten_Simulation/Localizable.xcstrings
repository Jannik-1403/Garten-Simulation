    "support.success.msg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht wurde an jannik.schill.2010@gmail.com gesendet. Wir melden uns bald!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was sent to jannik.schill.2010@gmail.com. We'll get back to you soon!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht wurde an jannik.schill.2010@gmail.com gesendet. Wir melden uns bald!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton message a \u00e9t\u00e9 envoy\u00e9 \u00e0 jannik.schill.2010@gmail.com. Nous te r\u00e9pondrons bient\u00f4t !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0938\u0902\u0926\u0947\u0936 jannik.schill.2010@gmail.com \u092a\u0930 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e \u091c\u0932\u094d\u0926 \u0939\u0940 \u0906\u092a\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0917\u0947!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was sent to jannik.schill.2010@gmail.com. We'll get back to you soon!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e1\u30c3\u30bb\u30fc\u30b8\u306f jannik.schill.2010@gmail.com \u306b\u9001\u4fe1\u3055\u308c\u307e\u3057\u305f\u3002\u3059\u3050\u306b\u3054\u9023\u7d61\u3044\u305f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadc0\ud558\uc758 \uba54\uc2dc\uc9c0\ub294 jannik.schill.2010@gmail.com\uc73c\ub85c \uc804\uc1a1\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uace7 \ub2e4\uc2dc \uc5f0\ub77d\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bericht is verzonden naar jannik.schild.2010@gmail.com. We nemen snel contact met u op!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wiadomo\u015b\u0107 zosta\u0142a wys\u0142ana na adres jannik.schill.2010@gmail.com. Wkr\u00f3tce si\u0119 z Tob\u0105 skontaktujemy!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua mensagem foi enviada para jannik.schill.2010@gmail.com. Responderemos em breve!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0430\u0448\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043d\u0430 jannik.schill.2010@gmail.com. \u041c\u044b \u0441\u0432\u044f\u0436\u0435\u043c\u0441\u044f \u0441 \u0432\u0430\u043c\u0438 \u0441\u043a\u043e\u0440\u043e!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj\u0131n\u0131z jannik.schill.2010@gmail.com adresine g\u00f6nderildi. Yak\u0131nda size geri d\u00f6nece\u011fiz!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u6d88\u606f\u5df2\u53d1\u9001\u81f3 jannik.schill.2010@gmail.com\u3002\u6211\u4eec\u4f1a\u5c3d\u5feb\u8054\u7cfb\u60a8\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u8a0a\u606f\u5df2\u767c\u9001\u81f3 jannik.schill.2010@gmail.com\u3002\u6211\u5011\u6703\u76e1\u5feb\u806f\u7d61\u60a8\uff01"
          }
        }
      }
    },

    "sleep.routine.regularity.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßige Bettgehzeiten verbessern deine Tiefschlafphasen enorm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistent bedtimes vastly improve your deep sleep phases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un horario constante para dormir mejora enormemente las fases de sueño profundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des heures de coucher régulières améliorent considérablement vos phases de sommeil profond."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने का नियमित समय आपकी गहरी नींद के चरणों में काफी सुधार करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orari costanti per andare a letto migliorano enormemente le fasi di sonno profondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時間を一定にすることで、深い睡眠の段階が大幅に改善されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관된 취침 시간은 깊은 수면 단계를 크게 향상시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een consistente bedtijd verbetert je diepe slaapfases enorm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stałe pory kładzenia się spać znacznie poprawiają fazy głębokiego snu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir para a cama em horários consistentes melhora enormemente as fases de sono profundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir para a cama em horários consistentes melhora enormemente as fases de sono profundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянное время отхода ко сну значительно улучшает фазы глубокого сна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli uyku saatleri derin uyku evrelerini büyük ölçüde iyileştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的就寝时间极大地改善了您的深度睡眠阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定的就寢時間極大地改善了您的深度睡眠階段。"
          }
        }
      }
    },

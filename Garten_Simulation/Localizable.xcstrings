    "garden.plant.dead.alert.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Pflanze wurde leider zu lange nicht gegossen und ist eingegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plant unfortunately died due to a lack of water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta murió desafortunadamente por falta de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette plante est malheureusement morte par manque d'eau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुर्भाग्य से, इस पौधे को बहुत लंबे समय तक पानी नहीं दिया गया और यह मर गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfortunatamente, questa pianta non è stata annaffiata per troppo tempo ed è morta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この植物は残念ながら水不足で枯れてしまいました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안타깝게도 이 식물은 물 부족으로 인해 죽었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze plant is helaas gestorven door gebrek aan water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roślina ta niestety uschła z powodu braku wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta infelizmente morreu por falta de água."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta infelizmente morreu por falta de água."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это растение, к сожалению, слишком долго не поливали и оно погибло."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bitki ne yazık ki susuzluktan dolayı öldü."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这株植物很遗憾因为长时间未浇水而枯萎了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不幸的是，這棵植物沒有澆水太久，就死了。"
          }
        }
      }
    },

    "assessment.health.q11": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Zeit verbringst du an einem durchschnittlichen Tag draußen im echten Tageslicht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On an average day, how much time do you spend outside in real daylight?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un día normal, ¿cuánto tiempo pasas afuera bajo luz real?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au cours d’une journée moyenne, combien de temps passez-vous dehors à la lumière du jour ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una giornata media, quanto tempo trascorri all'aperto alla luce del giorno?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは平均して一日にどれくらいの時間を実際の日中に屋外で過ごしますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 일광에서 하루 평균 얼마나 많은 시간을 밖에서 보내십니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel tijd brengt u gemiddeld op een dag buiten door in echt daglicht?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile czasu spędzasz przeciętnie na świeżym powietrzu przy prawdziwym świetle dziennym?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um dia normal, quanto tempo você passa ao ar livre à luz do dia?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama bir günde, gerçek gün ışığında dışarıda ne kadar zaman geçiriyorsunuz?"
          }
        }
      }
    },
    "assessment.health.q11.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als 15 Minuten. Ich bin fast nur drinnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 15 minutes. I'm almost exclusively indoors."

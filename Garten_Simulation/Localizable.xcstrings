    "plant.weltenbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge unendliches Wachstum und strebe nach H\u00f6herem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pursue infinite growth and strive for higher things."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Persigue el crecimiento infinito y aspira a cosas superiores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poursuivez une croissance infinie et visez plus haut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u0902\u0924 \u0935\u0943\u0926\u094d\u0927\u093f \u0915\u093e \u092a\u0940\u091b\u093e \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u091a\u094d\u091a\u0924\u0930 \u0915\u0940 \u0913\u0930 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Persegui una crescita infinita e mira a cose superiori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u9650\u306e\u6210\u9577\u3092\u8ffd\u6c42\u3057\u3001\u3088\u308a\u9ad8\u3044\u76ee\u6a19\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb34\ud55c\ud55c \uc131\uc7a5\uc744 \ucd94\uad6c\ud558\uace0 \ub354 \ub192\uc740 \uac83\uc744 \uc704\ud574 \ub178\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streef naar oneindige groei en mik op hogere doelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u0105\u017c do niesko\u0144czonego wzrostu i si\u0119gaj wy\u017cej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque o crescimento infinito e aspire a coisas maiores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0440\u0435\u043c\u0438\u0441\u044c \u043a \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c\u0443 \u0440\u043e\u0441\u0442\u0443 \u0438 \u0441\u0442\u0440\u0435\u043c\u0438\u0441\u044c \u043a \u0432\u044b\u0441\u0448\u0435\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuz b\u00fcy\u00fcmeyi hedefleyin ve daha y\u00fcksekleri arzulay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ffd\u6c42\u65e0\u9650\u6210\u957f\uff0c\u5fd7\u5b58\u9ad8\u8fdc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ffd\u6c42\u7121\u9650\u6210\u9577\uff0c\u8ffd\u6c42\u66f4\u9ad8\u7684\u4e8b\u7269\u3002"
          }
        }
      }
    },
    "plant.wildgras.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Z\u00e4h, regeneriert sich blitzschnell, bedeckt das Spielfeld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tough, regenerates lightning fast, covers the field"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistente, se regenera rapid\u00edsimo, cubre el campo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coriace, se r\u00e9g\u00e9n\u00e8re \u00e0 la vitesse de l'\u00e9clair, couvre le terrain"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u091c\u092c\u0942\u0924, \u0924\u0940\u0935\u094d\u0930 \u0917\u0924\u093f \u0938\u0947 \u092a\u0941\u0928\u0930\u094d\u091c\u0940\u0935\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948, \u0916\u0947\u0932 \u0915\u0947 \u092e\u0948\u0926\u093e\u0928 \u0915\u094b \u0922\u0915\u0924\u093e \u0939\u0948"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tough, regenerates lightning fast, covers the field"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30d5\u3067\u96fb\u5149\u77f3\u706b\u306e\u901f\u3055\u3067\u56de\u5fa9\u3057\u3001\u30d5\u30a3\u30fc\u30eb\u30c9\u3092\u30ab\u30d0\u30fc\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacac\uace0\ud558\uace0 \ubc88\uac1c\ucc98\ub7fc \ube60\ub974\uac8c \uc7ac\uc0dd\ub418\uba70 \ud544\ub4dc\ub97c \ub36e\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterk, regenereert razendsnel, dekt het veld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytrzyma\u0142y, b\u0142yskawicznie si\u0119 regeneruje, os\u0142ania pole"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistente, regenera-se com velocidade rel\u00e2mpago, cobre o terreno"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0416\u0435\u0441\u0442\u043a\u0438\u0439, \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e, \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0438\u0433\u0440\u043e\u0432\u043e\u0435 \u043f\u043e\u043b\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa\u011flamd\u0131r, y\u0131ld\u0131r\u0131m h\u0131z\u0131nda yenilenir, alan\u0131 kaplar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u575a\u97e7\uff0c\u5feb\u901f\u518d\u751f\uff0c\u8986\u76d6\u6574\u4e2a\u573a\u5730"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5805\u97cc\uff0c\u5feb\u901f\u518d\u751f\uff0c\u8986\u84cb\u6bd4\u8cfd\u5834\u5730"
          }
        }
      }
    },

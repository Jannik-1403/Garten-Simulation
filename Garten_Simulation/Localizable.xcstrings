            "state": "translated",
            "value": "'Uykuya yetişmek' için gece 12 ya da 13'e kadar uyuyorum."
          }
        }
      }
    },
    "assessment.health.q7.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stehe spätestens eine Stunde nach meiner normalen Zeit auf, um meinen Rhythmus nicht zu zerstören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get up at least an hour after my normal time so as not to disrupt my rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me levanto al menos una hora después de mi horario habitual para no alterar mi ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me lève au moins une heure après mon heure habituelle pour ne pas perturber mon rythme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alzo almeno un'ora dopo il mio orario normale per non interrompere il mio ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リズムを崩さないように、いつもの時間より少なくとも1時間は起きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 리듬을 방해하지 않기 위해 평소보다 최소한 한 시간 늦게 일어난다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sta minimaal een uur later op dan mijn normale tijd om mijn ritme niet te verstoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstaję przynajmniej godzinę później niż zwykle, żeby nie zakłócać rytmu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanto-me pelo menos uma hora depois do horário normal para não atrapalhar meu ritmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritimimi bozmamak için normal saatimden en az bir saat geç kalkıyorum."
          }
        }
      }
    },
    "assessment.health.q7.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe extrem wenig, weil ich bis 4 Uhr morgens zocke oder ausgehe."
          }
        },
        "en": {
          "stringUnit": {

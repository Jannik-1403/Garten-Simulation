    "assessment.health.q13" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stehst kurz vor einer wichtigen Prüfung oder einem extrem stressigen Gespräch. Du bist extrem nervös. Wie atmest du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are about to take an important exam or have an extremely stressful conversation. You are extremely nervous. How do you breathe?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a punto de realizar un examen importante o de tener una conversación extremadamente estresante. Estás extremadamente nervioso. ¿Cómo respiras?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sur le point de passer un examen important ou d’avoir une conversation extrêmement stressante. Vous êtes extrêmement nerveux. Comment respirez-vous ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप कोई महत्वपूर्ण परीक्षा देने वाले हैं या बेहद तनावपूर्ण बातचीत करने वाले हैं। आप बेहद घबराए हुए हैं. आप कैसे सांस लेते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai per sostenere un esame importante o hai una conversazione estremamente stressante. Sei estremamente nervoso. Come respiri?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは重要な試験を受けるか、非常にストレスのかかる会話をしようとしています。あなたはとても緊張しています。どうやって呼吸していますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 중요한 시험을 치르거나 극도로 스트레스가 많은 대화를 하려고 합니다. 당신은 매우 긴장되어 있습니다. 어떻게 숨을 쉬나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je staat op het punt een belangrijk examen af ​​te leggen of een extreem stressvol gesprek te voeren. Je bent extreem nerveus. Hoe adem je?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed Tobą ważny egzamin lub wyjątkowo stresująca rozmowa. Jesteś bardzo zdenerwowany. Jak oddychasz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está prestes a fazer um exame importante ou a ter uma conversa extremamente estressante. Você está extremamente nervoso. Como você respira?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты стоишь на пороге важного экзамена или крайне стрессового разговора. Ты крайне нервничаешь. Как ты дышишь?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önemli bir sınava girmek üzeresiniz veya son derece stresli bir konuşma yapmak üzeresiniz. Son derece gerginsin. Nasıl nefes alıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你正面临一场重要的考试或一次极其紧张的谈话。你非常紧张。你如何呼吸？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您即將參加一次重要的考試或進行一次壓力極大的對話。你非常緊張。你如何呼吸？"
          }
        }
      }
    },
    "assessment.health.q13.a" : {

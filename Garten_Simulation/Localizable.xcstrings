    "pfad_schwierigkeit_fortgeschritten_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcr ambitionierte G\u00e4rtner. Eine ausgewogene Mischung aus Herausforderung und Spa\u00df."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For ambitious gardeners. A balanced mix of challenge and fun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jardineros ambiciosos. Una mezcla equilibrada de desaf\u00edo y diversi\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les jardiniers ambitieux. Un m\u00e9lange \u00e9quilibr\u00e9 de d\u00e9fi et de plaisir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0939\u0924\u094d\u0935\u093e\u0915\u093e\u0902\u0915\u094d\u0937\u0940 \u092c\u093e\u0917\u0935\u093e\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f. \u091a\u0941\u0928\u094c\u0924\u0940 \u0914\u0930 \u092e\u0928\u094b\u0930\u0902\u091c\u0928 \u0915\u093e \u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u092e\u093f\u0936\u094d\u0930\u0923\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per giardinieri ambiziosi. Un mix equilibrato di sfida e divertimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91ce\u5fc3\u7684\u306a\u5ead\u5e2b\u5411\u3051\u3002\u6311\u6226\u3068\u697d\u3057\u307f\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u7d44\u307f\u5408\u308f\u305b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc57c\uc2ec\ucc2c \uc815\uc6d0\uc0ac\ub97c \uc704\ud55c \uc81c\ud488\uc785\ub2c8\ub2e4. \ub3c4\uc804\uacfc \uc7ac\ubbf8\uc758 \uade0\ud615 \uc7a1\ud78c \uc870\ud569."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor ambitieuze tuiniers. Een uitgebalanceerde mix van uitdaging en plezier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla ambitnych ogrodnik\u00f3w. Zr\u00f3wnowa\u017cona mieszanka wyzwa\u0144 i zabawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para jardineiros ambiciosos. Uma mistura equilibrada de desafio e divers\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u044b\u0445 \u0441\u0430\u0434\u043e\u0432\u043e\u0434\u043e\u0432. \u0421\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0441\u043c\u0435\u0441\u044c \u0432\u044b\u0437\u043e\u0432\u0430 \u0438 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u0131rsl\u0131 bah\u00e7\u0131vanlar i\u00e7in. M\u00fccadele ve e\u011flencenin dengeli bir kar\u0131\u015f\u0131m\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9002\u5408\u6709\u62b1\u8d1f\u7684\u56ed\u4e01\u3002\u6311\u6218\u4e0e\u4e50\u8da3\u7684\u5747\u8861\u7ed3\u5408\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0d\u65bc\u96c4\u5fc3\u52c3\u52c3\u7684\u5712\u4e01\u4f86\u8aaa\u3002\u6311\u6230\u8207\u6a02\u8da3\u7684\u5e73\u8861\u7d50\u5408\u3002"
          }
        }
      }
    },
    "pfad_schwierigkeit_hinweis": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schwierigkeit beeinflusst die t\u00e4gliche Aufgabenmenge und deinen XP-Gewinn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difficulty level affects your daily task amount and your XP gain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nivel de dificultad afecta la cantidad de tareas diarias y tu ganancia de XP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le niveau de difficult\u00e9 influence la quantit\u00e9 de t\u00e2ches quotidiennes et tes gains de XP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0920\u093f\u0928\u093e\u0908 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0940 \u0926\u0948\u0928\u093f\u0915 \u092e\u093e\u0924\u094d\u0930\u093e \u0914\u0930 \u0906\u092a\u0915\u0947 XP \u0932\u093e\u092d \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il livello di difficolt\u00e0 influisce sul numero di attivit\u00e0 giornaliere e sul guadagno di XP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96e3\u6613\u5ea6\u306f\u3001\u6bce\u65e5\u306e\u30bf\u30b9\u30af\u91cf\u3068\u7372\u5f97 XP \u306b\u5f71\u97ff\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub09c\uc774\ub3c4\ub294 \uc77c\uc77c \uc791\uc5c5\ub7c9\uacfc XP \ud68d\ub4dd\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De moeilijkheidsgraad heeft invloed op uw dagelijkse taakhoeveelheid en uw XP-winst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom trudno\u015bci wp\u0142ywa na liczb\u0119 codziennych zada\u0144 i liczb\u0119 zdobytych PD."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O niveau de dificuldade afeta a quantidade de tarefas di\u00e1rias e o teu ganho de XP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0442\u043e\u0431\u043e\u0439 \u043e\u0447\u043a\u043e\u0432 \u043e\u043f\u044b\u0442\u0430 (XP)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorluk seviyesi g\u00fcnl\u00fck g\u00f6rev miktar\u0131n\u0131z\u0131 ve XP kazanc\u0131n\u0131z\u0131 etkiler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96be\u5ea6\u4f1a\u5f71\u54cd\u6bcf\u65e5\u4efb\u52a1\u91cf\u548c\u4f60\u7684\u7ecf\u9a8c\u503c\u83b7\u53d6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96e3\u5ea6\u6703\u5f71\u97ff\u6bcf\u65e5\u4efb\u52d9\u91cf\u548c\u60a8\u7684 XP \u589e\u76ca\u3002"
          }
        }
      }
    },

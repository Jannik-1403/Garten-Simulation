    "custom.tracker.complete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du dir sicher, dass du fertig bist?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you are done?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfEst\u00e1s seguro de que has terminado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00cates-vous s\u00fbr d'avoir termin\u00e9 ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u0915\u093e\u092e \u092a\u0942\u0930\u093e \u0939\u094b \u0917\u092f\u093e?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di aver finito?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5f53\u306b\u5b8c\u4e86\u3057\u307e\u3057\u305f\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\ub9d0 \uc644\ub8cc\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je klaar bent?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno sko\u0144czy\u0142e\u015b?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que terminou?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u0442\u044b \u0433\u043e\u0442\u043e\u0432?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti\u011fine emin misin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u786e\u5b9a\u4f60\u5df2\u7ecf\u5b8c\u6210\u4e86\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u78ba\u5b9a\u4f60\u5df2\u7d93\u5b8c\u6210\u4e86\u55ce\uff1f"
          }
        }
      }
    },

    "assessment.lifestyle.q2.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leute, die ehrgeiziger, klüger oder fitter sind als ich. Sie zwingen mich zu wachsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People who are more ambitious, smarter or fitter than me. They force me to grow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personas que son más ambiciosas, más inteligentes o más en forma que yo. Me obligan a crecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des gens plus ambitieux, plus intelligents ou plus en forme que moi. Ils me forcent à grandir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो लोग मुझसे ज्यादा महत्वाकांक्षी, होशियार या फिट हैं। वे मुझे बढ़ने के लिए मजबूर करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persone che sono più ambiziose, più intelligenti o più in forma di me. Mi costringono a crescere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私より野心的で、賢くて、健康な人たち。彼らは私に成長を強制します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나보다 더 야심 차고, 더 똑똑하고, 더 건강한 사람들. 그들은 나에게 성장을 강요한다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen die ambitieuzer, slimmer of fitter zijn dan ik. Ze dwingen mij om te groeien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ludzi, którzy są bardziej ambitni, mądrzejsi i sprawniejsi ode mnie. Zmuszają mnie do rozwoju."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas que são mais ambiciosas, mais inteligentes ou mais aptas do que eu. Eles me forçam a crescer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди, которые более амбициозны, умны или спортивны, чем я. Они заставляют меня развиваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benden daha hırslı, daha akıllı veya daha fit olan insanlar. Beni büyümeye zorluyorlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比我更有野心、更聪明或更健康的人。他们迫使我成长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那些比我更有野心、更聰明、更健康的人。他們迫使我成長。"
          }
        }
      }
    },
    "assessment.lifestyle.q3" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gehst an einem normalen Dienstag aus dem Haus (Schule/Arbeit/Stadt). Wie bist du gekleidet?"

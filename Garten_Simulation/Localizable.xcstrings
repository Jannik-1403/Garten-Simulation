    "plant.pilzkolonie.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wächst im Verborgenen, verbindet alles – Networking"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows in hiding, connects everything – Networking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece en secreto, connects todo – Networking"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse en secret, relie tout – Networking"
          }

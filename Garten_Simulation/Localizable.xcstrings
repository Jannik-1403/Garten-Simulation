        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0443\u043f\u0438\u0442\u0435 \u043c\u043e\u043d\u0435\u0442\u044b \u0434\u043b\u044f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430"

    "plant.wildgras.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessere deine Ausdauer und laufe zu neuen Höchstleistungen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve your endurance and run to new peak performances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu resistencia y corre hacia nuevos récords."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez votre endurance et courez vers de nouveaux sommets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सहनशक्ति बढ़ाएँ और नए सर्वश्रेष्ठ प्रदर्शन तक दौड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliora la tua resistenza e corri verso nuove vette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持久力を向上させ、新たな最高記録に向かって走りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구력을 향상시키고 새로운 최고 기록을 향해 달리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbeter je uithoudingsvermogen en ren naar nieuwe hoogtes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw swoją wytrzymałość i biegaj po nowe rekordy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhore sua resistência e corra para novos recordes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhore sua resistência e corra para novos recordes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшай свою выносливость и достигай новых высот в беге."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayanıklılığınızı artırın ve yeni zirvelere koşun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升你的耐力，跑出新高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提高你的耐力並達到新的高度。"
          }
        }
      }
    },
    "plant.zitronenbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauer macht stark – Vitamin C & Immunsystem"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sour makes power – Vitamin C & Immune system"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo ácido da poder – Vitamina C e inmunidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acidité rend fort – Vitamine C & Système immunitaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खट्टा शक्ति बढ़ाता है – विटामिन C और प्रतिरक्षा प्रणाली"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acido ti rende forte: vitamina C e sistema immunitario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酸味は力を生む – ビタミンCと免疫システム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신맛이 힘을 만든다 - 비타민C & 면역체계"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuur maakt kracht – Vitamine C & immuunsysteem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwaśny daje moc – witamina C i układ odpornościowy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O azedo dá força – Vitamina C & Sistema imunitário"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O azedo dá força – Vitamina C & Sistema imunitário"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кислое делает сильным – витамин C и иммунная система"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekşi güç verir – C Vitamini ve Bağışıklık sistemi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酸能强身——维生素C与免疫系统"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "酸使你強壯 – 維生素 C 和免疫系統"
          }
        }
      }
    },

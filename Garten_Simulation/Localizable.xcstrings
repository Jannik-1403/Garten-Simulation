    "cheat_punishment.warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten verliert aktuell jede Stunde 1 Leben. Schalte die Bildschirmzeit in den Einstellungen wieder ein, um das Sterben zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is currently losing 1 life every hour. Turn Screen Time back on in the settings to stop the dying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jardín está perdiendo actualmente 1 vida cada hora. Vuelve a activar el Tiempo de uso en los ajustes para detener la muerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jardin perd actuellement 1 vie toutes les heures. Réactivez le Temps d'écran dans les réglages pour arrêter la mort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बगीचा वर्तमान में हर घंटे 1 जीवन खो रहा है। मरने से रोकने के लिए सेटिंग्स में स्क्रीन टाइम वापस चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo giardino sta attualmente perdendo 1 vita ogni ora. Riattiva il Tempo di utilizzo nelle impostazioni per fermare la morte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、あなたの庭は1時間ごとに1つのライフを失っています。死を止めるには、設定でスクリーンタイムを再びオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 정원은 매시간 1개의 생명을 잃고 있습니다. 죽음을 막으려면 설정에서 스크린 타임을 다시 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tuin verliest momenteel 1 leven per uur. Schakel Schermtijd weer in de instellingen in om het sterven te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ogród traci obecnie 1 życie co godzinę. Włącz ponownie Czas przed ekranem w ustawieniach, aby zatrzymać umieranie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu jardim está perdendo 1 vida a cada hora. Ative o Tempo de Uso novamente nos ajustes para parar a morte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu jardim está perdendo 1 vida a cada hora. Ative o Tempo de Uso novamente nos ajustes para parar a morte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время ваш сад теряет 1 жизнь каждый час. Снова включите Экранное время в настройках, чтобы остановить смерть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçeniz şu anda her saat 1 can kaybediyor. Ölümü durdurmak için ayarlardan Ekran Süresini tekrar açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的花园目前每小时失去 1 个生命。在“设置”中重新打开“屏幕时间”以停止死机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的花園目前每小時失去 1 個生命。在「設定」中重新開啟「螢幕時間」以停止當機。"
          }
        }
      }
    },

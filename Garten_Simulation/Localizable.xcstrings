    "custom.tracker.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher, dass du deinen Tracker l\u00f6schen m\u00f6chtest? Dein Fortschritt geht dabei verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete your tracker? Your progress will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfEst\u00e1s seguro de que quieres eliminar tu rastreador? Tu progreso se perder\u00e1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00cates-vous s\u00fbr de vouloir supprimer votre traqueur ? Votre progression sera perdue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0905\u092a\u0928\u093e \u091f\u094d\u0930\u0948\u0915\u0930 \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902? \u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0928\u0937\u094d\u091f \u0939\u094b \u091c\u093e\u092f\u0947\u0917\u0940."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare il tuo tracker? I tuoi progressi andranno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c8\u30e9\u30c3\u30ab\u30fc\u3092\u524a\u9664\u3057\u3066\u3082\u3088\u308d\u3057\u3044\u3067\u3059\u304b\uff1f\u9032\u6357\u306f\u5931\u308f\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud2b8\ub798\ucee4\ub97c \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c? \uc9c4\ud589 \uc0c1\ud669\uc774 \uc190\uc2e4\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je je tracker wilt verwijderen? Je voortgang gaat verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usun\u0105\u0107 sw\u00f3j tracker? Tw\u00f3j post\u0119p zostanie utracony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir seu rastreador? Seu progresso ser\u00e1 perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u0445\u043e\u0447\u0435\u0448\u044c \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0442\u0440\u0435\u043a\u0435\u0440? \u0422\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0431\u0443\u0434\u0435\u0442 \u0443\u0442\u0435\u0440\u044f\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130zleyicinizi silmek istedi\u011finizden emin misiniz? \u0130lerlemeniz kaybolacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u786e\u5b9a\u8981\u5220\u9664\u4f60\u7684\u8ffd\u8e2a\u5668\u5417\uff1f\u4f60\u7684\u8fdb\u5ea6\u5c06\u4f1a\u4e22\u5931\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u78ba\u5b9a\u8981\u522a\u9664\u60a8\u7684\u8ffd\u8e64\u5668\u55ce\uff1f\u4f60\u7684\u9032\u6b65\u5c07\u6703\u5931\u53bb\u3002"
          }
        }
      }
    },

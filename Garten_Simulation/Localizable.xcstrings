    "prog_wakeup_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genieße die Stille des frühen Sonntagmorgens. Mach dir einen guten Kaffee oder Tee, während der Rest der Welt noch schläft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy the silence of early Sunday morning. Make yourself a good coffee or tea while the rest of the world is still sleeping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfrute del silencio de la madrugada del domingo. Prepárate un buen café o té mientras el resto del mundo sigue durmiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez du silence du dimanche matin. Préparez-vous un bon café ou un bon thé pendant que le reste du monde dort encore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रविवार की सुबह की शांति का आनंद लें। जब बाकी दुनिया अभी भी सो रही हो तो अपने लिए एक अच्छी कॉफी या चाय बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Godetevi il silenzio della domenica mattina presto. Preparati un buon caffè o un tè mentre il resto del mondo sta ancora dormendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日曜日の早朝の静けさをお楽しみください。世界の他の人々がまだ寝ている間に、おいしいコーヒーや紅茶を淹れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일요일 이른 아침의 고요함을 즐겨보세요. 세상 사람들이 아직 자고 있는 동안 맛있는 커피나 차를 만들어 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniet van de stilte van de vroege zondagochtend. Zet een goede koffie of thee voor jezelf terwijl de rest van de wereld nog slaapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciesz się ciszą niedzielnego poranka. Zrób sobie dobrą kawę lub herbatę, gdy reszta świata jeszcze śpi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite o silêncio da manhã de domingo. Prepare um bom café ou chá enquanto o resto do mundo ainda dorme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite o silêncio da manhã de domingo. Prepare um bom café ou chá enquanto o resto do mundo ainda dorme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наслаждайтесь тишиной раннего воскресного утра. Сделайте себе хороший кофе или чай, пока остальной мир еще спит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazar sabahının erken saatlerindeki sessizliğin tadını çıkarın. Dünyanın geri kalanı hala uykudayken kendinize güzel bir kahve veya çay yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "享受周日清晨的宁静。当世界其他地方还在睡觉时，为自己泡一杯好咖啡或茶。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "享受週日清晨的寧靜。當世界其他地方還在睡覺時，為自己泡一杯好咖啡或茶。"
          }
        }
      }
    },

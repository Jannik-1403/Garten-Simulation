    "dailyspin.powerup.subtitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantiert Gr\u00fcn \u2014 kein Unkraut m\u00f6glich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guaranteed Green \u2014 no weeds possible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde garantizado \u2014 sin malas hierbas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert garanti \u2014 mauvaises herbes impossibles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930\u0947 \u0930\u0902\u0917 \u0915\u0940 \u0917\u093e\u0930\u0902\u091f\u0940 - \u0915\u094b\u0908 \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0938\u0902\u092d\u0935 \u0928\u0939\u0940\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde garantito \u2014 niente erbacce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b0\u30ea\u30fc\u30f3\u3092\u4fdd\u8a3c - \u96d1\u8349\u306e\u767a\u751f\u306f\u3042\u308a\u307e\u305b\u3093"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc0c9 \ubcf4\uc7a5 \u2014 \uc7a1\ucd08\uac00 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc74c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegarandeerd groen \u2013 geen onkruid mogelijk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwarancja ekologiczno\u015bci \u2013 brak chwast\u00f3w"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde garantido \u2014 sem ervas daninhas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e \u0437\u0435\u043b\u0451\u043d\u044b\u0439 \u2014 \u0441\u043e\u0440\u043d\u044f\u043a\u043e\u0432 \u0431\u044b\u0442\u044c \u043d\u0435 \u043c\u043e\u0436\u0435\u0442"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garantili Ye\u015fil \u2014 yabani otlara izin verilmez"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u8bc1\u7eff\u8272\u2014\u2014\u4e0d\u53ef\u80fd\u6709\u6742\u8349"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u8b49\u7da0\u8272\uff0d\u6c92\u6709\u96dc\u8349"
          }
        }
      }
    },

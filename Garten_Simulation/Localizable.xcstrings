    "plant.eiche.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wächst langsam, wird über Jahrzehnte massiv und weise"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grows slowly, becomes massive and wise over decades"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece lento, se vuelve masivo y sabio con las décadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse lentement, devient massif et sage au fil des décennies"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धीरे-धीरे बढ़ता है, दशकों में विशाल और बुद्धिमान बनता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grows slowly, becomes massive and wise over decades"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりと成長し、数十年かけて巨大かつ賢くなる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수십 년에 걸쳐 천천히 성장하고 거대해지고 현명해집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groeit langzaam, wordt in de loop van tientallen jaren enorm en wijs"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rośnie powoli, przez dziesięciolecia staje się masywny i mądry"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce devagar, torna-se massivo e sábio ao longo de décadas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растет медленно, становится массивным и мудрым на протяжении десятилетий"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yavaş yavaş büyür, onlarca yıl içinde devasa ve bilge hale gelir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓慢生长，数十年后变得粗壮而智慧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幾十年後慢慢成長，變得龐大又聰明"
          }
        }
      }
    },

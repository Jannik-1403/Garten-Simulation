            "value": "來源：Gloria Mark，加州大學歐文分校 · 每螢幕平均秒數"
          }
        }
      }
    },
    "dopamine_story_s4_sub": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schnitt bleibt dein Blick nur noch 47 Sekunden auf einem Bildschirm. 2004 waren es 150."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On average, your gaze only stays on a screen for 47 seconds. In 2004, it was 150."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En promedio, tu mirada se mantiene en una pantalla por solo 47 segundos. En 2004, eran 150."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, ton regard ne reste sur un écran que pendant 47 secondes. En 2004, c'était 150."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "औसतन, आपकी नज़र एक स्क्रीन पर केवल 47 सेकंड तक टिकी रहती है। 2004 में, यह 150 था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In media, il tuo sguardo rimane su uno schermo solo per 47 secondi. Nel 2004, erano 150."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均して、画面を見つめる時間はわずか47秒です。2004年は150秒でした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평균적으로 화면에 시선이 머무는 시간은 47초에 불과합니다. 2004년에는 150초였습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddeld blijft je blik maar 47 seconden op een scherm. In 2004 was dit 150."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnio twój wzrok pozostaje na ekranie tylko przez 47 sekund. W 2004 roku było to 150."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, o teu olhar permanece num ecrã apenas 47 segundos. Em 2004, eram 150."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, seu olhar permanece em uma tela por apenas 47 segundos. Em 2004, eram 150."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В среднем твой взгляд задерживается на экране всего 47 секунд. В 2004 году это было 150."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama olarak, bakışın bir ekranda sadece 47 saniye kalır. 2004'te bu 150'ydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，你的目光在屏幕上只停留 47 秒。在 2004 年，这个数字是 150。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平均而言，你的目光在螢幕上只停留 47 秒。在 2004 年，這個數字是 150。"
          }
        }
      }
    },
    "dopamine_story_s4_title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fokus\nschrumpft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your focus\nshrinks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu enfoque\nse reduce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta concentration\ndiminue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फोकस\nसिकुड़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo focus\nsi riduce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中力が\n縮小しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중력이\n줄어듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je focus\nkrimpt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój czas skupienia\nkurczy się."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu foco\nencolhe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu foco\nencolhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой фокус\nсокращается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odağın\nküçülüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的注意力\n在萎缩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的注意力\n在萎縮。"
          }
        }
      }
    },

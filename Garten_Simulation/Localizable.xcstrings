    "pfad_gesund_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage lang genug Wasser. Dein K\u00f6rper dankt es dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enough water for 7 days. Your body thanks you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suficiente agua durante 7 d\u00edas. Tu cuerpo te lo agradece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assez d'eau pendant 7 jours. Ton corps te remercie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u092a\u093e\u0928\u0940. \u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0906\u092a\u0915\u094b \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbastanza acqua per 7 giorni. Il tuo corpo ti ringrazia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7\u65e5\u5206\u306e\u6c34\u304c\u8db3\u308a\u308b\u3002\u3042\u306a\u305f\u306e\u4f53\u306f\u3042\u306a\u305f\u306b\u611f\u8b1d\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7\uc77c \ub3d9\uc548 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ucda9\ubd84\ud55c \ubb3c\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \ubab8\uc740 \ub2f9\uc2e0\uc5d0\uac8c \uac10\uc0ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoeg water voor 7 dagen. Je lichaam bedankt je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczaj\u0105ca ilo\u015b\u0107 wody na 7 dni. Twoje cia\u0142o Ci dzi\u0119kuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c1gua suficiente durante 7 dias. O teu corpo agradece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 \u0434\u043d\u0435\u0439 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u043e\u0434\u044b. \u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0441\u043a\u0430\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u0441\u043f\u0430\u0441\u0438\u0431\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 g\u00fcn yetecek kadar su. V\u00fccudunuz size te\u015fekk\u00fcr ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7\u5929\u5145\u8db3\u996e\u6c34\u3002\u4f60\u7684\u8eab\u4f53\u4f1a\u611f\u8c22\u4f60\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8db3\u59207\u5929\u7684\u6c34\u3002\u4f60\u7684\u8eab\u9ad4\u611f\u8b1d\u4f60\u3002"
          }
        }
      }
    },

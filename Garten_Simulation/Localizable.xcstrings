    "dailyspin.no_spins_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deine t\u00e4gliche Gratis-Drehung bereits genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already used your daily free spin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaste tu giro diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as d\u00e9j\u00e0 utilis\u00e9 ton tour gratuit du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0928\u0947 \u0926\u0948\u0928\u093f\u0915 \u092b\u094d\u0930\u0940 \u0938\u094d\u092a\u093f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already used your daily free spin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u306e\u30d5\u30ea\u30fc\u30b9\u30d4\u30f3\u306f\u3059\u3067\u306b\u4f7f\u7528\u6e08\u307f\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadc0\ud558\ub294 \uc774\ubbf8 \uc77c\uc77c \ubb34\ub8cc \uc2a4\ud540\uc744 \uc0ac\uc6a9\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je dagelijkse gratis spin al gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzysta\u0142e\u015b ju\u017c sw\u00f3j dzienny darmowy spin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 usaste a tua rota\u00e7\u00e3o gratuita de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b \u0443\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438 \u0432\u0430\u0448 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0439 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck bedava d\u00f6n\u00fc\u015f\u00fcn\u00fcz\u00fc zaten kulland\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u4f7f\u7528\u4e86\u4eca\u5929\u7684\u514d\u8d39\u65cb\u8f6c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5df2\u7d93\u4f7f\u7528\u4e86\u6bcf\u65e5\u514d\u8cbb\u65cb\u8f49\u3002"
          }
        }
      }
    },

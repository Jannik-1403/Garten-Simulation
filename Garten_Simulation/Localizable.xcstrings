    "paywall.feature.health.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe deine Schritte und Wasserziele direkt mit dem Garten."

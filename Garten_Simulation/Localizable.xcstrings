    "routine.success.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst %lld Minuten lang extrem fokussiert. Die XP werden auf alle deine Pflanzen aufgeteilt!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were extremely focused for %lld minutes. The XP will be split among all your plants!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste extremadamente concentrado durante %lld minutos. ¡La XP se dividirá entre todas tus plantas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été extrêmement concentré pendant %lld minutes. L'XP sera répartie entre toutes vos plantes !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato estremamente concentrato per %lld minuti. L'XP sarà divisa tra tutte le tue piante!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld分間、非常に集中していました。XPはすべての植物に分配されます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분 동안 매우 집중했습니다. XP는 모든 식물에 분배됩니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was extreem gefocust gedurende %lld minuten. De XP wordt verdeeld over al je planten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byłeś niezwykle skupiony przez %lld minut. PD zostaną podzielone między wszystkie twoje rośliny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você esteve extremamente focado por %lld minutos. A XP será dividida entre todas as suas plantas!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakika boyunca son derece odaklandınız. XP tüm bitkileriniz arasında paylaştırılacak!"
          }
        }
      }
    },

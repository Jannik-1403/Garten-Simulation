            "value": "¡%@ te echa de menos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'ennuie de toi !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sente la tua mancanza!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に会いたいです!"
          }
        },
        "ko": {
          "stringUnit": {

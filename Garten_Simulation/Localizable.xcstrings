    "plant.klee.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokussiere dich auf die positiven Dinge im Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on the positive things in life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfócate en las cosas positivas de la vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez-vous sur les choses positives de la vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrati sulle cose positive della vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人生のポジティブな面に焦点を当てましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삶의 긍정적인 면에 집중하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus je op de positieve dingen in het leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skup się na pozytywnych rzeczach w życiu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se nas coisas positivas da vida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayattaki olumlu şeylere odaklanın."
          }
        }
      }
    },
    "plant.korallenbusch.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wächst nur im richtigen Ökosystem – Freundschaften pflegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows only in the right ecosystem – Nurturing friendships"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece solo en el ecosistema correcto – Cultivar amistades"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse seulement dans le bon écosystème – Entretenir les amitiés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows only in the right ecosystem – Nurturing friendships"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適切なエコシステムでのみ成長 – 友情を育む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 생태계에서만 성장합니다 – 우정 키우기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit alleen in het juiste ecosysteem – Het koesteren van vriendschappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rośnie tylko w odpowiednim ekosystemie – Pielęgnując przyjaźnie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce apenas no ecossistema certo – Cultivar amizades"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğru ekosistemde büyür – Dostlukları beslemek"
          }
        }
      }
    },

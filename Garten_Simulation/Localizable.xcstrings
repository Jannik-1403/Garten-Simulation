    "screenTime.info.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Shield-Block zeigt einen Warn-Overlay über Apps. Die betroffenen Apps werden nicht gelöscht und können vom Nutzer weiterhin geöffnet werden (mit Bestätigung). Der Erwachsenen-Filter gilt nur in Safari."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the active block time, you cannot disable the blocker here. If you exceed a daily limit, the 'Too much screen time' habit is automatically bought/checked. If you stick to the limit, your plant is automatically watered at the end of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante el tiempo de bloqueo activo, no puedes desactivar el bloqueador aquí. Si excedes el límite, el mal hábito de pantalla se aplicará automáticamente. Si lo cumples, tu planta será regada al final del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le temps de blocage actif, vous ne pouvez pas désactiver le bloqueur. Si vous dépassez la limite, la mauvaise habitude d'écran s'applique automatiquement. Si vous la respectez, votre plante sera arrosée en fin de journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय ब्लॉक समय के दौरान, आप यहाँ ब्लॉकर को अक्षम नहीं कर सकते हैं। यदि आप सीमा से अधिक हैं, तो स्क्रीन टाइम आदत स्वचालित रूप से खरीदी जाती है। यदि आप सीमा पर टिके रहते हैं, तो आपके पौधे को दिन के अंत में स्वचालित रूप से पानी दिया जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il blocco attivo, non puoi disabilitare il blocco. Se superi il limite, l'abitudine dello schermo viene applicata in automatico. Se lo rispetti, la tua pianta verrà annaffiata a fine giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なブロック時間中は、ここでブロッカーを無効にすることはできません。制限を超えると、スクリーンタイムの悪習慣が自動的に適用されます。制限を守れば、一日の終わりに植物に自動的に水がやられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 차단 시간 동안에는 차단기를 비활성화할 수 없습니다. 한도를 초과하면 스크린타임 습관이 자동으로 적용됩니다. 한도를 지키면 하루가 끝날 때 식물에 자동으로 물을 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens de actieve bloktijd kun je de blokkering niet uitschakelen. Als je de limiet overschrijdt, wordt de schermtijdgewoonte automatisch toegepast. Als je je aan de limiet houdt, krijgt je plant aan het eind van de dag automatisch water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trakcie aktywnego czasu blokady nie możesz jej wyłączyć. Jeśli przekroczysz limit, zły nawyk zostanie automatycznie dodany. Jeśli dotrzymasz limitu, twoja roślina zostanie automatycznie podlana na koniec dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante o tempo de bloqueio ativo, você não pode desativar o bloqueador. Se exceder o limite, o mau hábito da tela é aplicado automaticamente. Se mantiver o limite, a planta será regada ao final do dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante o tempo de bloqueio ativo, você não pode desativar o bloqueador. Se exceder o limite, o mau hábito da tela é aplicado automaticamente. Se mantiver o limite, a planta será regada ao final do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время активной блокировки вы не можете отключить блокировщик. При превышении лимита привычка экранного времени срабатывает автоматически. Если лимит соблюден, растение будет полито в конце дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif engelleme süresince engelleyiciyi devre dışı bırakamazsınız. Sınırı aşarsanız ekran süresi alışkanlığı otomatik olarak uygulanır. Sınıra uyarsanız, bitkiniz gün sonunda otomatik olarak sulanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在活动阻止时间内，您无法禁用拦截器。如果超限，屏幕使用时间习惯会自动应用。如果遵守限制，您的植物将在一天结束时自动浇水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在活動阻止時間內，您無法禁用攔截器。如果超限，螢幕使用時間習慣會自動應用。如果遵守限制，您的植物將在一天結束時自動澆水。"
          }
        }
      }
    },
    "screenTime.info.title": {
      "extractionState": "manual",
      "localizations": {

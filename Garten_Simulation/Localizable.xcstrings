    "assessment.finance.q14" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel Geld gibst du in einer durchschnittlichen Woche unsichtbar für Kaffee to go, kleine Snacks oder Energydrinks aus?"
          }
        },
        "en" : {
          "stringUnit" : {

    "onboarding_fertig_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Garten ist bereit! Viel Erfolg beim Wachsen deiner neuen Gewohnheiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is ready! Good luck growing your new habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Tu jard\u00edn est\u00e1 listo! Buena suerte cultivando tus nuevos h\u00e1bitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton jardin est pr\u00eat ! Bonne chance pour faire grandir tes nouvelles habitudes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u092c\u0917\u0940\u091a\u093e \u0924\u0948\u092f\u093e\u0930 \u0939\u0948! \u0906\u092a\u0915\u0940 \u0928\u0908 \u0906\u0926\u0924\u0947\u0902 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0936\u0941\u092d\u0915\u093e\u092e\u0928\u093e\u090f\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Your garden is ready! Good luck growing your new habits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u306e\u6e96\u5099\u306f\u5b8c\u4e86\u3067\u3059\uff01\u65b0\u3057\u3044\u7fd2\u6163\u3092\u8eab\u306b\u3064\u3051\u3066\u9811\u5f35\u3063\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc815\uc6d0\uc774 \uc900\ube44\ub418\uc5c8\uc2b5\ub2c8\ub2e4! \uc0c8\ub85c\uc6b4 \uc2b5\uad00\uc744 \ud0a4\uc6b0\ub294 \ub370 \ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw tuin is klaar! Veel succes met het ontwikkelen van je nieuwe gewoontes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tw\u00f3j ogr\u00f3d jest gotowy! Powodzenia w rozwijaniu nowych nawyk\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu jardim est\u00e1 pronto! Boa sorte a cultivar os teus novos h\u00e1bitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

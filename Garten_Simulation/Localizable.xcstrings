        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はランニングセッションはありません。 20 分間の短いランニングで 1 日は十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 실행 세션이 없습니다. 하루에 20분 정도의 짧은 달리기이면 충분합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag geen hardloopsessie. Een korte run van 20 minuten is voldoende voor de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiaj nie ma sesji biegowej. Na dzień wystarczy krótki, 20-minutowy bieg."

    "assessment.finance.q7" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast 10.000€ für dein Traumauto gespart, aber dein aktuelles Auto fährt noch einwandfrei. Was machst du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You saved €10,000 for your dream car, but your current car still runs perfectly. What are you doing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahorraste 10.000 € en el coche de tus sueños, pero tu coche actual sigue funcionando perfectamente. ¿Qué estás haciendo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez économisé 10 000 € pour la voiture de vos rêves, mais votre voiture actuelle fonctionne toujours parfaitement. Que fais-tu?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने अपनी सपनों की कार के लिए €10,000 बचाए, लेकिन आपकी वर्तमान कार अभी भी ठीक से चल रही है। आप क्या कर रहे हो?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai risparmiato 10.000 € per l'auto dei tuoi sogni, ma la tua auto attuale funziona ancora perfettamente. Cosa fai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢の車のために 10,000 ユーロを節約しましたが、現在の車はまだ完璧に動作します。何してるの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꿈의 자동차를 구입하기 위해 €10,000를 절약했지만 현재 자동차는 여전히 완벽하게 작동합니다. 뭐하세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U heeft € 10.000 gespaard voor uw droomauto, maar uw huidige auto rijdt nog steeds perfect. Wat ben je aan het doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaoszczędziłeś 10 000 euro na swój wymarzony samochód, ale Twój obecny samochód nadal działa idealnie. Co robisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poupou 10.000€ no carro dos seus sonhos, mas o seu carro atual ainda funciona perfeitamente. O que você está fazendo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты накопил 10.000€ на свою машину мечты, но твоя нынешняя машина всё ещё отлично работает. Что ты будешь делать?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayalinizdeki araba için 10.000€ tasarruf ettiniz ama mevcut arabanız hala mükemmel çalışıyor. Ne yapıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已经为你的梦想汽车存了10,000欧元，但你目前的车仍然运行良好。你会怎么做？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您為您的夢想之車節省了 10,000 歐元，但您目前的汽車仍然運行完美。你在幹什麼？"
          }
        }
      }
    },

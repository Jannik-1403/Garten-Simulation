    "alert.strict_mode.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im strikten Modus (Handy weglegen) bricht der Timer ab, wenn du die App für mehr als 10 Sekunden verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In strict mode (put phone away), the timer will cancel if you leave the app for more than 10 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo estricto, el temporizador se cancelará si sales de la app por más de 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode strict, le minuteur sera annulé si tu quittes l'application plus de 10 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità rigorosa, il timer verrà annullato se lasci l'app per più di 10 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格モードでは、アプリを10秒以上離れるとタイマーがキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격 모드에서는 앱을 10초 이상 종료하면 타이머가 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de strikte modus annuleert de timer als je de app langer dan 10 seconden verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie ścisłym minutnik zostanie anulowany, jeśli opuścisz aplikację na dłużej niż 10 sekund."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo rigoroso, o temporizador será cancelado se saíres da aplicação por mais de 10 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katı modda, uygulamadan 10 saniyeden fazla ayrılırsanız zamanlayıcı iptal olur."
          }
        }
      }
    },
    "alert.strict_mode.no": {
      "comment": "",
      "extractionState": "manual",

    "pfad_lernen_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue deine t\u00e4gliche Lesegewohnheit auf. Ein paar Seiten am Tag helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build your daily reading habit. A few pages a day help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu h\u00e1bito de lectura diario. Unas pocas p\u00e1ginas al d\u00eda ayudan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cr\u00e9e une habitude de lecture quotidienne. Quelques pages par jour aident."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0926\u0948\u0928\u093f\u0915 \u092a\u0922\u093c\u0928\u0947 \u0915\u0940 \u0906\u0926\u0924 \u092c\u0928\u093e\u090f\u0902\u0964 \u0926\u093f\u0928 \u092e\u0947\u0902 \u0915\u0941\u091b \u092a\u0928\u094d\u0928\u0947 \u092e\u0926\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppa la tua abitudine di lettura quotidiana. Poche pagine al giorno aiutano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u306e\u8aad\u66f8\u7fd2\u6163\u3092\u7bc9\u304d\u307e\u3057\u3087\u3046\u3002 1\u65e5\u6570\u30da\u30fc\u30b8\u3067\u3082\u52b9\u679c\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \ub3c5\uc11c \uc2b5\uad00\uc744 \uae30\ub974\uc138\uc694. \ud558\ub8e8\uc5d0 \uba87 \ud398\uc774\uc9c0\uc529 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw uw dagelijkse leesgewoonte op. Een paar pagina's per dag helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj sw\u00f3j codzienny nawyk czytania. Kilka stron dziennie pomaga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Constr\u00f3i o teu h\u00e1bito di\u00e1rio de leitura. Algumas p\u00e1ginas por dia ajudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439 \u0441\u0432\u043e\u044e \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0443\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 \u0447\u0442\u0435\u043d\u0438\u044f. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0432 \u0434\u0435\u043d\u044c \u043f\u043e\u043c\u043e\u0433\u0430\u044e\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcnl\u00fck okuma al\u0131\u015fkanl\u0131\u011f\u0131n\u0131z\u0131 geli\u015ftirin. G\u00fcnde birka\u00e7 sayfa yard\u0131mc\u0131 olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f9\u517b\u4f60\u7684\u65e5\u5e38\u9605\u8bfb\u4e60\u60ef\u3002\u6bcf\u5929\u51e0\u9875\u4f1a\u6709\u5e2e\u52a9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f9\u990a\u4f60\u7684\u65e5\u5e38\u95b1\u8b80\u7fd2\u6163\u3002\u6bcf\u5929\u8b80\u5e7e\u9801\u6709\u5e6b\u52a9\u3002"
          }
        }
      }
    },
    "pfad_lernen_phase_meisterschaft_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebenslanges Lernen. Wissen ist deine Superkraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifelong learning. Knowledge is your superpower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendizaje de por vida. El conocimiento es tu superpoder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprentissage tout au long de la vie. Le savoir est ton superpouvoir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c\u0940\u0935\u0928 \u0938\u0940\u0916\u0928\u093e\u0964 \u091c\u094d\u091e\u093e\u0928 \u0906\u092a\u0915\u0940 \u092e\u0939\u093e\u0936\u0915\u094d\u0924\u093f \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendimento permanente. La conoscenza \u00e8 il tuo superpotere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6daf\u5b66\u7fd2\u3002\u77e5\u8b58\u306f\u3042\u306a\u305f\u306e\u30b9\u30fc\u30d1\u30fc\u30d1\u30ef\u30fc\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3c9\uc0dd \ud559\uc2b5. \uc9c0\uc2dd\uc740 \ub2f9\uc2e0\uc758 \ucd08\ub2a5\ub825\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levenslang leren. Kennis is je superkracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczenie si\u0119 przez ca\u0142e \u017cycie. Wiedza jest Twoj\u0105 supermoc\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendizagem ao longo da vida. O conhecimento \u00e9 o teu superpoder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043d\u0438. \u0417\u043d\u0430\u043d\u0438\u0435 \u2014 \u0442\u0432\u043e\u044f \u0441\u0443\u043f\u0435\u0440\u0441\u0438\u043b\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya\u015fam boyu \u00f6\u011frenme. Bilgi sizin s\u00fcper g\u00fcc\u00fcn\u00fczd\u00fcr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ec8\u8eab\u5b66\u4e60\u3002\u77e5\u8bc6\u662f\u4f60\u7684\u8d85\u80fd\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d42\u8eab\u5b78\u7fd2\u3002\u77e5\u8b58\u662f\u4f60\u7684\u8d85\u80fd\u529b\u3002"
          }
        }
      }
    },
    "pfad_lernen_phase_vertiefung_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissen vernetzen. Du lernst nun komplexe Zusammenh\u00e4nge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network knowledge. You are now learning complex connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta conocimientos. Ahora est\u00e1s aprendiendo conexiones complejas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9seautage des connaissances. Tu apprends maintenant des liens complexes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u094d\u091e\u093e\u0928 \u0915\u094b \u091c\u094b\u0921\u093c\u0947\u0902. \u0905\u092c \u0906\u092a \u091c\u091f\u093f\u0932 \u0938\u0902\u092c\u0902\u0927 \u0938\u0940\u0916 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in rete le conoscenze. Ora stai imparando connessioni complesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u306e\u77e5\u8b58\u3002\u3042\u306a\u305f\u306f\u4eca\u3001\u8907\u96d1\u306a\u63a5\u7d9a\u3092\u5b66\u7fd2\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub124\ud2b8\uc6cc\ud06c \uc9c0\uc2dd. \ub2f9\uc2e0\uc740 \uc774\uc81c \ubcf5\uc7a1\ud55c \uc5f0\uacb0\uc744 \ubc30\uc6b0\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerk kennis. Je leert nu complexe verbindingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajomo\u015b\u0107 sieci. Teraz uczysz si\u0119 z\u0142o\u017conych po\u0142\u0105cze\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta conhecimentos. Est\u00e1s agora a aprender liga\u00e7\u00f5es complexas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0435\u0434\u0438\u043d\u044f\u0439 \u0437\u043d\u0430\u043d\u0438\u044f. \u0422\u0435\u043f\u0435\u0440\u044c \u0442\u044b \u0438\u0437\u0443\u0447\u0430\u0435\u0448\u044c \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u011f bilgisi. Art\u0131k karma\u015f\u0131k ba\u011flant\u0131lar\u0131 \u00f6\u011freniyorsunuz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fde\u63a5\u77e5\u8bc6\u3002\u4f60\u73b0\u5728\u5b66\u4e60\u590d\u6742\u7684\u5173\u8054\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9023\u7d50\u77e5\u8b58\u3002\u4f60\u73fe\u5728\u6b63\u5728\u5b78\u7fd2\u8907\u96dc\u7684\u806f\u7e6b\u3002"
          }
        }
      }
    },

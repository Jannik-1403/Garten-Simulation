    "assessment.fitness.q6.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich analysiere meine Ernährung, erhöhe die Intensität und zwinge den Körper zur Anpassung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I analyze my diet, increase the intensity and force the body to adapt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizo mi dieta, aumento la intensidad y obligo al cuerpo a adaptarse."

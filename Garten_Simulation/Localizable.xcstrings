    },
    "assessment.lifestyle.q4" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast jemandem eine unwichtige Kleinigkeit versprochen (z.B. ein Video zu schicken). Du hast es vergessen und fällst abends totmüde ins Bett. Was tust du?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You promised someone an unimportant little thing (e.g. sending a video). You've forgotten it and fall into bed dead tired in the evening. What are you doing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prometiste a alguien una cosita sin importancia (por ejemplo, enviar un vídeo). Lo has olvidado y por la noche te acuestas muy cansado. ¿Qué estás haciendo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez promis à quelqu'un une petite chose sans importance (par exemple envoyer une vidéo). Vous l'avez oublié et vous vous couchez mort de fatigue le soir. Que fais-tu?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने किसी से एक महत्वहीन छोटी चीज़ का वादा किया था (उदाहरण के लिए एक वीडियो भेजना)। आप इसे भूल गए हैं और शाम को थककर बिस्तर पर सो जाते हैं। आप क्या कर रहे हो?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai promesso a qualcuno una piccola cosa non importante (ad esempio inviare un video). Te ne sei dimenticato e la sera cadi a letto stanco morto. Cosa fai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは誰かに重要でない小さなこと（ビデオを送るなど）を約束しました。あなたはそれを忘れて、夕方になると疲れ果ててベッドに落ちてしまいます。何してるの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가에게 중요하지 않은 작은 일(예: 비디오 보내기)을 약속했습니다. 당신은 그것을 잊어버리고 저녁에 지쳐서 침대에 쓰러졌습니다. 뭐하세요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt iemand een onbelangrijk kleinigheidje beloofd (bijvoorbeeld een video sturen). Je bent het vergeten en valt 's avonds doodmoe in bed. Wat ben je aan het doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiecałeś komuś nieistotną drobnostkę (np. przesłanie filmu). Zapomniałeś o tym i wieczorem kładziesz się do łóżka śmiertelnie zmęczony. Co robisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você prometeu a alguém uma coisinha sem importância (por exemplo, enviar um vídeo). Você esqueceu e cai na cama morto de cansaço à noite. O que você está fazendo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты пообещал кому-то неважную мелочь (например, прислать видео). Ты забыл об этом и вечером падаешь в кровать совершенно уставшим. Что ты делаешь?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birine önemsiz küçük bir şey sözü verdiniz (örneğin video göndermek). Bunu unutuyorsunuz ve akşamları yorgun bir şekilde yatağa düşüyorsunuz. Ne yapıyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你答应了某人一件无关紧要的小事（例如，发送一个视频）。你忘记了，晚上筋疲力尽地倒在床上。你会怎么办？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您向某人承諾了一件不重要的小事（例如發送影片）。你忘了這件事，晚上疲憊不堪地倒在床上。你在幹什麼？"
          }
        }
      }
    },

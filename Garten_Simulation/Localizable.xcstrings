    "assessment.lifestyle.profile.chaot.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst dringend Standards in deinem Leben. Etabliere klare Regeln für Ordnung, Hygiene und deinen täglichen Ablauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[EN] Du brauchst dringend Standards in deinem Leben. Etabliere klare Regeln für Ordnung, Hygiene und deinen täglichen Ablauf."
          }
        },
        "es": {

    "assessment.lifestyle.profile.mitlaeufer.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lache nicht mehr aus H\u00f6flichkeit \u00fcber Witze, die du nicht lustig oder unpassend findest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop laughing out of politeness at jokes that you don't find funny or inappropriate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de re\u00edrte por cortes\u00eda de chistes que no te parezcan graciosos o inapropiados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez de rire par politesse des blagues que vous ne trouvez pas dr\u00f4les ou inappropri\u00e9es."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0928 \u091a\u0941\u091f\u0915\u0941\u0932\u094b\u0902 \u092a\u0930 \u0935\u093f\u0928\u092e\u094d\u0930\u0924\u093e \u0938\u0947 \u0939\u0902\u0938\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u0939\u093e\u0938\u094d\u092f\u093e\u0938\u094d\u092a\u0926 \u092f\u093e \u0905\u0928\u0941\u091a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0932\u0917\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di ridere per educazione alle battute che non trovi divertenti o inappropriate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9762\u767d\u304f\u3082\u4e0d\u9069\u5207\u3067\u3082\u306a\u3044\u30b8\u30e7\u30fc\u30af\u3092\u793c\u5100\u3068\u3057\u3066\u7b11\u3046\u306e\u306f\u3084\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7ac\ubbf8\uc5c6\uac70\ub098 \ubd80\uc801\uc808\ud558\ub2e4\uace0 \uc0dd\uac01\ud558\uc9c0 \uc54a\ub294 \ub18d\ub2f4\uc5d0 \uacf5\uc190\ud558\uac8c \uc6c3\uc9c0 \ub9c8\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met lachen uit beleefdheid om grappen die u niet grappig of ongepast vindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesta\u0144 \u015bmia\u0107 si\u0119 z grzeczno\u015bci z dowcip\u00f3w, kt\u00f3re nie wydaj\u0105 ci si\u0119 zabawne lub niestosowne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare de rir por educa\u00e7\u00e3o de piadas que voc\u00ea n\u00e3o acha engra\u00e7adas ou inapropriadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u043c\u0435\u0439\u0441\u044f \u0438\u0437 \u0432\u0435\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0438 \u043d\u0430\u0434 \u0448\u0443\u0442\u043a\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u0431\u0435 \u043d\u0435 \u043a\u0430\u0436\u0443\u0442\u0441\u044f \u0441\u043c\u0435\u0448\u043d\u044b\u043c\u0438 \u0438\u043b\u0438 \u0443\u043c\u0435\u0441\u0442\u043d\u044b\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komik veya uygunsuz bulmad\u0131\u011f\u0131n\u0131z \u015fakalara nezaketen g\u00fclmeyi b\u0131rak\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u518d\u51fa\u4e8e\u793c\u8c8c\u800c\u5bf9\u4f60\u89c9\u5f97\u4e0d\u6709\u8da3\u6216\u4e0d\u5408\u9002\u7684\u7b11\u8bdd\u7b11\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0d\u65bc\u60a8\u89ba\u5f97\u4e0d\u597d\u7b11\u6216\u4e0d\u6070\u7576\u7684\u7b11\u8a71\uff0c\u4e0d\u8981\u51fa\u65bc\u79ae\u8c8c\u800c\u5927\u7b11\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.profile.mitlaeufer.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestelle im Restaurant als Erster. Das verhindert, dass du dich den Entscheidungen anderer anpasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to order in the restaurant. This prevents you from conforming to other people's decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9 el primero en ordenar en el restaurante. Esto le impide conformarse con las decisiones de otras personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez le premier \u00e0 commander au restaurant. Cela vous emp\u00eache de vous conformer aux d\u00e9cisions des autres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u0947\u0938\u094d\u0924\u0930\u093e\u0902 \u092e\u0947\u0902 \u0911\u0930\u094d\u0921\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u0939\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092c\u0928\u0947\u0902\u0964 \u092f\u0939 \u0906\u092a\u0915\u094b \u0905\u0928\u094d\u092f \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0928\u093f\u0930\u094d\u0923\u092f\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u091a\u0932\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina per primo al ristorante. Questo ti impedisce di conformarti alle decisioni degli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ec\u30b9\u30c8\u30e9\u30f3\u3067\u6700\u521d\u306b\u6ce8\u6587\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u4ed6\u306e\u4eba\u306e\u6c7a\u5b9a\u306b\u5f93\u3046\u3053\u3068\u304c\u3067\u304d\u306a\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub808\uc2a4\ud1a0\ub791\uc5d0\uc11c \uac00\uc7a5 \uba3c\uc800 \uc8fc\ubb38\ud558\uc138\uc694. \uc774\ub294 \ub2f9\uc2e0\uc774 \ub2e4\ub978 \uc0ac\ub78c\uc758 \uacb0\uc815\uc744 \ub530\ub974\ub294 \uac83\uc744 \ubc29\ud574\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestel als eerste in het restaurant. Dit weerhoudt je ervan om je te conformeren aan de beslissingen van anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0105d\u017a pierwsz\u0105 osob\u0105, kt\u00f3ra z\u0142o\u017cy zam\u00f3wienie w restauracji. Uniemo\u017cliwia to dostosowywanie si\u0119 do decyzji innych os\u00f3b."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja o primeiro a fazer o pedido no restaurante. Isso impede que voc\u00ea se conforme com as decis\u00f5es de outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u0439 \u043f\u0435\u0440\u0432\u044b\u043c \u0432 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0435. \u042d\u0442\u043e \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0442\u043e, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u0441\u044f \u043f\u043e\u0434 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoranda ilk sipari\u015f veren siz olun. Bu da ba\u015fkalar\u0131n\u0131n kararlar\u0131na uyman\u0131z\u0131 engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9910\u5385\u91cc\u7b2c\u4e00\u4e2a\u4e0b\u5355\u3002\u8fd9\u53ef\u4ee5\u9632\u6b62\u4f60\u968f\u522b\u4eba\u7684\u51b3\u5b9a\u800c\u6539\u53d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6210\u70ba\u9910\u5ef3\u88e1\u7b2c\u4e00\u500b\u9ede\u9910\u7684\u4eba\u3002\u9019\u6703\u963b\u6b62\u60a8\u9075\u5b88\u5176\u4ed6\u4eba\u7684\u6c7a\u5b9a\u3002"
          }
        }
      }
    },

    "insufficient_data": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genügend Daten. Trag dein Gewicht weiter täglich ein – in etwa %1$@ Tagen kannst du einen verlässlichen Trend sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data yet. Keep logging your weight daily — check back in about %1$@ days for a reliable trend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes datos. Sigue registrando tu peso a diario; en unos %1$@ días tendrás una tendencia fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de données. Continue à enregistrer ton poids chaque jour — reviens dans environ %1$@ jours pour une tendance fiable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पर्याप्त डेटा नहीं है। रोज़ अपना वज़न दर्ज करते रहें — लगभग %1$@ दिनों में आपको एक भरोसेमंद ट्रेंड दिखेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza dati. Continua a registrare il tuo peso ogni giorno — tra circa %1$@ giorni avrai una tendenza affidabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだデータが十分ではありません。毎日体重を記録し続けてください。あと約%1$@日で信頼できるトレンドが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 데이터가 충분하지 않습니다. 매일 체중을 계속 기록해 주세요 — 약 %1$@일 후면 신뢰할 수 있는 추세를 확인할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet genoeg gegevens. Blijf je gewicht dagelijks bijhouden — over ongeveer %1$@ dagen zie je een betrouwbare trend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych. Zapisuj swoją wagę codziennie — za około %1$@ dni zobaczysz wiarygodny trend."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes. Continue registrando seu peso todos os dias — em cerca de %1$@ dias você terá uma tendência confiável."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes. Continue registrando seu peso todos os dias — em cerca de %1$@ dias você terá uma tendência confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока недостаточно данных. Продолжайте ежедневно записывать вес — примерно через %1$@ дн. появится надёжный тренд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yeterli veri yok. Kilonu her gün kaydetmeye devam et — yaklaşık %1$@ gün sonra güvenilir bir eğilim göreceksin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据还不够。请继续每天记录体重——大约 %1$@ 天后即可看到可靠的趋势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料還不夠。請持續每天記錄體重——大約 %1$@ 天後即可看到可靠的趨勢。"
          }
        }
      }
    },

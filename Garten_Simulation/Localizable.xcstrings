        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u751f\u6d3b\u306f\u3069\u308c\u304f\u3089\u3044\u30d0\u30e9\u30f3\u30b9\u304c\u53d6\u308c\u3066\u3044\u307e\u3059\u304b\uff1f"

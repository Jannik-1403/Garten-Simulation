        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cafeína após as 14h – defina um alarme fixo como lembrete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cafeína após as 14h – defina um alarme fixo como lembrete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакого кофеина после 14:00 – установите жесткий будильник в качестве напоминания."
          }
        },

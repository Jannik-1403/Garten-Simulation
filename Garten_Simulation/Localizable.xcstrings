    "prog_teeth_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze einen Zungenkratzer (oder zur Not den Löffel), um Bakterienbelag am Morgen vor dem ersten Glas Wasser zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a tongue scraper (or spoon if necessary) to remove bacterial plaque before your first glass of water in the morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice un raspador de lengua (o una cuchara si es necesario) para eliminar la placa bacteriana antes del primer vaso de agua de la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un gratte-langue (ou une cuillère si nécessaire) pour éliminer la plaque bactérienne avant votre premier verre d'eau le matin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह अपने पहले गिलास पानी से पहले बैक्टीरिया की पट्टिका को हटाने के लिए जीभ खुरचनी (या यदि आवश्यक हो तो चम्मच) का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un raschietto per la lingua (o un cucchiaio se necessario) per rimuovere la placca batterica prima del primo bicchiere d'acqua al mattino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝最初のコップ一杯の水を飲む前に、舌スクレーパー（または必要に応じてスプーン）を使用して細菌の歯垢を取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 물을 마시기 전에 혀 스크래퍼(또는 필요한 경우 숟가락)를 사용하여 세균성 플라크를 제거하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een tongschraper (of indien nodig een lepel) om bacteriële tandplak te verwijderen vóór uw eerste glas water in de ochtend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj skrobaczki do języka (lub łyżki, jeśli to konieczne), aby usunąć płytkę bakteryjną przed pierwszą poranną szklanką wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um raspador de língua (ou colher, se necessário) para remover a placa bacteriana antes do primeiro copo de água pela manhã."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um raspador de língua (ou colher, se necessário) para remover a placa bacteriana antes do primeiro copo de água pela manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте скребок для языка (или ложку, если необходимо), чтобы удалить бактериальный налет перед первым стаканом воды утром."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah ilk bardak suyunuzu içmeden önce bakteri plağını çıkarmak için bir dil kazıyıcı (veya gerekiyorsa kaşık) kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早上喝第一杯水之前，使用刮舌器（或必要时使用勺子）去除菌斑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早上喝第一杯水之前，使用刮舌器（或必要時使用湯匙）去除菌斑。"
          }
        }
      }
    },

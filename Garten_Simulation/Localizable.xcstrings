    "level_up.custom_text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ schon lange gemeistert. Es wird immer einfacher für dich, die Gewohnheit beizubehalten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have mastered %@ for a long time. It gets easier and easier to maintain the habit!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has dominado %@ durante mucho tiempo. ¡Cada vez es más fácil mantener el hábito!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu maîtrises %@ depuis longtemps. Il est de plus en plus facile de maintenir l'habitude !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने %@ में लंबे समय से महारत हासिल कर ली है। इस आदत को बनाए रखना और भी आसान हो जाता है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai padroneggiato %@ da molto tempo. Diventa sempre più facile mantenere l'abitudine!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは %@ を長い間マスターしてきました。習慣を維持するのはどんどん簡単になります！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

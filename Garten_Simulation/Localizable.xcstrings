    "prog_teeth_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir putzen oft zu hart. Achte heute darauf, die Zahnbürste nur sehr leicht aufzudrücken, um den Schmelz und das Zahnfleisch zu schonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We often brush too hard. Today, make sure to only press on the toothbrush very lightly to protect the enamel and gums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A menudo nos cepillamos demasiado fuerte. Hoy, asegúrate de presionar muy ligeramente el cepillo de dientes para proteger el esmalte y las encías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On se brosse souvent trop fort. Aujourd’hui, veillez à n’appuyer que très légèrement sur la brosse à dents pour protéger l’émail et les gencives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम अक्सर बहुत जोर से ब्रश करते हैं। आज, सुनिश्चित करें कि इनेमल और मसूड़ों की सुरक्षा के लिए टूथब्रश को केवल हल्के से दबाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesso ci laviamo troppo forte. Oggi, assicurati di premere solo molto leggermente sullo spazzolino per proteggere lo smalto e le gengive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私たちはブラッシングを強くしすぎることがよくあります。エナメル質と歯茎を保護するために、今日は歯ブラシを軽く押すだけにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리는 종종 너무 세게 닦습니다. 오늘은 법랑질과 잇몸을 보호하기 위해 칫솔을 아주 가볍게만 누르도록 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wij poetsen vaak te hard. Zorg ervoor dat u vandaag slechts heel licht op de tandenborstel drukt om het glazuur en het tandvlees te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Często szczotkujemy zbyt mocno. Dzisiaj pamiętaj, aby delikatnie naciskać szczoteczkę do zębów, aby chronić szkliwo i dziąsła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas vezes escovamos com muita força. Hoje, certifique-se de pressionar levemente a escova de dentes para proteger o esmalte e as gengivas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas vezes escovamos com muita força. Hoje, certifique-se de pressionar levemente a escova de dentes para proteger o esmalte e as gengivas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы часто чистим зубы слишком сильно. Сегодня старайтесь нажимать на зубную щетку очень легко, чтобы защитить эмаль и десны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu zaman çok sert fırçalıyoruz. Bugün diş minesini ve diş etlerini korumak için diş fırçasına yalnızca çok hafif bastırdığınızdan emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们经常刷得太用力。今天，请确保仅轻轻按压牙刷，以保护牙釉质和牙龈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們常常刷得太用力。今天，請確保僅輕輕按壓牙刷，以保護琺瑯質和牙齦。"
          }
        }
      }
    },

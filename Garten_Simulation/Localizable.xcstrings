        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo come\u00e7o! Continua a aumentar o teu streak de %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u043e\u0432\u044b\u0439 \u0441\u0442\u0430\u0440\u0442! \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u0441\u0435\u0440\u0438\u044e \u043d\u0430%d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir ba\u015flang\u0131\u00e7! %d serisini olu\u015fturmaya devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u7684\u5f00\u59cb\uff01\u7ee7\u7eed\u4f60\u7684 %d \u8fde\u51fb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u7684\u958b\u59cb\uff01\u7e7c\u7e8c\u5f9e%d\u958b\u59cb\u5efa\u7acb\u60a8\u7684\u9023\u52dd\u8a18\u9304\u3002"

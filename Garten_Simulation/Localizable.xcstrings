    "focus_session.step1.desc.new": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dein Handy jetzt auf 'Nicht st\u00f6ren' und lege es nach dieser Einrichtung au\u00dfer Sichtweite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phone on 'Do Not Disturb' and place it out of sight after this setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu tel\u00e9fono en 'No molestar' y col\u00f3calo fuera de la vista despu\u00e9s de esta configuraci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez votre t\u00e9l\u00e9phone sur 'Ne pas d\u00e9ranger' et placez-le hors de vue apr\u00e8s cette configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092c \u0905\u092a\u0928\u0947 \u092b\u094b\u0928 \u0915\u094b '\u092a\u0930\u0947\u0936\u093e\u0928 \u0928 \u0915\u0930\u0947\u0902' \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0938 \u0938\u0947\u091f\u0905\u092a \u0915\u0947 \u092c\u093e\u0926 \u0907\u0938\u0947 \u0926\u0943\u0937\u094d\u091f\u093f \u0938\u0947 \u0926\u0942\u0930 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il telefono in 'Non disturbare' e mettilo fuori dalla vista dopo questa configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u8a2d\u5b9a\u5f8c\u306f\u3001\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3092\u300c\u304a\u3084\u3059\u307f\u30e2\u30fc\u30c9\u300d\u306b\u3057\u3066\u898b\u3048\u306a\u3044\u5834\u6240\u306b\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc124\uc815 \ud6c4\uc5d0\ub294 \ud734\ub300\ud3f0\uc744 '\ubc29\ud574 \uae08\uc9c0 \ubaa8\ub4dc'\ub85c \uc124\uc815\ud558\uace0 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uacf3\uc5d0 \ub450\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je telefoon op 'Niet storeen' en leg hem na deze installatie uit het zicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tej konfiguracji prze\u0142\u0105cz telefon w tryb \u201eNie przeszkadza\u0107\u201d i od\u0142\u00f3\u017c go z pola widzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o seu telefone em 'N\u00e3o incomodar' e coloque-o fora de vista ap\u00f3s esta configura\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043f\u0435\u0440\u044c \u0432\u043a\u043b\u044e\u0447\u0438 \u043d\u0430 \u0441\u0432\u043e\u0451\u043c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u0440\u0435\u0436\u0438\u043c \u00ab\u041d\u0435 \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u044c\u00bb \u0438 \u0443\u0431\u0435\u0440\u0438 \u0435\u0433\u043e \u0438\u0437 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumdan sonra telefonunuzu 'Rahats\u0131z Etmeyin' moduna al\u0131n ve g\u00f6zden uzak bir yere koyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

    "item.goldener_schluessel.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und öffnet die Tür zu raschem Wachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and opens the door to rapid growth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tome medidas inmediatas y abra la puerta a un crecimiento rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active immédiatement et ouvre la porte à une croissance rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तत्काल कार्रवाई करें और तेजी से विकास का द्वार खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agisci immediatamente e apri la porta a una rapida crescita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "即戦力となり、急成長への扉が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 활성화되어 급속한 성장의 문을 열어줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en opent de deur naar snelle groei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje się aktywny natychmiast i otwiera drzwi do szybkiego wzrostu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e abre a porta para o crescimento rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e abre a porta para o crescimento rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу активируется и открывает дверь к быстрому росту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve hızlı büyümeye kapı açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，开启快速成长之门。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即採取行動，打開快速增長之門。"
          }
        }
      }
    },
    "item.herz_auffueller.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt ein Leben auf. Ideal, um wieder auf maximale Lebenspunkte zu kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores one life. Ideal to get back to maximum health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura una vida. Ideal para volver a la salud máxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure une vie. Idéal pour retrouver la santé maximale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जीवन पुनः भर देता है. अधिकतम स्वास्थ्य बिंदुओं पर वापस जाने के लिए आदर्श।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina una vita. Ideale per tornare alla salute massima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライフを1つ回復します。最大限の健康状態を取り戻すのに最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 생명을 회복합니다. 최대 건강으로 돌아가는 데 이상적입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt één leven. Ideaal om weer maximale gezondheid te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca jedno życie. Idealny, aby wrócić do maksymalnego zdrowia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura uma vida. Ideal para voltar à saúde máxima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura uma vida. Ideal para voltar à saúde máxima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает жизнь. Идеально, чтобы вновь достичь максимального количества очков жизни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hayatı geri yükler. Maksimum sağlığa geri dönmek için idealdir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补充一个生命。非常适合恢复到最大生命值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "補充一個生命。恢復最大生命值的理想選擇。"
          }
        }
      }
    },

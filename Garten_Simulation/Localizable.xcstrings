    "focus.phone_prompt.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle danach die Apps aus, die für diesen Fokus blockiert werden sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Afterwards, select the apps that should be blocked for this focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, selecciona las aplicaciones que deben bloquearse para este enfoque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, sélectionnez les applications qui doivent être bloquées pour cette session de concentration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद उन ऐप्स को चुनें जिन्हें इस फोकस के लिए ब्लॉक किया जाना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Successivamente, seleziona le app che dovrebbero essere bloccate per questa concentrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、この集中のためにブロックするアプリを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 이 집중에 대해 차단해야 하는 앱을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer daarna de apps die voor deze focus geblokkeerd moeten worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie wybierz aplikacje, które powinny zostać zablokowane na czas tego skupienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, selecione os aplicativos que devem ser bloqueados para este foco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, selecione os aplicativos que devem ser bloqueados para este foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите затем приложения, которые должны быть заблокированы для этого фокуса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından, bu odak için engellenmesi gereken uygulamaları seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后选择要为此焦点阻止的应用程序。"

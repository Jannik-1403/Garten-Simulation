    "trash.endlos_scroll_tv.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege die Fernbedienung in eine Schublade \u2013 nicht griffbereit auf dem Sofa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the remote control in a drawer \u2013 not within easy reach on the sofa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el mando a distancia en un caj\u00f3n, no al alcance de la mano en el sof\u00e1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range la t\u00e9l\u00e9commande dans un tiroir \u2013 pas \u00e0 port\u00e9e de main sur le canap\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u092e\u094b\u091f \u0915\u094b \u0921\u094d\u0930\u093e \u092e\u0947\u0902 \u0930\u0916\u094b \u2013 \u0938\u094b\u092b\u093c\u0947 \u092a\u0930 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u092a\u0939\u0941\u0901\u091a \u092e\u0947\u0902 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il telecomando in un cassetto \u2013 non a portata di mano sul divano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30e2\u30b3\u30f3\u3092\u5f15\u304d\u51fa\u3057\u306b\u5165\u308c\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002\u30bd\u30d5\u30a1\u306e\u624b\u306e\u5c4a\u304f\u3068\u3053\u308d\u306b\u306f\u7f6e\u304b\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9ac\ubaa8\ucee8\uc744 \uc11c\ub78d\uc5d0 \ub123\uc5b4\ub450\uc138\uc694 \u2013 \uc18c\ud30c\uc5d0\uc11c \uc27d\uac8c \ub2ff\uc744 \uc218 \uc788\ub294 \uacf3\uc5d0 \ub450\uc9c0 \ub9c8\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg de afstandsbediening in een la \u2013 niet binnen handbereik op de bank."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142\u00f3\u017c pilota do szuflady \u2013 nie w zasi\u0119gu r\u0119ki na kanapie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o controle remoto em uma gaveta \u2013 n\u00e3o ao alcance f\u00e1cil no sof\u00e1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u043f\u0443\u043b\u044c\u0442 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0432 \u0434\u0430\u043b\u044c\u043d\u0438\u0439 \u044f\u0449\u0438\u043a \u0434\u0438\u0432\u0430\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan kumanday\u0131 bir \u00e7ekmeceye koy \u2013 koltukta kolayca ula\u015f\u0131labilir bir yerde de\u011fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u9065\u63a7\u5668\u653e\u5728\u62bd\u5c49\u91cc\uff0c\u653e\u5728\u6c99\u53d1\u4e0a\u591f\u4e0d\u5230\u7684\u5730\u65b9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u9059\u63a7\u5668\u653e\u5728\u62bd\u5c5c\u88e1\uff0c\u653e\u5728\u6c99\u767c\u4e0a\u6406\u4e0d\u5230\u7684\u5730\u65b9\u3002"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle bewusst: Frage dich vor dem Einschalten, ob es sich lohnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll consciously: ask yourself before turning it on if it's worth it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despl\u00e1zate conscientemente: preg\u00fantate antes de encenderlo si vale la pena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais d\u00e9filer consciemment : demande-toi avant d'allumer si \u00e7a vaut la peine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u091c\u0917 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0947\u0902: \u091a\u093e\u0932\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0947 \u092a\u0942\u091b\u0947\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u092f\u0939 \u0907\u0938\u0915\u0947 \u0932\u093e\u092f\u0915 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri consapevolmente: chiediti prima di accenderlo se ne vale la pena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u610f\u8b58\u7684\u306b\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u307e\u3057\u3087\u3046\u3002\u96fb\u6e90\u3092\u5165\u308c\u308b\u524d\u306b\u3001\u305d\u308c\u3060\u3051\u306e\u4fa1\u5024\u304c\u3042\u308b\u304b\u3069\u3046\u304b\u81ea\u554f\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc758\uc2dd\uc801\uc73c\ub85c \uc2a4\ud06c\ub864\ud558\uc138\uc694: \ucf1c\uae30 \uc804\uc5d0 \uadf8\ub7f4 \uac00\uce58\uac00 \uc788\ub294\uc9c0 \uc790\ubb38\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll bewust: vraag jezelf af of het de moeite waard is voordat je het aanzet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przewijaj \u015bwiadomie: zapytaj siebie przed w\u0142\u0105czeniem, czy to si\u0119 op\u0142aca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Role conscientemente: pergunte-se antes de ligar se vale a pena."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u043b\u0438\u0441\u0442\u044b\u0432\u0430\u0439\u0442\u0435 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e: \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f, \u0441\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u0441\u0435\u0431\u044f, \u0441\u0442\u043e\u0438\u0442 \u043b\u0438 \u043e\u043d\u043e \u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilin\u00e7li kayd\u0131r: a\u00e7madan \u00f6nce buna de\u011fip de\u011fmedi\u011fini kendinize sorun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u610f\u8bc6\u5730\u6eda\u52a8\uff1a\u5728\u6253\u5f00\u4e4b\u524d\uff0c\u95ee\u95ee\u81ea\u5df1\u8fd9\u662f\u5426\u503c\u5f97\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u610f\u8b58\u5730\u6efe\u52d5\uff1a\u5728\u6253\u958b\u4e4b\u524d\uff0c\u554f\u554f\u81ea\u5df1\u9019\u662f\u5426\u503c\u5f97\u3002"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze einen Timer: Stelle eine Stunde ein \u2013 danach automatisch ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a timer: set one hour \u2013 then automatically turn off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un temporizador: pon una hora y luego apaga autom\u00e1ticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un minuteur : r\u00e8gle une heure \u2013 puis \u00e9teins automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u091f\u093e\u0907\u092e\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902: \u090f\u0915 \u0918\u0902\u091f\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u091f \u0915\u0930\u0947\u0902 \u2013 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0905\u092a\u0928\u0947 \u0906\u092a \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un timer: imposta un'ora \u2013 poi spegni automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30a4\u30de\u30fc\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\u30021\u6642\u9593\u306b\u8a2d\u5b9a\u3057\u3066\u3001\u305d\u306e\u5f8c\u306f\u81ea\u52d5\u7684\u306b\u30aa\u30d5\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0c0\uc774\uba38\ub97c \uc0ac\uc6a9\ud558\uc138\uc694: 1\uc2dc\uac04\uc744 \uc124\uc815\ud558\uace0 \u2013 \uadf8 \ud6c4 \uc790\ub3d9\uc73c\ub85c \uaebc\uc9c0\uac8c \ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een timer: stel een uur in \u2013 daarna automatisch uitschakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj timera: ustaw godzin\u0119 \u2013 potem automatycznie wy\u0142\u0105cz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um temporizador: defina uma hora \u2013 depois desligue automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0442\u0430\u0439\u043c\u0435\u0440: \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0447\u0430\u0441 \u2013 \u0437\u0430\u0442\u0435\u043c \u0432\u044b\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlay\u0131c\u0131 kullan: bir saat ayarla \u2013 sonra otomatik olarak kapat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u5b9a\u65f6\u5668\uff1a\u8bbe\u7f6e\u4e00\u4e2a\u5c0f\u65f6 - \u7136\u540e\u81ea\u52a8\u5173\u95ed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u5b9a\u6642\u5668\uff1a\u8a2d\u5b9a\u4e00\u500b\u5c0f\u6642 - \u7136\u5f8c\u81ea\u52d5\u95dc\u9589\u3002"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fchre ein TV-Tagebuch: Was hast du gestern geschaut? War es wert?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a TV diary: what did you watch yesterday? Was it worth it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva un diario de TV: \u00bfqu\u00e9 viste ayer? \u00bfVali\u00f3 la pena?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens un journal t\u00e9l\u00e9vis\u00e9 : qu'as-tu regard\u00e9 hier ? \u00c7a valait le coup ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0940\u0935\u0940 \u0921\u093e\u092f\u0930\u0940 \u092c\u0928\u093e\u090f\u0902: \u0906\u092a\u0928\u0947 \u0915\u0932 \u0915\u094d\u092f\u093e \u0926\u0947\u0916\u093e? \u0915\u094d\u092f\u093e \u092f\u0939 \u0907\u0938\u0915\u0947 \u0932\u093e\u092f\u0915 \u0925\u093e?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni un diario televisivo: cosa hai guardato ieri? Ne valeva la pena?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c6\u30ec\u30d3\u65e5\u8a18\u3092\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u6628\u65e5\u306f\u4f55\u3092\u898b\u307e\u3057\u305f\u304b\uff1f\u305d\u308c\u3060\u3051\u306e\u4fa1\u5024\u304c\u3042\u308a\u307e\u3057\u305f\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV \uc77c\uae30\ub97c \uc368\ubcf4\uc138\uc694: \uc5b4\uc81c \ubb34\uc5c7\uc744 \ubd24\ub098\uc694? \uadf8\ub7f4 \uac00\uce58\uac00 \uc788\uc5c8\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een tv-dagboek bij: wat heb je gisteren gekeken? Was het de moeite waard?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prowad\u017a dziennik TV: co ogl\u0105da\u0142e\u015b wczoraj? Czy to by\u0142o warte?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um di\u00e1rio de TV: o que voc\u00ea assistiu ontem? Valeu a pena?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0434\u0438\u0442\u0435 \u0442\u0435\u043b\u0435\u0434\u043d\u0435\u0432\u043d\u0438\u043a: \u0447\u0442\u043e \u0432\u044b \u0441\u043c\u043e\u0442\u0440\u0435\u043b\u0438 \u0432\u0447\u0435\u0440\u0430? \u0421\u0442\u043e\u0438\u043b\u043e \u043b\u0438 \u043e\u043d\u043e \u0442\u043e\u0433\u043e?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV g\u00fcnl\u00fc\u011f\u00fc tut: d\u00fcn ne izledin? De\u011fdi mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5199\u7535\u89c6\u65e5\u8bb0\uff1a\u4f60\u6628\u5929\u770b\u4e86\u4ec0\u4e48\uff1f\u503c\u5f97\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5beb\u96fb\u8996\u65e5\u8a18\uff1a\u4f60\u6628\u5929\u770b\u4e86\u4ec0\u9ebc\uff1f\u503c\u5f97\u55ce\uff1f"
          }
        }
      }
    },
    "trash.endlos_scroll_tv.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Zuviel Fernsehen)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Ein Buch lesen)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zuviel Fernsehen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Ein Buch lesen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zuviel Fernsehen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Ein Buch lesen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zuviel Fernsehen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Ein Buch lesen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u092c\u0941\u0930\u0940 \u0906\u0926\u0924 \u0938\u0947 \u091b\u0941\u091f\u0915\u093e\u0930\u093e \u092a\u093e\u0928\u093e (\u0905\u0927\u093f\u0915 \u091f\u0940\u0935\u0940 \u0926\u0947\u0916\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u090f\u0902: \u0905\u092a\u0928\u0947 \u0926\u0943\u0936\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u090f\u0902: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u094d\u0930\u092d\u093e\u0935\u094b\u0902 \u0938\u0947 \u0905\u0935\u0917\u0924 \u0939\u094b\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u090f\u0902 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0916\u0940\u0902\u091a\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u090f\u0915 \u0915\u093f\u0924\u093e\u092c \u092a\u0922\u093c\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u090f\u0902: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u090f\u0902: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u090f\u0902: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0924\u0915 \u0918\u091f\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u090f\u0902: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zuviel Fernsehen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Ein Buch lesen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zuviel Fernsehen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Ein Buch lesen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Zuviel Fernsehen)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Ein Buch lesen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."

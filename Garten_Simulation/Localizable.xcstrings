    "trash.party_pass.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane Events nur noch bis 23 Uhr – danach nach Hause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",

    "plant.brennnessel.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schmerzt kurz, macht unkaputtbar – Kaltdusche + Gym Kombo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stings briefly, makes unbreakable – Cold shower + gym combo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duele un momento, te vuelve irrompible – Ducha fría + gym"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pique brièvement, rend indestructible – Douche froide + salle de sport"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थोड़े समय के लिए दर्द, इसे अविनाशी बनाता है - ठंडा स्नान + जिम कॉम्बो"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa male per un breve periodo, lo rende indistruttibile: combinazione doccia fredda + palestra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間刺すだけで壊れなくなる – 冷水シャワーとジムの組み合わせ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐 찌르면 깨지지 않게 됩니다 – 냉수 샤워 + 체육관 콤보"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikt kort, maakt onbreekbaar – Koude douche + gym combo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kłuje krótko, czyni niezniszczalnym – połączenie zimnego prysznica i siłowni"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arde brevemente, torna-te inquebrável – Duche frio + ginásio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arde brevemente, torna-te inquebrável – Duche frio + ginásio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Болит немного, делает неуязвимым – комбинация холодного душа и тренажерного зала"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa süreliğine acıtır, kırılmaz hale getirir – Soğuk duş + spor salonu kombinasyonu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短暂疼痛，但坚不可摧 – 冷水澡 + 健身组合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短暫疼痛，堅不可摧－冷水淋浴+健身房組合"
          }
        }
      }
    },
    "plant.chrysantheme.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnung = Blüte – Sauberkeit & Aufräumen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order = Bloom – Cleanliness & Tidying"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden = Floración – Limpieza y orden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordre = floraison – Propreté & rangement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम = खिलना - साफ़-सफ़ाई और साफ़-सफ़ाई"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordine = fioritura – pulizia e riordino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秩序 = ブルーム – 清潔さと整理整頓"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주문 = 꽃 – 청결 및 정리"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestellen = Bloom – Netheid en opruimen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządek = rozkwit – czystość i porządek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordem = florescimento – Limpeza & arrumação"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordem = florescimento – Limpeza & arrumação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок = цветение – чистота и уборка"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen = Bloom – Temizlik ve Düzenleme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秩序 = 绽放 – 清洁与整理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秩序 = 綻放 – 清潔與整理"
          }
        }
      }
    },

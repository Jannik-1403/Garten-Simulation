        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cb7\u9019\u500b\u80a5\u6599\uff01"
          }
        }
      }
    },
    "onboarding_tutorial_interactive_shop_success": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stark! Items geben dir sofortige Vorteile im Garten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awesome! Items give you immediate benefits in the garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Genial! Los objetos te dan beneficios inmediatos en el jard\u00edn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9nial ! Les objets te procurent des avantages imm\u00e9diats dans le jardin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u091c\u093c\u092c\u0942\u0924! \u0935\u0938\u094d\u0924\u0941\u090f\u0902 \u0906\u092a\u0915\u094b \u092c\u0917\u0940\u091a\u0947 \u092e\u0947\u0902 \u0924\u0924\u094d\u0915\u093e\u0932 \u0932\u093e\u092d \u0926\u0947\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Awesome! Items give you immediate benefits in the garden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d20\u6674\u3089\u3057\u3044\uff01\u30a2\u30a4\u30c6\u30e0\u306f\u5ead\u3067\u3059\u3050\u306b\u5229\u76ca\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5c4\uccad\ub09c! \uc544\uc774\ud15c\uc740 \uc815\uc6d0\uc5d0\uc11c \uc989\uac01\uc801\uc778 \ud61c\ud0dd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig! Artikelen geven je direct voordeel in de tuin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspania\u0142y! Przedmioty daj\u0105 natychmiastowe korzy\u015bci w ogrodzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incr\u00edvel! Os itens d\u00e3o-te benef\u00edcios imediatos no jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0440\u0443\u0442\u043e! \u041f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0434\u0430\u044e\u0442 \u0442\u0435\u0431\u0435 \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0432 \u0441\u0430\u0434\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00fckemmel! \u00d6\u011feler bah\u00e7ede size an\u0131nda fayda sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u592a\u68d2\u4e86\uff01\u7269\u54c1\u80fd\u7acb\u5373\u4e3a\u4f60\u7684\u82b1\u56ed\u5e26\u6765\u597d\u5904\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f37\u7684\uff01\u8fd9\u4e9b\u7269\u54c1\u53ef\u4ee5\u8ba9\u60a8\u5728\u82b1\u56ed\u4e2d\u7acb\u5373\u83b7\u5f97\u4f18\u52bf\u3002"
          }
        }
      }
    },
    "onboarding_tutorial_interactive_weed_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unkraut macht deinen Garten schw\u00e4cher und du verdienst weniger XP! Vermeide es, indem du nicht zu viele Schlechte Gewohnheiten kaufst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeds make your garden weaker and you earn less XP! Avoid them by not buying too many bad habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Las malas hierbas debilitan tu jard\u00edn y ganas menos XP! Ev\u00edtalas no comprando demasiadas decoraciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises herbes affaiblissent ton jardin et tu gagnes moins d'XP ! \u00c9vite-les en n'achetant pas trop de d\u00e9corations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0906\u092a\u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u094b \u0915\u092e\u091c\u093c\u094b\u0930 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a \u0915\u092e XP \u0915\u092e\u093e\u0924\u0947 \u0939\u0948\u0902! \u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u092c\u0941\u0930\u0940 \u0906\u0926\u0924\u0947\u0902 \u0928 \u092a\u093e\u0932\u0915\u0930 \u0907\u0938\u0938\u0947 \u092c\u091a\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le erbacce indeboliscono il tuo giardino e guadagni meno XP! Evitale non comprando troppe decorazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96d1\u8349\u304c\u751f\u3048\u308b\u3068\u5ead\u304c\u5f31\u304f\u306a\u308a\u3001\u7372\u5f97\u3067\u304d\u308b XP \u3082\u6e1b\u308a\u307e\u3059\u3002\u88c5\u98fe\u54c1\u3092\u8cb7\u3044\u3059\u304e\u306a\u3044\u3088\u3046\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a1\ucd08\ub294 \uc815\uc6d0\uc744 \uc57d\ud654\uc2dc\ud0a4\uace0 XP\ub97c \uc801\uac8c \uc5bb\uc2b5\ub2c8\ub2e4! \uc7a5\uc2dd\uc744 \ub108\ubb34 \ub9ce\uc774 \uad6c\uc785\ud558\uc9c0 \uc54a\uc74c\uc73c\ub85c\uc368 \uc774\ub7ec\ud55c \ud604\uc0c1\uc744 \ud53c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onkruid maakt je tuin zwakker en je verdient minder XP! Vermijd ze door niet te veel decoraties te kopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwasty os\u0142abiaj\u0105 Tw\u00f3j ogr\u00f3d i zarabiasz mniej XP! Unikaj ich, nie kupuj\u0105c zbyt wielu dekoracji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas enfraquecem o teu jardim e ganhas menos XP! Evita-as n\u00e3o comprando demasiadas decora\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0440\u043d\u044f\u043a\u0438 \u043e\u0441\u043b\u0430\u0431\u043b\u044f\u044e\u0442 \u0432\u0430\u0448 \u0441\u0430\u0434, \u0438 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u043c\u0435\u043d\u044c\u0448\u0435 \u043e\u043f\u044b\u0442\u0430! \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u044d\u0442\u043e\u0433\u043e, \u043d\u0435 \u043f\u043e\u043a\u0443\u043f\u0430\u044f \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u043f\u043b\u043e\u0445\u0438\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u0435\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabani otlar bah\u00e7enizi zay\u0131flat\u0131r ve daha az XP kazan\u0131rs\u0131n\u0131z! \u00c7ok fazla dekorasyon sat\u0131n almayarak bunlardan ka\u00e7\u0131n\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6742\u8349\u4f1a\u4f7f\u4f60\u7684\u82b1\u56ed\u53d8\u5f31\uff0c\u4f60\u83b7\u5f97\u7684\u7ecf\u9a8c\u503c\u4e5f\u4f1a\u51cf\u5c11\uff01\u907f\u514d\u8d2d\u4e70\u592a\u591a\u574f\u4e60\u60ef\u6765\u9632\u6b62\u6742\u8349\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96dc\u8349\u6703\u8b93\u4f60\u7684\u82b1\u5712\u8b8a\u5f97\u8106\u5f31\uff0c\u4f60\u7372\u5f97\u7684\u7d93\u9a57\u503c\u4e5f\u6703\u6e1b\u5c11\uff01\u4e0d\u8981\u8cfc\u8cb7\u592a\u591a\u58de\u7fd2\u6163\u4f86\u907f\u514d\u9019\u7a2e\u60c5\u6cc1\u3002"
          }
        }
      }
    },
    "onboarding_tutorial_interactive_weed_warning": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlechte Gewohnheiten locken langfristig Unkraut an. Je mehr Deko, desto h\u00f6her die Gefahr im Gl\u00fccksrad!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad Habits attract weeds in the long run. The more deco, the higher the danger in the wheel!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las decoraciones atraen malas hierbas a largo plazo. \u00a1A m\u00e1s decoraci\u00f3n, mayor peligro en la ruleta!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les d\u00e9corations attirent les mauvaises herbes \u00e0 long terme. Plus il y a de d\u00e9co, plus le danger est grand dans la roue !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0941\u0930\u0940 \u0906\u0926\u0924\u0947\u0902 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0924\u0915 \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u094d\u0930\u092d\u093e\u0935 \u0921\u093e\u0932\u0924\u0940 \u0939\u0948\u0902\u0964 \u091c\u093f\u0924\u0928\u0940 \u0905\u0927\u093f\u0915 \u0938\u091c\u093e\u0935\u091f, \u092d\u093e\u0917\u094d\u092f \u0915\u0947 \u091a\u0915\u094d\u0930 \u092e\u0947\u0902 \u0916\u0924\u0930\u093e \u0909\u0924\u0928\u093e \u0905\u0927\u093f\u0915!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le decorazioni attraggono le erbacce a lungo termine. Pi\u00f9 decorazioni ci sono, maggiore \u00e8 il pericolo nella ruota!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u88c5\u98fe\u306f\u9577\u671f\u7684\u306b\u306f\u96d1\u8349\u3092\u5f15\u304d\u5bc4\u305b\u307e\u3059\u3002\u30c7\u30b3\u304c\u591a\u3051\u308c\u3070\u591a\u3044\u307b\u3069\u3001\u30db\u30a4\u30fc\u30eb\u306e\u5371\u967a\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a5\uc2dd\uc740 \uc7a5\uae30\uc801\uc73c\ub85c \uc7a1\ucd08\ub97c \uc720\uc778\ud569\ub2c8\ub2e4. \ub370\ucf54\uac00 \ub9ce\uc744\uc218\ub85d \ud720\uc758 \uc704\ud5d8\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoraties trekken op den duur onkruid aan. Hoe meer decoratie, hoe groter het gevaar in het rad!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekoracje na d\u0142u\u017csz\u0105 met\u0119 przyci\u0105gaj\u0105 chwasty. Im wi\u0119cej deco, tym wi\u0119ksze niebezpiecze\u0144stwo w kole!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As decora\u00e7\u00f5es atraem ervas daninhas a longo prazo. Quanto mais decora\u00e7\u00e3o, maior o perigo na roleta!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043b\u043e\u0445\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u044e\u0442 \u0441\u043e\u0440\u043d\u044f\u043a\u0438. \u0427\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0435\u043a\u043e\u0440\u0430, \u0442\u0435\u043c \u0432\u044b\u0448\u0435 \u0440\u0438\u0441\u043a \u043d\u0430 \u043a\u043e\u043b\u0435\u0441\u0435 \u0444\u043e\u0440\u0442\u0443\u043d\u044b!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekorasyonlar uzun vadede yabani otlar\u0131 \u00e7eker. Deko ne kadar fazla olursa, tekerlekteki tehlike de o kadar y\u00fcksek olur!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u574f\u4e60\u60ef\u4f1a\u957f\u671f\u5438\u5f15\u6742\u8349\u3002\u88c5\u9970\u54c1\u8d8a\u591a\uff0c\u5e78\u8fd0\u8f6e\u76d8\u7684\u98ce\u9669\u5c31\u8d8a\u9ad8\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u58de\u7fd2\u6163\u6703\u5438\u5f15\u96dc\u8349\u3002\u88c5\u9970\u54c1\u8d8a\u591a\uff0c\u547d\u8fd0\u4e4b\u8f6e\u7684\u5371\u9669\u6027\u5c31\u8d8a\u9ad8\uff01"
          }
        }
      }
    },
    "onboarding_tutorial_interactive_xp_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Pflanze oben, um sie zu gie\u00dfen und XP zu sammeln!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the plant above to water it and collect XP!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Toca la planta arriba para regarla y ganar XP!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur la plante ci-dessus pour l'arroser et gagner de l'XP !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090a\u092a\u0930 \u0926\u093f\u090f \u0917\u090f \u092a\u094c\u0927\u0947 \u0915\u094b \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0938\u0947 \u091f\u0948\u092a \u0915\u0930\u0947\u0902 \u0914\u0930 XP \u0905\u0930\u094d\u091c\u093f\u0924 \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the plant above to water it and collect XP!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0a\u306e\u690d\u7269\u3092\u30bf\u30c3\u30d7\u3057\u3066\u6c34\u3092\u3084\u308a\u3001XP \u3092\u96c6\u3081\u307e\u3057\u3087\u3046!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc704\uc758 \uc2dd\ubb3c\uc744 \ud0ed\ud558\uc5ec \ubb3c\uc744 \uc8fc\uace0 XP\ub97c \ubaa8\uc544\ubcf4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de plant hierboven om hem water te geven en XP te verzamelen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij ro\u015blin\u0119 powy\u017cej, aby j\u0105 podla\u0107 i zebra\u0107 XP!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca na planta acima para a regares e ganhares XP!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0441\u0432\u0435\u0440\u0445\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0438\u0442\u044c \u0435\u0433\u043e \u0438 \u0441\u043e\u0431\u0440\u0430\u0442\u044c XP!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulamak ve XP toplamak i\u00e7in yukar\u0131daki bitkiye dokunun!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u4e0a\u9762\u7684\u690d\u7269\uff0c\u7ed9\u5b83\u6d47\u6c34\u5e76\u6536\u96c6\u7ecf\u9a8c\u503c\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u64ca\u4e0a\u9762\u7684\u690d\u7269\u4f86\u6f86\u6c34\u4e26\u8cfa\u53d6 XP\uff01"
          }
        }
      }
    },
    "onboarding_tutorial_interactive_xp_success": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Super! Wenn der Ring voll ist, steigt deine Pflanze ein Level auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great! When the ring is full, your plant levels up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Genial! Quando el c\u00edrculo est\u00e9 lleno, tu planta subir\u00e1 de nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super ! Quand l'anneau est plein, ta plante monte de niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0939\u0941\u0924 \u0905\u091a\u094d\u091b\u093e! \u091c\u092c \u0930\u093f\u0902\u0917 \u092d\u0930 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u0947 \u092a\u094c\u0927\u0947 \u0915\u093e \u0938\u094d\u0924\u0930 \u090a\u092a\u0930 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Great! When the ring is full, your plant levels up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d20\u6674\u3089\u3057\u3044\uff01\u30ea\u30f3\u30b0\u304c\u3044\u3063\u3071\u3044\u306b\u306a\u308b\u3068\u3001\u690d\u7269\u306e\u30ec\u30d9\u30eb\u304c\u4e0a\u304c\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5c4\uccad\ub09c! \ub9c1\uc774 \uac00\ub4dd \ucc28\uba74 \uc2dd\ubb3c\uc758 \ub808\ubca8\uc774 \uc62c\ub77c\uac11\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig! Als de ring vol is, gaat je plant in level omhoog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015awietnie! Kiedy pier\u015bcie\u0144 jest pe\u0142ny, twoja ro\u015blina awansuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espetacular! Quando o anel estiver cheio, a tua planta sobe de n\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043b\u0438\u0447\u043d\u043e! \u041a\u043e\u0433\u0434\u0430 \u043a\u043e\u043b\u044c\u0446\u043e \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043e, \u0432\u0430\u0448\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0434\u0438\u043d \u0443\u0440\u043e\u0432\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika! Halka doldu\u011funda bitkinizin seviyesi y\u00fckselir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u592a\u68d2\u4e86\uff01\u5f53\u5706\u73af\u6ee1\u65f6\uff0c\u4f60\u7684\u690d\u7269\u5c31\u4f1a\u5347\u7ea7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6975\u597d\u7684\uff01\u7576\u5713\u74b0\u6eff\u4e86\u6642\uff0c\u4f60\u7684\u690d\u7269\u5c31\u6703\u5347\u7d1a\u3002"
          }
        }
      }
    },
    "onboarding_tutorial_powerup_active_success": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stark! Der Goldene Schl\u00fcssel ist nun aktiv. Du erh\u00e4ltst jetzt 1.5x mehr XP!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awesome! The Golden Key is now active. You now get 1.5x more XP!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Genial! La Llave Dorada est\u00e1 activa. \u00a1Ahora obtienes 1.5x m\u00e1s XP!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super ! La Cl\u00e9 Dor\u00e9e est maintenant active. Tu re\u00e7ois maintenant 1.5x plus d'XP !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u091c\u093c\u092c\u0942\u0924! \u0917\u094b\u0932\u094d\u0921\u0928 \u0915\u0940 \u0905\u092c \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948. \u0905\u092c \u0906\u092a\u0915\u094b 1.5 \u0917\u0941\u0928\u093e \u0905\u0927\u093f\u0915 XP \u092e\u093f\u0932\u0947\u0917\u093e!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo! La Chiave Dorata \u00e8 ora attiva. Ricevi ora 1.5x pi\u00f9 XP!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d20\u6674\u3089\u3057\u3044\uff01\u30b4\u30fc\u30eb\u30c7\u30f3\u30ad\u30fc\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u4eca\u306a\u3089 1.5 \u500d\u306e XP \u3092\u7372\u5f97\u3067\u304d\u307e\u3059!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5c4\uccad\ub09c! \uc774\uc81c \ud669\uae08 \uc5f4\uc1e0\uac00 \ud65c\uc131\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\uc81c XP\uac00 1.5\ubc30 \ub354 \ub298\uc5b4\ub0a9\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig! De Gouden Sleutel is nu actief. Je krijgt nu 1,5x meer XP!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspania\u0142y! Z\u0142oty Klucz jest teraz aktywny. Otrzymasz teraz 1,5x wi\u0119cej PD!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incr\u00edvel! A Chave Dourada est\u00e1 agora ativa. Recebes agora 1.5x mais XP!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043b\u0438\u0447\u043d\u043e! \u0417\u043e\u043b\u043e\u0442\u043e\u0439 \u043a\u043b\u044e\u0447 \u0442\u0435\u043f\u0435\u0440\u044c \u0430\u043a\u0442\u0438\u0432\u0435\u043d. \u0422\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c \u0442\u0435\u043f\u0435\u0440\u044c \u0432 1,5 \u0440\u0430\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u043f\u044b\u0442\u0430!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00fckemmel! Alt\u0131n Anahtar art\u0131k aktif. Art\u0131k 1,5 kat daha fazla XP elde edeceksiniz!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u592a\u68d2\u4e86\uff01\u91d1\u94a5\u5319\u73b0\u5df2\u6fc0\u6d3b\u3002\u4f60\u73b0\u5728\u5c06\u83b7\u5f971.5\u500d\u7684\u7ecf\u9a8c\u503c\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f37\u7684\uff01\u91d1\u9470\u5319\u73fe\u5df2\u555f\u7528\u3002\u73fe\u5728\u60a8\u7372\u5f97\u7684 XP \u589e\u52a0\u4e86 1.5 \u500d\uff01"
          }
        }
      }
    },
    "onboarding_tutorial_powerup_bubble": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gebe dir verschiedene Effekte f\u00fcr den Garten. Benutze sie um sch\u00f6ne Fortschritte zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll give you various effects for the garden. Use them to make beautiful progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dar\u00e9 varios efectos para el jard\u00edn. \u00dasalos para lograr un progreso hermoso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais te donner divers effets pour le jardin. Utilise-les pour faire de beaux progr\u00e8s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u092c\u0917\u0940\u091a\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u094d\u0930\u092d\u093e\u0935 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964 \u0905\u091a\u094d\u091b\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0928\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dar\u00f2 vari effetti per il giardino. Usali per fare bei progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u5ead\u306b\u3055\u307e\u3056\u307e\u306a\u52b9\u679c\u3092\u4e0e\u3048\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u4f7f\u7528\u3057\u3066\u3001\u7f8e\u3057\u3044\u9032\u6b69\u3092\u9042\u3052\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc5d0 \ub2e4\uc591\ud55c \ud6a8\uacfc\ub97c \ub4dc\ub824\uc694. \uc774\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc544\ub984\ub2e4\uc6b4 \ubc1c\uc804\uc744 \uc774\ub8e8\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik geef je verschillende effecten voor de tuin. Gebruik ze om mooie vooruitgang te boeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podam Ci r\u00f3\u017cne efekty do ogrodu. U\u017cywaj ich, aby robi\u0107 pi\u0119kne post\u0119py."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou dar-te v\u00e1rios efeitos para o jardim. Usa-os para fazeres belos progressos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0434\u0430\u043c \u0442\u0435\u0431\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0434\u043b\u044f \u0441\u0430\u0434\u0430. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0438\u0445, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0438\u0447\u044c \u043a\u0440\u0430\u0441\u0438\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7e i\u00e7in sana \u00e7e\u015fitli efektler verece\u011fim. G\u00fczel bir ilerleme kaydetmek i\u00e7in bunlar\u0131 kullan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e3a\u4f60\u7684\u82b1\u56ed\u63d0\u4f9b\u5404\u79cd\u6548\u679c\u3002\u4f7f\u7528\u5b83\u4eec\u6765\u53d6\u5f97\u663e\u8457\u7684\u8fdb\u6b65\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u70ba\u60a8\u63d0\u4f9b\u4e86\u82b1\u5712\u7684\u4e0d\u540c\u6548\u679c\u3002\u5229\u7528\u5b83\u5011\u53d6\u5f97\u826f\u597d\u7684\u9032\u6b65\u3002"
          }
        }
      }
    },
    "onboarding_tutorial_powerup_detail_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Schl\u00fcssel, um ihn einzusetzen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the key to use it!"

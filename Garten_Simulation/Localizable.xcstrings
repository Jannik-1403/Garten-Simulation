          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu vou e faço o treino do ódio, mas com 50% menos peso/velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я иду туда, делаю ненавистную тренировку, но с 50% меньшим весом/скоростью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gidip nefret antrenmanı yapıyorum ama %50 daha az ağırlık/hızla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我去做那个讨厌的锻炼，但重量/速度减少50%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我去做討厭的鍛煉，但重量/速度減少了 50%。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.growth.pitfall.efficiency": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Perfektionismus. 80% erledigt ist besser als 0% perfekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid perfectionism. 80% done is better than 0% perfect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita el perfeccionismo. Un 80% hecho es mejor que un 0% perfecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite le perfectionnisme. 80% fait vaut mieux que 0% parfait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्णतावाद से बचो। 80% हो गया 0% परफेक्ट से बेहतर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

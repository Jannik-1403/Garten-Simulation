    "plant.watering.release": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslassen zum Gie\u00dfen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to water!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Suelta para regar!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rel\u00e2cher pour arroser !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0902\u091a\u093e\u0908 \u0915\u0947 \u0932\u093f\u090f \u091b\u094b\u0921\u093c \u0926\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia per annaffiare!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u653e\u3057\u3066\u6c34\u3084\u308a\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub193\uc544\uc11c \ubb3c \uc8fc\uae30!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslaten om te gieten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pu\u015b\u0107, aby podla\u0107!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte para regar!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u043b\u044f \u043f\u043e\u043b\u0438\u0432\u0430!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0131rak ve sula!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u677e\u5f00\u4ee5\u6d47\u6c34\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cb\u653e\u5230\u6c34\u4e2d\uff01"
          }
        }
      }
    },
    "plant.weinrebe.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je l\u00e4nger n\u00fcchtern, desto reicher die Ernte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer sober, the richer the harvest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto m\u00e1s sobrio, m\u00e1s rica la cosecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus on est sobre longtemps, plus riche est la r\u00e9colte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u093f\u0924\u0928\u093e \u0932\u0902\u092c\u093e \u0938\u0902\u092f\u092e, \u0909\u0924\u0928\u0940 \u0905\u0927\u093f\u0915 \u092b\u0938\u0932"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer sober, the richer the harvest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65ad\u9152\u671f\u9593\u304c\u9577\u3051\u308c\u3070\u9577\u3044\u307b\u3069\u3001\u3088\u308a\u8c4a\u304b\u306a\u53ce\u7a6b\u304c\u5f97\u3089\u308c\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0c9\uc815\ud55c \uc2dc\uac04\uc774 \uae38\uc5b4\uc9c8\uc218\ub85d \uc218\ud655\ub7c9\uc774 \ub9ce\uc544\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe langer nuchter, hoe rijker de oogst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Im d\u0142u\u017cej trze\u017awy, tym bogatsze zbiory"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais s\u00f3brio por mais tempo, mais rica a colheita"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0435\u043c \u0434\u043e\u043b\u044c\u0448\u0435 \u0442\u0440\u0435\u0437\u0432, \u0442\u0435\u043c \u0431\u043e\u0433\u0430\u0447\u0435 \u0443\u0440\u043e\u0436\u0430\u0439"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar ay\u0131k olursa, hasat o kadar zengin olur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6212\u9152\u8d8a\u4e45\uff0c\u6536\u83b7\u8d8a\u4e30"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301\u6e05\u9192\u7684\u6642\u9593\u8d8a\u9577\uff0c\u6536\u7a6b\u5c31\u8d8a\u8c50\u5bcc"
          }
        }
      }
    },

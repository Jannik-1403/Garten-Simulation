    "assessment.health.profile.erschoepfer.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf ist keine Schwäche — es ist das einzige Upgrade, das dein Gehirn kostenlos bekommt. Fang heute damit an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep isn't a weakness — it's the only upgrade your brain gets for free. Start it today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormir no es una debilidad: es la única mejora que tu cerebro obtiene de forma gratuita. Empiece hoy mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil n'est pas une faiblesse : c'est la seule amélioration dont votre cerveau bénéficie gratuitement. Commencez-le aujourd'hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद कोई कमजोरी नहीं है - यह आपके मस्तिष्क को मुफ्त में मिलने वाला एकमात्र अपग्रेड है। इसे आज ही शुरू करें."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno non è una debolezza: è l'unico potenziamento che il tuo cervello riceve gratuitamente. Inizialo oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は弱点ではありません。睡眠は、脳が無料で得られる唯一のアップグレードです。今日から始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면은 약점이 아닙니다. 수면은 두뇌가 무료로 얻을 수 있는 유일한 업그레이드입니다. 오늘 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap is geen zwakte; het is de enige upgrade die je hersenen gratis krijgen. Begin er vandaag mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen nie jest słabością — to jedyne ulepszenie, które Twój mózg otrzymuje za darmo. Zacznij już dziś."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono não é uma fraqueza – é a única atualização que seu cérebro recebe de graça. Comece hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон — это не слабость, это единственное обновление, которое ваш мозг получает бесплатно. Начните сегодня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku bir zayıflık değildir; beyninizin ücretsiz olarak elde ettiği tek yükseltmedir. Bugün başlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠不是弱点——它是你大脑唯一免费获得的升级。从今天开始吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠不是弱點——它是你的大腦唯一免費獲得的升級。今天就開始吧。"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinke morgens dein erstes Glas Wasser, BEVOR du den Knopf der Kaffeemaschine drückst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink your first glass of water in the morning BEFORE you press the button on the coffee machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe tu primer vaso de agua por la mañana ANTES de pulsar el botón de la cafetera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buvez votre premier verre d'eau le matin AVANT d'appuyer sur le bouton de la machine à café."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुबह कॉफी मशीन का बटन दबाने से पहले अपना पहला गिलास पानी पियें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevi il tuo primo bicchiere d'acqua al mattino PRIMA di premere il pulsante della macchina da caffè."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝、コーヒーマシンのボタンを押す前に、最初の水を一杯飲みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침에 커피 머신의 버튼을 누르기 전에 첫 번째 물 한 잔을 마시세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink 's ochtends uw eerste glas water VOORDAT u op de knop van de koffiemachine drukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszą szklankę wody wypij rano ZANIM naciśniesz przycisk na ekspresie do kawy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beba seu primeiro copo de água pela manhã ANTES de apertar o botão da cafeteira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пей утром первый стакан воды, ПРЕЖДЕ чем нажмёшь кнопку кофемашины."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabahları ilk bardak suyunuzu kahve makinesinin tuşuna basmadan ÖNCE için."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早上在按下咖啡机按钮之前，先喝你的第一杯水。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早上按咖啡機按鈕前喝第一杯水。"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle einen 'Schlaf-Wecker' um 21:45 Uhr. Wenn er klingelt, machst du nur das Deckenlicht aus und eine Leselampe an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a 'sleep alarm' at 9:45 p.m. When the doorbell rings, you just turn off the overhead light and turn on a reading lamp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure una 'alarma de sueño' a las 9:45 p.m. Cuando suena el timbre, simplemente apaga la luz del techo y enciende una lámpara de lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez une « alarme de sommeil » à 21h45. Lorsque la sonnette retentit, il vous suffit d’éteindre le plafonnier et d’allumer une lampe de lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रात 9:45 बजे 'स्लीप अलार्म' सेट करें। जब दरवाज़े की घंटी बजती है, तो आप बस ओवरहेड लाइट बंद कर दें और रीडिंग लैंप चालू कर दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una \"sveglia sonno\" alle 21:45. Quando suona il campanello, basta spegnere la luce e accendere una lampada da lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後9時45分に「睡眠アラーム」をセットします。ドアホンが鳴ったら、頭上の照明を消して読書灯を点灯するだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오후 9시 45분에 '수면 알람'을 설정해 주세요. 초인종이 울리면 머리 위 조명을 끄고 독서등만 켜면 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een 'slaapwekker' om 21.45 uur. Als de deurbel gaat, doe je gewoon het plafondlicht uit en zet je een leeslamp aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw „budzik snu” na 21:45. Kiedy zadzwoni dzwonek do drzwi, po prostu zgaś górne światło i włącz lampkę do czytania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina um ‘alarme de sono’ para 21h45. Quando a campainha tocar, basta desligar a luz do teto e acender uma lâmpada de leitura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установи «будильник для сна» на 21:45. Когда он зазвонит, просто выключи потолочный свет и включи настольную лампу для чтения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "21:45'e bir 'uyku alarmı' kurun. Kapı zili çaldığında tavandaki ışığı kapatıp okuma lambasını açmanız yeterli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置一个“睡眠闹钟”在21:45。当它响时，你只需关掉顶灯，开一盏阅读灯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在晚上 9:45 設定「睡眠鬧鐘」當門鈴響起時，您只需關閉頂燈並打開閱讀燈即可。"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Regeneration ist mangelhaft. Anstatt direkt 8 Stunden Schlaf zu erzwingen, etablieren wir eine 1％-Reibung vor dem Schlafengehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your regeneration is inadequate. Instead of directly forcing 8 hours of sleep, we establish a 1％ rub before bed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu regeneración es inadecuada. En lugar de forzar directamente 8 horas de sueño, establecemos una frotación del 1％ antes de acostarnos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre régénération est insuffisante. Au lieu de forcer directement 8 heures de sommeil, on établit un frottement à 1％ avant de se coucher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पुनर्जनन अपर्याप्त है. सीधे तौर पर 8 घंटे की नींद के लिए बाध्य करने के बजाय, हम सोने से पहले 1％ रगड़ना स्थापित करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua rigenerazione è inadeguata. Invece di forzare direttamente 8 ore di sonno, stabiliamo un massaggio dell’1％ prima di andare a letto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの再生能力は不十分です。 8時間の睡眠を直接強制するのではなく、就寝前に1％のマッサージを確立します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 재생은 불충분합니다. 직접적으로 8시간의 수면을 강요하는 대신, 잠자리에 들기 전 1％의 문지름을 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw wedergeboorte is ontoereikend. In plaats van direct 8 uur slaap af te dwingen, wrijven we voor het slapengaan een massage van 1％ in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja regeneracja jest niewystarczająca. Zamiast bezpośrednio wymuszać 8 godzin snu, ustalamy 1％ nacieranie przed snem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua regeneração é inadequada. Em vez de forçar diretamente 8 horas de sono, estabelecemos uma massagem de 1％ antes de dormir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твое восстановление недостаточно. Вместо того чтобы заставлять себя спать прямо 8 часов, мы вводим 1％-ное сопротивление перед сном."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilenmeniz yetersiz. Doğrudan 8 saatlik uykuyu zorlamak yerine yatmadan önce ％1'lik bir ovma oluşturuyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的恢复能力不足。与其强迫自己直接睡足8小时，我们不如在睡前建立1％的摩擦。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的再生能力不夠。我們沒有直接強制睡眠 8 小時，而是在睡前進行 1％ 的按摩。"
          }
        }
      }
    },

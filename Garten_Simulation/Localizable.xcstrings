    "decoration.info.description" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlechte Gewohnheiten in diesem Shop repräsentieren schlechte Gewohnheiten in der echten Welt. Du solltest dir diese Dinge in der App kaufen, wenn du eine dieser schlechten Gewohnheiten im echten Leben ausgeführt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bad Habits in this shop represent bad habits in the real world. You should buy these items in the app if you have performed one of these bad habits in real life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las decoraciones en esta tienda representan malos hábitos en el mundo real. Deberías comprar estos artículos en la aplicación si has realizado uno de estos malos hábitos en la vida real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les décorations dans cette boutique représentent de mauvaises habitudes dans le monde réel. Tu devrais acheter ces articles dans l'application si tu as effectué l'une de ces mauvaises habitudes dans la vraie vie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस दुकान की बुरी आदतें वास्तविक दुनिया की बुरी आदतों का प्रतिनिधित्व करती हैं। यदि आपने वास्तविक जीवन में इनमें से कोई भी बुरी आदत अपनाई है तो आपको ऐप से ये चीजें खरीदनी चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le decorazioni in questo negozio rappresentano cattive abitudini nel mondo reale. Dovresti acquistare questi articoli nell'app se hai eseguito una di queste cattive abitudini nella vita reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このショップの装飾品は、現実世界の悪い習慣を表しています。現実世界でこれらの悪い習慣のいずれかを行った場合は、アプリでこれらのアイテムを購入する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 상점의 장식은 현실 세계의 나쁜 습관을 나타냅니다. 실생활에서 이러한 나쁜 습관 중 하나를 수행한 경우 앱에서 이러한 항목을 구매해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decoraties in deze winkel vertegenwoordigen slechte gewoonten in de echte wereld. Je zou deze items in de app moeten kopen als je een van deze slechte gewoonten in het echte leven hebt uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekoracje w tym sklepie reprezentują złe nawyki w prawdziwym świecie. Powinieneś kupić te przedmioty w aplikacji, jeśli wykonałeś jeden z tych złych nawyków w prawdziwym życiu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As decorações nesta loja representam maus hábitos no mundo real. Deves comprar estes itens na aplicação se tiveres realizado um destes maus hábitos na vida real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохие привычки в этом магазине представляют собой плохие привычки в реальной жизни. Тебе следует покупать эти вещи в приложении, если ты выполнял одну из этих плохих привычек в реальной жизни."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mağazadaki dekorasyonlar gerçek dünyadaki kötü alışkanlıkları temsil eder. Gerçek hayatta bu kötü alışkanlıklardan birini yaptıysanız bu eşyaları uygulamada satın almalısınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个商店里的坏习惯代表现实世界中的坏习惯。如果你在现实生活中执行了这些坏习惯，你应该在应用程序中购买这些东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這家店的壞習慣代表了現實世界的壞習慣。如果您在現實生活中有任何這些壞習慣，您應該在應用程式中購買這些東西。"
          }
        }
      }
    },
    "decoration.info.title" : {
      "comment" : "",

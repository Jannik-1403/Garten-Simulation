    "plant.brennnessel.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schmerzt kurz, macht unkaputtbar \u2013 Kaltdusche + Gym Kombo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stings briefly, makes unbreakable \u2013 Cold shower + gym combo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duele un momento, te vuelve irrompible \u2013 Ducha fr\u00eda + gym"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pique bri\u00e8vement, rend indestructible \u2013 Douche froide + salle de sport"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0925\u094b\u0921\u093c\u0947 \u0938\u092e\u092f \u0915\u0947 \u0932\u093f\u090f \u0926\u0930\u094d\u0926, \u0907\u0938\u0947 \u0905\u0935\u093f\u0928\u093e\u0936\u0940 \u092c\u0928\u093e\u0924\u093e \u0939\u0948 - \u0920\u0902\u0921\u093e \u0938\u094d\u0928\u093e\u0928 + \u091c\u093f\u092e \u0915\u0949\u092e\u094d\u092c\u094b"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stings briefly, makes unbreakable \u2013 Cold shower + gym combo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u77ed\u6642\u9593\u523a\u3059\u3060\u3051\u3067\u58ca\u308c\u306a\u304f\u306a\u308b \u2013 \u51b7\u6c34\u30b7\u30e3\u30ef\u30fc\u3068\u30b8\u30e0\u306e\u7d44\u307f\u5408\u308f\u305b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\uae50 \ucc0c\ub974\uba74 \uae68\uc9c0\uc9c0 \uc54a\uac8c \ub429\ub2c8\ub2e4 \u2013 \ub0c9\uc218 \uc0e4\uc6cc + \uccb4\uc721\uad00 \ucf64\ubcf4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikt kort, maakt onbreekbaar \u2013 Koude douche + gym combo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0142uje kr\u00f3tko, czyni niezniszczalnym \u2013 po\u0142\u0105czenie zimnego prysznica i si\u0142owni"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arde brevemente, torna-te inquebr\u00e1vel \u2013 Duche frio + gin\u00e1sio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u043e\u043b\u0438\u0442 \u043d\u0435\u0434\u043e\u043b\u0433\u043e, \u0434\u0435\u043b\u0430\u0435\u0442 \u043d\u0435\u0443\u044f\u0437\u0432\u0438\u043c\u044b\u043c \u2013 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0443\u0448\u0430 \u0438 \u0442\u0440\u0435\u043d\u0430\u0436\u0435\u0440\u043d\u043e\u0433\u043e \u0437\u0430\u043b\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131sa s\u00fcreli\u011fine ac\u0131t\u0131r, k\u0131r\u0131lmaz hale getirir \u2013 So\u011fuk du\u015f + spor salonu kombinasyonu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u77ed\u6682\u75bc\u75db\uff0c\u4f46\u575a\u4e0d\u53ef\u6467 \u2013 \u51b7\u6c34\u6fa1 + \u5065\u8eab\u7ec4\u5408"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u77ed\u66ab\u75bc\u75db\uff0c\u5805\u4e0d\u53ef\u6467\uff0d\u51b7\u6c34\u6dcb\u6d74+\u5065\u8eab\u623f\u7d44\u5408"
          }
        }
      }
    },

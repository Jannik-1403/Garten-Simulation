        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś przed harmonogramem — w tym tempie możesz osiągnąć cel jeszcze przed %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está adiantado — nesse ritmo, pode atingir sua meta antes de %1$@."

        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek \u2014 osi\u0105gn\u0105\u0142e\u015b sw\u00f3j cel!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeito \u2014 atingiste o teu objetivo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0432\u0430\u0436\u0435\u043d\u0438\u0435 \u2014 \u0442\u044b \u0434\u043e\u0441\u0442\u0438\u0433 \u0441\u0432\u043e\u0435\u0439 \u0446\u0435\u043b\u0438!"
          }

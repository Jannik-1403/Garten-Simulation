    "plant.mandelbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Investiere in deine Zukunft und baue finanzielle Sicherheit auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invest in your future and build financial security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invierte en tu futuro y construye seguridad financiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Investissez dans votre avenir et b\u00e2tissez la s\u00e9curit\u00e9 financi\u00e8re."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0928\u093f\u0935\u0947\u0936 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092c\u0928\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Investi nel tuo futuro e costruisci sicurezza finanziaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u6765\u306b\u6295\u8cc7\u3057\u3001\u7d4c\u6e08\u7684\u306a\u5b89\u5168\u3092\u7bc9\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubbf8\ub798\uc5d0 \ud22c\uc790\ud558\uace0 \uc7ac\uc815\uc801 \uc548\uc815\uc744 \uad6c\ucd95\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Investeer in je toekomst en bouw financi\u00eble zekerheid op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainwestuj w swoj\u0105 przysz\u0142o\u015b\u0107 i buduj bezpiecze\u0144stwo finansowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Invista no seu futuro e construa seguran\u00e7a financeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0432\u0435\u0441\u0442\u0438\u0440\u0443\u0439 \u0432 \u0441\u0432\u043e\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0438 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0439 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0443\u044e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelece\u011finize yat\u0131r\u0131m yap\u0131n ve finansal g\u00fcvenlik olu\u015fturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6295\u8d44\u672a\u6765\uff0c\u5efa\u7acb\u8d22\u52a1\u5b89\u5168\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6295\u8cc7\u60a8\u7684\u672a\u4f86\u4e26\u5efa\u7acb\u8ca1\u52d9\u5b89\u5168\u3002"
          }
        }
      }
    },
    "plant.mangrove.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4lt auch in St\u00fcrmen stand \u2013 Resilienz & Stressabbau"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stands firm even in storms \u2013 Resilience & Stress relief"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firme incluso en tormentas \u2013 Resiliencia y alivio del estr\u00e9s"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient bon m\u00eame dans les temp\u00eates \u2013 R\u00e9silience & gestion du stress"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0942\u092b\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u092d\u0940 \u0915\u093e\u092f\u092e \u0930\u0939\u0924\u093e \u0939\u0948 \u2013 \u0932\u091a\u0940\u0932\u093e\u092a\u0928 \u0914\u0930 \u0924\u0928\u093e\u0935 \u0915\u092e \u0915\u0930\u0928\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stands firm even in storms \u2013 Resilience & Stress relief"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5d50\u306e\u4e2d\u3067\u3082\u3057\u3063\u304b\u308a\u3068\u7acb\u3064 \u2013 \u56de\u5fa9\u529b\u3068\u30b9\u30c8\u30ec\u30b9\u8efd\u6e1b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3ed\ud48d \uc18d\uc5d0\uc11c\ub3c4 \uad73\uac74\ud788 \uc11c\uc788\uc2b5\ub2c8\ub2e4 \u2013 \ud68c\ubcf5\ub825 \ubc0f \uc2a4\ud2b8\ub808\uc2a4 \uc644\ud654"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat stevig, zelfs bij storm \u2013 veerkracht en stressverlichting"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytrzymuje stabilnie nawet podczas burzy \u2013 odporno\u015b\u0107 i redukcja napr\u0119\u017ce\u0144"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9m-se firme mesmo em tempestades \u2013 Resili\u00eancia & al\u00edvio do stress"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0448\u0442\u043e\u0440\u043c\u044b \u2013 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c \u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u0442\u0440\u0435\u0441\u0441\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u0131rt\u0131nalarda bile sa\u011flam durur \u2013 Dayan\u0131kl\u0131l\u0131k ve Stres Giderme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u98ce\u66b4\u4e2d\u4e5f\u80fd\u5c79\u7acb\u4e0d\u5012 \u2013 \u97e7\u6027\u4e0e\u51cf\u538b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u80fd\u5920\u62b5\u79a6\u98a8\u66b4\uff0d\u5fa9\u539f\u529b\u548c\u7de9\u89e3\u58d3\u529b"
          }
        }
      }
    },

    "plant.thymian.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein, unscheinbar, aber immer da \u2013 Konsequenz & Routine"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small, inconspicuous, but always there \u2013 Consistency & Routine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peque\u00f1o, discreto, pero siempre presente \u2013 Constancia y Rutina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit, discret, mais toujours pr\u00e9sent \u2013 Constance & Routine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u094b\u091f\u093e, \u0938\u093e\u0927\u093e\u0930\u0923, \u0932\u0947\u0915\u093f\u0928 \u0939\u092e\u0947\u0936\u093e \u092e\u094c\u091c\u0942\u0926 \u2013 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a\u0924\u093e \u0914\u0930 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Small, inconspicuous, but always there \u2013 Consistency & Routine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u3055\u304f\u3066\u76ee\u7acb\u305f\u306a\u3044\u304c\u3001\u5e38\u306b\u305d\u3053\u306b\u3042\u308b - \u4e00\u8cab\u6027\u3068\u65e5\u5e38\u6027"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc791\uace0 \ub208\uc5d0 \ub744\uc9c0 \uc54a\uc9c0\ub9cc \ud56d\uc0c1 \uc874\uc7ac\ud569\ub2c8\ub2e4 \u2013 \uc77c\uad00\uc131 \ubc0f \ub8e8\ud2f4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein, onopvallend, maar altijd aanwezig \u2013 Consistentie & Routine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u0142y, niepozorny, ale zawsze obecny \u2013 Konsekwencja i rutyna"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno, discreto, mas sempre presente \u2013 Consist\u00eancia & Rotina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439, \u043d\u0435\u043f\u0440\u0438\u043c\u0435\u0442\u043d\u044b\u0439, \u043d\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u2013 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0440\u0443\u0442\u0438\u043d\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00fc\u00e7\u00fck, g\u00f6ze \u00e7arpmayan ama her zaman orada \u2013 Tutarl\u0131l\u0131k ve Rutin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u5de7\u3001\u4e0d\u8d77\u773c\uff0c\u4f46\u59cb\u7ec8\u5b58\u5728 \u2013 \u575a\u6301\u4e0e\u89c4\u5f8b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u3001\u4e0d\u986f\u773c\uff0c\u4f46\u59cb\u7d42\u5b58\u5728\uff0d\u4e00\u81f4\u6027\u548c\u5e38\u898f"
          }
        }
      }
    },
    "plant.walnussbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Harte Schale, wertvoller Kern \u2013 Weiterbildung & Kurse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard shell, valuable core \u2013 Further education & Courses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1scara dura, n\u00facleo valioso \u2013 Formaci\u00f3n continua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coque dure, noyau pr\u00e9cieux \u2013 Formation continue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0920\u094b\u0930 \u0916\u094b\u0932, \u092e\u0942\u0932\u094d\u092f\u0935\u093e\u0928 \u0905\u0902\u0926\u0930 \u2013 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0914\u0930 \u092a\u093e\u0920\u094d\u092f\u0915\u094d\u0930\u092e"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard shell, valuable core \u2013 Further education & Courses"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30cf\u30fc\u30c9\u30b7\u30a7\u30eb\u3001\u8cb4\u91cd\u306a\u30b3\u30a2 \u2013 \u3055\u3089\u306a\u308b\u6559\u80b2\u3068\u30b3\u30fc\u30b9"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e8\ub2e8\ud55c \uaecd\uc9c8, \uadc0\uc911\ud55c \ud575\uc2ec \u2013 \ucd94\uac00 \uad50\uc721 \ubc0f \uacfc\uc815"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Harde schaal, waardevolle kern \u2013 Bijscholing & Cursussen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twarda skorupa, cenny rdze\u0144 \u2013 dalsza edukacja i kursy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Casca dura, n\u00facleo valioso \u2013 Forma\u00e7\u00e3o cont\u00ednua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u0451\u0440\u0434\u0430\u044f \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0430, \u0446\u0435\u043d\u043d\u043e\u0435 \u044f\u0434\u0440\u043e \u2013 \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u0435 \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0438 \u043a\u0443\u0440\u0441\u044b"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert kabuk, de\u011ferli \u00e7ekirdek \u2013 \u0130leri E\u011fitim ve Kurslar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u575a\u786c\u7684\u5916\u58f3\uff0c\u73cd\u8d35\u7684\u5185\u6838 \u2013 \u8fdb\u4fee\u4e0e\u8bfe\u7a0b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5805\u786c\u7684\u5916\u6bbc\uff0c\u5bf6\u8cb4\u7684\u6838\u5fc3\u2014\u9032\u4e00\u6b65\u7684\u8a13\u7df4\u548c\u8ab2\u7a0b"
          }
        }
      }
    },

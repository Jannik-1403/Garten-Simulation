    "plant.orchidee.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten, fragil, aber wunderschön wenn gepflegt – Kunst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, but beautiful when cared for – Art"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, frágil, pero bella con cuidado – Arte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, mais magnifique quand soignée – Art"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, but beautiful when cared for – Art"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希少で壊れやすいが、大切に扱うと美しい – アート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "희귀하고 깨지기 쉬우나 관리하면 아름다운 – 예술"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeldzaam, kwetsbaar, maar mooi als je er voor zorgt – Art"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzadkie, delikatne, ale piękne, gdy się o nie dba – Art"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, frágil, mas bela quando cuidada – Arte"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadir, kırılgan ama bakım yapıldığında güzel - Sanat"
          }
        }
      }
    },

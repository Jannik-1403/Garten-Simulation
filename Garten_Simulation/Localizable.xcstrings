    "notification.wait.1.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon %d Stunden ohne Pflege. Schau doch kurz im Garten vorbei!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already %d hours without care. Just drop by the garden briefly!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya van %d horas sin cuidados. \u00a1Pasa un momento por el jard\u00edn!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9j\u00e0 %d heures sans soins. Fais un petit tour dans le jardin !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u092a\u0930\u0935\u093e\u0939 \u0915\u0947 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940%d\u0918\u0902\u091f\u0947\u0964 \u092c\u0917\u0940\u091a\u0947 \u092a\u0930 \u090f\u0915 \u0928\u091c\u093c\u0930 \u0921\u093e\u0932\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u00e0 %d ore senza cure. Fai un salto nel giardino!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c17\u306b\u305b\u305a\u306b\u3059\u3067\u306b %d \u6642\u9593\u7d4c\u904e\u3057\u3066\u3044\u307e\u3059\u3002\u305c\u3072\u3061\u3087\u3063\u3068\u304a\u5ead\u306b\u304a\u7acb\u3061\u5bc4\u308a\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubbf8 %d\uc2dc\uac04 \ub3d9\uc548 \uc2e0\uacbd \uc4f0\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc7a0\uc2dc \uc815\uc6d0\uc5d0 \ub4e4\ub7ec\ubcf4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al %d uur zonder zorg. Kom gewoon even langs in de tuin!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju\u017c %d godzin bez opieki. Wpadnij na chwil\u0119 do ogrodu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 %d horas sem cuidados. D\u00e1 um salto ao jardim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0436\u0435%d\u0447\u0430\u0441\u043e\u0432 \u0431\u0435\u0437 \u0443\u0445\u043e\u0434\u0430. \u0417\u0430\u0433\u043b\u044f\u043d\u0438-\u043a\u0430 \u043d\u0435\u043d\u0430\u0434\u043e\u043b\u0433\u043e \u0432 \u0441\u0430\u0434!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten %d saat bak\u0131ms\u0131z kald\u0131m. K\u0131sa bir s\u00fcreli\u011fine bah\u00e7eye u\u011framan\u0131z yeterli!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u7ecf %d \u5c0f\u65f6\u6ca1\u6709\u7167\u6599\u4e86\u3002\u5feb\u53bb\u82b1\u56ed\u770b\u770b\u5427\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u7d93%d\u5c0f\u6642\u7121\u8b77\u7406\u3002\u5feb\u901f\u700f\u89bd\u4e00\u4e0b\u82b1\u5712\uff01"
          }
        }
      }
    },
    "notification.wait.1.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vermisst dich!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ misses you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1%@ te echa de menos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'ennuie de toi !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u0906\u092a\u0915\u094b \u092f\u093e\u0926 \u0915\u0930\u0924\u093e \u0939\u0948!"
          }
        },
        "it": {

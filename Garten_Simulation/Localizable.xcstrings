    "item.zauberstab.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und l\u00e4sst Unkraut wie von Geisterhand verschwinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and makes weeds disappear as if by magic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa de inmediato y hace desaparecer las malas hierbas como por arte de magia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\\'active imm\u00e9diatement et fait dispara\u00eetre les mauvaises herbes comme par enchantement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0930\u0902\u0924 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0916\u0930-\u092a\u0924\u0935\u093e\u0930 \u0915\u094b \u091c\u093e\u0926\u0942 \u0915\u0940 \u0924\u0930\u0939 \u0917\u093e\u092f\u092c \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si attiva immediatamente e fa sparire le erbacce come per magia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u6d3b\u6027\u5316\u3057\u3066\u3001\u307e\u308b\u3067\u9b54\u6cd5\u306e\u3088\u3046\u306b\u96d1\u8349\u3092\u6d88\u3057\u53bb\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uc5b4 \ub9c8\ubc95\ucc98\ub7fc \uc7a1\ucd08\ub97c \uc0ac\ub77c\uc9c0\uac8c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt direct actief en laat onkruid als bij toverslag verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast staje si\u0119 aktywny i sprawia, \u017ce \u200b\u200bchwasty znikaj\u0105 jak za dotkni\u0119ciem czarodziejskiej r\u00f3\u017cd\u017cki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e faz as ervas daninhas desaparecer como por magia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0441\u0440\u0430\u0437\u0443 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u0440\u043d\u044f\u043a\u0438 \u0438\u0441\u0447\u0435\u0437\u0430\u0442\u044c, \u043a\u0430\u043a \u0440\u0443\u043a\u043e\u0439 \u0441\u043d\u044f\u043b\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve yabani otlar\u0131n sanki sihirli bir de\u011fnekmi\u015f gibi yok olmas\u0131n\u0131 sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u8ba9\u6742\u8349\u50cf\u88ab\u9b54\u6cd5\u822c\u6d88\u5931\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u8b8a\u5f97\u6d3b\u8e8d\uff0c\u4f7f\u96dc\u8349\u795e\u5947\u5730\u6d88\u5931\u3002"
          }
        }
      }
    },
    "item.zeitkapsel.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Friert eine Pflanze ein \u2013 kein Verfall f\u00fcr 3 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freezes a plant \u2013 no decay for 3 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela una planta \u2013 sin deterioro durante 3 d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e8le une plante \u2013 pas de d\u00e9gradation pendant 3 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092a\u094c\u0927\u0947 \u0915\u094b \u091c\u092e\u093e \u0926\u0947\u0924\u093e \u0939\u0948 - 3 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0915\u094b\u0908 \u0915\u094d\u0937\u092f \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Freezes a plant \u2013 no decay for 3 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u3092\u51cd\u7d50\u3057\u307e\u3059 \u2013 3\u65e5\u9593\u8150\u6557\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dd\ubb3c\uc744 \uc5bc\ub9ac\uba74 3\uc77c \ub3d9\uc548 \ubd80\ud328\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevriest een plant \u2013 geen verval gedurende 3 dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamra\u017ca ro\u015blin\u0119 \u2013 brak rozk\u0142adu przez 3 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela uma planta \u2013 sem degrada\u00e7\u00e3o durante 3 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0441\u043b\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0437\u0430\u043c\u0435\u0440\u0437\u0430\u0435\u0442 \u2013 \u0437\u0430\u043f\u0440\u0435\u0442 \u043d\u0430 \u0443\u0432\u044f\u0434\u0430\u043d\u0438\u0435 \u043d\u0430 3 \u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bitkiyi dondurur \u2013 3 g\u00fcn boyunca \u00e7\u00fcr\u00fcme olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51bb\u7ed3\u4e00\u682a\u690d\u7269 \u2013 3\u5929\u5185\u4e0d\u4f1a\u67af\u840e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u51b7\u51cd\u690d\u7269 - 3 \u5929\u5167\u4e0d\u8150\u721b\u3002"
          }
        }
      }
    },

            "value": "冰沙或湯"
          }
        }
      }
    },
    "prog_nutrition_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasche und schneide schon heute Gemüse für die kommenden Tage vor (z.B. Paprika in Dosen in den Kühlschrank)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wash and pre-cut vegetables today for the coming days (e.g. put canned peppers in the fridge)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave y precorte las verduras de hoy para los próximos días (por ejemplo, guarde los pimientos enlatados en el frigorífico)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavez et pré-coupez les légumes aujourd'hui pour les jours à venir (par exemple, mettez les poivrons en conserve au réfrigérateur)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आने वाले दिनों के लिए सब्जियाँ आज ही धोएं और पहले से काट लें (उदाहरण के लिए डिब्बाबंद मिर्च को फ्रिज में रखें)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavate e pretagliate oggi le verdure per i prossimi giorni (ad esempio mettete in frigo i peperoni in scatola)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、今後数日のために野菜を洗ってあらかじめカットしておきます（たとえば、ピーマンの缶詰を冷蔵庫に入れておくなど）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 며칠 동안 사용할 야채를 오늘 씻어서 미리 자르세요(예: 통조림 고추를 냉장고에 넣기)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag de groenten wassen en voorsnijden voor de komende dagen (zet bijvoorbeeld paprika uit blik in de koelkast)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś umyj i pokrój warzywa na kolejne dni (np. włóż paprykę konserwową do lodówki)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave e pré-corte os vegetais hoje para os próximos dias (por exemplo, coloque pimentões enlatados na geladeira)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lave e pré-corte os vegetais hoje para os próximos dias (por exemplo, coloque pimentões enlatados na geladeira)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня вымойте и нарежьте овощи на ближайшие дни (например, положите консервированный перец в холодильник)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki günler için sebzeleri bugün yıkayın ve önceden kesin (örneğin konserve biberleri buzdolabına koyun)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天清洗并预先切好未来几天的蔬菜（例如，将罐装辣椒放入冰箱）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天清洗並預先切好未來幾天的蔬菜（例如，將罐裝辣椒放入冰箱）。"
          }
        }
      }
    },

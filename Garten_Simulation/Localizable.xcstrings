    "pfad_activation_belohnung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlie\u00dfe die 90 Tage ab, um 5.000 M\u00fcnzen zu erhalten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the 90 days to receive 5,000 coins!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Completa los 90 d\u00edas para recibir 5.000 monedas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine les 90 jours pour recevoir 5 000 pi\u00e8ces !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5,000 \u0938\u093f\u0915\u094d\u0915\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 90 \u0926\u093f\u0928 \u092a\u0942\u0930\u0947 \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa i 90 giorni per ricevere 5.000 monete!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90 \u65e5\u9593\u3092\u5b8c\u4e86\u3059\u308b\u3068 5,000 \u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "90\uc77c\uc744 \uc644\ub8cc\ud558\uace0 5,000\ucf54\uc778\uc744 \ubc1b\uc73c\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi de 90 dagen om 5.000 munten te ontvangen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uko\u0144cz 90 dni, aby otrzyma\u0107 5000 monet!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui os 90 dias para receber 5.000 moedas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0435\u0440\u0448\u0438 90 \u0434\u043d\u0435\u0439, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c 5.000 \u043c\u043e\u043d\u0435\u0442!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5.000 jeton kazanmak i\u00e7in 90 g\u00fcn\u00fc tamamlay\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u621090\u5929\u5373\u53ef\u83b7\u5f975,000\u679a\u786c\u5e01\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odłóż telefon i uwolnij umysł od ciągłych bodźców."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

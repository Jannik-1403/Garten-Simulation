        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajudantes zumbidores para a poliniza\u00e7\u00e3o. (+1 moeda)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0416\u0443\u0436\u0436\u0430\u0449\u0438\u0435 \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u0438 \u0434\u043b\u044f \u043e\u043f\u044b\u043b\u0435\u043d\u0438\u044f. (+1 \u043c\u043e\u043d\u0435\u0442\u0430)"

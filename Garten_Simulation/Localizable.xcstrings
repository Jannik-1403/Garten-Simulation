    "plant.ingwerpflanze.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scharfe Alternative, natürliche Energie – Kein Koffein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharp alternative, natural energy – No caffeine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa picante, energía natural – Sin cafeína"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative épicée, énergie naturelle – Sans caféine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीक्ष्ण विकल्प, प्राकृतिक ऊर्जा – कोई कैफीन नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa piccante, energia naturale – senza caffeina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャープな代替自然エネルギー – ノンカフェイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날카로운 대안, 자연 에너지 – 카페인 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scherp alternatief, natuurlijke energie – Geen cafeïne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostra alternatywa, naturalna energia – Bez kofeiny"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa picante, energia natural – Sem cafeína"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa picante, energia natural – Sem cafeína"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Острая альтернатива, естественная энергия – Без кофеина"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskin alternatif, doğal enerji – Kafeinsiz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辛辣替代品，天然能量 – 不含咖啡因"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辛辣替代品，天然能量－不含咖啡因"
          }
        }
      }
    },

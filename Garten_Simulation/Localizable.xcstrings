    "trash.couch_abo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Sportschuhe sichtbar bereit – sie erinnern dich täglich ans Bewegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your sports shoes out visibly – they remind you to move every day."

    "assessment.mental.profile.glaeserner.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brichst unter Druck schnell zusammen. Anstatt mit Widerständen umzugehen, gibst du auf oder flüchtest dich in Ausreden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You quickly collapse under pressure. Instead of dealing with resistance, you give up or take refuge in excuses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápidamente colapsas bajo presión. En lugar de enfrentar la resistencia, te rindes o te refugias en excusas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous effondrez rapidement sous la pression. Au lieu de faire face à la résistance, vous abandonnez ou vous réfugiez dans des excuses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crolli rapidamente sotto pressione. Invece di affrontare la resistenza, ti arrendi o ti rifugi nelle scuse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレッシャーですぐに倒れてしまいます。抵抗に対処する代わりに、あきらめたり、言い訳に逃げたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압박감에 빨리 무너집니다. 저항에 대처하는 대신 핑계로 포기하거나 도피합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bezwijkt snel onder druk. In plaats van met weerstand om te gaan, geef je het op of zoek je je toevlucht in excuses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybko upadasz pod presją. Zamiast stawić czoła oporowi, poddajesz się lub szukasz wymówek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você desmaia rapidamente sob pressão. Em vez de lidar com a resistência, você desiste ou se refugia em desculpas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baskı altında hızla çökersiniz. Dirençle uğraşmak yerine pes edersiniz ya da bahanelere sığınırsınız."
          }
        }
      }
    },

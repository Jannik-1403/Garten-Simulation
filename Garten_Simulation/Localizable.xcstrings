          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbuduj w swój dzień drobne rytuały wellness (np. czytanie, relaksująca muzyka)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora pequenos rituais de bem-estar no teu dia (ex. ler, música relaxante)."
          }
        },
        "tr": {
          "stringUnit": {

    "cleaning.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Aufgabe wirklich löschen? Die bisherigen Daten bleiben anonymisiert erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to delete this task? Past data will be kept anonymously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar esta tarea? Los datos anteriores se conservarán de forma anónima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer cette tâche ? Les données passées seront conservées anonymement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस कार्य को हटाना चाहते हैं? पिछला डेटा गुमनाम रूप से रखा जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare questa attività? I dati precedenti verranno mantenuti in modo anonimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当にこのタスクを削除しますか？ 過去のデータは匿名で保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 정말 삭제하시겠습니까? 과거 데이터는 익명으로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze taak wilt verwijderen? Eerdere gegevens blijven anoniem bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć to zadanie? Dotychczasowe dane zostaną zachowane anonimowo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir esta tarefa? Os dados anteriores serão mantidos anonimamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir esta tarefa? Os dados anteriores serão mantidos anonimamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите удалить эту задачу? Предыдущие данные будут сохранены анонимно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görevi gerçekten silmek istiyor musunuz? Geçmiş veriler anonim olarak saklanacaktır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您真的要删除此任务吗？过去的数据将匿名保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您真的要刪除此任務嗎？過去的數據將匿名保留。"
          }
        }
      }
    },

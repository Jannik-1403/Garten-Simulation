    "stats.coach.bullet1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichgewicht: Versuche, alle Lebensbereiche gleichmäßig zu pflegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance: Try to nurture all life areas equally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio: Intenta cultivar todas las áreas de la vida por igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibre: Essaie de cultiver tous les aspects de ta vie de manière égale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संतुलन: प्रयास करें कि जीवन के सभी क्षेत्रों की समान रूप से देखभाल की जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio: Cerca di coltivare tutte le aree della vita in modo uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バランス：すべての生活領域を平等に育むように努めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균형: 모든 삶의 영역을 동등하게 육성하려고 노력하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans: Probeer alle levensgebieden in gelijke mate te koesteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Równowaga: Staraj się jednakowo pielęgnować wszystkie obszary życia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilíbrio: Tenta cultivar todas as áreas da vida igualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilíbrio: Tenta cultivar todas as áreas da vida igualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Равновесие: Старайтесь заботиться обо всех сферах жизни равномерно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denge: Yaşamın tüm alanlarını eşit şekilde beslemeye çalışın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡：尝试在生活的各个方面保持同等的关注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡：嘗試在生活的各個方面保持同等的關注。"
          }
        }
      }
    },
    "stats.coach.bullet2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontinuität: Tägliche kleine Schritte führen zu großem Erfolg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency: Daily small steps lead to great success."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistencia: Los pequeños pasos diarios llevan a un gran éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régularité: De petits pas quotidiens mènent à un grand succès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सततता: दैनिक छोटे-छोटे कदम बड़े सफलता की ओर ले जाते हैं।"

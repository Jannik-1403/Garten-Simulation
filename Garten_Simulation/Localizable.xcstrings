    "onboarding_willkommen_untertitel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue Gewohnheiten auf, die wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build habits that grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea h\u00e1bitos que crezcan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cr\u00e9e des habitudes qui grandissent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0910\u0938\u0940 \u0906\u0926\u0924\u0947\u0902 \u092c\u0928\u093e\u090f\u0901 \u091c\u094b \u0935\u093f\u0915\u0938\u093f\u0924 \u0939\u094b\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Build habits that grow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6210\u9577\u3059\u308b\u7fd2\u6163\u3092\u7bc9\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc131\uc7a5\ud558\ub294 \uc2b5\uad00\uc744 \uae38\ub7ec\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontwikkel gewoonten die groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj nawyki, kt\u00f3re rosn\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria h\u00e1bitos que cres\u00e7am."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0441\u0442\u0443\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcy\u00fcyen al\u0131\u015fkanl\u0131klar olu\u015fturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f9\u517b\u6210\u957f\u7684\u4e60\u60ef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u990a\u6210\u6210\u9577\u7684\u7fd2\u6163\u3002"
          }
        }
      }
    },
    "onboarding_xp_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jedem Gie\u00dfen sammelst du XP. Deine Pflanzen wachsen von Bronze bis Diamant!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With every watering, you collect XP. Your plants grow from Bronze to Diamond!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cada riego, coleccionas XP. \u00a1Tus plantas crecen de bronce a diamante!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c0 chaque arrosage, tu collectes de l'XP. Tes plantes poussent de Bronze \u00e0 Diamant !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u092c\u093e\u0930 \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a \u090f\u0915\u094d\u0938\u092a\u0940 \u0907\u0915\u091f\u094d\u0920\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u092a\u094c\u0927\u0947 \u0915\u093e\u0902\u0938\u0947 \u0938\u0947 \u0939\u0940\u0930\u0947 \u0924\u0915 \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "With every watering, you collect XP. Your plants grow from Bronze to Diamond!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c34\u3084\u308a\u3092\u3059\u308b\u305f\u3073\u306bXP\u304c\u96c6\u307e\u308a\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u690d\u7269\u306f\u30d6\u30ed\u30f3\u30ba\u304b\u3089\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u307e\u3067\u6210\u9577\u3057\u307e\u3059!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb3c\uc744 \uc904 \ub54c\ub9c8\ub2e4 XP\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc2dd\ubb3c\uc740 \ube0c\ub860\uc988\uc5d0\uc11c \ub2e4\uc774\uc544\ubaac\ub4dc\ub85c \uc131\uc7a5\ud569\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met elke bewatering verzamel je XP. Jouw planten groeien van Brons naar Diamant!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z ka\u017cdym podlaniem zbierasz XP. Twoje ro\u015bliny rosn\u0105 od br\u0105zu do diamentu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com cada rega, recolhes XP. As tuas plantas crescem de Bronze a Diamante!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421 \u043a\u0430\u0436\u0434\u044b\u043c \u043f\u043e\u043b\u0438\u0432\u043e\u043c \u0432\u044b \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0435 XP. \u0412\u0430\u0448\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0443\u0442 \u043e\u0442 \u0431\u0440\u043e\u043d\u0437\u044b \u0434\u043e \u0430\u043b\u043c\u0430\u0437\u0430!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sulamada XP toplars\u0131n\u0131z. Bitkileriniz Bronz'dan Elmas'a kadar b\u00fcy\u00fcyor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u6d47\u6c34\u4f60\u90fd\u4f1a\u6536\u96c6\u7ecf\u9a8c\u503c\u3002\u4f60\u7684\u690d\u7269\u4f1a\u4ece\u9752\u94dc\u7ea7\u6210\u957f\u5230\u94bb\u77f3\u7ea7\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u6f86\u6c34\u4f60\u90fd\u6703\u6536\u96c6\u7d93\u9a57\u503c\u3002\u4f60\u7684\u690d\u7269\u5f9e\u9752\u9285\u6210\u9577\u70ba\u947d\u77f3\uff01"
          }
        }
      }
    },
    "onboarding_zeit_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann m\u00f6chtest du deine Gewohnheiten erledigen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you want to do your habits?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfCu\u00e1ndo quieres realizar tus h\u00e1bitos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand veux-tu accomplir tes habitudes ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u0940 \u0906\u0926\u0924\u0947\u0902 \u0915\u092c \u092a\u0942\u0930\u0940 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you want to do your habits?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7fd2\u6163\u3092\u3044\u3064\u5b9f\u884c\u3057\u305f\u3044\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2b5\uad00\uc744 \uc5b8\uc81c \ud558\uace0 \uc2f6\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer wil je je gewoontes uitvoeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy chcesz wprowadzi\u0107 swoje nawyki?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando queres realizar os teus h\u00e1bitos?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0445\u043e\u0447\u0435\u0448\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0441\u0432\u043e\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Al\u0131\u015fkanl\u0131klar\u0131n\u0131z\u0131 ne zaman yapmak istiyorsunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5e0c\u671b\u4f55\u65f6\u5b8c\u6210\u4f60\u7684\u4e60\u60ef\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u60f3\u4ec0\u9ebc\u6642\u5019\u5b8c\u6210\u4f60\u7684\u7fd2\u6163\uff1f"
          }
        }
      }
    },
    "onboarding_zeit_blase_personal": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann m\u00f6chtest du an %@ erinnert werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you want to be reminded of %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfCu\u00e1ndo quieres que se te recuerde %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand veux-tu qu'on te rappelle %@ ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0915\u092c%@\u0915\u0940 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "When do you want to be reminded of %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3044\u3064 %@ \u3092\u601d\u3044\u51fa\u3055\u305b\u305f\u3044\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc5d0 \ub300\ud574 \uc5b8\uc81c \uc54c\ub9bc\uc744 \ubc1b\uace0 \uc2f6\uc73c\uc2e0\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer wil je herinnerd worden aan %@?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy chcesz otrzyma\u0107 przypomnienie o %@?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando queres ser lembrado de %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0433\u0434\u0430 \u0442\u044b \u0445\u043e\u0447\u0435\u0448\u044c, \u0447\u0442\u043e\u0431\u044b \u0442\u0435\u0431\u044f \u043d\u0430\u043f\u043e\u043c\u043d\u0438\u043b\u0438 \u043e%@?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'\u0131n ne zaman hat\u0131rlat\u0131lmas\u0131n\u0131 istiyorsunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5e0c\u671b\u4f55\u65f6\u6536\u5230\u5173\u4e8e%@\u7684\u63d0\u9192\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5e0c\u671b\u4f55\u6642\u6536\u5230%@\u63d0\u9192\uff1f"
          }
        }
      }
    },
    "onboarding_zeit_erklaerung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst t\u00e4glich eine Erinnerung zu dieser Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will receive a daily reminder at this time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibir\u00e1s un recordatorio diario a esta hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recevras un rappel quotidien \u00e0 cette heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u094b \u0907\u0938 \u0938\u092e\u092f \u0915\u093e \u0926\u0948\u0928\u093f\u0915 \u0905\u0928\u0941\u0938\u094d\u092e\u093e\u0930\u0915 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "You will receive a daily reminder at this time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u6642\u70b9\u3067\u6bce\u65e5\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u304c\u5c4a\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ub54c \ub9e4\uc77c \uc54c\ub9bc\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U ontvangt op dit moment dagelijks een herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O tej porze b\u0119dziesz otrzymywa\u0107 codzienne przypomnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Receber\u00e1s um lembrete di\u00e1rio a esta hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eu anda g\u00fcnl\u00fck bir hat\u0131rlatma alacaks\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6bcf\u5929\u90fd\u4f1a\u5728\u8fd9\u4e2a\u65f6\u95f4\u6536\u5230\u63d0\u9192\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5c07\u6536\u5230\u6709\u95dc\u8a72\u6642\u9593\u7684\u6bcf\u65e5\u63d0\u9192\u3002"
          }
        }
      }
    },

    "assessment.source.lif.q_env": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfeld-Fragen: Wer umgibt dich, welchen Einfluss haben sie?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfeld-Fragen: Wer umgibt dich, welchen Einfluss haben sie?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuestiones medioambientales: ¿Quiénes te rodean, qué influencia tienen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions environnementales : Qui vous entoure, quelle influence ont-ils ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवेश प्रश्न: आपके आसपास कौन है, उनका क्या प्रभाव है?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande sull'ambiente: Chi ti circonda, quale influenza hanno?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境に関する質問: あなたの周りには誰がいますか? 彼らはどのような影響を与えていますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 질문: 누가 당신을 둘러싸고 있고, 그들의 영향은 무엇인가?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgevingsvragen: Wie omringt je, welke invloed hebben ze?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania o otoczenie: Kto cię otacza, jaki mają wpływ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Questões de ambiente: Quem te rodeia, que influência têm?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Questões de ambiente: Quem te rodeia, que influência têm?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экологические вопросы: Кто вас окружает, какое влияние они оказывают?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevresel sorular: Sizi kim çevreliyor, ne gibi etkileri var?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境问题：谁围绕着你，他们有什么影响？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境問題：你周遭有哪些人，他們有什麼影響？"
          }
        }
      }
    },
    "assessment.source.lif.q_inf": {

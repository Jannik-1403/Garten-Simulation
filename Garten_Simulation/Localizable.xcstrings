          "stringUnit": {
            "state": "translated",
            "value": "Was genau möchtest du in deiner Fokus-Zeit schaffen? Nimm dir einen Moment, um dich zu fokussieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What exactly do you want to accomplish in your focus time? Take a moment to focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres lograr exactamente en tu tiempo de enfoque? Tómate un momento para enfocarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que voulez-vous accomplir exactement pendant votre temps de concentration ? Prenez un moment pour vous concentrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi realizzare esattamente nel tuo tempo di concentrazione? Prenditi un momento per concentrarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中する時間に具体的に何を達成したいですか?少し時間を取って集中してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중하는 시간에 정확히 무엇을 성취하고 싶나요? 잠시 집중할 시간을 가지세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je precies bereiken in je focustijd? Neem een ​​moment om je te concentreren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co dokładnie chcesz osiągnąć w swoim czasie skupienia? Poświęć chwilę na skupienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que deseja exatamente realizar no seu tempo de foco? Reserve um momento para se concentrar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanma sürenizde tam olarak neyi başarmak istiyorsunuz? Odaklanmak için bir dakikanızı ayırın."
          }
        }
      }
    },

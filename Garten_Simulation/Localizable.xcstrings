    "weather.rule.sturm": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sturm: Wenn eine Pflanze stirbt, verlierst du 2 Leben statt 1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storm: If a plant dies, you lose 2 lives instead of 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tormenta: Si una planta muere, pierdes 2 vidas en lugar de 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temp\u00eate : Si une plante meurt, tu perds 2 vies au lieu d'une."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0942\u092b\u093c\u093e\u0928: \u091c\u092c \u0915\u094b\u0908 \u092a\u094c\u0927\u093e \u092e\u0930\u0924\u093e \u0939\u0948, \u0924\u094b \u0906\u092a 1 \u0915\u0947 \u092c\u091c\u093e\u092f 2 \u091c\u0940\u0935\u0928 \u0916\u094b \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Storm: If a plant dies, you lose 2 lives instead of 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30fc\u30e0: \u690d\u7269\u304c\u67af\u308c\u308b\u3068\u3001\u30e9\u30a4\u30d5\u306f 1 \u3067\u306f\u306a\u304f 2 \u5931\u308f\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3ed\ud48d: \uc2dd\ubb3c\uc774 \uc8fd\uc73c\uba74 \uc0dd\uba85 1\uac1c\uac00 \uc544\ub2cc 2\uac1c\ub97c \uc783\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Storm: Als een plant sterft, verlies je 2 levens in plaats van 1."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Burza: Je\u015bli ro\u015blina zginie, tracisz 2 \u017cycia zamiast 1."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempestade: Se uma planta morrer, perdes 2 vidas em vez de 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0442\u043e\u0440\u043c: \u041a\u043e\u0433\u0434\u0430 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435 \u0443\u043c\u0438\u0440\u0430\u0435\u0442, \u0432\u044b \u0442\u0435\u0440\u044f\u0435\u0442\u0435 2 \u0436\u0438\u0437\u043d\u0438 \u0432\u043c\u0435\u0441\u0442\u043e 1."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u0131rt\u0131na: Bir bitki \u00f6l\u00fcrse 1 yerine 2 can kaybedersiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u98ce\u66b4\uff1a\u5f53\u4e00\u682a\u690d\u7269\u6b7b\u4ea1\u65f6\uff0c\u4f60\u4f1a\u5931\u53bb 2 \u6761\u751f\u547d\uff0c\u800c\u4e0d\u662f 1 \u6761\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u98a8\u66b4\uff1a\u7576\u4e00\u682a\u690d\u7269\u6b7b\u4ea1\u6642\uff0c\u4f60\u6703\u5931\u53bb 2 \u689d\u751f\u547d\uff0c\u800c\u4e0d\u662f 1 \u689d\u3002"
          }
        }
      }
    },

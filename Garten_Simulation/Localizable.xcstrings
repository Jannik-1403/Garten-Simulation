    "data.load.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Daten konnten nicht gelesen werden. Sie werden nicht ersetzt. Versuche es erneut oder sichere eine Wiederherstellungskopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved data could not be read. It will not be replaced. Try again or save a recovery copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer tus datos guardados. No se sustituirán. Inténtalo de nuevo o guarda una copia de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données enregistrées n’ont pas pu être lues. Elles ne seront pas remplacées. Réessayez ou enregistrez une copie de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सहेजा गया डेटा पढ़ा नहीं जा सका। उसे बदला नहीं जाएगा। फिर से कोशिश करें या रिकवरी कॉपी सहेजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere i dati salvati. Non verranno sostituiti. Riprova o salva una copia di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたデータを読み取れませんでした。データは置き換えられません。もう一度試すか、復元用のコピーを保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 데이터를 읽을 수 없습니다. 데이터는 대체되지 않습니다. 다시 시도하거나 복구용 사본을 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen gegevens konden niet worden gelezen. Ze worden niet vervangen. Probeer het opnieuw of sla een herstelkopie op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zapisanych danych. Nie zostaną zastąpione. Spróbuj ponownie lub zapisz kopię do odzyskiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os seus dados guardados. Não serão substituídos. Tente novamente ou guarde uma cópia de recuperação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler seus dados salvos. Eles não serão substituídos. Tente novamente ou salve uma cópia de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать сохранённые данные. Они не будут заменены. Повторите попытку или сохраните копию для восстановления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı verileriniz okunamadı. Veriler değiştirilmeyecek. Yeniden deneyin veya bir kurtarma kopyası kaydedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的数据。数据不会被替换。请重试或保存恢复副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的資料。資料不會被取代。請重試或儲存復原副本。"
          }
        }
      }
    },

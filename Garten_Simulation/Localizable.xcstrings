    "timer.hint.daily": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Erinnerung wiederholt sich t\u00e4glich zur eingestellten Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reminder repeats daily at the set time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recordatorio se repite diariamente a la hora establecida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rappel se r\u00e9p\u00e8te chaque jour \u00e0 l'heure d\u00e9finie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0928\u093e \u0939\u0930 \u0926\u093f\u0928 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0938\u092e\u092f \u092a\u0930 \u0926\u094b\u0939\u0930\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo promemoria si ripete ogni giorno all'ora impostata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u306f\u6bce\u65e5\u8a2d\u5b9a\u3055\u308c\u305f\u6642\u523b\u306b\u7e70\u308a\u8fd4\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc54c\ub9bc\uc740 \ub9e4\uc77c \uc124\uc815\ub41c \uc2dc\uac04\uc5d0 \ubc18\ubcf5\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze herinnering herhaalt zich dagelijks op het ingestelde tijdstip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie to powtarza si\u0119 codziennie o ustawionej godzinie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lembrete repete-se diariamente \u00e0 hora definida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442\u0441\u044f \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u0432 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hat\u0131rlatma her g\u00fcn ayarlanan saatte tekrarlan\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8be5\u63d0\u9192\u6bcf\u5929\u5728\u8bbe\u5b9a\u7684\u65f6\u95f4\u91cd\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u63d0\u9192\u6bcf\u5929\u5728\u8a2d\u5b9a\u7684\u6642\u9593\u91cd\u8907\u3002"
          }
        }
      }
    },

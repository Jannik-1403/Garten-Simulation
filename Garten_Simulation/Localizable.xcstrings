          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestelltes Essen kommt oft kalt und teuer an – und fühlt sich nie so gut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordered food often arrives cold and expensive – and never feels as good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comida pedida suele llegar fría y cara, y nunca sabe tan bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nourriture commandée arrive souvent froide et chère – et ne semble jamais aussi bonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑर्डर किया गया खाना अक्सर ठंडा और महंगा आता है – और कभी भी अच्छा महसूस नहीं कराता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cibo ordinato arriva spesso freddo e caro – e non sembra mai così buono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注文した食事は冷めていて高価なことが多く、思ったほどおいしくないことが多いです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주문한 음식은 종종 차갑고 비싸게 오며 – 결코 기대만큼 좋지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besteld eten komt vaak koud en duur aan – en voelt nooit zo goed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamawiane jedzenie często przyjeżdża zimne i drogie – i nigdy nie smakuje tak dobrze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comida pedida frequentemente chega fria e cara – e nunca é tão boa quanto parece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comida pedida frequentemente chega fria e cara – e nunca é tão boa quanto parece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказанная еда часто доставляется холодной и дорогой – и никогда не бывает такой вкусной."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sipariş edilen yemek genellikle soğuk ve pahalı gelir – ve asla beklediğin kadar iyi olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点的食物通常都是冷的而且价格昂贵——而且感觉从来没有那么好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點的食物通常都是冷的而且價格昂貴——而且感覺從來沒有那麼好。"
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche Mahlzeiten vor (Meal-Prep) für die kommende Woche."
          }
        },
        "en": {

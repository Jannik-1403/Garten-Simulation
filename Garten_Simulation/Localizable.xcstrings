    "focus.session.dnd_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dein Handy jetzt auf 'Nicht stören' und lege es nach dieser Einrichtung außer Sichtweite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your phone on 'Do Not Disturb' now and place it out of sight after this setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu teléfono en 'No Molestar' ahora y colócalo fuera de la vista después de esta configuración."
          }
        },
        "fr": {
          "stringUnit": {

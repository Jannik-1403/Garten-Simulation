    "plant.bambus.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue durch regelmäßiges Training Stärke und Widerstandskraft auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build strength and resilience through regular training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla fuerza y resistencia mediante el entrenamiento regular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez votre force et votre résilience grâce à un entraînement régulier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci forza e resilienza attraverso un allenamento regolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的なトレーニングで強さと回復力を築きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙적인 훈련을 통해 근력과 회복력을 기르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw kracht en veerkracht op door regelmatige training."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buduj siłę i odporność poprzez regularny trening."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa força e resiliência através de treinos regulares."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli eğitimle güç ve dayanıklılık oluşturun."
          }
        }
      }
    },
    "plant.basilikum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein aber intensiv im Geschmack – Bewusstes Essen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small but intense in flavor – Mindful eating"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeña pero intensa en sabor – Alimentación consciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit mais intense en saveur – Alimentation consciente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Small but intense in flavor – Mindful eating"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さいながらも濃厚な味わい – 意識して食べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작지만 강렬한 맛 – 마음챙김 식사"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein maar intens van smaak – Mindful eten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Małe, ale intensywne w smaku – Uważne jedzenie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno mas intenso em sabor – Alimentação consciente"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük ama tadı yoğun – Dikkatli yeme"

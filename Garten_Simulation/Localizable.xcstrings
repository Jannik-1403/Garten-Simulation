        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous dînez avec des amis. Vous souhaitez diviser par quatre la facture de 300 €. Vous n'aviez que de la salade et de l'eau. Votre réaction ?"

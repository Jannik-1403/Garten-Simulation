          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それは消えました - 正直に言うと、理由はわかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사라졌습니다. 솔직히 왜 그런지 잘 모르겠습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

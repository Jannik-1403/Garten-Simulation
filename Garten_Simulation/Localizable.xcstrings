    "pfad_produktiv_day_7_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane heute deine kommenden 7 Tage im Voraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan your next 7 days in advance today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica hoy tus próximos 7 días con antelación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifie aujourd'hui tes 7 prochains jours à l'avance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज ही अपने अगले 7 दिनों की योजना पहले से बना लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica oggi i tuoi prossimi 7 giorni in anticipo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日から 7 日前に次の計画を立てましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘부터 다음 7일을 미리 계획해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan vandaag nog uw volgende 7 dagen van tevoren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanuj swoje kolejne 7 dni wcześniej już dziś."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeia hoje os teus próximos 7 dias com antecedência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планируй сегодня свои предстоящие 7 дней заранее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelecek 7 gününüzü bugün önceden planlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天提前规划你未来7天的日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天就提前規劃您接下來的 7 天。"
          }
        }
      }
    },

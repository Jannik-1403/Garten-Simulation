    "paywall.feature.shop_discount.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir doppelt so schnell neue Pflanzen. Dein Erfolg wird direkt sichtbar belohnt (400 statt 800 Münzen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get new plants twice as fast. Your success is visibly rewarded right away (400 instead of 800 coins)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consigue nuevas plantas el doble de rápido. Tu éxito es recompensado visiblemente (400 en lugar de 800 monedas)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiens de nouvelles plantes deux fois plus vite. Ton succès est récompensé visiblement et immédiatement (400 au lieu de 800 pièces)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोगुनी तेजी से नये पौधे प्राप्त करें। आपकी सफलता का तुरंत और प्रत्यक्ष रूप से पुरस्कार दिया जाएगा (800 सिक्कों के बजाय 400)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni nuove piante il doppio più velocemente. Il tuo successo viene premiato visibilmente (400 invece di 800 monete)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2倍の速さで新しい植物を手に入れましょう。成功はすぐに目に見える形で報われます（800コインではなく400コイン）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 배 더 빨리 새로운 식물을 얻으세요. 성공은 즉시 눈에 띄게 보상받습니다 (800 코인 대신 400 코인)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg nieuwe planten twee keer zo snel. Jouw succes wordt direct zichtbaar beloond (400 in plaats van 800 munten)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdobądź nowe rośliny dwa razy szybciej. Twój sukces jest widocznie nagradzany (400 zamiast 800 monet)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenha novas plantas duas vezes mais rápido. Seu sucesso é recompensado visivelmente (400 em vez de 800 moedas)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте новые растения вдвое быстрее. Ваш успех будет напрямую видимо вознаграждён (400 вместо 800 монет)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bitkileri iki kat daha hızlı al. Başarın anında görünür şekilde ödüllendirilir (800 yerine 400 jeton)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取新植物的速度快两倍。您的成功将直接获得可见的奖励（400而非800硬币）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲得新植物的速度提高了一倍。您的成功將立即獲得明顯的獎勵（400 個硬幣，而不是 800 個硬幣）。"

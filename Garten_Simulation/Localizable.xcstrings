    "prog_nutrition_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Püriere deine Nährstoffe heute. Mach dir einen großen Smoothie oder eine Gemüsesuppe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puree your nutrients today. Make yourself a big smoothie or vegetable soup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga puré sus nutrientes hoy. Prepárate un gran batido o sopa de verduras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez vos nutriments en purée aujourd’hui. Préparez-vous un gros smoothie ou une soupe de légumes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज ही अपने पोषक तत्वों को शुद्ध करें। अपने लिए एक बड़ी स्मूदी या सब्जी का सूप बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frulla i tuoi nutrienti oggi stesso. Preparati un grosso frullato o una zuppa di verdure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は栄養素をピューレにしてみませんか。たっぷりのスムージーや野菜スープを作りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 영양분을 퓌레로 만드세요. 큰 스무디나 야채 수프를 만들어 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pureer vandaag nog uw voedingsstoffen. Maak voor jezelf een grote smoothie of groentesoep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już dziś przygotuj puree ze swoich składników odżywczych. Zrób sobie duży smoothie lub zupę jarzynową."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um purê de seus nutrientes hoje. Faça um grande smoothie ou sopa de legumes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um purê de seus nutrientes hoje. Faça um grande smoothie ou sopa de legumes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня сделайте пюре из своих питательных веществ. Приготовьте себе большой коктейль или овощной суп."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besinlerinizi bugün püre haline getirin. Kendinize büyük bir smoothie veya sebze çorbası yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天将你的营养物质制成泥。给自己做一杯大冰沙或蔬菜汤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天將你的營養物質製成泥狀。為自己做一杯大冰沙或蔬菜湯。"
          }
        }
      }
    },

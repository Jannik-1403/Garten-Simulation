    "tour_inventory_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier findest du all deine Samen. Außerdem kannst du hier deine ganz eigenen Pflanzen erstellen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you will find all your seeds. You can also create your very own plants here!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí encontrarás todas tus semillas. ¡También puedes crear tus propias plantas aquí!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous trouverez ici toutes vos graines. Vous pouvez également créer vos propres plantes ici !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ आपको अपने सभी बीज मिलेंगे। आप यहाँ अपने खुद के पौधे भी बना सकते हैं!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui troverai tutti i tuoi semi. Puoi anche creare le tue piante qui!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはすべての種があります。また、ここで独自の植物を作成することもできます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 모든 씨앗이 있습니다. 여기서 나만의 식물을 만들 수도 있습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier vind je al je zaden. Je kunt hier ook je eigen planten creëren!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj znajdziesz wszystkie swoje nasiona. Możesz tutaj również tworzyć własne rośliny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui você encontrará todas as suas sementes. Você também pode criar suas próprias plantas aqui!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui você encontrará todas as suas sementes. Você também pode criar suas próprias plantas aqui!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь вы найдете все свои семена. Вы также можете создавать свои собственные растения здесь!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada tüm tohumlarınızı bulacaksınız. Ayrıca burada kendi bitkilerinizi de oluşturabilirsiniz!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里你会找到所有的种子。你也可以在这里创建自己的植物！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡你會找到所有的種子。你也可以在這裡創建自己的植物！"
          }
        }
      }
    },

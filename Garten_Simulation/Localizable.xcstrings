          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige betaling. Levenslange toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u0142atno\u015b\u0107 jednorazowa. Do\u017cywotni dost\u0119p."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento \u00fanico. Acesso vital\u00edcio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0434\u0438\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u0432\u044b\u043f\u043b\u0430\u0442\u0430. \u041f\u043e\u0436\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik \u00f6deme. \u00d6m\u00fcr boyu eri\u015fim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6b21\u6027\u4ed8\u6b3e\u3002\u7ec8\u8eab\u8bbf\u95ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6b21\u4ed8\u6b3e\u3002\u7d42\u8eab\u8a2a\u554f\u3002"
          }
        }
      }
    },
    "paywall.feature.calendar.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiere deine Gewohnheiten und Timer direkt mit deinem Apple Kalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your habits and timers directly with your Apple Calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus h\u00e1bitos y temporizadores directamente con tu Calendario Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos habitudes et minuteurs directement avec votre calendrier Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0906\u0926\u0924\u094b\u0902 \u0914\u0930 \u091f\u093e\u0907\u092e\u0930\u094b\u0902 \u0915\u094b \u0938\u0940\u0927\u0947 \u0905\u092a\u0928\u0947 Apple \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u0938\u0947 \u0938\u093f\u0902\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza le tue abitudini e i tuoi timer direttamente con il tuo Calendario Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7fd2\u6163\u3084\u30bf\u30a4\u30de\u30fc\u3092Apple\u30ab\u30ec\u30f3\u30c0\u30fc\u3068\u76f4\u63a5\u540c\u671f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2b5\uad00\uacfc \ud0c0\uc774\uba38\ub97c Apple \uce98\ub9b0\ub354\uc640 \uc9c1\uc811 \ub3d9\uae30\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer je gewoonten en timers direct met je Apple-agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj swoje nawyki i timery bezpo\u015brednio z Kalendarzem Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize seus h\u00e1bitos e cron\u00f4metros diretamente com seu Calend\u00e1rio Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u0439 \u0441\u0432\u043e\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438 \u0442\u0430\u0439\u043c\u0435\u0440\u044b \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0441 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u0435\u043c Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Al\u0131\u015fkanl\u0131klar\u0131n\u0131z\u0131 ve zamanlay\u0131c\u0131lar\u0131n\u0131z\u0131 do\u011frudan Apple Takviminizle senkronize edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u60a8\u7684\u4e60\u60ef\u548c\u8ba1\u65f6\u5668\u76f4\u63a5\u540c\u6b65\u5230\u60a8\u7684Apple\u65e5\u5386\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u60a8\u7684\u7fd2\u6163\u548c\u8a08\u6642\u5668\u76f4\u63a5\u540c\u6b65\u5230\u60a8\u7684 Apple \u65e5\u66c6\u3002"
          }
        }
      }
    },

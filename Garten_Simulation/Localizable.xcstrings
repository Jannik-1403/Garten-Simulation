    "item.gartenschutz.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort aktiv: Schlechte Gewohnheiten und Belohnungen spawnen keine neuen Unkr\u00e4uter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active immediately: bad habits and rewards won't spawn new weeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo al instante: sin malas hierbas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif imm\u00e9diatement : pas de nouvelles mauvaises herbes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0930\u0902\u0924 \u0938\u0915\u094d\u0930\u093f\u092f: \u092c\u0941\u0930\u0940 \u0906\u0926\u0924\u0947\u0902 \u0914\u0930 \u092a\u0941\u0930\u0938\u094d\u0915\u093e\u0930 \u0928\u090f \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0928\u0939\u0940\u0902 \u092a\u0948\u0926\u093e \u0915\u0930\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo subito: niente nuove erbacce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u308a\u307e\u3059: \u88c5\u98fe\u3084\u5831\u916c\u306b\u3088\u3063\u3066\u65b0\u3057\u3044\u96d1\u8349\u304c\u767a\u751f\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654: \uc7a5\uc2dd\uacfc \ubcf4\uc0c1\uc73c\ub85c \uc778\ud574 \uc0c8\ub85c\uc6b4 \uc7a1\ucd08\uac00 \uc0dd\uc131\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct actief: decoraties en beloningen zullen geen nieuw onkruid voortbrengen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne natychmiast: dekoracje i nagrody nie powoduj\u0105 powstawania nowych chwast\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo j\u00e1: sem novas ervas daninhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0440\u0430\u0437\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e: \u043f\u043b\u043e\u0445\u0438\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u043d\u0435 \u043f\u043e\u0440\u043e\u0436\u0434\u0430\u044e\u0442 \u043d\u043e\u0432\u044b\u0435 \u0441\u043e\u0440\u043d\u044f\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif olun: Dekorasyonlar ve \u00f6d\u00fcller yeni yabani otlar\u0131n ortaya \u00e7\u0131kmas\u0131na neden olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u6fc0\u6d3b\uff1a\u574f\u4e60\u60ef\u548c\u5956\u52b1\u4e0d\u4f1a\u751f\u6210\u65b0\u7684\u6742\u8349\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u884c\u52d5\uff1a\u58de\u7fd2\u6163\u548c\u734e\u52f5\u4e0d\u6703\u6ecb\u751f\u65b0\u7684\u96dc\u8349\u3002"
          }
        }
      }
    },
    "item.giesscan_pro.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4lt deinen Garten l\u00e4nger feucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your garden moist longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tu jard\u00edn h\u00famedo por m\u00e1s tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ton jardin humide plus longtemps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u094b \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0924\u0915 \u0928\u092e \u0930\u0916\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your garden moist longer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5ead\u306e\u6f64\u3044\u3092\u9577\u304f\u4fdd\u3061\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc744 \ub354 \uc624\ub7ab\ub3d9\uc548 \ucd09\ucd09\ud558\uac8c \uc720\uc9c0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt uw tuin langer vochtig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje wilgo\u0107 w ogrodzie na d\u0142u\u017cej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your garden moist longer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0432\u0430\u0448 \u0441\u0430\u0434 \u0434\u043e\u043b\u044c\u0448\u0435 \u0432\u043b\u0430\u0436\u043d\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7enizin daha uzun s\u00fcre nemli kalmas\u0131n\u0131 sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba9\u4f60\u7684\u82b1\u56ed\u4fdd\u6301\u66f4\u957f\u65f6\u95f4\u7684\u6e7f\u6da6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b93\u60a8\u7684\u82b1\u5712\u4fdd\u6301\u66f4\u9577\u6642\u9593\u7684\u6fd5\u6f64\u3002"
          }
        }
      }
    },

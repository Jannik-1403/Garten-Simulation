    "notification.evening.3.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abend bricht an... und %d %@ rufen nach dir!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening falls... and %d %@ are calling for you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cae la noche... \u00a1y %d %@ te est\u00e1n llamando!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir tombe... et %d %@ t'appellent !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u093e\u092e \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u0939\u0948... \u0914\u0930%d%@\u0906\u092a\u0915\u094b \u092c\u0941\u0932\u093e \u0930\u0939\u0947 \u0939\u0948\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scende la sera... e %d %@ ti chiamano!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5915\u65b9\u306b\u306a\u308a\u307e\u3059...\u305d\u3057\u3066 %d %@ \u304c\u3042\u306a\u305f\u3092\u547c\u3093\u3067\u3044\u307e\u3059!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub141\uc774 \ub418\ub2c8... %d %@\uc774(\uac00) \ub2f9\uc2e0\uc744 \ubd80\ub974\uace0 \uc788\uc2b5\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De avond valt... en %d %@ roept je!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapada wiecz\u00f3r... i %d %@ wzywa Ci\u0119!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A noite cai... e %d %@ chamam por ti!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0432\u0435\u0447\u0435\u0440... \u0438%d%@\u0437\u043e\u0432\u0443\u0442 \u0442\u0435\u0431\u044f!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u015fam d\u00fc\u015f\u00fcyor... ve %d %@ sizi \u00e7a\u011f\u0131r\u0131yor!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u591c\u5e55\u964d\u4e34... %d %@ \u5728\u547c\u5524\u4f60\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u591c\u665a\u5373\u5c07\u4f86\u81e8\u2026%d%@\u6b63\u5728\u53ec\u559a\u60a8\uff01"

        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voldoende ruimte voor al uw gereedschap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du\u017co miejsca na wszystkie Twoje narz\u0119dzia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito espa\u00e7o para todas as tuas ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0432\u0430\u0448\u0438\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432."

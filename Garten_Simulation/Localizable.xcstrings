          }
        }
      }
    },
    "assessment.lifestyle.profile.elite.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide es, Ratschl\u00e4ge zu geben, wenn jemand eigentlich nur eine Schulter zum Anlehnen sucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid giving advice when someone is really just looking for a shoulder to lean on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite dar consejos cuando alguien en realidad s\u00f3lo busca un hombro en el que apoyarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9vitez de donner des conseils lorsque quelqu\u2019un cherche simplement une \u00e9paule sur laquelle s\u2019appuyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u092c \u0915\u094b\u0908 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0938\u0939\u093e\u0930\u093e \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u0915\u0902\u0927\u0947 \u0915\u0940 \u0924\u0932\u093e\u0936 \u092e\u0947\u0902 \u0939\u094b \u0924\u094b \u0938\u0932\u093e\u0939 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092c\u091a\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita di dare consigli quando qualcuno sta solo cercando una spalla su cui appoggiarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ab0\u304b\u304c\u672c\u5f53\u306b\u80a9\u3092\u5bc4\u305b\u305f\u3044\u3060\u3051\u306e\u5834\u5408\u306f\u3001\u30a2\u30c9\u30d0\u30a4\u30b9\u3092\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub204\uad70\uac00\uac00 \uc815\ub9d0\ub85c \uae30\ub308 \uc5b4\uae68\ub97c \ucc3e\uace0 \uc788\uc744 \ub54c\ub294 \uc870\uc5b8\uc744 \ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd het geven van advies als iemand eigenlijk alleen maar op zoek is naar een schouder om op te leunen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj udzielania rad, gdy kto\u015b tak naprawd\u0119 szuka ramienia, na kt\u00f3rym mo\u017ce si\u0119 oprze\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite dar conselhos quando algu\u00e9m est\u00e1 apenas procurando um ombro para se apoiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0431\u0435\u0433\u0430\u0439 \u0434\u0430\u0432\u0430\u0442\u044c \u0441\u043e\u0432\u0435\u0442\u044b, \u0435\u0441\u043b\u0438 \u043a\u0442\u043e-\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0438\u0449\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043b\u0435\u0447\u043e, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0436\u043d\u043e \u043e\u043f\u0435\u0440\u0435\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi ger\u00e7ekten yaslanacak bir omuz arad\u0131\u011f\u0131nda tavsiye vermekten ka\u00e7\u0131n\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u6709\u4eba\u5b9e\u9645\u4e0a\u53ea\u662f\u60f3\u627e\u4e2a\u53ef\u4ee5\u4f9d\u9760\u7684\u80a9\u8180\u65f6\uff0c\u907f\u514d\u7ed9\u51fa\u5efa\u8bae\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7576\u67d0\u4eba\u771f\u7684\u53ea\u662f\u5728\u5c0b\u627e\u4e00\u500b\u53ef\u4ee5\u4f9d\u9760\u7684\u80a9\u8180\u6642\uff0c\u907f\u514d\u63d0\u4f9b\u5efa\u8b70\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.profile.elite.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedanke dich einmal w\u00f6chentlich aufrichtig bei jemandem, der dir im Hintergrund hilft (Reinigungskraft, Assistent)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a week, sincerely thank someone who helps you in the background (cleaner, assistant)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez a la semana, agradece sinceramente a alguien que te ayude en segundo plano (limpiador, asistente)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine, remerciez sinc\u00e8rement quelqu'un qui vous aide en arri\u00e8re-plan (nettoyeur, assistant)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092a\u094d\u0924\u093e\u0939 \u092e\u0947\u0902 \u090f\u0915 \u092c\u093e\u0930, \u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 (\u0915\u094d\u0932\u0940\u0928\u0930, \u0938\u0939\u093e\u092f\u0915) \u0915\u094b \u0908\u092e\u093e\u0928\u0926\u093e\u0930\u0940 \u0938\u0947 \u0927\u0928\u094d\u092f\u0935\u093e\u0926 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta alla settimana, ringrazia sinceramente qualcuno che ti aiuta in background (addetto alle pulizie, assistente)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9031\u306b\u4e00\u5ea6\u3001\u88cf\u65b9\u3067\u624b\u4f1d\u3063\u3066\u304f\u308c\u308b\u4eba\uff08\u6e05\u6383\u54e1\u3084\u30a2\u30b7\u30b9\u30bf\u30f3\u30c8\uff09\u306b\u5fc3\u304b\u3089\u611f\u8b1d\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uc8fc\uc77c\uc5d0 \ud55c \ubc88, \ub4a4\uc5d0\uc11c \ub3c4\uc640\uc8fc\ub294 \uc0ac\ub78c(\uccad\uc18c\ubd80, \ubcf4\uc870\uc6d0)\uc5d0\uac8c \uc9c4\uc2ec\uc73c\ub85c \uac10\uc0ac\ub97c \ud45c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedank \u00e9\u00e9n keer per week oprecht iemand die je op de achtergrond helpt (schoonmaakster, assistent)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz w tygodniu szczerze podzi\u0119kuj komu\u015b, kto pomaga Ci w tle (sprz\u0105taczka, asystentka)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por semana, agrade\u00e7a sinceramente a algu\u00e9m que o ajuda nos bastidores (faxina, assistente)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u0442\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0438\u0441\u043a\u0440\u0435\u043d\u043d\u0435 \u0440\u0430\u0437 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u0432\u0430\u043c \u0437\u0430 \u043a\u0443\u043b\u0438\u0441\u0430\u043c\u0438 (\u0443\u0431\u043e\u0440\u0449\u0438\u0446\u0443, \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada bir kez arka planda size yard\u0131mc\u0131 olan birine (temizlik\u00e7i, asistan) i\u00e7tenlikle te\u015fekk\u00fcr edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5468\u771f\u8bda\u5730\u611f\u8c22\u4e00\u6b21\u5728\u80cc\u540e\u5e2e\u52a9\u4f60\u7684\u4eba\uff08\u6e05\u6d01\u5de5\u3001\u52a9\u7406\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u9031\u4e00\u6b21\uff0c\u771f\u8aa0\u5730\u611f\u8b1d\u5728\u5f8c\u53f0\u5e6b\u52a9\u4f60\u7684\u4eba\uff08\u6e05\u6f54\u5de5\u3001\u52a9\u7406\uff09\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.profile.elite.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst auf hohem Level. Die Marginal Gains f\u00fcr Eliten liegen in der Demut und dem Zur\u00fcckgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You play at a high level. The marginal gains for elites lie in humility and giving back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juegas a un alto nivel. Los beneficios marginales para las \u00e9lites residen en la humildad y la retribuci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous jouez \u00e0 un haut niveau. Les gains marginaux pour les \u00e9lites r\u00e9sident dans l\u2019humilit\u00e9 et le don en retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u090a\u0902\u091a\u0947 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0916\u0947\u0932\u0924\u0947 \u0939\u0948\u0902. \u0905\u092d\u093f\u091c\u093e\u0924 \u0935\u0930\u094d\u0917 \u0915\u0947 \u0932\u093f\u090f \u0938\u0940\u092e\u093e\u0902\u0924 \u0932\u093e\u092d \u0935\u093f\u0928\u092e\u094d\u0930\u0924\u093e \u0914\u0930 \u0935\u093e\u092a\u0938 \u0926\u0947\u0928\u0947 \u092e\u0947\u0902 \u0928\u093f\u0939\u093f\u0924 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giochi ad alto livello. I guadagni marginali per le \u00e9lite risiedono nell\u2019umilt\u00e0 e nella restituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u3044\u30ec\u30d9\u30eb\u3067\u30d7\u30ec\u30fc\u3057\u3066\u3044\u307e\u3059\u306d\u3002\u30a8\u30ea\u30fc\u30c8\u306b\u3068\u3063\u3066\u306e\u308f\u305a\u304b\u306a\u5229\u76ca\u306f\u3001\u8b19\u865a\u3055\u3068\u6069\u8fd4\u3057\u306b\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ub192\uc740 \uc218\uc900\uc5d0\uc11c \ud50c\ub808\uc774\ud569\ub2c8\ub2e4. \uc5d8\ub9ac\ud2b8\uc758 \ud55c\uacc4 \uc774\uc775\uc740 \uacb8\uc190\uacfc \ud658\uc6d0\uc5d0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je speelt op hoog niveau. De marginale winsten voor de elites liggen in nederigheid en teruggeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grasz na wysokim poziomie. Marginalne zyski elit polegaj\u0105 na pokorze i oddaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea joga em alto n\u00edvel. Os ganhos marginais para as elites residem na humildade e na retribui\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0438\u0433\u0440\u0430\u0435\u0448\u044c \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435. \u041c\u0430\u0440\u0436\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0434\u043b\u044f \u044d\u043b\u0438\u0442\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u0432 \u0441\u043c\u0438\u0440\u0435\u043d\u0438\u0438 \u0438 \u043e\u0442\u0434\u0430\u0447\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dcst d\u00fczeyde oynuyorsun. Se\u00e7kinlerin marjinal kazan\u0131mlar\u0131 al\u00e7akg\u00f6n\u00fcll\u00fcl\u00fck ve kar\u015f\u0131l\u0131k vermekte yatmaktad\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u9ad8\u6c34\u5e73\u4e0a\u6bd4\u8d5b\u3002\u7cbe\u82f1\u7684\u8fb9\u9645\u6536\u76ca\u5728\u4e8e\u8c26\u900a\u548c\u56de\u9988\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u6bd4\u8cfd\u6c34\u6e96\u5f88\u9ad8\u3002\u83c1\u82f1\u5011\u7684\u908a\u969b\u5229\u76ca\u5728\u65bc\u8b19\u905c\u548c\u56de\u994b\u3002"
          }
        }
      }
    },

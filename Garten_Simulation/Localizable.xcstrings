    "tour_coins_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du deine M\u00fcnzen. Klicke darauf, wenn du bei Bedarf weitere kaufen m\u00f6chtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see your coins. Click on them if you want to buy more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqu\u00ed puedes ver tus monedas. Haz clic en ellas si quieres comprar m\u00e1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici vos pi\u00e8ces. Cliquez dessus si vous souhaitez en acheter plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939\u093e\u0901 \u0906\u092a \u0905\u092a\u0928\u0947 \u0938\u093f\u0915\u094d\u0915\u0947 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0917\u0930 \u091c\u0930\u0942\u0930\u0924 \u0939\u094b \u0914\u0930 \u0906\u092a \u0914\u0930 \u0916\u0930\u0940\u0926\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0909\u0938 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco le tue monete. Cliccaci sopra se vuoi acquistarne altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u3053\u306b\u30b3\u30a4\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u8cfc\u5165\u3057\u305f\u3044\u5834\u5408\u306f\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ec\uae30\uc5d0 \ucf54\uc778\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub354 \uad6c\ub9e4\ud558\uace0 \uc2f6\ub2e4\uba74 \ud074\ub9ad\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zie je je munten. Klik erop als je er meer wilt kopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto twoje monety. Kliknij na nie, je\u015bli chcesz kupi\u0107 wi\u0119cej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui est\u00e3o suas moedas. Clique nelas se quiser comprar mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0434\u0435\u0441\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0432\u043e\u0438 \u043c\u043e\u043d\u0435\u0442\u044b. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u044d\u0442\u043e, \u0435\u0441\u043b\u0438 \u0432\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0441\u0442\u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u015fte paralar\u0131n\u0131z. Daha fazla sat\u0131n almak isterseniz \u00fczerlerine t\u0131klay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u8fd9\u91cc\u4f60\u53ef\u4ee5\u770b\u5230\u4f60\u7684\u786c\u5e01\u3002\u5982\u679c\u60a8\u60f3\u8d2d\u4e70\u66f4\u591a\uff0c\u8bf7\u70b9\u51fb\u6b64\u6309\u94ae\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9019\u88e1\u4f60\u53ef\u4ee5\u770b\u5230\u4f60\u7684\u786c\u5e63\u3002\u5982\u679c\u60a8\u60f3\u8cfc\u8cb7\u66f4\u591a\uff0c\u8acb\u9ede\u64ca\u6b64\u6309\u9215\u3002"
          }
        }
      }
    },

    "assessment.growth.profile.fakeWorker.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör auf, deinen Arbeitsplatz aufzuräumen, bevor du beginnst. Setz dich ran und starte unperfekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop cleaning up your workspace before you start. Sit down and start imperfectly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de limpiar tu espacio de trabajo antes de comenzar. Siéntate y empieza imperfectamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez de nettoyer votre espace de travail avant de commencer. Asseyez-vous et démarrez imparfaitement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू करने से पहले अपने कार्यक्षेत्र की सफ़ाई करना बंद कर दें। बैठ जाओ और अपूर्ण ढंग से शुरुआत करो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetti di pulire il tuo spazio di lavoro prima di iniziare. Siediti e inizia in modo imperfetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始める前にワークスペースのクリーンアップをやめてください。座って不完全にスタートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작하기 전에 작업 공간 청소를 중지하십시오. 앉아서 불완전하게 시작하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop met het opruimen van uw werkruimte voordat u begint. Ga zitten en begin onvolmaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań sprzątać swoje miejsce pracy, zanim zaczniesz. Usiądź i zacznij niedoskonale."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare de limpar seu espaço de trabalho antes de começar. Sente-se e comece de maneira imperfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перестань убирать своё рабочее место, прежде чем начнёшь. Садись и начинай несовершенно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamadan önce çalışma alanınızı temizlemeyi bırakın. Oturun ve kusurlu bir şekilde başlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在开始之前，不要整理你的工作场所。坐下来并不完美地开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在開始之前停止清理工作空間。坐下來，開始不完美的事。"
          }
        }
      }
    },
    "assessment.growth.profile.fakeWorker.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeite die ersten 10 Minuten am Schreibtisch komplett ohne Internetverbindung an der wichtigsten Aufgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work on the most important task for the first 10 minutes at your desk without an internet connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabaja en la tarea más importante durante los primeros 10 minutos en tu escritorio sin conexión a Internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez sur la tâche la plus importante pendant les 10 premières minutes à votre bureau sans connexion Internet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना इंटरनेट कनेक्शन के अपने डेस्क पर पहले 10 मिनट तक सबसे महत्वपूर्ण कार्य पर काम करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavora sull'attività più importante per i primi 10 minuti alla tua scrivania senza connessione Internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の 10 分間は、インターネット接続なしでデスクで最も重要なタスクに取り組みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결 없이 책상에서 처음 10분 동안 가장 중요한 작업을 수행하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk de eerste 10 minuten aan je bureau aan de belangrijkste taak zonder internetverbinding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracuj nad najważniejszym zadaniem przez pierwsze 10 minut przy biurku bez połączenia z Internetem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalhe na tarefa mais importante durante os primeiros 10 minutos em sua mesa, sem conexão com a Internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работай первые 10 минут за письменным столом полностью без интернет-соединения над самой важной задачей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk 10 dakika boyunca internet bağlantısı olmadan masanızda en önemli görev üzerinde çalışın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最重要的任务上，在桌前完全不连接互联网工作前十分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在沒有網路連線的情況下，在辦公桌前的前 10 分鐘內完成最重要的任務。"
          }
        }
      }
    },
    "assessment.growth.profile.fakeWorker.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist 'beschäftigt', aber nie produktiv. Wir durchbrechen den Pseudofleiß durch radikale 1％-Restriktionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are 'busy' but never productive. We break through the pseudo-industriousness with radical 1％ restrictions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás \"ocupado\" pero nunca eres productivo. Rompemos la pseudo laboriosidad con restricciones radicales del 1％."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes « occupé » mais jamais productif. Nous brisons le pseudo-industriel avec des restrictions radicales de 1％."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप 'व्यस्त' हैं लेकिन कभी उत्पादक नहीं हैं। हम कट्टरपंथी 1％ प्रतिबंधों के साथ छद्म-उद्योगशीलता को तोड़ते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei \"occupato\" ma mai produttivo. Superiamo la pseudo-operosità con restrizioni radicali dell’1％."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは「忙しい」のに、決して生産的ではありません。過激な１％規制で擬似勤勉を打ち破る。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 '바쁘지만' 결코 생산적이지 않습니다. 과격한 1％ 제한으로 유사근면을 돌파합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent ‘druk’ maar nooit productief. We doorbreken de pseudo-ijverigheid met radicale beperkingen van 1％."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś „zajęty”, ale nigdy produktywny. Przełamujemy pseudoprzedsiębiorczość radykalnym 1％ ograniczeniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está 'ocupado', mas nunca produtivo. Rompemos a pseudo-industriosidade com restrições radicais de 1％."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты 'занят', но никогда не продуктивен. Мы разрушаем иллюзию усердия через радикальные 1％-ные ограничения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Meşgulsün' ama asla üretken değilsin. Sahte çalışkanlığı ％1'lik radikal kısıtlamalarla aşıyoruz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你总是“忙碌”，但从未高效。我们通过激进的1％限制打破伪勤奋。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你很“忙”，但從來沒有生產力。我們突破了激進的1％限制的偽勤奮。"
          }
        }
      }
    },

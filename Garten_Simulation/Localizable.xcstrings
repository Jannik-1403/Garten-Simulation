          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je het absoluut zeker?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy jeste\u015b tego absolutnie pewien?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens a certeza absoluta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0443\u0432\u0435\u0440\u0435\u043d \u041d\u0410\u0412\u0415\u0420\u041d\u042f\u041a\u0410?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinlikle emin misin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5b8c\u5168\u786e\u5b9a\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5b8c\u5168\u78ba\u5b9a\u55ce\uff1f"
          }
        }
      }
    },

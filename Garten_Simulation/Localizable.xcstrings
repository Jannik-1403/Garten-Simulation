    "assessment.finance.profile.kontrolleur.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervorragend! Dein finanzielles System ist extrem stabil. Behalte deine bewussten Gewohnheiten bei, um dein Vermögen weiter aufzubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[EN] Hervorragend! Dein finanzielles System ist extrem stabil. Behalte deine bewussten Gewohnheiten bei, um dein Vermögen weiter aufzubauen."

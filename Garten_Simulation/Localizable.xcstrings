        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0142\u0119dny wynik! Spr\u00f3buj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultado errado! Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442! \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanl\u0131\u015f sonu\u00e7! Tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ed3\u679c\u9519\u8bef\uff01\u8bf7\u518d\u8bd5\u4e00\u6b21\u3002"
          }
        },
        "zh-Hant": {

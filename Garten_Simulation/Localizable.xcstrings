    "trash.endlos_scroll_tv.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe ein TV-Tagebuch: Was hast du gestern geschaut? War es wert?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a TV diary: what did you watch yesterday? Was it worth it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva un diario de TV: ¿qué viste ayer? ¿Valió la pena?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens un journal télévisé: qu'as-tu regardé hier ? Ça valait le coup ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी डायरी बनाएं: आपने कल क्या देखा? क्या यह इसके लायक था?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni un diario televisivo: cosa hai guardato ieri? Ne valeva la pena?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレビ日記をつけましょう。昨日は何を見ましたか？それだけの価値がありましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV 일기를 써보세요: 어제 무엇을 봤나요? 그럴 가치가 있었나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een tv-dagboek bij: wat heb je gisteren gekeken? Was het de moeite waard?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prowadź dziennik TV: co oglądałeś wczoraj? Czy to było warte?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um diário de TV: o que você assistiu ontem? Valeu a pena?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um diário de TV: o que você assistiu ontem? Valeu a pena?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите теледневник: что вы смотрели вчера? Стоило ли оно того?"
          }

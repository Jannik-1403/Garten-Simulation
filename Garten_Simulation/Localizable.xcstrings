    "prog_deepwork_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine harte kognitive Arbeit heute. Setze dich 15 Minuten hin und plane die Deep Work Slots für die kommende Woche in deinen Kalender ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hard cognitive work today. Sit down for 15 minutes and plan the deep work slots for the coming week in your calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay trabajo cognitivo duro. Siéntese durante 15 minutos y planifique en su calendario los espacios de trabajo profundo para la próxima semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de gros travail cognitif aujourd’hui. Asseyez-vous pendant 15 minutes et planifiez les créneaux de travail approfondi pour la semaine à venir dans votre calendrier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कोई कठिन संज्ञानात्मक कार्य नहीं. 15 मिनट के लिए बैठें और अपने कैलेंडर में आने वाले सप्ताह के लिए गहन कार्य स्लॉट की योजना बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun duro lavoro cognitivo oggi. Siediti per 15 minuti e pianifica nel tuo calendario gli orari di lavoro profondo per la prossima settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は難しい認知作業はありません。 15 分間座って、カレンダーに来週の集中的な作業枠を計画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 힘든 인지 작업이 없습니다. 15분 동안 앉아서 달력에 다음 주의 심층 작업 시간을 계획하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen zwaar cognitief werk vandaag. Ga er 15 minuten voor zitten en plan de diepe werkslots voor de komende week in je agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnej ciężkiej pracy poznawczej dzisiaj. Usiądź na 15 minut i zaplanuj w swoim kalendarzu miejsca na głęboką pracę na nadchodzący tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum trabalho cognitivo difícil hoje. Sente-se por 15 minutos e planeje em seu calendário os horários de trabalho intensos para a próxima semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum trabalho cognitivo difícil hoje. Sente-se por 15 minutos e planeje em seu calendário os horários de trabalho intensos para a próxima semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакой тяжелой познавательной работы сегодня. Сядьте на 15 минут и запланируйте в своем календаре места для углубленной работы на предстоящую неделю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün zor bilişsel çalışma yok. 15 dakika oturun ve takviminizde önümüzdeki hafta için derin çalışma aralıklarını planlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有艰苦的认知工作。坐下来 15 分钟，在日历中计划下一周的深度工作时段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天沒有艱苦的認知工作。坐下來 15 分鐘，在日曆中規劃下一週的深度工作時段。"
          }
        }
      }
    },

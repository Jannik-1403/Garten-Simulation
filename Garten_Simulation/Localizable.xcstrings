    "trash.luxus_auto.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche Shopping-Apps und deaktiviere gespeicherte Zahlungsmethoden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete shopping apps and disable saved payment methods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las apps de compras y desactiva los métodos de pago guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les applications de shopping et désactive les méthodes de paiement enregistrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉपिंग ऐप्स को हटाएं और संग्रहीत भुगतान विधियों को अक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina le app di shopping e disabilita i metodi di pagamento salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショッピングアプリを削除し、保存された支払い方法を無効にしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쇼핑 앱을 삭제하고 저장된 결제 수단을 비활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder winkel-apps en schakel opgeslagen betaalmethoden uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń aplikacje zakupowe i wyłącz zapisane metody płatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua apps de compras e desative métodos de pagamento salvos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua apps de compras e desative métodos de pagamento salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите приложения для покупок и отключите сохраненные способы оплаты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışveriş uygulamalarını sil ve kayıtlı ödeme yöntemlerini devre dışı bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除购物应用程序并禁用已保存的付款方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除購物應用程式並停用已儲存的付款方式。"
          }
        }
      }
    },
    "trash.luxus_auto.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage dich: Kaufe ich das für mich – oder um anderen zu imponieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask yourself: am I buying this for me – or to impress others?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntate: ¿compro esto para mí o para impresionar a los demás?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande-toi: est-ce que j'achète ça pour moi – ou pour impressionner les autres ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आप से पूछो: क्या मैं यह अपने लिए खरीद रहा हूँ – या दूसरों को प्रभावित करने के लिए?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiediti: sto comprando questo per me – o per fare colpo sugli altri?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自問しましょう。これは自分のために買うのか、それとも他人に感銘を与えるために買うのかを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스스로에게 물어보세요: 나를 위해 사는 건가요 – 아니면 남에게 보이기 위해서인가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag jezelf: koop ik dit voor mezelf – of om anderen onder de indruk te brengen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj siebie: czy kupuję to dla siebie – czy żeby zaimponować innym?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-se: estou comprando isso para mim – ou para impressionar os outros?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-se: estou comprando isso para mim – ou para impressionar os outros?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите себя: я покупаю это для себя или для того, чтобы произвести впечатление на других?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendine sor: bunu kendim için mi alıyorum – yoksa başkalarını etkilemek için mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问自己：我买这个是为了自己，还是为了给别人留下深刻的印象？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問問自己：我買這個是為了自己，還是為了給別人留下深刻的印象？"
          }
        }
      }
    },
    "trash.luxus_auto.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel: 72 Stunden warten bei jedem Kauf über 50 Euro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule: wait 72 hours for every purchase over 50 euros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regla: espera 72 horas para cada compra superior a 50 euros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle: attendre 72 heures pour tout achat de plus de 50 euros."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियम: 50 यूरो से अधिक की किसी भी खरीदारी पर 72 घंटे प्रतीक्षा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola: aspetta 72 ore per ogni acquisto superiore a 50 euro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルール：50ユーロ以上の購入はすべて72時間待ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙: 50유로 이상 구매 시 72시간 기다리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel: 72 uur wachten bij elke aankoop boven de 50 euro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasada: czekaj 72 godziny przy każdym zakupie powyżej 50 euro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regra: espere 72 horas para cada compra acima de 50 euros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regra: espere 72 horas para cada compra acima de 50 euros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило: подождите 72 часа при покупке на сумму более 50 евро."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural: 50 euronun üzerindeki her alışveriş için 72 saat bekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则：购买超过 50 欧元的商品需等待 72 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則：購買超過 50 歐元的商品需等待 72 小時。"
          }
        }
      }
    },
    "trash.luxus_auto.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere jeden Luxuskauf – was hattest du davon nach einem Monat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down every luxury purchase – what did you get from it after a month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota cada compra de lujo: ¿qué obtuviste de ella después de un mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note chaque achat de luxe – qu'est-ce que ça t'a apporté après un mois ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर लक्ज़री खरीद को नोट करें – एक महीने बाद आपको उससे क्या मिला?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota ogni acquisto di lusso – cosa ne hai ottenuto dopo un mese?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての高級品の購入を書き留めましょう。1ヶ月後、それは何をもたらしてくれましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 명품 구매를 적어두세요 – 한 달 후에 무엇을 얻었나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer elke luxe aankoop – wat heb je er na een maand van gehad?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj każdy zakup luksusowy – co z tego miałeś po miesiącu?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote cada compra de luxo – o que você obteve disso depois de um mês?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote cada compra de luxo – o que você obteve disso depois de um mês?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте каждую покупку предметов роскоши – что вы от нее получили через месяц?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her lüks alışverişi yaz – bir ay sonra bundan ne elde ettin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下每一次购买的奢侈品——一个月后你从中得到了什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下每一次購買的奢侈品－一個月後從中得到了什麼？"
          }
        }
      }
    },
    "trash.luxus_auto.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Sinnlose Autofahrten)**\n1. Unsichtbar machen: Entferne die Auslöser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue Hürden ein (z.B. Apps löschen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausführung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Spazieren gehen)**\n1. Offensichtlich machen: Platziere den Auslöser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die Hürden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Pointless drives)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Going for a walk)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina el mal hábito (Viajes en coche sin sentido)**\n1. Hazlo invisible: Elimina los desencadenantes de tu campo de visión.\n2. Hazlo poco atractivo: Sé consciente de las consecuencias negativas.\n3. Hazlo difícil: Añade obstáculos (p. ej. elimina apps, desconecta el enchufe).\n4. Hazlo insatisfactorio: Vincula la acción a un castigo.\n\n**Establece el buen hábito (Salir a caminar)**\n1. Hazlo evidente: Coloca el desencadenante bien visible.\n2. Hazlo atractivo: Asócialo con algo que te guste.\n3. Hazlo fácil: Reduce los obstáculos al mínimo (p. ej. solo 2 minutos).\n4. Hazlo satisfactorio: Recompénsate justo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Se débarrasser de la mauvaise habitude (Trajets en voiture inutiles)**\n1. La rendre invisible : Retire les déclencheurs de ton champ de vision.\n2. La rendre peu attirante : Prends conscience des conséquences négatives.\n3. La rendre difficile : Ajoute des obstacles (par ex. supprime des applis, débranche la prise).\n4. La rendre insatisfaisante : Associe l'action à une sanction.\n\n**Mettre en place la bonne habitude (Se promener)**\n1. La rendre évidente : Place le déclencheur bien en vue.\n2. La rendre attirante : Associe-la à quelque chose que tu aimes.\n3. La rendre facile : Réduis les obstacles au minimum (par ex. seulement 2 minutes).\n4. La rendre satisfaisante : Récompense-toi juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**खराब आदत से छुटकारा पाएं (बेकार की गाड़ी चलाना)**\n1. अदृश्य बनाएं: अपने दृष्टि क्षेत्र से ट्रिगर्स हटा दें।\n2. अप्रिय बनाएं: नकारात्मक परिणामों के बारे में जागरूक हों।\n3. मुश्किल बनाएं: बाधाएँ डालें (जैसे, ऐप्स हटाएं, प्लग खींचें)।\n4. असंतोषजनक बनाएं: इसे करने के साथ जुड़ी सजा निर्धारित करें।\n\n**अच्छी आदत स्थापित करें (चलना)**\n1. स्पष्ट बनाएं: ट्रिगर को अच्छी तरह दिखाई देने वाली जगह पर रखें।\n2. आकर्षक बनाएं: इसे किसी ऐसी चीज़ से जोड़ें जिसे आप पसंद करते हैं।\n3. आसान बनाएं: बाधाओं को न्यूनतम पर लाएं (जैसे, केवल 2 मिनट)।\n4. संतोषजनक बनाएं: तुरंत इसके बाद खुद को इनाम दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina la cattiva abitudine (Giri in auto senza scopo)**\n1. Rendila invisibile: Rimuovi i trigger dal tuo campo visivo.\n2. Rendila poco attraente: Prendi consapevolezza delle conseguenze negative.\n3. Rendila difficile: Aggiungi ostacoli (es. elimina le app, stacca la spina).\n4. Rendila insoddisfacente: Collega l'azione a una punizione.\n\n**Stabilisci la buona abitudine (Fare una passeggiata)**\n1. Rendila evidente: Posiziona il trigger ben visibile.\n2. Rendila attraente: Associala a qualcosa che ti piace.\n3. Rendila facile: Riduci gli ostacoli al minimo (es. solo 2 minuti).\n4. Rendila soddisfacente: Premiati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**悪い習慣（無駄に車に乗る）を取り除く**\n1. 目に見えないようにする: トリガーを視界から取り除きます。\n2. 自分自身を魅力的でなくする: マイナスの結果に注意してください。\n3. 難しくする: ハードルを設定します (例: アプリを削除する、プラグを抜く)。\n4. 満足できないものにする: 処刑にペナルティを付けます。\n\n**良い習慣を身につける（散歩に行く）**\n1. わかりやすいようにする: トリガーをはっきりと見えるように配置します。\n2. 魅力的にする: 好きなものと関連付けます。\n3. シンプルにする: ハードルを最小限に抑えます (例: わずか 2 分)。\n4. 満足のいくものにする: 終わったらすぐに自分にご褒美をあげましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**나쁜 습관 버리기(무의미한 자동차 타기)**\n1. 보이지 않게 만들기: 시야에서 트리거를 제거합니다.\n2. 자신을 매력적이지 않게 만드세요. 부정적인 결과를 염두에 두세요.\n3. 어렵게 만들기: 장애물을 설정합니다(예: 앱 삭제, 플러그 뽑기).\n4. 불만족스럽게 만들기: 처형에 벌금을 부과합니다.\n\n**좋은 습관을 들이세요(산책하기)**\n1. 명확하게 만드십시오: 트리거를 명확하게 보이도록 배치하십시오.\n2. 매력적으로 만드십시오: 당신이 좋아하는 것과 연관시키십시오.\n3. 단순하게 만드세요. 장애물을 최소한으로 줄이세요(예: 단 2분).\n4. 만족스러운 일을 하십시오: 직후에 자신에게 보상하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Weg met een slechte gewoonte (zinloze autoritten)**\n1. Maak onzichtbaar: verwijder de triggers uit je gezichtsveld.\n2. Maak jezelf onaantrekkelijk: wees je bewust van de negatieve gevolgen.\n3. Maak het moeilijk: stel hindernissen op (bijvoorbeeld apps verwijderen, stekker uit het stopcontact halen).\n4. Maak het onbevredigend: Verbind de uitvoering met een boete.\n\n** Ontwikkel een goede gewoonte (ga wandelen) **\n1. Maak het duidelijk: plaats de trekker duidelijk zichtbaar.\n2. Maak het aantrekkelijk: associeer het met iets dat je leuk vindt.\n3. Maak het eenvoudig: reduceer de hindernissen tot een minimum (bijvoorbeeld slechts 2 minuten).\n4. Maak het bevredigend: Beloon jezelf daarna meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pozbądź się złego nawyku (bezsensownej jazdy samochodem)**\n1. Uczyń niewidzialnym: Usuń wyzwalacze z pola widzenia.\n2. Stań się nieatrakcyjny: bądź świadomy negatywnych konsekwencji.\n3. Utrudnij to: ustaw przeszkody (np. usuń aplikacje, odłącz).\n4. Spraw, aby było to niezadowalające: Połącz egzekucję z karą.\n\n**Wypracuj dobry nawyk (idź na spacer)**\n1. Spraw, aby było to oczywiste: umieść spust w dobrze widocznym miejscu.\n2. Spraw, aby było atrakcyjne: skojarz to z czymś, co lubisz.\n3. Uprość sprawę: ogranicz przeszkody do minimum (np. tylko 2 minuty).\n4. Spraw, aby było to satysfakcjonujące: natychmiast po tym nagradzaj siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Livra-te do mau hábito (Viagens de carro sem sentido)**\n1. Torná-lo invisível: Remove os gatilhos do teu campo de visão.\n2. Torná-lo pouco atrativo: Consciencializa-te das consequências negativas.\n3. Torná-lo difícil: Cria obstáculos (por ex. elimina apps, desliga a ficha).\n4. Torná-lo insatisfatório: Associa a ação a uma penalização.\n\n**Estabelece o bom hábito (Dar um passeio)**\n1. Torná-lo evidente: Coloca o gatilho bem visível.\n2. Torná-lo atrativo: Associa-o a algo de que gostas.\n3. Torná-lo fácil: Reduz os obstáculos ao mínimo (por ex. apenas 2 minutos).\n4. Torná-lo satisfatório: Recompensa-te logo a seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimine o mau hábito (Passeios de carro sem sentido)**\n1. Torne-o invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-o pouco atraente: Conscientize-se das consequências negativas.\n3. Torne-o difícil: Crie obstáculos (ex.: exclua apps, desligue a tomada).\n4. Torne-o insatisfatório: Associe a ação a uma punição.\n\n**Estabeleça o bom hábito (Caminhar)**\n1. Torne-o evidente: Coloque o gatilho bem visível.\n2. Torne-o atraente: Associe-o a algo que você gosta.\n3. Torne-o fácil: Reduza os obstáculos ao mínimo (ex.: apenas 2 minutos).\n4. Torne-o satisfatório: Recompense-se logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Избавьтесь от вредной привычки (бессмысленные поездки на автомобиле)**\n1. Сделайте невидимыми: уберите триггеры из поля зрения. \n2. Сделайте себя непривлекательным. Помните о негативных последствиях. \n3. Усложните задачу: установите препятствия (например, удалите приложения, отключите их от сети). \n4. Сделайте его неудовлетворительным: прикрепите исполнение к наказанию. \n\n**Выработайте хорошую привычку (пойти на прогулку)**\n1. Сделайте это очевидным: разместите триггер на видном месте. \n2. Сделайте это привлекательным. Свяжите это с чем-то, что вам нравится. \n3. Сделайте это просто: сократите препятствия до минимума (например, всего 2 минуты). \n4. Сделайте это приятным: вознаградите себя сразу после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kötü bir alışkanlıktan kurtulun (anlamsız araba yolculukları)**\n1. Görünmez kılın: Tetikleyicileri görüş alanınızdan kaldırın.\n2. Kendinizi çekici olmaktan çıkarın: Olumsuz sonuçların farkında olun.\n3. Zorlaştırın: Engeller koyun (ör. uygulamaları silin, fişi çekin).\n4. Yetersiz hale getirin: İnfazı cezaya ekleyin.\n\n**İyi bir alışkanlık edinin (yürüyüşe çıkın)**\n1. Açıkça belirtin: Tetiği açıkça görülebilecek şekilde yerleştirin.\n2. Çekici hale getirin: Onu sevdiğiniz bir şeyle ilişkilendirin.\n3. Basitleştirin: Engelleri en aza indirin (örneğin sadece 2 dakika).\n4. Tatmin edici hale getirin: Hemen ardından kendinizi ödüllendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉坏习惯（无意义的乘车）**\n1. 隐形：将触发因素移出视野。\n2. 让自己变得没有吸引力：意识到负面后果。\n3. 让它变得困难：设置障碍（例如删除应用程序、拔掉插头）。\n4. 使其不令人满意：附加刑罚执行。\n\n**建立一个好习惯（散步）**\n1. 使其显而易见：将触发器放置在清晰可见的位置。\n2. 让它有吸引力：将它与你喜欢的东西联系起来。\n3. 让它变得简单：将障碍减少到最低限度（例如只需 2 分钟）。\n4. 让它令人满意：事后立即奖励自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉壞習慣（無意義的乘車）**\n1. 隱形：將觸發因素移出視野。\n2. 讓自己變得沒有吸引力：意識到負面後果。\n3. 讓它變得困難：設定障礙（例如刪除應用程式、拔掉插頭）。\n4. 使其不令人滿意：附加刑罰執行。\n\n**建立一個好習慣（散步）**\n1. 使其顯而易見：將觸發器放置在清晰可見的位置。\n2. 讓它有吸引力：將它與你喜歡的東西連結起來。\n3. 讓它變得簡單：將障礙減少到最低限度（例如只需 2 分鐘）。\n4. 讓它令人滿意：事後立即獎勵自己。"
          }
        }
      }
    },
    "trash.luxus_uhr.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahre Klasse braucht keine Statussymbole – investiere lieber in Erlebnisse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True class needs no status symbols – invest in experiences instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verdadera clase no necesita símbolos de estatus: invierte en experiencias en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vraie classe n'a pas besoin de symboles de statut - investissez plutôt dans des expériences."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सच्ची शान को किसी स्थिति के प्रतीकों की ज़रूरत नहीं होती – बेहतर है कि अनुभवों में निवेश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vera classe non ha bisogno di simboli di status: investi invece in esperienze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本物の品格にステータスシンボルは必要ありません。代わりに経験に投資しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진정한 품격에는 지위 상징이 필요하지 않습니다. 대신 경험에 투자하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ware klasse heeft geen statussymbolen nodig - investeer in plaats daarvan in ervaringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawdziwa klasa nie potrzebuje symboli statusu – inwestuj raczej w przeżycia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verdadeira classe não precisa de símbolos de status – invista em experiências em vez disso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verdadeira classe não precisa de símbolos de status – invista em experiências em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истинному классу не нужны символы статуса — вместо этого инвестируйте в опыт."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek sınıf statü sembollerine ihtiyaç duymaz - bunun yerine deneyimlere yatırım yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真正的阶级不需要地位象征——而是投资于体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真正的階級不需要地位象徵──而是投資於體驗。"
          }
        }
      }
    },
    "trash.luxus_uhr.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Statussymbole kaufen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Buying status symbols) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (comprar símbolos de estatus) le cuesta energía, tiempo y dinero a largo plazo. Le impide alcanzar su máximo potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (acheter des symboles de statut) vous coûte de l’énergie, du temps et de l’argent à long terme. Cela vous empêche d’atteindre votre plein potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (स्थिति प्रतीक खरीदना) आपको लंबी अवधि में ऊर्जा, समय और पैसा खर्च कराती है। यह आपको अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (acquistare status symbol) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di raggiungere il tuo pieno potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（ステータスシンボルを買う）は、長期的にはエネルギー、時間、お金を費やします。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(상태 기호 구매)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (Statussymbolen kopen) kost je op lange termijn energie, tijd en geld. Het weerhoudt je ervan je volledige potentieel te benutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (kupowanie symboli statusu) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Comprar símbolos de estatuto) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Comprar símbolos de status) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (покупка символов статуса) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (statü sembolleri satın almak) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（购买地位象征）会耗费你的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

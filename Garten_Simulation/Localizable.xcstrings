    "onboarding_tutorial_5_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenstände lassen Unkraut wachsen, das XP und Fortschritt blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items can cause weeds to grow, hindering XP and progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetos pueden hacer que crezcann malas hierbas, lo que dificulta la XP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objets peuvent faire de l'herbe pousse, ce qui freine l'XP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम खरपतवार उगने का कारण बनते हैं, जिससे एक्सपी और प्रगति अवरुद्ध हो जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggetti possono far crescere le erbacce, ostacolando l'XP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテムは雑草を生長させ、XP や進行を妨げる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이템으로 인해 잡초가 자라 XP와 진행을 방해할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items kunnen ervoor zorgen dat onkruid groeit, waardoor XP en voortgang worden belemmerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedmioty mogą powodować wzrost chwastów, utrudniając zdobywanie punktów doświadczenia i postęp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens podem causar ervas daninhas, dificultando o XP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens podem causar ervas daninhas, dificultando o XP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предметы позволяют расти сорнякам, которые блокируют XP и прогресс."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler yabani otların büyümesine neden olarak XP'yi ve ilerlemeyi engelleyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物品会让杂草生长，阻碍经验值和进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "物品會導致雜草生長，阻礙經驗值和進度。"
          }
        }
      }
    },

    "timer.preview.body.example": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wartet auf dich. Gib ihr heute noch etwas Wasser!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is waiting for you. Give it some water today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te espera. ¡Dale un poco de agua hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ t'attend. Donne-lui un peu d'eau aujourd'hui !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@तुम्हारा इंतजार कर रहा है। उसे आज ही थोड़ा पानी दो!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ti sta aspettando. Dagle un po' d'acqua oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ があなたを待っています。今日は水をあげましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 당신을 기다리고 있습니다. 오늘은 물을 좀 주세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",

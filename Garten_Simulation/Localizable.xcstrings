        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czujesz się wyjątkowo osłabiony, masz ból gardła i lekką gorączkę. Właściwie dzisiaj jest ciężki trening lub długa sesja naukowa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se sente extremamente fraco, com dor de garganta e febre baixa. Na verdade, hoje é um treino intenso ou uma longa sessão de estudo."

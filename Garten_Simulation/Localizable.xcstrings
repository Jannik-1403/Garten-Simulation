    "plant.lotus.symbolism" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde deine innere Ruhe und Balance durch tägliche Meditation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find your inner peace and balance through daily meditation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra tu paz interior y equilibrio a través de la meditación diaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez votre paix intérieure et votre équilibre grâce à la méditation quotidienne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक ध्यान के माध्यम से अपनी आंतरिक शांति और संतुलन खोजें।"
          }
        },
        "it" : {
          "stringUnit" : {

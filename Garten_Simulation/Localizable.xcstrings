    "plant.efeu.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breitet sich langsam aber stetig aus \u2013 t\u00e4gliches Dehnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreads slowly but steadily \u2013 daily stretching"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se extiende lenta pero constantemente \u2013 estiramiento diario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'\u00e9tend lentement mais s\u00fbrement \u2013 \u00e9tirements quotidiens"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0927\u0940\u0930\u0947-\u0927\u0940\u0930\u0947 \u0932\u0947\u0915\u093f\u0928 \u0932\u0917\u093e\u0924\u093e\u0930 \u092b\u0948\u0932\u0924\u093e \u0939\u0948 \u2013 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0916\u093f\u0902\u091a\u093e\u0935"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreads slowly but steadily \u2013 daily stretching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3086\u3063\u304f\u308a\u3068\u7740\u5b9f\u306b\u5e83\u304c\u308a\u307e\u3059 - \u6bce\u65e5\u306e\u30b9\u30c8\u30ec\u30c3\u30c1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub290\ub9ac\uc9c0\ub9cc \uafb8\uc900\ud558\uac8c \ud37c\uc9d1\ub2c8\ub2e4 \u2013 \ub9e4\uc77c \uc2a4\ud2b8\ub808\uce6d"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verspreidt zich langzaam maar gestaag \u2013 dagelijks strekken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozprzestrzenia si\u0119 powoli, ale r\u00f3wnomiernie \u2013 codzienne rozci\u0105ganie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalha-se lenta mas continuamente \u2013 alongamentos di\u00e1rios"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e, \u043d\u043e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u2013 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u0430\u044f \u0440\u0430\u0441\u0442\u044f\u0436\u043a\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yava\u015f ama istikrarl\u0131 bir \u015fekilde yay\u0131l\u0131r \u2013 g\u00fcnl\u00fck esneme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f13\u6162\u800c\u7a33\u5b9a\u5730\u8513\u5ef6\u2014\u2014\u6bcf\u65e5\u62c9\u4f38"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7de9\u6162\u800c\u7a69\u5b9a\u5730\u50b3\u64ad - \u6bcf\u65e5\u62c9\u4f38"
          }
        }
      }
    },

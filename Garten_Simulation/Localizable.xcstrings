        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5ead\u306e\u53ef\u80fd\u6027\u3092\u6700\u5927\u9650\u306b\u5f15\u304d\u51fa\u3057\u307e\u3057\u3087\u3046\u3002"

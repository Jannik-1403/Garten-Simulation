    "pfad_lernen_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue deine tägliche Lesegewohnheit auf. Ein paar Seiten am Tag helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build your daily reading habit. A few pages a day help."
          }
        },
        "es": {

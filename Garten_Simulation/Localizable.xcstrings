    "item.zeitkapsel.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und stoppt den Verfall aller Pflanzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and stops decay for all plants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und stoppt den Verfall aller Pflanzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active imm\u00e9diatement et stoppe la d\u00e9gradation de toutes les plantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0930\u0902\u0924 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u092d\u0940 \u092a\u094c\u0927\u094b\u0902 \u0915\u093e \u0915\u094d\u0937\u092f \u0930\u094b\u0915 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and stops decay for all plants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u6d3b\u6027\u5316\u3057\u3001\u3059\u3079\u3066\u306e\u690d\u7269\u306e\u8150\u6557\u3092\u6b62\u3081\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uc5b4 \ubaa8\ub4e0 \uc2dd\ubb3c\uc758 \ubd80\ud328\ub97c \uba48\ucda5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en stopt het verval van alle planten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje si\u0119 aktywny natychmiast i zatrzymuje rozk\u0142ad wszystkich ro\u015blin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e para a degrada\u00e7\u00e3o de todas as plantas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0438 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0443\u0432\u044f\u0434\u0430\u043d\u0438\u0435 \u0432\u0441\u0435\u0445 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve t\u00fcm bitkilerde \u00e7\u00fcr\u00fcmeyi durdurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u963b\u6b62\u6240\u6709\u690d\u7269\u7684\u67af\u840e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u8b8a\u5f97\u6d3b\u8e8d\u4e26\u963b\u6b62\u6240\u6709\u690d\u7269\u7684\u8150\u721b\u3002"
          }
        }
      }
    },

    "plant.chrysantheme.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffe Ordnung in deiner Umgebung f\u00fcr einen klaren Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create order in your environment for a clear head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea orden en tu entorno para una mente despejada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cr\u00e9ez de l'ordre dans votre environnement pour un esprit clair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u0926\u093f\u092e\u093e\u0917 \u0938\u093e\u092b\u093c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0906\u0938-\u092a\u093e\u0938 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u092c\u0928\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea ordine nel tuo ambiente per una mente lucida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u982d\u3092\u3059\u3063\u304d\u308a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u74b0\u5883\u3092\u6574\u3048\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9d1\uc740 \uba38\ub9ac\ub97c \uc704\ud574 \ud658\uacbd\uc744 \uc815\ub9ac\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cre\u00eber orde in je omgeving voor een helder hoofd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zr\u00f3b porz\u0105dek w swoim otoczeniu dla czystego umys\u0142u."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie ordem no seu ambiente para uma mente clara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0432\u0435\u0434\u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0435\u0431\u044f \u0434\u043b\u044f \u044f\u0441\u043d\u043e\u0441\u0442\u0438 \u0443\u043c\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Berrak bir zihin i\u00e7in \u00e7evrenizde d\u00fczen yarat\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6574\u7406\u4f60\u7684\u73af\u5883\uff0c\u4fdd\u6301\u5934\u8111\u6e05\u9192\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5275\u9020\u5468\u906d\u74b0\u5883\u7684\u79e9\u5e8f\uff0c\u8b93\u4f60\u7684\u982d\u8166\u6e05\u9192\u3002"
          }
        }
      }
    },
    "plant.create.custom_symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {

    "weed.comeback.overlay.body" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine Unkraut-Plage gemeistert. Für %2$d Stunden erhältst du %1$@ XP pro Gießen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You conquered the weed crisis. For %2$d hours you earn %1$@ XP per watering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superaste la crisis de malas hierbas. Durante %2$d horas ganas %1$@ de XP por riego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as surmonté la crise d'herbes. Pendant %2$d heures : %1$@ d'XP par arrosage."
          }

    "assessment.growth.q11": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst bei einem Projekt mit anderen zusammenarbeiten. Deine Partner sind langsam und unzuverlässig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need to collaborate with others on a project. Your partners are slow and unreliable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas colaborar con otros en un proyecto. Tus socios son lentos y poco confiables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez collaborer avec d’autres sur un projet. Vos partenaires sont lents et peu fiables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi collaborare con altri su un progetto. I tuoi partner sono lenti e inaffidabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトでは他の人と協力する必要があります。あなたのパートナーは遅くて信頼できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트에서 다른 사람들과 협력해야 합니다. 귀하의 파트너는 느리고 신뢰할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet samenwerken met anderen aan een project. Uw partners zijn traag en onbetrouwbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musisz współpracować z innymi nad projektem. Twoi partnerzy są powolni i zawodni."

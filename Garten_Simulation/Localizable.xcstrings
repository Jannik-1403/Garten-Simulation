            "value": "친구들과 고정된 픽업 시간을 약속하세요 – 이것이 자리를 떠나도록 강제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek een vaste ophaalzeit af met vrienden – dat dwingt je om te vertrekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustal stałą godzinę odbioru z przyjaciółmi – to zmusi cię do wyjścia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine um horário fixo de busca com amigos – isso te obriga a sair."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine um horário fixo de busca com amigos – isso te obriga a sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Договоритесь с друзьями о фиксированном времени встречи — это вынудит вас уйти."

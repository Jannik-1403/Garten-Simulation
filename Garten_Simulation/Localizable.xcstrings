          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Gira la ruleta para empezar el d\u00eda!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la roue pour commencer la journ\u00e9e !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u093e \u0926\u093f\u0928 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u093f\u092f\u093e \u0918\u0941\u092e\u093e\u090f\u0901!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spin the wheel to start your day!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30db\u30a4\u30fc\u30eb\u3092\u56de\u3057\u3066\u4e00\u65e5\u3092\u59cb\u3081\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub8f0\ub81b\uc744 \ub3cc\ub824 \ud558\ub8e8\ub97c \uc2dc\uc791\ud574 \ubcf4\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai aan het wiel om uw dag te beginnen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakr\u0119\u0107 ko\u0142em, aby rozpocz\u0105\u0107 dzie\u0144!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira a roda para come\u00e7ar o dia!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0435\u0440\u043d\u0438 \u043a\u043e\u043b\u0435\u0441\u043e, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u0434\u0435\u043d\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcne ba\u015flamak i\u00e7in \u00e7ark\u0131 d\u00f6nd\u00fcr\u00fcn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f6c\u52a8\u8f6e\u5b50\uff0c\u5f00\u59cb\u65b0\u7684\u4e00\u5929\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f49\u52d5\u8f2a\u5b50\u958b\u59cb\u65b0\u7684\u4e00\u5929\uff01"
          }
        }
      }
    },

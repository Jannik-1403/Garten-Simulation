    "assessment.lifestyle.profile.gefangener.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Umfeld zieht dich nach unten. Du musst dein Netzwerk nicht von heute auf morgen wechseln – fang mit 1% Digitalisierung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your environment is pulling you down. You don’t have to change your network overnight – start with 1% digitization."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu entorno te está hundiendo. No es necesario que cambie su red de la noche a la mañana: comience con un 1 % de digitalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre environnement vous tire vers le bas. Vous n’êtes pas obligé de changer de réseau du jour au lendemain: commencez par 1 % de numérisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वातावरण आपको नीचे खींच रहा है। आपको अपना नेटवर्क रातों-रात बदलने की ज़रूरत नहीं है - 1% डिजिटलीकरण से शुरुआत करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ambiente ti sta buttando giù. Non devi cambiare la tua rete da un giorno all’altro: inizia con una digitalizzazione dell’1%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの環境があなたを引きずり下ろしています。ネットワークを一夜にして変更する必要はありません。まずは 1% のデジタル化から始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 환경이 당신을 끌어내리고 있습니다. 하루아침에 네트워크를 변경할 필요가 없습니다. 1% 디지털화부터 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je omgeving trekt je naar beneden. U hoeft uw netwerk niet van de ene op de andere dag te veranderen – begin met 1% digitalisering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje otoczenie ciągnie Cię w dół. Nie musisz zmieniać sieci z dnia na dzień – zacznij od cyfryzacji 1%."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ambiente está puxando você para baixo. Você não precisa mudar sua rede da noite para o dia – comece com 1% de digitalização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ambiente está puxando você para baixo. Você não precisa mudar sua rede da noite para o dia – comece com 1% de digitalização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твое окружение тянет тебя вниз. Тебе не нужно менять свою сеть с сегодняшнего дня на завтра – начни с 1% цифровизации."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevreniz sizi aşağı çekiyor. Ağınızı bir gecede değiştirmenize gerek yok; %1 dijitalleştirmeyle başlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的环境在拉你向下。你不必在一夜之间更换你的网络——从1%的数字化开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的環境正在拖垮你。您不必在一夜之間改變您的人脈——從 1% 的數位化開始。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.lifestyle.q6.c": {
      "localizations": {
        "de": {

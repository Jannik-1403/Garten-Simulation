    "trash.doomscrolling_handy.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade das Handy nachts in einem anderen Zimmer – nicht im Schlafzimmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge your phone at night in another room – not in the bedroom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el teléfono por la noche en otra habitación, no en el dormitorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge ton téléphone la nuit dans une autre pièce – pas dans la chambre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन को रात में दूसरे कमरे में चार्ज करें – बेडरूम में नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica il telefono di notte in un'altra stanza – non in camera da letto."
          }
        },

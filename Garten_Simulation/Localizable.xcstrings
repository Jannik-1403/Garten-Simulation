    "shop.purchase_success.powerup_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Garten unter Power-Ups antippen – dann auf „Benutzen“ tippen, um es einzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it under Power-Ups in your garden, then tap Use to activate it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tócalo en Power-Ups en tu jardín y luego pulsa Usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie dessus dans Power-Ups du jardin, puis sur Utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचे में पावर-अप्स पर टैप करें – फिर इसे इस्तेमाल करने के लिए 'उपयोग करें' पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccalo in Power-Ups nel giardino, poi premi Usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭のパワーアップの下でそれをタップし、「使用」をタップして有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원의 파워업 아래에서 탭한 다음 사용을 탭하여 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik erop onder Power-ups in je tuin en tik vervolgens op Gebruiken om het te activeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij w opcję Power-Ups w swoim ogrodzie, a następnie stuknij opcję Użyj, aby ją aktywować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Power-Ups no jardim e depois em Usar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Power-Ups no jardim e depois em Usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В саду нажмите на усиление — затем нажмите «Использовать», чтобы применить его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçenizdeki Güçlendirmeler altında buna dokunun, ardından etkinleştirmek için Kullan'a dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在花园中，点击“Power-Ups”下方 - 然后点击“使用”来使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在花園中，點擊「Power-Ups」下方 - 然後點擊「使用」來使用它。"
          }
        }
      }
    },

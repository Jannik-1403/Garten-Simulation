    "Level werden nur angezeigt, wenn ein tatsächlicher Levelstand gespeichert ist. XP werden nicht als Abschlüsse interpretiert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level werden nur angezeigt, wenn ein tatsächlicher Levelstand gespeichert ist. XP werden nicht als Abschlüsse interpretiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Levels are only displayed if an actual level is stored. XP is not counted as completions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los niveles solo se muestran si hay un nivel real guardado. La XP no se interpreta como finalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les niveaux ne s'affichent que si un niveau réel est enregistré. Les XP ne sont pas comptés comme des réalisations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्तर तभी प्रदर्शित होते हैं जब कोई वास्तविक स्तर संग्रहीत होता है। XP को पूर्णता के रूप में नहीं गिना जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I livelli vengono mostrati solo se è memorizzato un livello effettivo. Gli XP non vengono interpretati come completamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のレベルが保存されている場合のみレベルが表示されます。XPは完了としてカウントされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 레벨이 저장되어 있을 때만 레벨이 표시됩니다. XP는 완료 횟수로 계산되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveaus worden alleen weergegeven als er een actueel niveau is opgeslagen. XP wordt niet als voltooiing geteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziomy są wyświetlane tylko wtedy, gdy zapisany jest rzeczywisty poziom. PD nie są traktowane jako ukończenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os níveis só são apresentados se houver um nível real guardado. Os XP não contam como conclusões."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os níveis só são exibidos se houver um nível real salvo. O XP não é interpretado como conclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровни отображаются только при наличии сохраненного уровня. Очки опыта (XP) не считаются завершениями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seviyeler yalnızca gerçek bir seviye kaydedilmişse gösterilir. XP tamamlanma olarak sayılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在保存了实际等级时才会显示等级。经验值 (XP) 不会被视作完成次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在儲存了實際等級時才會顯示等級。經驗值 (XP) 不會被視作完成次數。"
          }
        }
      }
    },

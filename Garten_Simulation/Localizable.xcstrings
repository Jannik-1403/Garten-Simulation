    "assessment.finance.profile.impulsiver.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fchre die 24-Stunden-Regel ein: Jede ungeplante Ausgabe \u00fcber 50\u20ac wird erst einen Tag sp\u00e4ter get\u00e4tigt. Ohne Ausnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce the 24-hour rule: Any unplanned expense over \u20ac50 will only be made one day later. Without exception."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la regla de las 24 horas: Cualquier gasto no planificado superior a 50\u20ac s\u00f3lo se realizar\u00e1 un d\u00eda despu\u00e9s. Sin excepci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduisez la r\u00e8gle des 24 heures : toute d\u00e9pense impr\u00e9vue sup\u00e9rieure \u00e0 50 \u20ac ne sera effectu\u00e9e qu'un jour plus tard. Sans exception."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 \u0918\u0902\u091f\u0947 \u0915\u093e \u0928\u093f\u092f\u092e \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902: \u20ac50 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u093e \u0915\u094b\u0908 \u092d\u0940 \u0905\u0928\u093f\u092f\u094b\u091c\u093f\u0924 \u0916\u0930\u094d\u091a \u0915\u0947\u0935\u0932 \u090f\u0915 \u0926\u093f\u0928 \u092c\u093e\u0926 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0905\u092a\u0935\u093e\u0926 \u0915\u0947 \u092c\u093f\u0928\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Introducete la regola delle 24 ore: qualsiasi spesa non pianificata superiore a 50 \u20ac verr\u00e0 effettuata solo un giorno dopo. Senza eccezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24 \u6642\u9593\u30eb\u30fc\u30eb\u3092\u5c0e\u5165\u3057\u307e\u3059\u300250 \u30e6\u30fc\u30ed\u3092\u8d85\u3048\u308b\u4e88\u5b9a\u5916\u306e\u51fa\u8cbb\u306f 1 \u65e5\u5f8c\u306b\u306e\u307f\u767a\u751f\u3057\u307e\u3059\u3002\u4f8b\u5916\u306a\u304f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24\uc2dc\uac04 \uaddc\uce59\uc744 \ub3c4\uc785\ud558\uc138\uc694. \u20ac50\ub97c \ucd08\uacfc\ud558\ub294 \uacc4\ud68d\ub418\uc9c0 \uc54a\uc740 \ube44\uc6a9\uc740 \ud558\ub8e8 \ud6c4\uc5d0\ub9cc \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uc608\uc678\uc5c6\uc774."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de 24-uursregel in: ongeplande uitgaven boven \u20ac 50,- worden pas een dag later gedaan. Zonder uitzondering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowad\u017a zasad\u0119 24 godzin: ka\u017cdy nieplanowany wydatek przekraczaj\u0105cy 50 euro zostanie zrealizowany dopiero dzie\u0144 p\u00f3\u017aniej. Bezwyj\u0105tkowo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a regra das 24 horas: Qualquer despesa n\u00e3o planeada superior a 50\u20ac s\u00f3 ser\u00e1 feita um dia depois. Sem exce\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0432\u0435\u0434\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u043e 24 \u0447\u0430\u0441\u043e\u0432: \u043a\u0430\u0436\u0434\u0430\u044f \u043d\u0435\u0437\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0442\u0440\u0430\u0442\u0430 \u0441\u0432\u044b\u0448\u0435 50\u20ac \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0435\u043d\u044c. \u0411\u0435\u0437 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 saat kural\u0131n\u0131 getirin: 50 \u20ac'yu a\u015fan planlanmam\u0131\u015f harcamalar yaln\u0131zca bir g\u00fcn sonra yap\u0131lacakt\u0131r. \u0130stisnas\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f15\u516524\u5c0f\u65f6\u89c4\u5219\uff1a\u6bcf\u4e00\u7b14\u8d85\u8fc750\u6b27\u5143\u7684\u672a\u8ba1\u5212\u652f\u51fa\u90fd\u8981\u63a8\u8fdf\u4e00\u5929\u8fdb\u884c\u3002\u6ca1\u6709\u4f8b\u5916\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f15\u5165 24 \u5c0f\u6642\u898f\u5247\uff1a\u4efb\u4f55\u8d85\u904e 50 \u6b50\u5143\u7684\u8a08\u5283\u5916\u8cbb\u7528\u53ea\u80fd\u5728\u4e00\u5929\u5f8c\u652f\u4ed8\u3002\u7121\u4e00\u4f8b\u5916\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.impulsiver.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe nie hungrig oder extrem gestresst einkaufen \u2013 das 1\uff05 extra Stress f\u00fchrt zu 50\uff05 mehr Ausgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never go shopping hungry or extremely stressed - that 1\uff05 extra stress leads to 50\uff05 more spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vayas de compras con hambre o muy estresado: ese 1 \uff05 de estr\u00e9s adicional genera un 50 \uff05 m\u00e1s de gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne faites jamais vos courses le ventre vide ou extr\u00eamement stress\u00e9 : 1 \uff05 de stress suppl\u00e9mentaire entra\u00eene 50 \uff05 de d\u00e9penses en plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092d\u0940 \u092d\u0940 \u092d\u0942\u0916\u0947 \u092a\u0947\u091f \u092f\u093e \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0924\u0928\u093e\u0935 \u092e\u0947\u0902 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0930\u0928\u0947 \u0928 \u091c\u093e\u090f\u0902 - 1\uff05 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0924\u0928\u093e\u0935 50\uff05 \u0905\u0927\u093f\u0915 \u0916\u0930\u094d\u091a \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0928\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non andare mai a fare shopping affamato o estremamente stressato: quell'1\uff05 di stress in pi\u00f9 porta a una spesa maggiore del 50\uff05."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7a7a\u8179\u3084\u6975\u5ea6\u306e\u30b9\u30c8\u30ec\u30b9\u3092\u62b1\u3048\u305f\u72b6\u614b\u3067\u8cb7\u3044\u7269\u306b\u884c\u304f\u306e\u306f\u7d76\u5bfe\u306b\u3084\u3081\u3066\u304f\u3060\u3055\u3044\u30021\uff05 \u306e\u4f59\u5206\u306a\u30b9\u30c8\u30ec\u30b9\u304c 50\uff05 \u306e\u652f\u51fa\u5897\u52a0\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc30\uace0\ud504\uac70\ub098 \uadf9\uc2ec\ud55c \uc2a4\ud2b8\ub808\uc2a4\ub97c \ubc1b\uc73c\uba70 \uc1fc\ud551\ud558\uc9c0 \ub9c8\uc138\uc694. 1\uff05\uc758 \ucd94\uac00 \uc2a4\ud2b8\ub808\uc2a4\ub85c \uc778\ud574 50\uff05 \ub354 \ub9ce\uc740 \uc9c0\ucd9c\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga nooit hongerig of extreem gestresst winkelen: 1\uff05 extra stress leidt tot 50\uff05 meer bestedingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie chod\u017a na zakupy g\u0142odny ani bardzo zestresowany \u2013 1\uff05 dodatkowego stresu prowadzi do 50\uff05 wi\u0119kszych wydatk\u00f3w."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca v\u00e1 \u00e0s compras com fome ou extremamente estressado \u2013 esse 1\uff05 de estresse extra leva a 50\uff05 mais gastos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0445\u043e\u0434\u0438\u0442\u0435 \u0437\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0430\u043c\u0438 \u0433\u043e\u043b\u043e\u0434\u043d\u044b\u043c \u0438\u043b\u0438 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043a\u0440\u0430\u0439\u043d\u0435\u0433\u043e \u0441\u0442\u0440\u0435\u0441\u0441\u0430 \u2013 1\uff05 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0435\u0441\u0441\u0430 \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a 50\uff05 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0440\u0430\u0441\u0445\u043e\u0434\u0430\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla a\u00e7 veya a\u015f\u0131r\u0131 stresli bir \u015fekilde al\u0131\u015fveri\u015fe gitmeyin; \uff051 ekstra stres \uff0550 daha fazla harcamaya yol a\u00e7ar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5207\u52ff\u5728\u9965\u997f\u6216\u6781\u5ea6\u538b\u529b\u4e0b\u8d2d\u7269\u2014\u2014\u989d\u59161\uff05\u7684\u538b\u529b\u4f1a\u5bfc\u81f450\uff05\u7684\u989d\u5916\u652f\u51fa\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c38\u9060\u4e0d\u8981\u9913\u8457\u809a\u5b50\u6216\u58d3\u529b\u904e\u5927\u53bb\u8cfc\u7269 - 1\uff05 \u7684\u984d\u5916\u58d3\u529b\u6703\u5c0e\u81f4 50\uff05 \u7684\u984d\u5916\u652f\u51fa\u3002"
          }
        }
      }
    },
    "assessment.finance.profile.impulsiver.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6sche deine Kreditkartendaten aus der Auto-Fill-Funktion deines Browsers. Die 10 Sekunden, um die Karte zu holen, stoppen 80\uff05 deiner Impulsk\u00e4ufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your credit card information from your browser's autofill feature. The 10 seconds to get the card stops 80\uff05 of your impulse purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine la informaci\u00f3n de su tarjeta de cr\u00e9dito de la funci\u00f3n de autocompletar de su navegador. Los 10 segundos para conseguir la tarjeta frenan el 80\uff05 de tus compras impulsivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les informations de votre carte de cr\u00e9dit de la fonction de saisie automatique de votre navigateur. Les 10 secondes pour obtenir la carte stoppent 80\uff05 de vos achats impulsifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u0915\u0940 \u0911\u091f\u094b\u092b\u093c\u093f\u0932 \u0938\u0941\u0935\u093f\u0927\u093e \u0938\u0947 \u0905\u092a\u0928\u0947 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0939\u091f\u093e\u090f\u0901\u0964 \u0915\u093e\u0930\u094d\u0921 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 10 \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 80\uff05 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0930\u0941\u0915 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i dati della tua carta di credito dalla funzione di compilazione automatica del browser. I 10 secondi per ottenere la carta bloccano l'80\uff05 dei tuoi acquisti d'impulso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d6\u30e9\u30a6\u30b6\u306e\u81ea\u52d5\u5165\u529b\u6a5f\u80fd\u304b\u3089\u30af\u30ec\u30b8\u30c3\u30c8 \u30ab\u30fc\u30c9\u60c5\u5831\u3092\u524a\u9664\u3057\u307e\u3059\u3002\u30ab\u30fc\u30c9\u3092\u53d6\u5f97\u3059\u308b\u307e\u3067\u306e 10 \u79d2\u3067\u3001\u885d\u52d5\u8cb7\u3044\u306e 80\uff05 \u304c\u963b\u6b62\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube0c\ub77c\uc6b0\uc800\uc758 \uc790\ub3d9\uc644\uc131 \uae30\ub2a5\uc5d0\uc11c \uc2e0\uc6a9\uce74\ub4dc \uc815\ubcf4\ub97c \uc0ad\uc81c\ud558\uc138\uc694. \uce74\ub4dc\ub97c \ubc1b\ub294 \ub370 10\ucd08\uac00 \uac78\ub9ac\uba74 \ucda9\ub3d9 \uad6c\ub9e4\uc758 80\uff05\uac00 \uc911\ub2e8\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder uw creditcardgegevens uit de functie voor automatisch aanvullen van uw browser. De 10 seconden om de kaart te krijgen, stopt 80\uff05 van uw impulsaankopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usu\u0144 informacje o karcie kredytowej z funkcji automatycznego uzupe\u0142niania w przegl\u0105darce. 10 sekund na otrzymanie karty zatrzymuje 80\uff05 zakup\u00f3w impulsywnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua as informa\u00e7\u00f5es do seu cart\u00e3o de cr\u00e9dito do recurso de preenchimento autom\u00e1tico do seu navegador. Os 10 segundos para obter o cart\u00e3o interrompem 80\uff05 de suas compras por impulso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0441\u0432\u043e\u0435\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u044b \u0438\u0437 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0430\u0432\u0442\u043e\u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0432\u0430\u0448\u0435\u0433\u043e \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430. \u0422\u0435 10 \u0441\u0435\u043a\u0443\u043d\u0434, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0430\u0442\u044c \u043a\u0430\u0440\u0442\u0443, \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442 80\uff05 \u0432\u0430\u0448\u0438\u0445 \u0438\u043c\u043f\u0443\u043b\u044c\u0441\u0438\u0432\u043d\u044b\u0445 \u043f\u043e\u043a\u0443\u043f\u043e\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taray\u0131c\u0131n\u0131z\u0131n otomatik doldurma \u00f6zelli\u011finden kredi kart\u0131 bilgilerinizi silin. Kart\u0131 almak i\u00e7in 10 saniye, anl\u0131k al\u0131\u015fveri\u015flerinizin \uff0580'ini durdurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u4f60\u6d4f\u89c8\u5668\u7684\u81ea\u52a8\u586b\u5199\u529f\u80fd\u4e2d\u5220\u9664\u4f60\u7684\u4fe1\u7528\u5361\u4fe1\u606f\u3002\u82b110\u79d2\u949f\u53bb\u62ff\u4fe1\u7528\u5361\u53ef\u4ee5\u963b\u6b62\u4f6080\uff05\u7684\u51b2\u52a8\u8d2d\u7269\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u700f\u89bd\u5668\u7684\u81ea\u52d5\u586b\u5165\u529f\u80fd\u4e2d\u522a\u9664\u60a8\u7684\u4fe1\u7528\u5361\u8cc7\u8a0a\u3002\u8fa6\u5361\u7684 10 \u79d2\u53ef\u4ee5\u963b\u6b62\u60a8 80\uff05 \u7684\u885d\u52d5\u8cfc\u8cb7\u3002"
          }
        }
      }
    },

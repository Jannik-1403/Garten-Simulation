    "prog_screentime_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dein Handy-Display heute in den Einstellungen komplett auf Schwarz-Weiß. Beobachte, wie der Dopamin-Drang sinkst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your cell phone display to completely black and white in the settings today. Watch the dopamine urge decrease."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure la pantalla de su teléfono celular completamente en blanco y negro en la configuración hoy. Observe cómo disminuye el impulso de dopamina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez l'écran de votre téléphone portable en noir et blanc dans les paramètres dès aujourd'hui. Observez la diminution du besoin de dopamine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज ही सेटिंग्स में अपने सेल फोन के डिस्प्ले को पूरी तरह से काले और सफेद पर सेट करें। डोपामाइन आग्रह में कमी देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta oggi stesso il display del tuo cellulare su completamente in bianco e nero nelle impostazioni. Guarda diminuire la voglia di dopamina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ設定で携帯電話のディスプレイを完全に白黒に設定してください。ドーパミンの衝動が減少するのを観察してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 설정에서 휴대폰 디스플레이를 완전 흑백으로 설정해보세요. 도파민 충동이 감소하는 것을 지켜보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel het display van uw mobiele telefoon vandaag nog in op volledig zwart-wit in de instellingen. Zie hoe de dopaminedrang afneemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już dziś ustaw w ustawieniach swój telefon komórkowy na całkowicie czarno-biały. Obserwuj, jak zmniejsza się zapotrzebowanie na dopaminę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a tela do seu celular para totalmente preto e branco nas configurações hoje. Observe a diminuição do desejo de dopamina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a tela do seu celular para totalmente preto e branco nas configurações hoje. Observe a diminuição do desejo de dopamina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня в настройках вашего мобильного телефона сделайте полностью черно-белый дисплей. Наблюдайте за уменьшением потребности в дофамине."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün ayarlarda cep telefonunuzun ekranını tamamen siyah beyaza ayarlayın. Dopamin dürtüsünün azalmasını izleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即在设置中将手机显示屏设置为完全黑白。观察多巴胺冲动的减少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即在設定中將手機顯示幕設定為完全黑白。觀察多巴胺衝動的減少。"
          }
        }
      }
    },

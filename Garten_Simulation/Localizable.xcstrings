          }
        }
      }
    },
    "assessment.fitness.q2" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du zahlst seit 6 Monaten 50€ für ein Gym, warst aber diesen Monat erst ein einziges Mal dort. Was sagst du dir selbst?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've been paying €50 for a gym for 6 months, but you've only been there once this month. What are you telling yourself?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas 6 meses pagando 50€ por un gimnasio, pero este mes solo has estado una vez. ¿Qué te estás diciendo a ti mismo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous payez 50 € pour une salle de sport depuis 6 mois, mais vous n'y êtes allé qu'une fois ce mois-ci. Qu'est-ce que tu te dis ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप 6 महीने से जिम के लिए €50 का भुगतान कर रहे हैं, लेकिन आप इस महीने केवल एक बार वहां गए हैं। आप अपने आप से क्या कह रहे हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono 6 mesi che paghi 50€ per una palestra, ma questo mese ci sei stato solo una volta. Cosa stai dicendo a te stesso?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたはジムに 6 か月間 50 ユーロ払っていますが、今月は 1 回しか行っていません。自分に何を言い聞かせていますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 6개월 동안 체육관 비용으로 €50를 지불했지만 이번 달에는 체육관에 한 번만 가봤습니다. 당신은 스스로에게 무엇을 말하고 있습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt al 6 maanden € 50,- voor een sportschool, maar je bent er deze maand maar één keer geweest. Wat vertel je jezelf?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płacisz 50 euro za siłownię od 6 miesięcy, ale byłeś tam tylko raz w tym miesiącu. Co sobie mówisz?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há 6 meses que pagas 50€ por um ginásio, mas só estiveste lá uma vez este mês. O que você está dizendo a si mesmo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты платишь 50€ за спортзал уже 6 месяцев, но в этом месяце был там всего один раз. Что ты себе говоришь?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 aydır spor salonuna 50€ ödüyorsunuz ama bu ay sadece bir kez oraya gittiniz. Kendine ne söylüyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已经为一个健身房支付了6个月的费用，每月50欧元，但这个月你只去过一次。你对自己说什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已經花費 50 歐元去健身房 6 個月了，但這個月您只去過一次。你在告訴自己什麼？"
          }
        }
      }
    },

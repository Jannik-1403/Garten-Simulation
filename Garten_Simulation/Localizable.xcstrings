    "streak.freeze.used.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Streak Freeze hat deinen Streak heute gerettet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Streak Freeze saved your streak today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Protector de Racha salv\u00f3 tu racha hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton Gel de s\u00e9rie a sauv\u00e9 ta s\u00e9rie aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u092b\u094d\u0930\u0940\u091c\u093c \u0906\u091c \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0947 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u0915\u094b \u092c\u091a\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Streak Freeze ha salvato la tua serie oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306e\u30b9\u30c8\u30ea\u30fc\u30af\u30d5\u30ea\u30fc\u30ba\u306f\u3042\u306a\u305f\u306e\u30b9\u30c8\u30ea\u30fc\u30af\u3092\u4fdd\u5b58\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Streak Freeze\uac00 \uc624\ub298 \uc5f0\uc18d \uae30\ub85d\uc744 \uc800\uc7a5\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Streak Freeze heeft je streak vandaag gered."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje Zamro\u017cenie Strefy uratowa\u0142o Twoj\u0105 dzisiejsz\u0105 pass\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu Protetor de Sequ\u00eancia salvou a tua sequ\u00eancia hoje."
          }
        },
        "ru": {

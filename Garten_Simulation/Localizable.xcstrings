    "garden.plant.dead.alert.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Pflanze wurde leider zu lange nicht gegossen und ist eingegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plant unfortunately died due to a lack of water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta muri\u00f3 desafortunadamente por falta de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette plante est malheureusement morte par manque d'eau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0930\u094d\u092d\u093e\u0917\u094d\u092f \u0938\u0947, \u0907\u0938 \u092a\u094c\u0927\u0947 \u0915\u094b \u092c\u0939\u0941\u0924 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0924\u0915 \u092a\u093e\u0928\u0940 \u0928\u0939\u0940\u0902 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u092f\u0939 \u092e\u0930 \u0917\u092f\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This plant unfortunately died due to a lack of water."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u690d\u7269\u306f\u6b8b\u5ff5\u306a\u304c\u3089\u6c34\u4e0d\u8db3\u3067\u67af\u308c\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc548\ud0c0\uae5d\uac8c\ub3c4 \uc774 \uc2dd\ubb3c\uc740 \ubb3c \ubd80\uc871\uc73c\ub85c \uc778\ud574 \uc8fd\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze plant is helaas gestorven door gebrek aan water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015blina ta niestety usch\u0142a z powodu braku wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta planta infelizmente morreu por falta de \u00e1gua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0434\u043e\u043b\u0433\u043e \u043d\u0435 \u043f\u043e\u043b\u0438\u0432\u0430\u043b\u0438 \u0438 \u043e\u043d\u043e \u043f\u043e\u0433\u0438\u0431\u043b\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bitki ne yaz\u0131k ki susuzluktan dolay\u0131 \u00f6ld\u00fc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u682a\u690d\u7269\u5f88\u9057\u61be\u56e0\u4e3a\u957f\u65f6\u95f4\u672a\u6d47\u6c34\u800c\u67af\u840e\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u5e78\u7684\u662f\uff0c\u9019\u68f5\u690d\u7269\u6c92\u6709\u6f86\u6c34\u592a\u4e45\uff0c\u5c31\u6b7b\u4e86\u3002"
          }
        }
      }
    },

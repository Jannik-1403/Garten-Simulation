    "assessment.health.profile.erschoepfer.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf ist keine Schw\u00e4che \u2014 es ist das einzige Upgrade, das dein Gehirn kostenlos bekommt. Fang heute damit an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep isn't a weakness \u2014 it's the only upgrade your brain gets for free. Start it today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir no es una debilidad: es la \u00fanica mejora que tu cerebro obtiene de forma gratuita. Empiece hoy mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sommeil n'est pas une faiblesse : c'est la seule am\u00e9lioration dont votre cerveau b\u00e9n\u00e9ficie gratuitement. Commencez-le aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0940\u0902\u0926 \u0915\u094b\u0908 \u0915\u092e\u091c\u094b\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948 - \u092f\u0939 \u0906\u092a\u0915\u0947 \u092e\u0938\u094d\u0924\u093f\u0937\u094d\u0915 \u0915\u094b \u092e\u0941\u092b\u094d\u0924 \u092e\u0947\u0902 \u092e\u093f\u0932\u0928\u0947 \u0935\u093e\u0932\u093e \u090f\u0915\u092e\u093e\u0924\u094d\u0930 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0906\u091c \u0939\u0940 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sonno non \u00e8 una debolezza: \u00e8 l'unico potenziamento che il tuo cervello riceve gratuitamente. Inizialo oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7761\u7720\u306f\u5f31\u70b9\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u7761\u7720\u306f\u3001\u8133\u304c\u7121\u6599\u3067\u5f97\u3089\u308c\u308b\u552f\u4e00\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3067\u3059\u3002\u4eca\u65e5\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc218\uba74\uc740 \uc57d\uc810\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uc218\uba74\uc740 \ub450\ub1cc\uac00 \ubb34\ub8cc\ub85c \uc5bb\uc744 \uc218 \uc788\ub294 \uc720\uc77c\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\uc785\ub2c8\ub2e4. \uc624\ub298 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaap is geen zwakte; het is de enige upgrade die je hersenen gratis krijgen. Begin er vandaag mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen nie jest s\u0142abo\u015bci\u0105 \u2014 to jedyne ulepszenie, kt\u00f3re Tw\u00f3j m\u00f3zg otrzymuje za darmo. Zacznij ju\u017c dzi\u015b."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O sono n\u00e3o \u00e9 uma fraqueza \u2013 \u00e9 a \u00fanica atualiza\u00e7\u00e3o que seu c\u00e9rebro recebe de gra\u00e7a. Comece hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u043d \u2014 \u044d\u0442\u043e \u043d\u0435 \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c, \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0430\u0448 \u043c\u043e\u0437\u0433 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e. \u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku bir zay\u0131fl\u0131k de\u011fildir; beyninizin \u00fccretsiz olarak elde etti\u011fi tek y\u00fckseltmedir. Bug\u00fcn ba\u015flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7761\u7720\u4e0d\u662f\u5f31\u70b9\u2014\u2014\u5b83\u662f\u4f60\u5927\u8111\u552f\u4e00\u514d\u8d39\u83b7\u5f97\u7684\u5347\u7ea7\u3002\u4ece\u4eca\u5929\u5f00\u59cb\u5427\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7761\u7720\u4e0d\u662f\u5f31\u9ede\u2014\u2014\u5b83\u662f\u4f60\u7684\u5927\u8166\u552f\u4e00\u514d\u8cbb\u7372\u5f97\u7684\u5347\u7d1a\u3002\u4eca\u5929\u5c31\u958b\u59cb\u5427\u3002"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke morgens dein erstes Glas Wasser, BEVOR du den Knopf der Kaffeemaschine dr\u00fcckst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink your first glass of water in the morning BEFORE you press the button on the coffee machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe tu primer vaso de agua por la ma\u00f1ana ANTES de pulsar el bot\u00f3n de la cafetera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez votre premier verre d'eau le matin AVANT d'appuyer sur le bouton de la machine \u00e0 caf\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u092c\u0939 \u0915\u0949\u092b\u0940 \u092e\u0936\u0940\u0928 \u0915\u093e \u092c\u091f\u0928 \u0926\u092c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u092a\u0939\u0932\u093e \u0917\u093f\u0932\u093e\u0938 \u092a\u093e\u0928\u0940 \u092a\u093f\u092f\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi il tuo primo bicchiere d'acqua al mattino PRIMA di premere il pulsante della macchina da caff\u00e8."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u671d\u3001\u30b3\u30fc\u30d2\u30fc\u30de\u30b7\u30f3\u306e\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u524d\u306b\u3001\u6700\u521d\u306e\u6c34\u3092\u4e00\u676f\u98f2\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uce68\uc5d0 \ucee4\ud53c \uba38\uc2e0\uc758 \ubc84\ud2bc\uc744 \ub204\ub974\uae30 \uc804\uc5d0 \uccab \ubc88\uc9f8 \ubb3c \ud55c \uc794\uc744 \ub9c8\uc2dc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink 's ochtends uw eerste glas water VOORDAT u op de knop van de koffiemachine drukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsz\u0105 szklank\u0119 wody wypij rano ZANIM naci\u015bniesz przycisk na ekspresie do kawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba seu primeiro copo de \u00e1gua pela manh\u00e3 ANTES de apertar o bot\u00e3o da cafeteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0439 \u0443\u0442\u0440\u043e\u043c \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u0442\u0430\u043a\u0430\u043d \u0432\u043e\u0434\u044b, \u041f\u0420\u0415\u0416\u0414\u0415 \u0447\u0435\u043c \u043d\u0430\u0436\u043c\u0451\u0448\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u043a\u043e\u0444\u0435\u043c\u0430\u0448\u0438\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabahlar\u0131 ilk bardak suyunuzu kahve makinesinin tu\u015funa basmadan \u00d6NCE i\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u4e0a\u5728\u6309\u4e0b\u5496\u5561\u673a\u6309\u94ae\u4e4b\u524d\uff0c\u5148\u559d\u4f60\u7684\u7b2c\u4e00\u676f\u6c34\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u4e0a\u6309\u5496\u5561\u6a5f\u6309\u9215\u524d\u559d\u7b2c\u4e00\u676f\u6c34\u3002"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle einen 'Schlaf-Wecker' um 21:45 Uhr. Wenn er klingelt, machst du nur das Deckenlicht aus und eine Leselampe an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a 'sleep alarm' at 9:45 p.m. When the doorbell rings, you just turn off the overhead light and turn on a reading lamp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure una 'alarma de sue\u00f1o' a las 9:45 p.m. Cuando suena el timbre, simplemente apaga la luz del techo y enciende una l\u00e1mpara de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9glez une \u00ab\u00a0alarme de sommeil\u00a0\u00bb \u00e0 21h45. Lorsque la sonnette retentit, il vous suffit d\u2019\u00e9teindre le plafonnier et d\u2019allumer une lampe de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093e\u0924 9:45 \u092c\u091c\u0947 '\u0938\u094d\u0932\u0940\u092a \u0905\u0932\u093e\u0930\u094d\u092e' \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u091c\u092c \u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u0915\u0940 \u0918\u0902\u091f\u0940 \u092c\u091c\u0924\u0940 \u0939\u0948, \u0924\u094b \u0906\u092a \u092c\u0938 \u0913\u0935\u0930\u0939\u0947\u0921 \u0932\u093e\u0907\u091f \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0902 \u0914\u0930 \u0930\u0940\u0921\u093f\u0902\u0917 \u0932\u0948\u0902\u092a \u091a\u093e\u0932\u0942 \u0915\u0930 \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta una \"sveglia sonno\" alle 21:45. Quando suona il campanello, basta spegnere la luce e accendere una lampada da lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5348\u5f8c9\u664245\u5206\u306b\u300c\u7761\u7720\u30a2\u30e9\u30fc\u30e0\u300d\u3092\u30bb\u30c3\u30c8\u3057\u307e\u3059\u3002\u30c9\u30a2\u30db\u30f3\u304c\u9cf4\u3063\u305f\u3089\u3001\u982d\u4e0a\u306e\u7167\u660e\u3092\u6d88\u3057\u3066\u8aad\u66f8\u706f\u3092\u70b9\u706f\u3059\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ud6c4 9\uc2dc 45\ubd84\uc5d0 '\uc218\uba74 \uc54c\ub78c'\uc744 \uc124\uc815\ud574 \uc8fc\uc138\uc694. \ucd08\uc778\uc885\uc774 \uc6b8\ub9ac\uba74 \uba38\ub9ac \uc704 \uc870\uba85\uc744 \ub044\uace0 \ub3c5\uc11c\ub4f1\ub9cc \ucf1c\uba74 \ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een 'slaapwekker' om 21.45 uur. Als de deurbel gaat, doe je gewoon het plafondlicht uit en zet je een leeslamp aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw \u201ebudzik snu\u201d na 21:45. Kiedy zadzwoni dzwonek do drzwi, po prostu zga\u015b g\u00f3rne \u015bwiat\u0142o i w\u0142\u0105cz lampk\u0119 do czytania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um \u2018alarme de sono\u2019 para 21h45. Quando a campainha tocar, basta desligar a luz do teto e acender uma l\u00e2mpada de leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438 \u00ab\u0431\u0443\u0434\u0438\u043b\u044c\u043d\u0438\u043a \u0434\u043b\u044f \u0441\u043d\u0430\u00bb \u043d\u0430 21:45. \u041a\u043e\u0433\u0434\u0430 \u043e\u043d \u0437\u0430\u0437\u0432\u043e\u043d\u0438\u0442, \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u043a\u043b\u044e\u0447\u0438 \u043f\u043e\u0442\u043e\u043b\u043e\u0447\u043d\u044b\u0439 \u0441\u0432\u0435\u0442 \u0438 \u0432\u043a\u043b\u044e\u0447\u0438 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043d\u0443\u044e \u043b\u0430\u043c\u043f\u0443 \u0434\u043b\u044f \u0447\u0442\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "21:45'e bir 'uyku alarm\u0131' kurun. Kap\u0131 zili \u00e7ald\u0131\u011f\u0131nda tavandaki \u0131\u015f\u0131\u011f\u0131 kapat\u0131p okuma lambas\u0131n\u0131 a\u00e7man\u0131z yeterli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e\u4e00\u4e2a\u201c\u7761\u7720\u95f9\u949f\u201d\u572821:45\u3002\u5f53\u5b83\u54cd\u65f6\uff0c\u4f60\u53ea\u9700\u5173\u6389\u9876\u706f\uff0c\u5f00\u4e00\u76cf\u9605\u8bfb\u706f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u665a\u4e0a 9:45 \u8a2d\u5b9a\u300c\u7761\u7720\u9b27\u9418\u300d\u7576\u9580\u9234\u97ff\u8d77\u6642\uff0c\u60a8\u53ea\u9700\u95dc\u9589\u9802\u71c8\u4e26\u6253\u958b\u95b1\u8b80\u71c8\u5373\u53ef\u3002"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Regeneration ist mangelhaft. Anstatt direkt 8 Stunden Schlaf zu erzwingen, etablieren wir eine 1\uff05-Reibung vor dem Schlafengehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your regeneration is inadequate. Instead of directly forcing 8 hours of sleep, we establish a 1\uff05 rub before bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regeneraci\u00f3n es inadecuada. En lugar de forzar directamente 8 horas de sue\u00f1o, establecemos una frotaci\u00f3n del 1\uff05 antes de acostarnos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre r\u00e9g\u00e9n\u00e9ration est insuffisante. Au lieu de forcer directement 8 heures de sommeil, on \u00e9tablit un frottement \u00e0 1\uff05 avant de se coucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u0928 \u0905\u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0939\u0948. \u0938\u0940\u0927\u0947 \u0924\u094c\u0930 \u092a\u0930 8 \u0918\u0902\u091f\u0947 \u0915\u0940 \u0928\u0940\u0902\u0926 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0927\u094d\u092f \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u091c\u093e\u092f, \u0939\u092e \u0938\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 1\uff05 \u0930\u0917\u0921\u093c\u0928\u093e \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua rigenerazione \u00e8 inadeguata. Invece di forzare direttamente 8 ore di sonno, stabiliamo un massaggio dell\u20191\uff05 prima di andare a letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u518d\u751f\u80fd\u529b\u306f\u4e0d\u5341\u5206\u3067\u3059\u3002 8\u6642\u9593\u306e\u7761\u7720\u3092\u76f4\u63a5\u5f37\u5236\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u5c31\u5bdd\u524d\u306b1\uff05\u306e\u30de\u30c3\u30b5\u30fc\u30b8\u3092\u78ba\u7acb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc7ac\uc0dd\uc740 \ubd88\ucda9\ubd84\ud569\ub2c8\ub2e4. \uc9c1\uc811\uc801\uc73c\ub85c 8\uc2dc\uac04\uc758 \uc218\uba74\uc744 \uac15\uc694\ud558\ub294 \ub300\uc2e0, \uc7a0\uc790\ub9ac\uc5d0 \ub4e4\uae30 \uc804 1\uff05\uc758 \ubb38\uc9c0\ub984\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw wedergeboorte is ontoereikend. In plaats van direct 8 uur slaap af te dwingen, wrijven we voor het slapengaan een massage van 1\uff05 in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja regeneracja jest niewystarczaj\u0105ca. Zamiast bezpo\u015brednio wymusza\u0107 8 godzin snu, ustalamy 1\uff05 nacieranie przed snem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua regenera\u00e7\u00e3o \u00e9 inadequada. Em vez de for\u00e7ar diretamente 8 horas de sono, estabelecemos uma massagem de 1\uff05 antes de dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u0435\u0431\u044f \u0441\u043f\u0430\u0442\u044c \u043f\u0440\u044f\u043c\u043e 8 \u0447\u0430\u0441\u043e\u0432, \u043c\u044b \u0432\u0432\u043e\u0434\u0438\u043c 1\uff05-\u043d\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0434 \u0441\u043d\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilenmeniz yetersiz. Do\u011frudan 8 saatlik uykuyu zorlamak yerine yatmadan \u00f6nce \uff051'lik bir ovma olu\u015fturuyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u6062\u590d\u80fd\u529b\u4e0d\u8db3\u3002\u4e0e\u5176\u5f3a\u8feb\u81ea\u5df1\u76f4\u63a5\u7761\u8db38\u5c0f\u65f6\uff0c\u6211\u4eec\u4e0d\u5982\u5728\u7761\u524d\u5efa\u7acb1\uff05\u7684\u6469\u64e6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u518d\u751f\u80fd\u529b\u4e0d\u5920\u3002\u6211\u5011\u6c92\u6709\u76f4\u63a5\u5f37\u5236\u7761\u7720 8 \u5c0f\u6642\uff0c\u800c\u662f\u5728\u7761\u524d\u9032\u884c 1\uff05 \u7684\u6309\u6469\u3002"
          }
        }
      }
    },
    "assessment.health.profile.erschoepfer.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ersch\u00f6pfer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Creator"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Creador"
          }
        },
        "fr": {

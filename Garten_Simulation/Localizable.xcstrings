        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every unit, every weight and every time is logged precisely. Without data, there is no growth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada unidad, cada peso y cada tiempo se registran con precisión. Sin datos no hay crecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque unité, chaque poids et chaque temps sont enregistrés avec précision. Sans données, pas de croissance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक इकाई, प्रत्येक भार और प्रत्येक समय को सटीक रूप से लॉग किया जाता है। डेटा के बिना कोई विकास नहीं होता."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni unità, ogni peso e ogni tempo vengono registrati con precisione. Senza dati non c’è crescita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての単位、すべての重量、すべての時間が正確に記録されます。データがなければ成長はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 단위, 모든 중량 및 모든 시간이 정확하게 기록됩니다. 데이터가 없으면 성장도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke eenheid, elk gewicht en elke tijd wordt nauwkeurig geregistreerd. Zonder data is er geen groei."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda jednostka, każda waga i każdy czas są precyzyjnie rejestrowane. Bez danych nie ma wzrostu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada unidade, cada peso e cada tempo são registrados com precisão. Sem dados não há crescimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое измерение, каждый вес и каждое время фиксируются точно. Без данных нет роста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "body.tracking.progress.tip_too_fast": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Crash-Diäten oder zu schnelles Zunehmen ist ungesund. Werde etwas langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",

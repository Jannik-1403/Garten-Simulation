        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0928\u0908 \u0936\u0941\u0930\u0941\u0906\u0924!%d\u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u094d\u091f\u094d\u0930\u0940\u0915 \u092c\u0928\u093e\u0928\u093e \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902\u0964"

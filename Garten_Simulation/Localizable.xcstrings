    "prog_coldshower_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dusche heiß, dann wechsle abrupt auf eiskalt. Spüre, wie das Blut in den Kern schießt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shower hot, then abruptly switch to ice cold. Feel the blood rush to the core."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúchese con agua caliente y luego cambie abruptamente a agua helada. Siente cómo la sangre corre hasta el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une douche chaude, puis passez brusquement à une douche glacée. Sentez le sang affluer vers le cœur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्म स्नान करें, फिर अचानक बर्फ़ीले ठंडे स्नान पर स्विच करें। महसूस करें कि रक्त हृदय की ओर दौड़ रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai la doccia calda, quindi passa bruscamente a quella ghiacciata. Senti il ​​sangue scorrere fino al midollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱いシャワーを浴びてから、突然氷のような冷たいシャワーに切り替えます。体の芯まで血液が流れていくのを感じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨거운 물로 샤워한 후 갑자기 얼음물로 전환하십시오. 혈액이 중심부로 돌진하는 것을 느껴보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Douche warm en schakel dan abrupt over naar ijskoud. Voel het bloed naar de kern stromen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weź gorący prysznic, a następnie nagle zmień go na lodowaty. Poczuj krew pędzącą do rdzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tome um banho quente e depois mude abruptamente para um banho gelado. Sinta o sangue correr para o âmago."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tome um banho quente e depois mude abruptamente para um banho gelado. Sinta o sangue correr para o âmago."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примите горячий душ, а затем резко переключитесь на ледяной. Почувствуйте, как кровь приливает к сердцу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcak duş alın, ardından aniden buz gibi soğuğa geçin. Kanın çekirdeğe doğru akışını hissedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洗热水澡，然后突然换成冰水。感觉血液冲向核心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "洗熱水澡，然後突然換成冰水。感覺血液衝向核心。"
          }
        }
      }
    },

    "support.success.msg": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht wurde an jannik.schill.2010@gmail.com gesendet. Wir melden uns bald!"

    "assessment.lifestyle.profile.elite.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeide es, Ratschläge zu geben, wenn jemand eigentlich nur eine Schulter zum Anlehnen sucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid giving advice when someone is really just looking for a shoulder to lean on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite dar consejos cuando alguien en realidad sólo busca un hombro en el que apoyarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez de donner des conseils lorsque quelqu’un cherche simplement une épaule sur laquelle s’appuyer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई वास्तव में सहारा लेने के लिए किसी कंधे की तलाश में हो तो सलाह देने से बचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita di dare consigli quando qualcuno sta solo cercando una spalla su cui appoggiarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かが本当に肩を寄せたいだけの場合は、アドバイスをしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가가 정말로 기댈 어깨를 찾고 있을 때는 조언을 하지 마십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermijd het geven van advies als iemand eigenlijk alleen maar op zoek is naar een schouder om op te leunen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj udzielania rad, gdy ktoś tak naprawdę szuka ramienia, na którym może się oprzeć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite dar conselhos quando alguém está apenas procurando um ombro para se apoiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избегай давать советы, если кто-то на самом деле ищет только плечо, на которое можно опереться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birisi gerçekten yaslanacak bir omuz aradığında tavsiye vermekten kaçının."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当有人实际上只是想找个可以依靠的肩膀时，避免给出建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當某人真的只是在尋找一個可以依靠的肩膀時，避免提供建議。"
          }
        }
      }
    },
    "assessment.lifestyle.profile.elite.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedanke dich einmal wöchentlich aufrichtig bei jemandem, der dir im Hintergrund hilft (Reinigungskraft, Assistent)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once a week, sincerely thank someone who helps you in the background (cleaner, assistant)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez a la semana, agradece sinceramente a alguien que te ayude en segundo plano (limpiador, asistente)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois par semaine, remerciez sincèrement quelqu'un qui vous aide en arrière-plan (nettoyeur, assistant)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सप्ताह में एक बार, पृष्ठभूमि में आपकी मदद करने वाले (क्लीनर, सहायक) को ईमानदारी से धन्यवाद दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta alla settimana, ringrazia sinceramente qualcuno che ti aiuta in background (addetto alle pulizie, assistente)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週に一度、裏方で手伝ってくれる人（清掃員やアシスタント）に心から感謝しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일주일에 한 번, 뒤에서 도와주는 사람(청소부, 보조원)에게 진심으로 감사를 표하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedank één keer per week oprecht iemand die je op de achtergrond helpt (schoonmaakster, assistent)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz w tygodniu szczerze podziękuj komuś, kto pomaga Ci w tle (sprzątaczka, asystentka)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vez por semana, agradeça sinceramente a alguém que o ajuda nos bastidores (faxina, assistente)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодарите одного человека искренне раз в неделю за то, что он помогает вам за кулисами (уборщицу, ассистента)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftada bir kez arka planda size yardımcı olan birine (temizlikçi, asistan) içtenlikle teşekkür edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周真诚地感谢一次在背后帮助你的人（清洁工、助理）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週一次，真誠地感謝在後台幫助你的人（清潔工、助理）。"
          }
        }
      }
    },
    "assessment.lifestyle.profile.elite.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spielst auf hohem Level. Die Marginal Gains für Eliten liegen in der Demut und dem Zurückgeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You play at a high level. The marginal gains for elites lie in humility and giving back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juegas a un alto nivel. Los beneficios marginales para las élites residen en la humildad y la retribución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous jouez à un haut niveau. Les gains marginaux pour les élites résident dans l’humilité et le don en retour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऊंचे स्तर पर खेलते हैं. अभिजात वर्ग के लिए सीमांत लाभ विनम्रता और वापस देने में निहित है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giochi ad alto livello. I guadagni marginali per le élite risiedono nell’umiltà e nella restituzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高いレベルでプレーしていますね。エリートにとってのわずかな利益は、謙虚さと恩返しにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 높은 수준에서 플레이합니다. 엘리트의 한계 이익은 겸손과 환원에 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je speelt op hoog niveau. De marginale winsten voor de elites liggen in nederigheid en teruggeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grasz na wysokim poziomie. Marginalne zyski elit polegają na pokorze i oddaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você joga em alto nível. Os ganhos marginais para as elites residem na humildade e na retribuição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты играешь на высоком уровне. Маржинальные преимущества для элиты заключаются в смирении и отдаче."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üst düzeyde oynuyorsun. Seçkinlerin marjinal kazanımları alçakgönüllülük ve karşılık vermekte yatmaktadır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在高水平上比赛。精英的边际收益在于谦逊和回馈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的比賽水準很高。菁英們的邊際利益在於謙遜和回饋。"
          }
        }
      }
    },

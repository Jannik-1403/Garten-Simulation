          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Water geven & XP"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewanie i XP"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega e XP"
          }
        },
        "tr": {

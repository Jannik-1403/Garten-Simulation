    "assessment.finance.q14.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich versuche es ständig zu vermeiden, breche aber mehrmals die Woche ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I try to avoid it all the time, but I cave in several times a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intento evitarlo todo el tiempo, pero cedo varias veces a la semana."

          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尊敬。止まらない集中力を維持してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "존경. 멈출 수 없는 집중력을 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respect. Houd die onstuitbare focus vast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szacunek. Utrzymuj to niepowstrzymane skupienie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respeito. Mantenha esse foco imparável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уважение. Сохраняй эту неумолимую сосредоточенность."

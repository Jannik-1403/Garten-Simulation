    "onboarding.screentime.error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die Berechtigung verweigert. Fehlermeldung: %@.\n\nBitte überprüfe deine Berechtigungen in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS denied permission. Error message: %@.\n\nPlease check your permissions in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS denegó el permiso. Mensaje de error: %@.\n\nVerifique sus permisos en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a refusé l'autorisation. Message d'erreur : %@.\n\nVeuillez vérifier vos autorisations dans Paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ने अनुमति नहीं दी. त्रुटि संदेश: %@।\n\nकृपया सेटिंग्स में अपनी अनुमतियां जांचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha negato l'autorizzazione. Messaggio di errore: %@.\n\nControlla le tue autorizzazioni in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が許可を拒否しました。エラー メッセージ: %@。\n\n設定で権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 권한을 거부했습니다. 오류 메시지: %@.\n\n설정에서 권한을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS heeft toestemming geweigerd. Foutmelding: %@.\n\nControleer uw rechten in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS odmówił pozwolenia. Komunikat o błędzie: %@.\n\nSprawdź swoje uprawnienia w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS negou permissão. Mensagem de erro: %@.\n\nVerifique suas permissões em Configurações."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS negou permissão. Mensagem de erro: %@.\n\nVerifique suas permissões em Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS отказала в разрешении. Сообщение об ошибке: %@.\n\nПожалуйста, проверьте свои разрешения в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS izni reddetti. Hata mesajı: %@.\n\nLütfen Ayarlar'daki izinlerinizi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 拒绝许可。错误信息： %@。\n\n请在“设置”中检查您的权限。"

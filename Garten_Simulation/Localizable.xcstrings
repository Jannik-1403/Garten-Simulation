    "settings.reset.alert.message": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion löscht alle deine Pflanzen, Coins und Fortschritte. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will delete all your plants, coins, and progress. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción eliminará tus plantas y progreso. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera toutes tes plantes, pièces et progressions. Cela ne peut pas être annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "This action will delete all your plants, coins, and progress. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、植物、コイン、進行状況がすべて削除されます。これを元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 수행하면 모든 식물, 코인 및 진행 상황이 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze actie worden al je planten, munten en voortgang verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność usunie wszystkie Twoje rośliny, monety i postęp. Tego nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação irá eliminar todas as tuas plantas, moedas e progresso. Não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eylem tüm bitkilerinizi, madeni paralarınızı ve ilerlemenizi silecektir. Bu geri alınamaz."
          }
        }
      }
    },

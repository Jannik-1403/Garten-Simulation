    "plant.teestrauch.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfter, nachhaltiger Wachstum – Weniger Kaffee"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle, sustainable growth – Less coffee"
          }
        },
        "es": {
          "stringUnit": {

    "trash.fast_food_abo.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstecke Fast-Food-Apps auf dem letzten Bildschirm oder l\u00f6sche sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide fast food apps on the last screen or delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las apps de comida r\u00e1pida en la \u00faltima pantalla o elim\u00ednalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache les applications de fast food sur le dernier \u00e9cran ou supprime-les."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093e\u0938\u094d\u091f-\u092b\u0942\u0921 \u0910\u092a\u094d\u0938 \u0915\u094b \u0906\u0916\u093f\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u091b\u0941\u092a\u093e\u090f\u0902 \u092f\u093e \u0909\u0928\u094d\u0939\u0947\u0902 \u0939\u091f\u093e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le app di fast food nell'ultima schermata o eliminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30b9\u30c8\u30d5\u30fc\u30c9\u306e\u30a2\u30d7\u30ea\u3092\u6700\u5f8c\u306e\u753b\u9762\u306b\u96a0\u3059\u304b\u524a\u9664\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud328\uc2a4\ud2b8\ud478\ub4dc \uc571\uc744 \ub9c8\uc9c0\ub9c9 \ud654\uba74\uc5d0 \uc228\uae30\uac70\ub098 \uc0ad\uc81c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg fastfood-apps op het laatste scherm of verwijder ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj aplikacje fast food na ostatnim ekranie lub usu\u0144 je."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esconda os apps de fast food na \u00faltima tela ou exclua-os."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u0440\u043e\u0439\u0442\u0435 \u0438\u043b\u0438 \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u0438\u0442\u0430\u043d\u0438\u044f \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food uygulamalar\u0131n\u0131 son ekrana gizle veya sil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u6700\u540e\u4e00\u4e2a\u5c4f\u5e55\u9690\u85cf\u6216\u5220\u9664\u5feb\u9910\u5e94\u7528\u7a0b\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u6700\u5f8c\u4e00\u500b\u756b\u9762\u96b1\u85cf\u6216\u522a\u9664\u5feb\u9910\u61c9\u7528\u7a0b\u5f0f\u3002"
          }
        }
      }
    },
    "trash.fast_food_abo.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnere dich: Fast Food macht tr\u00e4ge und kostet langfristig Energie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember: fast food makes you sluggish and costs energy in the long run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda: la comida r\u00e1pida te hace torpe y a largo plazo te cuesta energ\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappelle-toi : la restauration rapide te rend paresseux et te co\u00fbte de l'\u00e9nergie \u00e0 long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u093e\u0926 \u0930\u0916\u0947\u0902: \u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921 \u0938\u0941\u0938\u094d\u0924\u0940 \u0932\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u092e\u0947\u0902 \u090a\u0930\u094d\u091c\u093e \u0915\u0940 \u0932\u093e\u0917\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda: il fast food ti rende pigro e nel lungo periodo ti costa energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30b9\u30c8\u30d5\u30fc\u30c9\u306f\u75b2\u308c\u3084\u3059\u304f\u306a\u308a\u3001\u9577\u671f\u7684\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8017\u3059\u308b\u3053\u3068\u3092\u899a\u3048\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae30\uc5b5\ud558\uc138\uc694: \ud328\uc2a4\ud2b8\ud478\ub4dc\ub294 \ubb34\uae30\ub825\ud558\uac8c \ub9cc\ub4e4\uace0 \uc7a5\uae30\uc801\uc73c\ub85c \uc5d0\ub108\uc9c0\ub97c \uc18c\ubaa8\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedenk: fastfood maakt je traag en kost je op lange termijn energie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pami\u0119taj: fast food sprawia, \u017ce jeste\u015b ospa\u0142y i d\u0142ugoterminowo kosztuje ci\u0119 energi\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembre-se: fast food te deixa pregui\u00e7oso e custa energia a longo prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043c\u043d\u0438\u0442\u0435: \u0444\u0430\u0441\u0442-\u0444\u0443\u0434 \u0434\u0435\u043b\u0430\u0435\u0442 \u0432\u0430\u0441 \u0432\u044f\u043b\u044b\u043c\u0438 \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u044d\u043d\u0435\u0440\u0433\u0438\u0438 \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unutma: fast food seni yava\u015flat\u0131r ve uzun vadede enerji t\u00fcketir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u8bb0\u4f4f\uff1a\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u5feb\u9910\u4f1a\u8ba9\u4f60\u53d8\u5f97\u8fdf\u949d\u5e76\u4e14\u6d88\u8017\u80fd\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u8a18\u4f4f\uff1a\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u5feb\u9910\u6703\u8b93\u4f60\u8b8a\u5f97\u9072\u920d\u4e26\u4e14\u6d88\u8017\u80fd\u91cf\u3002"
          }
        }
      }
    },
    "trash.fast_food_abo.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche ein gesundes Gericht vor und stelle es in den K\u00fchlschrank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook a healthy meal in advance and put it in the fridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina una comida saludable con antelaci\u00f3n y ponla en el frigor\u00edfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9pare un plat sain \u00e0 l'avance et mets-le au r\u00e9frig\u00e9rateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0938\u094d\u0935\u0938\u094d\u0925 \u0935\u094d\u092f\u0902\u091c\u0928 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092a\u0915\u093e\u090f\u0901 \u0914\u0930 \u0909\u0938\u0947 \u092b\u094d\u0930\u093f\u091c \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina un piatto sano in anticipo e mettilo in frigo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5065\u5eb7\u7684\u306a\u6599\u7406\u3092\u4e8b\u524d\u306b\u4f5c\u3063\u3066\u51b7\u8535\u5eab\u306b\u5165\u308c\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac74\uac15\ud55c \uc2dd\uc0ac\ub97c \ubbf8\ub9ac \uc694\ub9ac\ud574\uc11c \ub0c9\uc7a5\uace0\uc5d0 \ub123\uc5b4\ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook een gezond gerecht van tevoren en zet het in de koelkast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugotuj zdrowe danie z wyprzedzeniem i w\u0142\u00f3\u017c je do lod\u00f3wki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe uma refei\u00e7\u00e3o saud\u00e1vel com anteced\u00eancia e coloque na geladeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u0443\u044e \u0435\u0434\u0443 \u0438 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u0435\u0435 \u0432 \u0445\u043e\u043b\u043e\u0434\u0438\u043b\u044c\u043d\u0438\u043a."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6nceden sa\u011fl\u0131kl\u0131 bir yemek pi\u015fir ve buzdolab\u0131na koy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9884\u5148\u716e\u4e00\u987f\u5065\u5eb7\u7684\u996d\u83dc\u5e76\u5c06\u5176\u653e\u5165\u51b0\u7bb1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9810\u5148\u716e\u4e00\u9813\u5065\u5eb7\u7684\u98ef\u83dc\u4e26\u5c07\u5176\u653e\u5165\u51b0\u7bb1\u3002"
          }
        }
      }
    },
    "trash.fast_food_abo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracke jede Fast-Food-Mahlzeit \u2013 die Summe wird dich \u00fcberraschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track every fast food meal \u2013 the total will surprise you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra cada comida de comida r\u00e1pida: el total te sorprender\u00e1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre chaque repas de fast food \u2013 le total te surprendra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u092b\u093e\u0938\u094d\u091f-\u092b\u0942\u0921 \u092d\u094b\u091c\u0928 \u0915\u094b \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902 \u2013 \u0915\u0941\u0932 \u0930\u093e\u0936\u093f \u0906\u092a\u0915\u094b \u0939\u0948\u0930\u093e\u0928 \u0915\u0930 \u0926\u0947\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia di ogni pasto fast food \u2013 il totale ti sorprender\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30b9\u30c8\u30d5\u30fc\u30c9\u306e\u98df\u4e8b\u3092\u6bce\u56de\u8a18\u9332\u3057\u307e\u3057\u3087\u3046\u3002\u5408\u8a08\u984d\u306b\u9a5a\u304f\u306f\u305a\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \ud328\uc2a4\ud2b8\ud478\ub4dc \uc2dd\uc0ac\ub97c \uae30\ub85d\ud558\uc138\uc694 \u2013 \ud569\uacc4\uac00 \ub180\ub77c\uc6b8 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer elke fastfoodmaaltijd \u2013 het totaal zal je verbazen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015aled\u017a ka\u017cdy posi\u0142ek fast food \u2013 suma ci\u0119 zaskoczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreie cada refei\u00e7\u00e3o de fast food \u2013 o total vai te surpreender."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u0440\u0438\u0435\u043c \u043f\u0438\u0449\u0438 \u0432 \u0444\u0430\u0441\u0442-\u0444\u0443\u0434\u0435 \u2014 \u043e\u0431\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0432\u0430\u0441 \u0443\u0434\u0438\u0432\u0438\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her fast food \u00f6\u011f\u00fcn\u00fcn\u00fc takip et \u2013 toplam seni \u015fa\u015f\u0131rtacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ffd\u8e2a\u6bcf\u4e00\u987f\u5feb\u9910 - \u603b\u6570\u4f1a\u8ba9\u60a8\u5927\u5403\u4e00\u60ca\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ffd\u8e64\u6bcf\u4e00\u9813\u5feb\u9910 - \u7e3d\u6578\u6703\u8b93\u60a8\u5927\u5403\u4e00\u9a5a\u3002"
          }
        }
      }
    },
    "trash.fast_food_abo.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Fast Food)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Gesund kochen)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u093e (\u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0928\u091c\u093c\u0930 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0926\u0902\u0921 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0938\u094d\u0935\u0938\u094d\u0925 \u0916\u093e\u0928\u093e \u092a\u0915\u093e\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0932\u093e\u090f\u0902 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0938\u094d\u0935\u092f\u0902 \u0915\u094b \u092a\u0941\u0930\u0938\u094d\u0915\u0943\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Fast Food)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Gesund kochen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."

    "item.herz_auffueller.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und f\u00fcllt 1 Leben auf (Max. 5)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and restores 1 life (Max. 5)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa de inmediato y restaura 1 vida (M\u00e1x. 5)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active imm\u00e9diatement et restaure 1 vie (Max. 5)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u091c\u0940\u0935\u0928 (\u0905\u0927\u093f\u0915\u0924\u092e 5) \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u0938\u0915\u094d\u0930\u093f\u092f \u0914\u0930 \u092a\u0941\u0928\u0903\u092a\u0942\u0930\u094d\u0924\u093f \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si attiva immediatamente e ripristina 1 vita (Max. 5)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5373\u6642\u767a\u52d5\u3057\u30e9\u30a4\u30d5\u30921\u56de\u5fa9\uff08\u6700\u59275\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uba70 \uc0dd\uba85\ub825\uc744 1\ud68c \ud68c\ubcf5\ud569\ub2c8\ub2e4(\ucd5c\ub300 5\ud68c)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en herstelt 1 leven (max. 5)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje si\u0119 natychmiast aktywny i przywraca 1 \u017cycie (maks. 5)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e restaura 1 vida (M\u00e1x. 5)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043a\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441\u0440\u0430\u0437\u0443 \u0438 \u0432\u043e\u0441\u043f\u043e\u043b\u043d\u044f\u0435\u0442 1 \u0436\u0438\u0437\u043d\u044c (\u043c\u0430\u043a\u0441. 5)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve 1 can yeniler (Maks. 5)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u8865\u51451\u4e2a\u751f\u547d\uff08\u6700\u591a5\u4e2a\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u555f\u52d5\u4e26\u88dc\u5145 1 \u9ede\u751f\u547d\uff08\u6700\u591a 5 \u9ede\uff09\u3002"
          }
        }
      }
    },
    "item.streak_schutz.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sch\u00fctzt deine Streaks 48h lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protects your streaks for 48h."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege tus rachas durante 48h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prot\u00e8ge tes s\u00e9ries pendant 48h."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0940 \u0927\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u094b 48 \u0918\u0902\u091f\u094b\u0902 \u0924\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Protects your streaks for 48h."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u7b4b\u309248\u6642\u9593\u4fdd\u8b77\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "48\uc2dc\uac04 \ub3d9\uc548 \uc5f0\uc18d \uae30\ub85d\uc744 \ubcf4\ud638\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschermt je strepen gedurende 48 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chroni pasma przez 48h."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege as tuas sequ\u00eancias durante 48h."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0442\u0432\u043e\u0438 \u0441\u0435\u0440\u0438\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 48 \u0447\u0430\u0441\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7izgilerinizi 48 saat boyunca korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u572848\u5c0f\u65f6\u5185\u4fdd\u62a4\u4f60\u7684\u8fde\u80dc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "48 \u5c0f\u6642\u4fdd\u8b77\u60a8\u7684\u9023\u7e8c\u8a18\u9304\u3002"
          }
        }
      }
    },

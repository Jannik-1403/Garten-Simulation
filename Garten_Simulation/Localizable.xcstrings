            "value": "\u0905\u092d\u0940 \u0915\u0926\u092e \u0909\u0920\u093e\u090f\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agisci ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u3059\u3050\u884c\u52d5\u3057\u307e\u3057\u3087\u3046"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uae08 \ud589\ub3d9\ud558\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handel nu"
          }
        },
        "pl": {
          "stringUnit": {

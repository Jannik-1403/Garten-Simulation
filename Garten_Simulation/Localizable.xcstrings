    "plant.lavendel.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine entspannte Routine f\u00fcr tiefen und erholsamen Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relaxed routine for deep and restful sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rutina relajada para un sue\u00f1o profundo y reparador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une routine d\u00e9tendue pour un sommeil profond et r\u00e9parateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0939\u0930\u0947 \u0914\u0930 \u0906\u0930\u093e\u092e\u0926\u093e\u092f\u0915 \u0928\u0940\u0902\u0926 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0906\u0938\u093e\u0928 \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una routine rilassata per un sonno profondo e ristoratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6df1\u304f\u5b89\u3089\u304b\u306a\u7761\u7720\u306e\u305f\u3081\u306e\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u305f\u30eb\u30fc\u30c1\u30f3\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae4a\uace0 \ud3b8\uc548\ud55c \uc218\uba74\uc744 \uc704\ud55c \ud3b8\uc548\ud55c \ub8e8\ud2f4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ontspannen routine voor een diepe en rustgevende slaap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaksuj\u0105ca rutyna dla g\u0142\u0119bokiego i spokojnego snu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma rotina relaxada para um sono profundo e reparador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u044f\u044e\u0449\u0438\u0439 \u0440\u0430\u0441\u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0434\u043b\u044f \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u0433\u043e \u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0433\u043e \u0441\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derin ve dinlendirici bir uyku i\u00e7in rahatlat\u0131c\u0131 bir rutin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u4e2a\u653e\u677e\u7684\u65e5\u5e38\uff0c\u5e26\u6765\u6df1\u5ea6\u548c\u6062\u590d\u6027\u7761\u7720\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u7a2e\u653e\u9b06\u7684\u7fd2\u6163\uff0c\u8b93\u60a8\u7372\u5f97\u6df1\u5ea6\u3001\u5b89\u5be7\u7684\u7761\u7720\u3002"
          }
        }
      }
    },

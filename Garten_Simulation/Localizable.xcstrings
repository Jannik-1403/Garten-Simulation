    "trash.online_shopping_app.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche alle Shopping-Apps und melde dich aus Online-Shops aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all shopping apps and log out of online shops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las apps de compras y cierra sesión en las tiendas online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les applications de shopping et déconnecte-toi des boutiques en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी शॉपिंग ऐप्स डिलीट करें और ऑनलाइन स्टोर्स से लॉग आउट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutte le app di shopping e disconnettiti dai negozi online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのショッピングアプリを削除し、オンラインショップからログアウトしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 쇼핑 앱을 삭제하고 온라인 쇼핑몰에서 로그아웃하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder alle winkel-apps en log uit bij online winkels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń wszystkie aplikacje zakupowe i wyloguj się ze sklepów internetowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua todos os apps de compras e saia das lojas online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua todos os apps de compras e saia das lojas online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите все приложения для покупок и выйдите из интернет-магазинов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm alışveriş uygulamalarını sil ve çevrimiçi mağazalardan çıkış yap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有购物应用程序并退出在线商店。"
          }
        },
        "zh-Hant": {
          "stringUnit": {

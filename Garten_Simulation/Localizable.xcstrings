    "trash.luxus_uhr.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft trägst du teure Sachen wirklich? Rechne den Preis pro Nutzung aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often do you actually wear expensive things? Calculate the price per use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Con qué frecuencia llevas realmente cosas caras? Calcula el precio por uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle fréquence portes-tu vraiment des choses chères ? Calcule le prix par utilisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम वास्तव में कितनी बार महंगे सामान पहनते हो? उपयोग प्रति कीमत निकालो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto spesso indossi davvero cose costose? Calcola il prezzo per utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高価なものを実際にどれくらい使っていますか？使用回数あたりのコストを計算しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비싼 것을 실제로 얼마나 자주 사용하나요? 사용당 가격을 계산해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vaak draag je dure spullen echt? Bereken de prijs per gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak często naprawdę nosisz drogie rzeczy? Oblicz cenę za użycie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que frequência você usa coisas caras? Calcule o preço por uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que frequência você usa coisas caras? Calcule o preço por uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как часто вы действительно носите дорогие вещи? Рассчитайте стоимость одного использования."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahalı şeyleri gerçekte ne sıklıkla kullanıyorsun? Kullanım başına fiyatı hesapla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你真正穿昂贵衣服的频率是多少？计算每次使用的价格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你真正穿昂貴衣服的頻率是多少？計算每次使用的價格。"
          }
        }
      }
    },
    "trash.luxus_uhr.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Statussymbole kaufen)**\n1. Unsichtbar machen: Entferne die Auslöser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue Hürden ein (z.B. Apps löschen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausführung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Dankbarkeit üben)**\n1. Offensichtlich machen: Platziere den Auslöser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die Hürden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Buying status symbols)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Practicing gratitude)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina el mal hábito (Comprar símbolos de estatus)**\n1. Hazlo invisible: Elimina los desencadenantes de tu campo de visión.\n2. Hazlo poco atractivo: Sé consciente de las consecuencias negativas.\n3. Hazlo difícil: Añade obstáculos (p. ej. elimina apps, desconecta el enchufe).\n4. Hazlo insatisfactorio: Vincula la acción a un castigo.\n\n**Establece el buen hábito (Practicar la gratitud)**\n1. Hazlo evidente: Coloca el desencadenante bien visible.\n2. Hazlo atractivo: Asócialo con algo que te guste.\n3. Hazlo fácil: Reduce los obstáculos al mínimo (p. ej. solo 2 minutos).\n4. Hazlo satisfactorio: Recompénsate justo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Se débarrasser de la mauvaise habitude (Acheter des symboles de statut)**\n1. La rendre invisible : Retire les déclencheurs de ton champ de vision.\n2. La rendre peu attirante : Prends conscience des conséquences négatives.\n3. La rendre difficile : Ajoute des obstacles (par ex. supprime des applis, débranche la prise).\n4. La rendre insatisfaisante : Associe l'action à une sanction.\n\n**Mettre en place la bonne habitude (Pratiquer la gratitude)**\n1. La rendre évidente : Place le déclencheur bien en vue.\n2. La rendre attirante : Associe-la à quelque chose que tu aimes.\n3. La rendre facile : Réduis les obstacles au minimum (par ex. seulement 2 minutes).\n4. La rendre satisfaisante : Récompense-toi juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**खराब आदत से छुटकारा पाना (स्थिति प्रतीक खरीदना)**\n1. अदृश्य बनाएं: अपने दृश्य क्षेत्र से ट्रिगर्स हटा दें।\n2. अप्रिय बनाएं: नकारात्मक परिणामों से अवगत रहें।\n3. कठिन बनाएं: बाधाएं डालें (जैसे ऐप्स हटाना, प्लग खींचना)।\n4. असंतोषजनक बनाएं: कार्य को किसी दंड के साथ जोड़ें।\n\n**अच्छी आदत स्थापित करना (कृतज्ञता अभ्यास करना)**\n1. स्पष्ट बनाएं: ट्रिगर को अच्छी तरह दिखाई देने वाली जगह पर रखें।\n2. आकर्षक बनाएं: इसे किसी ऐसी चीज़ के साथ जोड़ें जिसे आप पसंद करते हैं।\n3. सरल बनाएं: बाधाओं को न्यूनतम करें (जैसे केवल 2 मिनट)।\n4. संतोषजनक बनाएं: तुरंत इसके बाद खुद को पुरस्कृत करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sbarazzarsi di una cattiva abitudine (acquistare simboli di stato)**\n1. Rendi invisibile: rimuovi i trigger dal tuo campo visivo.\n2. Renditi poco attraente: sii consapevole delle conseguenze negative.\n3. Rendilo difficile: imposta degli ostacoli (ad esempio elimina app, scollega la spina).\n4. Renderlo insoddisfacente: collegare l'esecuzione a una penalità.\n\n**Stabilire buone abitudini (praticare la gratitudine)**\n1. Rendilo evidente: posiziona il grilletto chiaramente visibile.\n2. Rendilo attraente: associalo a qualcosa che ti piace.\n3. Rendilo semplice: riduci al minimo gli ostacoli (ad esempio solo 2 minuti).\n4. Rendilo soddisfacente: premiati subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**悪い習慣を取り除く (ステータス シンボルを購入する)**\n1. 目に見えないようにする: トリガーを視界から取り除きます。\n2. 自分自身を魅力的でなくする: マイナスの結果に注意してください。\n3. 難しくする: ハードルを設定します (例: アプリを削除する、プラグを抜く)。\n4. 満足できないものにする: 処刑にペナルティを付けます。\n\n**良い習慣を確立する（感謝の気持ちを実践する）**\n1. わかりやすいようにする: トリガーをはっきりと見えるように配置します。\n2. 魅力的にする: 好きなものと関連付けます。\n3. シンプルにする: ハードルを最小限に抑えます (例: わずか 2 分)。\n4. 満足のいくものにする: 終わったらすぐに自分にご褒美をあげましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**나쁜 습관 제거(상태 기호 구매)**\n1. 보이지 않게 만들기: 시야에서 트리거를 제거합니다.\n2. 자신을 매력적이지 않게 만드세요. 부정적인 결과를 염두에 두세요.\n3. 어렵게 만들기: 장애물을 설정합니다(예: 앱 삭제, 플러그 뽑기).\n4. 불만족스럽게 만들기: 처형에 벌금을 부과합니다.\n\n**좋은 습관 확립(감사 실천)**\n1. 명확하게 만드십시오: 트리거를 명확하게 보이도록 배치하십시오.\n2. 매력적으로 만드십시오: 당신이 좋아하는 것과 연관시키십시오.\n3. 단순하게 만드세요. 장애물을 최소한으로 줄이세요(예: 단 2분).\n4. 만족스러운 일을 하십시오: 직후에 자신에게 보상하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slechte gewoonte afleren (Statussymbolen kopen)**\n1. Onzichtbaar maken: Verwijder de triggers uit je blikveld.\n2. Onaantrekkelijk maken: Word je bewust van de negatieve gevolgen.\n3. Moeilijk maken: Bouw obstakels in (bijv. apps verwijderen, stekker eruit trekken).\n4. Onbevredigend maken: Koppel de handeling aan een straf.\n\n**Goede gewoonte opbouwen (Dankbaarheid oefenen)**\n1. Duidelijk maken: Plaats de trigger goed zichtbaar.\n2. Aantrekkelijk maken: Koppel het aan iets wat je leuk vindt.\n3. Makkelijk maken: Beperk de obstakels tot een minimum (bijv. slechts 2 minuten).\n4. Bevredigend maken: Beloon jezelf direct daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pozbądź się złego nawyku (Kup symbole statusu)**\n1. Uczyń niewidzialnym: Usuń wyzwalacze z pola widzenia.\n2. Stań się nieatrakcyjny: bądź świadomy negatywnych konsekwencji.\n3. Utrudnij to: ustaw przeszkody (np. usuń aplikacje, odłącz).\n4. Spraw, aby było to niezadowalające: Połącz egzekucję z karą.\n\n**Ustal dobre nawyki (ćwicz wdzięczność)**\n1. Spraw, aby było to oczywiste: umieść spust w dobrze widocznym miejscu.\n2. Spraw, aby było atrakcyjne: skojarz to z czymś, co lubisz.\n3. Uprość sprawę: ogranicz przeszkody do minimum (np. tylko 2 minuty).\n4. Spraw, aby było to satysfakcjonujące: natychmiast po tym nagradzaj siebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Livra-te do mau hábito (Comprar símbolos de estatuto)**\n1. Torná-lo invisível: Remove os gatilhos do teu campo de visão.\n2. Torná-lo pouco atrativo: Consciencializa-te das consequências negativas.\n3. Torná-lo difícil: Cria obstáculos (por ex. elimina apps, desliga a ficha).\n4. Torná-lo insatisfatório: Associa a ação a uma penalização.\n\n**Estabelece o bom hábito (Praticar gratidão)**\n1. Torná-lo evidente: Coloca o gatilho bem visível.\n2. Torná-lo atrativo: Associa-o a algo de que gostas.\n3. Torná-lo fácil: Reduz os obstáculos ao mínimo (por ex. apenas 2 minutos).\n4. Torná-lo satisfatório: Recompensa-te logo a seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimine o mau hábito (Comprar símbolos de status)**\n1. Torne-o invisível: Remova os gatilhos do seu campo de visão.\n2. Torne-o pouco atraente: Conscientize-se das consequências negativas.\n3. Torne-o difícil: Crie obstáculos (ex.: exclua apps, desligue a tomada).\n4. Torne-o insatisfatório: Associe a ação a uma punição.\n\n**Estabeleça o bom hábito (Praticar gratidão)**\n1. Torne-o evidente: Coloque o gatilho bem visível.\n2. Torne-o atraente: Associe-o a algo que você gosta.\n3. Torne-o fácil: Reduza os obstáculos ao mínimo (ex.: apenas 2 minutos).\n4. Torne-o satisfatório: Recompense-se logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Избавьтесь от вредной привычки (покупайте символы статуса)**\n1. Сделайте невидимыми: уберите триггеры из поля зрения. \n2. Сделайте себя непривлекательным. Помните о негативных последствиях. \n3. Усложните задачу: установите препятствия (например, удалите приложения, отключите их от сети). \n4. Сделайте его неудовлетворительным: прикрепите исполнение к наказанию. \n\n**Прививайте хорошие привычки (практикуйте благодарность)**\n1. Сделайте это очевидным: разместите триггер на видном месте. \n2. Сделайте это привлекательным. Свяжите это с чем-то, что вам нравится. \n3. Сделайте это просто: сократите препятствия до минимума (например, всего 2 минуты). \n4. Сделайте это приятным: вознаградите себя сразу после этого."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kötü Bir Alışkanlıktan Kurtulun (Durum Sembolleri Satın Alın)**\n1. Görünmez kılın: Tetikleyicileri görüş alanınızdan kaldırın.\n2. Kendinizi çekici olmaktan çıkarın: Olumsuz sonuçların farkında olun.\n3. Zorlaştırın: Engeller koyun (ör. uygulamaları silin, fişi çekin).\n4. Yetersiz hale getirin: İnfazı cezaya ekleyin.\n\n**İyi alışkanlıklar edinin (minnettarlık uygulayın)**\n1. Açıkça belirtin: Tetiği açıkça görülebilecek şekilde yerleştirin.\n2. Çekici hale getirin: Onu sevdiğiniz bir şeyle ilişkilendirin.\n3. Basitleştirin: Engelleri en aza indirin (örneğin sadece 2 dakika).\n4. Tatmin edici hale getirin: Hemen ardından kendinizi ödüllendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉坏习惯（购买地位象征）**\n1. 隐形：将触发因素移出视野。\n2. 让自己变得没有吸引力：意识到负面后果。\n3. 让它变得困难：设置障碍（例如删除应用程序、拔掉插头）。\n4. 使其不令人满意：附加刑罚执行。\n\n**建立良好的习惯（练习感恩）**\n1. 使其显而易见：将触发器放置在清晰可见的位置。\n2. 让它有吸引力：将它与你喜欢的东西联系起来。\n3. 让它变得简单：将障碍减少到最低限度（例如只需 2 分钟）。\n4. 让它令人满意：事后立即奖励自己。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**改掉壞習慣（購買地位象徵）**\n1. 隱形：將觸發因素移出視野。\n2. 讓自己變得沒有吸引力：意識到負面後果。\n3. 讓它變得困難：設定障礙（例如刪除應用程式、拔掉插頭）。\n4. 使其不令人滿意：附加刑罰執行。\n\n**建立良好的習慣（練習感恩）**\n1. 使其顯而易見：將觸發器放置在清晰可見的位置。\n2. 讓它有吸引力：將它與你喜歡的東西連結起來。\n3. 讓它變得簡單：將障礙減少到最低限度（例如只需 2 分鐘）。\n4. 讓它令人滿意：事後立即獎勵自己。"
          }
        }
      }
    },
    "trash.nacht_snack_box.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzichte auf späte Snacks für einen ruhigeren Magen und besseren Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid late-night snacks for a calmer stomach and better sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita los bocadillos nocturnos para tener un estómago más tranquilo y dormir mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite les collations nocturnes pour un estomac apaisé et un meilleur sommeil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत पेट और बेहतर नींद के लिए देर रात के स्नैक्स से बचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita gli spuntini notturni per uno stomaco più calmo e un sonno migliore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜遅くの軽食を避けて、胃を落ち着かせ、より良い睡眠を取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위장을 편안하게 하고 더 나은 수면을 취하려면 늦은 밤 간식을 피하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd late snacks voor een rustigere maag en een betere nachtrust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj późnych przekąsek, aby uspokoić żołądek i zapewnić sobie lepszy sen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite lanches noturnos para ter um estômago mais calmo e dormir melhor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite lanches noturnos para ter um estômago mais calmo e dormir melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте ночных перекусов, чтобы успокоить желудок и улучшить сон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sakin bir mide ve daha iyi bir uyku için gece geç saatte atıştırmalıklardan kaçının."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免深夜零食，让胃更平静，睡眠也更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免深夜零食，讓胃更平靜，睡眠也更好。"
          }
        }
      }
    },
    "trash.nacht_snack_box.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Nächtliches Snacken) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Late-night snacking) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Picar por la noche) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Grignoter la nuit) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (रात में स्नैक करना) लंबे समय में आपकी ऊर्जा, समय और पैसा खर्च करती है। यह आपको अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Spuntini notturni) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（夜食）は、長期的にはエネルギー、時間、お金を消費します。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(야식)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte ('s Nachts snacken) kost je op lange termijn energie, tijd en geld. Het weerhoudt je ervan je volledige potentieel te benutten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (nocne podjadanie) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Petiscar à noite) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Beliscar à noite) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (ночные перекусы) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (gece atıştırmalığı) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（夜宵）会消耗你的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長遠來看，這種習慣（宵夜）會消耗你的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },
    "trash.nacht_snack_box.name": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachts gesnackt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacked at night"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comió bocadillos en la noche"
          }
        },
        "fr": {
          "stringUnit": {

          "stringUnit": {
            "state": "translated",
            "value": "Cleans the air from within \u2013 Breathing exercises & Breathwork"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5185\u5074\u304b\u3089\u7a7a\u6c17\u3092\u304d\u308c\u3044\u306b\u3059\u308b \u2013 \u547c\u5438\u6cd5\u3068\u30d6\u30ec\u30b9\u30ef\u30fc\u30af"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\ubd80 \uacf5\uae30\ub97c \uc815\ud654\ud569\ub2c8\ub2e4 \u2013 \ud638\ud761 \uc6b4\ub3d9 & \ud638\ud761\ubc95"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinigt de lucht van binnenuit \u2013 Ademhalingsoefeningen & Ademwerk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczyszcza powietrze od wewn\u0105trz \u2013 \u0107wiczenia oddechowe i praca oddechowa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Purifica o ar por dentro \u2013 exerc\u00edcios de respira\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0447\u0438\u0449\u0430\u0435\u0442 \u0432\u043e\u0437\u0434\u0443\u0445 \u0438\u0437\u043d\u0443\u0442\u0440\u0438 \u2013 \u0434\u044b\u0445\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u0430\u043d\u0430\u044f\u043c\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Havay\u0131 i\u00e7eriden temizler \u2013 Nefes egzersizleri ve Nefes \u00c7al\u0131\u015fmas\u0131"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u5185\u800c\u5916\u51c0\u5316\u7a7a\u6c14\u2014\u2014\u547c\u5438\u7ec3\u4e60\u4e0e\u547c\u5438\u6cd5"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u5167\u90e8\u6de8\u5316\u7a7a\u6c23\uff0d\u547c\u5438\u7df4\u7fd2\u8207\u547c\u5438\u6cd5"
          }
        }
      }
    },
    "plant.farn.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht kein Licht von Bildschirmen \u2013 Digital Detox"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs no light from screens \u2013 Digital Detox"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesita luz de pantallas \u2013 Desintoxicaci\u00f3n digital"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'a pas besoin de la lumi\u00e8re des \u00e9crans \u2013 D\u00e9tox num\u00e9rique"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u2013 \u0921\u093f\u091c\u093f\u091f\u0932 \u0921\u093f\u091f\u0949\u0915\u094d\u0938"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs no light from screens \u2013 Digital Detox"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u753b\u9762\u304b\u3089\u306e\u5149\u306f\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093 \u2013 \u30c7\u30b8\u30bf\u30eb \u30c7\u30c8\u30c3\u30af\u30b9"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud654\uba74\uc758 \ube5b\uc774 \ud544\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4 \u2013 Digital Detox"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft geen licht van schermen nodig \u2013 Digital Detox"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potrzebuje \u015bwiat\u0142a z ekran\u00f3w \u2013 Digital Detox"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o precisa de luz de ecr\u00e3s \u2013 Desintoxica\u00e7\u00e3o digital"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u0432\u0435\u0442\u0435 \u044d\u043a\u0440\u0430\u043d\u043e\u0432 \u2013 \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0434\u0435\u0442\u043e\u043a\u0441"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranlardan gelen \u0131\u015f\u0131\u011fa ihtiya\u00e7 duymaz \u2013 Dijital Detoks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u9700\u8981\u5c4f\u5e55\u5149\u2014\u2014\u6570\u5b57\u6392\u6bd2"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u9700\u8981\u87a2\u5e55\u7684\u5149\u7dda\u2014\u2014\u6578\u4f4d\u6392\u6bd2"
          }
        }
      }
    },

        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima semana, recopile más sesiones de concentración y marque hábitos para obtener consejos precisos sobre su ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La semaine prochaine, rassemblez davantage de séances de concentration et cochez vos habitudes pour obtenir des conseils précis sur votre rythme."

    "plant.mandelbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Investiere in deine Zukunft und baue finanzielle Sicherheit auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invest in your future and build financial security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invierte en tu futuro y construye seguridad financiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Investissez dans votre avenir et bâtissez la sécurité financière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने भविष्य में निवेश करें और वित्तीय सुरक्षा बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Investi nel tuo futuro e costruisci sicurezza finanziaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "将来に投資し、経済的な安全を築きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미래에 투자하고 재정적 안정을 구축하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Investeer in je toekomst en bouw financiële zekerheid op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainwestuj w swoją przyszłość i buduj bezpieczeństwo finansowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Invista no seu futuro e construa segurança financeira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Invista no seu futuro e construa segurança financeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инвестируй в свое будущее и создавай финансовую безопасность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleceğinize yatırım yapın ve finansal güvenlik oluşturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投资未来，建立财务安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投資您的未來並建立財務安全。"
          }
        }
      }
    },
    "plant.mangrove.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält auch in Stürmen stand – Resilienz & Stressabbau"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stands firm even in storms – Resilience & Stress relief"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firme incluso en tormentas – Resiliencia y alivio del estrés"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient bon même dans les tempêtes – Résilience & gestion du stress"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तूफानों में भी कायम रहता है – लचीलापन और तनाव कम करना"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può resistere alle tempeste: resilienza e sollievo dallo stress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嵐の中でもしっかりと立つ – 回復力とストレス軽減"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭풍 속에서도 굳건히 서있습니다 – 회복력 및 스트레스 완화"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat stevig, zelfs bij storm – veerkracht en stressverlichting"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wytrzymuje stabilnie nawet podczas burzy – odporność i redukcja naprężeń"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se firme mesmo em tempestades – Resiliência & alívio do stress"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se firme mesmo em tempestades – Resiliência & alívio do stress"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдерживает штормы – устойчивость и снижение стресса"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fırtınalarda bile sağlam durur – Dayanıklılık ve Stres Giderme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在风暴中也能屹立不倒 – 韧性与减压"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能夠抵禦風暴－復原力和緩解壓力"
          }
        }
      }
    },

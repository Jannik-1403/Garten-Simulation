    "assessment.finance.q8" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist mit Freunden essen. Sie wollen die 300€-Rechnung durch vier teilen. Du hattest nur Salat und Wasser. Deine Reaktion?"

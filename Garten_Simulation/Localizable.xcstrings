    "assessment.lifestyle.profile.chaot.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Kleidung abends nicht auf dem Stuhl liegen – häng sie sofort an den Haken (dauert 3 Sekunden)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't leave your clothes on the chair in the evening - hang them on the hook immediately (takes 3 seconds)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dejes tu ropa en la silla por la noche; cuélgala inmediatamente en el gancho (tarda 3 segundos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne laissez pas vos vêtements sur la chaise le soir – accrochez-les immédiatement au crochet (cela prend 3 secondes)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शाम को अपने कपड़े कुर्सी पर न छोड़ें - उन्हें तुरंत हुक पर लटका दें (3 सेकंड लगते हैं)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sera non lasciare i vestiti sulla sedia: appendili subito al gancio (ci vogliono 3 secondi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方には衣服を椅子の上に残さないでください。すぐにフックに掛けてください（3秒かかります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁에는 옷을 의자 위에 두지 마세요. 즉시 옷걸이에 걸어주세요(3초 소요)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je kleding 's avonds niet op de stoel liggen, maar hang ze meteen aan het haakje (duurt 3 seconden)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zostawiaj ubrań na krześle wieczorem – od razu powieś je na wieszaku (trwa to 3 sekundy)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deixe suas roupas na cadeira à noite - pendure-as no gancho imediatamente (leva 3 segundos)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не оставляй одежду вечером на стуле – сразу повесь её на крючок (занимает 3 секунды)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşamları kıyafetlerinizi sandalyenin üzerinde bırakmayın; hemen kancaya asın (3 saniye sürer)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上不要把衣服放在椅子上——立即把它挂到钩子上（只需3秒钟）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚上不要把衣服留在椅子上 - 立即將它們掛在掛鉤上（需要 3 秒鐘）。"
          }
        }
      }
    },
    "assessment.lifestyle.profile.chaot.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlasse keinen Raum mit leeren Händen. Nimm immer eine Sache mit, die an ihren Platz gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't leave a room empty-handed. Always take one thing with you that belongs in its place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dejes una habitación con las manos vacías. Lleva siempre contigo algo que pertenezca a su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne quittez pas une pièce les mains vides. Emportez toujours avec vous une chose qui doit être à sa place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी कमरे को खाली हाथ न छोड़ें। हमेशा अपने साथ एक ऐसी चीज ले जाएं जो अपनी जगह पर हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non lasciare una stanza a mani vuote. Porta sempre con te una cosa che appartiene al suo posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手ぶらで部屋を出ないでください。常にその場所にふさわしいものを 1 つ持ち歩きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈손으로 방을 떠나지 마십시오. 항상 그 자리에 속한 것 한 가지를 가지고 가십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een kamer niet met lege handen achter. Neem altijd één ding mee dat op zijn plaats hoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wychodź z pokoju z pustymi rękami. Zawsze zabieraj ze sobą jedną rzecz, która należy na swoje miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não saia de uma sala de mãos vazias. Sempre leve com você algo que pertença ao seu lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не покидай комнату с пустыми руками. Всегда бери с собой вещь, которая должна находиться на своём месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir odayı eliniz boş bırakmayın. Her zaman yanınıza onun yerine ait olan bir şey alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要空手离开任何房间。总是带走一件放回原位的东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要空手離開房間。隨時隨身攜帶一件屬於其位置的東西。"
          }
        }
      }
    },

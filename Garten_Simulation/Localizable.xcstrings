    "settings.contact.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haben Sie Fragen oder Probleme? Unser Support-Team hilft Ihnen gerne weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have questions or problems? Our support team will be happy to help you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes preguntas o problemas? Nuestro equipo de soporte estará encantado de ayudarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as des questions ou des problèmes ? Notre équipe de support sera ravie de t'aider."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आपके पास कोई प्रश्न या समस्या है? हमारी सपोर्ट टीम आपकी मदद करने में खुशी होगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have questions or problems? Our support team will be happy to help you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご質問や問題がありますか?弊社のサポートチームが喜んでお手伝いさせていただきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문이나 문제가 있나요? 우리 지원팀이 기꺼이 도와드리겠습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft u vragen of problemen? Ons ondersteuningsteam helpt u graag verder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz pytania lub problemy? Nasz zespół wsparcia chętnie Ci pomoże."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens perguntas ou problemas? A nossa equipa de suporte terá muito prazer em ajudar-te."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас есть вопросы или проблемы? Наша служба поддержки с радостью вам поможет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorularınız veya sorunlarınız mı var? Destek ekibimiz size yardımcı olmaktan mutluluk duyacaktır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您有任何疑问或问题吗？我们的支持团队将很乐意为您提供帮助。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您有任何疑問或問題嗎？我們的支援團隊將很樂意為您提供協助。"
          }
        }
      }
    },

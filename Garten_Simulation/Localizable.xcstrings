            "value": "\u041e\u0441\u0442\u0440\u0430\u044f \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430, \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u044d\u043d\u0435\u0440\u0433\u0438\u044f \u2013 \u0411\u0435\u0437 \u043a\u043e\u0444\u0435\u0438\u043d\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskin alternatif, do\u011fal enerji \u2013 Kafeinsiz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f9b\u8fa3\u66ff\u4ee3\u54c1\uff0c\u5929\u7136\u80fd\u91cf \u2013 \u4e0d\u542b\u5496\u5561\u56e0"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f9b\u8fa3\u66ff\u4ee3\u54c1\uff0c\u5929\u7136\u80fd\u91cf\uff0d\u4e0d\u542b\u5496\u5561\u56e0"
          }
        }
      }
    },
    "plant.kakaobaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00fc\u00df nur nach harter Arbeit \u2013 Belohnung verdienen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweet only after hard work \u2013 Earn the reward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dulce solo tras el esfuerzo \u2013 G\u00e1nate la recompensa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doux seulement apr\u00e8s l'effort \u2013 M\u00e9riter la r\u00e9compense"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0930\u094d\u092b \u0915\u0921\u093c\u0940 \u092e\u0947\u0939\u0928\u0924 \u0915\u0947 \u092c\u093e\u0926 \u0939\u0940 \u092e\u0940\u0920\u093e \u2013 \u0907\u0928\u093e\u092e \u092a\u093e\u0928\u0947 \u0915\u0947 \u092f\u094b\u0917\u094d\u092f"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweet only after hard work \u2013 Earn the reward"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u82e6\u52b4\u3057\u305f\u5f8c\u306b\u306e\u307f\u7518\u3044 \u2013 \u5831\u916c\u3092\u7372\u5f97\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5f4\uc2ec\ud788 \uc77c\ud55c \ud6c4\uc5d0\uc57c \ub2ec\ucf64\ud568 \u2013 \ubcf4\uc0c1\uc744 \ubc1b\uc73c\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen zoet na hard werken \u2013 Verdien de beloning"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0142odko tylko po ci\u0119\u017ckiej pracy \u2013 Zdob\u0105d\u017a nagrod\u0119"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Doce apenas ap\u00f3s esfor\u00e7o \u2013 Merecer a recompensa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u0430\u0434\u043a\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u0442\u044f\u0436\u0451\u043b\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u2013 \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u0443"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece \u00e7ok \u00e7al\u0131\u015ft\u0131ktan sonra tatl\u0131 \u2013 \u00d6d\u00fcl\u00fc kazan\u0131n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u6709\u8f9b\u52e4\u5de5\u4f5c\u540e\u624d\u751c\u7f8e \u2013 \u8d62\u5f97\u5956\u52b1"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f9b\u52de\u4e4b\u5f8c\u624d\u751c\u871c\uff0d\u503c\u5f97\u56de\u5831"
          }
        }
      }
    },

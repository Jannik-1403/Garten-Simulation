    "tour_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige deine Gewohnheiten und ziehe den Wassertropfen auf deine Pflanze, um sie wachsen zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete your habits and drag the water drop onto your plant to make it grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa tus hábitos y arrastra la gota de agua sobre tu planta para hacerla crecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez vos habitudes et faites glisser la goutte d'eau sur votre plante pour la faire pousser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa le tue abitudini e trascina la goccia d'acqua sulla tua pianta per farla crescere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣を完成させて、植物の上に水滴をドラッグして成長させましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 완성하고 물방울을 식물 위로 끌어서 자라게 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi je gewoontes en sleep de waterdruppel naar je plant om hem te laten groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełnij swoje nawyki i przeciągnij kroplę wody na roślinę, aby rosła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete seus hábitos e arraste a gota d’água até sua planta para fazê-la crescer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlıklarınızı tamamlayın ve su damlasını bitkinizin üzerine sürükleyerek büyümesini sağlayın."
          }
        }
      }
    },
    "tour_1_title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {

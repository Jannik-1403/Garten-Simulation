    "prog_gratitude_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dir vor, etwas Wertvolles in deinem Leben wäre nicht da. Wie wäre das? Sei dankbar, dass es da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine if something valuable in your life were not there. How would that be? Be grateful that it is there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagínese si algo valioso en su vida no estuviera allí. ¿Cómo sería eso? Agradece que esté ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginez si quelque chose de précieux dans votre vie n'était pas là. Comment cela se passerait-il ? Soyez reconnaissant qu'il soit là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोचिए अगर आपके जीवन में कुछ मूल्यवान चीज़ न होती। वह कैसे होगा? आभारी रहें कि यह वहां है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina se qualcosa di prezioso nella tua vita non ci fosse. Come sarebbe? Sii grato che sia lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの人生に大切なものがそこになかったらと想像してみてください。それはどうでしょうか？それがあることに感謝してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 인생에서 가치 있는 것이 거기에 없었다고 상상해 보십시오. 어떻게 될까요? 그것이 있다는 사실에 감사하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor dat iets waardevols in je leven er niet zou zijn. Hoe zou dat zijn? Wees dankbaar dat het er is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyobraź sobie, że nie byłoby czegoś wartościowego w Twoim życiu. Jak by to było? Bądź wdzięczny, że tam jest."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine se algo valioso em sua vida não existisse. Como seria isso? Seja grato por estar aí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine se algo valioso em sua vida não existisse. Como seria isso? Seja grato por estar aí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, если бы в вашей жизни не было чего-то ценного. Как бы это было? Будьте благодарны, что оно есть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayatınızda değerli bir şeyin orada olmadığını hayal edin. Bu nasıl olurdu? Onun orada olduğuna şükredin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想象一下，如果你生命中没有一些有价值的东西会怎样。那会怎样呢？感谢它的存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想像一下，如果你生命中沒有一些有價值的東西會怎麼樣。那會怎麼樣呢？感謝它的存在。"
          }
        }
      }
    },
    "prog_gratitude_d4_t1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dinge notiert, ohne die dein Leben viel schwerer wäre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Jotted down things without which your life would be much harder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Anoté cosas sin las cuales tu vida sería mucho más difícil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld J'ai noté des choses sans lesquelles votre vie serait bien plus difficile"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld उन चीज़ों को संक्षेप में लिखा है जिनके बिना आपका जीवन बहुत कठिन होगा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ho annotato le cose senza le quali la tua vita sarebbe molto più difficile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld それなしではあなたの人生がはるかに困難になるものを書き留めました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 당신의 삶이 없으면 인생이 훨씬 더 어려울 것 같은 것들을 적어 두었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dingen opgeschreven zonder welke je leven veel moeilijker zou zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Zanotowałem rzeczy, bez których Twoje życie byłoby znacznie trudniejsze"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Anotou coisas sem as quais sua vida seria muito mais difícil"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Anotou coisas sem as quais sua vida seria muito mais difícil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Записал вещи, без которых ваша жизнь была бы намного сложнее"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Onlar olmadan hayatınızın çok daha zor olacağı şeyleri not aldım"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 记下一些事情，没有这些你的生活会更加困难"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 記下一些事情，沒有這些你的生活會更加困難"
          }
        }
      }
    },

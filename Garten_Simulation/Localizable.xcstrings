    "plant.mystic_seed.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Kraft deines Atems f\u00fcr Entspannung und Fokus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the power of your breath for relaxation and focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el poder de tu respiraci\u00f3n para relajarte y concentrarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le pouvoir de votre respiration pour la relaxation et la concentration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0936\u094d\u0930\u093e\u092e \u0914\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0938\u093e\u0901\u0938 \u0915\u0940 \u0936\u0915\u094d\u0924\u093f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il potere del tuo respiro per il relax e la concentrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u547c\u5438\u306e\u529b\u3092\u4f7f\u3063\u3066\u3001\u30ea\u30e9\u30af\u30bc\u30fc\u30b7\u30e7\u30f3\u3068\u96c6\u4e2d\u529b\u3092\u9ad8\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud638\ud761\uc758 \ud798\uc744 \uc774\uc6a9\ud558\uc5ec \uae34\uc7a5\uc744 \ud480\uace0 \uc9d1\uc911\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de kracht van je ademhaling voor ontspanning en focus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystaj si\u0142\u0119 oddechu dla relaksu i skupienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o poder da sua respira\u00e7\u00e3o para relaxamento e foco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 \u0441\u0438\u043b\u0443 \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u044b\u0445\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0438\u044f \u0438 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u043e\u0441\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nefesinizin g\u00fcc\u00fcn\u00fc rahatlama ve odaklanma i\u00e7in kullan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5229\u7528\u547c\u5438\u7684\u529b\u91cf\u6765\u653e\u677e\u548c\u96c6\u4e2d\u6ce8\u610f\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5229\u7528\u547c\u5438\u7684\u529b\u91cf\u4f86\u653e\u9b06\u548c\u96c6\u4e2d\u8a3b\u610f\u529b\u3002"
          }
        }
      }
    },
    "plant.olivenbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebt 1000 Jahre \u2013 Best\u00e4ndigkeit pur \u2013 Mediterraner Lifestyle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lives 1,000 years \u2013 pure persistence \u2013 Mediterranean lifestyle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1.000 a\u00f1os \u2013 pura persistencia \u2013 Estilo de vida mediterr\u00e1neo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vit 1 000 ans \u2013 pure constance \u2013 Mode de vie m\u00e9diterran\u00e9en"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 \u0938\u093e\u0932 \u091c\u093f\u092f\u094b \u2013 \u0936\u0941\u0926\u094d\u0927 \u0938\u094d\u0925\u093e\u092f\u093f\u0924\u094d\u0935 \u2013 \u092d\u0942\u092e\u0927\u094d\u092f\u0938\u093e\u0917\u0930\u0940\u092f \u091c\u0940\u0935\u0928\u0936\u0948\u0932\u0940"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lives 1,000 years \u2013 pure persistence \u2013 Mediterranean lifestyle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5343\u5e74\u751f\u304d\u308b \u2013 \u7d14\u7c8b\u306a\u6c38\u7d9a\u6027 \u2013 \u5730\u4e2d\u6d77\u306e\u30e9\u30a4\u30d5\u30b9\u30bf\u30a4\u30eb"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1,000\ub144 \uc218\uba85 \u2013 \uc21c\uc218\ud55c \ub048\uae30 \u2013 \uc9c0\uc911\ud574\uc2dd \ub77c\uc774\ud504\uc2a4\ud0c0\uc77c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeft 1000 jaar \u2013 pure doorzettingsvermogen \u2013 Mediterrane levensstijl"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017byje 1000 lat \u2013 czysta wytrwa\u0142o\u015b\u0107 \u2013 \u015br\u00f3dziemnomorski styl \u017cycia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive 1.000 anos \u2013 pura persist\u00eancia \u2013 Estilo de vida mediterr\u00e2neo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0416\u0438\u0432\u0438\u0442\u0435 1000 \u043b\u0435\u0442 \u2013 \u0447\u0438\u0441\u0442\u0430\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0441\u0442\u044c \u2013 \u0441\u0440\u0435\u0434\u0438\u0437\u0435\u043c\u043d\u043e\u043c\u043e\u0440\u0441\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 y\u0131l ya\u015far \u2013 saf dayan\u0131kl\u0131l\u0131k \u2013 Akdeniz ya\u015fam tarz\u0131"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bff\u547d\u5343\u5e74 \u2013 \u7eaf\u7cb9\u7684\u6301\u4e45 \u2013 \u5730\u4e2d\u6d77\u751f\u6d3b\u65b9\u5f0f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58fd\u547d 1000 \u5e74 \u2013 \u7d14\u7cb9\u7684\u8010\u7528\u6027 \u2013 \u5730\u4e2d\u6d77\u751f\u6d3b\u65b9\u5f0f"
          }
        }
      }
    },

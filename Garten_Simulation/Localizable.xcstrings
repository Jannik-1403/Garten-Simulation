    "prog_sleep_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinke heute keinen Kaffee oder Energy-Drinks mehr nach 14:00 Uhr. Koffein hat eine Halbwertszeit von ca. 5 Stunden!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't drink coffee or energy drinks after 2 p.m. today. Caffeine has a half-life of approximately 5 hours!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tomes café ni bebidas energéticas después de las 2 p.m. hoy. ¡La cafeína tiene una vida media de aproximadamente 5 horas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne buvez pas de café ou de boissons énergisantes après 14 heures. aujourd'hui. La caféine a une demi-vie d'environ 5 heures !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोपहर 2 बजे के बाद कॉफ़ी या एनर्जी ड्रिंक न पियें। आज। कैफीन का आधा जीवन लगभग 5 घंटे का होता है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non bere caffè o bevande energetiche dopo le 14:00. Oggi. La caffeina ha un'emivita di circa 5 ore!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "午後2時以降はコーヒーやエナジードリンクを飲まないでください。今日。カフェインの半減期は約5時間！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오후 2시 이후에는 커피나 에너지 음료를 마시지 마세요. 오늘. 카페인의 반감기는 약 5시간입니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink na 14.00 uur geen koffie of energiedrankjes. Vandaag. Cafeïne heeft een halfwaardetijd van ongeveer 5 uur!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pij kawy ani napojów energetyzujących po godzinie 14:00. Dzisiaj. Kofeina ma okres półtrwania wynoszący około 5 godzin!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não beba café ou bebidas energéticas depois das 14h. hoje. A cafeína tem meia-vida de aproximadamente 5 horas!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não beba café ou bebidas energéticas depois das 14h. hoje. A cafeína tem meia-vida de aproximadamente 5 horas!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пейте кофе и энергетические напитки после 14:00. сегодня. Кофеин имеет период полураспада около 5 часов!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğleden sonra 2'den sonra kahve veya enerji içeceği içmeyin. Bugün. Kafeinin yarı ömrü yaklaşık 5 saattir!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下午 2 点后不要喝咖啡或能量饮料。今天。咖啡因的半衰期约为 5 小时！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下午 2 點後不要喝咖啡或能量飲料。今天。咖啡因的半衰期約為 5 小時！"
          }
        }
      }
    },

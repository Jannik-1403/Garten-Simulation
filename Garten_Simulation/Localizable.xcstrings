        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u0440\u043a\u043e\u0435 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u043d\u0430 \u043d\u043e\u0447\u044c."

          }
        }
      }
    },
    "assessment.finance.q3.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irgendwas zwischen 200 und 800€, ich bin mir nicht sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something between €200 and €800, I'm not sure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre 200 y 800€, no estoy seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose entre 200 et 800 €, je ne suis pas sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa tra i 200 e gli 800 euro, non ne sono sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "200ユーロから800ユーロの間くらいでしょうか、わかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "€200에서 €800 사이인 것 같은데 잘 모르겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets tussen de €200 en €800, ik weet het niet zeker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś pomiędzy 200 a 800 euro, nie jestem pewien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo entre 200€ e 800€, não tenho a certeza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "200€ ile 800€ arasında bir şey, emin değilim."
          }
        }
      }
    },
    "assessment.finance.q3.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ahnung. Ich schaue ungern auf den Kontostand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No idea. I don't like looking at the account balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni idea. No me gusta mirar el saldo de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune idée. Je n'aime pas regarder le solde du compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna idea. Non mi piace guardare il saldo del conto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかりません。私は口座残高を見るのが好きではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모르겠어요. 나는 계좌 잔액을 보는 것을 좋아하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen idee. Ik hou er niet van om naar het rekeningsaldo te kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mam pojęcia. Nie lubię patrzeć na stan konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não faço ideia. Não gosto de olhar o saldo da conta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir fikrim yok. Hesap bakiyesine bakmayı sevmiyorum."
          }
        }
      }
    },
    "assessment.finance.q3.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich weiß es auf den Euro genau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know it exactly to the euro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sé exactamente al euro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je le sais exactement à l'euro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo so esattamente all'euro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーロまでは正確にわかります。"

    "item.tier_freund.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Best\u00e4ubt 3 Pflanzen mit einem Mini-Level-Boost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pollinates 3 plants with a mini level boost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poliniza 3 plantas con un mini impulso de nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pollinise 3 plantes avec un mini boost de niveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0918\u0941 \u0938\u094d\u0924\u0930 \u0915\u0947 \u092c\u0942\u0938\u094d\u091f \u0915\u0947 \u0938\u093e\u0925 3 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u092a\u0930\u093e\u0917\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pollinates 3 plants with a mini level boost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30df\u30cb\u30ec\u30d9\u30eb\u30d6\u30fc\u30b9\u30c8\u30673\u3064\u306e\u690d\u7269\u306b\u53d7\u7c89\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubbf8\ub2c8 \ub808\ubca8 \ubd80\uc2a4\ud2b8\ub85c 3\uac1c\uc758 \uc2dd\ubb3c\uc5d0 \uc218\ubd84\uc744 \uacf5\uae09\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestuift 3 planten met een mini-niveauboost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapyla 3 ro\u015bliny z mini-zwi\u0119kszeniem poziomu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Poliniza 3 plantas com um mini boost de n\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u044b\u043b\u0438\u0442\u0435 3 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0441 \u043c\u0438\u043d\u0438-\u0431\u0443\u0441\u0442\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini seviye deste\u011fiyle 3 bitkiyi tozla\u015ft\u0131r\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a3\u682a\u690d\u7269\u6388\u7c89\uff0c\u5e76\u63d0\u4f9b\u5c0f\u5e45\u7b49\u7ea7\u63d0\u5347\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba 3 \u682a\u690d\u7269\u6388\u7c89\uff0c\u4e26\u7565\u5fae\u63d0\u5347\u7b49\u7d1a\u3002"
          }
        }
      }
    },

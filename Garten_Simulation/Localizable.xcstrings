    "plant.efeu.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breitet sich langsam aber stetig aus – tägliches Dehnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreads slowly but steadily – daily stretching"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se extiende lenta pero constantemente – estiramiento diario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'étend lentement mais sûrement – étirements quotidiens"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे लेकिन लगातार फैलता है – रोज़ाना खिंचाव"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si diffonde lentamente ma costantemente - stretching quotidiano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくりと着実に広がります - 毎日のストレッチ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리지만 꾸준하게 퍼집니다 – 매일 스트레칭"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verspreidt zich langzaam maar gestaag – dagelijks strekken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozprzestrzenia się powoli, ale równomiernie – codzienne rozciąganie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalha-se lenta mas continuamente – alongamentos diários"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalha-se lenta mas continuamente – alongamentos diários"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распространяется медленно, но постоянно – ежедневная растяжка"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş ama istikrarlı bir şekilde yayılır – günlük esneme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓慢而稳定地蔓延——每日拉伸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緩慢而穩定地傳播 - 每日拉伸"
          }
        }
      }
    },

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 방해받지 않고 25분 동안 일하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk vandaag 25 minuten zonder afleiding."
          }

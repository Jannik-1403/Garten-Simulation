    "macro.recommendation.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf deinen Körperdaten (Größe, Gewicht, Alter) empfehlen wir dir dieses Tagesziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your body data (height, weight, age), we recommend this daily goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en tus datos corporales (altura, peso, edad), te recomendamos este objetivo diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la base de vos données corporelles (taille, poids, âge), nous vous recommandons cet objectif quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके शरीर के डेटा (ऊंचाई, वजन, उम्र) के आधार पर, हम इस दैनिक लक्ष्य की सलाह देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base ai tuoi dati corporei (altezza, peso, età), ti consigliamo questo obiettivo giornaliero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身体データ（身長、体重、年齢）に基づいて、この毎日の目標をお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신체 데이터(키, 체중, 연령)를 바탕으로 이 일일 목표를 권장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van je lichaamsgegevens (lengte, gewicht, leeftijd) raden we dit dagelijkse doel aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie Twoich danych ciała (wzrost, waga, wiek), zalecamy ten codzienny cel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos seus dados corporais (altura, peso, idade), recomendamos esta meta diária."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base em seus dados corporais (altura, peso, idade), recomendamos esta meta diária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На основе ваших данных тела (рост, вес, возраст), мы рекомендуем эту дневную цель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut verilerinize (boy, kilo, yaş) dayanarak, bu günlük hedefi öneriyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于您的身体数据（身高、体重、年龄），我们推荐这个每日目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於您的身體數據（身高、體重、年齡），我們推薦這個每日目標。"
          }
        }
      }
    },
    "macro.recommendation.missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir benötigen deine Körpergröße, dein Alter und Gewicht aus Apple Health, um dir eine Empfehlung zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your height, age, and weight from Apple Health to give you a recommendation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos tu altura, edad y peso de Apple Health para darte una recomendación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin de votre taille, âge et poids d'Apple Health pour vous donner une recommandation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें आपको एक सिफारिश देने के लिए Apple Health से आपकी ऊंचाई, उम्र और वजन की आवश्यकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo bisogno della tua altezza, età e peso da Apple Health per darti un consiglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨を提供するには、Apple Healthからの身長、年齢、および体重が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천을 제공하려면 Apple Health의 키, 나이 및 체중이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben je lengte, leeftijd en gewicht van Apple Health nodig om je een aanbeveling te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebujemy Twojego wzrostu, wieku i wagi z Apple Health, aby wydać Ci zalecenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos da sua altura, idade e peso no Apple Health para te dar uma recomendação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos de sua altura, idade e peso do Apple Health para lhe dar uma recomendação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам нужны ваш рост, возраст и вес из Apple Health, чтобы дать вам рекомендацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size bir öneri sunabilmemiz için Apple Health'ten boy, yaş ve kilonuza ihtiyacımız var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要您的 Apple Health 中的身高、年龄和体重来为您提供建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們需要您的 Apple Health 中的身高、年齡和體重來為您提供建議。"
          }
        }
      }
    },
    "macro.recommendation.missing.new": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es fehlen einige Körperdaten, um dir eine genaue Empfehlung zu geben. Bitte ergänze sie in der Übersicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some body data is missing to give you an accurate recommendation. Please add it in the overview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan algunos datos corporales para darte una recomendación precisa. Por favor agréguelos a la descripción general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données corporelles sont manquantes pour vous donner une recommandation précise. Veuillez les ajouter à l'aperçu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको सटीक अनुशंसा देने के लिए कुछ बॉडी डेटा गायब है। कृपया उन्हें अवलोकन में जोड़ें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano alcuni dati del corpo per darti una raccomandazione accurata. Si prega di aggiungerli alla panoramica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な推奨を提供するには、一部の身体データが欠落しています。概要に追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 추천을 제공하기 위해 일부 신체 데이터가 누락되었습니다. 개요에 추가해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige lichaamsgegevens ontbreken om u een nauwkeurig advies te kunnen geven. Voeg ze toe aan het overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje niektórych danych ciała, aby zapewnić dokładne zalecenie. Dodaj je do zestawienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam alguns dados corporais para uma recomendação precisa. Por favor, adicione-os na visão geral."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam alguns dados corporais para fornecer uma recomendação precisa. Adicione-os à visão geral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые данные о теле отсутствуют, чтобы дать вам точную рекомендацию. Пожалуйста, добавьте их в обзор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size doğru bir öneride bulunabilmek için bazı gövde verileri eksik. Lütfen bunları genel bakışa ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少一些身体数据，无法为您提供准确的建议。请将它们添加到概述中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少一些身體數據，無法為您提供準確的建議。請將它們添加到概述中。"
          }
        }
      }
    },

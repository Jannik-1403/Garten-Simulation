    "body.tracking.status.cutting.gain.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nimmst zu statt ab. Reduziere deine täglichen Kalorien um 300 kcal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are gaining instead of losing. Reduce your daily calories by 300 kcal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás ganando peso en lugar de perderlo. Reduce tus calorías diarias en 300 kcal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prenez du poids au lieu d’en perdre. Réduisez vos calories quotidiennes de 300 kcal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वजन कम होने की बजाय बढ़ जाता है। अपनी दैनिक कैलोरी 300 किलो कैलोरी कम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrassi invece di perdere peso. Riduci le calorie giornaliere di 300 kcal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重が減るどころか太ってしまいます。一日の摂取カロリーを300kcal減らしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "살이 빠지는 대신 살이 찌게 됩니다. 일일 칼로리를 300kcal 줄이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je komt aan in plaats van af te vallen. Verminder uw dagelijkse calorieën met 300 kcal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast schudnąć, przybierasz na wadze. Zmniejsz dzienną liczbę kalorii o 300 kcal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está ganhando peso em vez de perder. Reduza 300 kcal por dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ganha peso em vez de perder peso. Reduza suas calorias diárias em 300 kcal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы набираете вес вместо того, чтобы худеть. Уменьшите ежедневную калорийность на 300 ккал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo vermek yerine kilo alırsınız. Günlük kalorilerinizi 300 kcal azaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你体重增加而不是减轻。每日热量减少 300 kcal。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你體重增加而不是減輕。每日熱量減少 300 kcal。"
          }
        }
      }
    },

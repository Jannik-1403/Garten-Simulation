            "value": "先付錢給自己"
          }
        }
      }
    },
    "prog_saving_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe heute (und generell) absolut jeden Cent auf, den du ausgibst. Bewusstsein ist der erste Schritt zur Kontrolle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today (and in general), write down absolutely every penny you spend. Awareness is the first step to control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy (y en general), anota absolutamente cada centavo que gastes. La conciencia es el primer paso para controlar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui (et en général), notez absolument chaque centime que vous dépensez. La prise de conscience est la première étape du contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज (और सामान्य तौर पर), आप जो भी पैसा खर्च करते हैं उसे बिल्कुल लिख लें। नियंत्रण के लिए जागरूकता पहला कदम है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi (e in generale), scrivi assolutamente ogni centesimo che spendi. La consapevolezza è il primo passo verso il controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日（そして一般的に）、あなたが費やしたすべてのペニーを絶対に書き留めてください。意識することがコントロールへの第一歩です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘(그리고 일반적으로) 당신이 지출한 모든 돈을 절대적으로 적어보세요. 인식은 통제의 첫 번째 단계입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf vandaag (en in het algemeen) absoluut elke cent op die u uitgeeft. Bewustzijn is de eerste stap naar controle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś (i w ogóle) zapisuj absolutnie każdą wydaną złotówkę. Świadomość jest pierwszym krokiem do kontroli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje (e em geral), anote absolutamente cada centavo que você gasta. A conscientização é o primeiro passo para o controle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje (e em geral), anote absolutamente cada centavo que você gasta. A conscientização é o primeiro passo para o controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня (да и вообще) записывайте абсолютно каждую потраченную копейку. Осведомленность – первый шаг к контролю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün (ve genel olarak), harcadığınız her kuruşu mutlaka yazın. Farkındalık kontrolün ilk adımıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天（一般来说），绝对写下你花的每一分钱。意识是控制的第一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天（一般來說），絕對寫下你花的每一分錢。意識是控制的第一步。"
          }
        }
      }
    },

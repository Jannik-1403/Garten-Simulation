            "state": "translated",
            "value": "Grows in hiding, connects everything – Networking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠れて成長し、すべてを接続 – ネットワーキング"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨어서 성장하고 모든 것을 연결합니다 – 네트워킹"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit ondergedoken, verbindt alles – Netwerken"

    "assessment.lifestyle.q3.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin immer minimal besser angezogen als der Raum es erfordert. Kleidung ist Respekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am always slightly better dressed than the room requires. Clothing is respect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre estoy un poco mejor vestido de lo que requiere la habitación. La ropa es respeto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis toujours un peu mieux habillé que ce que la pièce exige. L'habillement, c'est le respect."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं हमेशा कमरे की आवश्यकता से थोड़ा बेहतर कपड़े पहनता हूं। वस्त्र सम्मान है."

        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6bcf\u5929\u90fd\u4f1a\u6536\u5230\u5173\u4e8e\u8fd9\u682a\u690d\u7269\u7684\u63d0\u9192\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

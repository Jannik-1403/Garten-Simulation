        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik weiger onmiddellijk. Er is geen rendement zonder risico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmawiam natychmiast. Bez ryzyka nie ma powrotu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu recuso imediatamente. Não há retorno sem risco."

    "effekt.frostwarnung.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute gibt es nur 50\uff05 Coins und XP beim Gie\u00dfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only 50\uff05 coins and XP from watering today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo 50\uff05 de monedas y XP al regar hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement 50\uff05 de pi\u00e8ces et XP \u00e0 l'arrosage aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0922\u0932\u093e\u0908 \u0915\u0947 \u0938\u092e\u092f \u0915\u0947\u0935\u0932 50\uff05 \u0938\u093f\u0915\u094d\u0915\u0947 \u0914\u0930 \u090f\u0915\u094d\u0938\u092a\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Only 50\uff05 coins and XP from watering today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306e\u6c34\u3084\u308a\u306b\u3088\u308b\u30b3\u30a4\u30f3\u3068XP\u306f50\uff05\u306e\u307f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298 \ubb3c\uc744 \ubfcc\ub9ac\uba74 \ucf54\uc778\uacfc XP\uac00 50\uff05\ub9cc \uc9c0\uae09\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechts 50\uff05 munten en XP door vandaag water te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko 50\uff05 monet i XP z dzisiejszego podlewania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas 50\uff05 de moedas e XP ao regar hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u043f\u0440\u0438 \u043f\u043e\u043b\u0438\u0432\u0435 \u0434\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e 50\uff05 \u043c\u043e\u043d\u0435\u0442 \u0438 \u043e\u043f\u044b\u0442\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcnk\u00fc sulamadan yaln\u0131zca \uff0550 jeton ve XP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u6d47\u6c34\u65f6\u53ea\u670950\uff05\u7684\u91d1\u5e01\u548c\u7ecf\u9a8c\u503c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u9444\u9020\u6642\u53ea\u6709 50\uff05 \u7684\u91d1\u5e63\u548c XP\u3002"
          }
        }
      }
    },

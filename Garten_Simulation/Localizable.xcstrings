    "assessment.mental.profile.glaeserner.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "St\u00e4rke deine Resilienz durch kleine R\u00fcckschl\u00e4ge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your resilience through small setbacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece tu resiliencia a trav\u00e9s de peque\u00f1os contratiempos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcez votre r\u00e9silience face \u00e0 de petits revers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u094b\u091f\u0940-\u091b\u094b\u091f\u0940 \u0905\u0938\u092b\u0932\u0924\u093e\u0913\u0902 \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926 \u0905\u092a\u0928\u0947 \u0932\u091a\u0940\u0932\u0947\u092a\u0928 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforza la tua resilienza attraverso piccoli intoppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u3055\u306a\u632b\u6298\u3092\u901a\u3058\u3066\u56de\u5fa9\u529b\u3092\u5f37\u5316\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc791\uc740 \uc88c\uc808\uc744 \ud1b5\ud574 \ud68c\ubcf5\ub825\uc744 \uac15\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versterk je veerkracht bij kleine tegenslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmacniaj swoj\u0105 odporno\u015b\u0107 poprzez drobne niepowodzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortale\u00e7a sua resili\u00eancia atrav\u00e9s de pequenos contratempos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0440\u0435\u043f\u043b\u044f\u0439 \u0441\u0432\u043e\u044e \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u043d\u0435\u0443\u0434\u0430\u0447\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00fc\u00e7\u00fck aksiliklerle dayan\u0131kl\u0131l\u0131\u011f\u0131n\u0131z\u0131 g\u00fc\u00e7lendirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u5c0f\u7684\u632b\u6298\u589e\u5f3a\u4f60\u7684\u97e7\u6027\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u5c0f\u632b\u6298\u4f86\u589e\u5f37\u4f60\u7684\u97cc\u6027\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies morgens in den ersten 10 Minuten nach dem Aufwachen keine Nachrichten. Sch\u00fctze diese 1\uff05 des Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't read the news for the first 10 minutes after you wake up in the morning. Protect that 1\uff05 of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No leas las noticias durante los primeros 10 minutos despu\u00e9s de despertarte por la ma\u00f1ana. Protege ese 1\uff05 del d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne lisez pas les informations pendant les 10 premi\u00e8res minutes apr\u00e8s votre r\u00e9veil le matin. Prot\u00e9gez ce 1\uff05 de la journ\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u092c\u0939 \u0909\u0920\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092a\u0939\u0932\u0947 10 \u092e\u093f\u0928\u091f \u0924\u0915 \u0938\u092e\u093e\u091a\u093e\u0930 \u0928 \u092a\u0922\u093c\u0947\u0902\u0964 \u0926\u093f\u0928 \u0915\u0947 \u0909\u0938 1\uff05 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non leggere le notizie per i primi 10 minuti dopo esserti svegliato al mattino. Proteggi quell'1\uff05 della giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u671d\u8d77\u304d\u3066\u304b\u3089\u6700\u521d\u306e10\u5206\u9593\u306f\u30cb\u30e5\u30fc\u30b9\u3092\u8aad\u307e\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u4e00\u65e5\u306e 1\uff05 \u3092\u5b88\u308a\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uce68\uc5d0 \uc77c\uc5b4\ub098\uc11c \ucc98\uc74c 10\ubd84 \ub3d9\uc548\uc740 \ub274\uc2a4\ub97c \uc77d\uc9c0 \ub9c8\uc138\uc694. \ud558\ub8e8\uc758 1\uff05\ub97c \ubcf4\ud638\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees het nieuws de eerste tien minuten nadat u 's ochtends wakker wordt niet. Bescherm die 1\uff05 van de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie czytaj wiadomo\u015bci przez pierwsze 10 minut po przebudzeniu si\u0119 rano. Chro\u0144 ten 1\uff05 dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o leia as not\u00edcias nos primeiros 10 minutos depois de acordar pela manh\u00e3. Proteja esse 1\uff05 do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0447\u0438\u0442\u0430\u0439 \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u0443\u0442\u0440\u043e\u043c \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 10 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u044f. \u0417\u0430\u0449\u0438\u0449\u0430\u0439 \u044d\u0442\u043e\u0442 1\uff05 \u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah uyand\u0131ktan sonraki ilk 10 dakika haber okumay\u0131n. G\u00fcn\u00fcn \uff051\u2019ini koruyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u4e0a\u9192\u6765\u7684\u524d10\u5206\u949f\u4e0d\u8981\u770b\u65b0\u95fb\u3002\u4fdd\u62a4\u8fd9\u4e00\u5929\u76841\uff05\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u4e0a\u8d77\u5e8a\u5f8c\u7684\u524d 10 \u5206\u9418\u4e0d\u8981\u95b1\u8b80\u65b0\u805e\u3002\u4fdd\u8b77\u4e00\u5929\u4e2d\u7684\u90a3 1\uff05\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende jede Dusche mit exakt 15 Sekunden kaltem Wasser. Dieser Mini-Stress h\u00e4rtet dein Nervensystem messbar ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End each shower with exactly 15 seconds of cold water. This mini-stress measurably toughens your nervous system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza cada ducha con exactamente 15 segundos de agua fr\u00eda. Este mini estr\u00e9s fortalece considerablemente su sistema nervioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez chaque douche avec exactement 15 secondes d\u2019eau froide. Ce mini-stress renforce de mani\u00e8re mesurable votre syst\u00e8me nerveux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u094d\u0928\u093e\u0928 \u0915\u094b \u0920\u0940\u0915 15 \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u0920\u0902\u0921\u0947 \u092a\u093e\u0928\u0940 \u0938\u0947 \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u091b\u094b\u091f\u093e-\u0938\u093e \u0924\u0928\u093e\u0935 \u0906\u092a\u0915\u0947 \u0924\u0902\u0924\u094d\u0930\u093f\u0915\u093e \u0924\u0902\u0924\u094d\u0930 \u0915\u094b \u0915\u093e\u092b\u0940 \u0939\u0926 \u0924\u0915 \u0938\u0916\u094d\u0924 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina ogni doccia con esattamente 15 secondi di acqua fredda. Questo mini-stress rafforza in modo misurabile il tuo sistema nervoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5404\u30b7\u30e3\u30ef\u30fc\u3092\u3061\u3087\u3046\u3069 15 \u79d2\u9593\u51b7\u6c34\u3067\u7d42\u4e86\u3057\u307e\u3059\u3002\u3053\u306e\u5c0f\u3055\u306a\u30b9\u30c8\u30ec\u30b9\u306f\u3001\u795e\u7d4c\u7cfb\u3092\u660e\u3089\u304b\u306b\u5f37\u5316\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\ud655\ud788 15\ucd08 \ub3d9\uc548 \ucc2c\ubb3c\ub85c \uc0e4\uc6cc\ub97c \ub9c8\uce69\ub2c8\ub2e4. \uc774 \uc791\uc740 \uc2a4\ud2b8\ub808\uc2a4\ub294 \uc2e0\uacbd\uacc4\ub97c \uc0c1\ub2f9\ud788 \uac15\ud654\uc2dc\ud0b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Be\u00ebindig elke douche met precies 15 seconden koud water. Deze mini-stress versterkt je zenuwstelsel meetbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zako\u0144cz ka\u017cdy prysznic dok\u0142adnie 15 sekundami zimnej wody. Ten mini-stres wymiernie wzmacnia Tw\u00f3j uk\u0142ad nerwowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine cada banho com exatamente 15 segundos de \u00e1gua fria. Esse mini-estresse fortalece de forma mensur\u00e1vel o sistema nervoso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0439 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0443\u0448 \u0440\u043e\u0432\u043d\u043e 15 \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u043c\u0438 \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0439 \u0432\u043e\u0434\u044b. \u042d\u0442\u043e\u0442 \u043c\u0438\u043d\u0438-\u0441\u0442\u0440\u0435\u0441\u0441 \u043e\u0449\u0443\u0442\u0438\u043c\u043e \u0437\u0430\u043a\u0430\u043b\u044f\u0435\u0442 \u0442\u0432\u043e\u044e \u043d\u0435\u0440\u0432\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her du\u015fu tam olarak 15 saniye so\u011fuk suyla sonland\u0131r\u0131n. Bu mini stres sinir sisteminizi \u00f6l\u00e7\u00fclebilir \u015fekilde g\u00fc\u00e7lendirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u6dcb\u6d74\u90fd\u4ee5\u51c6\u786e15\u79d2\u7684\u51b7\u6c34\u7ed3\u675f\u3002\u8fd9\u79cd\u5c0f\u538b\u529b\u663e\u8457\u5f3a\u5316\u4f60\u7684\u795e\u7ecf\u7cfb\u7edf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u6dcb\u6d74\u7d50\u675f\u6642\u7528\u51b7\u6c34\u6b63\u597d 15 \u79d2\u3002\u9019\u7a2e\u5fae\u5c0f\u7684\u58d3\u529b\u53ef\u4ee5\u986f\u8457\u589e\u5f37\u4f60\u7684\u795e\u7d93\u7cfb\u7d71\u3002"
          }
        }
      }
    },
    "assessment.mental.profile.glaeserner.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Druck entsteht, f\u00e4ngst du an zu br\u00f6ckeln. Du musst deinen K\u00f6rper und Geist an extrem kleine Dosen von Stress gew\u00f6hnen, um Resilienz aufzubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as pressure arises, you start to crumble. You must accustom your body and mind to extremely small doses of stress to build resilience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan pronto como surge la presi\u00f3n, empiezas a desmoronarte. Debe acostumbrar su cuerpo y su mente a dosis extremadamente peque\u00f1as de estr\u00e9s para desarrollar su resiliencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e8s que la pression monte, vous commencez \u00e0 vous effondrer. Vous devez habituer votre corps et votre esprit \u00e0 des doses de stress extr\u00eamement faibles pour renforcer votre r\u00e9silience."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u092c\u093e\u0935 \u092a\u0921\u093c\u0924\u0947 \u0939\u0940 \u0906\u092a \u092c\u093f\u0916\u0930\u0928\u0947 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u091a\u0940\u0932\u093e\u092a\u0928 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0914\u0930 \u0926\u093f\u092e\u093e\u0917 \u0915\u094b \u0924\u0928\u093e\u0935 \u0915\u0940 \u092c\u0947\u0939\u0926 \u091b\u094b\u091f\u0940 \u0916\u0941\u0930\u093e\u0915 \u0915\u093e \u0906\u0926\u0940 \u092c\u0928\u093e\u0928\u093e \u0939\u094b\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appena aumenta la pressione, inizi a sgretolarti. Devi abituare il tuo corpo e la tua mente a dosi estremamente piccole di stress per sviluppare la resilienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u304c\u304b\u304b\u308b\u3068\u3059\u3050\u306b\u5d29\u308c\u59cb\u3081\u307e\u3059\u3002\u56de\u5fa9\u529b\u3092\u9ad8\u3081\u308b\u306b\u306f\u3001\u6975\u5ea6\u306b\u5c11\u91cf\u306e\u30b9\u30c8\u30ec\u30b9\u306b\u4f53\u3068\u5fc3\u3092\u6163\u308c\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc555\ub825\uc774 \uac00\ud574\uc9c0\uba74 \ubb34\ub108\uc9c0\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4. \ud68c\ubcf5\ub825\uc744 \ud0a4\uc6b0\ub824\uba74 \ubab8\uacfc \ub9c8\uc74c\uc774 \uadf9\ub3c4\ub85c \uc801\uc740 \uc591\uc758 \uc2a4\ud2b8\ub808\uc2a4\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra er druk ontstaat, begin je af te brokkelen. Je moet je lichaam en geest wennen aan extreem kleine doses stress om veerkracht op te bouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy tylko pojawi si\u0119 ci\u015bnienie, zaczniesz si\u0119 kruszy\u0107. Aby zbudowa\u0107 odporno\u015b\u0107, musisz przyzwyczai\u0107 swoje cia\u0142o i umys\u0142 do wyj\u0105tkowo ma\u0142ych dawek stresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que surge a press\u00e3o, voc\u00ea come\u00e7a a desmoronar. Voc\u00ea deve acostumar seu corpo e mente a doses extremamente pequenas de estresse para construir resili\u00eancia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u0435, \u0442\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0448\u044c \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u0442\u044c\u0441\u044f. \u0422\u0435\u0431\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u0438\u0443\u0447\u0430\u0442\u044c \u0441\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u0438 \u0440\u0430\u0437\u0443\u043c \u043a \u044d\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u043e \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u043c \u0434\u043e\u0437\u0430\u043c \u0441\u0442\u0440\u0435\u0441\u0441\u0430, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044c \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bask\u0131 olu\u015ftu\u011fu anda par\u00e7alanmaya ba\u015flars\u0131n\u0131z. Dayan\u0131kl\u0131l\u0131k geli\u015ftirmek i\u00e7in v\u00fccudunuzu ve zihninizi son derece k\u00fc\u00e7\u00fck dozlarda strese al\u0131\u015ft\u0131rman\u0131z gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u65e6\u4ea7\u751f\u538b\u529b\uff0c\u4f60\u5c31\u5f00\u59cb\u5d29\u6e83\u3002\u4f60\u5fc5\u987b\u8ba9\u4f60\u7684\u8eab\u4f53\u548c\u7cbe\u795e\u4e60\u60ef\u4e8e\u6781\u5c0f\u5242\u91cf\u7684\u538b\u529b\uff0c\u4ee5\u5efa\u7acb\u97e7\u6027\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u65e6\u58d3\u529b\u51fa\u73fe\uff0c\u4f60\u5c31\u958b\u59cb\u5d29\u6f70\u3002\u60a8\u5fc5\u9808\u8b93\u81ea\u5df1\u7684\u8eab\u9ad4\u548c\u601d\u60f3\u9069\u61c9\u6975\u5c0f\u5291\u91cf\u7684\u58d3\u529b\uff0c\u4ee5\u589e\u5f37\u6062\u5fa9\u80fd\u529b\u3002"
          }
        }
      }
    },

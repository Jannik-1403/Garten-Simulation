    "pfad_produktiv_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane heute deine kommenden 7 Tage im Voraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan your next 7 days in advance today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica hoy tus pr\u00f3ximos 7 d\u00edas con antelaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifie aujourd'hui tes 7 prochains jours \u00e0 l'avance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0939\u0940 \u0905\u092a\u0928\u0947 \u0905\u0917\u0932\u0947 7 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u092f\u094b\u091c\u0928\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u092c\u0928\u093e \u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica oggi i tuoi prossimi 7 giorni in anticipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u304b\u3089 7 \u65e5\u524d\u306b\u6b21\u306e\u8a08\u753b\u3092\u7acb\u3066\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\ubd80\ud130 \ub2e4\uc74c 7\uc77c\uc744 \ubbf8\ub9ac \uacc4\ud68d\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan vandaag nog uw volgende 7 dagen van tevoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj swoje kolejne 7 dni wcze\u015bniej ju\u017c dzi\u015b."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeia hoje os teus pr\u00f3ximos 7 dias com anteced\u00eancia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043b\u0430\u043d\u0438\u0440\u0443\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0441\u0432\u043e\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u044f\u0449\u0438\u0435 7 \u0434\u043d\u0435\u0439 \u0437\u0430\u0440\u0430\u043d\u0435\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek 7 g\u00fcn\u00fcn\u00fcz\u00fc bug\u00fcn \u00f6nceden planlay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u63d0\u524d\u89c4\u5212\u4f60\u672a\u67657\u5929\u7684\u65e5\u7a0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u5c31\u63d0\u524d\u898f\u5283\u60a8\u63a5\u4e0b\u4f86\u7684 7 \u5929\u3002"
          }
        }
      }
    },

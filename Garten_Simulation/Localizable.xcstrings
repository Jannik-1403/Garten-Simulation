    "assessment.fitness.profile.wohlfuehler.action" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe die Intensität. Das Workout beginnt erst, wenn es wehtut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase the intensity. The workout only starts when it hurts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta la intensidad. El entrenamiento sólo comienza cuando duele."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentez l’intensité. L'entraînement ne commence que lorsque ça fait mal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीव्रता बढ़ाएँ. वर्कआउट तभी शुरू होता है जब दर्द होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta l'intensità. L'allenamento inizia solo quando fa male."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強度を上げます。トレーニングは痛みが出たときにのみ始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강도를 높이세요. 운동은 아플 때만 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhoog de intensiteit. De training begint pas als het pijn doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiększ intensywność. Trening rozpoczyna się dopiero wtedy, gdy zaczyna boleć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente a intensidade. O treino só começa quando dói."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличь интенсивность. Тренировка начинается только тогда, когда больно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoğunluğu artırın. Antrenman ancak canın acıdığında başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高强度。锻炼只有在感到疼痛时才开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加強度。運動只有在疼痛時才開始。"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dein Handy für die nächsten 3 Workouts im Spind. Das verhindert endlose Pausen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave your phone in the locker for the next 3 workouts. This prevents endless breaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja tu teléfono en el casillero durante los próximos 3 entrenamientos. Esto evita pausas interminables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez votre téléphone dans le casier pour les 3 prochaines séances d'entraînement. Cela évite des pauses interminables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले तीन वर्कआउट के लिए अपने फोन को लॉकर में छोड़ दें। यह अंतहीन ब्रेक को रोकता है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia il telefono nell'armadietto per i prossimi 3 allenamenti. Ciò impedisce pause infinite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の 3 つのワークアウトの間、携帯電話をロッカーに保管しておいてください。これにより、無限の休憩が防止されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 3번의 운동을 위해 휴대폰을 사물함에 넣어두세요. 이렇게 하면 끝없는 중단이 방지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je telefoon de komende 3 trainingen in het kluisje. Dit voorkomt eindeloze pauzes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaw telefon w szafce na kolejne 3 treningi. Zapobiega to niekończącym się przerwom."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe seu telefone no armário para os próximos 3 treinos. Isso evita pausas intermináveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставь свой телефон в шкафчике на следующие 3 тренировки. Это предотвратит бесконечные перерывы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki 3 antrenman için telefonunuzu dolabınızda bırakın. Bu sonsuz molaları önler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的手机在接下来的3次锻炼中放在储物柜里。这可以防止无休止的休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將手機留在儲物櫃中以供接下來 3 次鍛鍊使用。這可以防止無休止的中斷。"
          }
        }
      }
    },
    "assessment.fitness.profile.wohlfuehler.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe das Gewicht bei deiner Lieblingsübung heute um die allerkleinste Scheibe (1kg / 1.25kg)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Increase the weight of your favorite exercise today by the smallest disc (1kg / 1.25kg)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta hoy el peso de tu ejercicio favorito con el disco más pequeño (1kg/1,25kg)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

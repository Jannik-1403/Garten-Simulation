        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043b\u0438\u0447\u043d\u043e! \u0422\u0430\u043a \u0442\u044b \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0448\u044c \u0437\u0430 \u0441\u0432\u043e\u0438\u043c\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c\u0438."

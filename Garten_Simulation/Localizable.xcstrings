    "leben.regel1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gieße deine Pflanzen täglich um Leben zu behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants daily to keep your lives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tus plantas diariamente para conservar tus vidas"

            "state": "translated",
            "value": "Zapisz: ile godzin siedziałeś dzisiaj? Czego ci przez to brakuje?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote: quantas horas você ficou sentado hoje? O que está perdendo por isso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote: quantas horas você ficou sentado hoje? O que está perdendo por isso?"
          }
        },
        "ru": {

    "tour_2_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf deine Umgebung! Schlechte Gewohnheiten sammeln sich als Müll an und stören deinen schönen Garten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay attention to your surroundings! Bad habits accumulate as trash and ruin your beautiful garden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Presta atención a tu entorno! Los malos hábitos se acumulan como basura y arruinan tu hermoso jardín."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites attention à votre environnement ! Les mauvaises habitudes s'accumulent comme des déchets et ruinent votre beau jardin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने पर्यावरण पर ध्यान दें! बुरी आदतें कचरे के रूप में जमा होती हैं और आपके सुंदर बगीचे में परेशानी पैदा करती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presta attenzione all'ambiente circostante! Le cattive abitudini si accumulano come spazzatura e rovinano il tuo bellissimo giardino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周囲の環境に注意してください！悪い習慣はゴミとしてたまり、あなたの美しい庭を台無しにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 환경에 주의하세요! 나쁜 습관은 쓰레기처럼 쌓여 당신의 아름다운 정원을 망칩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op je omgeving! Slechte gewoonten hopen zich op als afval en verpesten je prachtige tuin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwracaj uwagę na otoczenie! Złe nawyki gromadzą się jak śmieci i niszczą twój piękny ogród."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preste atenção ao seu redor! Maus hábitos se acumulam como lixo e arruínam seu lindo jardim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратите внимание на свое окружение! Вредные привычки накапливаются как мусор и разрушают ваш прекрасный сад."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrenize dikkat edin! Kötü alışkanlıklar çöp gibi birikir ve güzel bahçenizi mahveder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意你周围的环境！坏习惯会像垃圾一样堆积起来，破坏你美丽的花园。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意你周圍的環境！壞習慣會像垃圾一樣堆積起來，破壞你美麗的花園。"
          }
        }
      }
    },

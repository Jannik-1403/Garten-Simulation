        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u043e \u044d\u0442\u043e\u043c \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0438."

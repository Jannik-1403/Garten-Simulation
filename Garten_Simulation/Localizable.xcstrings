        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0915\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u093f\u0915\u094d\u0915\u0947 \u0916\u0930\u0940\u0926\u0947\u0902"

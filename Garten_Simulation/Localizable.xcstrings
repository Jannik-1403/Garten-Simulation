    "assessment.category.headline": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen Bereich m\u00f6chtest du testen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which area do you want to test?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQu\u00e9 \u00e1rea quieres probar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel domaine voulez-vous tester\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0915\u093f\u0938 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale area vuoi testare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3069\u306e\u9818\u57df\u3092\u30c6\u30b9\u30c8\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\ub5a4 \uc601\uc5ed\uc744 \ud14c\uc2a4\ud2b8\ud558\uace0 \uc2f6\uc73c\uc2e0\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk gebied wil je testen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kt\u00f3ry obszar chcesz przetestowa\u0107?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual \u00e1rea voc\u00ea deseja testar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0442\u044b \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c?"
          }
        },
        "tr": {

    "assessment.health.profile.ignorant.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lebst nach dem Prinzip 'Wird schon gut gehen'. Lerne die Signale deines Körpers frühzeitig zu erkennen und präventiv zu handeln."

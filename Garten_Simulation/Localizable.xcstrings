    "assessment.lifestyle.profile.gefangener.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Push-Benachrichtigungen von WhatsApp-Gruppen stumm, in denen nur gejammert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute push notifications from whining WhatsApp groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia las notificaciones autom\u00e1ticas de los grupos de WhatsApp quejosos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9sactivez les notifications push des groupes WhatsApp pleurnicheurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u0917\u094d\u0930\u0941\u092a\u094b\u0902 \u0938\u0947 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u0941\u0936 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0915\u094b \u092e\u094d\u092f\u0942\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva l'audio delle notifiche push dei gruppi WhatsApp piagnucolosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u611a\u75f4\u3092\u3053\u307c\u3059 WhatsApp \u30b0\u30eb\u30fc\u30d7\u304b\u3089\u306e\u30d7\u30c3\u30b7\u30e5\u901a\u77e5\u3092\u30df\u30e5\u30fc\u30c8\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9d5\uc9d5\uac70\ub9ac\ub294 WhatsApp \uadf8\ub8f9\uc758 \ud478\uc2dc \uc54c\ub9bc\uc744 \uc74c\uc18c\uac70\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demp pushmeldingen van zeurende WhatsApp-groepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz powiadomienia push z marudz\u0105cych grup WhatsApp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencie notifica\u00e7\u00f5es push de grupos chor\u00f5es do WhatsApp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u043b\u044e\u0447\u0438 push-\u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u043e\u0442 \u0433\u0440\u0443\u043f\u043f WhatsApp, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0430\u043b\u0443\u044e\u0442\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131zlanan WhatsApp gruplar\u0131ndan gelen anl\u0131k bildirimleri sessize al\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u53ea\u4f1a\u62b1\u6028\u7684 WhatsApp \u7fa4\u7ec4\u7684\u63a8\u9001\u901a\u77e5\u9759\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u975c\u97f3\u4f86\u81ea\u62b1\u6028\u7684 WhatsApp \u7fa4\u7d44\u7684\u63a8\u64ad\u901a\u77e5\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.profile.gefangener.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe pro Woche nur einer Person auf LinkedIn oder per Mail, die ein Level \u00fcber dir ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write to only one person a week on LinkedIn or via email who is one level above you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe solo a una persona por semana en LinkedIn o por correo electr\u00f3nico que est\u00e9 un nivel por encima del tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9crivez \u00e0 une seule personne par semaine sur LinkedIn ou par e-mail qui se trouve un niveau au-dessus de vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093f\u0902\u0915\u094d\u0921\u0907\u0928 \u092a\u0930 \u092f\u093e \u0908\u092e\u0947\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u094d\u0930\u0924\u093f \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947\u0935\u0932 \u090f\u0915 \u0939\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0932\u093f\u0916\u0947\u0902 \u091c\u094b \u0906\u092a\u0938\u0947 \u090f\u0915 \u0938\u094d\u0924\u0930 \u090a\u092a\u0930 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi solo a una persona a settimana su LinkedIn o via email che \u00e8 un livello sopra di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn \u307e\u305f\u306f\u96fb\u5b50\u30e1\u30fc\u30eb\u3067\u3001\u81ea\u5206\u3088\u308a 1 \u3064\u4e0a\u306e\u30ec\u30d9\u30eb\u306e\u4eba\u306b\u9031\u306b 1 \u4eba\u3060\u3051\u624b\u7d19\u3092\u66f8\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn\uc774\ub098 \uc774\uba54\uc77c\uc744 \ud1b5\ud574 \uc77c\uc8fc\uc77c\uc5d0 \ud55c \ub2e8\uacc4 \uc704\uc758 \uc0ac\ub78c\uc5d0\uac8c\ub9cc \ud3b8\uc9c0\ub97c \uc4f0\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf slechts \u00e9\u00e9n persoon per week op LinkedIn of via e-mail die \u00e9\u00e9n niveau boven u staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz tylko do jednej osoby tygodniowo na LinkedIn lub przez e-mail, kt\u00f3ra jest o jeden poziom wy\u017cej od Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva para apenas uma pessoa por semana no LinkedIn ou por e-mail que esteja um n\u00edvel acima de voc\u00ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0438\u0448\u0438 \u043a\u0430\u0436\u0434\u0443\u044e \u043d\u0435\u0434\u0435\u043b\u044e \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0443 \u0432 LinkedIn \u0438\u043b\u0438 \u043f\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0432\u044b\u0448\u0435 \u0442\u0435\u0431\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaln\u0131zca LinkedIn'de veya e-posta yoluyla sizden bir seviye \u00fcst\u00fcn\u00fczdeki bir ki\u015fiye yaz\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5468\u53ea\u7ed9LinkedIn\u4e0a\u6216\u901a\u8fc7\u90ae\u4ef6\u5199\u4e00\u5c01\u4fe1\u7ed9\u6bd4\u4f60\u804c\u4f4d\u9ad8\u4e00\u7b49\u7ea7\u7684\u4eba\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u9031\u50c5\u5728 LinkedIn \u4e0a\u6216\u900f\u904e\u96fb\u5b50\u90f5\u4ef6\u5beb\u4fe1\u7d66\u6bd4\u60a8\u9ad8\u4e00\u7d1a\u7684\u4eba\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.profile.gefangener.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Umfeld zieht dich nach unten. Du musst dein Netzwerk nicht von heute auf morgen wechseln \u2013 fang mit 1\uff05 Digitalisierung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your environment is pulling you down. You don\u2019t have to change your network overnight \u2013 start with 1\uff05 digitization."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu entorno te est\u00e1 hundiendo. No es necesario que cambie su red de la noche a la ma\u00f1ana: comience con un 1 \uff05 de digitalizaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre environnement vous tire vers le bas. Vous n\u2019\u00eates pas oblig\u00e9 de changer de r\u00e9seau du jour au lendemain : commencez par 1 \uff05 de num\u00e9risation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0906\u092a\u0915\u094b \u0928\u0940\u091a\u0947 \u0916\u0940\u0902\u091a \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u093e \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0930\u093e\u0924\u094b\u0902-\u0930\u093e\u0924 \u092c\u0926\u0932\u0928\u0947 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948 - 1\uff05 \u0921\u093f\u091c\u093f\u091f\u0932\u0940\u0915\u0930\u0923 \u0938\u0947 \u0936\u0941\u0930\u0941\u0906\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ambiente ti sta buttando gi\u00f9. Non devi cambiare la tua rete da un giorno all\u2019altro: inizia con una digitalizzazione dell\u20191\uff05."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u74b0\u5883\u304c\u3042\u306a\u305f\u3092\u5f15\u304d\u305a\u308a\u4e0b\u308d\u3057\u3066\u3044\u307e\u3059\u3002\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3092\u4e00\u591c\u306b\u3057\u3066\u5909\u66f4\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u307e\u305a\u306f 1\uff05 \u306e\u30c7\u30b8\u30bf\u30eb\u5316\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \ud658\uacbd\uc774 \ub2f9\uc2e0\uc744 \ub04c\uc5b4\ub0b4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud558\ub8e8\uc544\uce68\uc5d0 \ub124\ud2b8\uc6cc\ud06c\ub97c \ubcc0\uacbd\ud560 \ud544\uc694\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. 1\uff05 \ub514\uc9c0\ud138\ud654\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je omgeving trekt je naar beneden. U hoeft uw netwerk niet van de ene op de andere dag te veranderen \u2013 begin met 1\uff05 digitalisering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje otoczenie ci\u0105gnie Ci\u0119 w d\u00f3\u0142. Nie musisz zmienia\u0107 sieci z dnia na dzie\u0144 \u2013 zacznij od cyfryzacji 1\uff05."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ambiente est\u00e1 puxando voc\u00ea para baixo. Voc\u00ea n\u00e3o precisa mudar sua rede da noite para o dia \u2013 comece com 1\uff05 de digitaliza\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0435 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0442\u044f\u043d\u0435\u0442 \u0442\u0435\u0431\u044f \u0432\u043d\u0438\u0437. \u0422\u0435\u0431\u0435 \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u043c\u0435\u043d\u044f\u0442\u044c \u0441\u0432\u043e\u044e \u0441\u0435\u0442\u044c \u0441 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0433\u043e \u0434\u043d\u044f \u043d\u0430 \u0437\u0430\u0432\u0442\u0440\u0430 \u2013 \u043d\u0430\u0447\u043d\u0438 \u0441 1\uff05 \u0446\u0438\u0444\u0440\u043e\u0432\u0438\u0437\u0430\u0446\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7evreniz sizi a\u015fa\u011f\u0131 \u00e7ekiyor. A\u011f\u0131n\u0131z\u0131 bir gecede de\u011fi\u015ftirmenize gerek yok; \uff051 dijitalle\u015ftirmeyle ba\u015flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u73af\u5883\u5728\u62c9\u4f60\u5411\u4e0b\u3002\u4f60\u4e0d\u5fc5\u5728\u4e00\u591c\u4e4b\u95f4\u66f4\u6362\u4f60\u7684\u7f51\u7edc\u2014\u2014\u4ece1\uff05\u7684\u6570\u5b57\u5316\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u74b0\u5883\u6b63\u5728\u62d6\u57ae\u4f60\u3002\u60a8\u4e0d\u5fc5\u5728\u4e00\u591c\u4e4b\u9593\u6539\u8b8a\u60a8\u7684\u4eba\u8108\u2014\u2014\u5f9e 1\uff05 \u7684\u6578\u4f4d\u5316\u958b\u59cb\u3002"
          }
        }
      }
    },

    "Du hast die App zu lange verlassen. Dein Fokus-Timer wurde abgebrochen.": {
      "comment": "An alert message that appears when the user exits the app for too long during a focus session. It informs the user that the focus session has been cancelled.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true
    },
    "Du warst %lld Minuten lang extrem fokussiert. Die XP werden auf alle deine Pflanzen aufgeteilt!": {
      "comment": "A description below the success text, indicating how much XP the user earned and how it will be distributed among their plants. The argument is the number of minutes the user spent focused.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true
    },
    "effekt.erholung.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanze erholt sich nach der Wiederbelebung. Wachstum ist vorübergehend reduziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is recovering after being revived. Growth is temporarily reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planta se está recuperando tras ser revivida. El crecimiento está temporalmente reducido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plante récupère après avoir été ranimée. La croissance est temporairement réduite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "The plant is recovering after being revived. Growth is temporarily reduced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "植物は復活して回復しています。成長は一時的に低下します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물이 부활한 후 회복되고 있습니다. 성장이 일시적으로 감소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plant herstelt zich nadat hij nieuw leven is ingeblazen. De groei wordt tijdelijk verminderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roślina wraca do zdrowia po ożywieniu. Wzrost jest chwilowo ograniczony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A planta está a recuperar após ser revivida. O crescimento está temporariamente reduzido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitki yeniden canlandırıldıktan sonra iyileşiyor. Büyüme geçici olarak azalır."
          }
        }
      }
    },

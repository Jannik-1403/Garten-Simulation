    "onboarding_benachrichtigung_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll ich dich an deine Gewohnheiten erinnern? So vergisst du nie zu gießen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I remind you of your habits? That way you'll never forget to water!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres que te recuerde tus hábitos? ¡Así nunca olvidarás regar!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois-je te rappeler tes habitudes ? Ainsi, tu n'oublieras jamais d'arroser !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I remind you of your habits? That way you'll never forget to water!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの習慣を思い出させたほうがいいでしょうか？そうすれば水やりを忘れることがなくなりますよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 습관을 상기시켜 드려야 할까요? 그렇게 하면 물 주는 것을 결코 잊지 않을 것입니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moet ik je aan je gewoontes herinneren? Zo vergeet je nooit meer water te geven!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam ci przypomnieć o twoich nawykach? Dzięki temu nigdy nie zapomnisz o podlaniu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres que te lembre dos teus hábitos? Assim nunca te esquecerás de regar!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana alışkanlıklarını hatırlatmalı mıyım? Böylece sulamayı asla unutmayacaksınız!"
          }
        }
      }
    },

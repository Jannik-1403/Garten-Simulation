    "streak.motivation.3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist st\u00e4rker als du denkst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are stronger than you think."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres m\u00e1s fuerte de lo que crees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es plus fort que tu ne le penses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u0907\u0938\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092e\u091c\u092c\u0942\u0924 \u0939\u094b \u091c\u093f\u0924\u0928\u093e \u0924\u0941\u092e \u0938\u094b\u091a\u0924\u0947 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "You are stronger than you think."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u601d\u3063\u3066\u3044\u308b\u3088\u308a\u5f37\u3044\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ub2f9\uc2e0\uc774 \uc0dd\uac01\ud558\ub294 \uac83\ubcf4\ub2e4 \ub354 \uac15\ud558\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent sterker dan je denkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b silniejszy ni\u017c my\u015blisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9s mais forte do que pensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0441\u0438\u043b\u044c\u043d\u0435\u0435, \u0447\u0435\u043c \u0434\u0443\u043c\u0430\u0435\u0448\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fc\u015f\u00fcnd\u00fc\u011f\u00fcnden daha g\u00fc\u00e7l\u00fcs\u00fcn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6bd4\u4f60\u60f3\u8c61\u7684\u66f4\u575a\u5f3a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6bd4\u4f60\u60f3\u50cf\u7684\u66f4\u5805\u5f37\u3002"
          }
        }
      }
    },
    "streak.motivation.4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unkraut w\u00e4chst nicht in gepflegten G\u00e4rten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeds don't grow in well-kept gardens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La maleza no crece en jardines cuidados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises herbes ne poussent pas dans les jardins bien entretenus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094c\u0902\u0926\u0930\u094d\u092f\u092a\u0942\u0930\u094d\u0923 \u092c\u093e\u0917\u093c\u094b\u0902 \u092e\u0947\u0902 \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0928\u0939\u0940\u0902 \u0909\u0917\u0924\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeds don't grow in well-kept gardens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u624b\u5165\u308c\u306e\u884c\u304d\u5c4a\u3044\u305f\u5ead\u306b\u306f\u96d1\u8349\u306f\u751f\u3048\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc798 \uad00\ub9ac\ub41c \uc815\uc6d0\uc5d0\uc11c\ub294 \uc7a1\ucd08\uac00 \uc790\ub77c\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In goed onderhouden tuinen groeit onkruid niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwasty nie rosn\u0105 w dobrze utrzymanych ogrodach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas n\u00e3o crescem em jardins bem cuidados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0440\u043d\u044f\u043a\u0438 \u043d\u0435 \u0440\u0430\u0441\u0442\u0443\u0442 \u0432 \u0443\u0445\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0441\u0430\u0434\u0430\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bak\u0131ml\u0131 bah\u00e7elerde yabani otlar yeti\u015fmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6742\u8349\u4e0d\u4f1a\u5728\u7ef4\u62a4\u826f\u597d\u7684\u82b1\u56ed\u91cc\u751f\u957f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96dc\u8349\u4e0d\u6703\u5728\u7dad\u8b77\u826f\u597d\u7684\u82b1\u5712\u4e2d\u751f\u9577\u3002"
          }
        }
      }
    },

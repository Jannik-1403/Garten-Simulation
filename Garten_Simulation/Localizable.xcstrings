          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les problèmes de la semaine sont honnêtement reflétés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह के मुद्दे ईमानदारी से प्रतिबिंबित"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I problemi della settimana si riflettono onestamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の問題を正直に反映"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번주 이슈를 솔직하게 반영"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De problemen van de week werden eerlijk weerspiegeld"
          }
        },
        "pl": {

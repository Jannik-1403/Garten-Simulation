    "dopamine_story_s2_sub": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unerwartete Belohnungen feuern Dopamin am stärksten. Genau dieses „Mal gibt's was, mal nicht“ steckt in jedem Feed."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected rewards fire dopamine the strongest. Exactly this 'sometimes there is something, sometimes not' is in every feed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recompensas inesperadas estimulan más la dopamina. Precisamente esto de 'a veces hay algo, a veces no' está en cada feed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récompenses inattendues libèrent le plus de dopamine. C'est exactement ce 'parfois il y a quelque chose, parfois non' que l'on trouve dans chaque feed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अप्रत्याशित इनाम डोपामाइन को सबसे मजबूत बनाते हैं। ठीक यही 'कभी कुछ होता है, कभी नहीं' हर फ़ीड में होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricompense inaspettate stimolano maggiormente la dopamina. Esattamente questo 'a volte c'è qualcosa, a volte no' si trova in ogni feed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期せぬ報酬はドーパミンを最も強く発火させます。まさにこの「たまに何かある、たまに何もない」がすべてのフィードに潜んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상치 못한 보상은 도파민을 가장 강하게 분비시킵니다. '어떨 때는 있고, 어떨 때는 없는' 이것이 모든 피드에 숨어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onverwachte beloningen vuren dopamine het sterkst. Precies dit 'soms is er iets, soms niet' zit in elke feed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niespodziewane nagrody najsilniej uwalniają dopaminę. Właśnie to 'czasem coś jest, czasem nie' kryje się w każdym feedzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompensas inesperadas disparam mais a dopamina. Exatamente este 'às vezes há algo, às vezes não' está em cada feed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompensas inesperadas disparam a dopamina de forma mais forte. Exatamente esse 'às vezes tem algo, às vezes não' está presente em todos os feeds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неожиданные награды сильнее всего стимулируют дофамин. Именно это 'иногда есть что-то, иногда нет' кроется в каждой ленте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenmedik ödüller dopamini en güçlü şekilde ateşler. Tam olarak bu 'bazen bir şey var, bazen yok' her akışta bulunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "意想不到的奖励最能刺激多巴胺。正是这种“有时候有，有时候没有”的感觉充斥在每个信息流中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "意想不到的獎勵最能刺激多巴胺。正是這種「有時候有，有時候沒有」的感覺充斥在每個信息流中。"
          }
        }
      }
    },

    "trash.alkohol_flatrate.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere alle Alkohol-Vorr\u00e4te aus dem Haus \u2013 was nicht da ist, wird nicht getrunken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty all alcohol supplies from home \u2013 what's not there won't be drunk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vac\u00eda todas las reservas de alcohol de casa: lo que no est\u00e1 no se bebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide toutes les r\u00e9serves d'alcool \u00e0 la maison \u2013 ce qui n'est pas l\u00e0 ne sera pas bu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0918\u0930 \u0938\u0947 \u0938\u092d\u0940 \u0936\u0930\u093e\u092c \u0915\u0940 \u092d\u0902\u0921\u093e\u0930 \u0938\u093e\u092b \u0915\u0930 \u0926\u0947\u0902 \u2013 \u091c\u094b \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0909\u0938\u0947 \u0915\u094b\u0908 \u0928\u0939\u0940\u0902 \u092a\u0940\u090f\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota tutte le scorte di alcolici da casa \u2013 quello che non c'\u00e8 non viene bevuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bb6\u306e\u30a2\u30eb\u30b3\u30fc\u30eb\u306e\u5728\u5eab\u3092\u3059\u3079\u3066\u51e6\u5206\u3057\u307e\u3057\u3087\u3046\u3002\u306a\u3051\u308c\u3070\u98f2\u3081\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9d1\uc5d0\uc11c \ubaa8\ub4e0 \uc54c\ucf54\uc62c \uc7ac\uace0\ub97c \ube44\uc6b0\uc138\uc694 \u2013 \uc5c6\ub294 \uac83\uc740 \ub9c8\uc2e4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak alle alcoholvoorraden thuis leeg \u2013 wat er niet is, wordt niet gedronken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opr\u00f3\u017cnij wszystkie zapasy alkoholu w domu \u2013 czego nie ma, nie zostanie wypite."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esvazie todos os estoques de \u00e1lcool em casa \u2013 o que n\u00e3o est\u00e1 l\u00e1 n\u00e3o ser\u00e1 bebido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u043b\u0435\u0439\u0442\u0435 \u0438\u0437 \u0434\u043e\u043c\u0430 \u0432\u0441\u0435 \u0437\u0430\u043f\u0430\u0441\u044b \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f \u2013 \u0435\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0433\u043e \u043d\u0435\u0442, \u043d\u0435 \u043f\u0435\u0439\u0442\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evdeki t\u00fcm alkol stoklar\u0131n\u0131 bo\u015falt \u2013 olmayan i\u00e7ilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e05\u7a7a\u5bb6\u91cc\u6240\u6709\u7684\u9152\u7cbe\u7528\u54c1\u2014\u2014\u5982\u679c\u6ca1\u6709\uff0c\u5c31\u4e0d\u8981\u559d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e05\u7a7a\u5bb6\u88e1\u6240\u6709\u7684\u9152\u7cbe\u7528\u54c1\u2014\u2014\u5982\u679c\u6c92\u6709\uff0c\u5c31\u4e0d\u8981\u559d\u3002"
          }
        }
      }
    },
    "trash.alkohol_flatrate.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol senkt kurzfristig Stress, erh\u00f6ht ihn langfristig massiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol reduces stress short-term but massively increases it long-term."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alcohol reduce el estr\u00e9s a corto plazo pero lo aumenta enormemente a largo plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alcool r\u00e9duit le stress \u00e0 court terme mais l'augmente massivement \u00e0 long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0930\u093e\u092c \u0905\u0932\u094d\u092a\u0915\u093e\u0932 \u092e\u0947\u0902 \u0924\u0928\u093e\u0935 \u0915\u094b \u0915\u092e \u0915\u0930\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932 \u092e\u0947\u0902 \u0907\u0938\u0947 \u092d\u093e\u0930\u0940 \u0930\u0942\u092a \u0938\u0947 \u092c\u0922\u093c\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alcol riduce lo stress a breve termine ma lo aumenta massicciamente a lungo termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30eb\u30b3\u30fc\u30eb\u306f\u77ed\u671f\u7684\u306b\u30b9\u30c8\u30ec\u30b9\u3092\u4e0b\u3052\u307e\u3059\u304c\u3001\u9577\u671f\u7684\u306b\u306f\u5927\u5e45\u306b\u5897\u52a0\u3055\u305b\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc54c\ucf54\uc62c\uc740 \ub2e8\uae30\uc801\uc73c\ub85c \uc2a4\ud2b8\ub808\uc2a4\ub97c \uc904\uc774\uc9c0\ub9cc \uc7a5\uae30\uc801\uc73c\ub85c\ub294 \ud06c\uac8c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol verlaagt stress op korte termijn maar verhoogt het op lange termijn enorm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkohol kr\u00f3tkoterminowo obni\u017ca stres, ale d\u0142ugoterminowo mocno go zwi\u0119ksza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00e1lcool reduz o estresse a curto prazo, mas o aumenta massivamente a longo prazo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043b\u043a\u043e\u0433\u043e\u043b\u044c \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u0441\u0442\u0440\u0435\u0441\u0441 \u0432 \u043a\u0440\u0430\u0442\u043a\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435, \u043d\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043e \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkol k\u0131sa vadede stresi azalt\u0131r ama uzun vadede b\u00fcy\u00fck \u00f6l\u00e7\u00fcde art\u0131r\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9152\u7cbe\u53ef\u4ee5\u5728\u77ed\u671f\u5185\u51cf\u8f7b\u538b\u529b\uff0c\u4f46\u4ece\u957f\u8fdc\u6765\u770b\u4f1a\u5927\u5927\u589e\u52a0\u538b\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9152\u7cbe\u53ef\u4ee5\u5728\u77ed\u671f\u5167\u6e1b\u8f15\u58d3\u529b\uff0c\u4f46\u9577\u671f\u4f86\u770b\u6703\u5927\u5927\u589e\u52a0\u58d3\u529b\u3002"
          }
        }
      }
    },
    "trash.alkohol_flatrate.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere 'Dry Days': Plane feste alkoholfreie Tage pro Woche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try 'Dry Days': plan fixed alcohol-free days per week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba los 'Dry Days': planifica d\u00edas fijos sin alcohol a la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie les 'Dry Days' : planifie des jours sans alcool fixes par semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u2018\u0921\u094d\u0930\u093e\u0908 \u0921\u0947\u091c\u093c\u2019 \u0906\u091c\u093c\u092e\u093e\u090f\u0901: \u0938\u092a\u094d\u0924\u093e\u0939 \u092e\u0947\u0902 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u092c\u093f\u0928\u093e \u0936\u0930\u093e\u092c \u0935\u093e\u0932\u0947 \u0926\u093f\u0928 \u0924\u092f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova i 'Dry Days': pianifica giorni fissi senza alcol a settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u30c9\u30e9\u30a4\u30c7\u30fc\u300d\u3092\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u9031\u306b\u56fa\u5b9a\u3057\u305f\u30a2\u30eb\u30b3\u30fc\u30eb\u306a\u3057\u306e\u65e5\u3092\u8a08\u753b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uac74\uc870\ud55c \ub0a0'\uc744 \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694: \uc8fc\ub2f9 \uace0\uc815\ub41c \uae08\uc8fc\uc77c\uc744 \uacc4\ud68d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer 'Dry Days': plan vaste alcoholvrije dagen per week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spr\u00f3buj 'Dry Days': zaplanuj sta\u0142e bezalkoholowe dni w tygodniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente 'Dry Days': planeje dias sem \u00e1lcool fixos por semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u00ab\u0441\u0443\u0445\u0438\u0435 \u0434\u043d\u0438\u00bb: \u043a\u0430\u0436\u0434\u0443\u044e \u043d\u0435\u0434\u0435\u043b\u044e \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u043d\u0438 \u0431\u0435\u0437 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Kuru G\u00fcnler' dene: haftada belirli alkol i\u00e7ilmeyecek g\u00fcnler planla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1d\u8bd5\u201c\u7981\u9152\u65e5\u201d\uff1a\u6bcf\u5468\u8ba1\u5212\u4e13\u95e8\u7684\u7981\u9152\u65e5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a66\u8a66\u300c\u7981\u9152\u65e5\u300d\uff1a\u6bcf\u9031\u898f\u5283\u5c08\u9580\u7684\u7981\u9152\u65e5\u3002"
          }
        }
      }
    },
    "trash.alkohol_flatrate.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechne die Kosten und Kalorien deines Alkohol-Konsums \u2013 pro Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate the costs and calories of your alcohol consumption \u2013 per month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula los costes y calor\u00edas de tu consumo de alcohol al mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule les co\u00fbts et calories de ta consommation d'alcool \u2013 par mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0936\u0930\u093e\u092c \u0915\u0947 \u0938\u0947\u0935\u0928 \u0915\u0940 \u0932\u093e\u0917\u0924 \u0914\u0930 \u0915\u0948\u0932\u094b\u0930\u0940 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0930\u0947\u0902 \u2013 \u092a\u094d\u0930\u0924\u093f \u092e\u093e\u0939\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola i costi e le calorie del tuo consumo di alcol \u2013 al mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30eb\u30b3\u30fc\u30eb\u6d88\u8cbb\u306e\u30b3\u30b9\u30c8\u3068\u30ab\u30ed\u30ea\u30fc\u3092\u6708\u3054\u3068\u306b\u8a08\u7b97\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc54c\ucf54\uc62c \uc18c\ube44\uc758 \uc6d4\ubcc4 \ube44\uc6a9\uacfc \uce7c\ub85c\ub9ac\ub97c \uacc4\uc0b0\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken de kosten en calorie\u00ebn van je alcoholconsumptie \u2013 per maand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblicz koszty i kalorie swojego spo\u017cycia alkoholu \u2013 miesi\u0119cznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule os custos e calorias do seu consumo de \u00e1lcool \u2013 por m\u00eas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0437\u0430\u0442\u0440\u0430\u0442\u044b \u0438 \u043a\u0430\u043b\u043e\u0440\u0438\u0439\u043d\u043e\u0441\u0442\u044c \u0432\u0430\u0448\u0435\u0433\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044f - \u0432 \u043c\u0435\u0441\u044f\u0446."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkol t\u00fcketiminin ayl\u0131k maliyetini ve kalorisini hesapla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba1\u7b97\u60a8\u6bcf\u6708\u996e\u9152\u7684\u6210\u672c\u548c\u5361\u8def\u91cc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a08\u7b97\u60a8\u6bcf\u6708\u98f2\u9152\u7684\u6210\u672c\u548c\u5361\u8def\u91cc\u3002"
          }
        }
      }
    },
    "trash.alkohol_flatrate.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Alkohol trinken)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Tee trinken)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Alkohol trinken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Tee trinken)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Alkohol trinken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Tee trinken)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Alkohol trinken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Tee trinken)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u092c\u0941\u0930\u0940 \u0906\u0926\u0924 \u091b\u094b\u0921\u093c\u0928\u093e (\u0936\u0930\u093e\u092c \u092a\u0940\u0928\u093e)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0928\u091c\u093c\u0930 \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u094b \u0938\u092e\u091d\u0947\u0902\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947, \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u090f\u0901, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0947\u0902)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0915\u094d\u0930\u093f\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u091a\u093e\u092f \u092a\u0940\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u092a\u0938\u0902\u0926 \u0939\u094b\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0932\u0947 \u0906\u090f\u0901 (\u091c\u0948\u0938\u0947, \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0938\u094d\u0935\u092f\u0902 \u0915\u094b \u092a\u0941\u0930\u0938\u094d\u0915\u0943\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Alkohol trinken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Tee trinken)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Alkohol trinken)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Tee trinken)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {

            "value": "咖啡因截止量"
          }
        }
      }
    },
    "prog_sleep_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte 60 Minuten vor dem Schlafen alle Deckenlichter aus (nutze warme Tischlampen) und aktiviere Night-Shift an Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minutes before bed, turn off all overhead lights (use warm table lamps) and activate night shift on devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minutos antes de acostarse, apague todas las luces del techo (use lámparas de mesa cálidas) y active el turno de noche en los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minutes avant de vous coucher, éteignez tous les plafonniers (utilisez des lampes de table chaudes) et activez le quart de nuit sur les appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से 60 मिनट पहले, सभी ओवरहेड लाइटें बंद कर दें (गर्म टेबल लैंप का उपयोग करें) और उपकरणों पर रात्रि शिफ्ट सक्रिय करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minuti prima di andare a letto, spegni tutte le luci a soffitto (usa lampade da tavolo calde) e attiva il turno notturno sui dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝の 60 分前に、頭上の照明をすべて消し (暖かい卓上ランプを使用してください)、デバイスのナイトシフトを有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자리에 들기 60분 전에 머리 위의 조명을 모두 끄고(따뜻한 테이블 램프 사용) 기기의 야간 근무를 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel 60 minuten voor het slapengaan alle bovenlichten uit (gebruik warme tafellampen) en activeer de nachtploeg op apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minut przed snem wyłącz wszystkie górne światła (użyj ciepłych lamp stołowych) i włącz na urządzeniach nocną zmianę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minutos antes de dormir, desligue todas as luzes do teto (use luminárias de mesa quentes) e ative o turno noturno nos dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "60 minutos antes de dormir, desligue todas as luzes do teto (use luminárias de mesa quentes) e ative o turno noturno nos dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За 60 минут до сна выключите весь верхний свет (используйте теплые настольные лампы) и включите на устройствах ночную смену."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan 60 dakika önce tüm tavan ışıklarını kapatın (sıcak masa lambaları kullanın) ve cihazlarda gece vardiyasını etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 60 分钟，关闭所有头顶灯（使用暖色台灯）并启动设备上的夜班。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 60 分鐘，關閉所有頭頂燈（使用暖色檯燈）並啟動設備上的夜班。"
          }
        }
      }
    },

      }
    },
    "assessment.fitness.profile.maschine.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoriere leichte Schmerzen im Gelenk nicht mehr – ersetze die Übung am selben Tag durch eine schonendere Variante."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop ignoring slight pain in the joint - replace the exercise with a gentler version on the same day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deje de ignorar el dolor leve en la articulación; reemplace el ejercicio con una versión más suave el mismo día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez d'ignorer les légères douleurs articulaires - remplacez l'exercice par une version plus douce le même jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोड़ों में हल्के दर्द को नजरअंदाज करना बंद करें - व्यायाम को उसी दिन हल्के व्यायाम से बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetti di ignorare il leggero dolore all'articolazione: sostituisci l'esercizio con una versione più delicata lo stesso giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関節のわずかな痛みを無視するのをやめて、その日のうちにエクササイズをより穏やかなバージョンに置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관절의 약간의 통증을 무시하지 마십시오. 같은 날 더 부드러운 운동으로 운동을 대체하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop met het negeren van lichte pijn in het gewricht - vervang de oefening dezelfde dag door een zachtere versie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań ignorować lekki ból stawu – zamień ćwiczenie na łagodniejszą wersję tego samego dnia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare de ignorar uma leve dor nas articulações - substitua o exercício por uma versão mais suave no mesmo dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше не игнорируйте лёгкую боль в суставе – замените упражнение в тот же день на более щадящий вариант."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklemdeki hafif ağrıyı görmezden gelmeyi bırakın - aynı gün egzersizi daha hafif bir versiyonla değiştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要再忽视关节的轻微疼痛——当天用一种更温和的方式替代该练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要忽視關節的輕微疼痛－在當天以較溫和的方式代替練習。"
          }
        }
      }
    },
    "assessment.fitness.profile.maschine.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integriere exakt 3 Minuten spezifisches Dehnen für deine schwächste Muskelgruppe nach dem Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incorporate exactly 3 minutes of specific stretching for your weakest muscle group after your workout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incorpora exactamente 3 minutos de estiramientos específicos para tu grupo muscular más débil después de tu entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incorporez exactement 3 minutes d’étirements spécifiques à votre groupe musculaire le plus faible après votre entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने वर्कआउट के बाद अपने सबसे कमजोर मांसपेशी समूह के लिए ठीक 3 मिनट की विशिष्ट स्ट्रेचिंग शामिल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incorpora esattamente 3 minuti di stretching specifico per il gruppo muscolare più debole dopo l'allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト後には、最も弱い筋肉群に特化したストレッチを 3 分間だけ取り入れてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 후 가장 약한 근육 그룹을 위한 특정 스트레칭을 정확히 3분 동안 포함하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat u na uw training precies 3 minuten specifiek rekt voor uw zwakste spiergroep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po treningu wykonaj dokładnie 3 minuty specjalnego rozciągania najsłabszej grupy mięśni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incorpore exatamente 3 minutos de alongamento específico para o grupo muscular mais fraco após o treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интегрируй точно 3 минуты специфической растяжки для твоей самой слабой группы мышц после тренировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenmanınızdan sonra en zayıf kas grubunuz için tam olarak 3 dakikalık özel esneme hareketleri yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在训练后，为你最弱的肌肉群精确地进行3分钟的特定拉伸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動後，針對最弱的肌肉群進行 3 分鐘的特定伸展。"
          }
        }
      }
    },
    "assessment.fitness.profile.maschine.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extreme Härte und Disziplin. Deine 1％ Verbesserung liegt im Verhindern von Verletzungs-Ausfällen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extreme hardship and discipline. Your 1％ improvement is in preventing injury absences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dificultad extrema y disciplina. Su mejora del 1％ es en la prevención de ausencias por lesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difficultés et discipline extrêmes. Votre amélioration de 1 ％ consiste à prévenir les absences pour cause de blessure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अत्यधिक कठिनाई और अनुशासन. आपका 1％ सुधार चोट की अनुपस्थिति को रोकने में है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrema difficoltà e disciplina. Il tuo miglioramento dell'1％ riguarda la prevenzione delle assenze per infortunio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極度の苦難と規律。 1％ の改善は怪我による欠勤の防止にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "극도의 고난과 규율. 1％의 개선은 부상 결근을 예방하는 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extreme ontberingen en discipline. Uw verbetering van 1％ ligt in het voorkomen van verzuim door blessures."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstremalne trudności i dyscyplina. Twój 1％ poprawy polega na zapobieganiu absencji spowodowanej kontuzjami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrema dificuldade e disciplina. Sua melhoria de 1％ está na prevenção de ausências por lesão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экстремальная строгость и дисциплина. Твоё улучшение на 1％ заключается в предотвращении травм."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşırı zorluk ve disiplin. ％1'lik ilerlemeniz sakatlıkların önlenmesindedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "极端的严格和纪律。你那1％的提升在于防止伤病缺勤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極度的艱苦和紀律。你的 1％ 進步是為了防止因傷缺席。"
          }
        }
      }
    },

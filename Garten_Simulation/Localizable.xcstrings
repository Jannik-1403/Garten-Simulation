    "tour_daily_ring_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ring zeigt deinen heutigen Fortschritt. Klicke darauf, um detaillierte Statistiken \u00fcber deine Leistung zu sehen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ring shows your daily progress. Click on it to see detailed statistics about your performance!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anillo muestra tu progreso diario. \u00a1Haz clic en \u00e9l para ver estad\u00edsticas detalladas sobre tu rendimiento!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet anneau montre votre progr\u00e8s quotidien. Cliquez dessus pour voir des statistiques d\u00e9taill\u00e9es sur vos performances !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0905\u0902\u0917\u0942\u0920\u0940 \u0906\u092a\u0915\u0947 \u0906\u091c \u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u094b \u0926\u093f\u0916\u093e\u0924\u0940 \u0939\u0948\u0964 \u0905\u092a\u0928\u0940 \u0909\u092a\u0932\u092c\u094d\u0927\u093f\u092f\u094b\u0902 \u0915\u0947 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0906\u0902\u0915\u0921\u093c\u0947 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo anello mostra il tuo progresso giornaliero. Cliccaci sopra per vedere statistiche dettagliate sulle tue prestazioni!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ea\u30f3\u30b0\u306f\u3042\u306a\u305f\u306e\u6bce\u65e5\u306e\u9032\u6357\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u30af\u30ea\u30c3\u30af\u3057\u3066\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u95a2\u3059\u308b\u8a73\u7d30\u306a\u7d71\u8a08\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ub9c1\uc740 \uc77c\uc77c \uc9c4\ud589 \uc0c1\ud669\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \ud074\ub9ad\ud558\uc5ec \uc131\uacfc\uc5d0 \ub300\ud55c \uc790\uc138\ud55c \ud1b5\uacc4\ub97c \ud655\uc778\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze ring toont je dagelijkse voortgang. Klik erop om gedetailleerde statistieken over je prestaties te zien!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten pier\u015bcie\u0144 pokazuje tw\u00f3j codzienny post\u0119p. Kliknij go, aby zobaczy\u0107 szczeg\u00f3\u0142owe statystyki o swoich wynikach!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este anel mostra seu progresso di\u00e1rio. Clique nele para ver estat\u00edsticas detalhadas sobre o seu desempenho!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u043a\u043e\u043b\u044c\u0446\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0432\u0430\u0448 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043d\u0435\u0435, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u043e \u0432\u0430\u0448\u0438\u0445 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f\u0445!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu halka g\u00fcnl\u00fck ilerlemenizi g\u00f6sterir. Performans\u0131n\u0131z hakk\u0131nda ayr\u0131nt\u0131l\u0131 istatistikleri g\u00f6rmek i\u00e7in \u00fczerine t\u0131klay\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u679a\u6212\u6307\u663e\u793a\u4e86\u60a8\u4eca\u5929\u7684\u8fdb\u6b65\u3002\u5355\u51fb\u5b83\u5373\u53ef\u67e5\u770b\u6709\u5173\u60a8\u8868\u73b0\u7684\u8be6\u7ec6\u7edf\u8ba1\u6570\u636e\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u679a\u6212\u6307\u986f\u793a\u4e86\u60a8\u4eca\u5929\u7684\u9032\u6b65\u3002\u9ede\u64ca\u5b83\u5373\u53ef\u67e5\u770b\u6709\u95dc\u60a8\u8868\u73fe\u7684\u8a73\u7d30\u7d71\u8a08\u6578\u64da\uff01"
          }
        }
      }
    },

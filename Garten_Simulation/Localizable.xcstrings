    "trash.zigaretten_automat.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befreie deine Lungen und wähle ein gesundes, rauchfreies Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free your lungs and choose a healthy, smoke-free life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera tus pulmones y elige una vida sana y sin humo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère tes poumons et choisis une vie saine et sans fumée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera i tuoi polmoni e scegli una vita sana e senza fumo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肺を解放し、健康で煙のない生活を選びましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폐를 해방시키고 건강하고 담배 없는 삶을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevrijd je longen en kies voor een gezond, rookvrij leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwolnij swoje płuca i wybierz zdrowe życie wolne od dymu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte seus pulmões e escolha uma vida saudável e sem fumo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akciğerlerinizi özgürleştirin ve sağlıklı, dumansız bir hayat seçin."
          }
        }
      }
    },
    "trash.zigaretten_automat.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Rauchen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {

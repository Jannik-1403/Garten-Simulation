          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przyszłym tygodniu zorganizuj więcej sesji skupiających się i sprawdź nawyki, aby uzyskać dokładne wskazówki dotyczące swojego rytmu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na próxima semana, reúna mais sessões de foco e marque hábitos para obter dicas precisas sobre o seu ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na próxima semana, reúna mais sessões de foco e marque hábitos para obter dicas precisas sobre o seu ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На следующей неделе проведите больше фокус-сессий и отметьте привычки, чтобы получить точные советы по поводу своего ритма."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek hafta daha fazla odaklanma seansı toplayın ve ritminiz hakkında kesin ipuçları almak için alışkanlıklarınızı kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下周，收集更多的焦点课程并检查习惯，以获得有关节奏的精确提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下週，收集更多的焦點課程並檢查習慣，以獲得有關節奏的精確提示。"
          }
        }
      }
    },
    "smart.weekly.tip.gaps": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast am %@ pausiert, bist aber sonst konstant. Um solche Aussetzer zu vermeiden, koppele deine Gewohnheiten an feste Anker in deinem Alltag (z.B. immer direkt nach dem Zähneputzen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You paused on %@, but are otherwise consistent. To avoid such dropouts, link your habits to fixed anchors in your everyday life (e.g., always right after brushing your teeth)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiciste una pausa en %@, pero por lo demás eres consistente. Para evitar tales fracasos, vincule sus hábitos a anclajes sólidos en su vida diaria (por ejemplo, siempre inmediatamente después de cepillarse los dientes)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez fait une pause sur %@, mais vous êtes par ailleurs cohérent. Pour éviter de tels échecs, associez vos habitudes à des ancrages solides dans votre quotidien (par exemple toujours immédiatement après vous être brossé les dents)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ पर रुके हैं, लेकिन अन्यथा सुसंगत हैं। ऐसी विफलताओं से बचने के लिए, अपनी आदतों को अपने रोजमर्रा के जीवन में ठोस जुड़ाव से जोड़ें (उदाहरण के लिए हमेशा अपने दाँत ब्रश करने के तुरंत बाद)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai fatto una pausa su %@, ma per il resto sei coerente. Per evitare tali fallimenti, collega le tue abitudini a solidi ancoraggi nella vita di tutti i giorni (ad esempio sempre subito dopo aver lavato i denti)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で一時停止しましたが、それ以外は一貫しています。このような失敗を避けるために、あなたの習慣を日常生活の中でしっかりと定着させてください（例：歯を磨いた直後は常に）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 일시중지하셨지만 그 외에는 일관성이 있습니다. 그러한 실패를 피하려면 습관을 일상 생활의 견고한 닻과 연결하십시오(예: 항상 이를 닦은 후 즉시)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent gepauzeerd op %@, maar bent verder consistent. Om dergelijke mislukkingen te voorkomen, koppelt u uw gewoonten aan stevige ankers in uw dagelijks leven (bijvoorbeeld altijd onmiddellijk na het tandenpoetsen)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrobiłeś pauzę w %@, ale poza tym jesteś konsekwentny. Aby uniknąć takich niepowodzeń, połącz swoje nawyki z solidnymi kotwicami w życiu codziennym (np. zawsze bezpośrednio po umyciu zębów)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pausou em %@, mas está consistente. Para evitar tais falhas, vincule seus hábitos a âncoras sólidas em sua vida cotidiana (por exemplo, sempre imediatamente após escovar os dentes)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pausou em %@, mas está consistente. Para evitar tais falhas, vincule seus hábitos a âncoras sólidas em sua vida cotidiana (por exemplo, sempre imediatamente após escovar os dentes)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сделали паузу на %@, но в остальном последовательны. Чтобы избежать подобных неудач, свяжите свои привычки с прочными якорями в повседневной жизни (например, всегда сразу после чистки зубов)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde duraklattınız ancak bunun dışında tutarlısınız. Bu tür başarısızlıklardan kaçınmak için alışkanlıklarınızı günlük yaşamınızdaki sağlam temellere bağlayın (örneğin her zaman dişlerinizi fırçaladıktan hemen sonra)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您在 %@ 处暂停，但在其他方面保持一致。为了避免此类失败，请将您的习惯与日常生活中的牢固锚点联系起来（例如，始终在刷牙后立即进行）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您在 %@ 處暫停，但在其他方面保持一致。為了避免此類失敗，請將您的習慣與日常生活中的牢固錨點聯繫起來（例如，始終在刷牙後立即進行）。"
          }
        }
      }
    },
    "smart.weekly.tip.late_habits": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erledigst viele Gewohnheiten erst spät am Abend. Versuche, deine wichtigste Gewohnheit direkt morgens als Erstes abzuhaken (Eat the Frog) – dann hast du den Rest des Tages den Kopf frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You complete many habits late in the evening. Try checking off your most important habit first thing in the morning (Eat the Frog) - then your mind is clear for the rest of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No practicas muchos hábitos hasta altas horas de la noche. Intenta marcar tu hábito más importante a primera hora de la mañana (Comer la rana); así tendrás la cabeza despejada durante el resto del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne prenez pas beaucoup d'habitudes jusque tard dans la soirée. Essayez de cocher votre habitude la plus importante dès le matin (Manger la grenouille) - vous aurez alors l'esprit clair pour le reste de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देर शाम तक आप कई आदतें नहीं अपनाते। सुबह सबसे पहले अपनी सबसे महत्वपूर्ण आदत (मेंढक खाओ) पर लगाम लगाने की कोशिश करें - फिर बाकी दिन के लिए आपका दिमाग साफ रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non fai molte abitudini fino a tarda sera. Prova a spuntare la tua abitudine più importante al mattino (Mangia la rana), così avrai le idee chiare per il resto della giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜遅くまで習慣をあまりやらない。朝一番に最も重要な習慣 (カエルを食べる) をチェックしてください。そうすれば、残りの日は頭がすっきりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁 늦게까지 많은 습관을 들이지 않습니다. 아침에 가장 중요한 습관인 개구리 먹기를 먼저 확인해보세요. 그러면 남은 하루 동안 머리가 맑아질 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel gewoontes voer je pas laat in de avond uit. Probeer 's ochtends als eerste je belangrijkste gewoonte af te vinken (Eat the Frog), dan heb je de rest van de dag een helder hoofd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele nawyków wykonuje się dopiero późnym wieczorem. Spróbuj od razu rano skreślić swój najważniejszy nawyk (Zjedz Żabę) – wtedy będziesz mieć czystą głowę na resztę dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pratica muitos hábitos até tarde da noite. Tente verificar seu hábito mais importante logo pela manhã (Comer o Sapo) - então você terá a cabeça limpa pelo resto do dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pratica muitos hábitos até tarde da noite. Tente verificar seu hábito mais importante logo pela manhã (Comer o Sapo) - então você terá a cabeça limpa pelo resto do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не выполняете многие привычки до позднего вечера. Постарайтесь утром первым делом отметить свою самую важную привычку («Съесть лягушку») — тогда у вас будет ясная голова до конца дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam geç saatlere kadar pek çok alışkanlığınızı yapmıyorsunuz. Sabah ilk iş olarak en önemli alışkanlığınızı ortadan kaldırmaya çalışın (Kurbağa Ye) - o zaman günün geri kalanında kafanız rahat olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直到深夜你才会养成很多习惯。早上第一件事就是尝试检查一下你最重要的习惯（吃青蛙）——然后你就会在一天的剩余时间里保持清醒的头脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直到深夜你才會養成很多習慣。早上第一件事就是試著檢查你最重要的習慣（吃青蛙）——然後你就會在一天剩餘的時間裡保持清醒的頭腦。"
          }
        }
      }
    },
    "smart.weekly.tip.no_focus": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Woche keine Fokus-Sessions genutzt. Baue feste Fokus-Zeiten in deinen Alltag ein. Reserviere dir jeden Tag zur selben Uhrzeit (z.B. direkt nach dem Frühstück) 25 Minuten, um eine Routine zu entwickeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't used any focus sessions this week. Build fixed focus times into your daily life. Reserve 25 minutes at the same time every day (e.g. right after breakfast) to develop a routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has utilizado ninguna sesión de concentración esta semana. Integra tiempos fijos de concentración en tu rutina. Reserva 25 minutos a la misma hora todos los días (p.ej. justo después del desayuno) para desarrollar una rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez utilisé aucune session de concentration cette semaine. Intégrez des temps de concentration fixes dans votre vie quotidienne. Réservez 25 minutes à la même heure chaque jour (ex. juste après le petit-déjeuner) pour créer une routine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस सप्ताह किसी भी फ़ोकस सत्र का उपयोग नहीं किया है। अपने दैनिक जीवन में निश्चित फ़ोकस समय बनाएँ। एक दिनचर्या विकसित करने के लिए हर दिन एक ही समय पर (उदा. नाश्ते के ठीक बाद) 25 मिनट आरक्षित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai utilizzato alcuna sessione di focus questa settimana. Inserisci momenti di focus fissi nella tua giornata. Riserva 25 minuti alla stessa ora ogni giorno (es. subito dopo colazione) per sviluppare una routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週はフォーカスセッションを使用していません。日常生活に固定のフォーカス時間を組み込みましょう。ルーティンを作るために、毎日同じ時間（例：朝食直後）に25分間確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 포커스 세션을 사용하지 않았습니다. 일상생활에 고정된 집중 시간을 만드세요. 루틴을 개발하기 위해 매일 같은 시간(예: 아침 식사 직후)에 25분을 예약하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze week geen focussessies gebruikt. Bouw vaste focustijden in je dagelijks leven in. Reserveer elke dag 25 minuten op hetzelfde tijdstip (bijv. direct na het ontbijt) om een routine te ontwikkelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym tygodniu nie korzystałeś z żadnych sesji skupienia. Wbuduj stałe czasy skupienia w swoje codzienne życie. Zarezerwuj 25 minut o tej samej porze każdego dnia (np. tuż po śniadaniu), aby wypracować rutynę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não usou nenhuma sessão de foco esta semana. Integre tempos de foco fixos na sua vida diária. Reserve 25 minutos no mesmo horário todos os dias (ex. logo após o café da manhã) para desenvolver uma rotina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não usou nenhuma sessão de foco esta semana. Integre tempos de foco fixos na sua vida diária. Reserve 25 minutos no mesmo horário todos os dias (ex. logo após o café da manhã) para desenvolver uma rotina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой неделе вы не использовали ни одного сеанса фокуса. Внедрите фиксированное время для фокуса в свою повседневную жизнь. Резервируйте 25 минут в одно и то же время каждый день (например, сразу после завтрака), чтобы выработать рутину."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta hiç odaklanma oturumu kullanmadınız. Günlük hayatınıza sabit odaklanma süreleri ekleyin. Bir rutin oluşturmak için her gün aynı saatte (örneğin kahvaltıdan hemen sonra) 25 dakika ayırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周您还没有使用过专注周期。将固定的专注时间融入您的日常生活中。每天在同一时间（例如早餐后）预留25分钟来养成习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本周您還沒有使用過專注週期。將固定的專注時間融入您的日常生活中。每天在同一時間（例如早餐後）預留25分鐘來養成習慣。"
          }
        }
      }
    },
    "smart.weekly.tip.weekend_drop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Wochenende bricht deine Fokuszeit komplett ein. Versuche, auch an diesen Tagen zumindest eine kleine 15-Minuten-Session einzulegen, um den Rhythmus nicht zu verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your focus time completely collapses on the weekend. Try to fit in at least a small 15-minute session on these days so you don't lose your rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fin de semana, tu tiempo de concentración colapsa por completo. Intenta realizar al menos una sesión corta de 15 minutos estos días para no perder el ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le week-end, votre temps de concentration s'effondre complètement. Essayez de faire au moins une petite séance de 15 minutes ces jours-là pour ne pas perdre le rythme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताहांत में आपका फोकस समय पूरी तरह से ख़त्म हो जाता है। इन दिनों कम से कम 15 मिनट का छोटा सत्र रखने का प्रयास करें ताकि लय न खोएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel fine settimana, il tuo tempo di concentrazione crolla completamente. Cerca di fare almeno una breve sessione di 15 minuti in questi giorni per non perdere il ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末になると、集中できる時間が完全になくなってしまいます。リズムを崩さないように、このような日は少なくとも15分の短いセッションを行うようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말에는 집중력이 완전히 무너집니다. 요즘에는 리듬을 잃지 않도록 최소한 15분 정도 짧은 세션을 갖도록 노력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het weekend stort je focustijd volledig in. Probeer op deze dagen minimaal een korte sessie van 15 minuten te houden, om het ritme niet te verliezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W weekend czas skupienia całkowicie się załamuje. Staraj się mieć w te dni chociaż krótką, 15-minutową sesję, żeby nie stracić rytmu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim de semana, seu tempo de concentração entra em colapso completamente. Procure fazer pelo menos uma sessão curta de 15 minutos nesses dias para não perder o ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim de semana, seu tempo de concentração entra em colapso completamente. Procure fazer pelo menos uma sessão curta de 15 minutos nesses dias para não perder o ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выходные время вашего внимания полностью теряется. Постарайтесь в эти дни проводить хотя бы короткие 15-минутные занятия, чтобы не потерять ритм."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonu odaklanma süreniz tamamen çöker. Ritmi kaybetmemek için bu günlerde en az 15 dakikalık kısa bir seans yapmaya çalışın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到了周末，你的专注时间就完全崩溃了。这些天尽量进行至少 15 分钟的简短训练，以免失去节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到了週末，你的專注時間就完全崩潰了。這些天盡量進行至少 15 分鐘的簡短訓練，以免失去節奏。"
          }
        }
      }
    },

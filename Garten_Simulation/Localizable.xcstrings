    "assessment.lifestyle.q1" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand kommt in 5 Minuten unerwartet zu dir nach Hause. Wie sieht dein Zimmer/deine Wohnung aus?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone comes to your house unexpectedly in 5 minutes. What does your room/apartment look like?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien llega inesperadamente a tu casa en 5 minutos. ¿Cómo es tu habitación/apartamento?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu'un arrive chez vous à l'improviste dans 5 minutes. A quoi ressemble votre chambre/appartement ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 मिनट में कोई आपके घर अप्रत्याशित रूप से आ जाता है. आपका कमरा/अपार्टमेंट कैसा दिखता है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno viene a casa tua inaspettatamente tra 5 minuti. Come è la tua stanza/appartamento?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5分以内に誰かが突然あなたの家にやって来ます。あなたの部屋/アパートはどんな感じですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5분 뒤에 갑자기 누군가 당신의 집에 찾아옵니다. 당신의 방/아파트는 어떤 모습인가요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen 5 minuten komt er onverwacht iemand bij je thuis. Hoe ziet jouw kamer/appartement eruit?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za 5 minut ktoś niespodziewanie przyjdzie do Twojego domu. Jak wygląda Twój pokój/mieszkanie?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém chega inesperadamente à sua casa em 5 minutos. Como é o seu quarto/apartamento?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то неожиданно приходит к тебе домой через 5 минут. Как выглядит твоя комната/твоя квартира?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 dakika içinde beklenmedik bir şekilde evinize biri geliyor. Odanız/daireniz nasıl görünüyor?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人五分钟后会意外地来你家。你的房间/公寓看起来怎么样？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 分鐘後有人意外來到你家。您的房間/公寓是什麼樣子？"
          }
        }
      }
    },
    "assessment.lifestyle.q1.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein absolutes Chaos. Ich schäme mich und lasse ihn nicht rein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An absolute mess. I'm ashamed and won't let him in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un desastre absoluto. Me da vergüenza y no lo dejaré entrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gâchis absolu. J'ai honte et je ne le laisse pas entrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकदम गड़बड़. मैं शर्मिंदा हूं और उसे अंदर नहीं आने दूंगी."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vero disastro. Mi vergogno e non lo lascio entrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まったくの混乱だ。恥ずかしくて彼を入れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "절대 엉망입니다. 부끄러워서 그를 들여보내지 않을 거예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een absolute puinhoop. Ik schaam me en laat hem niet binnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absolutny bałagan. Wstydzę się i nie wpuszczę go."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma bagunça absoluta. Tenho vergonha e não deixo ele entrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абсолютный хаос. Мне стыдно, и я не пускаю его внутрь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bir karmaşa. Utanıyorum ve onu içeri almayacağım."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一团糟。我感到羞愧，不让他进来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕對是一團糟。我很羞愧，不讓他進來。"
          }
        }
      }
    },
    "assessment.lifestyle.q1.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich werfe panisch alles in den Schrank und schiebe Sachen unters Bett."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a panic, I throw everything in the closet and shove things under the bed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presa del pánico, tiro todo en el armario y meto cosas debajo de la cama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paniqué, je jette tout dans le placard et je glisse les affaires sous le lit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घबराहट में, मैं सब कुछ कोठरी में फेंक देता हूं और चीजों को बिस्तर के नीचे रख देता हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In preda al panico, butto tutto nell'armadio e ficco le cose sotto il letto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パニックになって、すべてをクローゼットに放り込み、ベッドの下に物を押し込みました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당황한 나는 모든 것을 옷장에 던지고 침대 밑에 물건을 밀어 넣습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In paniek gooi ik alles in de kast en schuif ik spullen onder het bed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W panice wrzucam wszystko do szafy i chowam pod łóżkiem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pânico, jogo tudo no armário e enfio as coisas debaixo da cama."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я паникую и бросаю все в шкаф, а вещи задвигаю под кровать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panik içinde her şeyi dolaba atıyorum ve eşyaları yatağın altına itiyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我慌乱地把所有东西扔进衣柜，把杂物塞到床底下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驚慌失措中，我把所有東西都丟進衣櫃裡，然後把東西塞到床底下。"
          }
        }
      }
    },
    "assessment.lifestyle.q1.c" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {

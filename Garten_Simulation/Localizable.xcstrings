    "assessment.fitness.profile.ausreden_sucher.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist immer die Genetik, die Zeit, das Wetter oder der Stress. Du übernimmst keine Verantwortung für deinen Körper und lügst dich selbst an, um dein Ego zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's always genetics, time, weather or stress. You don't take responsibility for your body and lie to yourself to protect your ego."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre es la genética, el tiempo, el clima o el estrés. No te haces responsable de tu cuerpo y te mientes a ti mismo para proteger tu ego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est toujours une question de génétique, de temps, de météo ou de stress. Vous n’assumez pas la responsabilité de votre corps et vous mentez pour protéger votre ego."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È sempre la genetica, il tempo, il tempo o lo stress. Non ti assumi la responsabilità del tuo corpo e menti a te stesso per proteggere il tuo ego."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それは常に遺伝、時間、天候、ストレスです。自分の体に責任を負わず、自分のエゴを守るために自分に嘘をつきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것은 항상 유전학, 시간, 날씨 또는 스트레스입니다. 당신은 자신의 몸에 대해 책임을 지지 않고, 자아를 보호하기 위해 자신에게 거짓말을 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is altijd genetica, tijd, weer of stress. Je neemt geen verantwoordelijkheid voor je lichaam en liegt tegen jezelf om je ego te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze jest to kwestia genetyki, czasu, pogody lub stresu. Nie bierzesz odpowiedzialności za swoje ciało i okłamujesz siebie, aby chronić swoje ego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É sempre genética, tempo, clima ou estresse. Você não assume a responsabilidade pelo seu corpo e mente para si mesmo para proteger o seu ego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman genetik, zaman, hava durumu veya strestir. Bedeninizin sorumluluğunu almazsınız ve egonuzu korumak için kendinize yalan söylemezsiniz."
          }
        }
      }
    },

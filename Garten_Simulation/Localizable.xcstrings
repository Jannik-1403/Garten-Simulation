    "trash.fastfood_lieferdienst.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche frisch zu Hause anstatt immer wieder Essen zu bestellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook fresh at home instead of constantly ordering food."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina fresco en casa en lugar de pedir comida constantemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisine des repas frais à la maison au lieu de commander de la nourriture sans cesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina fresco a casa invece di ordinare cibo costantemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に食べ物を注文するのではなく、家で新鮮な料理を作りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끊임없이 음식을 주문하는 대신 집에서 신선하게 요리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook vers thuis in plaats van voortdurend eten te bestellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotuj świeże potrawy w domu, zamiast ciągle zamawiać jedzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe alimentos frescos em casa em vez de pedir comida constantemente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürekli yemek sipariş etmek yerine evde taze yemekler yapın."
          }
        }
      }
    },
    "trash.fastfood_lieferdienst.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Lieferdienst bestellen) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Lieferdienst bestellen) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."

    "trash.fast_food_abo.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigendes Gepl\u00e4tscher f\u00fcr deinen Garten. (+1 Coin)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calming water sounds for your garden. (+1 Coin)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonido relajante del agua. (+1 Moneda)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le doux son de l'eau pour ton jardin. (+1 pi\u00e8ce)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092c\u0917\u0940\u091a\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u0916\u0926 \u091c\u0932\u0927\u094d\u0935\u0928\u093f\u0964 (+1 \u0938\u093f\u0915\u094d\u0915\u093e)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calming water sounds for your garden. (+1 Coin)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u5ead\u306b\u7a4f\u3084\u304b\u306a\u6c34\u306e\u97f3\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002 (+1\u30b3\u30a4\u30f3)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc5d0 \uc794\uc794\ud55c \ubb3c\uc18c\ub9ac\uac00 \ub4e4\ub9bd\ub2c8\ub2e4. (+1 \ucf54\uc778)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalmerende watergeluiden voor uw tuin. (+1 munt)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspokajaj\u0105ce d\u017awi\u0119ki wody w Twoim ogrodzie. (+1 moneta)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Som relaxante da \u00e1gua para o teu jardim. (+1 moeda)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u043f\u043e\u043a\u0430\u0438\u0432\u0430\u044e\u0449\u0438\u0439 \u043b\u0435\u043f\u0435\u0442 \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u0430\u0434\u0430. (+1 \u043c\u043e\u043d\u0435\u0442\u0430)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7eniz i\u00e7in sakinle\u015ftirici su sesleri. (+1 Para)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u60a8\u7684\u82b1\u56ed\u5e26\u6765\u8212\u7f13\u7684\u54bf\u5440\u58f0\u3002 (+1 \u786c\u5e01)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u60a8\u7684\u82b1\u5712\u5e36\u4f86\u8212\u7de9\u7684\u54bf\u5440\u8072\u3002 (+1 \u786c\u5e63)"
          }
        }
      }
    },

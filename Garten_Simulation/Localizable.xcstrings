    "prog_screentime_d6_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade dein Handy heute Nacht nicht neben dem Bett, sondern in einem anderen Raum oder auf der anderen Seite des Zimmers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of charging your phone next to the bed tonight, charge it in another room or on the other side of the room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de cargar tu teléfono junto a la cama esta noche, cárgalo en otra habitación o al otro lado de la habitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de recharger votre téléphone à côté du lit ce soir, chargez-le dans une autre pièce ou de l'autre côté de la pièce."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज रात अपने फोन को बिस्तर के पास चार्ज करने के बजाय, इसे दूसरे कमरे में या कमरे के दूसरी तरफ चार्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di caricare il telefono accanto al letto stasera, caricalo in un'altra stanza o dall'altra parte della stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜はベッドの横で携帯電話を充電するのではなく、別の部屋か部屋の反対側で充電してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤에는 침대 옆에서 휴대폰을 충전하는 대신 다른 방이나 방 반대편에서 충전하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In plaats van vanavond je telefoon naast het bed op te laden, kun je hem in een andere kamer of aan de andere kant van de kamer opladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast ładować dziś wieczorem telefon przy łóżku, naładuj go w innym pokoju lub po drugiej stronie pokoju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de carregar o telefone ao lado da cama esta noite, carregue-o em outro quarto ou do outro lado do quarto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de carregar o telefone ao lado da cama esta noite, carregue-o em outro quarto ou do outro lado do quarto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо того чтобы сегодня вечером заряжать телефон рядом с кроватью, зарядите его в другой комнате или на другом конце комнаты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gece telefonunuzu yatağınızın yanında şarj etmek yerine başka bir odada veya odanın diğer tarafında şarj edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚不要在床边给手机充电，而是在另一个房间或房间的另一边充电。"
          }

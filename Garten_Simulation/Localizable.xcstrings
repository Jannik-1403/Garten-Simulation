          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई बात नहीं। थोड़ा गन्दा लेकिन प्रस्तुत करने योग्य।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va bene. Un po' disordinato ma presentabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大丈夫。少し乱雑ですが、見栄えはします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "괜찮아요. 조금 지저분하지만 표현 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is oké. Een beetje rommelig maar toonbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest w porządku. Trochę niechlujnie, ale reprezentacyjnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo bem. Um pouco bagunçado, mas apresentável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В порядке. Немного неаккуратно, но показательно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorun değil. Biraz dağınık ama prezentabl."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还可以。有点乱，但能见人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒關係。有点乱但还算得体。"
          }
        }
      }
    },
    "assessment.lifestyle.q1.d" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makellos. Meine Umgebung ist immer geordnet, weil Chaos meinen Geist schwächt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flawless. My surroundings are always orderly because chaos weakens my mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impecable. Mi entorno siempre está ordenado porque el caos debilita mi mente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impeccable. Mon environnement est toujours ordonné car le chaos affaiblit mon esprit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेदाग। मेरा परिवेश हमेशा व्यवस्थित रहता है क्योंकि अराजकता मेरे दिमाग को कमजोर कर देती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impeccabile. Ciò che mi circonda è sempre ordinato perché il caos indebolisce la mia mente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧。混乱は私の精神を弱めるので、私の周囲は常に整然としています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완벽합니다. 혼돈이 내 마음을 약화시키기 때문에 내 주변은 항상 질서정연합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlekkeloos. Mijn omgeving is altijd ordelijk omdat chaos mijn geest verzwakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doskonały. Moje otoczenie jest zawsze uporządkowane, ponieważ chaos osłabia mój umysł."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfeito. Meu entorno está sempre ordenado porque o caos enfraquece minha mente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безупречно. Мое окружение всегда упорядочено, потому что хаос ослабляет мой разум."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusursuz. Çevrem her zaman düzenli çünkü kaos zihnimi zayıflatıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一尘不染。我的环境总是井井有条，因为混乱会削弱我的精神。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完美無瑕。我的周圍總是秩序井然，因為混亂削弱了我的思想。"
          }
        }
      }
    },
    "assessment.lifestyle.q2" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist der Durchschnitt der 5 Menschen, mit denen du die meiste Zeit verbringst. Schau sie dir an. Wer sind sie?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the average of the 5 people you spend the most time with. Look at her. Who are they?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres el promedio de las 5 personas con las que pasas más tiempo. Mírala. ¿Quiénes son?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes la moyenne des 5 personnes avec qui vous passez le plus de temps. Regardez-la. Qui sont-ils ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप उन 5 लोगों में से औसत हैं जिनके साथ आप सबसे अधिक समय बिताते हैं। उसे देखो। कौन हैं वे?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei la media delle 5 persone con cui trascorri più tempo. Guardala. Chi sono?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは、最も多くの時間を一緒に過ごす 5 人の平均です。彼女を見てください。彼らは誰なの？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 가장 많은 시간을 함께 보내는 5명의 평균입니다. 그녀를보세요. 그들은 누구입니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij bent het gemiddelde van de 5 mensen met wie je de meeste tijd doorbrengt. Kijk naar haar. Wie zijn zij?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś średnią 5 osób, z którymi spędzasz najwięcej czasu. Spójrz na nią. Kim oni są?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é a média das 5 pessoas com quem passa mais tempo. Olhe para ela. Quem são eles?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты в среднем тот человек, с кем ты проводишь больше всего времени среди пяти людей. Посмотри на них. Кто они?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En çok vakit geçirdiğiniz 5 kişinin ortalamasısınız. Ona bak. Onlar kim?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是你花最多时间在一起的五个人的平均值。看看他们。他们是谁？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您是與您相處時間最多的 5 個人的平均值。看看她。他們是誰？"
          }
        }
      }
    },
    "assessment.lifestyle.q2.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leute ohne Ziele, die sich nur beschweren, zocken oder Party machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People without goals who just complain, gamble or party."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gente sin objetivos que sólo se queja, juega o se divierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des gens sans objectifs qui se contentent de se plaindre, de jouer ou de faire la fête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना लक्ष्य वाले लोग जो सिर्फ शिकायत करते हैं, जुआ खेलते हैं या पार्टी करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persone senza obiettivi che si limitano a lamentarsi, a giocare d'azzardo o a festeggiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標を持たず、ただ不平を言ったり、ギャンブルしたり、パーティーをしたりするだけの人。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불평만 하고, 도박을 하고, 파티만 하는 목표 없는 사람들."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen zonder doelen die alleen maar klagen, gokken of feesten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ludzie bez celów, którzy po prostu narzekają, uprawiają hazard lub imprezują."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas sem objetivos que só reclamam, jogam ou festejam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди без целей, которые только жалуются, играют в игры или устраивают вечеринки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefi olmayan, sadece şikayet eden, kumar oynayan veya parti yapan insanlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有目标的人，只会抱怨、玩游戏或参加派对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有目標的人只會抱怨、賭博或聚會。"
          }
        }
      }
    },
    "assessment.lifestyle.q2.b" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nette Leute, aber niemand von ihnen fordert mich wirklich heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nice people, but none of them really challenge me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buena gente, pero ninguno de ellos realmente me desafía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des gens sympas, mais aucun d’entre eux ne me défie vraiment."

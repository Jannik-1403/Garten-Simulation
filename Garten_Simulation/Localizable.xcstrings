    "screenTime.layer4.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Apps und Websites sind immer blockiert und können nur über die Notfall-Entsperrung geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These apps and websites are always blocked and can only be unlocked via Emergency Unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas aplicaciones y sitios web siempre están bloqueados y solo se pueden desbloquear mediante el Desbloqueo de emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces applications et sites web sont toujours bloqués et ne peuvent être débloqués que via le Déblocage d'urgence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये ऐप और वेबसाइट हमेशा ब्लॉक रहते हैं और केवल आपातकालीन अनलॉक के माध्यम से अनलॉक किए जा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste app e siti web sono sempre bloccati e possono essere sbloccati solo tramite Sblocco di emergenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリとウェブサイトは常にブロックされており、緊急ロック解除からのみ解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 앱과 웹사이트는 항상 차단되며 긴급 잠금 해제를 통해서만 잠금을 해제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze apps en websites zijn altijd geblokkeerd en kunnen alleen worden ontgrendeld via Noodontgrendeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te aplikacje i strony internetowe są zawsze zablokowane i można je odblokować tylko przez Odblokowanie awaryjne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses aplicativos e sites estão sempre bloqueados e só podem ser desbloqueados através do Desbloqueio de Emergência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses aplicativos e sites estão sempre bloqueados e só podem ser desbloqueados através do Desbloqueio de Emergência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти приложения и веб-сайты всегда заблокированы и могут быть разблокированы только с помощью экстренной разблокировки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamalar ve web siteleri her zaman engellenir ve yalnızca Acil Kilit Açma ile açılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些应用和网站始终被阻止，只能通过紧急解锁来解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些應用和網站在始終被阻止，只能透過緊急解鎖來解鎖。"
          }
        }
      }
    },

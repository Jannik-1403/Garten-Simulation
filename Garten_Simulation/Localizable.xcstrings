          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "All\u00f4 ? C'est l'heure de %@ !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u092e\u0938\u094d\u0924\u0947?%@\u0915\u093e \u0938\u092e\u092f!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao? \u00c8 l'ora di %@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u3093\u306b\u3061\u306f\uff1f %@ \u306e\u6642\u9593\u3067\u3059!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc548\ub155\ud558\uc138\uc694? %@\uc744(\ub97c) \uc704\ud55c \uc2dc\uac04\uc785\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo? Tijd voor %@!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cze\u015b\u0107? Czas na %@!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ol\u00e1? Hora de %@!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0432\u0435\u0442? \u0412\u0440\u0435\u043c\u044f \u0434\u043b\u044f%@!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba? %@ zaman\u0131!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u597d\uff1f\u662f\u65f6\u5019\u505a %@ \u4e86\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u597d\uff1f%@\u6642\u9593\u5230\u4e86\uff01"
          }
        }
      }
    },
    "notification.wait.3.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch %d Stunden Zeit, dich um deine Pflanze zu k\u00fcmmern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %d hours left to take care of your plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan tienes %d horas para cuidar de tu planta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te reste %d heures pour t'occuper de ta plante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0905\u092a\u0928\u0947 \u092a\u094c\u0927\u0947 \u0915\u0940 \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0947 \u0932\u093f\u090f \u0905\u092d\u0940 \u092d\u0940%d\u0918\u0902\u091f\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ancora %d ore per prenderti cura della tua pianta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u306e\u4e16\u8a71\u3092\u3059\u308b\u6642\u9593\u304c\u6b8b\u308a %d \u6642\u9593\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dd\ubb3c\uc744 \ub3cc\ubcfc \uc2dc\uac04\uc774 %d\uc2dc\uac04 \ub0a8\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog %d uur om voor je plant te zorgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozosta\u0142o Ci %d godzin na zaopiekowanie si\u0119 ro\u015blin\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda tens %d horas para cuidar da tua planta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0442\u0435\u0431\u044f \u0435\u0449\u0435 \u0435\u0441\u0442\u044c%d\u0447\u0430\u0441\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0437\u0430\u0431\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043e \u0441\u0432\u043e\u0435\u043c \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesisinizin bak\u0131m\u0131 i\u00e7in %d saatiniz kald\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u8fd8\u6709 %d \u5c0f\u65f6\u6765\u7167\u6599\u4f60\u7684\u690d\u7269\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u9084\u6709%d\u5c0f\u6642\u4f86\u7167\u9867\u60a8\u7684\u690d\u7269\u3002"
          }
        }
      }
    },
    "notification.wait.3.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss \"%@\" nicht!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget \"%@\"! "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1No olvides \"%@\"! "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oublie pas \"%@\" ! "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" \u092e\u0924 \u092d\u0942\u0932\u0928\u093e!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare \"%@\"!  "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss \"%@\" nicht!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"\uc744(\ub97c) \uc78a\uc9c0 \ub9c8\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet \"%@\" niet!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapomnij o \u201e%@\u201d!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o te esque\u00e7as de \"%@\"!  "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \"%@\"!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ifadesini unutmay\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5fd8\u8bb0\u201c%@\u201d\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5fd8\u8a18\u201c%@\u201d\uff01"
          }
        }
      }
    },
    "onboarding_benachrichtigung_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll ich dich an deine Gewohnheiten erinnern? So vergisst du nie zu gie\u00dfen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I remind you of your habits? That way you'll never forget to water!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQuieres que te recuerde tus h\u00e1bitos? \u00a1As\u00ed nunca olvidar\u00e1s regar!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois-je te rappeler tes habitudes ? Ainsi, tu n'oublieras jamais d'arroser !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u093e \u0906\u092a \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u0906\u092a\u0915\u0940 \u0906\u0926\u0924\u0947\u0902 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u090a\u0902? \u0907\u0938 \u0924\u0930\u0939 \u0906\u092a \u092a\u093e\u0928\u0940 \u0926\u0947\u0928\u093e \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092d\u0942\u0932\u0947\u0902\u0917\u0947!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I remind you of your habits? That way you'll never forget to water!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u7fd2\u6163\u3092\u601d\u3044\u51fa\u3055\u305b\u305f\u307b\u3046\u304c\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f\u305d\u3046\u3059\u308c\u3070\u6c34\u3084\u308a\u3092\u5fd8\u308c\u308b\u3053\u3068\u304c\u306a\u304f\u306a\u308a\u307e\u3059\u3088\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \uc2b5\uad00\uc744 \uc0c1\uae30\uc2dc\ucf1c \ub4dc\ub824\uc57c \ud560\uae4c\uc694? \uadf8\ub807\uac8c \ud558\uba74 \ubb3c \uc8fc\ub294 \uac83\uc744 \uacb0\ucf54 \uc78a\uc9c0 \uc54a\uc744 \uac83\uc785\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moet ik je aan je gewoontes herinneren? Zo vergeet je nooit meer water te geven!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam ci przypomnie\u0107 o twoich nawykach? Dzi\u0119ki temu nigdy nie zapomnisz o podlaniu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres que te lembre dos teus h\u00e1bitos? Assim nunca te esquecer\u00e1s de regar!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043d\u0435 \u043d\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u0442\u0435\u0431\u0435 \u043e \u0442\u0432\u043e\u0438\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u0445? \u0422\u0430\u043a \u0442\u044b \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044c \u043f\u043e\u043b\u0438\u0432\u0430\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana al\u0131\u015fkanl\u0131klar\u0131n\u0131 hat\u0131rlatmal\u0131 m\u0131y\u0131m? B\u00f6ylece sulamay\u0131 asla unutmayacaks\u0131n\u0131z!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8981\u6211\u63d0\u9192\u4f60\u517b\u6210\u4e60\u60ef\u5417\uff1f\u8fd9\u6837\u4f60\u5c31\u6c38\u8fdc\u4e0d\u4f1a\u5fd8\u8bb0\u6d47\u6c34\u4e86\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u60f3\u8b93\u6211\u63d0\u9192\u4f60\u4f60\u7684\u7fd2\u6163\u55ce\uff1f\u9019\u6a23\u4f60\u5c31\u6c38\u9060\u4e0d\u6703\u5fd8\u8a18\u6f86\u6c34\uff01"
          }
        }
      }
    },

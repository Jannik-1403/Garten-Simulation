    "pfad_produktiv_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deinen Rhythmus. Eine fokussierte Einheit heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your rhythm. One focused session today."
          }
        },

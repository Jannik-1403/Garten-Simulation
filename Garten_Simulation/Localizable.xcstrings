    "effekt.regen.beschreibung": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pflanzen wachsen schneller \u2014 +25\uff05 XP heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plants grow faster \u2014 +25\uff05 XP today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas crecen m\u00e1s r\u00e1pido \u2014 +25\uff05 XP hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes poussent plus vite \u2014 +25\uff05 XP aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094c\u0927\u0947 \u0924\u0947\u091c\u0940 \u0938\u0947 \u092c\u0922\u093c\u0924\u0947 \u0939\u0948\u0902 - \u0906\u091c +25\uff05 XP\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plants grow faster \u2014 +25\uff05 XP today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u306e\u6210\u9577\u304c\u901f\u304f\u306a\u308a\u307e\u3059 - \u4eca\u65e5\u306e XP \u306f +25\uff05 \u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dd\ubb3c\uc774 \ub354 \ube68\ub9ac \uc790\ub78d\ub2c8\ub2e4 \u2014 \uc624\ub298 XP +25\uff05."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planten groeien sneller: +25\uff05 XP vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ro\u015bliny rosn\u0105 szybciej \u2014 dzisiaj +25\uff05 PD."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As plantas crescem mais r\u00e1pido \u2014 +25\uff05 XP hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0440\u0430\u0441\u0442\u0443\u0442 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u2014 +25\uff05 \u043e\u043f\u044b\u0442\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiler daha h\u0131zl\u0131 b\u00fcy\u00fcyor \u2014 bug\u00fcn +%25 XP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u751f\u957f\u66f4\u5feb \u2014 \u4eca\u5929\u7ecf\u9a8c\u503c +25\uff05."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u751f\u9577\u5f97\u66f4\u5feb \u2014 \u4eca\u5929 +25\uff05 XP\u3002"
          }
        }
      }
    },

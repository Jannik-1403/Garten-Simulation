    "plant.minzpflanze.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frisch, klar, täglich – Zähneputzen & Hygiene"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh, clear, daily – Toothbrushing & Hygiene"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresca, clara, diaria – Higiene dental y personal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraîche, claire, quotidienne – Hygiène dentaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताजगी, साफ़, रोजाना – ब्रश करना और स्वच्छता"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresco, chiaro, quotidiano: lavarsi i denti e igiene"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレッシュ、クリア、毎日 - 歯磨きと衛生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신선하고 맑으며 매일 – 칫솔질 및 위생"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fris, helder, dagelijks – Tandenpoetsen & Hygiëne"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świeże, przejrzyste, codzienne – szczotkowanie zębów i higiena"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresca, clara, diária – Higiene dentária"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresca, clara, diária – Higiene dentária"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свежо, чисто, ежедневно – чистка зубов и гигиена"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taze, berrak, günlük – Diş Fırçalama ve Hijyen"
          }
        },
        "zh-Hans": {
          "stringUnit": {

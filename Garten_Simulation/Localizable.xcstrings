            "value": "常春藤"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常春藤"
          }
        }
      }
    },
    "plant.efeu.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe flexibel und beuge Verspannungen durch tägliches Dehnen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay flexible and prevent tension through daily stretching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente flexible y previene la tensión mediante estiramientos diarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez flexible et prévenez les tensions grâce à des étirements quotidiens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लचीला बने रहें और रोज़ाना स्ट्रेचिंग करके तनाव को रोकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimani flessibile e previeni le tensioni attraverso lo stretching quotidiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日のストレッチで柔軟性を保ち、緊張を防ぎましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일의 스트레칭을 통해 유연성을 유지하고 긴장을 예방하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf flexibel en voorkom spanningen door dagelijks te strekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostań elastyczny i zapobiegaj napięciom dzięki codziennemu rozciąganiu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se flexível e evite tensões através de alongamentos diários."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se flexível e evite tensões através de alongamentos diários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставайся гибким и предотвращай напряжение с помощью ежедневной растяжки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnek kalın ve günlük esneme hareketleriyle gerginliği önleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持灵活，通过每日拉伸预防紧张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天進行伸展運動，保持靈活性並防止緊張。"
          }
        }
      }
    },
    "plant.eiche.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wächst langsam, wird über Jahrzehnte massiv und weise"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows slowly, becomes massive and wise over decades"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece lento, se vuelve masivo y sabio con las décadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse lentement, devient massif et sage au fil des décennies"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे बढ़ता है, दशकों में विशाल और बुद्धिमान बनता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce lentamente, diventa massiccio e saggio nel corso dei decenni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくりと成長し、数十年かけて巨大かつ賢くなる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수십 년에 걸쳐 천천히 성장하고 거대해지고 현명해집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit langzaam, wordt in de loop van tientallen jaren enorm en wijs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rośnie powoli, przez dziesięciolecia staje się masywny i mądry"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce devagar, torna-se massivo e sábio ao longo de décadas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce devagar, torna-se massivo e sábio ao longo de décadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Растет медленно, становится массивным и мудрым на протяжении десятилетий"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaş yavaş büyür, onlarca yıl içinde devasa ve bilge hale gelir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓慢生长，数十年后变得粗壮而智慧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾十年後慢慢成長，變得龐大又聰明"
          }
        }
      }
    },

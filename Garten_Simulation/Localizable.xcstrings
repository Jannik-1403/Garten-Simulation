    "assessment.mental.q5" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand in deiner Firma, der extrem faul ist, bekommt durch reines Glück oder Networking die Beförderung, für die du monatelang geblutet hast. Deine Reaktion?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone at your company who is extremely lazy gets the promotion you've been bleeding for for months through sheer luck or networking. Your reaction?"

    "plant.aloe_vera.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heilt und regeneriert still im Hintergrund – weniger Handy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heals and regenerates silently – less phone time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cura y regenera en silencio – menos tiempo de pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guérit et régénère silencieusement – moins de téléphone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक हो जाता है और पृष्ठभूमि में चुपचाप पुनर्जीवित हो जाता है - कम सेल फोन"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cura e rigenera silenziosamente in background - meno cellulare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに修復と再生 – 電話時間を短縮"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용히 치료하고 재생합니다. 통화 시간이 줄어듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geneest en regenereert in stilte – minder telefoontijd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leczy i regeneruje po cichu – mniej czasu na telefon"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cura e regenera silenciosamente – menos telemóvel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cura e regenera silenciosamente – menos telemóvel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исцеляет и восстанавливает тихо на заднем плане — меньше телефона"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessizce iyileşir ve yenilenir; daha az telefon süresi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台默默治愈和再生 – 减少手机使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在後台默默地治癒和再生——無需手機"
          }
        }
      }
    },

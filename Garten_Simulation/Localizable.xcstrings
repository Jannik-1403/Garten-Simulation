    "trash.energy_drink_kiste.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume alle Energy Drinks aus dem Haus – was nicht da ist, wird nicht getrunken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all energy drinks from the house – what's not there won't be drunk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira todas las bebidas energéticas de casa: lo que no está no se bebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire toutes les boissons énergisantes de la maison – ce qui n'est pas là ne sera pas bu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारे एनर्जी ड्रिंक घर से हटा दो – जो नहीं है, वह पीया नहीं जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi tutte le bevande energetiche da casa – quello che non c'è non viene bevuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エナジードリンクをすべて家から取り除きましょう。なければ飲めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집에서 모든 에너지 드링크를 치우세요 – 없는 것은 마실 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim alle energiedranken op uit huis – wat er niet is, wordt niet gedronken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń wszystkie napoje energetyczne z domu – czego nie ma, nie zostanie wypite."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova todos os energéticos de casa – o que não está lá não será bebido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova todos os energéticos de casa – o que não está lá não será bebido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите из дома все энергетические напитки — если у вас их нет, не пейте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm enerji içeceklerini evden çıkar – olmayan içilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把家里所有的能量饮料拿走——如果没有，就不要喝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把家裡所有的能量飲料拿走——如果沒有，就不要喝。"
          }
        }
      }
    },
    "trash.energy_drink_kiste.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Drinks erzeugen eine Scheinenergie, die deinen Schlaf ruiniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy drinks create a false energy that ruins your sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bebidas energéticas crean una energía falsa que arruina tu sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boissons énergisantes créent une fausse énergie qui ruine ton sommeil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊर्जा पेय एक नकली ऊर्जा उत्पन्न करते हैं, जो आपकी नींद को बर्बाद कर देती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bevande energetiche creano un'energia falsa che rovina il tuo sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エナジードリンクは睡眠を台無しにする偽のエネルギーを生み出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지 드링크는 수면을 망치는 가짜 에너지를 만들어 냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiedranken creëren schijnenergie die je slaap ruïneert."

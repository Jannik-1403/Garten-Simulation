    "assessment.lifestyle.profile.gefangener.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfeld s\u00e4ubern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean the environment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpiar el medio ambiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer l'environnement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0938-\u092a\u093e\u0938 \u0915\u0940 \u0938\u092b\u093e\u0908 \u0915\u0930\u0947\u0902"
          }
        },
        "it": {

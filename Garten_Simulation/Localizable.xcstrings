    "plant.bambus_schilf.symbolism" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflektiere deine Gedanken und halte wichtige Erlebnisse fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflect on your thoughts and capture important experiences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexiona sobre tus pensamientos y captura experiencias importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réfléchissez à vos pensées et capturez des expériences importantes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने विचारों पर विचार करें और महत्वपूर्ण अनुभव रिकार्ड करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rifletti sui tuoi pensieri e cattura esperienze importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の考えを振り返り、重要な経験を記録しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각을 되돌아보고 중요한 경험을 기록하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflecteer op je gedachten en leg belangrijke ervaringen vast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastanów się nad swoimi myślami i uchwyć ważne doświadczenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflita sobre seus pensamentos e capture experiências importantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размышляй о своих мыслях и фиксируй важные события."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşüncelerinizi yansıtın ve önemli deneyimlerinizi kaydedin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反思你的思想，记录重要的经历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反思你的想法並記錄重要的經驗。"
          }
        }
      }
    },
    "plant.bambus.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wächst schnell, extrem stabil und schwer zu brechen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grows fast, extremely stable and hard to break"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece rápido, extremadamente estable y difícil de romper"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse vite, extrêmement stable et difficile à briser"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेजी से बढ़ता है, बेहद स्थिर और तोड़ना मुश्किल होता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grows fast, extremely stable and hard to break"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成長が早く、非常に安定しており、壊れにくい"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠르게 성장하고 매우 안정적이며 깨지기 어렵습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groeit snel, extreem stabiel en moeilijk te breken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rośnie szybko, niezwykle stabilnie i trudno złamać"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce rápido, extremamente estável e difícil de quebrar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растет быстро, чрезвычайно устойчивый и трудно ломается"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

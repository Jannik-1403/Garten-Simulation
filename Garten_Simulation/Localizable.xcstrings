    "tour_prompt_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du eine kurze Einführung in die wichtigsten Funktionen von Grovy erhalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like a quick tour of the main features of Grovy?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Le gustaría un recorrido rápido por las características principales de Grovy?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souhaitez-vous un tour rapide des principales fonctionnalités de Grovy ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप Grovy की मुख्य सुविधाओं का एक संक्षिप्त परिचय प्राप्त करना चाहते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desideri un rapido tour delle principali funzionalità di Grovy?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grovy の主な機能について簡単に説明してみませんか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grovy의 주요 기능을 빠르게 살펴보고 싶으신가요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilt u een korte rondleiding door de belangrijkste functies van Grovy?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz szybko zapoznać się z głównymi funkcjami Grovy?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de um tour rápido pelos principais recursos do Grovy?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите быстро познакомиться с ключевыми функциями Grovy?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grovy'nin ana özelliklerine hızlı bir tur atmak ister misiniz?"

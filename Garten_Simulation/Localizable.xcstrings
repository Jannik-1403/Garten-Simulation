    "screenTime.layer1.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Ablauf dieser Zeit werden die ausgewählten Apps für den Rest des Tages blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this time, the selected apps will be blocked for the rest of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasado este tiempo, las aplicaciones seleccionadas quedarán bloqueadas por el resto del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passé ce délai, les applications sélectionnées seront bloquées pour le reste de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय के बाद, चयनित ऐप्स को शेष दिन के लिए ब्लॉक कर दिया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascorso questo tempo, le app selezionate verranno bloccate per il resto della giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間を過ぎると、選択したアプリはその日の残りの間ブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간이 지나면 선택한 앱이 하루 종일 차단됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na deze tijd worden de geselecteerde apps voor de rest van de dag geblokkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tym czasie wybrane aplikacje zostaną zablokowane na resztę dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após esse horário, os aplicativos selecionados ficarão bloqueados pelo resto do dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após esse horário, os aplicativos selecionados ficarão bloqueados pelo resto do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По истечении этого времени выбранные приложения будут заблокированы до конца дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürenin sonunda seçilen uygulamalar günün geri kalanında engellenecektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此时间之后，选定的应用程序将在当天剩余时间内被阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此時間之後，選定的應用程式將在當天剩餘時間內被阻止。"
          }
        }
      }
    },

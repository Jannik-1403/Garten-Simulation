    "prog_saving_d7_t2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben der Woche ehrlich reflektiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issues of the week honestly reflected"
          }

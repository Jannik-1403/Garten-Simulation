            "value": "\u0411\u043e\u043b\u0438\u0442 \u043d\u0435\u043c\u043d\u043e\u0433\u043e, \u0434\u0435\u043b\u0430\u0435\u0442 \u043d\u0435\u0443\u044f\u0437\u0432\u0438\u043c\u044b\u043c \u2013 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f \u0445\u043e\u043b\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0443\u0448\u0430 \u0438 \u0442\u0440\u0435\u043d\u0430\u0436\u0435\u0440\u043d\u043e\u0433\u043e \u0437\u0430\u043b\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131sa s\u00fcreli\u011fine ac\u0131t\u0131r, k\u0131r\u0131lmaz hale getirir \u2013 So\u011fuk du\u015f + spor salonu kombinasyonu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u77ed\u6682\u75bc\u75db\uff0c\u4f46\u575a\u4e0d\u53ef\u6467 \u2013 \u51b7\u6c34\u6fa1 + \u5065\u8eab\u7ec4\u5408"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u77ed\u66ab\u75bc\u75db\uff0c\u5805\u4e0d\u53ef\u6467\uff0d\u51b7\u6c34\u6dcb\u6d74+\u5065\u8eab\u623f\u7d44\u5408"
          }
        }
      }
    },
    "plant.chrysantheme.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnung = Bl\u00fcte \u2013 Sauberkeit & Aufr\u00e4umen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order = Bloom \u2013 Cleanliness & Tidying"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden = Floraci\u00f3n \u2013 Limpieza y orden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordre = floraison \u2013 Propret\u00e9 & rangement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u0930\u092e = \u0916\u093f\u0932\u0928\u093e - \u0938\u093e\u092b\u093c-\u0938\u092b\u093c\u093e\u0908 \u0914\u0930 \u0938\u093e\u092b\u093c-\u0938\u092b\u093c\u093e\u0908"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Order = Bloom \u2013 Cleanliness & Tidying"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79e9\u5e8f = \u30d6\u30eb\u30fc\u30e0 \u2013 \u6e05\u6f54\u3055\u3068\u6574\u7406\u6574\u9813"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\ubb38 = \uaf43 \u2013 \uccad\uacb0 \ubc0f \uc815\ub9ac"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestellen = Bloom \u2013 Netheid en opruimen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porz\u0105dek = rozkwit \u2013 czysto\u015b\u0107 i porz\u0105dek"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordem = florescimento \u2013 Limpeza & arruma\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0440\u044f\u0434\u043e\u043a = \u0446\u0432\u0435\u0442\u0435\u043d\u0438\u0435 \u2013 \u0447\u0438\u0441\u0442\u043e\u0442\u0430 \u0438 \u0443\u0431\u043e\u0440\u043a\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fczen = Bloom \u2013 Temizlik ve D\u00fczenleme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79e9\u5e8f = \u7efd\u653e \u2013 \u6e05\u6d01\u4e0e\u6574\u7406"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79e9\u5e8f = \u7dbb\u653e \u2013 \u6e05\u6f54\u8207\u6574\u7406"
          }
        }
      }
    },

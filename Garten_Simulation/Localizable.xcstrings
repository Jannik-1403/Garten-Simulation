    "assessment.benchmark.top10": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gehörst zu den Top 10%. Du bist extrem diszipliniert und hebst dich deutlich vom Durchschnitt ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in the top 10%. You are extremely disciplined and stand out from the crowd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en el top 10%. Eres extremadamente disciplinado y te destacas de la multitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es dans le top 10%. Tu es extrêmement discipliné et tu te distingues clairement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप शीर्ष 10% में हैं। आप अत्यंत अनुशासित हैं और भीड़ से अलग हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei nel top 10%. Sei estremamente disciplinato e ti distingui nettamente dalla media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トップ10%に入っています。非常に規律があり、他と一線を画しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상위 10%에 속합니다. 매우 규율적이며 다른 사람들과 차별됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je behoort tot de top 10%. Je bent extreem gedisciplineerd en onderscheidt je duidelijk van de rest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś w top 10%. Jesteś niezwykle zdyscyplinowany i wyraźnie wyróżniasz się z tłumu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás no top 10%. És extremamente disciplinado e destacas-te claramente da média."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás no top 10%. És extremamente disciplinado e destacas-te claramente da média."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты в топ 10%. Ты исключительно дисциплинирован и явно выделяешься из толпы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk %10 içindesin. Son derece disiplinlisin ve kalabalıktan öne çıkıyorsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你位于前10%。你极为自律，明显与众不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你位於前10%。你極為自律，明顯與眾不同。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.benchmark.top30": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solide Leistung (Top 30%). Du bist überdurchschnittlich, aber es gibt noch klares Potenzial nach oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid performance (Top 30%). You are above average, but there is clear room for improvement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendimiento sólido (Top 30%). Estás por encima de la media, pero hay margen de mejora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance solide (Top 30%). Tu es au-dessus de la moyenne, mais il y a encore du potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठोस प्रदर्शन (शीर्ष 30%)। आप औसत से ऊपर हैं, लेकिन सुधार की गुंजाइश है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestazione solida (Top 30%). Sei sopra la media, ma c'è ancora spazio per migliorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しっかりしたパフォーマンス（トップ30%）。平均以上ですが、改善の余地があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탄탄한 성과(상위 30%). 평균 이상이지만 개선의 여지가 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solide prestatie (Top 30%). Je bent bovengemiddeld, maar er is nog duidelijk potentieel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solidny wynik (Top 30%). Jesteś powyżej przeciętnej, ale jest jeszcze wyraźny potencjał do rozwoju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desempenho sólido (Top 30%). Estás acima da média, mas ainda há potencial de melhoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desempenho sólido (Top 30%). Estás acima da média, mas ainda há potencial de melhoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошая работа (топ 30%). Ты выше среднего, но есть явный потенциал для роста."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlam performans (%30 en iyi). Ortalamanın üzerindesin, ancak daha fazla potansiyel var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表现出色（前30%）。你高于平均水平，但仍有明显提升空间。"

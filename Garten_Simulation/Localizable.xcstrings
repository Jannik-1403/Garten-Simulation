    "item.tier_freund.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und ruft kleine Helfer in den Garten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and calls little helpers to the garden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und ruft kleine Helfer in den Garten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active imm\u00e9diatement et appelle de petits auxiliaires dans le jardin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0930\u0902\u0924 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u092c\u0917\u0940\u091a\u0947 \u092e\u0947\u0902 \u091b\u094b\u091f\u0947 \u0938\u0939\u093e\u092f\u0915\u094b\u0902 \u0915\u094b \u092c\u0941\u0932\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and calls little helpers to the garden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u6d3b\u767a\u306b\u306a\u308a\u3001\u5c0f\u3055\u306a\u304a\u624b\u4f1d\u3044\u3055\u3093\u3092\u5ead\u306b\u547c\u3073\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uc5b4 \uc815\uc6d0\uc5d0 \uc791\uc740 \ub3c4\uc6b0\ubbf8\ub97c \ubd88\ub7ec\uc635\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en roept kleine helpers naar de tuin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast staje si\u0119 aktywny i przywo\u0142uje ma\u0142ych pomocnik\u00f3w do ogrodu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e chama pequenos ajudantes para o jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u0438 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0445 \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u0432 \u0432 \u0441\u0430\u0434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve minik yard\u0131mc\u0131lar\u0131n\u0131 bah\u00e7eye \u00e7a\u011f\u0131r\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u53ec\u5524\u5c0f\u5e2e\u624b\u6765\u5230\u82b1\u56ed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u8b8a\u5f97\u6d3b\u8e8d\u4e26\u53ec\u559a\u5c0f\u5e6b\u624b\u9032\u5165\u82b1\u5712\u3002"
          }
        }
      }
    },
    "item.unkraut_schild.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Unkraut mit dem Schild-Ritual und sch\u00fctzt 24 Stunden vor neuem Unkraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes weeds with the shield ritual and protects against new weeds for 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina malas hierbas con el ritual del escudo y protege 24 h contra nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire les mauvaises herbes par le rituel du bouclier et prot\u00e8ge 24 h contre les nouvelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0922\u093e\u0932 \u0905\u0928\u0941\u0937\u094d\u0920\u093e\u0928 \u0938\u0947 \u0916\u0930-\u092a\u0924\u0935\u093e\u0930 \u0915\u094b \u0939\u091f\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 24 \u0918\u0902\u091f\u0947 \u0924\u0915 \u0928\u092f\u0947 \u0916\u0930-\u092a\u0924\u0935\u093e\u0930 \u0938\u0947 \u092c\u091a\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove le erbacce con il rituale dello scudo e protegge per 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30fc\u30eb\u30c9\u30ea\u30c1\u30e5\u30a2\u30eb\u3067\u96d1\u8349\u3092\u9664\u53bb\u3057\u3001\u65b0\u305f\u306a\u96d1\u8349\u309224\u6642\u9593\u9632\u304e\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc29\ud328 \uc758\uc2dd\uc73c\ub85c \uc7a1\ucd08\ub97c \uc81c\uac70\ud558\uace0 24\uc2dc\uac04 \ub3d9\uc548 \uc0c8\ub85c\uc6b4 \uc7a1\ucd08\ub97c \ub9c9\uc544\uc90d\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert onkruid met het schildritueel en beschermt 24 uur lang tegen nieuw onkruid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa chwasty za pomoc\u0105 rytua\u0142u tarczy i chroni przed nowymi chwastami przez 24 godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove ervas com o ritual do escudo e protege 24 h contra novas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u044f\u0435\u0442 \u0441\u043e\u0440\u043d\u044f\u043a\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u0438\u0442\u0443\u0430\u043b\u0430 \u0449\u0438\u0442\u0430 \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043e\u0442 \u043d\u043e\u0432\u044b\u0445 \u0441\u043e\u0440\u043d\u044f\u043a\u043e\u0432 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 24 \u0447\u0430\u0441\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkan rit\u00fceli ile yabani otlar\u0131 yok eder ve 24 saat boyunca yeni yabani otlara kar\u015f\u0131 koruma sa\u011flar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u62a4\u76fe\u4eea\u5f0f\u6e05\u9664\u6742\u8349\uff0c\u5e76\u572824\u5c0f\u65f6\u5185\u9632\u6b62\u65b0\u6742\u8349\u51fa\u73b0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u76fe\u724c\u5100\u5f0f\u6e05\u9664\u96dc\u8349\uff0c\u4e26\u5728 24 \u5c0f\u6642\u5167\u9632\u6b62\u65b0\u96dc\u8349\u7684\u751f\u9577\u3002"
          }
        }
      }
    },

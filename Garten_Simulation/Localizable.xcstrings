          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я смотрю ему в глаза и говорю 'Нет', не оправдываясь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "settings.share.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringen Sie andere Leute auch dazu, ihr Bestes aus ihrem Leben zu holen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encourage other people to get the best out of their lives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima a otras personas a sacar lo mejor de sus vidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encouragez d'autres personnes à tirer le meilleur parti de leur vie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य लोगों को भी अपने जीवन से अपनी सबसे अच्छी चीज़ प्राप्त करने के लिए प्रेरित करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoraggia altre persone a ottenere il meglio dalla loro vita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人が人生を最大限に活用できるように奨励する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람들이 자신의 삶에서 최선을 다하도록 격려하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moedig andere mensen aan om het beste uit hun leven te halen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachęcaj innych ludzi, aby czerpali z życia to, co najlepsze"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incentive outras pessoas a tirarem o melhor das suas vidas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incentive outras pessoas a tirarem o melhor das suas vidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставляйте других людей тоже выжимать из своей жизни максимум"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer insanları hayatlarından en iyi şekilde yararlanmaya teşvik edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼓励其他人也充分利用自己的生活"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鼓勵其他人也充分利用自己的生活"
          }
        }
      }
    },

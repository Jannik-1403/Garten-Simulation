    "assessment.fitness.q3" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du machst eine Übung. Dein Plan sagt 12 Wiederholungen. Bei Nummer 9 fangen deine Muskeln an, extrem zu brennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You do an exercise. Your plan says 12 reps. At number 9 your muscles start to burn extremely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haces un ejercicio. Tu plan dice 12 repeticiones. En el número 9 tus músculos empiezan a arder muchísimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous faites un exercice. Votre plan dit 12 répétitions. Au numéro 9, vos muscles commencent à brûler extrêmement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप एक व्यायाम करें. आपकी योजना 12 प्रतिनिधि कहती है। 9वें नंबर पर आपकी मांसपेशियां अत्यधिक जलने लगती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai un esercizio. Il tuo piano dice 12 ripetizioni. Al numero 9 i tuoi muscoli iniziano a bruciare moltissimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは運動をします。あなたの計画では12回繰り返します。 9 番目では、筋肉が極度に燃え始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 운동을합니다. 귀하의 계획에는 12회 반복이 포함되어 있습니다. 9번에서는 근육이 극도로 타기 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je doet een oefening. Je plan zegt 12 herhalingen. Op nummer 9 beginnen je spieren extreem te verbranden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robisz ćwiczenie. Twój plan zakłada 12 powtórzeń. Przy liczbie 9 Twoje mięśnie zaczynają się niesamowicie palić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz um exercício. Seu plano diz 12 repetições. No número 9, seus músculos começam a queimar extremamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты выполняешь упражнение. Твой план говорит 12 повторений. На девятом твои мышцы начинают очень сильно гореть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir egzersiz yapıyorsun. Planınızda 12 tekrar yazıyor. 9 numarada kaslarınız aşırı derecede yanmaya başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在做一个练习。你的计划写着12次重复。在第9次时，你的肌肉开始极度燃烧。"
          }
        },

          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免完美主义。80%完成比0%完美更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免完美主義。80%完成比0%完美更好。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.growth.profile.aufgeber.break": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf keine neuen Tools oder Kurse mehr, solange der alte Kurs nicht zu mindestens 10% abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not purchase any new tools or courses until the old course is at least 10% complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compre ninguna herramienta o curso nuevo hasta que el curso anterior esté completo al menos en un 10 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'achetez pas de nouveaux outils ou cours tant que l'ancien cours n'est pas terminé à au moins 10 %."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक पुराना कोर्स कम से कम 10% पूरा न हो जाए तब तक कोई नया टूल या कोर्स न खरीदें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non acquistare nuovi strumenti o corsi fino a quando il vecchio corso non avrà completato almeno il 10%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いコースが少なくとも 10% 完了するまで、新しいツールやコースを購入しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 과정이 최소 10% 완료될 때까지 새 도구나 과정을 구입하지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koop geen nieuwe tools of cursussen totdat de oude cursus voor minimaal 10% voltooid is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie kupuj żadnych nowych narzędzi ani kursów, dopóki stary kurs nie zostanie ukończony w co najmniej 10%."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não compre nenhuma ferramenta ou curso novo até que o curso antigo esteja pelo menos 10% concluído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não compre nenhuma ferramenta ou curso novo até que o curso antigo esteja pelo menos 10% concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не покупай новые инструменты или курсы, пока старый курс не будет пройден как минимум на 10%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski kursun en az %10'u tamamlanana kadar yeni araç veya kurs satın almayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在旧课程至少完成10%之前，不要再购买新的工具或课程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在舊課程至少完成 10% 之前，請勿購買任何新工具或課程。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.growth.profile.fakeWorker.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist 'beschäftigt', aber nie produktiv. Wir durchbrechen den Pseudofleiß durch radikale 1%-Restriktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are 'busy' but never productive. We break through the pseudo-industriousness with radical 1% restrictions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás \"ocupado\" pero nunca eres productivo. Rompemos la pseudo laboriosidad con restricciones radicales del 1%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes « occupé » mais jamais productif. Nous brisons le pseudo-industriel avec des restrictions radicales de 1%."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप 'व्यस्त' हैं लेकिन कभी उत्पादक नहीं हैं। हम कट्टरपंथी 1% प्रतिबंधों के साथ छद्म-उद्योगशीलता को तोड़ते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei \"occupato\" ma mai produttivo. Superiamo la pseudo-operosità con restrizioni radicali dell’1%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは「忙しい」のに、決して生産的ではありません。過激な１%規制で擬似勤勉を打ち破る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 '바쁘지만' 결코 생산적이지 않습니다. 과격한 1% 제한으로 유사근면을 돌파합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent ‘druk’ maar nooit productief. We doorbreken de pseudo-ijverigheid met radicale beperkingen van 1%."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś „zajęty”, ale nigdy produktywny. Przełamujemy pseudoprzedsiębiorczość radykalnym 1% ograniczeniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está 'ocupado', mas nunca produtivo. Rompemos a pseudo-industriosidade com restrições radicais de 1%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está 'ocupado', mas nunca produtivo. Rompemos a pseudo-industriosidade com restrições radicais de 1%."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты 'занят', но никогда не продуктивен. Мы разрушаем иллюзию усердия через радикальные 1%-ные ограничения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Meşgulsün' ama asla üretken değilsin. Sahte çalışkanlığı %1'lik radikal kısıtlamalarla aşıyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你总是“忙碌”，但从未高效。我们通过激进的1%限制打破伪勤奋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你很“忙”，但從來沒有生產力。我們突破了激進的1%限制的偽勤奮。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.growth.profile.macher.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lieferst ab. Die letzten 1% liegen in der Skalierung: Du darfst nicht selbst zum Flaschenhals werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You deliver. The last 1% is in scaling: you can't become a bottleneck yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú entregas. El último 1% está en escala: usted mismo no puede convertirse en un cuello de botella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous livrez. Le dernier 1 % est consacré à la mise à l'échelle : vous ne pouvez pas devenir vous-même un goulot d'étranglement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप वितरित करें. अंतिम 1% स्केलिंग में है: आप स्वयं बाधा नहीं बन सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu consegni. L'ultimo 1% riguarda il ridimensionamento: non puoi diventare tu stesso un collo di bottiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが配達します。最後の 1% はスケーリングに関係します。自分自身がボトルネックになることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 배달합니다. 마지막 1%는 확장에 있습니다. 스스로 병목 현상을 일으킬 수는 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij levert. De laatste 1% zit in schaalvergroting: je kunt zelf geen knelpunt worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarczasz. Ostatni 1% to skalowanie: nie możesz sam stać się wąskim gardłem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entrega. O último 1% está no dimensionamento: você mesmo não pode se tornar um gargalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você entrega. O último 1% está no dimensionamento: você mesmo não pode se tornar um gargalo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты сдаёшься. Последние 1% заключаются в масштабировании: не позволяй самому себе стать узким местом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen teslim et. Geriye kalan %1 ise ölçeklendirmeyle ilgilidir: Kendi başınıza bir darboğaz haline gelemezsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你交付成果。最后的1%在于扩展：你不能自己成为瓶颈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你交付。最後 1% 是擴充：你自己不能成為瓶頸。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.growth.profile.traeumer.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesige Visionen, aber keine Umsetzung. Wir reduzieren deine Pläne auf 1%, damit die Ausführung unvermeidbar wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Huge visions but no implementation. We reduce your plans to 1% so that execution becomes unavoidable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes visiones pero ninguna implementación. Reducimos tus planes al 1% para que la ejecución sea inevitable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des visions énormes mais aucune mise en œuvre. Nous réduisons vos projets à 1% pour que leur exécution devienne inévitable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सपने बड़े लेकिन क्रियान्वयन नहीं. हम आपकी योजनाओं को घटाकर 1% कर देते हैं ताकि कार्यान्वयन अपरिहार्य हो जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandi visioni ma nessuna attuazione. Riduciamo i tuoi piani all'1% in modo che l'esecuzione diventi inevitabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壮大なビジョンはあるが、実行には至っていない。実行が避けられないように、計画を 1% に削減します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거대한 비전이지만 구현은 없습니다. 실행이 불가피해질 수 있도록 계획을 1%로 줄입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enorme visies maar geen implementatie. Wij brengen uw plannen terug naar 1% zodat uitvoering onvermijdelijk wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogromne wizje, ale brak realizacji. Obniżamy Twoje plany do 1%, aby realizacja stała się nieunikniona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes visões, mas nenhuma implementação. Reduzimos seus planos para 1% para que a execução se torne inevitável."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandes visões, mas nenhuma implementação. Reduzimos seus planos para 1% para que a execução se torne inevitável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Огромные видения, но никакой реализации. Мы сокращаем твои планы до 1%, чтобы выполнение стало неизбежным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük vizyonlar var ama uygulama yok. Uygulamanın kaçınılmaz hale gelmesi için planlarınızı %1'e düşürüyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巨大的愿景，但没有执行。我们将你的计划缩减到1%，以使执行不可避免。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "願景宏偉但沒有實施。我們將您的計劃減少到 1%，以便執行變得不可避免。"
          }
        }
      },
      "extractionState": "manual"
    },
    "assessment.growth.q3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Projekt ist zu 80 % fertig und bereits gut genug, um eine Top-Bewertung zu bekommen. Die restlichen 20 % würden dich noch einmal 10 Stunden kosten. Was machst du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your project is 80% complete and already good enough to get a top rating. The remaining 20% ​​would cost you another 10 hours. What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su proyecto está completo en un 80% y ya es lo suficientemente bueno como para obtener la máxima calificación. El 20% restante te costaría otras 10 horas. ¿Qué estás haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre projet est terminé à 80 % et est déjà suffisamment bon pour obtenir la meilleure note. Les 20 % restants vous coûteraient encore 10 heures. Que fais-tu?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्रोजेक्ट 80% पूरा हो चुका है और शीर्ष रेटिंग पाने के लिए पहले से ही काफी अच्छा है। शेष 20% में आपको 10 घंटे और लगेंगे। आप क्या कर रहे हो?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo progetto è completo all'80% e già sufficientemente buono per ottenere una valutazione massima. Il restante 20% ti costerebbe altre 10 ore. Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのプロジェクトは 80% 完了しており、すでに最高の評価を得るのに十分なレベルに達しています。残りの 20% ではさらに 10 時間かかります。何してるの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 프로젝트는 80% 완료되었으며 이미 최고 평가를 받을 만큼 충분합니다. 나머지 20%에는 10시간이 더 소요됩니다. 뭐하세요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw project is voor 80% voltooid en al goed genoeg om een ​​topbeoordeling te krijgen. De overige 20% kost je nog eens 10 uur. Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój projekt jest ukończony w 80% i już wystarczająco dobry, aby uzyskać najwyższą ocenę. Pozostałe 20% będzie kosztować kolejne 10 godzin. Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu projeto está 80% concluído e já é bom o suficiente para obter uma classificação máxima. Os 20% restantes custariam mais 10 horas. O que você está fazendo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu projeto está 80% concluído e já é bom o suficiente para obter uma classificação máxima. Os 20% restantes custariam mais 10 horas. O que você está fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой проект готов на 80 % и уже достаточно хорош, чтобы получить отличную оценку. Остальные 20 % обошлись бы тебе еще в 10 часов. Что ты будешь делать?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projenizin %80'i tamamlandı ve zaten en yüksek puanı almaya yetecek kadar iyi. Kalan %20 size 10 saat daha mal olacak. Ne yapıyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的项目已经完成了80%，并且已经足够好，可以获得最高评价。剩下的20%将会再花你10个小时。你会怎么做？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的專案已完成 80%，並且足以獲得最高評級。剩下的20%又要花你10小時。你在幹什麼？"
          }
        }
      },
      "extractionState": "manual"
    },

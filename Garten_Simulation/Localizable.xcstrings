    "onboarding_benachrichtigung_status_abgelehnt": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Du hast Mitteilungen bereits deaktiviert. Um sie zu nutzen, musst du sie in den iOS-Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: You have already disabled notifications. To use them, you must re-enable them in the iOS settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Ya has desactivado las notificaciones. Para usarlas, debes volver a activarlas en los ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: tu as déjà désactivé les notifications. Pour les utiliser, tu dois les réactiver dans les réglages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान दें: आपने पहले ही सूचनाएं अक्षम कर दी हैं. इसका उपयोग करने के लिए, आपको इसे iOS सेटिंग्स में सक्रिय करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: hai già disabilitato le notifiche. Per utilizzarlo è necessario attivarlo nelle impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注: 通知はすでに無効になっています。これらを使用するには、iOS 設定で再度有効にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고: 이미 알림을 비활성화했습니다. 이를 사용하려면 iOS 설정에서 다시 활성화해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opmerking: je hebt meldingen al uitgeschakeld. Om ze te gebruiken, moet je ze opnieuw inschakelen in de iOS-instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: wyłączyłeś już powiadomienia. Aby z nich skorzystać, należy je ponownie włączyć w ustawieniach iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Já desativaste as notificações. Para as usares, tens de as reativar nas definições do iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: Já desativaste as notificações. Para as usares, tens de as reativar nas definições do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание: вы уже отключили уведомления. Чтобы их использовать, вам нужно включить их в настройках iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not: Bildirimleri zaten devre dışı bıraktınız. Bunları kullanmak için iOS ayarlarında yeniden etkinleştirmeniz gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：你已禁用通知。要使用它们，你需要在iOS设置中启用它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意：您已經禁用了通知。要使用它，您需要在 iOS 設定中啟動它。"
          }
        }
      }
    },
    "onboarding_benachrichtigung_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen, um deinen Garten am Leben zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications to keep your garden alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones para mantener vivo tu jardín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les notifications pour garder ton jardin en vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बगीचे को जीवित रखने के लिए सूचनाएं सक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita le notifiche per mantenere vivo il tuo giardino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を有効にして庭を生き生きとさせましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원에 생기를 불어넣으려면 알림을 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel meldingen in om uw tuin levend te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz powiadomienia, aby Twój ogród żył."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa as notificações para manter o teu jardim vivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa as notificações para manter o teu jardim vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите уведомления, чтобы поддерживать ваш сад в живом состоянии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçenizi canlı tutmak için bildirimleri etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用通知，让你的花园保持生机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用通知讓您的花園保持活力。"
          }
        }
      }
    },

    "support.email.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen diese Adresse nur, um dir zu antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We only use this address to respond to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen diese Adresse nur, um dir zu antworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous utilisons cette adresse uniquement pour te r\u00e9pondre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u092e \u0907\u0938 \u092a\u0924\u0947 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u094b \u091c\u0935\u093e\u092c \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "We only use this address to respond to you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30a2\u30c9\u30ec\u30b9\u306f\u304a\u5ba2\u69d8\u3078\u306e\u8fd4\u4fe1\u306e\u307f\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6b0\ub9ac\ub294 \uadc0\ud558\uc5d0\uac8c \uc751\ub2f5\ud558\uae30 \uc704\ud574\uc11c\ub9cc \uc774 \uc8fc\uc18c\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres gebruiken wij uitsluitend om u te kunnen antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cywamy tego adresu wy\u0142\u0105cznie w celu udzielenia odpowiedzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizamos este endere\u00e7o apenas para te responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c \u044d\u0442\u043e\u0442 \u0430\u0434\u0440\u0435\u0441 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c \u0442\u0435\u0431\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adresi yaln\u0131zca size yan\u0131t vermek i\u00e7in kullan\u0131yoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4eec\u4ec5\u4f7f\u7528\u6b64\u5730\u5740\u56de\u590d\u60a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5011\u50c5\u4f7f\u7528\u6b64\u5730\u5740\u56de\u8986\u60a8\u3002"
          }
        }
      }
    },

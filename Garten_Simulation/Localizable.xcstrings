    "assessment.lifestyle.profile.gefangener.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Umfeld zieht dich runter. Du bist gefangen in einem toxischen oder leistungsfeindlichen Kreis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your environment is dragging you down. You are trapped in a toxic or anti-achievement circle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu entorno te está arrastrando hacia abajo. Estás atrapado en un círculo tóxico o anti-logros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre environnement vous tire vers le bas. Vous êtes piégé dans un cercle toxique ou anti-réussite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ambiente ti sta trascinando verso il basso. Sei intrappolato in un circolo tossico o anti-realizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境があなたを引きずっています。あなたは有害な、または達成を妨げるサークルに閉じ込められています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 환경이 당신을 끌어내리고 있습니다. 당신은 독성이 있거나 성취를 방해하는 서클에 갇혀 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je omgeving haalt je naar beneden. Je zit gevangen in een giftige of anti-prestatiecirkel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje otoczenie ciągnie Cię w dół. Jesteś uwięziony w kręgu toksycznym lub antyosiągalnym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ambiente está arrastando você para baixo. Você está preso em um círculo tóxico ou anti-realização."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevreniz sizi aşağıya çekiyor. Zehirli veya başarı karşıtı bir çemberin içinde sıkışıp kaldınız."
          }
        }
      }
    },

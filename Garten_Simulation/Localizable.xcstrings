    "shop.weed_blocks_planting": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unkraut blockiert das Anpflanzen! Jäte es zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weed blocks planting! Remove it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las malas hierbas bloquean la plantación. Quítalas primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mauvaises herbes bloquent la plantation ! Retire-les d'abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जंगली घास पौधों की रोपाई में बाधा डाल रही है! पहले इसे निकालो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le erbacce bloccano la semina! Rimuovile prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雑草ブロック植え！まずそれを取り外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잡초 블록 심기! 먼저 제거하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wietblokken planten! Verwijder het eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chwasty blokują sadzenie! Najpierw go usuń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas bloqueiam o plantio! Remove-as primeiro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ervas daninhas bloqueiam o plantio! Remove-as primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сорняки мешают посадке! Сначала их прополите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ot blokları ekimi! Önce onu kaldırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "杂草阻碍种植！先除草吧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

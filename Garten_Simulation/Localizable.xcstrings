        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0932\u0924 \u092a\u0930\u093f\u0923\u093e\u092e! \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"

    "trash.online_shopping_app.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6sche alle Shopping-Apps und melde dich aus Online-Shops aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all shopping apps and log out of online shops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las apps de compras y cierra sesi\u00f3n en las tiendas online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les applications de shopping et d\u00e9connecte-toi des boutiques en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092d\u0940 \u0936\u0949\u092a\u093f\u0902\u0917 \u0910\u092a\u094d\u0938 \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u094d\u091f\u094b\u0930\u094d\u0938 \u0938\u0947 \u0932\u0949\u0917 \u0906\u0909\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutte le app di shopping e disconnettiti dai negozi online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u306e\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u30a2\u30d7\u30ea\u3092\u524a\u9664\u3057\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u30b7\u30e7\u30c3\u30d7\u304b\u3089\u30ed\u30b0\u30a2\u30a6\u30c8\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uc1fc\ud551 \uc571\uc744 \uc0ad\uc81c\ud558\uace0 \uc628\ub77c\uc778 \uc1fc\ud551\ubab0\uc5d0\uc11c \ub85c\uadf8\uc544\uc6c3\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder alle winkel-apps en log uit bij online winkels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usu\u0144 wszystkie aplikacje zakupowe i wyloguj si\u0119 ze sklep\u00f3w internetowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua todos os apps de compras e saia das lojas online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0438\u0442\u0435 \u0432\u0441\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043f\u043e\u043a\u0443\u043f\u043e\u043a \u0438 \u0432\u044b\u0439\u0434\u0438\u0442\u0435 \u0438\u0437 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00fcm al\u0131\u015fveri\u015f uygulamalar\u0131n\u0131 sil ve \u00e7evrimi\u00e7i ma\u011fazalardan \u00e7\u0131k\u0131\u015f yap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5220\u9664\u6240\u6709\u8d2d\u7269\u5e94\u7528\u7a0b\u5e8f\u5e76\u9000\u51fa\u5728\u7ebf\u5546\u5e97\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u522a\u9664\u6240\u6709\u8cfc\u7269\u61c9\u7528\u7a0b\u5f0f\u4e26\u9000\u51fa\u7dda\u4e0a\u5546\u5e97\u3002"
          }
        }
      }
    },
    "trash.online_shopping_app.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterfrage: Brauchst du das wirklich \u2013 oder willst du nur den Dopamin-Kick?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Question it: do you really need this \u2013 or do you just want the dopamine kick?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuesti\u00f3natelo: \u00bfrealmente lo necesitas o solo quieres el chute de dopamina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remets en question : as-tu vraiment besoin de \u00e7a \u2013 ou tu veux juste le coup de dopamine ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u091b\u094b: \u0915\u094d\u092f\u093e \u0924\u0941\u092e\u094d\u0939\u0947\u0902 \u092f\u0939 \u0938\u091a \u092e\u0947\u0902 \u091a\u093e\u0939\u093f\u090f \u2013 \u092f\u093e \u0924\u0941\u092e \u0938\u093f\u0930\u094d\u092b \u0921\u094b\u092a\u093e\u092e\u093f\u0928 \u0915\u093e \u0909\u0924\u094d\u0938\u093e\u0939 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in discussione: ne hai davvero bisogno \u2013 o vuoi solo la scarica di dopamina?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u554f\u3057\u307e\u3057\u3087\u3046\u3002\u672c\u5f53\u306b\u5fc5\u8981\u306a\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u30c9\u30fc\u30d1\u30df\u30f3\u306e\u523a\u6fc0\u304c\u6b32\u3057\u3044\u3060\u3051\u306a\u306e\u304b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc790\ubb38\ud574 \ubcf4\uc138\uc694: \uc815\ub9d0 \ud544\uc694\ud55c \uac74\uac00\uc694 \u2013 \uc544\ub2c8\uba74 \ub3c4\ud30c\ubbfc \uc790\uadf9\uc774 \ud544\uc694\ud55c \uac74\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag jezelf af: heb je dit echt nodig \u2013 of wil je gewoon de dopaminestoot?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwestionuj to: czy naprawd\u0119 tego potrzebujesz \u2013 czy chcesz tylko zastrzyku dopaminy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Questione: voc\u00ea realmente precisa disso \u2013 ou s\u00f3 quer o pico de dopamina?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u043f\u0440\u043e\u0441: \u0412\u0430\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u044d\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u2013 \u0438\u043b\u0438 \u0432\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u0444\u0430\u043c\u0438\u043d?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgula: buna ger\u00e7ekten ihtiyac\u0131n var m\u0131 \u2013 yoksa sadece dopamin at\u0131\u015f\u0131n\u0131 m\u0131 istiyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95ee\u9898\uff1a\u4f60\u771f\u7684\u9700\u8981\u8fd9\u4e2a\u5417\uff1f\u8fd8\u662f\u4f60\u53ea\u662f\u60f3\u8981\u591a\u5df4\u80fa\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u554f\u984c\uff1a\u4f60\u771f\u7684\u9700\u8981\u9019\u500b\u55ce\uff1f\u9084\u662f\u4f60\u53ea\u662f\u60f3\u8981\u591a\u5df4\u80fa\uff1f"
          }
        }
      }
    },
    "trash.online_shopping_app.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel: Warenkorb f\u00fcllen, aber 24h warten bevor du kaufst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule: fill the cart, but wait 24 hours before buying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regla: llena el carrito pero espera 24 horas antes de comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e8gle : remplis le panier, mais attends 24 heures avant d'acheter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u092f\u092e: \u0915\u093e\u0930\u094d\u091f \u092d\u0930\u0947\u0902, \u0932\u0947\u0915\u093f\u0928 \u0916\u0930\u0940\u0926\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 24 \u0918\u0902\u091f\u0947 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola: riempi il carrello, ma aspetta 24 ore prima di acquistare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30eb\u30fc\u30eb\uff1a\u30ab\u30fc\u30c8\u306b\u5165\u308c\u308b\u304c\u3001\u8cfc\u5165\u524d\u306b24\u6642\u9593\u5f85\u3064\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uaddc\uce59: \uc7a5\ubc14\uad6c\ub2c8\ub97c \ucc44\uc6b0\ub418 \uad6c\ub9e4 \uc804 24\uc2dc\uac04 \uae30\ub2e4\ub9ac\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regel: vul de winkelwagen, maar wacht 24 uur voor je koopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasada: wype\u0142nij koszyk, ale poczekaj 24 godziny przed zakupem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regra: encha o carrinho, mas espere 24 horas antes de comprar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0430\u0432\u0438\u043b\u043e: \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u043a\u043e\u0440\u0437\u0438\u043d\u0443, \u043d\u043e \u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435 24 \u0447\u0430\u0441\u0430 \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u043a\u0443\u043f\u043a\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural: sepeti doldur ama sat\u0131n almadan \u00f6nce 24 saat bekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89c4\u5219\uff1a\u586b\u6ee1\u60a8\u7684\u8d2d\u7269\u8f66\uff0c\u4f46\u7b49\u5f85 24 \u5c0f\u65f6\u540e\u518d\u8d2d\u4e70\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u898f\u5247\uff1a\u586b\u6eff\u60a8\u7684\u8cfc\u7269\u8eca\uff0c\u4f46\u7b49\u5f85 24 \u5c0f\u6642\u5f8c\u518d\u8cfc\u8cb7\u3002"
          }
        }
      }
    },
    "trash.online_shopping_app.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summiere deine Online-K\u00e4ufe des letzten Monats. \u00dcberraschend?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up your online purchases from last month. Surprising?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suma tus compras online del mes pasado. \u00bfSorprendente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Additionne tes achats en ligne du mois dernier. Surprenant ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u0915\u0940 \u0905\u092a\u0928\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u094b \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u0939\u0948\u0930\u093e\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Somma i tuoi acquisti online dell'ultimo mese. Sorprendente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5148\u6708\u306e\u30aa\u30f3\u30e9\u30a4\u30f3\u8cfc\u5165\u3092\u5408\u8a08\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u9a5a\u304d\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\ub09c\ub2ec \uc628\ub77c\uc778 \uad6c\ub9e4\ub97c \ud569\uc0b0\ud574 \ubcf4\uc138\uc694. \ub180\ub78d\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel je online aankopen van de afgelopen maand op. Verrassend?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsumuj swoje zakupy online z ostatniego miesi\u0105ca. Zaskakuj\u0105ce?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Some suas compras online do m\u00eas passado. Surpreendente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0441\u0432\u043e\u0438 \u043e\u043d\u043b\u0430\u0439\u043d-\u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043c\u0435\u0441\u044f\u0446. \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7en ayki \u00e7evrimi\u00e7i al\u0131\u015fveri\u015flerini topla. \u015ea\u015f\u0131rt\u0131c\u0131 m\u0131?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u603b\u8ba1\u60a8\u4e0a\u4e2a\u6708\u7684\u7f51\u4e0a\u8d2d\u7269\u3002\u5947\u602a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7e3d\u8a08\u60a8\u4e0a\u500b\u6708\u7684\u7dda\u4e0a\u8cfc\u7269\u3002\u5947\u602a\uff1f"
          }
        }
      }
    },
    "trash.online_shopping_app.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Online Shopping)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Geld sparen)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Online Shopping)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Geld sparen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Online Shopping)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Geld sparen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Online Shopping)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Geld sparen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u093e (\u0911\u0928\u0932\u093e\u0907\u0928 \u0936\u0949\u092a\u093f\u0902\u0917)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0926\u0943\u0937\u094d\u091f\u093f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u094b \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0947\u0902\u0964\n3. \u0915\u0920\u093f\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0926\u0902\u0921 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u092a\u0948\u0938\u093e \u092c\u091a\u093e\u0928\u093e)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0906\u0938\u093e\u0928 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0915\u0930\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0938\u093f\u0930\u094d\u092b 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Online Shopping)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Geld sparen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Online Shopping)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Geld sparen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Online Shopping)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Geld sparen)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."

    "trash.nacht_snack_box.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends snacken = schlechter Schlaf + mehr Hunger am nächsten Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacking at night = poor sleep + more hunger the next day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Picar por la noche = sueño malo + más hambre al día siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grignoter le soir = mauvais sommeil + plus de faim le lendemain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शाम को स्नैक करना = खराब नींद + अगले दिन अधिक भूख।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuntini serali = sonno scarso + più fame il giorno dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜のスナックは睡眠不良と翌日の空腹感につながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤에 간식을 먹으면 수면이 나빠지고 다음 날 더 배가 고파집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacken 's avonds = slechte slaap + meer honger de volgende dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczorne przekąski = słaby sen + więcej głodu następnego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanchar à noite = sono ruim + mais fome no dia seguinte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanchar à noite = sono ruim + mais fome no dia seguinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

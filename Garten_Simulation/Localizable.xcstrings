    "weekly_report.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Plane kleine, feste Fokus-Bl\u00f6cke (z.B. 25 Minuten) ein, anstatt zu versuchen, stundenlang durchzuarbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Schedule small, fixed focus blocks (e.g. 25 minutes) instead of trying to work for hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Planifica bloques de enfoque peque\u00f1os y fijos (p.ej. 25 minutos) en lugar de intentar trabajar durante horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Planifie de petits blocs de concentration fixes (p.ex. 25 minutes) plut\u00f4t que d'essayer de travailler pendant des heures."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u091d\u093e\u0935: \u091b\u094b\u091f\u0947, \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u092b\u094b\u0915\u0938-\u092c\u094d\u0932\u0949\u0915\u094d\u0938 (\u091c\u0948\u0938\u0947 25 \u092e\u093f\u0928\u091f) \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u090f\u0902, \u092c\u091c\u093e\u092f \u0907\u0938\u0915\u0947 \u0915\u093f \u0918\u0902\u091f\u094b\u0902 \u0924\u0915 \u0932\u0917\u093e\u0924\u093e\u0930 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Pianifica piccoli blocchi di concentrazione fissi (ad es. 25 minuti) invece di cercare di lavorare per ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d2\u30f3\u30c8\uff1a\u4f55\u6642\u9593\u3082\u4f5c\u696d\u3057\u3088\u3046\u3068\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u5c0f\u3055\u306a\u56fa\u5b9a\u306e\u96c6\u4e2d\u30d6\u30ed\u30c3\u30af\uff08\u4f8b\uff1a25\u5206\uff09\u3092\u8a08\u753b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud301: \uba87 \uc2dc\uac04 \ub3d9\uc548 \uc791\uc5c5\ud558\ub824 \ud558\uc9c0 \ub9d0\uace0 \uc791\uc740 \uace0\uc815 \uc9d1\uc911 \ube14\ub85d(\uc608: 25\ubd84)\uc744 \uacc4\ud68d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Plan kleine, vaste focusblokken (bijv. 25 minuten) in plaats van te proberen urenlang te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaz\u00f3wka: Zaplanuj ma\u0142e, sta\u0142e bloki skupienia (np. 25 minut) zamiast pr\u00f3bowa\u0107 pracowa\u0107 przez wiele godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Planeje blocos de foco pequenos e fixos (ex: 25 minutos) em vez de tentar trabalhar por horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0432\u0435\u0442: \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0431\u043b\u043e\u043a\u0438 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, 25 \u043c\u0438\u043d\u0443\u0442) \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u044b\u0442\u0430\u0442\u044c\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0447\u0430\u0441\u0430\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130pucu: Saatler boyunca \u00e7al\u0131\u015fmaya \u00e7al\u0131\u015fmak yerine k\u00fc\u00e7\u00fck, sabit odak bloklar\u0131 (\u00f6r. 25 dakika) planla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u8ba1\u5212\u5c0f\u7684\u3001\u56fa\u5b9a\u7684\u7126\u70b9\uff08\u4f8b\u5982 25 \u5206\u949f\uff09\uff0c\u800c\u4e0d\u662f\u5c1d\u8bd5\u5de5\u4f5c\u51e0\u4e2a\u5c0f\u65f6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u898f\u5283\u5c0f\u7684\u3001\u56fa\u5b9a\u7684\u7126\u9ede\uff08\u4f8b\u5982 25 \u5206\u9418\uff09\uff0c\u800c\u4e0d\u662f\u5617\u8a66\u5de5\u4f5c\u5e7e\u500b\u5c0f\u6642\u3002"
          }
        }
      }
    },
    "weekly_report.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Versuche, das Handy w\u00e4hrend deiner Sessions au\u00dfer Sichtweite zu legen \u2013 das reduziert Ablenkungen enorm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Try keeping your phone out of sight during sessions \u2013 it massively reduces distractions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Intenta mantener el tel\u00e9fono fuera de tu vista durante las sesiones, eso reduce enormemente las distracciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Essaie de garder ton t\u00e9l\u00e9phone hors de ta vue pendant tes sessions \u2013 cela r\u00e9duit \u00e9norm\u00e9ment les distractions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u091d\u093e\u0935: \u0905\u092a\u0928\u0940 \u0938\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092e\u094b\u092c\u093e\u0907\u0932 \u092b\u094b\u0928 \u0915\u094b \u0928\u091c\u093c\u0930 \u0938\u0947 \u0926\u0942\u0930 \u0930\u0916\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902 \u2013 \u0907\u0938\u0938\u0947 \u0927\u094d\u092f\u093e\u0928 \u092d\u091f\u0915\u0928\u0947 \u092e\u0947\u0902 \u0915\u093e\u092b\u0940 \u0915\u092e\u0940 \u0906\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Prova a tenere il telefono fuori dalla vista durante le sessioni \u2013 riduce enormemente le distrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d2\u30f3\u30c8\uff1a\u30bb\u30c3\u30b7\u30e7\u30f3\u4e2d\u306f\u30b9\u30de\u30db\u3092\u8996\u754c\u306e\u5916\u306b\u7f6e\u304f\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3067\u6c17\u304c\u6563\u308b\u3053\u3068\u304c\u5927\u5e45\u306b\u6e1b\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud301: \uc138\uc158 \ub3d9\uc548 \uc2a4\ub9c8\ud2b8\ud3f0\uc744 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uacf3\uc5d0 \ub450\uc5b4 \uc9d1\uc911\ub825 \ubd84\uc0b0\uc744 \ud06c\uac8c \uc904\uc774\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Probeer je telefoon tijdens sessies buiten het zicht te houden \u2013 dat vermindert afleidingen enorm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaz\u00f3wka: Staraj si\u0119 trzyma\u0107 telefon poza zasi\u0119giem wzroku podczas sesji \u2013 to znacznie zmniejsza rozproszenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Tente manter o celular fora do seu campo de vis\u00e3o durante as sess\u00f5es \u2013 isso reduz muito as distra\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0432\u0435\u0442: \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u043d\u044f\u0442\u0438\u0439 \u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0432\u043d\u0435 \u043f\u043e\u043b\u044f \u0437\u0440\u0435\u043d\u0438\u044f \u2014 \u044d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442 \u043e\u0442\u0432\u043b\u0435\u043a\u0430\u044e\u0449\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130pucu: Seanslar s\u0131ras\u0131nda telefonunu g\u00f6r\u00fc\u015f alan\u0131n\u0131n d\u0131\u015f\u0131nda tutmay\u0131 dene \u2013 bu dikkat da\u011f\u0131n\u0131kl\u0131\u011f\u0131n\u0131 b\u00fcy\u00fck \u00f6l\u00e7\u00fcde azalt\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u5728\u4f1a\u8bae\u671f\u95f4\u5c3d\u91cf\u5c06\u624b\u673a\u653e\u5728\u89c6\u7ebf\u4e4b\u5916 - \u8fd9\u4f1a\u5927\u5927\u51cf\u5c11\u5e72\u6270\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u5728\u6703\u8b70\u671f\u9593\u76e1\u91cf\u5c07\u624b\u6a5f\u653e\u5728\u8996\u7dda\u4e4b\u5916 - \u9019\u6703\u5927\u5927\u6e1b\u5c11\u5e72\u64fe\u3002"
          }
        }
      }
    },
    "weekly_report.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Erledige deine wichtigsten Gewohnheiten direkt morgens. So startest du bereits mit einem kleinen Sieg in den Tag!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Complete your most important habits first thing in the morning. That way you start the day with a small win!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: Completa tus h\u00e1bitos m\u00e1s importantes a primera hora de la ma\u00f1ana. \u00a1As\u00ed empezar\u00e1s el d\u00eda con una peque\u00f1a victoria!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Effectue tes habitudes les plus importantes d\u00e8s le matin. Tu commenceras ainsi la journ\u00e9e avec une petite victoire !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0915\u0947\u0924: \u0905\u092a\u0928\u0947 \u0938\u092c\u0938\u0947 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0938\u0940\u0927\u0947 \u0938\u0941\u092c\u0939 \u0939\u0940 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0964 \u0907\u0938 \u0924\u0930\u0939 \u0906\u092a \u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u090f\u0915 \u091b\u094b\u091f\u0940 \u091c\u0940\u0924 \u0938\u0947 \u0915\u0930\u0947\u0902\u0917\u0947!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: Completa le tue abitudini pi\u00f9 importanti di mattina. In questo modo inizi la giornata con una piccola vittoria!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d2\u30f3\u30c8\uff1a\u4e00\u756a\u5927\u5207\u306a\u7fd2\u6163\u3092\u671d\u4e00\u756a\u306b\u6e08\u307e\u305b\u307e\u3057\u3087\u3046\u3002\u5c0f\u3055\u306a\u52dd\u5229\u3067\u4e00\u65e5\u3092\u30b9\u30bf\u30fc\u30c8\u3067\u304d\u307e\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud301: \uac00\uc7a5 \uc911\uc694\ud55c \uc2b5\uad00\uc744 \uc544\uce68 \uac00\uc7a5 \uba3c\uc800 \uc644\ub8cc\ud558\uc138\uc694. \uc791\uc740 \uc131\uacf5\uc73c\ub85c \ud558\ub8e8\ub97c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Voltooi je belangrijkste gewoonten 's ochtends vroeg. Zo begin je de dag al met een kleine overwinning!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaz\u00f3wka: Wykonaj swoje najwa\u017cniejsze nawyki od razu rano. W ten spos\u00f3b zaczniesz dzie\u0144 z ma\u0142ym sukcesem!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Conclua seus h\u00e1bitos mais importantes logo de manh\u00e3. Assim voc\u00ea come\u00e7a o dia com uma pequena vit\u00f3ria!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0432\u0435\u0442: \u043f\u0435\u0440\u0432\u044b\u043c \u0434\u0435\u043b\u043e\u043c \u0443\u0442\u0440\u043e\u043c \u0437\u0430\u043d\u0438\u043c\u0430\u0439\u0442\u0435\u0441\u044c \u0441\u0432\u043e\u0438\u043c\u0438 \u0441\u0430\u043c\u044b\u043c\u0438 \u0432\u0430\u0436\u043d\u044b\u043c\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u043c\u0438. \u0418\u0442\u0430\u043a, \u0432\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0435 \u0434\u0435\u043d\u044c \u0441 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439 \u043f\u043e\u0431\u0435\u0434\u044b!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130pucu: En \u00f6nemli al\u0131\u015fkanl\u0131klar\u0131n\u0131 sabah ilk i\u015f olarak tamamla. B\u00f6ylece g\u00fcne k\u00fc\u00e7\u00fck bir zaferle ba\u015flars\u0131n!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u65e9\u4e0a\u7b2c\u4e00\u4ef6\u4e8b\u5c31\u662f\u517b\u6210\u6700\u91cd\u8981\u7684\u4e60\u60ef\u3002\u6240\u4ee5\u4f60\u4ee5\u4e00\u4e2a\u5c0f\u5c0f\u7684\u80dc\u5229\u5f00\u59cb\u4e86\u65b0\u7684\u4e00\u5929\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u65e9\u4e0a\u7b2c\u4e00\u4ef6\u4e8b\u5c31\u662f\u990a\u6210\u6700\u91cd\u8981\u7684\u7fd2\u6163\u3002\u6240\u4ee5\u4f60\u4ee5\u4e00\u500b\u5c0f\u5c0f\u7684\u52dd\u5229\u958b\u59cb\u4e86\u65b0\u7684\u4e00\u5929\uff01"
          }
        }
      }
    },
    "weekly_report.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Weniger ist manchmal mehr. Konzentriere dich n\u00e4chste Woche auf 2-3 Kern-Gewohnheiten, um sie wirklich zu festigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Less is sometimes more. Focus on 2-3 core habits next week to really cement them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: A veces menos es m\u00e1s. Conc\u00e9ntrate en 2-3 h\u00e1bitos clave la pr\u00f3xima semana para consolidarlos de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : Parfois, moins c'est plus. Concentre-toi sur 2-3 habitudes cl\u00e9s la semaine prochaine pour vraiment les ancrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u091d\u093e\u0935: \u0915\u092d\u0940-\u0915\u092d\u0940 \u0915\u092e \u0905\u0927\u093f\u0915 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0905\u0917\u0932\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 2-3 \u092e\u0941\u0916\u094d\u092f \u0906\u0926\u0924\u094b\u0902 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902, \u0924\u093e\u0915\u093f \u0909\u0928\u094d\u0939\u0947\u0902 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u092e\u091c\u092c\u0942\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiglio: A volte meno \u00e8 meglio. Concentrati su 2-3 abitudini principali la settimana prossima per consolidarle davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d2\u30f3\u30c8\uff1a\u5c11\u306a\u3044\u65b9\u304c\u3044\u3044\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\u6765\u9031\u306f2\u301c3\u3064\u306e\u30b3\u30a2\u7fd2\u6163\u306b\u96c6\u4e2d\u3057\u3066\u3001\u3057\u3063\u304b\u308a\u5b9a\u7740\u3055\u305b\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud301: \ub54c\ub85c\ub294 \uc801\uc744\uc218\ub85d \ub354 \uc88b\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \uc8fc\uc5d0\ub294 2-3\uac00\uc9c0 \ud575\uc2ec \uc2b5\uad00\uc5d0 \uc9d1\uc911\ud574 \ud655\uc2e4\ud788 \uad73\ud600\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Soms is minder meer. Richt je volgende week op 2-3 kerngewoonten om ze echt te verankeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaz\u00f3wka: Mniej znaczy czasem wi\u0119cej. Skoncentruj si\u0119 w przysz\u0142ym tygodniu na 2-3 podstawowych nawykach, by naprawd\u0119 je utrwali\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: \u00c0s vezes, menos \u00e9 mais. Foque em 2-3 h\u00e1bitos essenciais na pr\u00f3xima semana para realmente consolid\u00e1-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0432\u0435\u0442: \u0438\u043d\u043e\u0433\u0434\u0430 \u043c\u0435\u043d\u044c\u0448\u0435 \u0437\u043d\u0430\u0447\u0438\u0442 \u0431\u043e\u043b\u044c\u0448\u0435. \u041d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u044c\u0442\u0435\u0441\u044c \u043d\u0430 2\u20133 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043a\u0440\u0435\u043f\u044f\u0442 \u0438\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130pucu: Bazen az daha fazlad\u0131r. Gelecek hafta 2-3 temel al\u0131\u015fkanl\u0131\u011fa odaklanarak onlar\u0131 ger\u00e7ekten peki\u015ftir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u6709\u65f6\u5c11\u5373\u662f\u591a\u3002\u4e0b\u5468\uff0c\u91cd\u70b9\u5173\u6ce8 2-3 \u4e2a\u6838\u5fc3\u4e60\u60ef\uff0c\u771f\u6b63\u5de9\u56fa\u5b83\u4eec\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u793a\uff1a\u6709\u6642\u5c11\u5373\u662f\u591a\u3002\u4e0b\u9031\uff0c\u91cd\u9ede\u95dc\u6ce8 2-3 \u500b\u6838\u5fc3\u7fd2\u6163\uff0c\u771f\u6b63\u978f\u56fa\u5b83\u5011\u3002"
          }
        }
      }
    },

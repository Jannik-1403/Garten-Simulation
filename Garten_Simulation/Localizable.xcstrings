        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शनिवार की सुबह है. आपकी कोई नियुक्ति नहीं है, कोई दायित्व नहीं है। दिन कैसे बीतता है?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sabato mattina. Non hai appuntamenti, né obblighi. Come si svolge la giornata?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土曜の朝です。あなたには何の約束も義務もありません。一日はどのように展開しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {

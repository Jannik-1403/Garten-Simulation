        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u00e3o equilibrada est\u00e1 a tua vida?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u0442\u0432\u043e\u044f \u0436\u0438\u0437\u043d\u044c?"

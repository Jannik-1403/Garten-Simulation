        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스 세션을 취소하려면 다음 수학 문제를 푸세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los het volgende wiskundige probleem op om je focussessie te annuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż poniższe zadanie matematyczne, aby anulować sesję skupienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrzywa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Urtiga"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u043a\u0440\u0430\u043f\u0438\u0432\u0430"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Is\u0131rgan otu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8368\u9ebb"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8541\u9ebb"
          }
        }
      }
    },

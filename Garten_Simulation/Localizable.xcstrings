    "plant.klee.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokussiere dich auf die positiven Dinge im Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on the positive things in life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enf\u00f3cate en las cosas positivas de la vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez-vous sur les choses positives de la vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u091a\u0940\u091c\u094b\u0902 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrati sulle cose positive della vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eba\u751f\u306e\u30dd\u30b8\u30c6\u30a3\u30d6\u306a\u9762\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0b6\uc758 \uae0d\uc815\uc801\uc778 \uba74\uc5d0 \uc9d1\uc911\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus je op de positieve dingen in het leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skup si\u0119 na pozytywnych rzeczach w \u017cyciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se nas coisas positivas da vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u044c\u0441\u044f \u043d\u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0432\u0435\u0449\u0430\u0445 \u0432 \u0436\u0438\u0437\u043d\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayattaki olumlu \u015feylere odaklan\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e13\u6ce8\u4e8e\u751f\u6d3b\u4e2d\u7684\u79ef\u6781\u4e8b\u7269\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c08\u6ce8\u65bc\u751f\u6d3b\u4e2d\u6b63\u9762\u7684\u4e8b\u60c5\u3002"
          }
        }
      }
    },
    "plant.korallenbusch.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4chst nur im richtigen \u00d6kosystem \u2013 Freundschaften pflegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows only in the right ecosystem \u2013 Nurturing friendships"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece solo en el ecosistema correcto \u2013 Cultivar amistades"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse seulement dans le bon \u00e9cosyst\u00e8me \u2013 Entretenir les amiti\u00e9s"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0930\u094d\u092b \u0938\u0939\u0940 \u092a\u093e\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u0915\u0940 \u0924\u0902\u0924\u094d\u0930 \u092e\u0947\u0902 \u0939\u0940 \u092c\u0922\u093c\u0924\u093e \u0939\u0948 \u2013 \u0926\u094b\u0938\u094d\u0924\u0940 \u0928\u093f\u092d\u093e\u090f\u0902"

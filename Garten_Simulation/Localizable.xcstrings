        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6d3b\u65b9\u5f0f\u8a55\u4f30"
          }
        }
      }
    },
    "assessment.lifestyle.profile.chaot.action": {

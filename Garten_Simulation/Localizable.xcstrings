    "assessment.health.q1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist 14:30 Uhr. Du sitzt am Schreibtisch und f\u00e4llst in ein massives M\u00fcdigkeitsloch. Dein Gehirn arbeitet nur noch auf 20\uff05. Was tust du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's 2:30 p.m. You sit at your desk and fall into a massive hole of fatigue. Your brain only works at 20\uff05. What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son las 14:30. Te sientas en tu escritorio y caes en un enorme agujero de fatiga. Tu cerebro s\u00f3lo funciona al 20\uff05. \u00bfQu\u00e9 est\u00e1s haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est 14h30. Vous \u00eates assis \u00e0 votre bureau et tombez dans un \u00e9norme trou de fatigue. Votre cerveau ne fonctionne qu'\u00e0 20 \uff05. Que fais-tu?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u092a\u0939\u0930 \u0915\u0947 2:30 \u092c\u091c\u0947 \u0939\u0948\u0902. \u0906\u092a \u0905\u092a\u0928\u0947 \u0921\u0947\u0938\u094d\u0915 \u092a\u0930 \u092c\u0948\u0920\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0925\u0915\u093e\u0928 \u0915\u0947 \u092d\u093e\u0930\u0940 \u0917\u0921\u094d\u0922\u0947 \u092e\u0947\u0902 \u0917\u093f\u0930 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u093e \u0926\u093f\u092e\u093e\u0917 \u0915\u0947\u0935\u0932 20\uff05 \u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono le 14:30 Ti siedi alla scrivania e cadi in un enorme buco di stanchezza. Il tuo cervello funziona solo al 20\uff05. Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5348\u5f8c2\u664230\u5206\u3067\u3059\u3002\u673a\u306b\u5ea7\u3063\u3066\u3044\u308b\u3068\u3001\u5927\u304d\u306a\u75b2\u52b4\u306e\u7a74\u306b\u9665\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u8133\u306f20\uff05\u3057\u304b\u6a5f\u80fd\u3057\u307e\u305b\u3093\u3002\u4f55\u3057\u3066\u308b\u306e\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ud6c4 2\uc2dc 30\ubd84\uc774\uc5d0\uc694. \ub2f9\uc2e0\uc740 \ucc45\uc0c1\uc5d0 \uc549\uc544 \uc5c4\uccad\ub09c \ud53c\ub85c\uc758 \uad6c\uba4d\uc5d0 \ube60\uc9c4\ub2e4. \ub2f9\uc2e0\uc758 \ub450\ub1cc\ub294 20\uff05\ub85c\ub9cc \uc791\ub3d9\ud569\ub2c8\ub2e4. \ubb50\ud558\uc138\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is 14.30 uur. Je zit aan je bureau en valt in een enorm gat van vermoeidheid. Je hersenen werken maar voor 20\uff05. Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest 14:30. Siedzisz przy biurku i wpadasz w ogromn\u0105 dziur\u0119 zm\u0119czenia. Tw\u00f3j m\u00f3zg pracuje tylko na 20\uff05. Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e3o 14h30. Voc\u00ea se senta em sua mesa e cai em um enorme buraco de fadiga. Seu c\u00e9rebro s\u00f3 funciona a 20\uff05. O que voc\u00ea est\u00e1 fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0439\u0447\u0430\u0441 14:30. \u0422\u044b \u0441\u0438\u0434\u0438\u0448\u044c \u0437\u0430 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u043c \u0441\u0442\u043e\u043b\u043e\u043c \u0438 \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u0435\u0448\u044c\u0441\u044f \u0432 \u0441\u0438\u043b\u044c\u043d\u0443\u044e \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u044c. \u0422\u0432\u043e\u0439 \u043c\u043e\u0437\u0433 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 20\uff05. \u0427\u0442\u043e \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat 14.30. Masan\u0131za oturuyorsunuz ve b\u00fcy\u00fck bir yorgunluk \u00e7ukuruna d\u00fc\u015f\u00fcyorsunuz. Beyniniz yaln\u0131zca \uff0520 oran\u0131nda \u00e7al\u0131\u015f\u0131r. Ne yap\u0131yorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73b0\u5728\u662f14:30\u3002\u4f60\u5750\u5728\u4e66\u684c\u524d\uff0c\u9677\u5165\u4e86\u5de8\u5927\u7684\u75b2\u5026\u6f29\u6da1\u4e2d\u3002\u4f60\u7684\u5927\u8111\u53ea\u8fd0\u884c\u572820\uff05\u7684\u72b6\u6001\u3002\u4f60\u4f1a\u600e\u4e48\u505a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u662f\u4e0b\u5348 2:30\u3002\u4f60\u5750\u5728\u8fa6\u516c\u684c\u524d\uff0c\u9677\u5165\u4e86\u5de8\u5927\u7684\u75b2\u52de\u3002\u4f60\u7684\u5927\u8166\u53ea\u5de5\u4f5c\u4e86 20\uff05\u3002\u4f60\u5728\u5e79\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.health.q1.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kippe mir sofort Kaffee oder einen Energydrink rein, um mich durchzupeitschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I immediately drink coffee or an energy drink to get me going."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente tomo caf\u00e9 o una bebida energ\u00e9tica para ponerme en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bois imm\u00e9diatement du caf\u00e9 ou une boisson \u00e9nergisante pour me relancer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0916\u0941\u0926 \u0915\u094b \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u0915\u0949\u092b\u0940 \u092f\u093e \u090f\u0928\u0930\u094d\u091c\u0940 \u0921\u094d\u0930\u093f\u0902\u0915 \u092a\u0940\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevo subito un caff\u00e8 o una bevanda energetica per rimettermi in moto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u30b3\u30fc\u30d2\u30fc\u3084\u30a8\u30ca\u30b8\u30fc\u30c9\u30ea\u30f3\u30af\u3092\u98f2\u3093\u3067\u5143\u6c17\u3092\u53d6\u308a\u623b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc989\uc2dc \uc5d0\ub108\uc9c0 \ub4dc\ub9c1\ud06c\ub098 \ucee4\ud53c\ub97c \ub9c8\uc2e0\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik drink meteen koffie of een energiedrankje om op gang te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od razu pij\u0119 kaw\u0119 lub nap\u00f3j energetyczny, \u017ceby mie\u0107 si\u0142\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebo imediatamente caf\u00e9 ou uma bebida energ\u00e9tica para me animar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043d\u0430\u043b\u0438\u0432\u0430\u044e \u0441\u0435\u0431\u0435 \u043a\u043e\u0444\u0435 \u0438\u043b\u0438 \u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043d\u0430\u043f\u0438\u0442\u043e\u043a, \u0447\u0442\u043e\u0431\u044b \u0441\u0435\u0431\u044f \u0432\u0437\u0431\u043e\u0434\u0440\u0438\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harekete ge\u00e7mek i\u00e7in hemen kahve ya da enerji i\u00e7ece\u011fi i\u00e7erim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u559d\u5496\u5561\u6216\u80fd\u91cf\u996e\u6599\u6765\u97ad\u7b56\u81ea\u5df1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u5373\u559d\u5496\u5561\u6216\u80fd\u91cf\u98f2\u6599\u4f86\u63d0\u795e\u3002"
          }
        }
      }
    },
    "assessment.health.q1.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich esse etwas S\u00fc\u00dfes, um schnell wieder Energie zu bekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I eat something sweet to quickly regain my energy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como algo dulce para recuperar r\u00e1pidamente mi energ\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mange quelque chose de sucr\u00e9 pour retrouver rapidement mon \u00e9nergie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091c\u0932\u094d\u0926\u0940 \u0938\u0947 \u0905\u092a\u0928\u0940 \u090a\u0930\u094d\u091c\u093e \u0935\u093e\u092a\u0938 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u092e\u0940\u0920\u093e \u0916\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangio qualcosa di dolce per ritrovare velocemente le energie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u56de\u5fa9\u3059\u308b\u305f\u3081\u306b\u7518\u3044\u3082\u306e\u3092\u98df\u3079\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube68\ub9ac \uae30\uc6b4\uc744 \ub418\ucc3e\uae30 \uc704\ud574 \ub2e8 \uac83\uc744 \uba39\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik eet iets zoets om snel weer energie te krijgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjadam co\u015b s\u0142odkiego, \u017ceby szybko odzyska\u0107 si\u0142y."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como algo doce para recuperar rapidamente minhas energias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0435\u043c \u0447\u0442\u043e-\u0442\u043e \u0441\u043b\u0430\u0434\u043a\u043e\u0435, \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0441\u0442\u0440\u043e \u0441\u043d\u043e\u0432\u0430 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u044d\u043d\u0435\u0440\u0433\u0438\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enerjimi h\u0131zla geri kazanmak i\u00e7in tatl\u0131 bir \u015feyler yerim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5403\u4e00\u4e9b\u751c\u7684\u4e1c\u897f\u6765\u5feb\u901f\u6062\u590d\u80fd\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5403\u4e00\u4e9b\u751c\u7684\u6771\u897f\u4f86\u5feb\u901f\u6062\u5fa9\u7cbe\u529b\u3002"
          }
        }
      }
    },
    "assessment.health.q1.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trinke 500ml Wasser, mache 15 Minuten einen Powernap oder bewege mich an der frischen Luft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I drink 500ml of water, take a 15-minute power nap or exercise in the fresh air."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebo 500 ml de agua, tomo una siesta de 15 minutos o hago ejercicio al aire libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bois 500 ml d'eau, je fais une sieste de 15 minutes ou je fais de l'exercice au grand air."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 500 \u092e\u093f\u0932\u0940\u0932\u0940\u091f\u0930 \u092a\u093e\u0928\u0940 \u092a\u0940\u0924\u093e \u0939\u0942\u0902, 15 \u092e\u093f\u0928\u091f \u0915\u0940 \u091d\u092a\u0915\u0940 \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u092f\u093e \u0924\u093e\u091c\u0940 \u0939\u0935\u093e \u092e\u0947\u0902 \u0935\u094d\u092f\u093e\u092f\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevo 500 ml di acqua, faccio un pisolino di 15 minuti o mi alleno all'aria aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "500ml\u306e\u6c34\u3092\u98f2\u307f\u300115\u5206\u9593\u306e\u4eee\u7720\u3092\u3068\u308b\u304b\u3001\u65b0\u9bae\u306a\u7a7a\u6c17\u306e\u4e2d\u3067\u904b\u52d5\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb3c 500ml\ub97c \ub9c8\uc2dc\uace0, 15\ubd84\uac04 \ub0ae\uc7a0\uc744 \uc790\uac70\ub098, \uc2e0\uc120\ud55c \uacf5\uae30\ub97c \ub9c8\uc2dc\uba70 \uc6b4\ub3d9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik drink 500 ml water, doe een powernap van 15 minuten of ga sporten in de frisse lucht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij\u0119 500ml wody, robi\u0119 sobie 15-minutow\u0105 drzemk\u0119 lub \u0107wicz\u0119 na \u015bwie\u017cym powietrzu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebo 500ml de \u00e1gua, tiro uma soneca revigorante de 15 minutos ou fa\u00e7o exerc\u00edcios ao ar livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u044c\u044e 500 \u043c\u043b \u0432\u043e\u0434\u044b, \u0434\u0435\u043b\u0430\u044e 15-\u043c\u0438\u043d\u0443\u0442\u043d\u044b\u0439 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0441\u043e\u043d \u0438\u043b\u0438 \u0434\u0432\u0438\u0433\u0430\u044e\u0441\u044c \u043d\u0430 \u0441\u0432\u0435\u0436\u0435\u043c \u0432\u043e\u0437\u0434\u0443\u0445\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "500 ml su i\u00e7erim, 15 dakika \u015fekerleme yapar\u0131m veya temiz havada egzersiz yapar\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u559d500\u6beb\u5347\u6c34\uff0c\u625315\u5206\u949f\u7684\u5348\u7761\uff0c\u6216\u8005\u5728\u65b0\u9c9c\u7a7a\u6c14\u4e2d\u6d3b\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u559d 500 \u6beb\u5347\u6c34\uff0c\u5c0f\u61a9 15 \u5206\u9418\uff0c\u6216\u5728\u65b0\u9bae\u7a7a\u6c23\u4e2d\u935b\u934a\u8eab\u9ad4\u3002"
          }
        }
      }
    },
    "assessment.health.q1.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich qu\u00e4le mich unproduktiv weiter und starre apathisch auf den Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I continue to torture myself unproductively and stare apathetically at the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigo tortur\u00e1ndome improductivamente y miro con apat\u00eda la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je continue \u00e0 me torturer de mani\u00e8re improductive et \u00e0 regarder l'\u00e9cran avec apathie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b \u0905\u0928\u0941\u0924\u094d\u092a\u093e\u0926\u0915 \u0930\u0942\u092a \u0938\u0947 \u092a\u094d\u0930\u0924\u093e\u0921\u093c\u093f\u0924 \u0915\u0930\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u094b \u0909\u0926\u093e\u0938\u0940\u0928\u0924\u093e \u0938\u0947 \u0926\u0947\u0916\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuo a torturarmi in modo improduttivo e fisso apaticamente lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u975e\u751f\u7523\u7684\u306b\u81ea\u5206\u3092\u82e6\u3057\u3081\u7d9a\u3051\u3001\u7121\u95a2\u5fc3\u306b\u753b\u9762\u3092\u898b\u3064\u3081\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uacc4\uc18d\ud574\uc11c \ub098 \uc790\uc2e0\uc744 \ube44\uc0dd\uc0b0\uc801\uc73c\ub85c \uace0\ubb38\ud558\uace0 \ubb34\uad00\uc2ec\ud558\uac8c \ud654\uba74\uc744 \uc751\uc2dc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf mezelf onproductief martelen en staar apathisch naar het scherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal bezproduktywnie si\u0119 torturuj\u0119 i apatycznie wpatruj\u0119 si\u0119 w ekran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuo a me torturar de forma improdutiva e a olhar apaticamente para a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u043c\u0443\u0447\u0438\u0442\u044c\u0441\u044f \u043d\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e \u0438 \u0430\u043f\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u043c\u043e\u0442\u0440\u044e \u043d\u0430 \u044d\u043a\u0440\u0430\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verimsizce kendime i\u015fkence etmeye ve kay\u0131ts\u0131zca ekrana bakmaya devam ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u65e0\u8c13\u5730\u7ee7\u7eed\u6298\u78e8\u81ea\u5df1\uff0c\u65e0\u7cbe\u6253\u91c7\u5730\u76ef\u7740\u5c4f\u5e55\u770b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7e7c\u7e8c\u6beb\u7121\u6210\u679c\u5730\u6298\u78e8\u81ea\u5df1\uff0c\u51b7\u6f20\u5730\u76ef\u8457\u87a2\u5e55\u3002"
          }
        }
      }
    },
    "assessment.health.q2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sieht deine allererste Handlung in den ersten 5 Minuten nach dem Aufwachen aus?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is your very first action in the first 5 minutes after waking up?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfCu\u00e1l es tu primera acci\u00f3n en los primeros 5 minutos despu\u00e9s de despertarte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est votre toute premi\u00e8re action dans les 5 premi\u00e8res minutes apr\u00e8s votre r\u00e9veil ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u093e\u0917\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092a\u0939\u0932\u0947 5 \u092e\u093f\u0928\u091f \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092a\u0939\u0932\u0940 \u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094d\u092f\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual \u00e8 la tua prima azione nei primi 5 minuti dopo il risveglio?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u671d\u8d77\u304d\u30665\u5206\u4ee5\u5185\u306b\u6700\u521d\u306b\u884c\u3046\u884c\u52d5\u306f\u4f55\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\uc5d0\uc11c \uae68\uc5b4\ub09c \ud6c4 5\ubd84 \ub3d9\uc548 \uac00\uc7a5 \uba3c\uc800 \ud558\ub294 \ud589\ub3d9\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is jouw allereerste actie in de eerste 5 minuten na het ontwaken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaka jest Twoja pierwsza czynno\u015b\u0107 w ci\u0105gu pierwszych 5 minut po przebudzeniu?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual \u00e9 a sua primeira a\u00e7\u00e3o nos primeiros 5 minutos depois de acordar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a\u043e\u0432\u043e \u0442\u0432\u043e\u0451 \u0441\u0430\u043c\u043e\u0435 \u043f\u0435\u0440\u0432\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u043f\u0435\u0440\u0432\u044b\u0435 5 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0431\u0443\u0436\u0434\u0435\u043d\u0438\u044f?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyand\u0131ktan sonraki ilk 5 dakikadaki ilk hareketiniz nedir?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u9192\u6765\u7684\u6700\u521d\u4e94\u5206\u949f\u5185\u505a\u7684\u7b2c\u4e00\u4ef6\u4e8b\u662f\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u5e8a\u5f8c 5 \u5206\u9418\u5167\u60a8\u7684\u7b2c\u4e00\u500b\u884c\u52d5\u662f\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.health.q2.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich dr\u00fccke 3-mal Snooze und zwinge mich im letzten Moment panisch aus dem Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I press snooze three times and force myself out of bed in a panic at the last moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiono el bot\u00f3n de repetici\u00f3n tres veces y me obligo a levantarme de la cama presa del p\u00e1nico en el \u00faltimo momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'appuie trois fois sur snooze et me force \u00e0 sortir du lit, paniqu\u00e9, au dernier moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0924\u0940\u0928 \u092c\u093e\u0930 \u0938\u094d\u0928\u0942\u091c\u093c \u0926\u092c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0906\u0916\u093f\u0930\u0940 \u0915\u094d\u0937\u0923 \u092e\u0947\u0902 \u0918\u092c\u0930\u093e\u0939\u091f \u092e\u0947\u0902 \u0916\u0941\u0926 \u0915\u094b \u092c\u093f\u0938\u094d\u0924\u0930 \u0938\u0947 \u0909\u0920\u093e \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premo snooze tre volte e all'ultimo momento mi costringo ad alzarmi dal letto in preda al panico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u30b9\u30cc\u30fc\u30ba\u30923\u56de\u62bc\u3057\u3001\u6700\u5f8c\u306e\u77ac\u9593\u306b\u30d1\u30cb\u30c3\u30af\u306b\u306a\u3063\u3066\u30d9\u30c3\u30c9\u304b\u3089\u5f37\u5236\u7684\u306b\u8d77\u304d\u4e0a\u304c\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc2a4\ub204\uc988 \ubc84\ud2bc\uc744 \uc138 \ubc88 \ub204\ub974\uace0 \ub9c8\uc9c0\ub9c9 \uc21c\uac04\uc5d0 \ud328\ub2c9 \uc0c1\ud0dc\uc5d0 \ube60\uc838 \uce68\ub300\uc5d0\uc11c \uac15\uc81c\ub85c \uc77c\uc5b4\ub0a9\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik druk drie keer op snooze en dwing mezelf op het laatste moment in paniek uit bed te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzykrotnie naciskam przycisk drzemki i w ostatniej chwili w panice zrywam si\u0119 z \u0142\u00f3\u017cka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperto soneca tr\u00eas vezes e me for\u00e7o a sair da cama em p\u00e2nico no \u00faltimo momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043d\u0430\u0436\u0438\u043c\u0430\u044e \u043f\u043e\u0432\u0442\u043e\u0440 \u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u043f\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u044b\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044e \u0441\u0435\u0431\u044f \u0438\u0437 \u043a\u0440\u043e\u0432\u0430\u0442\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dc\u00e7 kez ertele tu\u015funa bas\u0131yorum ve son anda panik i\u00e7inde kendimi yataktan kalkmaya zorluyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6309\u4e86\u4e09\u6b21\u8d2a\u7761\uff0c\u7136\u540e\u5728\u6700\u540e\u4e00\u523b\u60ca\u614c\u5730\u5f3a\u8feb\u81ea\u5df1\u8d77\u5e8a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u6700\u5f8c\u4e00\u523b\u9a5a\u614c\u5931\u63aa\u5730\u6309\u4e86\u4e09\u4e0b\u8caa\u7761\u9375\uff0c\u5f37\u8feb\u81ea\u5df1\u4e0b\u5e8a\u3002"
          }
        }
      }
    },
    "assessment.health.q2.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich greife blind zum Handy und scrolle 20 Minuten im Bett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I blindly pick up my phone and scroll in bed for 20 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cojo mi tel\u00e9fono a ciegas y me desplazo en la cama durante 20 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prends aveugl\u00e9ment mon t\u00e9l\u00e9phone et fais d\u00e9filer le lit pendant 20 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0906\u0902\u0916 \u092e\u0942\u0902\u0926\u0915\u0930 \u0905\u092a\u0928\u093e \u092b\u094b\u0928 \u0909\u0920\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 20 \u092e\u093f\u0928\u091f \u0924\u0915 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendo alla cieca il telefono e scorro sul letto per 20 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3084\u307f\u304f\u3082\u306b\u643a\u5e2f\u96fb\u8a71\u3092\u624b\u306b\u53d6\u308a\u3001\u30d9\u30c3\u30c9\u306e\u4e2d\u306720\u5206\u9593\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ubb34\uc791\uc815 \ud734\ub300\ud3f0\uc744 \ub4e4\uace0 \uce68\ub300\uc5d0\uc11c 20\ubd84 \ub3d9\uc548 \uc2a4\ud06c\ub864\uc744 \ub0b4\ub9b0\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik pak blindelings mijn telefoon en scroll 20 minuten in bed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na o\u015blep chwytam telefon i przewijam w \u0142\u00f3\u017cku przez 20 minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pego cegamente meu telefone e fico deitado na cama por 20 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043b\u0435\u043f\u043e \u0445\u0432\u0430\u0442\u0430\u044e \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u0438 \u043b\u0438\u0441\u0442\u0430\u044e \u043b\u0435\u043d\u0442\u0443 20 \u043c\u0438\u043d\u0443\u0442 \u0432 \u043f\u043e\u0441\u0442\u0435\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00f6r\u00fc k\u00f6r\u00fcne telefonumu al\u0131p 20 dakika boyunca yatakta dola\u015f\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u76f2\u76ee\u5730\u62ff\u8d77\u624b\u673a\uff0c\u5728\u5e8a\u4e0a\u6eda\u52a8\u4e8620\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u76f2\u76ee\u5730\u62ff\u8d77\u624b\u6a5f\uff0c\u5728\u5e8a\u4e0a\u5237\u4e8620\u5206\u9418\u3002"
          }
        }
      }
    },
    "assessment.health.q2.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stehe direkt auf, trinke Wasser und lasse Tageslicht in meine Augen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get up straight away, drink water and let daylight into my eyes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me levanto inmediatamente, bebo agua y dejo que la luz del d\u00eda entre en mis ojos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me l\u00e8ve aussit\u00f4t, bois de l'eau et laisse la lumi\u00e8re du jour entrer dans mes yeux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0924\u0941\u0930\u0902\u0924 \u0909\u0920\u0924\u093e \u0939\u0942\u0902, \u092a\u093e\u0928\u0940 \u092a\u0940\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0926\u093f\u0928 \u0915\u0940 \u0930\u094b\u0936\u0928\u0940 \u0905\u092a\u0928\u0940 \u0906\u0902\u0916\u094b\u0902 \u092e\u0947\u0902 \u0921\u093e\u0932\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alzo subito, bevo acqua e lascio entrare la luce del sole negli occhi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3059\u3050\u306b\u8d77\u304d\u3066\u6c34\u3092\u98f2\u307f\u3001\u65e5\u5149\u3092\u76ee\u306b\u5f53\u3066\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uace7\ubc14\ub85c \uc77c\uc5b4\ub098\uc11c \ubb3c\uc744 \ub9c8\uc2dc\uace0 \ud587\ube5b\uc744 \ub208\uc5d0 \ube44\ucda5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sta meteen op, drink water en laat daglicht in mijn ogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od razu wstaj\u0119, pij\u0119 wod\u0119 i wpuszczam \u015bwiat\u0142o dzienne do oczu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanto-me imediatamente, bebo \u00e1gua e deixo a luz do dia entrar em meus olhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u0441\u0442\u0430\u044e \u0441 \u043f\u043e\u0441\u0442\u0435\u043b\u0438, \u043f\u044c\u044e \u0432\u043e\u0434\u0443 \u0438 \u0432\u043f\u0443\u0441\u043a\u0430\u044e \u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u0441\u0432\u0435\u0442 \u0432 \u0433\u043b\u0430\u0437\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen kalk\u0131p su i\u00e7iyorum ve g\u00fcn \u0131\u015f\u0131\u011f\u0131n\u0131n g\u00f6zlerime girmesine izin veriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u76f4\u63a5\u7ad9\u8d77\u6765\uff0c\u559d\u6c34\uff0c\u8ba9\u65e5\u5149\u7167\u8fdb\u6211\u7684\u773c\u775b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u8d77\u5e8a\uff0c\u559d\u6c34\uff0c\u8b93\u967d\u5149\u9032\u5165\u6211\u7684\u773c\u775b\u3002"
          }
        }
      }
    },
    "assessment.health.q2.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich brauche sofort Kaffee, sonst bin ich nicht ansprechbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need coffee immediately, otherwise I won't be available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesito caf\u00e9 inmediatamente, de lo contrario no estar\u00e9 disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai besoin de caf\u00e9 imm\u00e9diatement, sinon je ne serai pas disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0941\u091d\u0947 \u0924\u0941\u0930\u0902\u0924 \u0915\u0949\u092b\u093c\u0940 \u091a\u093e\u0939\u093f\u090f, \u0905\u0928\u094d\u092f\u0925\u093e \u092e\u0948\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u094b \u092a\u093e\u090a\u0901\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho bisogno di caff\u00e8 immediatamente, altrimenti non sar\u00f2 disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u30b3\u30fc\u30d2\u30fc\u304c\u5fc5\u8981\u3067\u3059\u3002\u305d\u3046\u3067\u306a\u3044\u3068\u5bfe\u5fdc\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uae08 \ub2f9\uc7a5 \ucee4\ud53c\uac00 \ud544\uc694\ud574\uc694. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uc2dc\uac04\uc774 \uc5c6\uc5b4\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb onmiddellijk koffie nodig, anders ben ik niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebuj\u0119 kawy natychmiast, inaczej nie b\u0119d\u0119 dost\u0119pny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preciso de caf\u00e9 imediatamente, caso contr\u00e1rio n\u00e3o estarei dispon\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043d\u0435 \u0441\u0440\u043e\u0447\u043d\u043e \u043d\u0443\u0436\u0435\u043d \u043a\u043e\u0444\u0435, \u0438\u043d\u0430\u0447\u0435 \u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0434\u043b\u044f \u043e\u0431\u0449\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen kahveye ihtiyac\u0131m var, yoksa m\u00fcsait olamayaca\u011f\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u523b\u9700\u8981\u5496\u5561\uff0c\u5426\u5219\u6211\u65e0\u6cd5\u4ea4\u6d41\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u99ac\u4e0a\u9700\u8981\u5496\u5561\uff0c\u5426\u5247\u6c92\u7a7a\u3002"
          }
        }
      }
    },
    "assessment.health.q3": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du f\u00fchlst dich extrem schwach, hast Halskratzen und leichtes Fieber. Eigentlich steht heute ein hartes Workout oder eine lange Lernsession an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You feel extremely weak, have a sore throat and a mild fever. Actually, today is a hard workout or a long study session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se siente extremadamente d\u00e9bil, tiene dolor de garganta y fiebre leve. En realidad, hoy es un duro entrenamiento o una larga sesi\u00f3n de estudio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous sentez extr\u00eamement faible, vous avez mal \u00e0 la gorge et une l\u00e9g\u00e8re fi\u00e8vre. En fait, aujourd\u2019hui c\u2019est un entra\u00eenement intensif ou une longue s\u00e9ance d\u2019\u00e9tude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0915\u092e\u091c\u094b\u0930\u0940 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0917\u0932\u0947 \u092e\u0947\u0902 \u0916\u0930\u093e\u0936 \u0914\u0930 \u0939\u0932\u094d\u0915\u093e \u092c\u0941\u0916\u093e\u0930 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0926\u0930\u0905\u0938\u0932, \u0906\u091c \u0939\u093e\u0930\u094d\u0921 \u0935\u0930\u094d\u0915\u0906\u0909\u091f \u092f\u093e \u0932\u0902\u092c\u093e \u0938\u094d\u091f\u0921\u0940 \u0938\u0947\u0936\u0928 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti senti estremamente debole, hai mal di gola e una leggera febbre. In realt\u00e0, oggi \u00e8 un duro allenamento o una lunga sessione di studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6975\u5ea6\u306b\u8870\u5f31\u3057\u3001\u5589\u306e\u75db\u307f\u3068\u8efd\u3044\u767a\u71b1\u304c\u3042\u308a\u307e\u3059\u3002\u5b9f\u306f\u4eca\u65e5\u306f\u30cf\u30fc\u30c9\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u304b\u9577\u6642\u9593\u306e\u52c9\u5f37\u4f1a\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubab8\uc774 \uadf9\ub3c4\ub85c \ud5c8\uc57d\ud574\uc9c0\uace0, \ubaa9\uc774 \uc544\ud504\uace0 \ubbf8\uc5f4\uc774 \ub0a9\ub2c8\ub2e4. \uc0ac\uc2e4 \uc624\ub298\uc740 \ud798\ub4e0 \uc6b4\ub3d9\uc774\uac70\ub098 \uae34 \uacf5\ubd80 \uc2dc\uac04\uc774\uc5d0\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U voelt zich extreem zwak, heeft keelpijn en lichte koorts. Eigenlijk is het vandaag een zware training of een lange studiesessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czujesz si\u0119 wyj\u0105tkowo os\u0142abiony, masz b\u00f3l gard\u0142a i lekk\u0105 gor\u0105czk\u0119. W\u0142a\u015bciwie dzisiaj jest ci\u0119\u017cki trening lub d\u0142uga sesja naukowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea se sente extremamente fraco, com dor de garganta e febre baixa. Na verdade, hoje \u00e9 um treino intenso ou uma longa sess\u00e3o de estudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u0441\u0435\u0431\u044f \u043a\u0440\u0430\u0439\u043d\u0435 \u0441\u043b\u0430\u0431\u044b\u043c, \u0443 \u0442\u0435\u0431\u044f \u043f\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u0432 \u0433\u043e\u0440\u043b\u0435 \u0438 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430. \u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b\u0442\u044c \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0435 \u0437\u0430\u043d\u044f\u0442\u0438\u0435 \u0441\u043f\u043e\u0440\u0442\u043e\u043c \u0438\u043b\u0438 \u0434\u043e\u043b\u0433\u0438\u0439 \u0443\u0447\u0435\u0431\u043d\u044b\u0439 \u0441\u0435\u0430\u043d\u0441."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinizi a\u015f\u0131r\u0131 derecede zay\u0131f hissediyorsunuz, bo\u011faz a\u011fr\u0131n\u0131z var ve hafif ate\u015finiz var. Asl\u0131nda bug\u00fcn zorlu bir antrenman ya da uzun bir \u00e7al\u0131\u015fma seans\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u611f\u89c9\u975e\u5e38\u865a\u5f31\uff0c\u5589\u5499\u53d1\u75d2\uff0c\u8fd8\u6709\u8f7b\u5fae\u53d1\u70e7\u3002\u4eca\u5929\u672c\u6765\u8ba1\u5212\u8fdb\u884c\u4e00\u6b21\u9ad8\u5f3a\u5ea6\u953b\u70bc\u6216\u957f\u65f6\u95f4\u5b66\u4e60\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u611f\u89ba\u6975\u5ea6\u865b\u5f31\u3001\u5589\u56a8\u75db\u548c\u8f15\u5fae\u767c\u71d2\u3002\u4e8b\u5be6\u4e0a\uff0c\u4eca\u5929\u662f\u8271\u82e6\u7684\u935b\u934a\u6216\u9577\u6642\u9593\u7684\u5b78\u7fd2\u3002"
          }
        }
      }
    },
    "assessment.health.q3.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ziehe es durch. 'No Pain, No Gain'. Krankheit ist nur im Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll go through with it. 'No pain no gain'. Illness is only in the mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo har\u00e9. 'Sin dolor no hay ganancia'. La enfermedad est\u00e1 s\u00f3lo en la mente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais aller jusqu'au bout. 'On a rien sans rien'. La maladie est seulement dans l'esprit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0907\u0938\u0947 \u0932\u0947\u0915\u0930 \u091a\u0932\u0942\u0902\u0917\u093e. '\u092c\u093f\u0928\u093e \u0915\u0937\u094d\u091f \u0915\u093f\u092f\u0947 \u092b\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e'\u0964 \u092c\u0940\u092e\u093e\u0930\u0940 \u0938\u093f\u0930\u094d\u092b \u0926\u093f\u092e\u093e\u0917 \u092e\u0947\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo far\u00f2 fino in fondo. 'Nessun dolore nessun guadagno'. La malattia \u00e8 solo nella mente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3084\u308a\u9042\u3052\u307e\u3059\u3002 '\u75db\u307f\u306a\u304f\u3057\u3066\u5f97\u308b\u3082\u306e\u306a\u3057'\u3002\u75c5\u6c17\u306f\u5fc3\u306e\u4e2d\u306b\u3060\u3051\u3042\u308b\u306e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\uac00 \ucc98\ub9ac\ud560\uac8c. '\uace0\ud1b5\uc774 \uc5c6\uc73c\uba74 \uc774\ub4dd\ub3c4 \uc5c6\ub2e4'. \uc9c8\ubcd1\uc740 \ub9c8\uc74c\uc5d0\ub9cc \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga ermee door. 'Geen pijn, geen winst'. Ziekte zit alleen in de geest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejd\u0119 przez to. \u201eBez b\u00f3lu nie ma zysku\u201d. Choroba jest tylko w umy\u015ble."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu vou em frente com isso. 'Sem dor sem ganho'. A doen\u00e7a est\u00e1 apenas na mente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0434\u043e\u0432\u0435\u0434\u0443 \u044d\u0442\u043e \u0434\u043e \u043a\u043e\u043d\u0446\u0430. '\u041d\u0435\u0442 \u0431\u043e\u043b\u0438, \u043d\u0435\u0442 \u0432\u044b\u0433\u043e\u0434\u044b'. \u0411\u043e\u043b\u0435\u0437\u043d\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0433\u043e\u043b\u043e\u0432\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu halledece\u011fim. 'Emeksiz yemek olmaz'. Hastal\u0131k yaln\u0131zca zihindedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4f1a\u575a\u6301\u5230\u5e95\u3002\u201c\u6ca1\u6709\u75db\u82e6\u5c31\u6ca1\u6709\u6536\u83b7\u201d\u3002\u75be\u75c5\u53ea\u662f\u5fc3\u7406\u4e0a\u7684\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u5b8c\u6210\u5b83\u3002 \u300c\u6c92\u6709\u75db\u82e6\u5c31\u6c92\u6709\u6536\u7a6b\u300d\u3002\u75be\u75c5\u53ea\u5b58\u5728\u65bc\u982d\u8166\u4e2d\u3002"
          }
        }
      }
    },
    "assessment.health.q3.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werfe Schmerzmittel ein, um die Symptome zu unterdr\u00fccken, und funktioniere weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I pop painkillers to suppress the symptoms and continue to function."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomo analg\u00e9sicos para suprimir los s\u00edntomas y seguir funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prends des analg\u00e9siques pour supprimer les sympt\u00f4mes et continuer \u00e0 fonctionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0932\u0915\u094d\u0937\u0923\u094b\u0902 \u0915\u094b \u0926\u092c\u093e\u0928\u0947 \u0914\u0930 \u0915\u093e\u092e \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u0930\u094d\u0926 \u0928\u093f\u0935\u093e\u0930\u0915 \u0926\u0935\u093e\u090f\u0902 \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendo antidolorifici per sopprimere i sintomi e continuare a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u75c7\u72b6\u3092\u6291\u3048\u3066\u4ed5\u4e8b\u3092\u7d9a\u3051\u308b\u305f\u3081\u306b\u93ae\u75db\u5264\u3092\u98f2\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc99d\uc0c1\uc744 \uc5b5\uc81c\ud558\uace0 \uae30\ub2a5\uc744 \uacc4\uc18d\ud558\uae30 \uc704\ud574 \uc9c4\ud1b5\uc81c\ub97c \ud130\ub728\ub9bd\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik gebruik pijnstillers om de symptomen te onderdrukken en te blijven functioneren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bior\u0119 leki przeciwb\u00f3lowe, \u017ceby st\u0142umi\u0107 objawy i dalej funkcjonowa\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomo analg\u00e9sicos para suprimir os sintomas e continuar a funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0430\u0432\u0438\u0442\u044c \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semptomlar\u0131 bast\u0131rmak ve \u00e7al\u0131\u015fmaya devam etmek i\u00e7in a\u011fr\u0131 kesici kullan\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u670d\u7528\u6b62\u75db\u836f\u6765\u6291\u5236\u75c7\u72b6\uff0c\u5e76\u7ee7\u7eed\u8fd0\u4f5c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u670d\u7528\u6b62\u75db\u85e5\u4f86\u6291\u5236\u75c7\u72c0\u4e26\u7e7c\u7e8c\u767c\u63ee\u4f5c\u7528\u3002"
          }
        }
      }
    },
    "assessment.health.q3.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage alles ab, lege mich sofort ins Bett und lasse den K\u00f6rper reparieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cancel everything, go to bed immediately and have my body repaired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelo todo, me acuesto inmediatamente y hago reparar mi cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'annule tout, je me couche imm\u00e9diatement et je fais r\u00e9parer mon corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u092c \u0915\u0941\u091b \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902, \u0924\u0941\u0930\u0902\u0924 \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u0940 \u092e\u0930\u092e\u094d\u092e\u0924 \u0915\u0930\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullo tutto, vado subito a letto e faccio riparare il mio corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u3001\u3059\u3050\u306b\u5bdd\u3066\u4f53\u3092\u4fee\u5fa9\u3057\u3066\u3082\u3089\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4 \ucde8\uc18c\ud558\uace0 \ubc14\ub85c \uc7a0\uc790\ub9ac\uc5d0 \ub4e4\uace0 \ubab8\uc744 \uc218\ub9ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik annuleer alles, ga direct naar bed en laat mijn lichaam repareren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odwo\u0142uj\u0119 wszystko, natychmiast id\u0119 spa\u0107 i regeneruj\u0119 swoje cia\u0142o."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelo tudo, vou para a cama imediatamente e mando consertar meu corpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0442\u043c\u0435\u043d\u044f\u044e \u0432\u0441\u0435 \u0434\u0435\u043b\u0430, \u0441\u0440\u0430\u0437\u0443 \u043b\u043e\u0436\u0443\u0441\u044c \u0432 \u043a\u0440\u043e\u0432\u0430\u0442\u044c \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e \u0442\u0435\u043b\u0443 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her \u015feyi iptal ediyorum, hemen yat\u0131yorum ve v\u00fccudumu onar\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53d6\u6d88\u6240\u6709\u8ba1\u5212\uff0c\u7acb\u523b\u4e0a\u5e8a\u7761\u89c9\uff0c\u8ba9\u8eab\u4f53\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53d6\u6d88\u4e00\u5207\uff0c\u7acb\u5373\u4e0a\u5e8a\u7761\u89ba\uff0c\u4fee\u5fa9\u8eab\u9ad4\u3002"
          }
        }
      }
    },
    "assessment.health.q3.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich mache es nur 'ein bisschen' und verschleppe die Erk\u00e4ltung dadurch wochenlang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I only do it 'a little bit' and it puts off the cold for weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo s\u00f3lo lo hago 'un poquito' y aguanta el fr\u00edo durante semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne le fais que \u00ab un peu \u00bb et \u00e7a repousse le froid pendant des semaines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0907\u0938\u0947 \u0915\u0947\u0935\u0932 '\u0925\u094b\u0921\u093c\u093e-\u0938\u093e' \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0907\u0938\u0938\u0947 \u0915\u0908 \u0939\u092b\u094d\u0924\u094b\u0902 \u0924\u0915 \u0938\u0930\u094d\u0926\u0940 \u0926\u0942\u0930 \u0930\u0939\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo faccio solo \"un po'\" e allontana il raffreddore per settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u307b\u3093\u306e\u5c11\u3057\u300d\u3084\u308b\u3060\u3051\u3067\u3001\u6570\u9031\u9593\u306f\u98a8\u90aa\u304c\u6cbb\u307e\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'\uc870\uae08'\ub9cc \ud558\uba74 \uba87 \uc8fc \ub3d9\uc548 \uac10\uae30\uac00 \ub0ab\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik doe het maar 'een klein beetje' en het houdt de kou wekenlang tegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Robi\u0119 to tylko \u201etroch\u0119\u201d i to odstrasza przezi\u0119bienie na tygodnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu s\u00f3 fa\u00e7o isso 'um pouquinho' e adia o frio por semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0434\u0435\u043b\u0430\u044e \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e '\u043d\u0435\u043c\u043d\u043e\u0433\u043e' \u0438 \u0442\u0435\u043c \u0441\u0430\u043c\u044b\u043c \u0437\u0430\u0442\u044f\u0433\u0438\u0432\u0430\u044e \u043f\u0440\u043e\u0441\u0442\u0443\u0434\u0443 \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu sadece 'biraz' yap\u0131yorum ve so\u011fu\u011fu haftalarca erteliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u662f\u505a\u4e00\u70b9\u70b9\uff0c\u56e0\u6b64\u628a\u611f\u5192\u62d6\u4e86\u597d\u51e0\u4e2a\u661f\u671f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u505a\u201c\u4e00\u9ede\u9ede\u201d\uff0c\u5c31\u80fd\u8b93\u611f\u5192\u63a8\u9072\u6578\u9031\u3002"
          }
        }
      }
    },
    "assessment.health.q4": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist extrem hungrig, hast nichts vorbereitet und bist unterwegs. Vor dir ist ein Fast-Food-Laden und ein Supermarkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are extremely hungry, have nothing prepared and are on the move. In front of you is a fast food shop and a supermarket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes mucha hambre, no tienes nada preparado y est\u00e1s en movimiento. Frente a ti hay una tienda de comida r\u00e1pida y un supermercado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez extr\u00eamement faim, vous n\u2019avez rien pr\u00e9par\u00e9 et vous \u00eates en d\u00e9placement. En face de vous se trouvent un fast food et un supermarch\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092c\u0939\u0941\u0924 \u092d\u0942\u0916\u0947 \u0939\u0948\u0902, \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0915\u0941\u091b \u092d\u0940 \u0924\u0948\u092f\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u0906\u092a \u0906\u0917\u0947 \u092c\u0922\u093c \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u090f\u0915 \u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921 \u0915\u0940 \u0926\u0941\u0915\u093e\u0928 \u0914\u0930 \u090f\u0915 \u0938\u0941\u092a\u0930\u092e\u093e\u0930\u094d\u0915\u0947\u091f \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei estremamente affamato, non hai nulla di preparato e sei in movimento. Di fronte a te c'\u00e8 un fast food e un supermercato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u975e\u5e38\u306b\u304a\u8179\u304c\u7a7a\u3044\u3066\u304a\u308a\u3001\u4f55\u3082\u6e96\u5099\u3057\u3066\u304a\u3089\u305a\u3001\u79fb\u52d5\u4e2d\u3067\u3059\u3002\u76ee\u306e\u524d\u306b\u306f\u30d5\u30a1\u30fc\u30b9\u30c8\u30d5\u30fc\u30c9\u5e97\u3068\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uadf9\ub3c4\ub85c \ubc30\uac00 \uace0\ud504\uace0 \uc544\ubb34\uac83\ub3c4 \uc900\ube44\ud558\uc9c0 \uc54a\uc740 \ucc44 \uc774\ub3d9 \uc911\uc785\ub2c8\ub2e4. \ub208\uc55e\uc5d0\ub294 \ud328\uc2a4\ud2b8\ud478\ub4dc\uc810\uacfc \uc288\ud37c\ub9c8\ucf13\uc774 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt enorme honger, hebt niets voorbereid en bent onderweg. Voor je is een fastfoodwinkel en een supermarkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b bardzo g\u0142odny, nie masz nic przygotowanego i jeste\u015b w ruchu. Naprzeciwko znajduje si\u0119 fast food i supermarket."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 com muita fome, n\u00e3o tem nada preparado e est\u00e1 em movimento. \u00c0 sua frente h\u00e1 uma loja de fast food e um supermercado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043e\u0447\u0435\u043d\u044c \u0433\u043e\u043b\u043e\u0434\u0435\u043d, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u0438\u043b \u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u0448\u044c\u0441\u044f \u0432 \u043f\u0443\u0442\u0438. \u041f\u0435\u0440\u0435\u0434 \u0442\u043e\u0431\u043e\u0439 \u0444\u0430\u0441\u0442\u0444\u0443\u0434 \u0438 \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son derece a\u00e7s\u0131n\u0131z, hi\u00e7bir haz\u0131rl\u0131\u011f\u0131n\u0131z yok ve hareket halindesiniz. \u00d6n\u00fcn\u00fczde bir fast food d\u00fckkan\u0131 ve bir s\u00fcpermarket var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u975e\u5e38\u997f\uff0c\u6ca1\u6709\u51c6\u5907\u4efb\u4f55\u4e1c\u897f\uff0c\u5e76\u4e14\u5728\u5916\u9762\u3002\u4f60\u9762\u524d\u6709\u4e00\u5bb6\u5feb\u9910\u5e97\u548c\u4e00\u5bb6\u8d85\u5e02\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u975e\u5e38\u9913\uff0c\u6c92\u6709\u6e96\u5099\u4efb\u4f55\u6771\u897f\uff0c\u6b63\u5728\u79fb\u52d5\u3002\u4f60\u9762\u524d\u662f\u4e00\u5bb6\u5feb\u9910\u5e97\u548c\u4e00\u5bb6\u8d85\u5e02\u3002"
          }
        }
      }
    },
    "assessment.health.q4.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast Food. Es muss jetzt sofort gehen und ich brauche Kalorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food. It has to happen now and I need calories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comida r\u00e1pida. Tiene que suceder ahora y necesito calor\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauration rapide. Cela doit arriver maintenant et j\u2019ai besoin de calories."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093e\u0938\u094d\u091f \u092b\u0942\u0921\u0964 \u092f\u0939 \u0905\u092c \u0939\u094b\u0928\u093e \u0939\u0940 \u0939\u0948 \u0914\u0930 \u092e\u0941\u091d\u0947 \u0915\u0948\u0932\u094b\u0930\u0940 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948\u0964'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food. Deve succedere adesso e ho bisogno di calorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30fc\u30b9\u30c8\u30d5\u30fc\u30c9\u3002\u4eca\u3059\u3050\u306b\u3084\u3089\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3057\u3001\u30ab\u30ed\u30ea\u30fc\u304c\u5fc5\u8981\u3060\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud328\uc2a4\ud2b8\ud478\ub4dc. \uc9c0\uae08 \uc77c\uc5b4\ub098\uc57c\ud558\uace0 \uce7c\ub85c\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastfood. Het moet nu gebeuren en ik heb calorie\u00ebn nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food. To musi si\u0119 wydarzy\u0107 teraz, a ja potrzebuj\u0119 kalorii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comida r\u00e1pida. Tem que acontecer agora e preciso de calorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0441\u0442\u0444\u0443\u0434. \u042d\u0442\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441, \u0438 \u043c\u043d\u0435 \u043d\u0443\u0436\u043d\u044b \u043a\u0430\u043b\u043e\u0440\u0438\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast food. Bunun \u015fimdi olmas\u0131 gerekiyor ve kaloriye ihtiyac\u0131m var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5feb\u9910\u3002\u6211\u73b0\u5728\u5fc5\u987b\u7acb\u523b\u5403\uff0c\u800c\u4e14\u6211\u9700\u8981\u70ed\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901f\u98df.\u73fe\u5728\u5c31\u5fc5\u9808\u767c\u751f\uff0c\u6211\u9700\u8981\u5361\u8def\u91cc\u3002"
          }
        }
      }
    },
    "assessment.health.q4.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich hole mir im Supermarkt ein Geb\u00e4ck oder einen Snack vom B\u00e4cker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get a pastry or a snack from the bakery at the supermarket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro un pastelillo o un snack en la panader\u00eda del supermercado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je re\u00e7ois une p\u00e2tisserie ou un snack \u00e0 la boulangerie du supermarch\u00e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0941\u091d\u0947 \u0938\u0941\u092a\u0930\u092e\u093e\u0930\u094d\u0915\u0947\u091f \u092e\u0947\u0902 \u092c\u0947\u0915\u0930\u0940 \u0938\u0947 \u092a\u0947\u0938\u094d\u091f\u094d\u0930\u0940 \u092f\u093e \u0938\u094d\u0928\u0948\u0915 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendo un dolce o uno spuntino dal panificio al supermercato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30fc\u30d1\u30fc\u306e\u30d1\u30f3\u5c4b\u3067\u30da\u30b9\u30c8\u30ea\u30fc\u3084\u30b9\u30ca\u30c3\u30af\u3092\u8cb7\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc288\ud37c\ub9c8\ucf13 \ube75\uc9d1\uc5d0\uc11c \ud398\uc774\uc2a4\ud2b8\ub9ac\ub098 \uac04\uc2dd\uc744 \uc0ac\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik haal een gebakje of een snack bij de bakker in de supermarkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaj\u0119 ciasto lub przek\u0105sk\u0119 z piekarni w supermarkecie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pego um doce ou um lanche na padaria do supermercado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u043e\u0437\u044c\u043c\u0443 \u0432 \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442\u0435 \u0432\u044b\u043f\u0435\u0447\u043a\u0443 \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u043a\u0443\u0441 \u0443 \u043f\u0435\u043a\u0430\u0440\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00fcpermarketteki f\u0131r\u0131ndan hamur i\u015fi veya at\u0131\u015ft\u0131rmal\u0131k al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u8d85\u5e02\u4e70\u4e00\u4e9b\u7cd5\u70b9\u6216\u4ece\u9762\u5305\u5e97\u4e70\u4e00\u4e9b\u5c0f\u5403\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5f9e\u8d85\u5e02\u7684\u9eb5\u5305\u5e97\u8cb7\u7cd5\u9ede\u6216\u5c0f\u5403\u3002"
          }
        }
      }
    },
    "assessment.health.q4.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich gehe in den Supermarkt und hole mir N\u00fcsse, Obst oder einen Protein-Snack."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I go to the supermarket and get nuts, fruit or a protein snack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voy al supermercado y compro frutos secos, fruta o un snack proteico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais au supermarch\u00e9 et j'ach\u00e8te des noix, des fruits ou une collation prot\u00e9in\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u0941\u092a\u0930\u092e\u093e\u0930\u094d\u0915\u0947\u091f \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0928\u091f\u094d\u0938, \u092b\u0932 \u092f\u093e \u092a\u094d\u0930\u094b\u091f\u0940\u0928 \u0938\u094d\u0928\u0948\u0915 \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vado al supermercato e prendo noci, frutta o uno spuntino proteico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30fc\u30d1\u30fc\u306b\u884c\u3063\u3066\u30ca\u30c3\u30c4\u3001\u30d5\u30eb\u30fc\u30c4\u3001\u30d7\u30ed\u30c6\u30a4\u30f3\u30b9\u30ca\u30c3\u30af\u306a\u3069\u3092\u8cb7\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc288\ud37c\ub9c8\ucf13\uc5d0 \uac00\uc11c \uacac\uacfc\ub958, \uacfc\uc77c, \ub2e8\ubc31\uc9c8 \uac04\uc2dd\uc744 \uc0ac\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ga naar de supermarkt en haal noten, fruit of een eiwitsnack."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Id\u0119 do supermarketu i kupuj\u0119 orzechy, owoce lub przek\u0105sk\u0119 bia\u0142kow\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou ao supermercado e compro nozes, frutas ou um lanche proteico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0438\u0434\u0443 \u0432 \u0441\u0443\u043f\u0435\u0440\u043c\u0430\u0440\u043a\u0435\u0442 \u0438 \u0431\u0435\u0440\u0443 \u0441\u0435\u0431\u0435 \u043e\u0440\u0435\u0445\u0438, \u0444\u0440\u0443\u043a\u0442\u044b \u0438\u043b\u0438 \u043f\u0440\u043e\u0442\u0435\u0438\u043d\u043e\u0432\u044b\u0439 \u043f\u0435\u0440\u0435\u043a\u0443\u0441."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00fcpermarkete gidiyorum ve f\u0131nd\u0131k, meyve ya da proteinli at\u0131\u015ft\u0131rmal\u0131k al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53bb\u8d85\u5e02\uff0c\u4e70\u4e00\u4e9b\u575a\u679c\u3001\u6c34\u679c\u6216\u4e00\u4efd\u86cb\u767d\u5c0f\u5403\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53bb\u8d85\u5e02\u8cb7\u5805\u679c\u3001\u6c34\u679c\u6216\u86cb\u767d\u8cea\u96f6\u98df\u3002"
          }
        }
      }
    },
    "assessment.health.q4.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich hungere stundenlang weiter, bis meine Laune komplett im Keller ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I continue to starve for hours until my mood is completely ruined."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigo muriendo de hambre durante horas hasta que mi estado de \u00e1nimo se arruina por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je continue \u00e0 mourir de faim pendant des heures jusqu'\u00e0 ce que mon humeur soit compl\u00e8tement ruin\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0918\u0902\u091f\u094b\u0902 \u0924\u0915 \u092d\u0942\u0916\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902 \u091c\u092c \u0924\u0915 \u092e\u0947\u0930\u093e \u092e\u0942\u0921 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0916\u0930\u093e\u092c \u0928\u0939\u0940\u0902 \u0939\u094b \u091c\u093e\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuo a morire di fame per ore finch\u00e9 il mio umore non \u00e8 completamente rovinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c17\u5206\u304c\u5b8c\u5168\u306b\u53f0\u7121\u3057\u306b\u306a\u308b\u307e\u3067\u3001\u4f55\u6642\u9593\u3082\u98e2\u3048\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uae30\ubd84\uc774 \uc644\uc804\ud788 \ub9dd\uac00\uc9c8 \ub54c\uae4c\uc9c0 \uba87 \uc2dc\uac04 \ub3d9\uc548 \uacc4\uc18d \uad76\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf urenlang verhongeren totdat mijn humeur volledig verpest is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal g\u0142oduj\u0119 godzinami, a\u017c m\u00f3j nastr\u00f3j zostanie ca\u0142kowicie zrujnowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuo morrendo de fome por horas at\u00e9 que meu humor esteja completamente arruinado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u043e\u043b\u043e\u0434\u0430\u044e \u0447\u0430\u0441\u044b \u043d\u0430\u043f\u0440\u043e\u043b\u0451\u0442, \u043f\u043e\u043a\u0430 \u043c\u043e\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435 \u043d\u0435 \u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0441\u044f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0432 \u043f\u043e\u0434\u0432\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruh halim tamamen bozulana kadar saatlerce a\u00e7 kalmaya devam ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6301\u7eed\u997f\u4e86\u597d\u51e0\u4e2a\u5c0f\u65f6\uff0c\u76f4\u5230\u6211\u7684\u5fc3\u60c5\u5b8c\u5168\u8dcc\u5230\u8c37\u5e95\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7e7c\u7e8c\u6328\u9913\u5e7e\u500b\u5c0f\u6642\uff0c\u76f4\u5230\u6211\u7684\u5fc3\u60c5\u5b8c\u5168\u5d29\u6f70\u3002"
          }
        }
      }
    },
    "assessment.health.q5": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist Zeit zum Schlafen. Du liegst im Bett. Wo ist dein Smartphone?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's time to sleep. You're lying in bed. Where is your smartphone?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hora de dormir. Est\u00e1s acostado en la cama. \u00bfD\u00f3nde est\u00e1 tu tel\u00e9fono inteligente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est temps de dormir. Vous \u00eates allong\u00e9 dans votre lit. O\u00f9 est ton smartphone ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094b\u0928\u0947 \u0915\u093e \u0938\u092e\u092f \u0939\u094b \u0917\u092f\u093e \u0939\u0948. \u0924\u0941\u092e \u092c\u093f\u0938\u094d\u0924\u0930 \u092a\u0930 \u0932\u0947\u091f\u0947 \u0939\u094b. \u0906\u092a\u0915\u093e \u0938\u094d\u092e\u093e\u0930\u094d\u091f\u092b\u093c\u094b\u0928 \u0915\u0939\u093e\u0901 \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E' ora di dormire. Sei sdraiato a letto. Dov'\u00e8 il tuo smartphone?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bdd\u308b\u6642\u9593\u3067\u3059\u3002\u3042\u306a\u305f\u306f\u30d9\u30c3\u30c9\u306b\u6a2a\u305f\u308f\u3063\u3066\u3044\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u306f\u3069\u3053\u306b\u3042\u308a\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\uc81c \uc7a0\uc744 \uc798 \uc2dc\uac04\uc774\ub2e4. \ub2f9\uc2e0\uc740 \uce68\ub300\uc5d0 \ub204\uc6cc\uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc758 \uc2a4\ub9c8\ud2b8\ud3f0\uc740 \uc5b4\ub514\uc5d0 \uc788\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is tijd om te slapen. Je ligt in bed. Waar is je smartphone?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas spa\u0107. Le\u017cysz w \u0142\u00f3\u017cku. Gdzie jest Tw\u00f3j smartfon?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9 hora de dormir. Voc\u00ea est\u00e1 deitado na cama. Onde est\u00e1 seu smartphone?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0440\u0430 \u0441\u043f\u0430\u0442\u044c. \u0422\u044b \u043b\u0435\u0436\u0438\u0448\u044c \u0432 \u043a\u0440\u043e\u0432\u0430\u0442\u0438. \u0413\u0434\u0435 \u0442\u0432\u043e\u0439 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyuma zaman\u0131 geldi. Yatakta yat\u0131yorsun. Ak\u0131ll\u0131 telefonun nerede?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u662f\u65f6\u5019\u7761\u89c9\u4e86\u3002\u4f60\u8eba\u5728\u5e8a\u4e0a\u3002\u4f60\u7684\u667a\u80fd\u624b\u673a\u5728\u54ea\u91cc\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u662f\u6642\u5019\u7761\u89ba\u4e86\u3002\u4f60\u8eba\u5728\u5e8a\u4e0a\u3002\u4f60\u7684\u667a\u6167\u578b\u624b\u6a5f\u5728\u54ea\u88e1\uff1f"
          }
        }
      }
    },
    "assessment.health.q5.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In meiner Hand. Ich scrolle, bis mir das Ger\u00e4t aufs Gesicht f\u00e4llt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In my hand. I scroll until the device falls on my face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En mi mano. Me desplazo hasta que el dispositivo cae sobre mi cara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ma main. Je fais d\u00e9filer jusqu'\u00e0 ce que l'appareil me tombe sur le visage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0947\u0930\u0947 \u0939\u093e\u0925 \u092e\u0947\u0901\u0964 \u092e\u0948\u0902 \u0924\u092c \u0924\u0915 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u091c\u092c \u0924\u0915 \u0921\u093f\u0935\u093e\u0907\u0938 \u092e\u0947\u0930\u0947 \u091a\u0947\u0939\u0930\u0947 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0917\u093f\u0930 \u091c\u093e\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella mia mano. Scorro finch\u00e9 il dispositivo non mi cade in faccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306e\u624b\u306e\u4e2d\u306b\u3002\u30c7\u30d0\u30a4\u30b9\u304c\u9854\u306e\u4e0a\u306b\u843d\u3061\u308b\u307e\u3067\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4 \uc190\uc5d0. \uc7a5\uce58\uac00 \ub0b4 \uc5bc\uad74\uc5d0 \ub5a8\uc5b4\uc9c8 \ub54c\uae4c\uc9c0 \uc2a4\ud06c\ub864\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In mijn hand. Ik scroll totdat het apparaat op mijn gezicht valt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W mojej d\u0142oni. Przewijam, a\u017c urz\u0105dzenie spadnie mi na twarz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na minha m\u00e3o. Eu rolo at\u00e9 que o dispositivo caia no meu rosto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043c\u043e\u0435\u0439 \u0440\u0443\u043a\u0435. \u042f \u043f\u0440\u043e\u043a\u0440\u0443\u0447\u0438\u0432\u0430\u044e, \u043f\u043e\u043a\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u043d\u0435 \u043f\u0430\u0434\u0430\u0435\u0442 \u043c\u043d\u0435 \u043d\u0430 \u043b\u0438\u0446\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimde. Cihaz y\u00fcz\u00fcme d\u00fc\u015fene kadar kayd\u0131rd\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6211\u624b\u91cc\u3002\u6211\u4e00\u76f4\u6eda\u52a8\uff0c\u76f4\u5230\u8bbe\u5907\u6389\u5230\u6211\u7684\u8138\u4e0a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6211\u624b\u88e1\u3002\u6211\u6efe\u52d5\u76f4\u5230\u8a2d\u5099\u843d\u5728\u6211\u81c9\u4e0a\u3002"
          }
        }
      }
    },
    "assessment.health.q5.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Nachttisch. Ich checke nur noch 'kurz' die letzten Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the bedside table. I just check the latest news 'quickly'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la mesita de noche. Simplemente reviso las \u00faltimas noticias \"r\u00e1pidamente\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la table de chevet. Je v\u00e9rifie simplement les derni\u00e8res nouvelles \u00ab\u00a0rapidement\u00a0\u00bb."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0947\u0921\u0938\u093e\u0907\u0921 \u091f\u0947\u092c\u0932 \u092a\u0930. \u092e\u0948\u0902 \u092c\u0938 \u0928\u0935\u0940\u0928\u0924\u092e \u0938\u092e\u093e\u091a\u093e\u0930 '\u091c\u0932\u094d\u0926\u0940' \u091c\u093e\u0901\u091a\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul comodino. Controllo semplicemente le ultime notizie \"rapidamente\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d9\u30c3\u30c9\u30b5\u30a4\u30c9\u30c6\u30fc\u30d6\u30eb\u306e\u4e0a\u3002\u6700\u65b0\u30cb\u30e5\u30fc\u30b9\u3092\u300c\u3055\u3063\u3068\u300d\u30c1\u30a7\u30c3\u30af\u3059\u308b\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce68\ub300 \uc606 \ud0c1\uc790 \uc704\uc5d0. \ub098\ub294 \ub2e8\uc9c0 \ucd5c\uc2e0 \ub274\uc2a4\ub97c '\ube60\ub974\uac8c' \ud655\uc778\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het nachtkastje. Ik check gewoon \u2018snel\u2019 het laatste nieuws."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stoliku nocnym. Po prostu \u201ena szybko\u201d sprawdzam najnowsze wiadomo\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesa de cabeceira. Acabei de ver as \u00faltimas not\u00edcias 'rapidamente'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430 \u0442\u0443\u043c\u0431\u043e\u0447\u043a\u0435. \u042f \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c '\u0431\u044b\u0441\u0442\u0440\u043e' \u043f\u0440\u043e\u0432\u0435\u0440\u044e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komidin \u00fczerinde. En son haberleri 'h\u0131zl\u0131ca' kontrol ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5e8a\u5934\u67dc\u4e0a\u3002\u6211\u53ea\u662f\u2018\u5feb\u901f\u2019\u67e5\u770b\u4e00\u4e0b\u6700\u540e\u7684\u6d88\u606f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5e8a\u982d\u6ac3\u4e0a\u3002\u6211\u53ea\u662f\u201c\u5feb\u901f\u201d\u67e5\u770b\u6700\u65b0\u6d88\u606f\u3002"
          }
        }
      }
    },
    "assessment.health.q5.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Flugmodus oder in einem anderen Raum. Mein Bett ist nur f\u00fcr Schlaf da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In airplane mode or in another room. My bed is only for sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo avi\u00f3n o en otra habitaci\u00f3n. Mi cama es s\u00f3lo para dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode avion ou dans une autre pi\u00e8ce. Mon lit est uniquement pour dormir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0935\u093e\u0908 \u091c\u0939\u093e\u091c\u093c \u092e\u094b\u0921 \u092e\u0947\u0902 \u092f\u093e \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0915\u092e\u0930\u0947 \u092e\u0947\u0902. \u092e\u0947\u0930\u093e \u092c\u093f\u0938\u094d\u0924\u0930 \u0938\u093f\u0930\u094d\u092b \u0938\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalit\u00e0 aereo o in un'altra stanza. Il mio letto serve solo per dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a5f\u5185\u30e2\u30fc\u30c9\u307e\u305f\u306f\u5225\u306e\u90e8\u5c4b\u3067\u3002\u79c1\u306e\u30d9\u30c3\u30c9\u306f\u5bdd\u308b\u305f\u3081\u3060\u3051\u306e\u3082\u306e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube44\ud589\uae30 \ubaa8\ub4dc\ub098 \ub2e4\ub978 \ubc29\uc5d0\uc11c. \ub0b4 \uce68\ub300\ub294 \uc7a0\ub9cc \uc790\ub294 \uacf3\uc774\uc5d0\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In vliegtuigmodus of in een andere kamer. Mijn bed is alleen bedoeld om te slapen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie samolotowym lub w innym pomieszczeniu. Moje \u0142\u00f3\u017cko s\u0142u\u017cy tylko do spania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo avi\u00e3o ou em outra sala. Minha cama \u00e9 apenas para dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u043e\u043b\u0435\u0442\u0430 \u0438\u043b\u0438 \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435. \u041c\u043e\u044f \u043a\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0441\u043d\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u00e7ak modunda veya ba\u015fka bir odada. Yata\u011f\u0131m sadece uyumak i\u00e7indir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u98de\u884c\u6a21\u5f0f\u6216\u5728\u53e6\u4e00\u4e2a\u623f\u95f4\u3002\u6211\u7684\u5e8a\u53ea\u7528\u4e8e\u7761\u89c9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u98db\u884c\u6a21\u5f0f\u4e0b\u6216\u5728\u53e6\u4e00\u500b\u623f\u9593\u3002\u6211\u7684\u5e8a\u53ea\u662f\u7528\u4f86\u7761\u89ba\u7684\u3002"
          }
        }
      }
    },
    "assessment.health.q5.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe mit Netflix oder YouTube auf dem Laptop oder Fernseher ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I fall asleep with Netflix or YouTube on my laptop or TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me quedo dormido con Netflix o YouTube en mi computadora port\u00e1til o televisor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'endors avec Netflix ou YouTube sur mon ordinateur portable ou mon t\u00e9l\u00e9viseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0932\u0948\u092a\u091f\u0949\u092a \u092f\u093e \u091f\u0940\u0935\u0940 \u092a\u0930 \u0928\u0947\u091f\u092b\u094d\u0932\u093f\u0915\u094d\u0938 \u092f\u093e \u092f\u0942\u091f\u094d\u092f\u0942\u092c \u0926\u0947\u0916\u0924\u0947 \u0939\u0941\u090f \u0938\u094b \u091c\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi addormento con Netflix o YouTube sul mio laptop o TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ce\u30fc\u30c8\u30d1\u30bd\u30b3\u30f3\u3084\u30c6\u30ec\u30d3\u3067 Netflix \u3084 YouTube \u3092\u898b\u306a\u304c\u3089\u7720\u308a\u306b\u843d\u3061\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub178\ud2b8\ubd81\uc774\ub098 TV\uc5d0\uc11c \ub137\ud50c\ub9ad\uc2a4\ub098 \uc720\ud29c\ube0c\ub97c \ubcf4\ub2e4\uac00 \uc7a0\uc774 \ub4ed\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik val in slaap met Netflix of YouTube op mijn laptop of tv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasypiam z Netflixem lub YouTube na laptopie lub telewizorze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adorme\u00e7o com Netflix ou YouTube no meu laptop ou TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0437\u0430\u0441\u044b\u043f\u0430\u044e \u0441 Netflix \u0438\u043b\u0438 YouTube \u043d\u0430 \u043d\u043e\u0443\u0442\u0431\u0443\u043a\u0435 \u0438\u043b\u0438 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz\u00fcst\u00fc bilgisayar\u0131mda veya televizyonumda Netflix veya YouTube izlerken uykuya dal\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u7b14\u8bb0\u672c\u7535\u8111\u6216\u7535\u89c6\u4e0a\u7528Netflix\u6216YouTube\u5165\u7761\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728\u7b46\u8a18\u578b\u96fb\u8166\u6216\u96fb\u8996\u4e0a\u89c0\u770b Netflix \u6216 YouTube \u6642\u5165\u7761\u3002"
          }
        }
      }
    },
    "assessment.health.q6": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Satz beschreibt deinen Umgang mit Hydration am ehrlichsten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which sentence most honestly describes your approach to hydration?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQu\u00e9 frase describe m\u00e1s honestamente su enfoque de la hidrataci\u00f3n?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle phrase d\u00e9crit le plus honn\u00eatement votre approche de l\u2019hydratation\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094c\u0928 \u0938\u093e \u0935\u093e\u0915\u094d\u092f \u091c\u0932\u092f\u094b\u091c\u0928 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0906\u092a\u0915\u0947 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u0915\u093e \u0938\u092c\u0938\u0947 \u0908\u092e\u093e\u0928\u0926\u093e\u0930\u0940 \u0938\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0924\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale frase descrive pi\u00f9 onestamente il tuo approccio all'idratazione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c34\u5206\u88dc\u7d66\u306b\u5bfe\u3059\u308b\u3042\u306a\u305f\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u6700\u3082\u6b63\u76f4\u306b\u8aac\u660e\u3057\u3066\u3044\u308b\u6587\u306f\u3069\u308c\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc218\ubd84 \uacf5\uae09\uc5d0 \ub300\ud55c \uadc0\ud558\uc758 \uc811\uadfc \ubc29\uc2dd\uc744 \uac00\uc7a5 \uc194\uc9c1\ud558\uac8c \uc124\uba85\ud558\ub294 \ubb38\uc7a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke zin beschrijft het meest eerlijk uw benadering van hydratatie?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kt\u00f3re zdanie najuczciwiej opisuje Twoje podej\u015bcie do nawodnienia?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual frase descreve mais honestamente sua abordagem \u00e0 hidrata\u00e7\u00e3o?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a\u043e\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u0441\u0442\u043d\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u043a \u0433\u0438\u0434\u0440\u0430\u0442\u0430\u0446\u0438\u0438?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi c\u00fcmle s\u0131v\u0131 al\u0131m\u0131na yakla\u015f\u0131m\u0131n\u0131z\u0131 en d\u00fcr\u00fcst \u015fekilde tan\u0131ml\u0131yor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54ea\u53e5\u8bdd\u6700\u8bda\u5b9e\u5730\u63cf\u8ff0\u4e86\u4f60\u5bf9\u8865\u6c34\u7684\u5904\u7406\u65b9\u5f0f\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u54ea\u4e00\u53e5\u8a71\u6700\u771f\u5be6\u5730\u63cf\u8ff0\u4e86\u60a8\u7684\u88dc\u6c34\u65b9\u6cd5\uff1f"
          }
        }
      }
    },
    "assessment.health.q6.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trinke fast nur S\u00e4fte, Softdrinks oder Energydrinks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I almost only drink juices, soft drinks or energy drinks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi s\u00f3lo bebo zumos, refrescos o bebidas energ\u00e9ticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne bois presque que des jus de fruits, des boissons gazeuses ou des boissons \u00e9nergisantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0932\u0917\u092d\u0917 \u0915\u0947\u0935\u0932 \u091c\u0942\u0938, \u0936\u0940\u0924\u0932 \u092a\u0947\u092f \u092f\u093e \u090a\u0930\u094d\u091c\u093e \u092a\u0947\u092f \u0939\u0940 \u092a\u0940\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevo quasi solo succhi, bibite o bevande energetiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u307b\u3068\u3093\u3069\u30b8\u30e5\u30fc\u30b9\u3001\u30bd\u30d5\u30c8\u30c9\u30ea\u30f3\u30af\u3001\u307e\u305f\u306f\u30a8\u30ca\u30b8\u30fc\u30c9\u30ea\u30f3\u30af\u3057\u304b\u98f2\u307f\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uac70\uc758 \uc8fc\uc2a4, \uccad\ub7c9\uc74c\ub8cc, \uc5d0\ub108\uc9c0 \uc74c\ub8cc\ub9cc \ub9c8\uc2e0\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik drink bijna alleen maar sapjes, frisdranken of energiedrankjes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij\u0119 prawie wy\u0142\u0105cznie soki, napoje bezalkoholowe i napoje energetyczne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase s\u00f3 bebo sucos, refrigerantes ou energ\u00e9ticos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u044c\u044e \u043f\u043e\u0447\u0442\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e\u043a\u0438, \u0431\u0435\u0437\u0430\u043b\u043a\u043e\u0433\u043e\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438 \u0438\u043b\u0438 \u044d\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse sadece meyve sular\u0131, alkols\u00fcz i\u00e7ecekler veya enerji i\u00e7ecekleri i\u00e7erim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u51e0\u4e4e\u53ea\u559d\u679c\u6c41\u3001\u8f6f\u996e\u6599\u6216\u80fd\u91cf\u996e\u6599\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5e7e\u4e4e\u53ea\u559d\u679c\u6c41\u3001\u8edf\u6027\u98f2\u6599\u6216\u80fd\u91cf\u98f2\u6599\u3002"
          }
        }
      }
    },
    "assessment.health.q6.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trinke oft erst, wenn ich Kopfschmerzen bekomme oder extremen Durst habe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I often only drink when I get a headache or am extremely thirsty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A menudo s\u00f3lo bebo cuando me duele la cabeza o tengo mucha sed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souvent, je ne bois que lorsque j\u2019ai mal \u00e0 la t\u00eate ou que j\u2019ai extr\u00eamement soif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u0915\u094d\u0938\u0930 \u0924\u092d\u0940 \u092a\u0940\u0924\u093e \u0939\u0942\u0902 \u091c\u092c \u092e\u0941\u091d\u0947 \u0938\u093f\u0930\u0926\u0930\u094d\u0926 \u0939\u094b\u0924\u093e \u0939\u0948 \u092f\u093e \u092c\u0939\u0941\u0924 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u094d\u092f\u093e\u0938 \u0932\u0917\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesso bevo solo quando ho mal di testa o ho molta sete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u982d\u304c\u75db\u304f\u306a\u3063\u305f\u3068\u304d\u3001\u307e\u305f\u306f\u5589\u304c\u3072\u3069\u304f\u6e07\u3044\u305f\u3068\u304d\u306b\u306e\u307f\u304a\u9152\u3092\u98f2\u3080\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub450\ud1b5\uc774 \uc788\uac70\ub098 \uadf9\ub3c4\ub85c \ubaa9\uc774 \ub9c8\ub97c \ub54c\ub9cc \uc220\uc744 \ub9c8\uc2dc\ub294 \uacbd\uc6b0\uac00 \ub9ce\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik drink vaak alleen als ik hoofdpijn krijg of extreem dorst heb."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cz\u0119sto pij\u0119 tylko wtedy, gdy boli mnie g\u0142owa lub jestem bardzo spragniony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas vezes s\u00f3 bebo quando tenho dor de cabe\u00e7a ou muita sede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0447\u0430\u0441\u0442\u043e \u043f\u044c\u044e \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0443 \u043c\u0435\u043d\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u044b\u0435 \u0431\u043e\u043b\u0438 \u0438\u043b\u0438 \u0441\u0438\u043b\u044c\u043d\u0430\u044f \u0436\u0430\u0436\u0434\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7o\u011funlukla yaln\u0131zca ba\u015f\u0131m a\u011fr\u0131d\u0131\u011f\u0131nda ya da a\u015f\u0131r\u0131 susad\u0131\u011f\u0131mda i\u00e7iyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u901a\u5e38\u53ea\u6709\u5728\u5934\u75bc\u6216\u975e\u5e38\u53e3\u6e34\u65f6\u624d\u559d\u6c34\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u901a\u5e38\u53ea\u5728\u982d\u75db\u6216\u6975\u5ea6\u53e3\u6e34\u6642\u624d\u559d\u6c34\u3002"
          }
        }
      }
    },
    "assessment.health.q6.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe immer eine Wasserflasche dabei und trinke 2\u20133 Liter klares Wasser am Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I always have a water bottle with me and drink 2-3 liters of plain water a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre llevo conmigo una botella de agua y bebo 2-3 litros de agua corriente al d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai toujours une bouteille d'eau avec moi et je bois 2 \u00e0 3 litres d'eau claire par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0947 \u0938\u093e\u0925 \u092a\u093e\u0928\u0940 \u0915\u0940 \u092c\u094b\u0924\u0932 \u0930\u0916\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0926\u093f\u0928 \u092e\u0947\u0902 2-3 \u0932\u0940\u091f\u0930 \u0938\u093e\u0926\u093e \u092a\u093e\u0928\u0940 \u092a\u0940\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho sempre con me una borraccia e bevo 2-3 litri di acqua naturale al giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3044\u3064\u3082\u6c34\u7b52\u3092\u6301\u3061\u6b69\u304d\u30011\u65e52\uff5e3\u30ea\u30c3\u30c8\u30eb\u306e\u6c34\u3092\u98f2\u3093\u3067\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub294 \ud56d\uc0c1 \ubb3c\ubcd1\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2c8\uace0 \ud558\ub8e8\uc5d0 2~3\ub9ac\ud130\uc758 \uc0dd\uc218\ub97c \ub9c8\uc2ed\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb altijd een fles water bij me en drink 2-3 liter gewoon water per dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze mam przy sobie butelk\u0119 wody i pij\u0119 2-3 litry zwyk\u0142ej wody dziennie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre tenho uma garrafa de \u00e1gua comigo e bebo de 2 a 3 litros de \u00e1gua pura por dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u043e\u0448\u0443 \u0441 \u0441\u043e\u0431\u043e\u0439 \u0431\u0443\u0442\u044b\u043b\u043a\u0443 \u0432\u043e\u0434\u044b \u0438 \u043f\u044c\u044e 2\u20133 \u043b\u0438\u0442\u0440\u0430 \u0447\u0438\u0441\u0442\u043e\u0439 \u0432\u043e\u0434\u044b \u0432 \u0434\u0435\u043d\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman yan\u0131mda bir \u015fi\u015fe su bulundururum ve g\u00fcnde 2-3 litre sade su i\u00e7erim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u603b\u662f\u5e26\u7740\u4e00\u74f6\u6c34\uff0c\u6bcf\u5929\u559d2\u52303\u5347\u6e05\u6c34\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7e3d\u662f\u96a8\u8eab\u5e36\u8457\u4e00\u500b\u6c34\u74f6\uff0c\u6bcf\u5929\u559d2-3\u516c\u5347\u767d\u958b\u6c34\u3002"
          }
        }
      }
    },
    "assessment.health.q6.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich trinke viel Wasser, aber eigentlich nur, um den Hunger zu unterdr\u00fccken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I drink a lot of water, but really only to suppress hunger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebo mucha agua, pero en realidad s\u00f3lo para calmar el hambre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bois beaucoup d\u2019eau, mais uniquement pour supprimer la faim."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u093e \u092a\u093e\u0928\u0940 \u092a\u0940\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u092d\u0942\u0916 \u0915\u094b \u0926\u092c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevo molta acqua, ma in realt\u00e0 solo per sopprimere la fame."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u6c34\u3092\u305f\u304f\u3055\u3093\u98f2\u307f\u307e\u3059\u304c\u3001\u5b9f\u969b\u306b\u306f\u7a7a\u8179\u3092\u6291\u3048\u308b\u305f\u3081\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ubb3c\uc744 \ub9ce\uc774 \ub9c8\uc2e0\ub2e4. \uadf8\ub7ec\ub098 \uc0ac\uc2e4\uc740 \ubc30\uace0\ud514\uc744 \ucc38\uae30 \uc704\ud574\uc11c\ub9cc\uc774\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik drink veel water, maar eigenlijk alleen om de honger te onderdrukken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij\u0119 du\u017co wody, ale tak naprawd\u0119 tylko po to, \u017ceby st\u0142umi\u0107 g\u0142\u00f3d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebo muita \u00e1gua, mas na verdade s\u00f3 para suprimir a fome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u044c\u044e \u043c\u043d\u043e\u0433\u043e \u0432\u043e\u0434\u044b, \u043d\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0430\u0432\u0438\u0442\u044c \u0433\u043e\u043b\u043e\u0434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7ok su i\u00e7erim ama asl\u0131nda sadece a\u00e7l\u0131\u011f\u0131 bast\u0131rmak i\u00e7in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u559d\u5f88\u591a\u6c34\uff0c\u4f46\u5b9e\u9645\u4e0a\u53ea\u662f\u4e3a\u4e86\u6291\u5236\u9965\u997f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u559d\u4e86\u5f88\u591a\u6c34\uff0c\u4f46\u5be6\u969b\u4e0a\u53ea\u662f\u70ba\u4e86\u6291\u5236\u98e2\u9913\u611f\u3002"
          }
        }
      }
    },
    "assessment.health.q7": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Woche stehst du um 6:30 Uhr auf. Was passiert am Wochenende?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the week you get up at 6:30 a.m. What happens on the weekend?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la semana te levantas a las 6:30 a.m. \u00bfQu\u00e9 pasa el fin de semana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En semaine, vous vous levez \u00e0 6h30. Que se passe-t-il le week-end ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0906\u092a \u0938\u0941\u092c\u0939 6:30 \u092c\u091c\u0947 \u0909\u0920\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u092a\u094d\u0924\u093e\u0939\u093e\u0902\u0924 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0939\u094b\u0924\u093e \u0939\u0948?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la settimana ti alzi alle 6:30. Cosa succede nel fine settimana?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u65e5\u306f\u671d6\u6642\u534a\u306b\u8d77\u304d\u307e\u3059\u304c\u3001\u9031\u672b\u306f\u3069\u3046\u306a\u308a\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\uc911\uc5d0\ub294 \uc624\uc804 6\uc2dc 30\ubd84\uc5d0 \uc77c\uc5b4\ub0a9\ub2c8\ub2e4. \uc8fc\ub9d0\uc5d0\ub294 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doordeweeks sta je om 6.30 uur op. Wat gebeurt er in het weekend?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tygodniu wstajesz o 6:30. Co dzieje si\u0119 w weekend?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a semana voc\u00ea acorda \u00e0s 6h30. O que acontece no fim de semana?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0431\u0443\u0434\u043d\u0438\u0435 \u0434\u043d\u0438 \u0442\u044b \u0432\u0441\u0442\u0430\u0451\u0448\u044c \u0432 6:30. \u0427\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0432 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta i\u00e7i sabah 6.30'da kalk\u0131yorsunuz. Hafta sonu ne oluyor?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u65e5\u4f60\u57286:30\u8d77\u5e8a\u3002\u5468\u672b\u4f1a\u53d1\u751f\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u65e5\u4f60\u65e9\u4e0a 6:30 \u8d77\u5e8a\u3002\u9031\u672b\u6703\u767c\u751f\u4ec0\u9ebc\u4e8b\uff1f"
          }
        }
      }
    },
    "assessment.health.q7.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe bis 12 oder 13 Uhr, um den 'Schlaf nachzuholen'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I sleep until 12 or 1pm to 'catch up on sleep'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duermo hasta las 12 o la 1 de la tarde para \"recuperar el sue\u00f1o\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dors jusqu'\u00e0 midi ou 13 heures pour \u00ab rattraper mon sommeil \u00bb."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 '\u0928\u0940\u0902\u0926 \u092a\u0942\u0930\u0940 \u0915\u0930\u0928\u0947' \u0915\u0947 \u0932\u093f\u090f 12 \u092f\u093e 1 \u092c\u091c\u0947 \u0924\u0915 \u0938\u094b\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormo fino alle 12 o alle 13 per \"recuperare il sonno\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u7761\u7720\u6642\u9593\u3092\u53d6\u308a\u623b\u3059\u300d\u305f\u3081\u306b\u3001\u5348\u5f8c12\u6642\u304b\u5348\u5f8c1\u6642\u307e\u3067\u5bdd\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\uc744 \ubcf4\ucda9\ud558\uae30 \uc704\ud574 \ubc24 12\uc2dc\ub098 \uc624\ud6c4 1\uc2dc\uae4c\uc9c0 \uc7a0\uc744 \uc794\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik slaap tot 12 of 13 uur om 'slaap in te halen'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015api\u0119 do 12 lub 13, \u017ceby nadrobi\u0107 zaleg\u0142o\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durmo at\u00e9 12h ou 13h para 'colocar o sono em dia'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043f\u043b\u044e \u0434\u043e 12 \u0438\u043b\u0438 13 \u0447\u0430\u0441\u043e\u0432, \u0447\u0442\u043e\u0431\u044b '\u0434\u043e\u0433\u043d\u0430\u0442\u044c \u0441\u043e\u043d'."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Uykuya yeti\u015fmek' i\u00e7in gece 12 ya da 13'e kadar uyuyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7761\u523012\u70b9\u621613\u70b9\uff0c\u4ee5\u8865\u56de\u7761\u7720\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6703\u7761\u5230\u4e2d\u5348 12 \u9ede\u6216 1 \u9ede\uff0c\u4ee5\u300c\u88dc\u5145\u7761\u7720\u300d\u3002"
          }
        }
      }
    },
    "assessment.health.q7.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stehe sp\u00e4testens eine Stunde nach meiner normalen Zeit auf, um meinen Rhythmus nicht zu zerst\u00f6ren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I get up at least an hour after my normal time so as not to disrupt my rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me levanto al menos una hora despu\u00e9s de mi horario habitual para no alterar mi ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me l\u00e8ve au moins une heure apr\u00e8s mon heure habituelle pour ne pas perturber mon rythme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u092e\u092f \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0918\u0902\u091f\u0947 \u092c\u093e\u0926 \u0909\u0920\u0924\u093e \u0939\u0942\u0902 \u0924\u093e\u0915\u093f \u092e\u0947\u0930\u0940 \u0932\u092f \u092c\u093e\u0927\u093f\u0924 \u0928 \u0939\u094b\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi alzo almeno un'ora dopo il mio orario normale per non interrompere il mio ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30ba\u30e0\u3092\u5d29\u3055\u306a\u3044\u3088\u3046\u306b\u3001\u3044\u3064\u3082\u306e\u6642\u9593\u3088\u308a\u5c11\u306a\u304f\u3068\u30821\u6642\u9593\u306f\u8d77\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub9ac\ub4ec\uc744 \ubc29\ud574\ud558\uc9c0 \uc54a\uae30 \uc704\ud574 \ud3c9\uc18c\ubcf4\ub2e4 \ucd5c\uc18c\ud55c \ud55c \uc2dc\uac04 \ub2a6\uac8c \uc77c\uc5b4\ub09c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik sta minimaal een uur later op dan mijn normale tijd om mijn ritme niet te verstoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstaj\u0119 przynajmniej godzin\u0119 p\u00f3\u017aniej ni\u017c zwykle, \u017ceby nie zak\u0142\u00f3ca\u0107 rytmu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanto-me pelo menos uma hora depois do hor\u00e1rio normal para n\u00e3o atrapalhar meu ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0432\u0441\u0442\u0430\u044e \u043d\u0435 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 \u0447\u0435\u043c \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043f\u043e\u0441\u043b\u0435 \u043c\u043e\u0435\u0433\u043e \u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u043d\u0430\u0440\u0443\u0448\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0440\u0438\u0442\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritimimi bozmamak i\u00e7in normal saatimden en az bir saat ge\u00e7 kalk\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6700\u8fdf\u5728\u5e73\u65f6\u8d77\u5e8a\u65f6\u95f4\u540e\u4e00\u5c0f\u65f6\u8d77\u5e8a\uff0c\u4ee5\u514d\u6253\u4e71\u6211\u7684\u4f5c\u606f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u81f3\u5c11\u6bd4\u6b63\u5e38\u6642\u9593\u8d77\u5e8a\u4e00\u500b\u5c0f\u6642\uff0c\u4ee5\u514d\u6253\u4e82\u6211\u7684\u7bc0\u594f\u3002"
          }
        }
      }
    },
    "assessment.health.q7.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schlafe extrem wenig, weil ich bis 4 Uhr morgens zocke oder ausgehe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I sleep extremely little because I'm gaming or going out until 4 a.m."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duermo muy poco porque juego o salgo hasta las 4 a.m."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dors extr\u00eamement peu parce que je joue ou que je sors jusqu'\u00e0 4 heures du matin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u0939\u0941\u0924 \u0915\u092e \u0938\u094b\u0924\u093e \u0939\u0942\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0948\u0902 \u0938\u0941\u092c\u0939 4 \u092c\u091c\u0947 \u0924\u0915 \u0917\u0947\u092e \u0916\u0947\u0932\u0924\u093e \u0939\u0942\u0902 \u092f\u093e \u092c\u093e\u0939\u0930 \u091c\u093e\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormo pochissimo perch\u00e9 gioco o esco fino alle 4 del mattino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5348\u524d4\u6642\u307e\u3067\u30b2\u30fc\u30e0\u3092\u3057\u305f\u308a\u5916\u51fa\u3057\u305f\u308a\u3057\u3066\u3044\u308b\u305f\u3081\u3001\u7761\u7720\u6642\u9593\u304c\u975e\u5e38\u306b\u77ed\u304f\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c8\ubcbd 4\uc2dc\uae4c\uc9c0 \uac8c\uc784\uc744 \ud558\uac70\ub098 \ubc16\uc5d0 \ub098\uac00\uc11c \uc7a0\uc744 \uac70\uc758 \ubabb \uc794\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik slaap extreem weinig omdat ik aan het gamen ben of uitga tot 04.00 uur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015api\u0119 wyj\u0105tkowo ma\u0142o, bo gram lub wychodz\u0119 do 4 rano"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durmo muito pouco porque jogo ou saio at\u00e9 as 4 da manh\u00e3"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043f\u043b\u044e \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u0430\u043b\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0433\u0440\u0430\u044e \u0438\u043b\u0438 \u0433\u0443\u043b\u044f\u044e \u0434\u043e \u0447\u0435\u0442\u044b\u0440\u0451\u0445 \u0443\u0442\u0440\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7ok az uyuyorum \u00e7\u00fcnk\u00fc oyun oynuyorum ya da sabah 4'e kadar d\u0131\u015far\u0131 \u00e7\u0131k\u0131yorum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7761\u5f97\u975e\u5e38\u5c11\uff0c\u56e0\u4e3a\u6211\u73a9\u6e38\u620f\u6216\u5916\u51fa\u5230\u51cc\u6668\u56db\u70b9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7761\u5f97\u5f88\u5c11\uff0c\u56e0\u70ba\u6211\u8981\u73a9\u904a\u6232\u6216\u51fa\u53bb\u76f4\u5230\u51cc\u6668 4 \u9ede\u3002"
          }
        }
      }
    },
    "assessment.health.q7.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wache von alleine fr\u00fch auf, zwinge mich aber, weiterzuschlafen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I wake up early on my own, but force myself to go back to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me despierto temprano por mi cuenta, pero me obligo a volver a dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me r\u00e9veille t\u00f4t tout seul, mais je me force \u00e0 me rendormir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0916\u0941\u0926 \u0924\u094b \u091c\u0932\u094d\u0926\u0940 \u0909\u0920 \u091c\u093e\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0916\u0941\u0926 \u0915\u094b \u0935\u093e\u092a\u0938 \u0938\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u091c\u092c\u0942\u0930 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi sveglio presto da solo, ma mi costringo a riaddormentarmi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u3067\u65e9\u8d77\u304d\u3057\u307e\u3059\u304c\u3001\u5f37\u5236\u7684\u306b\u4e8c\u5ea6\u5bdd\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc2a4\uc2a4\ub85c \uc77c\ucc0d \uc77c\uc5b4\ub0ac\uc9c0\ub9cc, \uc5b5\uc9c0\ub85c \ub2e4\uc2dc \uc7a0\uc5d0 \ub4e0\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik word zelf vroeg wakker, maar dwing mezelf om weer in slaap te vallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama budz\u0119 si\u0119 wcze\u015bnie, ale zmuszam si\u0119, \u017ceby ponownie zasn\u0105\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordo cedo sozinha, mas me for\u00e7o a voltar a dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0441\u044b\u043f\u0430\u044e\u0441\u044c \u0440\u0430\u043d\u043e \u0441\u0430\u043c, \u043d\u043e \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e \u0441\u0435\u0431\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0441\u043f\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi ba\u015f\u0131ma erken uyan\u0131yorum ama kendimi tekrar uyumaya zorluyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u81ea\u5df1\u5f88\u65e9\u5c31\u9192\u4e86\uff0c\u4f46\u5f3a\u8feb\u81ea\u5df1\u7ee7\u7eed\u7761\u89c9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u81ea\u5df1\u65e9\u8d77\uff0c\u4f46\u5f37\u8feb\u81ea\u5df1\u56de\u53bb\u7761\u89ba\u3002"
          }
        }
      }
    },
    "assessment.health.q8": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf einer Feier. Jeder betrinkt sich massiv oder isst extrem viel Junkfood. Du hast eigentlich klare Gesundheitsziele."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are at a party. Everyone gets very drunk or eats a lot of junk food. You actually have clear health goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s en una fiesta. Todo el mundo se emborracha mucho o come mucha comida chatarra. De hecho, tienes objetivos de salud claros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates \u00e0 une f\u00eate. Tout le monde est tr\u00e8s ivre ou mange beaucoup de malbouffe. En fait, vous avez des objectifs de sant\u00e9 clairs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u090f\u0915 \u0926\u093e\u0935\u0924 \u092e\u0947\u0902 \u0939\u094b\u0964 \u0939\u0930 \u0915\u094b\u0908 \u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u0936\u0930\u093e\u092c \u092a\u0940\u0924\u093e \u0939\u0948 \u092f\u093e \u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u091c\u0902\u0915 \u092b\u093c\u0942\u0921 \u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0932\u0915\u094d\u0937\u094d\u092f \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei a una festa. Tutti si ubriacano molto o mangiano molto cibo spazzatura. In realt\u00e0 hai obiettivi di salute chiari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u30d1\u30fc\u30c6\u30a3\u30fc\u306b\u53c2\u52a0\u3057\u3066\u3044\u307e\u3059\u3002\u8ab0\u3082\u304c\u3072\u3069\u304f\u9154\u3063\u305f\u308a\u3001\u30b8\u30e3\u30f3\u30af\u30d5\u30fc\u30c9\u3092\u305f\u304f\u3055\u3093\u98df\u3079\u305f\u308a\u3057\u307e\u3059\u3002\u5b9f\u306f\u660e\u78ba\u306a\u5065\u5eb7\u76ee\u6a19\u304c\u3042\u308b\u306e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ud30c\ud2f0\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub4e4 \uc220\uc5d0 \ucde8\ud558\uac70\ub098 \uc815\ud06c\ud478\ub4dc\ub97c \ub9ce\uc774 \uba39\uc2b5\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \uc2e4\uc81c\ub85c \uba85\ud655\ud55c \uac74\uac15 \ubaa9\ud45c\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent op een feestje. Iedereen wordt erg dronken of eet veel junkfood. Je hebt eigenlijk duidelijke gezondheidsdoelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste\u015b na imprezie. Ka\u017cdy si\u0119 bardzo upija lub je du\u017co \u015bmieciowego jedzenia. W\u0142a\u015bciwie masz jasne cele zdrowotne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 em uma festa. Todo mundo fica muito b\u00eabado ou come muita junk food. Na verdade, voc\u00ea tem objetivos de sa\u00fade claros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u043d\u0430 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0435. \u0412\u0441\u0435 \u0441\u0438\u043b\u044c\u043d\u043e \u043d\u0430\u043f\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0438\u043b\u0438 \u0435\u0434\u044f\u0442 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043d\u0435\u0437\u0434\u043e\u0440\u043e\u0432\u043e\u0439 \u043f\u0438\u0449\u0438. \u0423 \u0442\u0435\u0431\u044f \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0435\u0441\u0442\u044c \u0447\u0435\u0442\u043a\u0438\u0435 \u0446\u0435\u043b\u0438 \u043f\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir partidesin. Herkes \u00e7ok sarho\u015f olur veya \u00e7ok fazla abur cubur yer. Asl\u0131nda net sa\u011fl\u0131k hedefleriniz var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u5728\u53c2\u52a0\u4e00\u4e2a\u805a\u4f1a\u3002\u6bcf\u4e2a\u4eba\u90fd\u5728\u5927\u91cf\u559d\u9152\u6216\u5403\u6781\u591a\u7684\u5783\u573e\u98df\u54c1\u3002\u4f60\u5b9e\u9645\u4e0a\u6709\u660e\u786e\u7684\u5065\u5eb7\u76ee\u6807\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u5728\u53c3\u52a0\u4e00\u500b\u805a\u6703\u3002\u6bcf\u500b\u4eba\u90fd\u6703\u559d\u5f97\u5f88\u9189\u6216\u5403\u5f88\u591a\u5783\u573e\u98df\u7269\u3002\u60a8\u5be6\u969b\u4e0a\u6709\u660e\u78ba\u7684\u5065\u5eb7\u76ee\u6a19\u3002"
          }
        }
      }
    },
    "assessment.health.q8.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich mache voll mit. Man muss das Leben auch mal genie\u00dfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm fully involved. You have to enjoy life sometimes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy completamente involucrado. A veces hay que disfrutar la vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'implique pleinement. Il faut parfois profiter de la vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0936\u093e\u092e\u093f\u0932 \u0939\u0942\u0902. \u0906\u092a\u0915\u094b \u0915\u092d\u0940-\u0915\u092d\u0940 \u091c\u0940\u0935\u0928 \u0915\u093e \u0906\u0928\u0902\u0926 \u0932\u0947\u0928\u093e \u0939\u094b\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono completamente coinvolto. A volte devi goderti la vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5168\u9762\u7684\u306b\u95a2\u4e0e\u3057\u3066\u3044\u307e\u3059\u3002\u6642\u306b\u306f\u4eba\u751f\u3092\u697d\u3057\u307e\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc644\uc804\ud788 \ucc38\uc5ec\ud588\uc2b5\ub2c8\ub2e4. \ub54c\ub85c\ub294 \uc778\uc0dd\uc744 \uc990\uaca8\uc57c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben er volledig bij betrokken. Je moet soms van het leven genieten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jestem w pe\u0142ni zaanga\u017cowany. Czasem trzeba cieszy\u0107 si\u0119 \u017cyciem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou totalmente envolvido. Voc\u00ea tem que aproveitar a vida \u00e0s vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e. \u041d\u0443\u0436\u043d\u043e \u0438\u043d\u043e\u0433\u0434\u0430 \u0438 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0442\u044c\u0441\u044f \u0436\u0438\u0437\u043d\u044c\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen ilgiliyim. Bazen hayattan keyif almak gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5b8c\u5168\u53c2\u4e0e\u3002\u4eba\u4e5f\u5fc5\u987b\u5076\u5c14\u4eab\u53d7\u751f\u6d3b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5b8c\u5168\u53c3\u8207\u5176\u4e2d\u3002\u6709\u6642\u4f60\u5fc5\u9808\u4eab\u53d7\u751f\u6d3b\u3002"
          }
        }
      }
    },
    "assessment.health.q8.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage 'Nein', lasse mich aber nach 10 Minuten \u00fcberreden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I say 'No' but allow myself to be persuaded after 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo \"No\", pero me dejo convencer despu\u00e9s de 10 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dis \u00ab\u00a0non\u00a0\u00bb mais je me laisse convaincre au bout de 10\u00a0minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 '\u0928\u0939\u0940\u0902' \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0932\u0947\u0915\u093f\u0928 10 \u092e\u093f\u0928\u091f \u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u092e\u0928\u093e \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dico \"No\", ma mi lascio convincere dopo 10 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u300c\u30ce\u30fc\u300d\u3068\u8a00\u3044\u307e\u3057\u305f\u304c\u300110 \u5206\u5f8c\u306b\u306f\u8aac\u5f97\u3055\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 '\uc544\ub2c8\uc624'\ub77c\uace0 \ub9d0\ud558\uc9c0\ub9cc 10\ubd84 \ud6c4\uc5d0\ub294 \uc124\ub4dd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg 'Nee', maar laat me na 10 minuten overtuigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3wi\u0119 \u201eNie\u201d, ale daj\u0119 si\u0119 przekona\u0107 po 10 minutach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo \u201cN\u00e3o\u201d, mas deixo-me persuadir ap\u00f3s 10 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u043e\u0432\u043e\u0440\u044e \u00ab\u043d\u0435\u0442\u00bb, \u043d\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e \u0441\u0435\u0431\u044f \u0443\u0431\u0435\u0434\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 10 \u043c\u0438\u043d\u0443\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'Hay\u0131r' diyorum ama 10 dakika sonra ikna olmama izin veriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8bf4\u2018\u4e0d\u2019\uff0c\u4f46\u5728\u5341\u5206\u949f\u540e\u88ab\u8bf4\u670d\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8aaa\u201c\u4e0d\u201d\uff0c\u4f46 10 \u5206\u9418\u5f8c\u6211\u88ab\u8aaa\u670d\u4e86\u3002"
          }
        }
      }
    },
    "assessment.health.q8.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe bei meiner Linie, egal wie dumm die Spr\u00fcche der anderen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I stick to my line, no matter how stupid other people's sayings are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me atengo a mi l\u00ednea, por muy est\u00fapidos que sean los dichos de los dem\u00e1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je m'en tiens \u00e0 ma ligne, peu importe \u00e0 quel point les paroles des autres sont stupides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092c\u093e\u0924 \u092a\u0930 \u0905\u0921\u093c\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902, \u091a\u093e\u0939\u0947 \u0926\u0942\u0938\u0930\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u0940 \u092c\u093e\u0924\u0947\u0902 \u0915\u093f\u0924\u0928\u0940 \u092d\u0940 \u092e\u0942\u0930\u094d\u0916\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u0915\u094d\u092f\u094b\u0902 \u0928 \u0939\u094b\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimango fedele alla mia linea, non importa quanto stupide siano le parole degli altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u4eba\u306e\u767a\u8a00\u304c\u3069\u3093\u306a\u306b\u611a\u304b\u3067\u3042\u3063\u3066\u3082\u3001\u79c1\u306f\u81ea\u5206\u306e\u65b9\u91dd\u3092\u5b88\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \ub9d0\uc774 \uc544\ubb34\ub9ac \uc5b4\ub9ac\uc11d\ub354\ub77c\ub3c4 \ub0b4 \uc120\uc744 \uace0\uc218\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf bij mijn standpunt, hoe dom de uitspraken van anderen ook zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymam si\u0119 swojego zdania, bez wzgl\u0119du na to, jak g\u0142upie s\u0105 wypowiedzi innych ludzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu mantenho minha linha, n\u00e3o importa qu\u00e3o est\u00fapidas sejam as palavras das outras pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043e\u0441\u0442\u0430\u044e\u0441\u044c \u043f\u0440\u0438 \u0441\u0432\u043e\u0435\u043c \u043c\u043d\u0435\u043d\u0438\u0438, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0442\u043e\u0433\u043e, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u043f\u044b\u0435 \u0432\u044b\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043d\u0438\u044f \u0434\u0440\u0443\u0433\u0438\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015fkalar\u0131n\u0131n s\u00f6zleri ne kadar aptalca olursa olsun, kendi \u00e7izgime sad\u0131k kal\u0131r\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u8bba\u522b\u4eba\u7684\u8bdd\u591a\u4e48\u611a\u8822\uff0c\u6211\u90fd\u4f1a\u575a\u6301\u81ea\u5df1\u7684\u8def\u7ebf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5805\u6301\u81ea\u5df1\u7684\u7acb\u5834\uff0c\u4e0d\u7ba1\u5225\u4eba\u7684\u8a00\u8ad6\u6709\u591a\u611a\u8822\u3002"
          }
        }
      }
    },
    "assessment.health.q8.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bleibe solchen Events komplett fern, weil ich keine Willenskraft habe zu widerstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I stay away from such events completely because I have no willpower to resist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me mantengo completamente alejado de tales eventos porque no tengo fuerza de voluntad para resistir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reste compl\u00e8tement \u00e0 l\u2019\u00e9cart de tels \u00e9v\u00e9nements parce que je n\u2019ai aucune volont\u00e9 de r\u00e9sister."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0910\u0938\u0947 \u0906\u092f\u094b\u091c\u0928\u094b\u0902 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0926\u0942\u0930 \u0930\u0939\u0924\u093e \u0939\u0942\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0941\u091d\u092e\u0947\u0902 \u0935\u093f\u0930\u094b\u0927 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0907\u091a\u094d\u091b\u093e\u0936\u0915\u094d\u0924\u093f \u0928\u0939\u0940\u0902 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi tengo completamente lontano da tali eventi perch\u00e9 non ho la forza di volont\u00e0 per resistere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306b\u306f\u62b5\u6297\u3059\u308b\u610f\u5fd7\u304c\u306a\u3044\u306e\u3067\u3001\u305d\u306e\u3088\u3046\u306a\u51fa\u6765\u4e8b\u304b\u3089\u306f\u5b8c\u5168\u306b\u9060\u3056\u304b\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc800\ud56d\ud560 \uc758\uc9c0\uac00 \uc5c6\uae30 \ub54c\ubb38\uc5d0 \uadf8\ub7ec\ud55c \uc0ac\uac74\uc744 \uc644\uc804\ud788 \uba40\ub9ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik blijf volledig weg van dergelijke gebeurtenissen omdat ik geen wilskracht heb om weerstand te bieden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca\u0142kowicie trzymam si\u0119 z daleka od takich wydarze\u0144, poniewa\u017c nie mam si\u0142y woli, aby si\u0119 oprze\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu fico completamente afastado de tais eventos porque n\u00e3o tenho for\u00e7a de vontade para resistir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0438\u0437\u0431\u0435\u0433\u0430\u044e \u0442\u0430\u043a\u0438\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0443 \u043c\u0435\u043d\u044f \u043d\u0435\u0442 \u0441\u0438\u043b\u044b \u0432\u043e\u043b\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u044f\u0442\u044c\u0441\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Direnecek iradem olmad\u0131\u011f\u0131 i\u00e7in bu t\u00fcr olaylardan tamamen uzak duruyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5b8c\u5168\u8fdc\u79bb\u8fd9\u79cd\u6d3b\u52a8\uff0c\u56e0\u4e3a\u6211\u6ca1\u6709\u610f\u5fd7\u529b\u53bb\u62b5\u6297\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5b8c\u5168\u9060\u96e2\u9019\u985e\u4e8b\u4ef6\uff0c\u56e0\u70ba\u6211\u6c92\u6709\u62b5\u6297\u7684\u610f\u5fd7\u529b\u3002"
          }
        }
      }
    },
    "assessment.health.q9": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast seit drei Wochen beim Sitzen leichte, aber nervige R\u00fcckenschmerzen. Was tust du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have had mild but annoying back pain when sitting for three weeks. What are you doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha tenido un dolor de espalda leve pero molesto al estar sentado durante tres semanas. \u00bfQu\u00e9 est\u00e1s haciendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ressentez des maux de dos l\u00e9gers mais g\u00eanants lorsque vous \u00eates assis depuis trois semaines. Que fais-tu?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0940\u0928 \u0938\u092a\u094d\u0924\u093e\u0939 \u0924\u0915 \u092c\u0948\u0920\u0928\u0947 \u092a\u0930 \u0906\u092a\u0915\u094b \u0939\u0932\u094d\u0915\u093e \u0932\u0947\u0915\u093f\u0928 \u0915\u0937\u094d\u091f\u092a\u094d\u0930\u0926 \u092a\u0940\u0920 \u0926\u0930\u094d\u0926 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai avuto un lieve ma fastidioso dolore alla schiena quando sei rimasto seduto per tre settimane. Cosa fai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3\u9031\u9593\u5ea7\u3063\u3066\u3044\u308b\u3068\u3001\u8efd\u5ea6\u3060\u304c\u4e0d\u5feb\u306a\u8170\u75db\u306b\u60a9\u307e\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f55\u3057\u3066\u308b\u306e\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 3\uc8fc \ub3d9\uc548 \uc549\uc544 \uc788\uc744 \ub54c \uacbd\ubbf8\ud558\uc9c0\ub9cc \uc9dc\uc99d\ub098\ub294 \ud5c8\ub9ac \ud1b5\uc99d\uc744 \uacaa\uc5c8\uc2b5\ub2c8\ub2e4. \ubb50\ud558\uc138\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft gedurende drie weken lichte maar vervelende rugpijn gehad tijdens het zitten. Wat ben je aan het doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od trzech tygodni odczuwasz \u0142agodny, ale irytuj\u0105cy b\u00f3l plec\u00f3w. Co robisz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea sentiu uma dor leve, mas inc\u00f4moda nas costas, quando ficou sentado por tr\u00eas semanas. O que voc\u00ea est\u00e1 fazendo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0442\u0435\u0431\u044f \u0443\u0436\u0435 \u0442\u0440\u0438 \u043d\u0435\u0434\u0435\u043b\u0438 \u043b\u0435\u0433\u043a\u0430\u044f, \u043d\u043e \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044e\u0449\u0430\u044f \u0431\u043e\u043b\u044c \u0432 \u0441\u043f\u0438\u043d\u0435 \u043f\u0440\u0438 \u0441\u0438\u0434\u0435\u043d\u0438\u0438. \u0427\u0442\u043e \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dc\u00e7 haftad\u0131r otururken hafif ama sinir bozucu s\u0131rt a\u011fr\u0131n\u0131z oldu. Ne yap\u0131yorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5750\u7740\u7684\u65f6\u5019\u5df2\u7ecf\u4e09\u5468\u6709\u8f7b\u5fae\u4f46\u607c\u4eba\u7684\u80cc\u75db\u4e86\u3002\u4f60\u4f1a\u600e\u4e48\u505a\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5750\u4e86\u4e09\u9031\u5f8c\uff0c\u60a8\u51fa\u73fe\u4e86\u8f15\u5fae\u4f46\u7169\u4eba\u7684\u80cc\u75db\u3002\u4f60\u5728\u5e79\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "assessment.health.q9.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gar nichts. Das geht schon wieder von alleine weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing at all. This will go away on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en absoluto. Esto desaparecer\u00e1 por s\u00ed solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien du tout. Cela dispara\u00eetra tout seul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0941\u091b \u092d\u0940 \u0928\u0939\u0940\u0902\u0964 \u092f\u0947 \u0905\u092a\u0928\u0947 \u0906\u092a \u0926\u0942\u0930 \u0939\u094b \u091c\u093e\u090f\u0917\u093e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di niente. Questo andr\u00e0 via da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f55\u3082\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u308c\u306f\u81ea\u7136\u306b\u6d88\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc804\ud600 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \uc800\uc808\ub85c \uc0ac\ub77c\uc9c8 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helemaal niets. Dit zal vanzelf verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic. To zniknie samoistnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutamente nada. Isso desaparecer\u00e1 por conta pr\u00f3pria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0432\u0441\u0435 \u043d\u0438\u0447\u0435\u0433\u043e. \u042d\u0442\u043e \u0441\u043d\u043e\u0432\u0430 \u043f\u0440\u043e\u0439\u0434\u0435\u0442 \u0441\u0430\u043c\u043e \u0441\u043e\u0431\u043e\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u00e7bir \u015fey. Bu kendi kendine ortadan kalkacakt\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u70b9\u4e5f\u4e0d\u3002\u8fd9\u4f1a\u81ea\u5df1\u6162\u6162\u6d88\u5931\u7684\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec0\u9ebc\u90fd\u6c92\u6709\u3002\u9019\u6703\u81ea\u884c\u6d88\u5931\u3002"
          }
        }
      }
    },
    "assessment.health.q9.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich google meine Symptome, gerate in Panik, tue aber praktisch nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I google my symptoms, panic, but do practically nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busco en Google mis s\u00edntomas, me entra el p\u00e1nico, pero no hago pr\u00e1cticamente nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je recherche mes sympt\u00f4mes sur Google, je panique, mais je ne fais pratiquement rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u0923\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0917\u0942\u0917\u0932 \u092a\u0930 \u0916\u094b\u091c\u0924\u093e \u0939\u0942\u0902, \u0918\u092c\u0930\u093e\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerco su Google i miei sintomi, panico, ma non faccio praticamente nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u75c7\u72b6\u3092\u30b0\u30fc\u30b0\u30eb\u3067\u691c\u7d22\u3057\u3066\u30d1\u30cb\u30c3\u30af\u306b\u306a\u308a\u307e\u3059\u304c\u3001\u5b9f\u969b\u306b\u306f\u4f55\u3082\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub0b4 \uc99d\uc0c1\uc744 \uac80\uc0c9\ud558\uace0 \ub2f9\ud669\ud558\uc9c0\ub9cc \uc0ac\uc2e4\uc0c1 \uc544\ubb34\uac83\ub3c4 \ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik google mijn symptomen, raak in paniek, maar doe vrijwel niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuj\u0119 w Google swoje objawy, wpadam w panik\u0119, ale praktycznie nic nie robi\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procuro meus sintomas no Google, entro em p\u00e2nico, mas praticamente n\u00e3o fa\u00e7o nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0433\u0443\u0433\u043b\u044e \u0441\u0432\u043e\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b, \u0432\u043f\u0430\u0434\u0430\u044e \u0432 \u043f\u0430\u043d\u0438\u043a\u0443, \u043d\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0434\u0435\u043b\u0430\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirtilerimi Google'da ara\u015ft\u0131r\u0131yorum, pani\u011fe kap\u0131l\u0131yorum ama neredeyse hi\u00e7bir \u015fey yapm\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7528\u8c37\u6b4c\u641c\u7d22\u6211\u7684\u75c7\u72b6\uff0c\u611f\u5230\u6050\u614c\uff0c\u4f46\u5b9e\u9645\u4e0a\u4ec0\u4e48\u4e5f\u4e0d\u505a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u9a5a\u614c\u5730\u7528\u8c37\u6b4c\u641c\u5c0b\u6211\u7684\u75c7\u72c0\uff0c\u4f46\u5e7e\u4e4e\u4ec0\u9ebc\u90fd\u6c92\u505a\u3002"
          }
        }
      }
    },
    "assessment.health.q9.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich analysiere meine Haltung, fange an mich zu dehnen und mache einen Arzttermin, falls es nicht besser wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I analyze my posture, start stretching and make a doctor's appointment if it doesn't get better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizo mi postura, empiezo a estirarme y pido cita con el m\u00e9dico si no mejora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'analyse ma posture, commence \u00e0 m'\u00e9tirer et prends rendez-vous chez le m\u00e9decin si \u00e7a ne s'am\u00e9liore pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0940 \u092e\u0941\u0926\u094d\u0930\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u0938\u094d\u091f\u094d\u0930\u0947\u091a\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u0917\u0930 \u092f\u0939 \u092c\u0947\u0939\u0924\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e \u0939\u0948 \u0924\u094b \u0921\u0949\u0915\u094d\u091f\u0930 \u0938\u0947 \u0905\u092a\u0949\u0907\u0902\u091f\u092e\u0947\u0902\u091f \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizzo la mia postura, inizio a fare stretching e prendo un appuntamento dal medico se non migliora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u59ff\u52e2\u3092\u5206\u6790\u3057\u3001\u30b9\u30c8\u30ec\u30c3\u30c1\u3092\u59cb\u3081\u3001\u6539\u5584\u3057\u306a\u3044\u5834\u5408\u306f\u533b\u5e2b\u306e\u8a3a\u5bdf\u3092\u53d7\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc790\uc138\ub97c \ubd84\uc11d\ud558\uace0 \uc2a4\ud2b8\ub808\uce6d\uc744 \uc2dc\uc791\ud574\ub3c4 \ub098\uc544\uc9c0\uc9c0 \uc54a\uc73c\uba74 \ubcd1\uc6d0\uc5d0 \uac00\ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik analyseer mijn houding, begin met stretchen en maak een afspraak bij de dokter als het niet beter wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizuj\u0119 swoj\u0105 postaw\u0119, zaczynam si\u0119 rozci\u0105ga\u0107 i umawiam wizyt\u0119 u lekarza, je\u015bli nie b\u0119dzie poprawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiso minha postura, come\u00e7o o alongamento e marco consulta m\u00e9dica se n\u00e3o melhorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e \u0441\u0432\u043e\u044e \u043e\u0441\u0430\u043d\u043a\u0443, \u043d\u0430\u0447\u0438\u043d\u0430\u044e \u0440\u0430\u0441\u0442\u044f\u0433\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0438 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e\u0441\u044c \u043d\u0430 \u043f\u0440\u0438\u0451\u043c \u043a \u0432\u0440\u0430\u0447\u0443, \u0435\u0441\u043b\u0438 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0442 \u043b\u0443\u0447\u0448\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duru\u015fumu analiz ediyorum, esnemeye ba\u015fl\u0131yorum ve iyile\u015fmezse doktor randevusu al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5206\u6790\u6211\u7684\u59ff\u52bf\uff0c\u5f00\u59cb\u62c9\u4f38\uff0c\u5982\u679c\u60c5\u51b5\u6ca1\u6709\u6539\u5584\uff0c\u5c31\u53bb\u9884\u7ea6\u533b\u751f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5206\u6790\u81ea\u5df1\u7684\u59ff\u52e2\uff0c\u958b\u59cb\u4f38\u5c55\u904b\u52d5\uff0c\u5982\u679c\u72c0\u6cc1\u6c92\u6709\u597d\u8f49\uff0c\u5c31\u53bb\u770b\u91ab\u751f\u3002"
          }
        }
      }
    },
    "assessment.health.q9.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wechsle den Stuhl, sitze aber weiterhin 10 Stunden am St\u00fcck ohne Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I change chairs, but continue to sit for 10 hours straight without moving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de silla, pero sigo sentado durante 10 horas seguidas sin moverme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je change de chaise, mais je reste assis 10 heures d'affil\u00e9e sans bouger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u0941\u0930\u094d\u0938\u093f\u092f\u093e\u0901 \u092c\u0926\u0932\u0924\u093e \u0939\u0942\u0901, \u0932\u0947\u0915\u093f\u0928 \u092c\u093f\u0928\u093e \u0939\u093f\u0932\u0947-\u0921\u0941\u0932\u0947 \u0932\u0917\u093e\u0924\u093e\u0930 10 \u0918\u0902\u091f\u0947 \u0924\u0915 \u092c\u0948\u0920\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio sedia, ma continuo a stare seduto per 10 ore di fila senza muovermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6905\u5b50\u3092\u5909\u3048\u307e\u3059\u304c\u300110\u6642\u9593\u306f\u52d5\u304b\u305a\u306b\u5ea7\u308a\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc758\uc790\ub97c \ubc14\uafd4\ub3c4 10\uc2dc\uac04 \ub3d9\uc548 \uc6c0\uc9c1\uc774\uc9c0 \uc54a\uace0 \uacc4\uc18d \uc549\uc544\uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wissel van stoel, maar blijf 10 uur achter elkaar zitten zonder te bewegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniam krzes\u0142o, ale nadal siedz\u0119 bez ruchu przez 10 godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Troco de cadeira, mas continuo sentado por 10 horas seguidas, sem me mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u0435\u043d\u044f\u044e \u0441\u0442\u0443\u043b, \u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u0441\u0438\u0434\u0435\u0442\u044c \u0431\u0435\u0437 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043f\u043e 10 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u0434\u0440\u044f\u0434."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandalyeleri de\u011fi\u015ftiriyorum ama 10 saat boyunca hareket etmeden oturmaya devam ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6362\u4e86\u6905\u5b50\uff0c\u4f46\u4ecd\u7136\u8fde\u7eed\u5750\u5341\u4e2a\u5c0f\u65f6\u4e0d\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u63db\u4e86\u6905\u5b50\uff0c\u4f46\u4ecd\u7136\u9023\u7e8c\u5750\u4e86 10 \u500b\u5c0f\u6642\uff0c\u4e00\u52d5\u4e5f\u4e0d\u52d5\u3002"
          }
        }
      }
    },
    "assessment.health.q10": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stellst du sicher, dass dein K\u00f6rper genug Vitamine und N\u00e4hrstoffe bekommt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you make sure your body gets enough vitamins and nutrients?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfC\u00f3mo se asegura de que su cuerpo obtenga suficientes vitaminas y nutrientes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment vous assurer que votre corps re\u00e7oit suffisamment de vitamines et de nutriments ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u092f\u0939 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0935\u093f\u091f\u093e\u092e\u093f\u0928 \u0914\u0930 \u092a\u094b\u0937\u0915 \u0924\u0924\u094d\u0935 \u092e\u093f\u0932\u0947\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come puoi assicurarti che il tuo corpo riceva abbastanza vitamine e sostanze nutritive?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f53\u306b\u5341\u5206\u306a\u30d3\u30bf\u30df\u30f3\u3084\u6804\u990a\u7d20\u3092\u78ba\u5b9f\u306b\u6442\u53d6\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubab8\uc5d0 \ucda9\ubd84\ud55c \ube44\ud0c0\ubbfc\uacfc \uc601\uc591\uc18c\uac00 \uacf5\uae09\ub418\ub3c4\ub85d \ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe zorg je ervoor dat je lichaam voldoende vitamines en voedingsstoffen binnenkrijgt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak zapewni\u0107 organizmowi wystarczaj\u0105c\u0105 ilo\u015b\u0107 witamin i sk\u0142adnik\u00f3w od\u017cywczych?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como voc\u00ea garante que seu corpo receba vitaminas e nutrientes suficientes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0442\u044b \u0443\u0431\u0435\u0436\u0434\u0430\u0435\u0448\u044c\u0441\u044f, \u0447\u0442\u043e \u0442\u0432\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u0438\u0442\u0430\u043c\u0438\u043d\u043e\u0432 \u0438 \u043f\u0438\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuzun yeterli miktarda vitamin ve besin ald\u0131\u011f\u0131ndan nas\u0131l emin olursunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5982\u4f55\u786e\u4fdd\u4f60\u7684\u8eab\u4f53\u83b7\u5f97\u8db3\u591f\u7684\u7ef4\u751f\u7d20\u548c\u8425\u517b\u7d20\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u4f55\u78ba\u4fdd\u60a8\u7684\u8eab\u9ad4\u7372\u5f97\u8db3\u5920\u7684\u7dad\u751f\u7d20\u548c\u71df\u990a\uff1f"
          }
        }
      }
    },
    "assessment.health.q10.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich esse einfach das, worauf ich Lust habe. Bisher lebe ich ja noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I just eat what I feel like. So far I'm still alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo como lo que tengo ganas. Hasta ahora sigo vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mange juste ce que je ressens. Jusqu'\u00e0 pr\u00e9sent, je suis toujours en vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u0938 \u0935\u0939\u0940 \u0916\u093e\u0924\u093e \u0939\u0942\u0902 \u091c\u094b \u092e\u0941\u091d\u0947 \u0905\u091a\u094d\u091b\u093e \u0932\u0917\u0924\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u0924\u0915 \u092e\u0948\u0902 \u091c\u0940\u0935\u093f\u0924 \u0939\u0942\u0902."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangio solo quello che mi va. Finora sono ancora vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u98df\u3079\u305f\u3044\u3082\u306e\u3092\u305f\u3060\u98df\u3079\u305f\u3044\u3060\u3051\u3067\u3059\u3002\u4eca\u306e\u3068\u3053\u308d\u79c1\u306f\u307e\u3060\u751f\u304d\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uadf8\ub0e5 \uae30\ubd84\ub300\ub85c \uba39\uc2b5\ub2c8\ub2e4. \uc9c0\uae08\uae4c\uc9c0 \ub098\ub294 \uc544\uc9c1 \uc0b4\uc544\uc788\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik eet gewoon waar ik zin in heb. Tot nu toe leef ik nog."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po prostu jem to, na co mam ochot\u0119. P\u00f3ki co jeszcze \u017cyj\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu apenas como o que tenho vontade. At\u00e9 agora ainda estou vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0441\u0442\u043e \u0435\u043c \u0442\u043e, \u0447\u0435\u0433\u043e \u043c\u043d\u0435 \u0445\u043e\u0447\u0435\u0442\u0441\u044f. \u041f\u043e\u043a\u0430 \u0447\u0442\u043e \u044f \u0432\u0441\u0451 \u0435\u0449\u0451 \u0436\u0438\u0432\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece can\u0131m ne isterse onu yiyorum. \u015eu ana kadar h\u00e2l\u00e2 hayattay\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u662f\u5403\u81ea\u5df1\u60f3\u5403\u7684\u4e1c\u897f\u3002\u5230\u76ee\u524d\u4e3a\u6b62\u6211\u8fd8\u6d3b\u7740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u53ea\u662f\u5403\u6211\u60f3\u5403\u7684\u6771\u897f\u3002\u5230\u76ee\u524d\u70ba\u6b62\u6211\u9084\u6d3b\u8457\u3002"
          }
        }
      }
    },
    "assessment.health.q10.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ern\u00e4hre mich schlecht, aber werfe jeden Morgen eine Multivitamin-Tablette ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I eat poorly but take a multivitamin every morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mal pero tomo un multivitam\u00ednico todas las ma\u00f1anas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mange mal mais je prends une multivitamine tous les matins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0915\u092e \u0916\u093e\u0924\u093e \u0939\u0942\u0902 \u0932\u0947\u0915\u093f\u0928 \u0939\u0930 \u0938\u0941\u092c\u0939 \u092e\u0932\u094d\u091f\u0940\u0935\u093f\u091f\u093e\u092e\u093f\u0928 \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangio male ma prendo un multivitaminico ogni mattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3042\u307e\u308a\u98df\u3079\u307e\u305b\u3093\u304c\u3001\u6bce\u671d\u30de\u30eb\u30c1\u30d3\u30bf\u30df\u30f3\u3092\u98f2\u3093\u3067\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc798 \uba39\uc9c0 \uc54a\uc9c0\ub9cc \ub9e4\uc77c \uc544\uce68 \uc885\ud569 \ube44\ud0c0\ubbfc\uc81c\ub97c \uba39\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik eet slecht, maar neem elke ochtend een multivitamine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od\u017cywiam si\u0119 s\u0142abo, ale codziennie rano bior\u0119 multiwitamin\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mal, mas tomo um multivitam\u00ednico todas as manh\u00e3s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0438\u0442\u0430\u044e\u0441\u044c \u043f\u043b\u043e\u0445\u043e, \u043d\u043e \u043a\u0430\u0436\u0434\u043e\u0435 \u0443\u0442\u0440\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0443 \u043c\u0443\u043b\u044c\u0442\u0438\u0432\u0438\u0442\u0430\u043c\u0438\u043d\u043e\u0432."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00f6t\u00fc besleniyorum ama her sabah multivitamin al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u996e\u98df\u4e0d\u5065\u5eb7\uff0c\u4f46\u6bcf\u5929\u65e9\u4e0a\u90fd\u4f1a\u670d\u4e00\u7247\u7efc\u5408\u7ef4\u751f\u7d20\u7247\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5403\u5f97\u4e0d\u597d\uff0c\u4f46\u6bcf\u5929\u65e9\u4e0a\u90fd\u670d\u7528\u591a\u7a2e\u7dad\u751f\u7d20\u3002"
          }
        }
      }
    },
    "assessment.health.q10.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens die H\u00e4lfte meiner Mahlzeiten besteht aus echtem, unverarbeitetem Essen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least half of my meals consist of real, unprocessed food."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos la mitad de mis comidas consisten en alimentos reales y no procesados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins la moiti\u00e9 de mes repas sont constitu\u00e9s de vrais aliments non transform\u00e9s."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0947\u0930\u0947 \u092d\u094b\u091c\u0928 \u0915\u093e \u0915\u092e \u0938\u0947 \u0915\u092e \u0906\u0927\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915, \u0905\u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u092d\u094b\u091c\u0928 \u0938\u0947 \u092c\u0928\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno la met\u00e0 dei miei pasti sono costituiti da cibo vero e non trasformato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306e\u98df\u4e8b\u306e\u5c11\u306a\u304f\u3068\u3082\u534a\u5206\u306f\u3001\u52a0\u5de5\u3055\u308c\u3066\u3044\u306a\u3044\u672c\u7269\u306e\u98df\u3079\u7269\u3067\u69cb\u6210\u3055\u308c\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4 \uc2dd\uc0ac\uc758 \uc801\uc5b4\ub3c4 \uc808\ubc18\uc740 \uac00\uacf5\ub418\uc9c0 \uc54a\uc740 \uc2e4\uc81c \uc74c\uc2dd\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens de helft van mijn maaltijden bestaat uit echte, onbewerkte voeding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przynajmniej po\u0142owa moich posi\u0142k\u00f3w sk\u0142ada si\u0119 z prawdziwej, nieprzetworzonej \u017cywno\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos metade das minhas refei\u00e7\u00f5es consiste em comida de verdade e n\u00e3o processada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0430 \u043c\u043e\u0438\u0445 \u043f\u0440\u0438\u0451\u043c\u043e\u0432 \u043f\u0438\u0449\u0438 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439, \u043d\u0435\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u043e\u0439 \u0435\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6\u011f\u00fcnlerimin en az yar\u0131s\u0131 ger\u00e7ek, i\u015flenmemi\u015f yiyeceklerden olu\u015fuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u81f3\u5c11\u4e00\u534a\u9910\u98df\u7531\u771f\u6b63\u7684\u3001\u672a\u52a0\u5de5\u7684\u98df\u7269\u7ec4\u6210\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7684\u98ef\u83dc\u4e2d\u81f3\u5c11\u6709\u4e00\u534a\u662f\u771f\u6b63\u7684\u3001\u672a\u52a0\u5de5\u7684\u98df\u7269\u3002"
          }
        }
      }
    },
    "assessment.health.q10.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich folge jedem neuen Ern\u00e4hrungs-Trend auf TikTok, breche ihn aber nach 2 Wochen wieder ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I follow every new diet trend on TikTok but stop after 2 weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigo todas las nuevas tendencias diet\u00e9ticas en TikTok, pero dejo de hacerlo despu\u00e9s de 2 semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis chaque nouvelle tendance di\u00e9t\u00e9tique sur TikTok mais j'arr\u00eate au bout de 2 semaines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u091f\u093f\u0915\u091f\u0949\u0915 \u092a\u0930 \u0939\u0930 \u0928\u090f \u0906\u0939\u093e\u0930 \u091f\u094d\u0930\u0947\u0902\u0921 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0932\u0947\u0915\u093f\u0928 2 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0947 \u092c\u093e\u0926 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguo ogni nuova tendenza dietetica su TikTok ma mi fermo dopo 2 settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306fTikTok\u3067\u65b0\u3057\u3044\u30c0\u30a4\u30a8\u30c3\u30c8\u30c8\u30ec\u30f3\u30c9\u3092\u3059\u3079\u3066\u30d5\u30a9\u30ed\u30fc\u3057\u3066\u3044\u307e\u3059\u304c\u30012\u9031\u9593\u5f8c\u306b\u3084\u3081\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 TikTok\uc758 \ubaa8\ub4e0 \uc0c8\ub85c\uc6b4 \ub2e4\uc774\uc5b4\ud2b8 \ud2b8\ub80c\ub4dc\ub97c \ub530\ub974\uc9c0\ub9cc 2\uc8fc \ud6c4\uc5d0\ub294 \uc911\ub2e8\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik volg elke nieuwe dieettrend op TikTok maar stop na 2 weken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015aledz\u0119 ka\u017cdy nowy trend dietetyczny na TikToku, ale przestaj\u0119 po 2 tygodniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigo todas as novas tend\u00eancias de dieta no TikTok, mas paro depois de 2 semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043b\u0435\u0436\u0443 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u043c \u043d\u043e\u0432\u044b\u043c \u0442\u0440\u0435\u043d\u0434\u043e\u043c \u0432 \u043f\u0438\u0442\u0430\u043d\u0438\u0438 \u043d\u0430 TikTok, \u043d\u043e \u0431\u0440\u043e\u0441\u0430\u044e \u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437 2 \u043d\u0435\u0434\u0435\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok'taki her yeni diyet trendini takip ediyorum ancak 2 hafta sonra b\u0131rak\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5728TikTok\u4e0a\u8ffd\u968f\u6bcf\u4e00\u4e2a\u65b0\u7684\u996e\u98df\u6f6e\u6d41\uff0c\u4f46\u4e24\u5468\u540e\u5c31\u4f1a\u653e\u5f03\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u95dc\u6ce8 TikTok \u4e0a\u7684\u6bcf\u4e00\u500b\u65b0\u7684\u98f2\u98df\u8da8\u52e2\uff0c\u4f46\u5169\u9031\u5f8c\u5c31\u505c\u6b62\u4e86\u3002"
          }
        }
      }
    },
    "assessment.health.q11": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Zeit verbringst du an einem durchschnittlichen Tag drau\u00dfen im echten Tageslicht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On an average day, how much time do you spend outside in real daylight?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un d\u00eda normal, \u00bfcu\u00e1nto tiempo pasas afuera bajo luz real?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au cours d\u2019une journ\u00e9e moyenne, combien de temps passez-vous dehors \u00e0 la lumi\u00e8re du jour\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0914\u0938\u0924 \u0926\u093f\u0928 \u092e\u0947\u0902, \u0906\u092a \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0926\u093f\u0928 \u0915\u0947 \u0909\u091c\u093e\u0932\u0947 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u093e \u0938\u092e\u092f \u092c\u093e\u0939\u0930 \u092c\u093f\u0924\u093e\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una giornata media, quanto tempo trascorri all'aperto alla luce del giorno?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u5e73\u5747\u3057\u3066\u4e00\u65e5\u306b\u3069\u308c\u304f\u3089\u3044\u306e\u6642\u9593\u3092\u5b9f\u969b\u306e\u65e5\u4e2d\u306b\u5c4b\u5916\u3067\u904e\u3054\u3057\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\uc81c \uc77c\uad11\uc5d0\uc11c \ud558\ub8e8 \ud3c9\uade0 \uc5bc\ub9c8\ub098 \ub9ce\uc740 \uc2dc\uac04\uc744 \ubc16\uc5d0\uc11c \ubcf4\ub0b4\uc2ed\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel tijd brengt u gemiddeld op een dag buiten door in echt daglicht?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile czasu sp\u0119dzasz przeci\u0119tnie na \u015bwie\u017cym powietrzu przy prawdziwym \u015bwietle dziennym?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um dia normal, quanto tempo voc\u00ea passa ao ar livre \u00e0 luz do dia?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0442\u044b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0448\u044c \u043d\u0430 \u0443\u043b\u0438\u0446\u0435 \u043f\u0440\u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u0434\u043d\u0435\u0432\u043d\u043e\u043c \u0441\u0432\u0435\u0442\u0435 \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0437\u0430 \u0434\u0435\u043d\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama bir g\u00fcnde, ger\u00e7ek g\u00fcn \u0131\u015f\u0131\u011f\u0131nda d\u0131\u015far\u0131da ne kadar zaman ge\u00e7iriyorsunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5728\u4e00\u5929\u4e2d\u5e73\u5747\u82b1\u591a\u5c11\u65f6\u95f4\u5728\u6237\u5916\u7684\u81ea\u7136\u9633\u5149\u4e0b\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e73\u5747\u4e00\u5929\uff0c\u60a8\u5728\u767d\u5929\u7684\u6236\u5916\u6d3b\u52d5\u6642\u9593\u6709\u591a\u5c11\uff1f"
          }
        }
      }
    },
    "assessment.health.q11.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger als 15 Minuten. Ich bin fast nur drinnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 15 minutes. I'm almost exclusively indoors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 15 minutos. Estoy casi exclusivamente en el interior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de 15 minutes. Je suis presque exclusivement \u00e0 l'int\u00e9rieur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "15 \u092e\u093f\u0928\u091f \u0938\u0947 \u092d\u0940 \u0915\u092e. \u092e\u0948\u0902 \u0932\u0917\u092d\u0917 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0918\u0930 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno di 15 minuti. Sto quasi esclusivamente in ambienti chiusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15 \u5206\u672a\u6e80\u3067\u3059\u3002\u79c1\u306f\u307b\u307c\u5ba4\u5185\u306b\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15\ubd84 \ubbf8\ub9cc. \uc800\ub294 \uac70\uc758 \uc2e4\ub0b4\uc5d0\ub9cc \uc788\uc5b4\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder dan 15 minuten. Ik ben bijna uitsluitend binnenshuis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej ni\u017c 15 minut. Przebywam prawie wy\u0142\u0105cznie w pomieszczeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 15 minutos. Estou quase exclusivamente dentro de casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0435\u043d\u0435\u0435 15 \u043c\u0438\u043d\u0443\u0442. \u042f \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0451 \u0432\u0440\u0435\u043c\u044f \u0434\u043e\u043c\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "15 dakikadan az. Neredeyse sadece i\u00e7 mekanday\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u523015\u5206\u949f\u3002\u6211\u51e0\u4e4e\u4e00\u76f4\u5f85\u5728\u5ba4\u5185\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u523015\u5206\u9418\u3002\u6211\u5e7e\u4e4e\u5b8c\u5168\u5f85\u5728\u5ba4\u5167\u3002"
          }
        }
      }
    },
    "assessment.health.q11.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Weg zur Schule oder Arbeit und zur\u00fcck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the way to school or work and back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3lo el camino a la escuela o al trabajo y de regreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste le chemin de l'\u00e9cole ou du travail et retour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0938 \u0938\u094d\u0915\u0942\u0932 \u092f\u093e \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0914\u0930 \u0935\u093e\u092a\u0938 \u0906\u0928\u0947 \u0915\u093e \u0930\u093e\u0938\u094d\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il tragitto per andare a scuola o al lavoro e ritorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b66\u6821\u3084\u4f1a\u793e\u3078\u306e\u884c\u304d\u5e30\u308a\u3060\u3051\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud559\uad50\ub098 \uc9c1\uc7a5\uc5d0 \uac14\ub2e4\uac00 \ub3cc\uc544\uc624\ub294 \uae38\ubfd0\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewoon de weg naar school of werk en terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko w drodze do szko\u0142y lub pracy i z powrotem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o caminho para a escola ou trabalho e de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u043e\u043b\u044c\u043a\u043e \u043f\u0443\u0442\u044c \u0432 \u0448\u043a\u043e\u043b\u0443 \u0438\u043b\u0438 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u0438 \u043e\u0431\u0440\u0430\u0442\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece okula veya i\u015fe gidi\u015f-d\u00f6n\u00fc\u015f yolu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u6709\u4e0a\u5b66\u6216\u4e0a\u73ed\u4ee5\u53ca\u56de\u5bb6\u7684\u8def\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u662f\u4e0a\u5b78\u6216\u4e0a\u73ed\u7136\u5f8c\u56de\u4f86\u7684\u8def\u4e0a\u3002"
          }
        }
      }
    },
    "assessment.health.q11.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 30\u201360 Minuten aktiv, egal ob es regnet oder die Sonne scheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be active for at least 30-60 minutes, whether it rains or the sun shines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9ngase activo durante al menos 30 a 60 minutos, ya sea que llueva o brille el sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez actif pendant au moins 30 \u00e0 60 minutes, qu\u2019il pleuve ou que le soleil brille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u093e\u0939\u0947 \u092c\u093e\u0930\u093f\u0936 \u0939\u094b \u092f\u093e \u0927\u0942\u092a, \u0915\u092e \u0938\u0947 \u0915\u092e 30-60 \u092e\u093f\u0928\u091f \u0924\u0915 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii attivo per almeno 30-60 minuti, sia che piova o che splenda il sole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96e8\u304c\u964d\u3063\u3066\u3044\u3066\u3082\u6674\u308c\u3066\u3044\u3066\u3082\u3001\u5c11\u306a\u304f\u3068\u3082 30 \uff5e 60 \u5206\u9593\u306f\u6d3b\u52d5\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube44\uac00 \uc624\ub4e0 \ud587\ube5b\uc774 \ube44\uce58\ub4e0 \ucd5c\uc18c 30~60\ubd84 \ub3d9\uc548 \ud65c\ub3d9\ud558\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees minimaal 30-60 minuten actief, of het nu regent of de zon schijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0105d\u017a aktywny przez co najmniej 30\u201360 minut, niezale\u017cnie od tego, czy pada deszcz, czy \u015bwieci s\u0142o\u0144ce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja ativo por pelo menos 30-60 minutos, quer chova ou fa\u00e7a sol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043a\u0442\u0438\u0432\u043d\u043e \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 30\u201360 \u043c\u0438\u043d\u0443\u0442, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u0442\u043e\u0433\u043e, \u0438\u0434\u0435\u0442 \u043b\u0438 \u0434\u043e\u0436\u0434\u044c \u0438\u043b\u0438 \u0441\u0432\u0435\u0442\u0438\u0442 \u0441\u043e\u043b\u043d\u0446\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ster ya\u011fmur ya\u011fs\u0131n ister g\u00fcne\u015f parlas\u0131n, en az 30-60 dakika aktif olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81f3\u5c1130\u201360\u5206\u949f\u6d3b\u8dc3\uff0c\u65e0\u8bba\u4e0b\u96e8\u8fd8\u662f\u9633\u5149\u660e\u5a9a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u8ad6\u4e0b\u96e8\u6216\u6674\u5929\uff0c\u81f3\u5c11\u6d3b\u52d5 30-60 \u5206\u9418\u3002"
          }
        }
      }
    },
    "assessment.health.q11.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin viel drau\u00dfen, schaue aber auch beim Gehen zu 90\uff05 auf mein Smartphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I spend a lot of time outside, but I also look at my smartphone 90\uff05 of the time when I walk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso mucho tiempo al aire libre, pero tambi\u00e9n miro mi tel\u00e9fono inteligente el 90\uff05 del tiempo cuando camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je passe beaucoup de temps dehors, mais je regarde aussi mon smartphone 90 \uff05 du temps lorsque je marche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u093e \u0938\u092e\u092f \u092c\u093e\u0939\u0930 \u092c\u093f\u0924\u093e\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u091c\u092c \u092e\u0948\u0902 \u091a\u0932\u0924\u093e \u0939\u0942\u0902 \u0924\u094b 90\uff05 \u0938\u092e\u092f \u0905\u092a\u0928\u0947 \u0938\u094d\u092e\u093e\u0930\u094d\u091f\u092b\u094b\u0928 \u092a\u0930 \u092d\u0940 \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascorro molto tempo fuori, ma guardo anche il mio smartphone il 90\uff05 delle volte quando cammino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u5916\u3067\u904e\u3054\u3059\u6642\u9593\u304c\u591a\u3044\u3067\u3059\u304c\u3001\u6b69\u3044\u3066\u3044\u308b\u3068\u304d\u30829\u5272\u306f\u30b9\u30de\u30db\u3092\u898b\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub294 \ubc16\uc5d0\uc11c \ub9ce\uc740 \uc2dc\uac04\uc744 \ubcf4\ub0b4\uc9c0\ub9cc, \uac78\uc744 \ub54c\uc5d0\ub3c4 90\uff05\uc758 \uc2dc\uac04\uc744 \uc2a4\ub9c8\ud2b8\ud3f0\uc744 \ubd05\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik breng veel tijd buiten door, maar kijk ook 90\uff05 van de tijd op mijn smartphone als ik loop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du\u017co czasu sp\u0119dzam na \u015bwie\u017cym powietrzu, ale podczas spaceru przez 90\uff05 czasu patrz\u0119 te\u017c na smartfon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo muito tempo fora de casa, mas tamb\u00e9m olho para o meu smartphone 90\uff05 do tempo quando caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0432\u043e\u0436\u0443 \u043d\u0430 \u0443\u043b\u0438\u0446\u0435, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c 90\uff05 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043a\u043e\u0433\u0434\u0430 \u0438\u0434\u0443, \u0441\u043c\u043e\u0442\u0440\u044e \u043d\u0430 \u0441\u0432\u043e\u0439 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman\u0131m\u0131n \u00e7o\u011funu d\u0131\u015far\u0131da ge\u00e7iriyorum ama ayn\u0131 zamanda y\u00fcr\u00fcrken \uff0590 oran\u0131nda ak\u0131ll\u0131 telefonuma da bak\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7ecf\u5e38\u5728\u6237\u5916\uff0c\u4f46\u8d70\u8def\u65f6\u670990\uff05\u7684\u65f6\u95f4\u90fd\u5728\u770b\u6211\u7684\u667a\u80fd\u624b\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5927\u90e8\u5206\u6642\u9593\u90fd\u5728\u6236\u5916\uff0c\u4f46\u8d70\u8def\u6642 90\uff05 \u7684\u6642\u9593\u6211\u4e5f\u6703\u770b\u667a\u6167\u578b\u624b\u6a5f\u3002"
          }
        }
      }
    },
    "assessment.health.q12": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei v\u00f6llig ehrlich: Wie oft benutzt du Zahnseide oder reinigst deine Zahnzwischenr\u00e4ume?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be completely honest: How often do you floss or clean between your teeth?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sea completamente honesto: \u00bfCon qu\u00e9 frecuencia usa hilo dental o se limpia entre los dientes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez tout \u00e0 fait honn\u00eate\u00a0: \u00e0 quelle fr\u00e9quence utilisez-vous la soie dentaire ou nettoyez-vous entre vos dents\u00a0?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0908\u092e\u093e\u0928\u0926\u093e\u0930 \u0930\u0939\u0947\u0902: \u0906\u092a \u0915\u093f\u0924\u0928\u0940 \u092c\u093e\u0930 \u0905\u092a\u0928\u0947 \u0926\u093e\u0902\u0924\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092b\u094d\u0932\u0949\u0938 \u092f\u093e \u0938\u092b\u093c\u093e\u0908 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii completamente onesto: quanto spesso usi il filo interdentale o pulisci gli spazi interdentali?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u76f4\u306b\u8a00\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u3069\u308c\u304f\u3089\u3044\u306e\u983b\u5ea6\u3067\u6b6f\u9593\u306e\u30d5\u30ed\u30b9\u3084\u6383\u9664\u3092\u3057\u3066\u3044\u307e\u3059\u304b?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc644\uc804\ud788 \uc194\uc9c1\ud558\uac8c \ub9d0\ud558\uc2ed\uc2dc\uc624. \uc5bc\ub9c8\ub098 \uc790\uc8fc \uce58\uc2e4\uc744 \uc0ac\uc6a9\ud558\uac70\ub098 \uce58\uc544 \uc0ac\uc774\ub97c \uccad\uc18c\ud569\ub2c8\uae4c?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees helemaal eerlijk: hoe vaak flos of reinig jij tussen je tanden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u0105d\u017a ca\u0142kowicie szczery: jak cz\u0119sto nitkujesz z\u0119by lub czy\u015bcisz przestrzenie mi\u0119dzy z\u0119bami?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja completamente honesto: com que frequ\u00eancia voc\u00ea usa fio dental ou limpa entre os dentes?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0443\u0434\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0447\u0435\u0441\u0442\u0435\u043d: \u043a\u0430\u043a \u0447\u0430\u0441\u0442\u043e \u0442\u044b \u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0448\u044c\u0441\u044f \u0437\u0443\u0431\u043d\u043e\u0439 \u043d\u0438\u0442\u044c\u044e \u0438\u043b\u0438 \u043e\u0447\u0438\u0449\u0430\u0435\u0448\u044c \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043a\u0438 \u043c\u0435\u0436\u0434\u0443 \u0437\u0443\u0431\u0430\u043c\u0438?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen d\u00fcr\u00fcst olun: Di\u015flerinizin aras\u0131n\u0131 ne s\u0131kl\u0131kla di\u015f ipi ile temizliyorsunuz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u5168\u8bda\u5b9e\u4e00\u70b9\uff1a\u4f60\u591a\u4e45\u4f7f\u7528\u4e00\u6b21\u7259\u7ebf\u6216\u6e05\u7406\u7259\u7f1d\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u5168\u8aa0\u5be6\uff1a\u60a8\u591a\u4e45\u4f7f\u7528\u4e00\u6b21\u7259\u7dda\u6216\u6e05\u6f54\u7259\u7e2b\uff1f"
          }
        }
      }
    },
    "assessment.health.q12.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie. Z\u00e4hneputzen muss reichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never. Brushing your teeth has to be enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca. Cepillarse los dientes tiene que ser suficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais. Se brosser les dents doit suffire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092d\u0940 \u0928\u0939\u0940\u0902\u0964 \u0905\u092a\u0928\u0947 \u0926\u093e\u0902\u0924\u094b\u0902 \u0915\u094b \u092c\u094d\u0930\u0936 \u0915\u0930\u0928\u093e \u0939\u0940 \u0915\u093e\u092b\u0940 \u0939\u094b\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai. Lavarsi i denti deve essere sufficiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u5ea6\u3082\u306a\u3044\u3002\u6b6f\u3092\u78e8\u304f\u3060\u3051\u3067\u5341\u5206\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc808\ub300. \uc774\ub97c \ub2e6\ub294 \uac83\ub9cc\uc73c\ub85c\ub3c4 \ucda9\ubd84\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nooit. Tandenpoetsen moet voldoende zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy. Mycie z\u0119b\u00f3w musi wystarczy\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca. Escovar os dentes tem que ser suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442. \u0427\u0438\u0441\u0442\u043a\u0438 \u0437\u0443\u0431\u043e\u0432 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla. Di\u015flerinizi f\u0131r\u00e7alamak yeterli olmal\u0131d\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u3002\u5237\u7259\u5c31\u591f\u4e86\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d55\u4e0d\u3002\u5237\u7259\u5c31\u5920\u4e86\u3002"
          }
        }
      }
    },
    "assessment.health.q12.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn ich merke, dass etwas zwischen den Z\u00e4hnen festh\u00e4ngt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when I notice that something is stuck between my teeth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3lo cuando noto que algo se me queda atrapado entre los dientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement quand je remarque que quelque chose est coinc\u00e9 entre mes dents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0947\u0935\u0932 \u0924\u092d\u0940 \u091c\u092c \u092e\u0941\u091d\u0947 \u0927\u094d\u092f\u093e\u0928 \u0906\u0924\u093e \u0939\u0948 \u0915\u093f \u092e\u0947\u0930\u0947 \u0926\u093e\u0902\u0924\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0915\u0941\u091b \u092b\u0902\u0938\u093e \u0939\u0941\u0906 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quando noto che qualcosa mi \u00e8 rimasto incastrato tra i denti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b6f\u306e\u9593\u306b\u4f55\u304b\u304c\u631f\u307e\u3063\u3066\u3044\u308b\u3053\u3068\u306b\u6c17\u3065\u3044\u305f\u3068\u304d\u3060\u3051\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce58\uc544 \uc0ac\uc774\uc5d0 \ubb54\uac00 \ub07c\uc5b4 \uc788\ub294 \uac83\uc744 \ubc1c\uacac\ud55c \uacbd\uc6b0\uc5d0\ub9cc."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen als ik merk dat er iets tussen mijn tanden zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopiero gdy zauwa\u017c\u0119, \u017ce co\u015b utkn\u0119\u0142o mi mi\u0119dzy z\u0119bami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f3 quando percebo que algo est\u00e1 preso entre meus dentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u0433\u0434\u0430 \u044f \u0437\u0430\u043c\u0435\u0447\u0430\u044e, \u0447\u0442\u043e \u0447\u0442\u043e-\u0442\u043e \u0437\u0430\u0441\u0442\u0440\u044f\u043b\u043e \u043c\u0435\u0436\u0434\u0443 \u0437\u0443\u0431\u0430\u043c\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancak di\u015flerimin aras\u0131na bir \u015feyin s\u0131k\u0131\u015ft\u0131\u011f\u0131n\u0131 fark etti\u011fimde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u6709\u5f53\u6211\u611f\u89c9\u6709\u4ec0\u4e48\u4e1c\u897f\u5361\u5728\u7259\u9f7f\u4e4b\u95f4\u65f6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u6709\u7576\u6211\u767c\u73fe\u6709\u6771\u897f\u5361\u5728\u6211\u7684\u7259\u9f52\u4e4b\u9593\u3002"
          }
        }
      }
    },
    "assessment.health.q12.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Abend. Das ist ein nicht verhandelbarer Teil meiner Routine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every evening. This is a non-negotiable part of my routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las noches. Esta es una parte no negociable de mi rutina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les soirs. C'est une partie non n\u00e9gociable de ma routine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0936\u093e\u092e\u0964 This is a non-negotiable part of my routine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sera. Questa \u00e8 una parte non negoziabile della mia routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u6669\u3002\u3053\u308c\u306f\u79c1\u306e\u30eb\u30fc\u30c6\u30a3\u30f3\u306e\u4e2d\u3067\u8b72\u308c\u306a\u3044\u90e8\u5206\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \uc800\ub141. \uc774\uac83\uc740 \ub0b4 \uc77c\uc0c1\uc5d0\uc11c \ud0c0\ud611\ud560 \uc218 \uc5c6\ub294 \ubd80\ubd84\uc774\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke avond. Dit is een niet-onderhandelbaar onderdeel van mijn routine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cdego wieczoru. To niezbywalna cz\u0119\u015b\u0107 mojej rutyny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as noites. Esta \u00e9 uma parte inegoci\u00e1vel da minha rotina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u044b\u0439 \u0432\u0435\u0447\u0435\u0440. \u042d\u0442\u043e \u043d\u0435\u043e\u0441\u043f\u043e\u0440\u0438\u043c\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u043c\u043e\u0435\u0439 \u0440\u0443\u0442\u0438\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ak\u015fam. Bu benim rutinimin tart\u0131\u015f\u0131lmaz bir par\u00e7as\u0131."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u665a\u3002\u8fd9\u662f\u6211\u65e5\u5e38\u751f\u6d3b\u4e2d\u4e0d\u53ef\u534f\u5546\u7684\u4e00\u90e8\u5206\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u665a\u4e0a\u3002\u9019\u662f\u6211\u65e5\u5e38\u751f\u6d3b\u4e2d\u4e0d\u53ef\u5354\u5546\u7684\u4e00\u90e8\u5206\u3002"
          }
        }
      }
    },
    "assessment.health.q12.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kaufe Zahnseide, benutze sie drei Tage und vergesse sie dann f\u00fcr Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I buy dental floss, use it for three days, and then forget about it for months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro hilo dental, lo uso durante tres d\u00edas y luego lo olvido durante meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ach\u00e8te du fil dentaire, je l'utilise pendant trois jours, puis je l'oublie pendant des mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0926\u093e\u0902\u0924\u094b \u0915\u0947 \u0927\u093e\u0917\u0947 \u0916\u0930\u0940\u0926\u0924\u093e \u0939\u0942\u0901, \u0909\u0928\u094d\u0939\u0947\u0902 \u0924\u0940\u0928 \u0926\u093f\u0928 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0924\u093e \u0939\u0942\u0901 \u0914\u0930 \u092b\u093f\u0930 \u092e\u0939\u0940\u0928\u094b\u0902 \u0924\u0915 \u0909\u0928\u094d\u0939\u0947\u0902 \u092d\u0942\u0932 \u091c\u093e\u0924\u093e \u0939\u0942\u0901\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro il filo interdentale, lo uso per tre giorni e poi me ne dimentico per mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u30c7\u30f3\u30bf\u30eb\u30d5\u30ed\u30b9\u3092\u8cfc\u5165\u3057\u30013\u65e5\u9593\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001\u305d\u306e\u5f8c\u6570\u304b\u6708\u9593\u5fd8\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\ub294 \uce58\uc2e4\uc744 \uc0ac\uc11c 3\uc77c \ub3d9\uc548 \uc0ac\uc6a9\ud558\uace0 \uba87 \ub2ec \ub3d9\uc548 \uc78a\uc5b4\ubc84\ub9bd\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik koop tandzijde, gebruik het drie dagen en vergeet het dan maandenlang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupuj\u0119 ni\u0107 dentystyczn\u0105, u\u017cywam jej przez trzy dni, a potem zapominam o niej na miesi\u0105ce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compro fio dental, uso por tr\u00eas dias e depois esque\u00e7o por meses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u043a\u0443\u043f\u0430\u044e \u0437\u0443\u0431\u043d\u0443\u044e \u043d\u0438\u0442\u044c, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e \u0435\u0451 \u0442\u0440\u0438 \u0434\u043d\u044f, \u0430 \u043f\u043e\u0442\u043e\u043c \u0437\u0430\u0431\u044b\u0432\u0430\u044e \u043e \u043d\u0435\u0439 \u043d\u0430 \u043c\u0435\u0441\u044f\u0446\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Di\u015f ipi al\u0131yorum, \u00fc\u00e7 g\u00fcn kullan\u0131yorum ve aylarca unutuyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e70\u7259\u7ebf\uff0c\u7528\u4e09\u5929\uff0c\u7136\u540e\u51e0\u4e2a\u6708\u90fd\u5fd8\u4e86\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8cb7\u7259\u7dda\uff0c\u7528\u4e86\u4e09\u5929\uff0c\u7136\u5f8c\u5e7e\u500b\u6708\u5c31\u5fd8\u4e86\u3002"
          }
        }
      }
    },
    "assessment.health.q13": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du stehst kurz vor einer wichtigen Pr\u00fcfung oder einem extrem stressigen Gespr\u00e4ch. Du bist extrem nerv\u00f6s. Wie atmest du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to take an important exam or have an extremely stressful conversation. You are extremely nervous. How do you breathe?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Est\u00e1s a punto de realizar un examen importante o de tener una conversaci\u00f3n extremadamente estresante. Est\u00e1s extremadamente nervioso. \u00bfC\u00f3mo respiras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous \u00eates sur le point de passer un examen important ou d\u2019avoir une conversation extr\u00eamement stressante. Vous \u00eates extr\u00eamement nerveux. Comment respirez-vous ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0915\u094b\u0908 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902 \u092f\u093e \u092c\u0947\u0939\u0926 \u0924\u0928\u093e\u0935\u092a\u0942\u0930\u094d\u0923 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u092c\u0947\u0939\u0926 \u0918\u092c\u0930\u093e\u090f \u0939\u0941\u090f \u0939\u0948\u0902. \u0906\u092a \u0915\u0948\u0938\u0947 \u0938\u093e\u0902\u0938 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai per sostenere un esame importante o hai una conversazione estremamente stressante. Sei estremamente nervoso. Come respiri?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f\u91cd\u8981\u306a\u8a66\u9a13\u3092\u53d7\u3051\u308b\u304b\u3001\u975e\u5e38\u306b\u30b9\u30c8\u30ec\u30b9\u306e\u304b\u304b\u308b\u4f1a\u8a71\u3092\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u3042\u306a\u305f\u306f\u3068\u3066\u3082\u7dca\u5f35\u3057\u3066\u3044\u307e\u3059\u3002\u3069\u3046\u3084\u3063\u3066\u547c\u5438\u3057\u3066\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc911\uc694\ud55c \uc2dc\ud5d8\uc744 \uce58\ub974\uac70\ub098 \uadf9\ub3c4\ub85c \uc2a4\ud2b8\ub808\uc2a4\uac00 \ub9ce\uc740 \ub300\ud654\ub97c \ud558\ub824\uace0 \ud569\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub9e4\uc6b0 \uae34\uc7a5\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5bb\uac8c \uc228\uc744 \uc26c\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je staat op het punt een belangrijk examen af \u200b\u200bte leggen of een extreem stressvol gesprek te voeren. Je bent extreem nerveus. Hoe adem je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed Tob\u0105 wa\u017cny egzamin lub wyj\u0105tkowo stresuj\u0105ca rozmowa. Jeste\u015b bardzo zdenerwowany. Jak oddychasz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea est\u00e1 prestes a fazer um exame importante ou a ter uma conversa extremamente estressante. Voc\u00ea est\u00e1 extremamente nervoso. Como voc\u00ea respira?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0441\u0442\u043e\u0438\u0448\u044c \u043d\u0430 \u043f\u043e\u0440\u043e\u0433\u0435 \u0432\u0430\u0436\u043d\u043e\u0433\u043e \u044d\u043a\u0437\u0430\u043c\u0435\u043d\u0430 \u0438\u043b\u0438 \u043a\u0440\u0430\u0439\u043d\u0435 \u0441\u0442\u0440\u0435\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430. \u0422\u044b \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0435\u0440\u0432\u043d\u0438\u0447\u0430\u0435\u0448\u044c. \u041a\u0430\u043a \u0442\u044b \u0434\u044b\u0448\u0438\u0448\u044c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6nemli bir s\u0131nava girmek \u00fczeresiniz veya son derece stresli bir konu\u015fma yapmak \u00fczeresiniz. Son derece gerginsin. Nas\u0131l nefes al\u0131yorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u9762\u4e34\u4e00\u573a\u91cd\u8981\u7684\u8003\u8bd5\u6216\u4e00\u6b21\u6781\u5176\u7d27\u5f20\u7684\u8c08\u8bdd\u3002\u4f60\u975e\u5e38\u7d27\u5f20\u3002\u4f60\u5982\u4f55\u547c\u5438\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5373\u5c07\u53c3\u52a0\u4e00\u6b21\u91cd\u8981\u7684\u8003\u8a66\u6216\u9032\u884c\u4e00\u6b21\u58d3\u529b\u6975\u5927\u7684\u5c0d\u8a71\u3002\u4f60\u975e\u5e38\u7dca\u5f35\u3002\u4f60\u5982\u4f55\u547c\u5438\uff1f"
          }
        }
      }
    },
    "assessment.health.q13.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich halte unbewusst oft die Luft an oder atme extrem flach in die Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I unconsciously often hold my breath or breathe extremely shallowly into my chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A menudo, inconscientemente, aguanto la respiraci\u00f3n o respiro muy superficialmente hacia el pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inconsciemment, je retiens souvent ma respiration ou je respire extr\u00eamement superficiellement dans ma poitrine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u0928\u091c\u093e\u0928\u0947 \u092e\u0947\u0902 \u0905\u0915\u094d\u0938\u0930 \u0905\u092a\u0928\u0940 \u0938\u093e\u0902\u0938 \u0930\u094b\u0915 \u0932\u0947\u0924\u093e \u0939\u0942\u0902 \u092f\u093e \u0905\u092a\u0928\u0940 \u091b\u093e\u0924\u0940 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0909\u0925\u0932\u0940 \u0938\u093e\u0902\u0938 \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inconsciamente spesso trattengo il respiro o respiro in modo estremamente superficiale nel petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u610f\u8b58\u306e\u3046\u3061\u306b\u606f\u3092\u6b62\u3081\u305f\u308a\u3001\u80f8\u306b\u975e\u5e38\u306b\u6d45\u3044\u547c\u5438\u3092\u3059\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ubb34\uc758\uc2dd\uc801\uc73c\ub85c \uc228\uc744 \ucc38\uac70\ub098 \uac00\uc2b4 \uc18d\uc73c\ub85c \uc544\uc8fc \uc595\uac8c \uc228\uc744 \uc26c\ub294 \uacbd\uc6b0\uac00 \ub9ce\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik houd onbewust vaak mijn adem in of adem extreem oppervlakkig in mijn borst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cz\u0119sto nie\u015bwiadomie wstrzymuj\u0119 oddech lub oddycham wyj\u0105tkowo p\u0142ytko w klatk\u0119 piersiow\u0105."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inconscientemente, muitas vezes prendo a respira\u00e7\u00e3o ou respiro de forma extremamente superficial em meu peito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0447\u0430\u0441\u0442\u043e \u043d\u0435\u0432\u043e\u043b\u044c\u043d\u043e \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e \u0434\u044b\u0445\u0430\u043d\u0438\u0435 \u0438\u043b\u0438 \u0434\u044b\u0448\u0443 \u043a\u0440\u0430\u0439\u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u043d\u043e \u0432 \u0433\u0440\u0443\u0434\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilin\u00e7sizce s\u0131kl\u0131kla nefesimi tutuyorum ya da g\u00f6\u011fs\u00fcme a\u015f\u0131r\u0131 s\u0131\u011f bir \u015fekilde nefes al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7ecf\u5e38\u65e0\u610f\u8bc6\u5730\u5c4f\u4f4f\u547c\u5438\u6216\u80f8\u90e8\u6781\u6d45\u5730\u547c\u5438\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5e38\u5e38\u4e0d\u81ea\u89ba\u5730\u5c4f\u4f4f\u547c\u5438\uff0c\u6216\u662f\u5c07\u547c\u5438\u6975\u6dfa\u5730\u5438\u9032\u80f8\u53e3\u3002"
          }
        }
      }
    },
    "assessment.health.q13.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich hyperventiliere leicht und fange an zu zittern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I hyperventilate slightly and start shaking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiperventilo un poco y empiezo a temblar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'hyperventile l\u00e9g\u00e8rement et je commence \u00e0 trembler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0925\u094b\u0921\u093c\u093e \u0939\u093e\u0907\u092a\u0930\u0935\u0947\u0902\u091f\u0940\u0932\u0947\u091f \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0915\u093e\u0902\u092a\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iperventilo leggermente e inizio a tremare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8efd\u304f\u904e\u547c\u5438\u306b\u306a\u308a\u3001\u9707\u3048\u59cb\u3081\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc57d\uac04 \uacfc\ud638\ud761\uc744 \ud558\uace0 \ubab8\uc774 \ub5a8\ub9ac\uae30 \uc2dc\uc791\ud55c\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik hyperventileer lichtjes en begin te trillen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekko hiperwentyluj\u0119 i zaczynam si\u0119 trz\u0105\u015b\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu hiperventilo um pouco e come\u00e7o a tremer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0441\u043b\u0435\u0433\u043a\u0430 \u0433\u0438\u043f\u0435\u0440\u0432\u0435\u043d\u0442\u0438\u043b\u0438\u0440\u0443\u044e \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e \u0434\u0440\u043e\u0436\u0430\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif\u00e7e h\u0131zl\u0131 nefes al\u0131yorum ve titremeye ba\u015fl\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6709\u70b9\u8fc7\u5ea6\u6362\u6c14\uff0c\u5f00\u59cb\u53d1\u6296\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7a0d\u5fae\u63db\u6c23\u904e\u5ea6\u4e26\u958b\u59cb\u767c\u6296\u3002"
          }
        }
      }
    },
    "assessment.health.q13.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich \u00fcbernehme die Kontrolle und atme bewusst tief in den Bauch, um mein Nervensystem zu beruhigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I take control and consciously breathe deeply into my stomach to calm my nervous system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomo el control y conscientemente respiro profundamente en mi est\u00f3mago para calmar mi sistema nervioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prends le contr\u00f4le et respire consciemment profond\u00e9ment dans mon ventre pour calmer mon syst\u00e8me nerveux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0930\u0916\u0924\u093e \u0939\u0942\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0924\u0902\u0924\u094d\u0930\u093f\u0915\u093e \u0924\u0902\u0924\u094d\u0930 \u0915\u094b \u0936\u093e\u0902\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u091a\u0947\u0924 \u0930\u0942\u092a \u0938\u0947 \u0905\u092a\u0928\u0947 \u092a\u0947\u091f \u092e\u0947\u0902 \u0917\u0939\u0930\u0940 \u0938\u093e\u0902\u0938 \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendo il controllo e respiro consapevolmente profondamente nello stomaco per calmare il mio sistema nervoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u795e\u7d4c\u7cfb\u3092\u843d\u3061\u7740\u304b\u305b\u308b\u305f\u3081\u306b\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3057\u3066\u610f\u8b58\u7684\u306b\u304a\u8179\u306b\u6df1\u304f\u547c\u5438\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud1b5\uc81c\ub825\uc744 \uac16\uace0 \uc758\uc2dd\uc801\uc73c\ub85c \ubc30 \uc18d\uc73c\ub85c \uae4a\uc774 \uc228\uc744 \uc26c\uc5b4 \uc2e0\uacbd\uacc4\ub97c \uc9c4\uc815\uc2dc\ud0b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik neem de controle over en adem bewust diep in mijn buik om mijn zenuwstelsel te kalmeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejmuj\u0119 kontrol\u0119 i \u015bwiadomie oddycham g\u0142\u0119boko w brzuch, aby uspokoi\u0107 uk\u0142ad nerwowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumo o controle e conscientemente respiro profundamente em meu est\u00f4mago para acalmar meu sistema nervoso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0431\u0435\u0440\u0443 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u043d\u0430 \u0441\u0435\u0431\u044f \u0438 \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0434\u044b\u0448\u0443 \u0432 \u0436\u0438\u0432\u043e\u0442, \u0447\u0442\u043e\u0431\u044b \u0443\u0441\u043f\u043e\u043a\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u044e \u043d\u0435\u0440\u0432\u043d\u0443\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol\u00fc elime al\u0131yorum ve sinir sistemimi sakinle\u015ftirmek i\u00e7in bilin\u00e7li olarak mideme derin nefes al\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u63a5\u7ba1\u63a7\u5236\uff0c\u5e76\u6709\u610f\u8bc6\u5730\u6df1\u5438\u8179\u90e8\u6c14\u606f\uff0c\u4ee5\u5e73\u9759\u6211\u7684\u795e\u7ecf\u7cfb\u7edf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u63a7\u5236\u4f4f\u81ea\u5df1\uff0c\u6709\u610f\u8b58\u5730\u6df1\u547c\u5438\uff0c\u8b93\u6211\u7684\u795e\u7d93\u7cfb\u7d71\u5e73\u975c\u4e0b\u4f86\u3002"
          }
        }
      }
    },
    "assessment.health.q13.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich atme normal, aber bei\u00dfe die Z\u00e4hne extrem fest zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm breathing normally, but I'm clenching my teeth extremely tightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiro normalmente, pero aprieto los dientes con mucha fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je respire normalement, mais je serre extr\u00eamement fort les dents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0938\u093e\u0902\u0938 \u0932\u0947 \u0930\u0939\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0926\u093e\u0902\u0924\u094b\u0902 \u0915\u094b \u092c\u0939\u0941\u0924 \u0915\u0938\u0915\u0930 \u092d\u0940\u0902\u091a \u0930\u0939\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiro normalmente, ma stringo forte i denti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u547c\u5438\u306f\u666e\u901a\u306b\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u6b6f\u3092\u5f37\u304f\u98df\u3044\u3057\u3070\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc0c1\uc801\uc73c\ub85c \ud638\ud761\ud558\uace0 \uc788\uc9c0\ub9cc \uc774\ub97c \ub9e4\uc6b0 \uaf49 \uc545\ubb3c\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik adem normaal, maar ik klem mijn tanden extreem stevig op elkaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddycham normalnie, ale z\u0119by bardzo mocno zaciskam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou respirando normalmente, mas cerro os dentes com muita for\u00e7a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0434\u044b\u0448\u0443 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e, \u043d\u043e \u0441\u0436\u0438\u043c\u0430\u044e \u0437\u0443\u0431\u044b \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u044c\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal nefes al\u0131yorum ama di\u015flerimi a\u015f\u0131r\u0131 derecede s\u0131k\u0131yorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u6b63\u5e38\u547c\u5438\uff0c\u4f46\u7259\u9f7f\u7d27\u54ac\u5f97\u975e\u5e38\u7528\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u547c\u5438\u6b63\u5e38\uff0c\u4f46\u7259\u9f52\u54ac\u5f97\u6975\u7dca\u3002"
          }
        }
      }
    },
    "assessment.health.q14": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du isst ein bestimmtes Lebensmittel und merkst, dass du danach oft Bauchschmerzen hast oder extrem m\u00fcde wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You eat a certain food and notice that you often have a stomach ache or become extremely tired afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted come un determinado alimento y nota que a menudo le duele el est\u00f3mago o se cansa mucho despu\u00e9s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous mangez un certain aliment et remarquez que vous avez souvent mal au ventre ou que vous \u00eates extr\u00eamement fatigu\u00e9 par la suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u090f\u0915 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u092d\u094b\u091c\u0928 \u0916\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u094b \u0905\u0915\u094d\u0938\u0930 \u092a\u0947\u091f \u092e\u0947\u0902 \u0926\u0930\u094d\u0926 \u0939\u094b\u0924\u093e \u0939\u0948 \u092f\u093e \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0925\u0915\u093e\u0928 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mangi un certo cibo e noti che spesso hai mal di pancia o che dopo ti senti estremamente stanco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7279\u5b9a\u306e\u98df\u3079\u7269\u3092\u98df\u3079\u308b\u3068\u3001\u305d\u306e\u5f8c\u3088\u304f\u304a\u8179\u304c\u75db\u304f\u306a\u3063\u305f\u308a\u3001\u6975\u5ea6\u306b\u75b2\u308c\u305f\u308a\u3059\u308b\u3053\u3068\u306b\u6c17\u3065\u304d\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ud2b9\uc815 \uc74c\uc2dd\uc744 \uba39\uace0 \ub098\uc11c \uc885\uc885 \ubc30\uac00 \uc544\ud504\uac70\ub098 \uadf9\ub3c4\ub85c \ud53c\uace4\ud574\uc9c0\ub294 \uac83\uc744 \ub290\ub080\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eet een bepaald voedingsmiddel en merkt dat je daarna vaak buikpijn hebt of extreem moe wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjadasz okre\u015blone jedzenie i zauwa\u017casz, \u017ce cz\u0119sto boli Ci\u0119 brzuch lub po tym stajesz si\u0119 bardzo zm\u0119czony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea come um determinado alimento e percebe que muitas vezes sente dor de est\u00f4mago ou fica extremamente cansado depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0435\u0448\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0438 \u0437\u0430\u043c\u0435\u0447\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u0443 \u0442\u0435\u0431\u044f \u0447\u0430\u0441\u0442\u043e \u0431\u043e\u043b\u0438\u0442 \u0436\u0438\u0432\u043e\u0442 \u0438\u043b\u0438 \u0442\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0448\u044c\u0441\u044f \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli bir yeme\u011fi yersiniz ve sonras\u0131nda s\u0131kl\u0131kla karn\u0131n\u0131z\u0131n a\u011fr\u0131d\u0131\u011f\u0131n\u0131 veya a\u015f\u0131r\u0131 derecede yoruldu\u011funuzu fark edersiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5403\u67d0\u79cd\u98df\u7269\u540e\uff0c\u53d1\u73b0\u81ea\u5df1\u7ecf\u5e38\u8179\u75db\u6216\u611f\u5230\u975e\u5e38\u75b2\u5026\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u5403\u4e86\u67d0\u7a2e\u98df\u7269\u5f8c\u767c\u73fe\u81ea\u5df1\u7d93\u5e38\u80c3\u75db\u6216\u8b8a\u5f97\u6975\u5ea6\u75b2\u5026\u3002"
          }
        }
      }
    },
    "assessment.health.q14.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich ignoriere es. Es schmeckt einfach zu gut, um darauf zu verzichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I ignore it. It just tastes too good to pass up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo ignoro. Sabe demasiado bien como para dejarlo pasar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je l'ignore. C'est tout simplement trop bon pour le laisser passer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0907\u0938\u0947 \u0928\u091c\u0930\u0905\u0902\u0926\u093e\u091c \u0915\u0930\u0924\u093e \u0939\u0942\u0902. \u0907\u0938\u0915\u093e \u0938\u094d\u0935\u093e\u0926 \u0907\u0924\u0928\u093e \u0905\u091a\u094d\u091b\u093e \u0939\u0948 \u0915\u093f \u0907\u0938\u0947 \u091b\u094b\u0921\u093c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo ignoro. Ha un sapore troppo buono per lasciarlo perdere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u8996\u3057\u307e\u3059\u3002\u7f8e\u5473\u3057\u3059\u304e\u3066\u624b\u653e\u3059\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uadf8\uac83\uc744 \ubb34\uc2dc\ud55c\ub2e4. \uadf8\ub0e5 \uc9c0\ub098\uce58\uae30\uc5d4 \ub108\ubb34 \ub9db\uc788\ub294 \ub9db\uc774\uc5d0\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik negeer het. Het smaakt gewoon te lekker om te laten liggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoruj\u0119 to. Po prostu smakuje zbyt dobrze, \u017ceby to przegapi\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu ignoro isso. O gosto \u00e9 bom demais para deixar passar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0443\u044e \u044d\u0442\u043e. \u042d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0432\u043a\u0443\u0441\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u044d\u0442\u043e\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "g\u00f6rmezden geliyorum. Tad\u0131 ka\u00e7\u0131r\u0131lmayacak kadar g\u00fczel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5ffd\u7565\u5b83\u3002\u5b83\u7684\u5473\u9053\u592a\u597d\uff0c\u820d\u4e0d\u5f97\u653e\u5f03\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5ffd\u7565\u5b83\u3002\u5b83\u7684\u5473\u9053\u592a\u597d\u4e86\uff0c\u4e0d\u5bb9\u932f\u904e\u3002"
          }
        }
      }
    },
    "assessment.health.q14.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich esse es seltener, aber ertrage die Schmerzen, wenn ich Lust darauf habe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I eat it less often, but tolerate the pain when I feel like it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo como con menos frecuencia, pero tolero el dolor cuando me apetece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'en mange moins souvent, mais je tol\u00e8re la douleur quand j'en ai envie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0907\u0938\u0947 \u0915\u092e \u0939\u0940 \u0916\u093e\u0924\u093e \u0939\u0942\u0902, \u0932\u0947\u0915\u093f\u0928 \u091c\u092c \u092e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u0924\u094b \u0926\u0930\u094d\u0926 \u0938\u0939\u0928 \u0915\u0930 \u0932\u0947\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mangio meno spesso, ma tollero il dolore quando ne ho voglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u98df\u3079\u308b\u983b\u5ea6\u306f\u6e1b\u308a\u307e\u3057\u305f\u304c\u3001\u98df\u3079\u305f\u3044\u3068\u304d\u306f\u75db\u307f\u3092\u6211\u6162\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc790\uc8fc \uba39\uc9c0\ub294 \uc54a\uc9c0\ub9cc \uba39\uace0 \uc2f6\uc744 \ub54c\ub294 \uace0\ud1b5\uc744 \ucc38\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik eet het minder vaak, maar tolereer de pijn als ik er zin in heb."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jem go rzadziej, ale toleruj\u0119 b\u00f3l, kiedy mam na to ochot\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como com menos frequ\u00eancia, mas tolero a dor quando tenho vontade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0435\u043c \u044d\u0442\u043e \u0440\u0435\u0436\u0435, \u043d\u043e \u0432\u044b\u043d\u043e\u0448\u0443 \u0431\u043e\u043b\u044c, \u043a\u043e\u0433\u0434\u0430 \u0443 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0436\u0435\u043b\u0430\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az yiyorum ama can\u0131m istedi\u011finde ac\u0131ya tahamm\u00fcl ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5403\u5f97\u6bd4\u8f83\u5c11\uff0c\u4f46\u5f53\u6211\u60f3\u5403\u7684\u65f6\u5019\uff0c\u6211\u4f1a\u5fcd\u53d7\u75bc\u75db\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5403\u7684\u6b21\u6578\u8f03\u5c11\uff0c\u4f46\u7576\u6211\u60f3\u5403\u7684\u6642\u5019\u5c31\u6703\u5fcd\u53d7\u75bc\u75db\u3002"
          }
        }
      }
    },
    "assessment.health.q14.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich streiche es sofort aus meiner Ern\u00e4hrung und teste, ob es mir dann besser geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I immediately cut it out of my diet and see if it makes me feel better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente lo elimino de mi dieta y veo si me hace sentir mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je l\u2019ai imm\u00e9diatement supprim\u00e9 de mon alimentation et je vois si cela me fait me sentir mieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902\u0928\u0947 \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u0939\u093e\u0930 \u0938\u0947 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u0914\u0930 \u0926\u0947\u0916\u093e \u0915\u093f \u0915\u094d\u092f\u093e \u0907\u0938\u0938\u0947 \u092e\u0941\u091d\u0947 \u092c\u0947\u0939\u0924\u0930 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ho immediatamente eliminato dalla mia dieta e vedo se mi fa sentire meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u3059\u3050\u306b\u98df\u4e8b\u304b\u3089\u305d\u308c\u3092\u3084\u3081\u3066\u3001\u6c17\u5206\u304c\u826f\u304f\u306a\u308b\u304b\u3069\u3046\u304b\u3092\u78ba\u8a8d\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \uc989\uc2dc \uadf8\uac83\uc744 \uc2dd\ub2e8\uc5d0\uc11c \uc81c\uc678\ud558\uace0 \uae30\ubd84\uc774 \uc88b\uc544\uc9c0\ub294\uc9c0 \ud655\uc778\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik schrap het onmiddellijk uit mijn dieet en kijk of ik me er beter door voel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast wyklucz\u0119 go z diety i zobacz\u0119, czy dzi\u0119ki temu poczuj\u0119 si\u0119 lepiej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imediatamente cortei-o da minha dieta e vejo se isso me faz sentir melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0438\u0441\u043a\u043b\u044e\u0447\u0443 \u044d\u0442\u043e \u0438\u0437 \u0441\u0432\u043e\u0435\u0433\u043e \u0440\u0430\u0446\u0438\u043e\u043d\u0430 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044e, \u0441\u0442\u0430\u043d\u0435\u0442 \u043b\u0438 \u043c\u043d\u0435 \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u043b\u0443\u0447\u0448\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen diyetimden \u00e7\u0131kard\u0131m ve kendimi daha iyi hissettirip hissettirmedi\u011fine bakt\u0131m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4f1a\u7acb\u5373\u628a\u5b83\u4ece\u6211\u7684\u996e\u98df\u4e2d\u53bb\u6389\uff0c\u5e76\u6d4b\u8bd5\u662f\u5426\u4f1a\u8ba9\u6211\u611f\u89c9\u66f4\u597d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7acb\u5373\u5c07\u5176\u5f9e\u6211\u7684\u98f2\u98df\u4e2d\u5254\u9664\uff0c\u770b\u770b\u5b83\u662f\u5426\u80fd\u8b93\u6211\u611f\u89ba\u597d\u4e00\u4e9b\u3002"
          }
        }
      }
    },
    "assessment.health.q14.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich rede mir ein, dass es nur Stress ist, und esse es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I tell myself it's just stress and keep eating it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me digo a m\u00ed mismo que es s\u00f3lo estr\u00e9s y sigo comi\u00e9ndolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je me dis que c'est juste du stress et je continue d'en manger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0916\u0941\u0926 \u0938\u0947 \u0915\u0939\u0924\u093e \u0939\u0942\u0902 \u0915\u093f \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0924\u0928\u093e\u0935 \u0939\u0948 \u0914\u0930 \u0907\u0938\u0947 \u0916\u093e\u0924\u093e \u0930\u0939\u0924\u093e \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi dico che \u00e8 solo stress e continuo a mangiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u308c\u306f\u305f\u3060\u306e\u30b9\u30c8\u30ec\u30b9\u3060\u3068\u81ea\u5206\u306b\u8a00\u3044\u805e\u304b\u305b\u3066\u98df\u3079\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud2b8\ub808\uc2a4\uc77c \ubfd0\uc774\ub77c\uace0 \uc2a4\uc2a4\ub85c\uc5d0\uac8c \ub9d0\ud558\uace0 \uacc4\uc18d \uba39\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zeg tegen mezelf dat het gewoon stress is en blijf het eten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f3wi\u0119 sobie, \u017ce to tylko stres i objadam si\u0119 tym dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digo a mim mesmo que \u00e9 apenas estresse e continuo comendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0443\u0431\u0435\u0436\u0434\u0430\u044e \u0441\u0435\u0431\u044f, \u0447\u0442\u043e \u044d\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u0440\u0435\u0441\u0441, \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e \u044d\u0442\u043e \u0435\u0441\u0442\u044c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendime bunun sadece stres oldu\u011funu s\u00f6yl\u00fcyorum ve yemeye devam ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u8bf4\u670d\u81ea\u5df1\u8fd9\u53ea\u662f\u538b\u529b\uff0c\u7136\u540e\u7ee7\u7eed\u5403\u4e0b\u53bb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u544a\u8a34\u81ea\u5df1\u9019\u53ea\u662f\u58d3\u529b\uff0c\u7136\u5f8c\u7e7c\u7e8c\u5403\u5b83\u3002"
          }
        }
      }
    },
    "assessment.health.q15": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum willst du \u00fcberhaupt gesund sein?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why do you even want to be healthy?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfPor qu\u00e9 quieres siquiera estar sano?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi veux-tu m\u00eame \u00eatre en bonne sant\u00e9 ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0938\u094d\u0935\u0938\u094d\u0925 \u0915\u094d\u092f\u094b\u0902 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perch\u00e9 vuoi essere sano?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u306a\u305c\u5065\u5eb7\u306b\u306a\u308a\u305f\u3044\u3068\u601d\u3046\u306e\u3067\u3057\u3087\u3046\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc65c \uac74\uac15\ud574\uc9c0\uace0 \uc2f6\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom wil je \u00fcberhaupt gezond zijn?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego w og\u00f3le chcesz by\u0107 zdrowy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que voc\u00ea quer ser saud\u00e1vel?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0442\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u0445\u043e\u0447\u0435\u0448\u044c \u0431\u044b\u0442\u044c \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u043c?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden sa\u011fl\u0131kl\u0131 olmak istiyorsun ki?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5230\u5e95\u4e3a\u4ec0\u4e48\u60f3\u8981\u5065\u5eb7\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u4ec0\u9ebc\u4f60\u9084\u60f3\u4fdd\u6301\u5065\u5eb7\uff1f"
          }
        }
      }
    },
    "assessment.health.q15.a": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will eigentlich nur gut aussehen. Der Rest ist mir egal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I actually just want to look good. I don't care about the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En realidad s\u00f3lo quiero lucir bien. No me importa el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fait, je veux juste avoir l'air bien. Je m'en fiche du reste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0938\u093f\u0930\u094d\u092b \u0905\u091a\u094d\u091b\u093e \u0926\u093f\u0916\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0902\u0964 \u092e\u0941\u091d\u0947 \u092c\u093e\u0915\u0940 \u0915\u0940 \u092a\u0930\u0935\u093e\u0939 \u0928\u0939\u0940\u0902 \u0939\u0948."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In realt\u00e0 voglio solo avere un bell'aspetto. Non mi interessa il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5f53\u306f\u898b\u305f\u76ee\u3092\u826f\u304f\u3057\u305f\u3044\u3060\u3051\u306a\u3093\u3067\u3059\u3002\u6b8b\u308a\u306e\u3053\u3068\u306f\u6c17\u306b\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc2e4 \uadf8\ub0e5 \uba4b\uc788\uc5b4 \ubcf4\uc774\uace0 \uc2f6\uc744 \ubfd0\uc774\uc5d0\uc694. \ub098\uba38\uc9c0\ub294 \uc2e0\uacbd \uc548 \uc368\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigenlijk wil ik er gewoon goed uitzien. De rest interesseert mij niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142a\u015bciwie to chc\u0119 po prostu dobrze wygl\u0105da\u0107. Reszta mnie nie obchodzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na verdade, eu s\u00f3 quero ter uma boa apar\u00eancia. Eu n\u00e3o me importo com o resto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0443 \u0445\u043e\u0440\u043e\u0448\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0435\u0442\u044c. \u0412\u0441\u0451 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u043c\u043d\u0435 \u0431\u0435\u0437\u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asl\u0131nda sadece iyi g\u00f6r\u00fcnmek istiyorum. Gerisi umurumda de\u011fil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5176\u5b9e\u53ea\u662f\u60f3\u770b\u8d77\u6765\u597d\u770b\uff0c\u5176\u4ed6\u7684\u6211\u90fd\u4e0d\u5728\u4e4e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5176\u5be6\u6211\u53ea\u662f\u60f3\u770b\u8d77\u4f86\u597d\u770b\u800c\u5df2\u3002\u5176\u9918\u7684\u6211\u4e0d\u95dc\u5fc3\u3002"
          }
        }
      }
    },
    "assessment.health.q15.b": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich will mich nicht st\u00e4ndig m\u00fcde und kaputt f\u00fchlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't want to feel tired and exhausted all the time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quiero sentirme cansado y agotado todo el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne veux pas me sentir fatigu\u00e9 et \u00e9puis\u00e9 tout le temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0939\u0930 \u0938\u092e\u092f \u0925\u0915\u093e \u0939\u0941\u0906 \u0914\u0930 \u091f\u0942\u091f\u093e \u0939\u0941\u0906 \u092e\u0939\u0938\u0942\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non voglio sentirmi sempre stanco ed esausto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e38\u306b\u75b2\u52b4\u611f\u3084\u5026\u6020\u611f\u3092\u611f\u3058\u305f\u304f\u306a\u3044\u306e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ud56d\uc0c1 \ud53c\uace4\ud558\uace0 \uc9c0\uce58\uace0 \uc2f6\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil me niet voortdurend moe en uitgeput voelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie chc\u0119 czu\u0107 si\u0119 ci\u0105gle zm\u0119czona i wyczerpana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o quero me sentir cansado e exausto o tempo todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043d\u0435 \u0445\u043e\u0447\u0443 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043c \u0438 \u0440\u0430\u0437\u0431\u0438\u0442\u044b\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendimi s\u00fcrekli yorgun ve bitkin hissetmek istemiyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e0d\u60f3\u603b\u662f\u611f\u5230\u75b2\u5026\u548c\u865a\u5f31\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e0d\u60f3\u4e00\u76f4\u611f\u5230\u75b2\u5026\u548c\u75b2\u618a\u3002"
          }
        }
      }
    },
    "assessment.health.q15.c": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich betrachte meinen K\u00f6rper als Maschine. Er muss reibungslos funktionieren, damit ich meine Ziele zerst\u00f6ren kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I view my body as a machine. It needs to function smoothly so I can destroy my targets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo mi cuerpo como una m\u00e1quina. Tiene que funcionar sin problemas para poder destruir mis objetivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je consid\u00e8re mon corps comme une machine. Il doit fonctionner correctement pour que je puisse d\u00e9truire mes cibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u094b \u090f\u0915 \u092e\u0936\u0940\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u0947\u0916\u0924\u093e \u0939\u0942\u0902\u0964 \u0907\u0938\u0947 \u0938\u0941\u091a\u093e\u0930\u0942 \u0930\u0942\u092a \u0938\u0947 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948 \u0924\u093e\u0915\u093f \u092e\u0948\u0902 \u0905\u092a\u0928\u0947 \u0932\u0915\u094d\u0937\u094d\u092f\u094b\u0902 \u0915\u094b \u0928\u0937\u094d\u091f \u0915\u0930 \u0938\u0915\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Considero il mio corpo come una macchina. Deve funzionare senza intoppi cos\u00ec posso distruggere i miei obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79c1\u306f\u81ea\u5206\u306e\u4f53\u3092\u6a5f\u68b0\u3068\u3057\u3066\u898b\u3066\u3044\u307e\u3059\u3002\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u7834\u58ca\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u6a5f\u80fd\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\ub294 \ub0b4 \ubab8\uc744 \uae30\uacc4\ub85c \ubcf8\ub2e4. \ubaa9\ud45c\ubb3c\uc744 \ud30c\uad34\ud558\ub824\uba74 \uc6d0\ud65c\ud558\uac8c \uc791\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik zie mijn lichaam als een machine. Het moet soepel functioneren, zodat ik mijn doelen kan vernietigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postrzegam swoje cia\u0142o jako maszyn\u0119. Musi dzia\u0142a\u0107 sprawnie, \u017cebym m\u00f3g\u0142 niszczy\u0107 cele."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vejo meu corpo como uma m\u00e1quina. Ele precisa funcionar sem problemas para que eu possa destruir meus alvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044e \u0441\u0432\u043e\u0451 \u0442\u0435\u043b\u043e \u043a\u0430\u043a \u043c\u0430\u0448\u0438\u043d\u0443. \u041e\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0431\u0435\u0437 \u0441\u0431\u043e\u0435\u0432, \u0447\u0442\u043e\u0431\u044b \u044f \u043c\u043e\u0433 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0446\u0435\u043b\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudumu bir makine gibi g\u00f6r\u00fcyorum. Hedeflerimi yok edebilmem i\u00e7in sorunsuz \u00e7al\u0131\u015fmas\u0131 gerekiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u628a\u6211\u7684\u8eab\u4f53\u770b\u4f5c\u4e00\u53f0\u673a\u5668\u3002\u5b83\u5fc5\u987b\u987a\u5229\u8fd0\u4f5c\uff0c\u8fd9\u6837\u6211\u624d\u80fd\u6467\u6bc1\u6211\u7684\u76ee\u6807\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5c07\u6211\u7684\u8eab\u9ad4\u8996\u70ba\u4e00\u53f0\u6a5f\u5668\u3002\u5b83\u9700\u8981\u9806\u5229\u904b\u884c\uff0c\u9019\u6a23\u6211\u624d\u80fd\u6467\u6bc0\u6211\u7684\u76ee\u6a19\u3002"
          }
        }
      }
    },
    "assessment.health.q15.d": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrlich gesagt? Ich habe gar keinen Antrieb, gesund zu sein, solange ich nicht krank bin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honestly? I have no motivation to be healthy unless I'm sick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfHonestamente? No tengo ninguna motivaci\u00f3n para estar sano a menos que est\u00e9 enfermo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Honn\u00eatement? Je n'ai aucune motivation pour \u00eatre en bonne sant\u00e9 \u00e0 moins d'\u00eatre malade."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0908\u092e\u093e\u0928\u0926\u093e\u0930\u0940 \u0938\u0947? \u091c\u092c \u0924\u0915 \u092e\u0948\u0902 \u092c\u0940\u092e\u093e\u0930 \u0928 \u0939\u094b \u091c\u093e\u090a\u0902, \u092e\u0941\u091d\u0947 \u0938\u094d\u0935\u0938\u094d\u0925 \u0930\u0939\u0928\u0947 \u0915\u0940 \u0915\u094b\u0908 \u092a\u094d\u0930\u0947\u0930\u0923\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Onestamente? Non ho alcuna motivazione per essere in salute a meno che non sia malato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u76f4\u306b\uff1f\u75c5\u6c17\u3067\u306a\u3051\u308c\u3070\u5065\u5eb7\u3067\u3042\u308a\u305f\u3044\u3068\u3044\u3046\u52d5\u6a5f\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc194\uc9c1\ud788? \uc544\ud504\uc9c0 \uc54a\uc73c\uba74 \uac74\uac15\ud560 \uc758\uc695\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerlijk gezegd? Ik heb geen motivatie om gezond te zijn tenzij ik ziek ben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczerze m\u00f3wi\u0105c? Nie mam motywacji, \u017ceby by\u0107 zdrowym, chyba \u017ce jestem chory."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Honestamente? N\u00e3o tenho motiva\u00e7\u00e3o para ser saud\u00e1vel, a menos que esteja doente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f? \u0423 \u043c\u0435\u043d\u044f \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435\u0442 \u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0431\u044b\u0442\u044c \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u043c, \u043f\u043e\u043a\u0430 \u044f \u043d\u0435 \u0431\u043e\u043b\u0435\u044e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00e7\u0131k\u00e7as\u0131? Hasta olmad\u0131\u011f\u0131m s\u00fcrece sa\u011fl\u0131kl\u0131 olmak i\u00e7in hi\u00e7bir motivasyonum yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf4\u5b9e\u8bdd\uff1f\u53ea\u8981\u6211\u6ca1\u751f\u75c5\uff0c\u6211\u5b8c\u5168\u6ca1\u6709\u52a8\u529b\u53bb\u4fdd\u6301\u5065\u5eb7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aa0\u5be6\u5730\uff1f\u9664\u975e\u6211\u751f\u75c5\u4e86\uff0c\u5426\u5247\u6211\u6c92\u6709\u52d5\u529b\u4fdd\u6301\u5065\u5eb7\u3002"
          }
        }
      }
    },
    "assessment.lifestyle.nav.title": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifestyle Assessment"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifestyle Assessment"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluaci\u00f3n de estilo de vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9valuation du mode de vie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0940\u0935\u0928\u0936\u0948\u0932\u0940 \u0915\u093e \u0906\u0915\u0932\u0928"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valutazione dello stile di vita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e9\u30a4\u30d5\u30b9\u30bf\u30a4\u30eb\u306e\u8a55\u4fa1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\ud65c\ubc29\uc2dd \ud3c9\uac00"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levensstijlbeoordeling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocena stylu \u017cycia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalia\u00e7\u00e3o do estilo de vida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0446\u0435\u043d\u043a\u0430 \u043e\u0431\u0440\u0430\u0437\u0430 \u0436\u0438\u0437\u043d\u0438"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya\u015fam Tarz\u0131 De\u011ferlendirmesi"
          }
        },
        "zh-Hans": {

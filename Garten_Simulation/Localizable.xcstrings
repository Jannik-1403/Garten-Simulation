    "prog_noalcohol_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wochenende beginnt. Wenn du unter Leute gehst, sei die Person, die sich als Erstes selbstbewusst ein Wasser oder AF-Bier bestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weekend begins. When you go out with people, be the person who confidently orders a water or AF beer first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza el fin de semana. Cuando salgas con gente, sé la persona que con confianza pide primero agua o cerveza AF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le week-end commence. Lorsque vous sortez avec du monde, soyez la personne qui commande en toute confiance une eau ou une bière AF en premier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताहांत शुरू होता है. जब आप लोगों के साथ बाहर जाते हैं, तो वह व्यक्ति बनें जो आत्मविश्वास से सबसे पहले पानी या एएफ बियर का ऑर्डर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia il fine settimana. Quando esci con le persone, sii la persona che ordina con sicurezza per prima un'acqua o una birra AF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末が始まります。誰かと出かけるときは、自信を持って最初に水かAFビールを注文する人になりましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말이 시작됩니다. 사람들과 외출할 때는 자신있게 물이나 AF맥주를 먼저 주문하는 사람이 되세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het weekend begint. Als je met mensen uitgaat, wees dan de persoon die zelfverzekerd als eerste een water- of AF-biertje bestelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna się weekend. Kiedy wychodzisz z ludźmi, bądź osobą, która jako pierwsza pewnie zamówi wodę lub piwo AF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim de semana começa. Quando você sai com outras pessoas, seja a pessoa que pede primeiro uma água ou uma cerveja AF com confiança."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim de semana começa. Quando você sai com outras pessoas, seja a pessoa que pede primeiro uma água ou uma cerveja AF com confiança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходные начинаются. Когда вы встречаетесь с людьми, будьте тем человеком, который первым с уверенностью заказывает воду или пиво AF."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonu başlıyor. İnsanlarla dışarı çıktığınızda, önce kendinize güvenerek su veya AF birası sipariş eden kişi olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周末开始了。当你与人外出时，首先自信地点一杯水或 AF 啤酒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週末開始了。當你與人外出時，首先自信地點一杯水或 AF 啤酒。"
          }
        }
      }
    },

    "item.zauberstab.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein magischer Stab, der 3 Tage lang automatisch das Unkraut wegzaubert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A magic wand that automatically removes weeds for 3 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una varita m\u00e1gica que elimina autom\u00e1ticamente las malas hierbas durante 3 d\u00edas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une baguette magique qui \u00e9limine automatiquement les mauvaises herbes pendant 3 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u091c\u093e\u0926\u0941\u0908 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u091c\u094b 3 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0916\u0930-\u092a\u0924\u0935\u093e\u0930 \u0939\u091f\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bacchetta magica che rimuove automaticamente le erbacce per 3 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3\u65e5\u9593\u81ea\u52d5\u3067\u96d1\u8349\u3092\u9664\u53bb\u3057\u3066\u304f\u308c\u308b\u9b54\u6cd5\u306e\u6756\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3\uc77c \ub3d9\uc548 \uc790\ub3d9\uc73c\ub85c \uc7a1\ucd08\ub97c \uc81c\uac70\ud574 \uc8fc\ub294 \ub9c8\uc220 \uc9c0\ud321\uc774\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een toverstaf die 3 dagen lang automatisch onkruid verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magiczna r\u00f3\u017cd\u017cka, kt\u00f3ra automatycznie usuwa chwasty na 3 dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma varinha m\u00e1gica que remove automaticamente as ervas daninhas durante 3 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u043b\u0448\u0435\u0431\u043d\u0430\u044f \u043f\u0430\u043b\u043e\u0447\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 3 \u0434\u043d\u0435\u0439 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u043e\u0440\u043d\u044f\u043a\u0438."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yabani otlar\u0131 3 g\u00fcn boyunca otomatik olarak temizleyen sihirli bir de\u011fnek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6839\u9b54\u6756\uff0c\u53ef\u57283\u5929\u5185\u81ea\u52a8\u6e05\u9664\u6742\u8349\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u80fd\u81ea\u52d5\u9664\u83493\u5929\u7684\u795e\u5947\u6cd5\u6756\u3002"
          }
        }
      }
    },

    "plant.mammutbaum.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gr\u00f6\u00dfter Baum der Welt \u2013 braucht alles \u2013 Jahresprojekt & Big Goal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest tree in the world \u2013 needs everything \u2013 Year project & Big Goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El \u00e1rbol m\u00e1s grande del mundo \u2013 Proyecto anual y Gran Objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arbre le plus grand du monde \u2013 Projet annuel & Grand objectif"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0928\u093f\u092f\u093e \u0915\u093e \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u093e \u092a\u0947\u0921\u093c \u2013 \u0938\u092c \u0915\u0941\u091b \u091a\u093e\u0939\u093f\u090f \u2013 \u0935\u093e\u0930\u094d\u0937\u093f\u0915 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0914\u0930 \u092c\u0921\u093c\u093e \u0932\u0915\u094d\u0937\u094d\u092f"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest tree in the world \u2013 needs everything \u2013 Year project & Big Goal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e16\u754c\u6700\u5927\u306e\u6728 \u2013 \u3059\u3079\u3066\u304c\u5fc5\u8981 \u2013 \u5e74\u9593\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3068\u5927\u304d\u306a\u76ee\u6a19"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc138\uacc4\uc5d0\uc11c \uac00\uc7a5 \ud070 \ub098\ubb34 \u2013 \ubaa8\ub4e0 \uac83\uc774 \ud544\uc694\ud568 \u2013 \uc5f0\ub3c4 \ud504\ub85c\uc81d\ud2b8 \ubc0f \ud070 \ubaa9\ud45c"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grootste boom ter wereld \u2013 heeft alles nodig \u2013 Jaarproject & Groot Doel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwi\u0119ksze drzewo na \u015bwiecie \u2013 potrzebuje wszystkiego \u2013 projekt roczny i wielki cel"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior \u00e1rvore do mundo \u2013 Projeto anual & Grande objetivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0430\u043c\u043e\u0435 \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u0434\u0435\u0440\u0435\u0432\u043e \u0432 \u043c\u0438\u0440\u0435 \u2013 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0441\u0435\u0433\u043e \u2013 \u0433\u043e\u0434\u043e\u0432\u043e\u0439 \u043f\u0440\u043e\u0435\u043a\u0442 \u0438 \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0446\u0435\u043b\u044c"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fcnyan\u0131n en b\u00fcy\u00fck a\u011fac\u0131 \u2013 her \u015feye ihtiyac\u0131 var \u2013 Y\u0131l Projesi ve B\u00fcy\u00fck Hedef"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e16\u754c\u4e0a\u6700\u5927\u7684\u6811 \u2013 \u9700\u8981\u4e00\u5207 \u2013 \u5e74\u5ea6\u9879\u76ee\u4e0e\u5927\u76ee\u6807"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e16\u754c\u4e0a\u6700\u5927\u7684\u6a39 - \u9700\u8981\u4e00\u5207 - \u5e74\u5ea6\u5c08\u6848\u548c\u5927\u76ee\u6a19"
          }
        }
      }
    },

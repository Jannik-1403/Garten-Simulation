            "value": "\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0444\u043e\u043a\u0443\u0441"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanmaya devam et"
          }

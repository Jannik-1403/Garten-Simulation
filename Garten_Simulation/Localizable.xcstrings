    "trash.negativitaets_feed.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet verschiedene Gartenbereiche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects different garden areas."
          }
        },
        "es": {

          "stringUnit": {
            "state": "translated",
            "value": "何の習慣のために？ (オプション)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 습관 때문에? (선택 과목)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor welke gewoonte? (Optioneel)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z jakiego nawyku? (Fakultatywny)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qual hábito? (Opcional)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qual hábito? (Opcional)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По какой привычке? (Необязательный)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi alışkanlık için? (İsteğe bağlı)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了什么习惯？ （选修的）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了什麼習慣？ （選修的）"
          }
        }
      }
    },
    "tour_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige deine Gewohnheiten, indem du den Fortschrittsbalken auf der Karte nach rechts schiebst, um die Pflanze wachsen zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete your habits by sliding the progress bar on the card to the right to make the plant grow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa tus hábitos deslizando la barra de progreso de la tarjeta hacia la derecha para hacer crecer la planta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accomplis tes habitudes en faisant glisser la barre de progression de la carte vers la droite pour faire grandir la plante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी आदतें पूरी करने के लिए कार्ड पर प्रगति बार को दाईं ओर खिसकाएं, ताकि पौधा बड़ा हो सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa le tue abitudini facendo scorrere la barra di progresso sulla scheda verso destra, per far crescere la pianta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップ上の進行状況バーを右にスライドさせて植物を成長させ、習慣を完成させましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식물을 키우려면 지도의 진행률 표시줄을 오른쪽으로 밀어 습관을 완성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi je gewoontes door de voortgangsbalk op de kaart naar rechts te schuiven om de plant te laten groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełnij swoje nawyki, przesuwając pasek postępu na mapie w prawo, aby wyhodować roślinę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa os teus hábitos deslizando a barra de progresso no cartão para a direita, para fazer a planta crescer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete seus hábitos deslizando a barra de progresso no cartão para a direita, para fazer a planta crescer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняй свои привычки, сдвигая полосу прогресса на карточке вправо, чтобы растение росло."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitkiyi yetiştirmek için haritadaki ilerleme çubuğunu sağa kaydırarak alışkanlıklarınızı tamamlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过将卡片上的进度条向右滑动来完成你的习惯，让植物成长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過將卡片上的進度條向右滑動來完成你的習慣，讓植物成長。"
          }
        }
      }
    },

    "inventory.seeds.info.body": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast momentan %d Samen. Pro Pflanze, die du erstellst, werden 10 Samen ben\u00f6tigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You currently have %d seeds. Creating a custom plant costs 10 seeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente tienes %d semillas. Crear una planta personalizada cuesta 10 semillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez actuellement %d graines. Cr\u00e9er une plante personnalis\u00e9e co\u00fbte 10 graines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938%d\u092c\u0940\u091c \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0924\u0948\u092f\u093e\u0930 \u0915\u093f\u090f \u0917\u090f \u092a\u094d\u0930\u0924\u093f \u092a\u094c\u0927\u0947 10 \u092c\u0940\u091c\u094b\u0902 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attualmente hai %d semi. Creare una pianta personalizzata costa 10 semi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728 %d \u500b\u306e\u30b7\u30fc\u30c9\u304c\u3042\u308a\u307e\u3059\u3002\u30ab\u30b9\u30bf\u30e0\u690d\u7269\u306e\u4f5c\u6210\u306b\u306f 10 \u500b\u306e\u7a2e\u5b50\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc7ac %d\uac1c\uc758 \uc528\uc557\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub9de\ucda4\ud615 \uc2dd\ubb3c\uc744 \ub9cc\ub4dc\ub294 \ub370\ub294 \uc528\uc557 10\uac1c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt momenteel %d zaden. Het maken van een aangepaste plant kost 10 zaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "You currently have %d seeds. Stworzenie niestandardowej ro\u015bliny kosztuje 10 nasion."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea tem atualmente %d sementes. Criar uma planta personalizada custa 10 sementes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0442\u0435\u0431\u044f \u0432 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442%d\u0441\u0435\u043c\u044f\u043d. \u041d\u0430 \u043a\u0430\u0436\u0434\u043e\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0442\u044b \u0441\u043e\u0437\u0434\u0430\u0451\u0448\u044c, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f 10 \u0441\u0435\u043c\u044f\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eu anda %d tohumun var. \u00d6zel bir bitki olu\u015fturmak 10 tohuma mal olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u76ee\u524d\u6709%d\u9897\u79cd\u5b50\u3002\u6bcf\u521b\u5efa\u4e00\u682a\u690d\u7269\u9700\u898110\u9897\u79cd\u5b50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u76ee\u524d\u64c1\u6709%d\u7a2e\u5b50\u3002\u60a8\u5275\u5efa\u7684\u6bcf\u682a\u690d\u7269\u9700\u8981 10 \u9846\u7a2e\u5b50\u3002"
          }
        }
      }
    },

    "prog_wakeup_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum stehst du so früh auf? Rufe dir dein wichtigstes Ziel des Tages in Erinnerung, noch während du die Decke zurückschlägst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why are you getting up so early? As you pull back the covers, remind yourself of your most important goal of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué te levantas tan temprano? Mientras retira las mantas, recuerde su objetivo más importante del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi tu te lèves si tôt ? En retirant les couvertures, rappelez-vous votre objectif le plus important de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम इतनी जल्दी क्यों उठ रहे हो? जैसे ही आप कवर वापस खींचते हैं, अपने आप को दिन के अपने सबसे महत्वपूर्ण लक्ष्य की याद दिलाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché ti alzi così presto? Mentre scosti le coperte, ricorda a te stesso il tuo obiettivo più importante della giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜそんなに早く起きるのですか？カバーを元に戻すときに、その日の最も重要な目標を思い出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 이렇게 일찍 일어나요? 덮개를 뒤로 젖힐 때 오늘의 가장 중요한 목표를 상기하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom sta je zo vroeg op? Terwijl u de dekens opentrekt, herinnert u uzelf aan uw belangrijkste doel van de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego wstajesz tak wcześnie? Odsuwając kołdrę, przypomnij sobie o swoim najważniejszym celu dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que você está acordando tão cedo? Ao puxar as cobertas, lembre-se do objetivo mais importante do dia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que você está acordando tão cedo? Ao puxar as cobertas, lembre-se do objetivo mais importante do dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему ты встаешь так рано? Откидывая одеяло, напомните себе о своей самой важной цели на день."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden bu kadar erken kalkıyorsun? Örtüleri geri çekerken kendinize günün en önemli hedefini hatırlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你为什么起这么早？当您拉开被子时，提醒自己当天最重要的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼起這麼早？當您拉開被子時，提醒自己當天最重要的目標。"
          }
        }
      }
    },

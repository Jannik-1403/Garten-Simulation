        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天花 2 分鐘真誠地讚美別人的成功。"
          }
        }
      }
    },
    "assessment.mental.profile.unerschuetterlicher.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist extrem mental stark. Um die letzten 1％ herauszuholen, musst du sicherstellen, dass du nicht arrogant oder abgestumpft wirst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are extremely mentally strong. To get that last 1％, you need to make sure you don't become arrogant or jaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres extremadamente fuerte mentalmente. Para obtener ese último 1％, debes asegurarte de no volverte arrogante ni hastiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes extrêmement fort mentalement. Pour obtenir ce dernier 1％, vous devez vous assurer de ne pas devenir arrogant ou blasé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप मानसिक रूप से बेहद मजबूत हैं. उस अंतिम 1％ को पाने के लिए, आपको यह सुनिश्चित करना होगा कि आप अहंकारी या थके हुए न बनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei estremamente forte mentalmente. Per ottenere quell'ultimo 1％, devi assicurarti di non diventare arrogante o stanco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは非常に精神的に強いです。最後の 1％ を獲得するには、傲慢になったり、うんざりしたりしないようにする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 정신적으로 매우 강합니다. 마지막 1％를 얻으려면 교만하거나 지치지 않도록 해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent mentaal enorm sterk. Om die laatste 1％ te krijgen, moet je ervoor zorgen dat je niet arrogant of afgemat wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś niezwykle silny psychicznie. Aby zdobyć ten ostatni 1％, musisz uważać, aby nie stać się aroganckim ani zblazowanym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é extremamente forte mentalmente. Para obter o último 1％, você precisa ter certeza de não se tornar arrogante ou cansado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты экстремально психологически сильный. Чтобы выжать последние 1％, ты должен убедиться, что не станешь высокомерным или черствым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zihinsel olarak son derece güçlüsünüz. Son ％1'i elde etmek için kibirli veya bitkin olmadığınızdan emin olmalısınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你精神非常强大。为了挖掘最后的1％，你必须确保自己不变得傲慢或麻木。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的心理素質非常強大。為了獲得最後 1％，您需要確保自己不會變得傲慢或厭倦。"
          }
        }
      }
    },

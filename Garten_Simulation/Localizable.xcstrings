        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5185\u306a\u308b\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3067\u958b\u82b1 \u2013 \u81ea\u5df1\u898f\u5f8b"
          }

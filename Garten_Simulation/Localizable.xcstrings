        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092e\u094d\u092e\u093e\u0928 \u2014 \u0924\u0941\u092e\u0928\u0947 \u0905\u092a\u0928\u093e \u0932\u0915\u094d\u0937\u094d\u092f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect \u2014 you reached your goal!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u656c\u610f\u3092\u8868\u3057\u307e\u3059 \u2014 \u3042\u306a\u305f\u306f\u76ee\u6a19\u3092\u9054\u6210\u3057\u307e\u3057\u305f!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc874\uacbd\ud569\ub2c8\ub2e4. \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uc168\uc2b5\ub2c8\ub2e4!"

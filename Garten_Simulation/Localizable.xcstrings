        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जीवन में सकारात्मक चीजों पर ध्यान केंद्रित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrati sulle cose positive della vita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人生のポジティブな面に焦点を当てましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삶의 긍정적인 면에 집중하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus je op de positieve dingen in het leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skup się na pozytywnych rzeczach w życiu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se nas coisas positivas da vida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se nas coisas positivas da vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сосредоточься на положительных вещах в жизни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayattaki olumlu şeylere odaklanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注于生活中的积极事物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注於生活中正面的事情。"
          }
        }
      }
    },
    "plant.korallenbusch.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wächst nur im richtigen Ökosystem – Freundschaften pflegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grows only in the right ecosystem – Nurturing friendships"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crece solo en el ecosistema correcto – Cultivar amistades"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse seulement dans le bon écosystème – Entretenir les amitiés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ सही पारिस्थितिकी तंत्र में ही बढ़ता है – दोस्ती निभाएं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce solo nel giusto ecosistema: mantenendo le amicizie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適切なエコシステムでのみ成長 – 友情を育む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 생태계에서만 성장합니다 – 우정 키우기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groeit alleen in het juiste ecosysteem – Het koesteren van vriendschappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rośnie tylko w odpowiednim ekosystemie – Pielęgnując przyjaźnie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce apenas no ecossistema certo – Cultivar amizades"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cresce apenas no ecossistema certo – Cultivar amizades"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Растет только в правильной экосистеме – поддерживать дружбу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca doğru ekosistemde büyür – Dostlukları beslemek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在正确的生态系统中生长 – 培养友谊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在正確的生態系中成長－維持友誼"
          }
        }
      }
    },

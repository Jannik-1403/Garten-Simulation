    "prog_coldshower_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasche dir das Gesicht zuerst mit kaltem Wasser und lass es dann über den ganzen Kopf laufen (stimuliert den Vagusnerv stark)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First wash your face with cold water and then run it all over your head (strongly stimulates the vagus nerve)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero lava tu cara con agua fría y luego pásala por toda tu cabeza (estimula fuertemente el nervio vago)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavez d’abord votre visage à l’eau froide puis passez-le sur toute votre tête (stimule fortement le nerf vague)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे पहले अपने चेहरे को ठंडे पानी से धोएं और फिर इसे अपने पूरे सिर पर चलाएं (वेगस तंत्रिका को दृढ़ता से उत्तेजित करता है)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavati prima il viso con acqua fredda e poi passala su tutta la testa (stimola fortemente il nervo vago)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず冷水で顔を洗い、それを頭全体に流します（迷走神経を強く刺激します）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 찬물로 세안한 후 머리 전체에 발라줍니다(미주신경을 강하게 자극합니다)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Was eerst je gezicht met koud water en laat het dan over je hele hoofd lopen (stimuleert de nervus vagus sterk)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw umyj twarz zimną wodą, a następnie rozprowadź ją po całej głowie (silnie pobudza nerw błędny)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro lave o rosto com água fria e depois passe na cabeça (estimula fortemente o nervo vago)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro lave o rosto com água fria e depois passe na cabeça (estimula fortemente o nervo vago)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала умойтесь холодной водой, а затем промойте ею голову (сильно стимулирует блуждающий нерв)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce yüzünüzü soğuk suyla yıkayın ve ardından başınızın her yerine sürün (vagus sinirini güçlü bir şekilde uyarır)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用冷水洗脸，然后用冷水冲洗整个头部（强烈刺激迷走神经）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先用冷水洗臉，然後用冷水沖洗整個頭部（強烈刺激迷走神經）。"
          }
        }
      }
    },

    "paywall.feature.coin_bonus.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdiene bei jedem Gießen und Erledigen von Aufgaben %@ mehr Münzen, um deinen Garten schneller wachsen zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn %@ more coins with every watering and completed task to grow your garden faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana un %@ más de monedas con cada riego y tarea completada para hacer crecer tu jardín más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne %@ de pièces en plus à chaque arrosage et tâche complétée pour faire grandir ton jardin plus vite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बगीचे को तेजी से विकसित करने के लिए हर बार पानी देने और कार्य पूरा करने पर %@ अधिक सिक्के अर्जित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagna il %@ in più di monete con ogni annaffiatura e attività completata per far crescere il tuo giardino più velocemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "庭をより速く育てるために、水やりやタスク完了のたびに%@多くのコインを獲得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원을 더 빨리 키우기 위해 물을 줄 때나 작업을 완료할 때마다 %@ 더 많은 코인을 획득하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien %@ meer munten bij elke waterbeurt en voltooide taak om je tuin sneller te laten groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarabiaj o %@ więcej monet za każde podlewanie i wykonane zadanie, aby szybciej rozwijać swój ogród."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhe %@ mais moedas a cada rega e tarefa concluída para cultivar seu jardim mais rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhe %@ mais moedas a cada rega e tarefa concluída para cultivar seu jardim mais rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарабатывайте на %@ больше монет за каждый полив и выполнение заданий, чтобы ваш сад рос быстрее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahçenizi daha hızlı büyütmek için her sulamada ve tamamlanan görevde %@25 daha fazla jeton kazanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次浇水和完成任务时，可额外获得%@的硬币，让您的花园更快成长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次澆水並完成任務時，您可以多賺取 %@ 的金幣，讓您的花園生長得更快。"
          }
        }
      }
    },

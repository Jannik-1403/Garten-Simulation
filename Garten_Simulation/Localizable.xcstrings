    "tour_prompt_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du eine kurze Einführung in die wichtigsten Funktionen von Zalimo Habits erhalten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Would you like a quick tour of the main features of Zalimo Habits?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Le gustaría un recorrido rápido por las características principales de Zalimo Habits?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous un tour rapide des principales fonctionnalités de Zalimo Habits ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप Zalimo Habits की मुख्य सुविधाओं का एक संक्षिप्त परिचय प्राप्त करना चाहते हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Desideri un rapido tour delle principali funzionalità di Zalimo Habits?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits の主な機能について簡単に説明してみませんか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits의 주요 기능을 빠르게 살펴보고 싶으신가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wilt u een korte rondleiding door de belangrijkste functies van Zalimo Habits?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz szybko zapoznać się z głównymi funkcjami Zalimo Habits?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de um tour rápido pelos principais recursos do Zalimo Habits?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de um tour rápido pelos principais recursos do Zalimo Habits?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите быстро познакомиться с ключевыми функциями Zalimo Habits?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalimo Habits'nin ana özelliklerine hızlı bir tur atmak ister misiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想快速了解 Zalimo Habits 的主要功能吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您想快速了解 Zalimo Habits 的主要功能嗎？"
          }
        }
      }
    },

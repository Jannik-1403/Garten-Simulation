    "prog_cooking_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koche heute die doppelte oder dreifache Menge, damit du Montag und Dienstag direkt Tupperdosen für die Arbeit/Uni hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook double or triple the amount today so that you have Tupperware for work/university on Monday and Tuesday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina el doble o el triple de cantidad hoy para tener Tupperware para el trabajo/universidad los lunes y martes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuisinez le double ou le triple de la quantité aujourd'hui afin d'avoir des Tupperware pour le travail/l'université lundi et mardi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज दोगुनी या तिगुनी मात्रा में पकाएं ताकि आपके पास सोमवार और मंगलवार को काम/विश्वविद्यालय के लिए टपरवेयर हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cucina il doppio o il triplo della quantità oggi in modo da avere Tupperware per il lavoro/università il lunedì e il martedì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は2倍か3倍の量を調理して、月曜と火曜に仕事や大学に使えるタッパーウェアを用意しておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월요일과 화요일에 업무/대학에 사용할 Tupperware를 사용할 수 있도록 오늘 양을 두 배 또는 세 배로 요리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kook vandaag de dubbele of drievoudige hoeveelheid, zodat je op maandag en dinsdag Tupperware voor je werk/universiteit hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugotuj dzisiaj podwójną lub potrójną ilość, aby mieć Tupperware do pracy/na uczelni w poniedziałek i wtorek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe o dobro ou o triplo da quantidade hoje para ter Tupperware para o trabalho/universidade na segunda e terça-feira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe o dobro ou o triplo da quantidade hoje para ter Tupperware para o trabalho/universidade na segunda e terça-feira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приготовьте сегодня вдвое или втрое больше еды, чтобы в понедельник и вторник у вас была посуда Tupperware для работы/университета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesi ve Salı günleri iş/üniversite için Tupperware'inizin olması için bugün miktarı iki veya üç katına çıkarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天煮两倍或三倍的量，这样你周一和周二就能在工作/大学里吃到特百惠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天煮兩倍或三倍的量，這樣你週一和週二就能在工作/大學裡吃到特百惠。"
          }
        }
      }
    },

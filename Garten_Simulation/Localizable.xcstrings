    "pfad_lernen_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies heute genau 5 Seiten in einem Buch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read exactly 5 pages in a book today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee hoy exactamente 5 p\u00e1ginas de un libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis exactement 5 pages d'un livre aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u090f\u0915 \u0915\u093f\u0924\u093e\u092c \u0915\u0947 \u0920\u0940\u0915 5 \u092a\u0928\u094d\u0928\u0947 \u092a\u0922\u093c\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi esattamente 5 pagine di un libro oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f\u672c\u3092\u3061\u3087\u3046\u3069 5 \u30da\u30fc\u30b8\u8aad\u307f\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298 \ucc45 \ud55c \uad8c\uc744 \uc815\ud655\ud788 5\ud398\uc774\uc9c0 \uc77d\uc5b4 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees vandaag precies 5 pagina's in een boek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj dzisiaj dok\u0142adnie 5 stron ksi\u0105\u017cki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00ea exatamente 5 p\u00e1ginas num livre hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0447\u0438\u0442\u0430\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0440\u043e\u0432\u043d\u043e 5 \u0441\u0442\u0440\u0430\u043d\u0438\u0446 \u0432 \u043a\u043d\u0438\u0433\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn bir kitaptan tam olarak 5 sayfa okuyun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u7cbe\u786e\u9605\u8bfb\u4e00\u672c\u4e66\u76845\u9875\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u8b80\u5b8c\u4e00\u672c\u66f8\u7684 5 \u9801\u3002"
          }
        }
      }
    },

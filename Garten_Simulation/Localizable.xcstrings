    "level_up_spin_verdient_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe das Rad f\u00fcr M\u00fcnzen, Power-Ups und Pflanzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spin the wheel for coins, power-ups, and plants"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la ruleta para conseguir monedas, power-ups y plantas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la roue pour des pi\u00e8ces, des power-ups et des plantes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0915\u094d\u0915\u094b\u0902, \u092a\u093e\u0935\u0930-\u0905\u092a \u0914\u0930 \u092a\u094c\u0927\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u093f\u092f\u093e \u0918\u0941\u092e\u093e\u090f\u0901"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spin the wheel for coins, power-ups, and plants"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30db\u30a4\u30fc\u30eb\u3092\u56de\u3057\u3066\u30b3\u30a4\u30f3\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3001\u690d\u7269\u3092\u5165\u624b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub8f0\ub81b\uc744 \ub3cc\ub824 \ucf54\uc778, \ud30c\uc6cc\uc5c5, \uc2dd\ubb3c\uc744 \uc5bb\uc73c\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai aan het wiel voor munten, power-ups en planten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakr\u0119\u0107 ko\u0142em, aby zdoby\u0107 monety, ulepszenia i ro\u015bliny"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira a roda para moedas, power-ups e plantas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0440\u0443\u0442\u0438 \u043a\u043e\u043b\u0435\u0441\u043e \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u043e\u043d\u0435\u0442, \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0439 \u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u0439"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paralar, g\u00fc\u00e7lendiriciler ve bitkiler i\u00e7in \u00e7ark\u0131 d\u00f6nd\u00fcr\u00fcn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f6c\u52a8\u8f6e\u76d8\u8d62\u53d6\u91d1\u5e01\u3001\u5f3a\u5316\u9053\u5177\u548c\u690d\u7269"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65cb\u8f49\u8f2a\u5b50\u7372\u5f97\u91d1\u5e63\u3001\u80fd\u91cf\u9053\u5177\u548c\u690d\u7269"
          }
        }
      }
    },

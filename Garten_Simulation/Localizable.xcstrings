    "xp_info.description": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahrungspunkte (XP) spiegeln deinen gärtnerischen Fleiß wider! Du erhältst XP für das tägliche Gießen deiner Pflanzen. Je mehr XP du sammelst, desto höher steigt das Level deines Gartens, was exklusive neue Pflanzen und Schlechte Gewohnheiten freischaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experience points (XP) reflect your gardening diligence! You earn XP for watering your plants daily. The more XP you collect, the higher your garden level rises, unlocking exclusive new plants and bad habits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Los puntos de experiencia (XP) reflejan tu constancia en la jardinería! Obtienes XP por regar tus plantas a diario. Cuantos más XP acumules, más subirá el nivel de tu jardín, desbloqueando nuevas plantas y decoraciones exclusivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points d'expérience (XP) reflètent votre assiduité au jardinage ! Vous gagnez des XP en arrosant vos plantes quotidiennement. Plus vous accumulez de XP, plus le niveau de votre jardin augmente, débloquant de nouvelles plantes et décorations exclusives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुभव अंक (XP) तुम्हारी बागवानी मेहनत को दर्शाते हैं! तुम्हें अपने पौधों को रोज़ पानी देने के लिए XP मिलते हैं। जितने अधिक XP तुम जमा करते हो, तुम्हारे बगीचे का स्तर उतना ही बढ़ता है, जो विशेष नए पौधों और बुरी आदतों को अनलॉक करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punti esperienza (XP) riflettono la tua diligenza nel giardinaggio! Guadagni XP innaffiando le tue piante ogni giorno. Più XP accumuli, più sale il livello del tuo giardino, sbloccando nuove piante e decorazioni esclusive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経験値 (XP) はあなたのガーデニングの熱心さを反映します!毎日植物に水をやることで XP を獲得できます。より多くの XP を収集するほど、庭のレベルが上がり、限定の新しい植物や装飾品のロックが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경험치(XP)는 귀하의 정원 가꾸기 노력을 반영합니다! 매일 식물에 물을 주면 XP를 얻을 수 있습니다. 더 많은 XP를 수집할수록 정원 레벨이 올라가고 독점적인 새로운 식물과 장식이 잠금 해제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ervaringspunten (XP) weerspiegelen uw toewijding bij het tuinieren! Je verdient XP door je planten dagelijks water te geven. Hoe meer XP je verzamelt, hoe hoger je tuinniveau stijgt, waardoor exclusieve nieuwe planten en decoraties worden ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkty doświadczenia (XP) odzwierciedlają Twoją pracowitość w ogrodnictwie! Zdobywasz XP za codzienne podlewanie roślin. Im więcej XP zbierzesz, tym wyżej wzrośnie poziom Twojego ogrodu, odblokowując nowe, ekskluzywne rośliny i dekoracje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos de experiência (XP) refletem a tua dedicação na jardinagem! Ganhas XP ao regar as tuas plantas diariamente. Quanto mais XP acumulares, maior será o nível do teu jardim, desbloqueando novas plantas e decorações exclusivas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos de experiência (XP) refletem a tua dedicação na jardinagem! Ganhas XP ao regar as tuas plantas diariamente. Quanto mais XP acumulares, maior será o nível do teu jardim, desbloqueando novas plantas e decorações exclusivas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очки опыта (XP) отражают ваш тяжелый труд в саду! Вы получаете XP за ежедневный полив растений. Чем больше опыта вы соберете, тем выше будет уровень вашего сада, открывая новые эксклюзивные растения и вредные привычки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneyim puanları (XP) bahçecilik konusundaki çabanızı yansıtır! Bitkilerinizi günlük olarak suladığınız için XP kazanırsınız. Ne kadar çok XP toplarsanız bahçe seviyeniz o kadar yükselir ve özel yeni bitki ve dekorasyonların kilidini açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经验值（XP）反映了你的园艺努力！您每天浇灌植物即可获得 XP。您收集的 XP 越多，您的花园等级就越高，解锁专属的新植物和坏习惯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經驗值（XP）反映了你的園藝努力！您每天澆灌植物即可獲得 XP。您收集的 XP 越多，您的花園等級就越高，解鎖專屬的新植物和壞習慣。"
          }
        }
      }
    },

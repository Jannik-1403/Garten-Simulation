    "prog_screentime_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein YouTube, kein TikTok, kein TV während deiner Mahlzeiten. Kau und schmecke dein Essen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No YouTube, no TikTok, no TV during your meals. Chew and taste your food."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de YouTube, nada de TikTok, nada de televisión durante las comidas. Mastica y prueba tu comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de YouTube, pas de TikTok, pas de télé pendant vos repas. Mâchez et goûtez votre nourriture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके भोजन के दौरान कोई यूट्यूब, कोई टिकटॉक, कोई टीवी नहीं। अपने भोजन को चबाएं और चखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente YouTube, niente TikTok, niente TV durante i pasti. Mastica e assapora il tuo cibo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事中は YouTube も TikTok もテレビも禁止です。食べ物をよく噛んで味わいましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사 중에는 YouTube, TikTok, TV가 없습니다. 음식을 씹고 맛보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen YouTube, geen TikTok, geen tv tijdens je maaltijden. Kauw en proef je eten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnego YouTube'a, żadnego TikToka, żadnego telewizora podczas posiłków. Żuj i smakuj jedzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de YouTube, nada de TikTok, nada de TV durante as refeições. Mastigue e experimente sua comida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de YouTube, nada de TikTok, nada de TV durante as refeições. Mastigue e experimente sua comida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни YouTube, ни TikTok, ни телевизора во время еды. Жуйте и пробуйте еду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yemekleriniz sırasında YouTube yok, TikTok yok, TV yok. Yemeğinizi çiğneyin ve tadına bakın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吃饭时不能看 YouTube、不能看 TikTok、不能看电视。咀嚼并品尝食物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "吃飯時不能看 YouTube、不能看 TikTok、不能看電視。咀嚼並品嚐食物。"
          }
        }
      }
    },

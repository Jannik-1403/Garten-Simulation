    "pfad_mental_day_1_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir heute 2 Minuten nur zum Atmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take 2 minutes today just to breathe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3mate 2 minutos hoy solo para respirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends 2 minutes aujourd'hui juste pour respirer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0938\u093f\u0930\u094d\u092b \u0938\u093e\u0902\u0938 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 2 \u092e\u093f\u0928\u091f \u0915\u093e \u0938\u092e\u092f \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi 2 minuti oggi solo per respirare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306f 2 \u5206\u9593\u3060\u3051\u606f\u3092\u5438\u3063\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298\uc740 2\ubd84\ub9cc \ud638\ud761\ud574 \ubcf4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem vandaag 2 minuten de tijd om adem te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po\u015bwi\u0119\u0107 dzisiaj 2 minuty na oddychanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 2 minutos hoje s\u00f3 para respirar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0432\u0435\u0434\u0438 \u0441\u0435\u0431\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0434\u044b\u0445\u0430\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn sadece nefes almaya 2 dakika ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u82b12\u5206\u949f\u53ea\u7528\u4e8e\u547c\u5438\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929\u82b1 2 \u5206\u9418\u547c\u5438\u4e00\u4e0b\u3002"
          }
        }
      }
    },

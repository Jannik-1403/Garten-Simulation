    "pfad_abschluss_desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unglaublich! Du hast 90 Tage am Stück gemeistert. Hier ist deine wohlverdiente Belohnung:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incredible! You mastered 90 days in a row. Here is your well-deserved reward:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Increíble! Has dominado 90 días seguidos. Aquí tienes tu bien merecida recompensa:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incroyable ! Tu as maîtrisé 90 jours d'affilée. Voici ta récompense bien méritée :"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अविश्वसनीय! आपने लगातार 90 दिनों में महारत हासिल कर ली है। यहाँ आपका सुयोग्य इनाम है:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incredibile! Hai dominato 90 giorni di fila. Ecco la tua meritata ricompensa:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信じられない！ You mastered 90 days in a row.これが当然の報酬です:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믿을 수 없는! 90일 연속으로 마스터하셨습니다. 여기 당신이 받을 만한 보상이 있습니다:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongelooflijk! Je hebt het 90 dagen achter elkaar onder de knie. Hier is uw welverdiende beloning:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niesamowity! Osiągałeś mistrzostwo przez 90 dni z rzędu. Oto Twoja zasłużona nagroda:"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incrível! Dominaste 90 dias seguidos. Aqui tens a tua merecida recompensa:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невероятно! Ты продержался 90 дней подряд. Вот твоя заслуженная награда:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnanılmaz! Art arda 90 gün ustalaştınız. İşte hak ettiğiniz ödülünüz:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太棒了！您已连续坚持90天。这是您应得的奖励："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極好的！你已經連續90天掌握了。這是您應得的獎勵："
          }
        }
      }
    },

    "assessment.lifestyle.q5" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du betrittst einen Raum voller Fremder (z.B. ein Klassenzimmer oder ein Event). Wie ist deine Körpersprache?"

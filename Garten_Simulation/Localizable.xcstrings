    "trash.alkohol_flatrate.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein klarer Kopf und ein gesunder Körper durch ein alkoholfreies Leben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clear mind and a healthy body through an alcohol-free life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente clara y un cuerpo sano a través de una vida sin alcohol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esprit clair et un corps sain grâce à une vie sans alcool."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्पष्ट दिमाग और स्वस्थ शरीर बिना शराब वाली जिंदगी के माध्यम से।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mente lucida e un corpo sano attraverso una vita senza alcol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルコールのない生活を通じて、クリアな心と健康な体を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무알코올 생활을 통한 맑은 정신과 건강한 몸."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een heldere geest en een gezond lichaam door een alcoholvrij leven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty umysł i zdrowe ciało dzięki życiu wolnemu od alkoholu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mente clara e um corpo são através de uma vida sem álcool."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mente clara e um corpo são através de uma vida sem álcool."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ясная голова и здоровое тело через безалкогольную жизнь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkolsüz bir yaşamla berrak bir zihin ve sağlıklı bir vücut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过无酒精的生活保持清醒的头脑和健康的身体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過無酒精的生活保持清醒的頭腦和健康的身體。"
          }
        }
      }
    },
    "trash.alkohol_flatrate.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Alkohol trinken) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Drinking alcohol) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Beber alcohol) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Boire de l'alcool) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (शराब पीना) लंबे समय में तुम्हारी ऊर्जा, समय और पैसा खर्च करती है। यह तुम्हें अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Bere alcolici) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣（飲酒）は、長期的にはエネルギー、時間、お金を消費します。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(음주)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (alcohol drinken) kost je op de lange termijn energie, tijd en geld. Het verhindert dat je je volledige potentieel bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (picie alkoholu) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Beber álcool) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Beber álcool) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (употребление алкоголя) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (Alkol içmek) uzun vadede sana enerji, zaman ve para kaybettirir. Tam potansiyeline ulaşmanı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（饮酒）会消耗您的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，這種習慣（飲酒）會消耗您的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

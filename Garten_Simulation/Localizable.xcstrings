    "shop.purchase_success.powerup_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Garten unter Power-Ups antippen \u2013 dann auf \u201eBenutzen\u201c tippen, um es einzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it under Power-Ups in your garden, then tap Use to activate it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3calo en Power-Ups en tu jard\u00edn y luego pulsa Usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie dessus dans Power-Ups du jardin, puis sur Utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0917\u0940\u091a\u0947 \u092e\u0947\u0902 \u092a\u093e\u0935\u0930-\u0905\u092a\u094d\u0938 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902 \u2013 \u092b\u093f\u0930 \u0907\u0938\u0947 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccalo in Power-Ups nel giardino, poi premi Usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5ead\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u4e0b\u3067\u305d\u308c\u3092\u30bf\u30c3\u30d7\u3057\u3001\u300c\u4f7f\u7528\u300d\u3092\u30bf\u30c3\u30d7\u3057\u3066\u6709\u52b9\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc815\uc6d0\uc758 \ud30c\uc6cc\uc5c5 \uc544\ub798\uc5d0\uc11c \ud0ed\ud55c \ub2e4\uc74c \uc0ac\uc6a9\uc744 \ud0ed\ud558\uc5ec \ud65c\uc131\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik erop onder Power-ups in je tuin en tik vervolgens op Gebruiken om het te activeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij w opcj\u0119 Power-Ups w swoim ogrodzie, a nast\u0119pnie stuknij opcj\u0119 U\u017cyj, aby j\u0105 aktywowa\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Power-Ups no jardim e depois em Usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0441\u0430\u0434\u0443 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u2014 \u0437\u0430\u0442\u0435\u043c \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u00bb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u0435\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bah\u00e7enizdeki G\u00fc\u00e7lendirmeler alt\u0131nda buna dokunun, ard\u0131ndan etkinle\u015ftirmek i\u00e7in Kullan'a dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u82b1\u56ed\u4e2d\uff0c\u70b9\u51fb\u201cPower-Ups\u201d\u4e0b\u65b9 - \u7136\u540e\u70b9\u51fb\u201c\u4f7f\u7528\u201d\u6765\u4f7f\u7528\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u82b1\u5712\u4e2d\uff0c\u9ede\u64ca\u300cPower-Ups\u300d\u4e0b\u65b9 - \u7136\u5f8c\u9ede\u64ca\u300c\u4f7f\u7528\u300d\u4f86\u4f7f\u7528\u5b83\u3002"
          }
        }
      }
    },

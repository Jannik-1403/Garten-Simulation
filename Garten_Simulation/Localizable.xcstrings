    "plant.sonnenblume.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte fr\u00fch und voller Energie in den neuen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start early and full of energy into the new day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza temprano y lleno de energ\u00eda el nuevo d\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez t\u00f4t et plein d'\u00e9nergie dans la nouvelle journ\u00e9e."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u090f \u0926\u093f\u0928 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u091c\u0932\u094d\u0926\u0940 \u0914\u0930 \u090a\u0930\u094d\u091c\u093e \u0938\u0947 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia presto e pieno di energia la nuova giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u304f\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u306b\u6e80\u3061\u305f\u65b0\u3057\u3044\u4e00\u65e5\u3092\u59cb\u3081\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\ucc0d \uc77c\uc5b4\ub098 \uc5d0\ub108\uc9c0 \ub118\uce58\ub294 \uc0c8\ub85c\uc6b4 \ud558\ub8e8\ub97c \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin vroeg en vol energie aan de nieuwe dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij wcze\u015bnie i pe\u0142en energii nowy dzie\u0144."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece cedo e cheio de energia no novo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0447\u0438\u043d\u0430\u0439 \u043d\u043e\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u0440\u0430\u043d\u043e \u0438 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0435\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni g\u00fcne erken ve enerji dolu ba\u015flay\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u8d77\uff0c\u5145\u6ee1\u6d3b\u529b\u5730\u5f00\u59cb\u65b0\u7684\u4e00\u5929\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e9\u9ede\u958b\u59cb\u65b0\u7684\u4e00\u5929\uff0c\u5145\u6eff\u6d3b\u529b\u3002"
          }
        }
      }
    },

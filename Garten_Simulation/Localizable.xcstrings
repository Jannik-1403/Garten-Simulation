    "assessment.feedback.needs_work.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Ergebnis zeigt, dass du aktuell einige Herausforderungen hast. Keine Sorge, genau dafür sind wir hier – lass uns gemeinsam Schritt für Schritt daran arbeiten!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This result shows that you currently face some challenges. Don't worry, that's exactly what we're here for – let's work on it together step by step!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este resultado muestra que actualmente tienes algunos desafíos. No te preocupes, para eso estamos aquí. ¡Vamos a trabajar en ello paso a paso!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce résultat montre que vous faites actuellement face à des défis. Ne vous inquiétez pas, c'est exactement pour cela que nous sommes là – travaillons-y ensemble étape par étape !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह परिणाम दर्शाता है कि वर्तमान में आपके सामने कुछ चुनौतियाँ हैं। चिंता न करें, हम बिल्कुल इसी लिए यहां आए हैं - आइए इस पर कदम दर कदम मिलकर काम करें!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo risultato mostra che attualmente hai alcune sfide. Non preoccuparti, siamo qui proprio per questo: lavoriamoci insieme passo dopo passo!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この結果は、現在あなたがいくつかの課題に直面していることを示しています。心配しないでください。そのために私たちがここにいるのです。一歩一歩一緒に取り組んでいきましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 결과는 현재 당신이 몇 가지 어려움에 직면해 있음을 보여줍니다. 걱정하지 마세요. 그게 바로 우리가 여기 있는 이유입니다. 한 걸음씩 함께 해결해 나갑시다!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit resultaat laat zien dat je momenteel voor enkele uitdagingen staat. Maak je geen zorgen, dat is precies waar we voor zijn – laten we er samen stap voor stap aan werken!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten wynik pokazuje, że obecnie stoisz przed pewnymi wyzwaniami. Nie martw się, po to tu jesteśmy – popracujmy nad tym razem krok po kroku!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este resultado mostra que atualmente tens alguns desafios. Não te preocupes, é exatamente para isso que estamos aqui - vamos trabalhar nisso juntos passo a passo!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот результат показывает, что у тебя в настоящее время есть некоторые трудности. Не волнуйся, именно для этого мы здесь – давай работать над этим вместе шаг за шагом!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sonuç şu anda bazı zorluklarla karşı karşıya olduğunuzu gösteriyor. Merak etmeyin, tam da bunun için buradayız – hadi birlikte adım adım üzerinde çalışalım!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个结果显示，你目前遇到了一些挑战。别担心，这正是我们在这里的原因——让我们一起一步一步地努力解决它们！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此結果表明您目前面臨一些挑戰。別擔心，這正是我們來這裡的目的——讓我們一起努力，一步一步！"
          }
        }
      }
    },

            "state": "translated",
            "value": "이벤트는 밤 11시까지만 계획하세요 – 그 후에는 집에 가세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan evenementen nog maar tot 23 uur – daarna naar huis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planuj imprezy tylko do 23 – potem wróć do domu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje eventos apenas até as 23h – depois vá para casa."

    "pflanze.wiederbeleben.beschreibung" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Pflanze war %d Tage nicht gegossen. Nach der Wiederbelebung erhältst du für 3 Tage weniger XP und Münzen beim Gießen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plant hasn't been watered for %d days. After revival, you'll earn less XP and coins for 3 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta planta no ha sido regada durante %d días. Tras revivirla, ganarás menos XP y monedas durante 3 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette plante n'a pas été arrosée depuis %d jours. Après la réanimation, tu gagneras moins de XP et de pièces pendant 3 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पौधे को%dदिनों तक पानी नहीं दिया गया। पुनर्जीवित होने के बाद, आपको 3 दिनों तक कास्टिंग से कम XP और सिक्के प्राप्त होंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plant hasn't been watered for %d days. After revival, you'll earn less XP and coins for 3 days."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この植物は %d 日間水やりをしていません。復活後、3 日間獲得できる XP とコインが少なくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 식물에 %d일 동안 물을 주지 않았습니다. 부활 후에는 3일 동안 더 적은 XP와 코인을 획득하게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze plant heeft al %d dagen geen water gekregen. Na de heropleving verdien je gedurende 3 dagen minder XP en munten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta roślina nie była podlewana przez %d dni. Po odrodzeniu będziesz zdobywał mniej PD i monet przez 3 dni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta planta não foi regada durante %d dias. Após a revivificação, ganharás menos XP e moedas durante 3 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это растение не поливали%dдней. После оживления вы получаете за полив на 3 дня меньше опыта и монет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bitki %d gündür sulanmıyor. Dirilişten sonra 3 gün boyunca daha az XP ve jeton kazanacaksınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这株植物已 %d 天未浇水。复活后，您在浇水时获得的经验值和金币将在3天内减少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該植物已經%d天沒有澆水。復活後，您將在 3 天內獲得更少的 XP 和鑄造金幣。"
          }
        }
      }
    },

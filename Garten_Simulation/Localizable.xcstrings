    "assessment.growth.profile.macher.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide es, Aufgaben anderer zu \u00fcbernehmen, nur weil du es 'schneller' erledigen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid taking on other people's tasks just because you can do it 'quicker'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite asumir tareas de otras personas s\u00f3lo porque puede hacerlo \"m\u00e1s r\u00e1pido\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9vitez de vous charger des t\u00e2ches des autres simplement parce que vous pouvez les faire \u00ab plus rapidement \u00bb."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0942\u0938\u0930\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0915\u093e\u092e \u0938\u093f\u0930\u094d\u092b\u093c \u0907\u0938\u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u090a\u092a\u0930 \u0932\u0947\u0928\u0947 \u0938\u0947 \u092c\u091a\u0947\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u092a \u0907\u0938\u0947 '\u0924\u0947\u091c\u093c\u0940 \u0938\u0947' \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita di assumerti i compiti di altre persone solo perch\u00e9 puoi farlo \"pi\u00f9 velocemente\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u5206\u306e\u307b\u3046\u304c\u300c\u65e9\u304f\u300d\u3067\u304d\u308b\u304b\u3089\u3068\u3044\u3063\u3066\u3001\u4ed6\u306e\u4eba\u306e\u30bf\u30b9\u30af\u3092\u5f15\u304d\u53d7\u3051\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e8\uc9c0 '\ub354 \ube68\ub9ac' \ud560 \uc218 \uc788\ub2e4\ub294 \uc774\uc720\ub9cc\uc73c\ub85c \ub2e4\ub978 \uc0ac\ub78c\uc758 \uc791\uc5c5\uc744 \ub5a0\ub9e1\ub294 \uac83\uc744 \ud53c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem niet de taken van anderen over, alleen maar omdat u het 'sneller' kunt doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj podejmowania zada\u0144 innych os\u00f3b tylko dlatego, \u017ce mo\u017cesz to zrobi\u0107 \u201eszybciej\u201d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite assumir tarefas de outras pessoas s\u00f3 porque voc\u00ea pode fazer isso \u201cmais r\u00e1pido\u201d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0431\u0435\u0433\u0430\u0439 \u0431\u0440\u0430\u0442\u044c \u043d\u0430 \u0441\u0435\u0431\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u0434\u0440\u0443\u0433\u0438\u0445, \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0438\u0445 \u00ab\u0431\u044b\u0441\u0442\u0440\u0435\u0435\u00bb."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131rf 'daha h\u0131zl\u0131' yapabilece\u011finiz i\u00e7in ba\u015fkalar\u0131n\u0131n g\u00f6revlerini \u00fcstlenmekten ka\u00e7\u0131n\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u4ec5\u4ec5\u56e0\u4e3a\u4f60\u80fd\u66f4\u5feb\u5b8c\u6210\u5c31\u63a5\u624b\u522b\u4eba\u7684\u4efb\u52a1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u907f\u514d\u50c5\u50c5\u56e0\u70ba\u4f60\u53ef\u4ee5\u300c\u66f4\u5feb\u300d\u5730\u5b8c\u6210\u5176\u4ed6\u4eba\u7684\u4efb\u52d9\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.macher.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentiere jeden Freitag f\u00fcr 5 Minuten einen Prozess per Video, um ihn in Zukunft delegieren zu k\u00f6nnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document a process on video for 5 minutes every Friday so you can delegate it in the future."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenta un proceso en v\u00eddeo durante 5 minutos todos los viernes para poder delegarlo en el futuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentez un processus en vid\u00e9o pendant 5 minutes chaque vendredi afin de pouvoir le d\u00e9l\u00e9guer \u00e0 l'avenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0936\u0941\u0915\u094d\u0930\u0935\u093e\u0930 \u0915\u094b 5 \u092e\u093f\u0928\u091f \u0915\u0947 \u0932\u093f\u090f \u0935\u0940\u0921\u093f\u092f\u094b \u092a\u0930 \u090f\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u0940\u0915\u0930\u0923 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0906\u092a \u0907\u0938\u0947 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0938\u094c\u0902\u092a \u0938\u0915\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenta un processo in video per 5 minuti ogni venerd\u00ec in modo da poterlo delegare in futuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u9031\u91d1\u66dc\u65e5\u306b 5 \u5206\u9593\u30d7\u30ed\u30bb\u30b9\u3092\u30d3\u30c7\u30aa\u3067\u8a18\u9332\u3057\u3001\u5c06\u6765\u305d\u308c\u3092\u59d4\u4efb\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\uc911\uc5d0 \uc704\uc784\ud560 \uc218 \uc788\ub3c4\ub85d \ub9e4\uc8fc \uae08\uc694\uc77c 5\ubd84 \ub3d9\uc548 \ud504\ub85c\uc138\uc2a4\ub97c \ube44\ub514\uc624\ub85c \ubb38\uc11c\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Documenteer elke vrijdag gedurende 5 minuten een proces op video, zodat u dit in de toekomst kunt delegeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentuj proces na wideo przez 5 minut w ka\u017cdy pi\u0105tek, aby m\u00f3c go delegowa\u0107 w przysz\u0142o\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Documente um processo em v\u00eddeo por 5 minutos todas as sextas-feiras para que voc\u00ea possa deleg\u00e1-lo no futuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043a\u0430\u0436\u0434\u0443\u044e \u043f\u044f\u0442\u043d\u0438\u0446\u0443 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 5 \u043c\u0438\u043d\u0443\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432\u0438\u0434\u0435\u043e, \u0447\u0442\u043e\u0431\u044b \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir i\u015flemi her Cuma 5 dakika boyunca videoyla belgeleyin, b\u00f6ylece gelecekte bu i\u015flemi devredebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5468\u4e94\u7528\u89c6\u9891\u8bb0\u5f55\u4e00\u4e2a\u6d41\u7a0b5\u5206\u949f\uff0c\u4ee5\u4fbf\u5c06\u6765\u80fd\u591f\u59d4\u6d3e\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u9031\u4e94\u7528 5 \u5206\u9418\u7684\u8996\u8a0a\u8a18\u9304\u6d41\u7a0b\uff0c\u4ee5\u4fbf\u60a8\u5c07\u4f86\u53ef\u4ee5\u5c07\u5176\u59d4\u6d3e\u7d66\u4ed6\u4eba\u3002"
          }
        }
      }
    },
    "assessment.growth.profile.macher.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lieferst ab. Die letzten 1\uff05 liegen in der Skalierung: Du darfst nicht selbst zum Flaschenhals werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You deliver. The last 1\uff05 is in scaling: you can't become a bottleneck yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00fa entregas. El \u00faltimo 1\uff05 est\u00e1 en escala: usted mismo no puede convertirse en un cuello de botella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous livrez. Le dernier 1\u00a0\uff05 est consacr\u00e9 \u00e0 la mise \u00e0 l'\u00e9chelle\u00a0: vous ne pouvez pas devenir vous-m\u00eame un goulot d'\u00e9tranglement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0947\u0902. \u0905\u0902\u0924\u093f\u092e 1\uff05 \u0938\u094d\u0915\u0947\u0932\u093f\u0902\u0917 \u092e\u0947\u0902 \u0939\u0948: \u0906\u092a \u0938\u094d\u0935\u092f\u0902 \u092c\u093e\u0927\u093e \u0928\u0939\u0940\u0902 \u092c\u0928 \u0938\u0915\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu consegni. L'ultimo 1\uff05 riguarda il ridimensionamento: non puoi diventare tu stesso un collo di bottiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u304c\u914d\u9054\u3057\u307e\u3059\u3002\u6700\u5f8c\u306e 1\uff05 \u306f\u30b9\u30b1\u30fc\u30ea\u30f3\u30b0\u306b\u95a2\u4fc2\u3057\u307e\u3059\u3002\u81ea\u5206\u81ea\u8eab\u304c\u30dc\u30c8\u30eb\u30cd\u30c3\u30af\u306b\u306a\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \ubc30\ub2ec\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9 1\uff05\ub294 \ud655\uc7a5\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc2a4\uc2a4\ub85c \ubcd1\ubaa9 \ud604\uc0c1\uc744 \uc77c\uc73c\ud0ac \uc218\ub294 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij levert. De laatste 1\uff05 zit in schaalvergroting: je kunt zelf geen knelpunt worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarczasz. Ostatni 1\uff05 to skalowanie: nie mo\u017cesz sam sta\u0107 si\u0119 w\u0105skim gard\u0142em."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea entrega. O \u00faltimo 1\uff05 est\u00e1 no dimensionamento: voc\u00ea mesmo n\u00e3o pode se tornar um gargalo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0441\u0434\u0430\u0451\u0448\u044c\u0441\u044f. \u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 1\uff05 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f \u0432 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438: \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0439 \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0435\u0431\u0435 \u0441\u0442\u0430\u0442\u044c \u0443\u0437\u043a\u0438\u043c \u043c\u0435\u0441\u0442\u043e\u043c."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen teslim et. Geriye kalan \uff051 ise \u00f6l\u00e7eklendirmeyle ilgilidir: Kendi ba\u015f\u0131n\u0131za bir darbo\u011faz haline gelemezsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4ea4\u4ed8\u6210\u679c\u3002\u6700\u540e\u76841\uff05\u5728\u4e8e\u6269\u5c55\uff1a\u4f60\u4e0d\u80fd\u81ea\u5df1\u6210\u4e3a\u74f6\u9888\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u4ea4\u4ed8\u3002\u6700\u5f8c 1\uff05 \u662f\u64f4\u5145\uff1a\u4f60\u81ea\u5df1\u4e0d\u80fd\u6210\u70ba\u74f6\u9838\u3002"
          }
        }
      }
    },

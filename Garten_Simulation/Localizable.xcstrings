    "plant.weinrebe.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je länger nüchtern, desto reicher die Ernte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longer sober, the richer the harvest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más sobrio, más rica la cosecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus on est sobre longtemps, plus riche est la récolte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जितना लंबा संयम, उतनी अधिक फसल"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più a lungo rimani sobrio, più ricco sarà il raccolto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断酒期間が長ければ長いほど、より豊かな収穫が得られる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "냉정한 시간이 길어질수록 수확량이 많아집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe langer nuchter, hoe rijker de oogst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Im dłużej trzeźwy, tym bogatsze zbiory"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais sóbrio por mais tempo, mais rica a colheita"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais sóbrio por mais tempo, mais rica a colheita"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем дольше трезв, тем богаче урожай"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar ayık olursa, hasat o kadar zengin olur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "戒酒越久，收获越丰"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持清醒的時間越長，收穫就越豐富"
          }
        }
      }
    },

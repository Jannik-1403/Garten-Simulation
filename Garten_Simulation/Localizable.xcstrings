        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0930\u093e\u0917\u0923 \u0915\u0947 \u0932\u093f\u090f \u0917\u0941\u0928\u0917\u0941\u0928\u093e\u0924\u0947 \u0938\u0939\u093e\u092f\u0915\u0964 (+1 \u0938\u093f\u0915\u094d\u0915\u093e)"

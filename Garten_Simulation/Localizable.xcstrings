        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u592a\u68d2\u4e86\uff01\u8fd9\u5c31\u662f\u4f60\u57f9\u517b\u4e60\u60ef\u7684\u65b9\u5f0f\u3002"

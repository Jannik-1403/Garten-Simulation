    "pfad_fit_day_30_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Tage Fitness. Heute: maximale Leistung \u2014 so viele Liegest\u00fctze wie m\u00f6glich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 days of fitness. Today: maximum performance \u2014 as many pushups as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "30 d\u00edas de fitness. Hoy: rendimiento m\u00e1ximo - tantas flexiones como sea posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 jours de fitness. Aujourd'hui : performance maximale \u2014 autant de pompes que possible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093f\u091f\u0928\u0947\u0938 \u0915\u0947 30 \u0926\u093f\u0928\u0964 \u0906\u091c: \u0905\u0927\u093f\u0915\u0924\u092e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 - \u091c\u093f\u0924\u0928\u093e \u0938\u0902\u092d\u0935 \u0939\u094b \u0909\u0924\u0928\u0947 \u092a\u0941\u0936-\u0905\u092a\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "30 giorni di fitness. Oggi: prestazioni massime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30\u65e5\u9593\u306e\u30d5\u30a3\u30c3\u30c8\u30cd\u30b9\u3002\u4eca\u65e5: \u6700\u5927\u9650\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9 \u2014 \u3067\u304d\u308b\u3060\u3051\u591a\u304f\u306e\u8155\u7acb\u3066\u4f0f\u305b\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30\uc77c \ud53c\ud2b8\ub2c8\uc2a4. \uc624\ub298: \ucd5c\ub300 \uc131\ub2a5 \u2014 \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \ud478\uc2dc\uc5c5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dagen fitness. Vandaag: maximale prestaties \u2013 zoveel mogelijk push-ups."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dni fitnessu. Dzisiaj: maksimum wydajno\u015bci \u2013 jak najwi\u0119cej pompek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dias de fitness. Hoje: desempenho m\u00e1ximo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "30 \u0434\u043d\u0435\u0439 \u0444\u0438\u0442\u043d\u0435\u0441\u0430. \u0421\u0435\u0433\u043e\u0434\u043d\u044f: \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u2014 \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u0442\u0436\u0438\u043c\u0430\u043d\u0438\u0439."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 g\u00fcnl\u00fck fitness. Bug\u00fcn: maksimum performans - m\u00fcmk\u00fcn oldu\u011fu kadar \u00e7ok \u015f\u0131nav."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30\u5929\u5065\u8eab\u3002\u4eca\u5929\uff1a\u6700\u5927\u8868\u73b0 \u2014 \u5c3d\u53ef\u80fd\u591a\u5730\u505a\u4fef\u5367\u6491\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5065\u8eab30\u5929\u3002\u4eca\u5929\uff1a\u6700\u5927\u8868\u73fe\uff0d\u76e1\u53ef\u80fd\u591a\u7684\u4fef\u81e5\u6490\u3002"
          }
        }
      }
    },

    "prog_deepwork_d4_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe VOR dem Starten des Timers exakt auf, welches Outcome du in dieser Session erreichen willst. Keine ungerichtete Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BEFORE starting the timer, write down exactly what outcome you want to achieve in this session. No undirected work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ANTES de poner en marcha el cronómetro, escriba exactamente qué resultado desea lograr en esta sesión. Ningún trabajo no dirigido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AVANT de démarrer le chronomètre, notez exactement le résultat que vous souhaitez atteindre au cours de cette séance. Pas de travail non dirigé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर शुरू करने से पहले, यह लिख लें कि आप इस सत्र में क्या परिणाम प्राप्त करना चाहते हैं। कोई अप्रत्यक्ष कार्य नहीं."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PRIMA di avviare il timer, scrivi esattamente quale risultato desideri ottenere in questa sessione. Nessun lavoro non diretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーを開始する前に、このセッションで達成したい結果を正確に書き留めてください。方向性のない仕事はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머를 시작하기 전에 이 세션에서 달성하고 싶은 결과를 정확히 적어보세요. 지시되지 않은 작업은 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VOORDAT u de timer start, noteert u precies welk resultaat u met deze sessie wilt bereiken. Geen ongericht werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ZANIM uruchomisz stoper, zapisz dokładnie, jaki wynik chcesz osiągnąć w tej sesji. Żadnej nieukierunkowanej pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ANTES de iniciar o cronômetro, anote exatamente o resultado que você deseja alcançar nesta sessão. Nenhum trabalho não direcionado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ANTES de iniciar o cronômetro, anote exatamente o resultado que você deseja alcançar nesta sessão. Nenhum trabalho não direcionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПРЕЖДЕ ЧЕМ запустить таймер, запишите, какого именно результата вы хотите достичь на этом занятии. Никакой ненаправленной работы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlayıcıyı başlatmadan ÖNCE, bu oturumda tam olarak hangi sonucu elde etmek istediğinizi yazın. Yönlendirilmemiş çalışma yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在启动计时器之前，准确写下您希望在本次训练中实现的结果。没有无指导的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟動計時器之前，請準確寫下您希望在本次訓練中實現的結果。沒有無指導的工作。"
          }
        }
      }
    },

    "pfad_fit_day_14_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "25 Liegest\u00fctze + 2 Minuten Plank. Du bist auf dem Weg zur Meisterschaft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "25 pushups + 2 minutes plank. You're on your way to mastery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "25 flexiones + 2 minutos de plancha. Est\u00e1s de camino a la maestr\u00eda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 pompes + 2 minutes de gainage. Tu es sur la voie de la ma\u00eetrise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "25 \u092a\u0941\u0936-\u0905\u092a\u094d\u0938 + 2 \u092e\u093f\u0928\u091f \u092a\u094d\u0932\u0948\u0902\u0915\u0964 \u0906\u092a \u091a\u0948\u092e\u094d\u092a\u093f\u092f\u0928\u0936\u093f\u092a \u0915\u0940 \u0930\u093e\u0939 \u092a\u0930 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "25 flessioni + 2 minuti di plank. Sei sulla strada per la maestria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8155\u7acb\u3066\u4f0f\u305b25\u56de+\u30d7\u30e9\u30f3\u30af2\u5206\u3002\u3042\u306a\u305f\u306f\u30de\u30b9\u30bf\u30fc\u3078\u306e\u9053\u3092\u9032\u3093\u3067\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud314\uad7d\ud600\ud3b4\uae30 25\uac1c + \ud50c\ub7ad\ud06c 2\ubd84. \ub2f9\uc2e0\uc740 \uc219\ub2ec\uc744 \ud5a5\ud574 \uac00\uace0 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "25 push-ups + 2 minuten plank. Je bent op weg naar meesterschap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "25 pompek + 2 minuty deski. Jeste\u015b na dobrej drodze do mistrzostwa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "25 flex\u00f5es + 2 minutos de prancha. Est\u00e1s no caminho para a mestria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "25 \u043e\u0442\u0436\u0438\u043c\u0430\u043d\u0438\u0439 + 2 \u043c\u0438\u043d\u0443\u0442\u044b \u043f\u043b\u0430\u043d\u043a\u0430. \u0422\u044b \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 \u015f\u0131nav + 2 dakika plank. Ustal\u0131\u011fa giden yoldas\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "25\u4e2a\u4fef\u5367\u6491 + 2\u5206\u949f\u5e73\u677f\u652f\u6491\u3002\u4f60\u6b63\u8fc8\u5411\u7cbe\u901a\u4e4b\u8def\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "25\u500b\u4fef\u81e5\u6490+2\u5206\u9418\u5e73\u677f\u652f\u6490\u3002\u4f60\u6b63\u5728\u901a\u5f80\u51a0\u8ecd\u7684\u8def\u4e0a\u3002"
          }
        }
      }
    },

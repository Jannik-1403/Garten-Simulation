    "assessment.lifestyle.profile.gefangener.break" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Push-Benachrichtigungen von WhatsApp-Gruppen stumm, in denen nur gejammert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mute push notifications from whining WhatsApp groups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencia las notificaciones automáticas de los grupos de WhatsApp quejosos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez les notifications push des groupes WhatsApp pleurnicheurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोने वाले व्हाट्सएप ग्रुपों से आने वाले पुश नोटिफिकेशन को म्यूट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l'audio delle notifiche push dei gruppi WhatsApp piagnucolosi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愚痴をこぼす WhatsApp グループからのプッシュ通知をミュートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "징징거리는 WhatsApp 그룹의 푸시 알림을 음소거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demp pushmeldingen van zeurende WhatsApp-groepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wycisz powiadomienia push z marudzących grup WhatsApp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silencie notificações push de grupos chorões do WhatsApp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключи push-уведомления от групп WhatsApp, в которых только жалуются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sızlanan WhatsApp gruplarından gelen anlık bildirimleri sessize alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将只会抱怨的 WhatsApp 群组的推送通知静音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靜音來自抱怨的 WhatsApp 群組的推播通知。"
          }
        }
      }
    },
    "assessment.lifestyle.profile.gefangener.build" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe pro Woche nur einer Person auf LinkedIn oder per Mail, die ein Level über dir ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write to only one person a week on LinkedIn or via email who is one level above you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe solo a una persona por semana en LinkedIn o por correo electrónico que esté un nivel por encima del tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez à une seule personne par semaine sur LinkedIn ou par e-mail qui se trouve un niveau au-dessus de vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक्डइन पर या ईमेल के माध्यम से प्रति सप्ताह केवल एक ही व्यक्ति को लिखें जो आपसे एक स्तर ऊपर हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi solo a una persona a settimana su LinkedIn o via email che è un livello sopra di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkedIn または電子メールで、自分より 1 つ上のレベルの人に週に 1 人だけ手紙を書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkedIn이나 이메일을 통해 일주일에 한 단계 위의 사람에게만 편지를 쓰세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf slechts één persoon per week op LinkedIn of via e-mail die één niveau boven u staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisz tylko do jednej osoby tygodniowo na LinkedIn lub przez e-mail, która jest o jeden poziom wyżej od Ciebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva para apenas uma pessoa por semana no LinkedIn ou por e-mail que esteja um nível acima de você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пиши каждую неделю только одному человеку в LinkedIn или по электронной почте, который находится на уровень выше тебя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftada yalnızca LinkedIn'de veya e-posta yoluyla sizden bir seviye üstünüzdeki bir kişiye yazın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周只给LinkedIn上或通过邮件写一封信给比你职位高一等级的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每週僅在 LinkedIn 上或透過電子郵件寫信給比您高一級的人。"
          }
        }
      }
    },
    "assessment.lifestyle.profile.gefangener.desc" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Umfeld zieht dich nach unten. Du musst dein Netzwerk nicht von heute auf morgen wechseln – fang mit 1％ Digitalisierung an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your environment is pulling you down. You don’t have to change your network overnight – start with 1％ digitization."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entorno te está hundiendo. No es necesario que cambie su red de la noche a la mañana: comience con un 1 ％ de digitalización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre environnement vous tire vers le bas. Vous n’êtes pas obligé de changer de réseau du jour au lendemain : commencez par 1 ％ de numérisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका वातावरण आपको नीचे खींच रहा है। आपको अपना नेटवर्क रातों-रात बदलने की ज़रूरत नहीं है - 1％ डिजिटलीकरण से शुरुआत करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo ambiente ti sta buttando giù. Non devi cambiare la tua rete da un giorno all’altro: inizia con una digitalizzazione dell’1％."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの環境があなたを引きずり下ろしています。ネットワークを一夜にして変更する必要はありません。まずは 1％ のデジタル化から始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 환경이 당신을 끌어내리고 있습니다. 하루아침에 네트워크를 변경할 필요가 없습니다. 1％ 디지털화부터 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je omgeving trekt je naar beneden. U hoeft uw netwerk niet van de ene op de andere dag te veranderen – begin met 1％ digitalisering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje otoczenie ciągnie Cię w dół. Nie musisz zmieniać sieci z dnia na dzień – zacznij od cyfryzacji 1％."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu ambiente está puxando você para baixo. Você não precisa mudar sua rede da noite para o dia – comece com 1％ de digitalização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твое окружение тянет тебя вниз. Тебе не нужно менять свою сеть с сегодняшнего дня на завтра – начни с 1％ цифровизации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevreniz sizi aşağı çekiyor. Ağınızı bir gecede değiştirmenize gerek yok; ％1 dijitalleştirmeyle başlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的环境在拉你向下。你不必在一夜之间更换你的网络——从1％的数字化开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的環境正在拖垮你。您不必在一夜之間改變您的人脈——從 1％ 的數位化開始。"
          }
        }
      }
    },

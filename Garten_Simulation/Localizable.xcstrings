            "value": "Comida crua"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сырая пища"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çiğ gıda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生食"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生食"
          }
        }
      }
    },
    "prog_nutrition_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iss heute ein Gemüse oder Obst, das du schon sehr lange nicht mehr oder noch nie gegessen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, eat a vegetable or fruit that you haven't eaten in a long time or have never eaten before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, come una verdura o fruta que no hayas comido en mucho tiempo o que nunca hayas comido antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, mangez un légume ou un fruit que vous n’avez pas mangé depuis longtemps ou que vous n’avez jamais mangé auparavant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कोई ऐसी सब्जी या फल खाएं जो आपने काफी समय से नहीं खाया हो या पहले कभी नहीं खाया हो."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi mangia una verdura o un frutto che non mangi da molto tempo o che non hai mai mangiato prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は、長い間食べていなかった、またはこれまで食べたことのない野菜や果物を食べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 오랫동안 먹지 않았거나 한 번도 먹어본 적이 없는 야채나 과일을 먹어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eet vandaag een groente of fruit dat je al lang niet meer hebt gegeten, of nog nooit eerder hebt gegeten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjedz dziś warzywo lub owoc, którego nie jadłeś od dawna lub nigdy wcześniej nie jadłeś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, coma um vegetal ou fruta que você não come há muito tempo ou nunca comeu antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, coma um vegetal ou fruta que você não come há muito tempo ou nunca comeu antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня съешьте овощ или фрукт, который вы давно не ели или никогда раньше не ели."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün uzun zamandır yemediğiniz veya daha önce hiç yemediğiniz bir sebze veya meyve yiyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，吃一种你很久没吃或以前从未吃过的蔬菜或水果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，吃一種你很久沒吃或以前從未吃過的蔬菜或水果。"
          }
        }
      }
    },

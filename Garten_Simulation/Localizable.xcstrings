    "plateau_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Trend hat sich in den letzten %1$@ Wochen kaum verändert. Das kann passieren, auch wenn du alles richtig machst – hält es an, schlagen wir bald eine Kalorienanpassung vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trend has barely moved over the last %1$@ weeks. This can happen even when you're doing everything right — if it continues, we'll suggest a calorie adjustment soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tendencia apenas se ha movido en las últimas %1$@ semanas. Esto puede pasar incluso haciendo todo bien — si continúa, pronto te sugeriremos un ajuste de calorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta tendance a très peu bougé au cours des %1$@ dernières semaines. Cela peut arriver même en faisant tout comme il faut — si ça continue, nous te proposerons bientôt un ajustement calorique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले %1$@ हफ्तों में आपका ट्रेंड लगभग नहीं बदला है। यह तब भी हो सकता है जब आप सब कुछ सही कर रहे हों — अगर यह जारी रहा, तो हम जल्द ही कैलोरी में बदलाव का सुझाव देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua tendenza è rimasta quasi invariata nelle ultime %1$@ settimane. Può succedere anche facendo tutto correttamente — se continua, ti suggeriremo presto una modifica delle calorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去%1$@週間、トレンドはほとんど変化していません。すべて正しく行っていてもこうしたことは起こり得ます。この状態が続く場合は、近いうちにカロリー調整をご提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 %1$@주 동안 추세가 거의 변하지 않았습니다. 모든 것을 제대로 하고 있어도 이런 일은 생길 수 있어요 — 계속된다면 곧 칼로리 조정을 제안해 드릴게요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je trend is de afgelopen %1$@ weken nauwelijks veranderd. Dat kan gebeuren, ook als je alles goed doet — als dit aanhoudt, stellen we binnenkort een calorie-aanpassing voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój trend prawie się nie zmienił przez ostatnie %1$@ tygodni. Może się to zdarzyć, nawet gdy wszystko robisz dobrze — jeśli to się utrzyma, wkrótce zaproponujemy zmianę kalorii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua tendência quase não mudou nas últimas %1$@ semanas. Isso pode acontecer mesmo fazendo tudo certo — se continuar, sugeriremos em breve um ajuste de calorias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua tendência quase não mudou nas últimas %1$@ semanas. Isso pode acontecer mesmo fazendo tudo certo — se continuar, sugeriremos em breve um ajuste de calorias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш тренд почти не менялся последние %1$@ нед. Такое может случиться, даже если вы всё делаете правильно — если это продолжится, мы скоро предложим изменить калорийность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğilimin son %1$@ haftadır neredeyse hiç değişmedi. Her şeyi doğru yaparken bile bu olabilir — devam ederse yakında bir kalori ayarlaması önereceğiz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 %1$@ 周你的趋势几乎没有变化。即使一切都做得很好,也可能出现这种情况——如果持续下去,我们会尽快建议调整热量摄入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 %1$@ 週你的趨勢幾乎沒有變化。即使一切都做得很好,也可能發生這種情況——如果持續下去,我們會盡快建議調整熱量攝取。"
          }
        }
      }
    },

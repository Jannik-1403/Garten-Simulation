    "assessment.fitness.profile.maschine.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Respekt. Behalte diesen unaufhaltsamen Fokus bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect. Maintain that unstoppable focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeto. Mantenga ese enfoque imparable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect. Maintenez cette concentration imparable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispetto. Mantieni quella concentrazione inarrestabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "尊敬。止まらない集中力を維持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "존경. 멈출 수 없는 집중력을 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect. Houd die onstuitbare focus vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek. Utrzymuj to niepowstrzymane skupienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Respeito. Mantenha esse foco imparável."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saygı. Durdurulamaz odağınızı koruyun."
          }
        }
      }
    },
    "assessment.fitness.profile.maschine.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst alles perfekt. Achte nur darauf, dass du weiterhin auf die Regeneration hörst – ansonsten gibt es nichts abzubauen!"

            "value": "\u0421\u0442\u043e\u0438\u0442 \u043d\u0430 \u0441\u043e\u043b\u043d\u0446\u0435, \u043d\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u0448\u0438\u0440\u043e\u043a\u0438\u0445 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u0445 \u2013 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131cakta duruyor, geni\u015f ufuklara ihtiya\u00e7 duyuyor \u2013 Macera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u957f\u5728\u6e29\u6696\u4e4b\u5730\uff0c\u9700\u8981\u5e7f\u9614\u7684\u89c6\u91ce \u2013 \u5192\u9669"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ad9\u5728\u6eab\u6696\u4e2d\uff0c\u9700\u8981\u5ee3\u95ca\u7684\u8996\u91ce\uff0d\u5192\u96aa"
          }
        }
      }
    },
    "plant.passionsblume.desc": {

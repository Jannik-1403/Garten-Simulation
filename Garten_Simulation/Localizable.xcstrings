    "prog_coldshower_d5_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche heute nicht die Sekunden zu zählen, sondern entspanne deine Muskeln aktiv, während du frierst. Kein Zittern, kein Anspannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't try to count the seconds today, but actively relax your muscles while you freeze. No shaking, no tensing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No intentes contar los segundos hoy, relaja activamente tus músculos mientras te congelas. Sin temblores, sin tensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'essayez pas de compter les secondes aujourd'hui, mais détendez activement vos muscles pendant que vous gelez. Pas de secousses, pas de tensions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज सेकंड गिनने की कोशिश न करें, बल्कि जमने के दौरान सक्रिय रूप से अपनी मांसपेशियों को आराम दें। कोई हिलना नहीं, कोई तनाव नहीं."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non provare a contare i secondi oggi, ma rilassa attivamente i muscoli mentre ti congeli. Nessuna agitazione, nessuna tensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は秒数を数えるのではなく、フリーズしている間に積極的に筋肉をリラックスさせてください。震えも緊張もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 초를 세려고 하지 말고, 얼어붙는 동안 근육을 ​​적극적으로 이완시키십시오. 흔들림도 없고 긴장도 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer vandaag niet de seconden te tellen, maar ontspan actief je spieren terwijl je bevriest. Geen schudden, geen spanning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie próbuj dzisiaj liczyć sekund, ale aktywnie rozluźniaj mięśnie podczas zamrożenia. Żadnego drżenia, żadnego napięcia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tente contar os segundos hoje, mas relaxe ativamente os músculos enquanto congela. Sem tremores, sem tensão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tente contar os segundos hoje, mas relaxe ativamente os músculos enquanto congela. Sem tremores, sem tensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пытайтесь сегодня считать секунды, а активно расслабьте мышцы, пока вы замерзаете. Никакой тряски, никакого напряжения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün saniyeleri saymaya çalışmayın, donarken kaslarınızı aktif olarak gevşetin. Sarsıntı yok, gerginlik yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不要试图数秒，而是在冻结时积极放松肌肉。没有颤抖，没有紧张。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天不要試圖數秒，而是在凍結時積極放鬆肌肉。沒有顫抖，沒有緊張。"
          }
        }
      }
    },

    "prog_noalcohol_d1_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte heute darauf, in welchen Momenten du normalerweise ans Trinken denkst (Stress, Feierabend, Belohnung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, pay attention to the moments in which you usually think about drinking (stress, after work, reward)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy presta atención a los momentos en los que sueles pensar en beber (estrés, afterwork, recompensa)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, faites attention aux moments où vous pensez habituellement à boire (stress, après le travail, récompense)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज उन क्षणों पर ध्यान दें जिनमें आप आमतौर पर शराब पीने (तनाव, काम के बाद, इनाम) के बारे में सोचते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi, presta attenzione ai momenti in cui solitamente pensi al bere (stress, dopo il lavoro, gratificazione)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は、あなたが普段お酒のことを考える瞬間（ストレス、仕事後、ご褒美など）に注目してみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 평소 음주에 대해 생각하는 순간(스트레스, 퇴근 후, 보상)에 주목해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Let vandaag op de momenten waarop u gewoonlijk aan drinken denkt (stress, na het werk, beloning)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś zwróć uwagę na momenty, w których zwykle myślisz o piciu (stres, po pracy, nagroda)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje preste atenção nos momentos em que você costuma pensar em beber (estresse, depois do trabalho, recompensa)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje preste atenção nos momentos em que você costuma pensar em beber (estresse, depois do trabalho, recompensa)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня обратите внимание на моменты, в которые вы обычно думаете о выпивке (стресс, после работы, вознаграждение)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün genellikle içki içmeyi düşündüğünüz anlara (stres, iş sonrası, ödül) dikkat edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，请注意您通常想到喝酒的时刻（压力、下班后、奖励）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天，請注意您通常想到喝酒的時刻（壓力、下班後、獎勵）。"
          }
        }
      }
    },

        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef planten water direct vanaf het startscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewaj ro\u015bliny z ekranu g\u0142\u00f3wnego."
          }

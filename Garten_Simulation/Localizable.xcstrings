    "assessment.fitness.q5" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute steht dein absolutes Hass-Workout auf dem Plan (z.B. schweres Beintraining oder intensives Cardio). Du hast leichte Kopfschmerzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today your absolute hate workout is on the plan (e.g. heavy leg training or intense cardio). You have a slight headache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy tu entrenamiento de odio absoluto está en el plan (por ejemplo, entrenamiento pesado de piernas o cardio intenso). Tienes un ligero dolor de cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd'hui, votre entraînement de haine absolue est au programme (par exemple, entraînement des jambes lourdes ou cardio intense). Vous avez un léger mal de tête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज आपकी संपूर्ण नफरत वाली कसरत योजना पर है (उदाहरण के लिए भारी पैर प्रशिक्षण या गहन कार्डियो)। आपको हल्का सिरदर्द है."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi è in programma il tuo allenamento più odioso (ad esempio allenamento per le gambe pesanti o cardio intenso). Hai un leggero mal di testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は、絶対に嫌いなトレーニングが計画されています (例: 激しい脚のトレーニングや激しい有酸素運動など)。少し頭が痛いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 당신이 가장 싫어하는 운동(예: 무거운 다리 훈련 또는 강렬한 유산소 운동)이 계획에 있습니다. 약간의 두통이 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag staat jouw absolute haattraining op het plan (bijvoorbeeld zware beentraining of intensieve cardio). Je hebt lichte hoofdpijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiaj w planie jest Twój absolutny trening nienawiści (np. ciężki trening nóg lub intensywne cardio). Masz lekki ból głowy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje o seu treino de ódio absoluto está no plano (por exemplo, treino pesado para as pernas ou cardio intenso). Você está com uma leve dor de cabeça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня у тебя в расписании абсолютная тренировка ненависти (например, тяжелая тренировка ног или интенсивное кардио). У тебя легкая головная боль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün kesinlikle nefret antrenmanınız planlanıyor (örneğin ağır bacak antrenmanı veya yoğun kardiyo). Hafif bir baş ağrınız var."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天你计划进行你最讨厌的训练（例如，重腿训练或高强度有氧）。你有轻微的头痛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天，你絕對討厭的運動已在計劃中（例如大重量的腿部訓練或劇烈的有氧運動）。你有輕微的頭痛。"
          }
        }
      }
    },

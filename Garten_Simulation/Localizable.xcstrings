    "assessment.fitness.q7" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du machst eine schwere Übung vor anderen Leuten im Gym. Das Gewicht ist eigentlich zu schwer, um es mit sauberer Technik zu bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You do a heavy exercise in front of other people in the gym. The weight is actually too heavy to move with proper technique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haces un ejercicio intenso delante de otras personas en el gimnasio. En realidad, el peso es demasiado pesado para moverlo con la técnica adecuada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous faites un exercice intense devant d’autres personnes dans la salle de sport. Le poids est en fait trop lourd pour être déplacé avec une technique appropriée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जिम में अन्य लोगों के सामने भारी व्यायाम करते हैं। वज़न वास्तव में उचित तकनीक के साथ हिलाने के लिए बहुत भारी है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai un esercizio pesante davanti ad altre persone in palestra. Il peso è in realtà troppo pesante per essere spostato con la tecnica adeguata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジムで他の人の前で激しい運動をします。実際、適切なテクニックで動かすには重量が重すぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 체육관에서 다른 사람들 앞에서 무거운 운동을 합니다. 실제로 무게가 너무 무거워서 적절한 기술로 움직일 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je doet een zware oefening voor andere mensen in de sportschool. Het gewicht is eigenlijk te zwaar om met de juiste techniek te verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykonujesz ciężkie ćwiczenia w obecności innych osób na siłowni. Ciężar jest w rzeczywistości zbyt duży, aby można go było przenieść przy odpowiedniej technice."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz um exercício pesado na frente de outras pessoas na academia. O peso é realmente muito pesado para ser movido com a técnica adequada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты делаешь тяжелое упражнение перед другими людьми в спортзале. Вес на самом деле слишком тяжелый, чтобы двигать его с правильной техникой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spor salonunda diğer insanların önünde ağır bir egzersiz yapıyorsunuz. Ağırlık aslında uygun teknikle hareket edemeyecek kadar ağırdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在健身房当着别人面做一个很重的练习。这个重量实际上太重了，无法用正确的技术举起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在健身房的其他人面前進行劇烈運動。實際上，重量太重，無法透過適當的技術移動。"
          }
        }
      }
    },
    "assessment.fitness.q7.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich reiße das Gewicht mit absolut miserabler Form hoch, um stark auszusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pull up the weight with absolutely terrible form to look strong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levanto el peso con una forma absolutamente terrible para parecer fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je soulève le poids avec une forme absolument terrible pour avoir l'air fort."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं मजबूत दिखने के लिए बिल्कुल भयानक तरीके से वजन उठाता हूं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0430 (\u0437\u0430\u043f\u043e\u0439\u043d\u043e\u0435 \u0432\u0435\u0449\u0430\u043d\u0438\u0435) \u0432 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0430\u043c \u044d\u043d\u0435\u0440\u0433\u0438\u0438, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0434\u0435\u043d\u0435\u0433. \u042d\u0442\u043e \u043c\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c \u0441\u0432\u043e\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Binge Streaming) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u957f\u8fdc\u6765\u770b\uff0c\u8fd9\u79cd\u4e60\u60ef\uff08\u72c2\u6d41\u5a92\u4f53\uff09\u4f1a\u6d88\u8017\u60a8\u7684\u7cbe\u529b\u3001\u65f6\u95f4\u548c\u91d1\u94b1\u3002\u5b83\u4f1a\u963b\u6b62\u60a8\u5145\u5206\u53d1\u6325\u6f5c\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u9577\u9060\u4f86\u770b\uff0c\u9019\u7a2e\u7fd2\u6163\uff08\u72c2\u6d41\u5a92\u9ad4\uff09\u6703\u6d88\u8017\u60a8\u7684\u7cbe\u529b\u3001\u6642\u9593\u548c\u91d1\u9322\u3002\u5b83\u6703\u963b\u6b62\u60a8\u5145\u5206\u767c\u63ee\u6f5b\u529b\u3002"
          }
        }
      }
    },

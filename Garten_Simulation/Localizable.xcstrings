    "assessment.finance.q11" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ziehst mit deinem Partner zusammen. Ab welchem Moment forderst du offene Zahlen über seine/ihre Schulden ein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You move in with your partner. At what point do you demand open figures about his/her debts?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te mudas con tu pareja. ¿En qué momento exige cifras abiertas sobre sus deudas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous emménagez avec votre partenaire. À quel moment exigez-vous des chiffres ouverts sur ses dettes ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपने साथी के साथ आगे बढ़ें। आप किस बिंदु पर उसके ऋणों के बारे में खुले आंकड़ों की मांग करते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai a vivere con il tuo partner. A che punto chiedi cifre aperte sui suoi debiti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたはパートナーと一緒に引っ越します。どの時点で彼/彼女の借金について公開の数字を要求しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 파트너와 함께 이사합니다. 어느 시점에서 귀하의 부채에 대한 공개 수치를 요구합니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U gaat samenwonen met uw partner. Op welk punt eist u open cijfers over zijn/haar schulden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadzasz się ze swoim partnerem. W którym momencie żądasz otwartych danych na temat jego długów?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vai morar com seu parceiro. Em que momento você exige números abertos sobre suas dívidas?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты переезжаешь к своему партнёру. С какого момента ты требуешь открытых цифр о его/её долгах?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partnerinizin yanına taşınıyorsunuz. Borçlarıyla ilgili ne zaman açık rakam talep edeceksiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你和你的伴侣同居。从什么时候起，你会要求他/她公开债务情况？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你搬去和你的伴侶住在一起。您在什麼時候要求他/她的債務公開資料？"
          }
        }
      }
    },
    "assessment.finance.q11.a" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gar nicht. Über Geld spricht man nicht in einer romantischen Beziehung."
          }

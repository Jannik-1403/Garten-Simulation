    "plant.orchidee.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten, fragil, aber wunderschön wenn gepflegt – Kunst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, but beautiful when cared for – Art"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, frágil, pero bella con cuidado – Arte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare, fragile, mais magnifique quand soignée – Art"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुर्लभ, नाजुक, लेकिन देखभाल करने पर सुंदर – कला"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro, fragile, ma bello se curato – arte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "希少で壊れやすいが、大切に扱うと美しい – アート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "희귀하고 깨지기 쉬우나 관리하면 아름다운 – 예술"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeldzaam, kwetsbaar, maar mooi als je er voor zorgt – Art"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzadkie, delikatne, ale piękne, gdy się o nie dba – Art"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, frágil, mas bela quando cuidada – Arte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rara, frágil, mas bela quando cuidada – Arte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редко, хрупко, но прекрасно, если ухаживать – искусство"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadir, kırılgan ama bakım yapıldığında güzel - Sanat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稀有、脆弱，但若精心照料则美丽非凡 – 艺术"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稀有、脆弱，但保養時卻很美麗──藝術"
          }
        }
      }
    },

    "assessment.health.profile.ignorant.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein K\u00f6rper sendet Signale. Lerne sie zu lesen und handle, bevor der Crash kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body sends signals. Learn to read them and act before the crash comes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo env\u00eda se\u00f1ales. Aprenda a leerlos y actuar antes de que llegue el colapso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps envoie des signaux. Apprenez \u00e0 les lire et \u00e0 agir avant que le crash ne survienne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0936\u0930\u0940\u0930 \u0938\u0902\u0915\u0947\u0924 \u092d\u0947\u091c\u0924\u093e \u0939\u0948\u0964 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e \u0906\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0922\u093c\u0928\u093e \u0914\u0930 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0928\u093e \u0938\u0940\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo invia segnali. Impara a leggerli e ad agire prima che arrivi lo schianto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306e\u4f53\u306f\u4fe1\u53f7\u3092\u9001\u308a\u307e\u3059\u3002\u30af\u30e9\u30c3\u30b7\u30e5\u304c\u8d77\u3053\u308b\u524d\u306b\u3001\u305d\u308c\u3089\u3092\u8aad\u3093\u3067\u884c\u52d5\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc758 \ubab8\uc740 \uc2e0\ud638\ub97c \ubcf4\ub0c5\ub2c8\ub2e4. \ucda9\ub3cc\uc774 \ubc1c\uc0dd\ud558\uae30 \uc804\uc5d0 \uc774\ub97c \uc77d\uace0 \ud589\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lichaam zendt signalen uit. Leer ze te lezen en te handelen voordat de crash komt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje cia\u0142o wysy\u0142a sygna\u0142y. Naucz si\u0119 je czyta\u0107 i dzia\u0142aj, zanim nadejdzie katastrofa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo envia sinais. Aprenda a l\u00ea-los e a agir antes que o acidente aconte\u00e7a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u043e\u0435 \u0442\u0435\u043b\u043e \u043f\u043e\u0441\u044b\u043b\u0430\u0435\u0442 \u0441\u0438\u0433\u043d\u0430\u043b\u044b. \u041d\u0430\u0443\u0447\u0438\u0441\u044c \u0438\u0445 \u0447\u0438\u0442\u0430\u0442\u044c \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u0442 \u043a\u0440\u0430\u0445."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuz sinyaller g\u00f6nderir. Bunlar\u0131 okumay\u0131 ve kaza gelmeden \u00f6nce harekete ge\u00e7meyi \u00f6\u011frenin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u8eab\u4f53\u5728\u53d1\u51fa\u4fe1\u53f7\u3002\u5b66\u4f1a\u89e3\u8bfb\u5b83\u4eec\uff0c\u5e76\u5728\u5d29\u6e83\u6765\u4e34\u4e4b\u524d\u91c7\u53d6\u884c\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u8eab\u9ad4\u6703\u767c\u51fa\u8a0a\u865f\u3002\u5b78\u6703\u95b1\u8b80\u5b83\u5011\u4e26\u5728\u5d29\u6f70\u767c\u751f\u4e4b\u524d\u63a1\u53d6\u884c\u52d5\u3002"
          }
        }
      }
    },
    "assessment.health.profile.ignorant.break": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Schmerzmittel nicht direkt beim ersten Ziehen \u2013 trinke stattdessen 500ml Wasser und warte 10 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't take painkillers right away when you first puff - instead, drink 500ml of water and wait 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tome analg\u00e9sicos inmediatamente despu\u00e9s de la primera inhalaci\u00f3n; en su lugar, beba 500 ml de agua y espere 10 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prenez pas d'analg\u00e9siques d\u00e8s la premi\u00e8re bouff\u00e9e. Buvez plut\u00f4t 500 ml d'eau et attendez 10 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u092c \u0906\u092a \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0915\u0936 \u0932\u0947\u0902 \u0924\u094b \u0924\u0941\u0930\u0902\u0924 \u0926\u0930\u094d\u0926 \u0928\u093f\u0935\u093e\u0930\u0915 \u0926\u0935\u093e\u090f\u0902 \u0928 \u0932\u0947\u0902 - \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f, 500 \u092e\u093f\u0932\u0940\u0932\u0940\u091f\u0930 \u092a\u093e\u0928\u0940 \u092a\u093f\u090f\u0902 \u0914\u0930 10 \u092e\u093f\u0928\u091f \u0924\u0915 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non prendere antidolorifici subito al primo tiro, bevi invece 500 ml di acqua e attendi 10 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u521d\u306b\u5438\u3063\u305f\u3068\u304d\u306b\u3059\u3050\u306b\u93ae\u75db\u5264\u3092\u670d\u7528\u305b\u305a\u3001500ml \u306e\u6c34\u3092\u98f2\u3093\u3067 10 \u5206\u9593\u5f85\u3061\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc98\uc74c \ud761\uc785\ud560 \ub54c \ubc14\ub85c \uc9c4\ud1b5\uc81c\ub97c \ubcf5\uc6a9\ud558\uc9c0 \ub9d0\uace0, \ub300\uc2e0 \ubb3c 500ml\ub97c \ub9c8\uc2dc\uace0 10\ubd84 \uc815\ub3c4 \uae30\ub2e4\ub9ac\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem niet meteen pijnstillers als u voor het eerst puft, maar drink in plaats daarvan 500 ml water en wacht 10 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie bierz \u015brodk\u00f3w przeciwb\u00f3lowych od razu po pierwszym zaci\u0105gni\u0119ciu \u2013 zamiast tego wypij 500ml wody i odczekaj 10 minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o tome analg\u00e9sicos imediatamente na primeira inala\u00e7\u00e3o - em vez disso, beba 500ml de \u00e1gua e espere 10 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0439\u0442\u0435 \u043e\u0431\u0435\u0437\u0431\u043e\u043b\u0438\u0432\u0430\u044e\u0449\u0435\u0435 \u043f\u0440\u0438 \u043f\u0435\u0440\u0432\u044b\u0445 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0430\u0445 \u0431\u043e\u043b\u0438 \u2013 \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u0432\u044b\u043f\u0435\u0439\u0442\u0435 500 \u043c\u043b \u0432\u043e\u0434\u044b \u0438 \u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435 10 \u043c\u0438\u043d\u0443\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130lk nefesinizi \u00e7ekerken hemen a\u011fr\u0131 kesici almay\u0131n; bunun yerine 500 ml su i\u00e7ip 10 dakika bekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u5728\u7b2c\u4e00\u6b21\u75bc\u75db\u65f6\u76f4\u63a5\u670d\u7528\u6b62\u75db\u836f\u2014\u2014\u6539\u4e3a\u5148\u559d500\u6beb\u5347\u6c34\uff0c\u7136\u540e\u7b49\u5f8510\u5206\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b2c\u4e00\u6b21\u5438\u6642\u4e0d\u8981\u7acb\u5373\u670d\u7528\u6b62\u75db\u85e5\uff0c\u800c\u662f\u559d 500 \u6beb\u5347\u6c34\u4e26\u7b49\u5f85 10 \u5206\u9418\u3002"
          }
        }
      }
    },
    "assessment.health.profile.ignorant.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe jeden Tag exakt 2 Minuten in einer tiefen Hocke (Deep Squat), um deine Gelenke zu schmieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend exactly 2 minutes in a deep squat every day to lubricate your joints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pase exactamente 2 minutos en sentadilla profunda todos los d\u00edas para lubricar sus articulaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez exactement 2 minutes en squat profond chaque jour pour lubrifier vos articulations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u091c\u094b\u0921\u093c\u094b\u0902 \u0915\u094b \u091a\u093f\u0915\u0928\u093e\u0908 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0930 \u0926\u093f\u0928 \u0920\u0940\u0915 2 \u092e\u093f\u0928\u091f \u0917\u0939\u0930\u0940 \u0938\u094d\u0915\u094d\u0935\u093e\u091f \u092e\u0947\u0902 \u092c\u093f\u0924\u093e\u090f\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascorri esattamente 2 minuti ogni giorno in uno squat profondo per lubrificare le articolazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u3061\u3087\u3046\u3069 2 \u5206\u9593\u3001\u6df1\u3044\u30b9\u30af\u30ef\u30c3\u30c8\u3092\u3057\u3066\u95a2\u7bc0\u3092\u6f64\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad00\uc808\uc5d0 \uc724\ud65c\uc720\ub97c \uacf5\uae09\ud558\uae30 \uc704\ud574 \ub9e4\uc77c \uc815\ud655\ud788 2\ubd84 \ub3d9\uc548 \ub525 \uc2a4\ucffc\ud2b8\ub97c \ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng elke dag precies 2 minuten door in een diepe squat om je gewrichten te smeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codziennie po\u015bwi\u0119\u0107 dok\u0142adnie 2 minuty na g\u0142\u0119bokie przysiady, aby nasmarowa\u0107 stawy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe exatamente 2 minutos em um agachamento profundo todos os dias para lubrificar as articula\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0440\u043e\u0432\u043d\u043e 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u043e\u043c \u043f\u0440\u0438\u0441\u0435\u0434\u0435 (Deep Squat), \u0447\u0442\u043e\u0431\u044b \u0441\u043c\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0432\u0430\u0448\u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemlerinizi ya\u011flamak i\u00e7in her g\u00fcn tam olarak 2 dakikan\u0131z\u0131 derin \u00e7\u00f6melmeye ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u82b1\u786e\u5207\u76842\u5206\u949f\u65f6\u95f4\u505a\u6df1\u8e72\uff0c\u4ee5\u6da6\u6ed1\u4f60\u7684\u5173\u8282\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u82b1 2 \u5206\u9418\u6df1\u8e72\u4f86\u6f64\u6ed1\u95dc\u7bc0\u3002"
          }
        }
      }
    },
    "assessment.health.profile.ignorant.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ignorierst Alarmsignale deines K\u00f6rpers. Wir f\u00fcgen eine extrem kleine pr\u00e4ventive Wartung hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You ignore your body\u2019s alarm signals. We add extremely small preventive maintenance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoras las se\u00f1ales de alarma de tu cuerpo. Agregamos un mantenimiento preventivo extremadamente peque\u00f1o."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ignorez les signaux d\u2019alarme de votre corps. Nous ajoutons une maintenance pr\u00e9ventive extr\u00eamement minime."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0905\u092a\u0928\u0947 \u0936\u0930\u0940\u0930 \u0915\u0947 \u0905\u0932\u093e\u0930\u094d\u092e \u0938\u0902\u0915\u0947\u0924\u094b\u0902 \u0915\u094b \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u0905\u0924\u094d\u092f\u0902\u0924 \u091b\u094b\u091f\u093e \u0928\u093f\u0935\u093e\u0930\u0915 \u0930\u0916\u0930\u0916\u093e\u0935 \u091c\u094b\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignori i segnali di allarme del tuo corpo. Aggiungiamo una manutenzione preventiva estremamente ridotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8eab\u4f53\u306e\u8b66\u5831\u4fe1\u53f7\u3092\u7121\u8996\u3057\u307e\u3059\u3002\u3054\u304f\u5c0f\u898f\u6a21\u306a\u4e88\u9632\u4fdd\u5b88\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 \uc2e0\uccb4\uc758 \uacbd\ubcf4 \uc2e0\ud638\ub97c \ubb34\uc2dc\ud569\ub2c8\ub2e4. \uc6b0\ub9ac\ub294 \ub9e4\uc6b0 \uc791\uc740 \uc608\ubc29 \uc720\uc9c0 \ubcf4\uc218\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je negeert de alarmsignalen van je lichaam. Wij voegen extreem klein preventief onderhoud toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorujesz sygna\u0142y alarmowe swojego cia\u0142a. Do tego dodajemy niezwykle drobne prace konserwacyjne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea ignora os sinais de alarme do seu corpo. Adicionamos manuten\u00e7\u00f5es preventivas extremamente pequenas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0438\u0433\u043d\u043e\u0440\u0438\u0440\u0443\u0435\u0448\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u044b \u0442\u0440\u0435\u0432\u043e\u0433\u0438 \u0441\u0432\u043e\u0435\u0433\u043e \u0442\u0435\u043b\u0430. \u041c\u044b \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u043c \u043a\u0440\u0430\u0439\u043d\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043f\u0440\u0435\u0432\u0435\u043d\u0442\u0438\u0432\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00fccudunuzun alarm sinyallerini g\u00f6rmezden geliyorsunuz. Son derece k\u00fc\u00e7\u00fck \u00f6nleyici bak\u0131mlar ekliyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5ffd\u89c6\u4e86\u81ea\u5df1\u8eab\u4f53\u7684\u8b66\u793a\u4fe1\u53f7\u3002\u6211\u4eec\u589e\u52a0\u4e86\u4e00\u6b21\u6781\u5c0f\u7684\u9884\u9632\u6027\u7ef4\u62a4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5ffd\u8996\u4e86\u8eab\u9ad4\u767c\u51fa\u7684\u8b66\u5831\u4fe1\u865f\u3002\u6211\u5011\u589e\u52a0\u4e86\u6975\u5c0f\u7684\u9810\u9632\u6027\u7dad\u8b77\u3002"
          }
        }
      }
    },

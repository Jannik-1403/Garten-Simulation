    "tour_lives_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sind deine Leben. Du verlierst Leben, wenn du deine Pflanzen nicht gießt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are your lives. You lose lives if you don't water your plants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí están tus vidas. Pierdes vidas si no riegas tus plantas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici vos vies. Vous perdez des vies si vous n'arrosez pas vos plantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco le tue vite. Perdi vite se non annaffi le tue piante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにあなたのライフがあります。植物に水をやらないとライフを失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 생명이 있습니다. 식물에 물을 주지 않으면 생명을 잃습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zijn je levens. Je verliest levens als je je planten geen water geeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto twoje życia. Tracisz życia, jeśli nie podlewasz swoich roślin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui estão suas vidas. Você perde vidas se não regar suas plantas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşte canlarınız. Bitkilerinizi sulamazsanız can kaybedersiniz."
          }
        }
      }
    },

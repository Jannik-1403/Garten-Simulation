          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节省你的钱，而不是把钱花在微交易和赌博上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節省你的錢，而不是把錢花在微交易和賭博上。"
          }
        }
      }
    },

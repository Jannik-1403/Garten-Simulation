    "trash.couch_abo.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere: Wie viele Stunden saßt du heute? Was fehlt dir dadurch?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: how many hours did you sit today? What are you missing because of it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota: ¿cuántas horas has estado sentado hoy? ¿Qué te pierdes por ello?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: combien d'heures as-tu été assis aujourd'hui ? Qu'est-ce que tu rates à cause de ça ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट करें: आप आज कितने घंटे बैठे रहें? इसके कारण आपको क्या कमी महसूस हो रही है?"

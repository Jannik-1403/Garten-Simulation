    "onboarding_shop_blase": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Shop findest du neue Pflanzen und n\u00fctzliche Gegenst\u00e4nde f\u00fcr deine Reise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the shop, you'll find new plants and useful items for your journey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la tienda encontrar\u00e1s nuevas plantas y objetos \u00fatiles para tu viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la boutique, tu trouveras de nouvelles plantes et des objets utiles pour ton voyage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0941\u0915\u093e\u0928 \u092e\u0947\u0902 \u0906\u092a\u0915\u094b \u0928\u090f \u092a\u094c\u0927\u0947 \u0914\u0930 \u0906\u092a\u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917\u0940 \u0935\u0938\u094d\u0924\u0941\u090f\u0902 \u092e\u093f\u0932\u0947\u0902\u0917\u0940\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In the shop, you'll find new plants and useful items for your journey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e7\u30c3\u30d7\u306b\u306f\u65b0\u3057\u3044\u690d\u7269\u3084\u65c5\u306b\u5f79\u7acb\u3064\u30a2\u30a4\u30c6\u30e0\u304c\u63c3\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c1\uc810\uc5d0\uc11c\ub294 \uc5ec\ud589\uc5d0 \ud544\uc694\ud55c \uc0c8\ub85c\uc6b4 \uc2dd\ubb3c\uacfc \uc720\uc6a9\ud55c \uc544\uc774\ud15c\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de winkel vind je nieuwe planten en handige spullen voor onderweg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sklepie znajdziesz nowe ro\u015bliny i przydatne przedmioty, kt\u00f3re pomog\u0105 Ci w podr\u00f3\u017cy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na loja, encontrar\u00e1s novas plantas e itens \u00fateis para a tua viagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0432\u044b \u043d\u0430\u0439\u0434\u0451\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0434\u043b\u044f \u0432\u0430\u0448\u0435\u0433\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u011fazada yolculu\u011funuz i\u00e7in yeni bitkiler ve faydal\u0131 e\u015fyalar bulacaks\u0131n\u0131z."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5546\u5e97\u91cc\uff0c\u4f60\u53ef\u4ee5\u627e\u5230\u65b0\u7684\u690d\u7269\u548c\u6709\u7528\u7684\u7269\u54c1\uff0c\u52a9\u4f60\u4e00\u81c2\u4e4b\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5546\u5e97\u88e1\uff0c\u60a8\u6703\u767c\u73fe\u65b0\u7684\u690d\u7269\u548c\u5c0d\u60a8\u7684\u65c5\u7a0b\u6709\u7528\u7684\u7269\u54c1\u3002"
          }
        }
      }
    },
    "onboarding_tutorial_1_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige deine Gewohnheit und tippe auf den Wassertropfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete your habit and tap the water drop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa tu h\u00e1bito y toca la gota de agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compl\u00e8te ton habitude et appuie sur la goutte d'eau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0940 \u0906\u0926\u0924 \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u093e\u0928\u0940 \u0915\u0940 \u092c\u0942\u0902\u0926 \u0915\u094b \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete your habit and tap the water drop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7fd2\u6163\u3092\u5b8c\u6210\u3055\u305b\u3066\u3001\u6c34\u6ef4\u3092\u30bf\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2b5\uad00\uc744 \uc644\uc131\ud558\uace0 \ubb3c\ubc29\uc6b8\uc744 \ud0ed\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je gewoonte af en tik op de waterdruppel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doko\u0144cz sw\u00f3j nawyk i dotknij kropli wody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa o teu h\u00e1bito e toca na gota de \u00e1gua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u043f\u043e\u043b\u043d\u0438 \u0441\u0432\u043e\u044e \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0443 \u0438 \u043d\u0430\u0436\u043c\u0438 \u043d\u0430 \u043a\u0430\u043f\u043b\u044e \u0432\u043e\u0434\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Al\u0131\u015fkanl\u0131\u011f\u0131n\u0131z\u0131 tamamlay\u0131n ve su damlas\u0131na dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u6210\u4f60\u7684\u4e60\u60ef\u5e76\u70b9\u51fb\u6c34\u6ef4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u6210\u4f60\u7684\u7fd2\u6163\u4e26\u9ede\u64ca\u6c34\u6ef4\u3002"
          }
        }
      }
    },

    "trash.junk_mail_abo.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Spam & Ablenkung) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Spam & Distractions) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Spam y distracciones) te cuesta energía, tiempo y dinero a largo plazo. Te impide desarrollar todo tu potencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette habitude (Spam et distractions) te coûte de l'énergie, du temps et de l'argent à long terme. Elle t'empêche d'exploiter pleinement ton potentiel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आदत (स्पैम और विचलन) लंबे समय में आपकी ऊर्जा, समय और पैसा खर्च करती है। यह आपको अपनी पूरी क्षमता का उपयोग करने से रोकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa abitudine (Spam e distrazioni) ti costa energia, tempo e denaro a lungo termine. Ti impedisce di sfruttare appieno il tuo potenziale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この習慣 (スパムや気が散る) は、長期的にはエネルギー、時間、お金を浪費します。それはあなたの潜在能力を最大限に発揮することを妨げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 습관(스팸 및 방해 요소)은 장기적으로 에너지, 시간 및 비용을 소모합니다. 그것은 당신이 잠재력을 최대한 발휘하는 것을 방해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gewoonte (spam & afleiding) kost je op de lange termijn energie, tijd en geld. Het verhindert dat je je volledige potentieel bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten nawyk (spam i rozproszenie uwagi) w dłuższej perspektywie kosztuje Cię energię, czas i pieniądze. Uniemożliwia osiągnięcie pełnego potencjału."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este hábito (Spam e distrações) custa-te energia, tempo e dinheiro a longo prazo. Impede-te de aproveitar todo o teu potencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse hábito (Spam e distrações) custa energia, tempo e dinheiro a longo prazo. Ele te impede de aproveitar todo o seu potencial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта привычка (спам и отвлечение) в долгосрочной перспективе стоит вам энергии, времени и денег. Это мешает вам полностью раскрыть свой потенциал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alışkanlık (spam ve dikkat dağıtma) uzun vadede enerjinize, zamanınıza ve paranıza mal olur. Tam potansiyelinize ulaşmanızı engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长远来看，这种习惯（垃圾邮件和干扰）会消耗您的精力、时间和金钱。它会阻止您充分发挥潜力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從長遠來看，這種習慣（垃圾郵件和乾擾）會消耗您的精力、時間和金錢。它會阻止您充分發揮潛力。"
          }
        }
      }
    },

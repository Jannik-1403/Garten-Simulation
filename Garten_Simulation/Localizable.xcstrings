    "habit.fruit_veg.connect_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Apple Health, um Ballaststoffe und Kalzium aus deiner Ernährung auszulesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health to read fiber and calcium from your diet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Apple Health para leer la fibra y el calcio de tu dieta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Apple Health pour lire les fibres et le calcium de votre alimentation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आहार से फाइबर और कैल्शियम पढ़ने के लिए Apple Health को कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti Apple Health per leggere le fibre e il calcio dalla tua dieta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthを接続して、食事から食物繊維とカルシウムを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health를 연결하여 식단에서 식이섬유와 칼슘을 읽어오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel Apple Health om vezels en calcium uit je dieet te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz Apple Health, aby odczytywać błonnik i wapń ze swojej diety."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Apple Health para ler as fibras e o cálcio da sua dieta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Apple Health para ler as fibras e o cálcio da sua dieta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Apple Health, чтобы считывать клетчатку и кальций из вашего рациона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyetinizden lif ve kalsiyumu okumak için Apple Health'i bağlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接Apple Health以读取您饮食中的膳食纤维和钙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接Apple Health以讀取您飲食中的膳食纖維和鈣。"
          }
        }
      }
    },

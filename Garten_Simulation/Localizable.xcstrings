        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका संदेश jannik.schill.2010@gmail.com पर भेज दिया गया है। हम जल्द ही आपसे संपर्क करेंगे!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio è stato inviato a jannik.schill.2010@gmail.com. Ti risponderemo presto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは jannik.schill.2010@gmail.com に送信されました。すぐにご連絡いたします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 메시지는 jannik.schill.2010@gmail.com으로 전송되었습니다. 곧 다시 연락드리겠습니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bericht is verzonden naar jannik.schild.2010@gmail.com. We nemen snel contact met u op!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wiadomość została wysłana na adres jannik.schill.2010@gmail.com. Wkrótce się z Tobą skontaktujemy!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua mensagem foi enviada para jannik.schill.2010@gmail.com. Responderemos em breve!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua mensagem foi enviada para jannik.schill.2010@gmail.com. Responderemos em breve!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

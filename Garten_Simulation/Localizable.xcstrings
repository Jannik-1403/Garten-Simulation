    "prog_stretching_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr langes Halten von wenigen Posen. Nutze Schwerkraft und Atmung, statt Muskelkraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding a few poses for a very long time. Use gravity and breathing instead of muscle strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteniendo algunas poses durante mucho tiempo. Utilice la gravedad y la respiración en lugar de la fuerza muscular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir quelques poses pendant très longtemps. Utilisez la gravité et la respiration plutôt que la force musculaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत लंबे समय तक कुछ पोज बनाए रखना। मांसपेशियों की ताकत के बजाय गुरुत्वाकर्षण और श्वास का प्रयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere alcune pose per molto tempo. Usa la gravità e la respirazione invece della forza muscolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかのポーズを非常に長い間保持します。筋力の代わりに重力と呼吸を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아주 오랫동안 몇 가지 포즈를 취합니다. 근력 대신 중력과 호흡을 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar poses heel lang vasthouden. Gebruik de zwaartekracht en ademhaling in plaats van spierkracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymanie kilku pozycji przez bardzo długi czas. Używaj grawitacji i oddychania zamiast siły mięśni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendo algumas poses por muito tempo. Use a gravidade e a respiração em vez da força muscular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendo algumas poses por muito tempo. Use a gravidade e a respiração em vez da força muscular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживание нескольких поз в течение очень долгого времени. Используйте гравитацию и дыхание вместо мышечной силы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç pozu çok uzun süre tutmak. Kas gücü yerine yerçekimini ve nefes almayı kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间保持几个姿势。使用重力和呼吸代替肌肉力量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間保持幾個姿勢。使用重力和呼吸代替肌肉力量。"
          }
        }
      }
    },

    "tour_shop_prompt_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist der Shop! Klicke auf Weiter, um ihn dir anzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here is the shop! Click Next to check it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Aquí está la tienda! Haz clic en Siguiente para echar un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici la boutique ! Cliquez sur Suivant pour y jeter un œil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ दुकान है! इसे देखने के लिए आगे क्लिक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco il negozio! Clicca su Avanti per dare un'occhiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここはショップです！次へをクリックしてチェックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기가 상점입니다! 다음을 클릭하여 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is de winkel! Klik op Volgende om het te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto sklep! Kliknij Dalej, aby go sprawdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui está a loja! Clique em Próximo para conferir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui está a loja! Clique em Próximo para conferir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот магазин! Нажмите «Далее», чтобы посмотреть его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşte mağaza! Göz atmak için Sonraki'ye tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是商店！单击“下一步”观看。"

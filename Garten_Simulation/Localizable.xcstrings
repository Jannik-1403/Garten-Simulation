    "prog_deepwork_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterteile deine Session in 25-Minuten-Blöcke (Fokus) und 5-Minuten-Pausen (Aufstehen, Augen vom Bildschirm weg)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide your session into 25-minute blocks (focus) and 5-minute breaks (stand up, eyes away from the screen)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida su sesión en bloques de 25 minutos (enfoque) y descansos de 5 minutos (levántese, sin mirar la pantalla)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisez votre séance en blocs de 25 minutes (concentration) et de pauses de 5 minutes (debout, les yeux éloignés de l'écran)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सत्र को 25 मिनट के ब्लॉक (फोकस) और 5 मिनट के ब्रेक (खड़े हो जाएं, आंखें स्क्रीन से दूर) में विभाजित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividi la sessione in blocchi da 25 minuti (concentrazione) e pause da 5 minuti (alzati, occhi lontani dallo schermo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを 25 分間のブロック (集中) と 5 分間の休憩 (立ち上がって画面から目を離す) に分割します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 25분 블록(집중)과 5분 휴식(일어나서 화면에서 눈을 떼기)으로 나눕니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeel uw sessie in blokken van 25 minuten (focus) en pauzes van 5 minuten (sta op, ogen weg van het scherm)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel sesję na 25-minutowe bloki (koncentracja) i 5-minutowe przerwy (wstań, oczy oddalone od ekranu)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida sua sessão em blocos de 25 minutos (foco) e intervalos de 5 minutos (levante-se, olhos longe da tela)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida sua sessão em blocos de 25 minutos (foco) e intervalos de 5 minutos (levante-se, olhos longe da tela)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделите занятие на 25-минутные блоки (сосредоточенность) и 5-минутные перерывы (встаньте, отведя глаза от экрана)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seansınızı 25 dakikalık bloklara (odaklanma) ve 5 dakikalık aralara (ayağa kalkın, gözlerinizi ekrandan ayırın) bölün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的训练分为 25 分钟的时间段（专注）和 5 分钟的休息时间（站起来，眼睛远离屏幕）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將您的訓練分為 25 分鐘的時間段（專注）和 5 分鐘的休息時間（站起來，眼睛遠離螢幕）。"
          }
        }
      }
    },

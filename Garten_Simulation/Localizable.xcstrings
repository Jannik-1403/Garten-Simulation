    "trash.negativitaets_feed.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute oder entfolge alle Accounts, die du nach dem Lesen schlechter f\u00fchlst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute or unfollow all accounts that make you feel worse after reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia o deja de seguir todas las cuentas que te hacen sentir peor despu\u00e9s de leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe le son ou ne suis plus tous les comptes qui te font te sentir moins bien apr\u00e8s la lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092d\u0940 \u0916\u093e\u0924\u094b\u0902 \u0915\u094b \u092e\u094d\u092f\u0942\u091f \u092f\u093e \u0905\u0928\u092b\u0949\u0932\u094b \u0915\u0930\u0947\u0902, \u091c\u093f\u0928\u0938\u0947 \u0906\u092a \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092c\u0941\u0930\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenzia o smetti di seguire tutti gli account che ti fanno sentire peggio dopo la lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u3093\u3060\u5f8c\u306b\u6c17\u5206\u304c\u60aa\u304f\u306a\u308b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u3059\u3079\u3066\u30df\u30e5\u30fc\u30c8\u307e\u305f\u306f\u30d5\u30a9\u30ed\u30fc\u89e3\u9664\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77d\uc740 \ud6c4 \uae30\ubd84\uc774 \ub098\ube60\uc9c0\ub294 \ubaa8\ub4e0 \uacc4\uc815\uc744 \uc74c\uc18c\uac70\ud558\uac70\ub098 \ud314\ub85c\uc6b0\ub97c \ucde8\uc18c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dempen of ontvolg alle accounts waarna je je na het lezen slechter voelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycisz lub przesta\u0144 obserwowa\u0107 wszystkich, po kt\u00f3rych czujesz si\u0119 gorzej po przeczytaniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencie ou deixe de seguir todas as contas que te fazem sentir pior depois de ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0437\u0432\u0443\u043a \u0438\u043b\u0438 \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0443 \u043d\u0430 \u043b\u044e\u0431\u044b\u0435 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0432\u0430\u0441 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0445\u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0438\u0445 \u043f\u0440\u043e\u0447\u0442\u0435\u043d\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuduktan sonra kendini daha k\u00f6t\u00fc hissettiren t\u00fcm hesaplar\u0131 sessize al veya takipten \u00e7\u0131k."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9759\u97f3\u6216\u53d6\u6d88\u5173\u6ce8\u4efb\u4f55\u8ba9\u60a8\u5728\u9605\u8bfb\u540e\u611f\u89c9\u66f4\u7cdf\u7684\u5e10\u6237\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u975c\u97f3\u6216\u53d6\u6d88\u8ffd\u8e64\u4efb\u4f55\u8b93\u60a8\u5728\u95b1\u8b80\u5f8c\u611f\u89ba\u66f4\u7cdf\u7684\u5e33\u6236\u3002"
          }
        }
      }
    },
    "trash.negativitaets_feed.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Negatives Nachrichten-Konsumieren erh\u00f6ht Angstzust\u00e4nde messbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consuming negative news measurably increases anxiety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El consumo de noticias negativas aumenta de forma mensurable la ansiedad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La consommation de nouvelles n\u00e9gatives augmente l'anxi\u00e9t\u00e9 de mani\u00e8re mesurable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u0938\u092e\u093e\u091a\u093e\u0930\u094b\u0902 \u0915\u093e \u0909\u092a\u092d\u094b\u0917 \u092e\u093e\u092a\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u091a\u093f\u0902\u0924\u093e \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il consumo di notizie negative aumenta misurabilmente l'ansia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30cd\u30ac\u30c6\u30a3\u30d6\u306a\u30cb\u30e5\u30fc\u30b9\u3092\u6d88\u8cbb\u3059\u308b\u3053\u3068\u3067\u3001\u4e0d\u5b89\u304c\u6e2c\u5b9a\u53ef\u80fd\u306a\u307b\u3069\u5897\u52a0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubd80\uc815\uc801\uc778 \ub274\uc2a4\ub97c \uc18c\ube44\ud558\uba74 \ubd88\uc548\uc774 \uce21\uc815 \uac00\ub2a5\ud558\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumptie van negatief nieuws verhoogt angststoornissen meetbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsumowanie negatywnych wiadomo\u015bci mierzalnie zwi\u0119ksza l\u0119k."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O consumo de not\u00edcias negativas aumenta visivelmente a ansiedade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439 \u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0442\u0440\u0435\u0432\u043e\u0433\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olumsuz haber t\u00fcketimi kayg\u0131y\u0131 \u00f6l\u00e7\u00fclebilir bi\u00e7imde art\u0131r\u0131r."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u53d7\u8d1f\u9762\u65b0\u95fb\u4f1a\u663e\u7740\u589e\u52a0\u7126\u8651\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u53d7\u8ca0\u9762\u65b0\u805e\u6703\u986f\u8457\u589e\u52a0\u7126\u616e\u3002"
          }
        }
      }
    },
    "trash.negativitaets_feed.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimme 1 feste Zeit f\u00fcr Nachrichten \u2013 danach kein Nachrichten-Konsum mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set 1 fixed time for news \u2013 then no more news consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece 1 hora fija para las noticias: despu\u00e9s, nada m\u00e1s de consumo de noticias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe 1 moment fixe pour les nouvelles \u2013 puis plus de consommation de nouvelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0938\u092e\u092f \u0924\u092f \u0915\u0930\u0947\u0902 \u2013 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0915\u094b\u0908 \u0938\u0902\u0926\u0947\u0936 \u0926\u0947\u0916\u0928\u093e \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisci 1 orario fisso per le notizie \u2013 poi niente pi\u00f9 consumo di notizie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30cb\u30e5\u30fc\u30b9\u306e\u305f\u3081\u306e\u56fa\u5b9a\u6642\u9593\u30921\u3064\u6c7a\u3081\u307e\u3057\u3087\u3046\u3002\u305d\u306e\u5f8c\u306f\u30cb\u30e5\u30fc\u30b9\u3092\u6d88\u8cbb\u3057\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub274\uc2a4\ub97c \uc704\ud55c \uace0\uc815\ub41c \uc2dc\uac04 1\uac1c\ub97c \uc124\uc815\ud558\uc138\uc694 \u2013 \uadf8 \ud6c4\uc5d0\ub294 \ub274\uc2a4 \uc18c\ube44 \uc5c6\uc774 \uc9c0\ub0b4\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal 1 vast tijdstip voor nieuws \u2013 daarna geen nieuwsconsumptie meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyznacz 1 sta\u0142y czas na wiadomo\u015bci \u2013 potem \u017cadnego konsumowania wiadomo\u015bci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina 1 hor\u00e1rio fixo para not\u00edcias \u2013 depois sem mais consumo de not\u00edcias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 1 \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439 \u2013 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haberler i\u00e7in 1 sabit zaman belirle \u2013 sonra haber t\u00fcketimi yapma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e 1 \u4e2a\u56fa\u5b9a\u7684\u65b0\u95fb\u65f6\u95f4 - \u4e4b\u540e\uff0c\u4e0d\u518d\u6d88\u8d39\u65b0\u95fb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a 1 \u500b\u56fa\u5b9a\u7684\u65b0\u805e\u6642\u9593 - \u4e4b\u5f8c\uff0c\u4e0d\u518d\u6d88\u8cbb\u65b0\u805e\u3002"
          }
        }
      }
    },
    "trash.negativitaets_feed.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere: Wie hast du dich nach den letzten Nachrichten gef\u00fchlt? Und was hat es gebracht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: how did you feel after the last news? And what did it bring you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota: \u00bfc\u00f3mo te sentiste despu\u00e9s de las \u00faltimas noticias? \u00bfY qu\u00e9 te aport\u00f3?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note : comment t'es-tu senti apr\u00e8s les derni\u00e8res nouvelles ? Et qu'est-ce que \u00e7a t'a apport\u00e9 ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093f\u0916\u094b: \u092a\u093f\u091b\u0932\u0940 \u0916\u092c\u0930\u094b\u0902 \u0915\u0947 \u092c\u093e\u0926 \u0924\u0941\u092e\u0928\u0947 \u0915\u0948\u0938\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u093f\u092f\u093e? \u0914\u0930 \u0907\u0938\u0938\u0947 \u0915\u094d\u092f\u093e \u0939\u093e\u0938\u093f\u0932 \u0939\u0941\u0906?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: come ti sei sentito dopo le ultime notizie? E cosa ti ha portato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u7559\u3081\u307e\u3057\u3087\u3046\u3002\u6700\u5f8c\u306e\u30cb\u30e5\u30fc\u30b9\u306e\u5f8c\u3001\u3069\u306e\u3088\u3046\u306b\u611f\u3058\u307e\u3057\u305f\u304b\uff1f\u305d\u3057\u3066\u4f55\u3092\u3082\u305f\u3089\u3057\u3066\u304f\u308c\u307e\u3057\u305f\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae30\ub85d\ud558\uc138\uc694: \ub9c8\uc9c0\ub9c9 \ub274\uc2a4 \ud6c4 \uc5b4\ub5a4 \uae30\ubd84\uc774\uc5c8\ub098\uc694? \uadf8\uac83\uc774 \ubb34\uc5c7\uc744 \uac00\uc838\ub2e4 \uc8fc\uc5c8\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noteer: hoe voelde je je na het laatste nieuws? En wat heeft het opgeleverd?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz: jak si\u0119 czu\u0142e\u015b po ostatnich wiadomo\u015bciach? I co ci to przynios\u0142o?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote: como voc\u00ea se sentiu ap\u00f3s as \u00faltimas not\u00edcias? E o que isso trouxe para voc\u00ea?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435: \u0427\u0442\u043e \u0432\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445 \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439? \u0418 \u0447\u0435\u0433\u043e \u044d\u0442\u043e \u0434\u0430\u043b\u043e?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaz: son haberlerden sonra nas\u0131l hissettin? Ve bu sana ne getirdi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bb0\uff1a\u542c\u5230\u6700\u8fd1\u7684\u6d88\u606f\u540e\u60a8\u6709\u4f55\u611f\u53d7\uff1f\u5b83\u53d6\u5f97\u4e86\u4ec0\u4e48\u6210\u679c\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a18\uff1a\u807d\u5230\u6700\u8fd1\u7684\u6d88\u606f\u5f8c\u60a8\u6709\u4f55\u611f\u53d7\uff1f\u5b83\u53d6\u5f97\u4e86\u4ec0\u9ebc\u6210\u679c\uff1f"
          }
        }
      }
    },
    "trash.negativitaets_feed.tips": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schlechte Gewohnheit loswerden (Negativer News Feed)**\n1. Unsichtbar machen: Entferne die Ausl\u00f6ser aus deinem Sichtfeld.\n2. Unattraktiv machen: Mache dir die negativen Folgen bewusst.\n3. Schwierig machen: Baue H\u00fcrden ein (z.B. Apps l\u00f6schen, Stecker ziehen).\n4. Unbefriedigend machen: Verbinde die Ausf\u00fchrung mit einer Strafe.\n\n**Gute Gewohnheit etablieren (Positives Journaling)**\n1. Offensichtlich machen: Platziere den Ausl\u00f6ser gut sichtbar.\n2. Attraktiv machen: Verbinde es mit etwas, das du magst.\n3. Einfach machen: Reduziere die H\u00fcrden auf ein Minimum (z.B. nur 2 Minuten).\n4. Befriedigend machen: Belohne dich direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Negativer News Feed)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Positives Journaling)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Negativer News Feed)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Positives Journaling)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Negativer News Feed)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Positives Journaling)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**\u0916\u0930\u093e\u092c \u0906\u0926\u0924 \u0915\u094b \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e (\u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u0928\u094d\u092f\u0942\u091c\u093c \u092b\u093c\u0940\u0921)**\n1. \u0905\u0926\u0943\u0936\u094d\u092f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930\u094d\u0938 \u0915\u094b \u0905\u092a\u0928\u0940 \u0926\u0943\u0936\u094d\u092f \u0938\u0940\u092e\u093e \u0938\u0947 \u0939\u091f\u093e \u0926\u0947\u0902\u0964\n2. \u0905\u092a\u094d\u0930\u093f\u092f \u092c\u0928\u093e\u0928\u093e: \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u091c\u093e\u0917\u0930\u0942\u0915 \u0939\u094b \u091c\u093e\u090f\u0901\u0964\n3. \u092e\u0941\u0936\u094d\u0915\u093f\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u090f\u0901 \u0921\u093e\u0932\u0947\u0902 (\u091c\u0948\u0938\u0947 \u0910\u092a\u094d\u0938 \u0939\u091f\u093e\u0928\u093e, \u092a\u094d\u0932\u0917 \u0928\u093f\u0915\u093e\u0932\u0928\u093e)\u0964\n4. \u0905\u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0915\u093e\u0930\u094d\u092f \u0915\u094b \u0915\u093f\u0938\u0940 \u0926\u0902\u0921 \u0915\u0947 \u0938\u093e\u0925 \u091c\u094b\u0921\u093c\u0947\u0902\u0964\n\n**\u0905\u091a\u094d\u091b\u0940 \u0906\u0926\u0924 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u093e (\u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u091c\u0930\u094d\u0928\u0932\u093f\u0902\u0917)**\n1. \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u0928\u093e\u0928\u093e: \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u094b \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0916\u0947\u0902\u0964\n2. \u0906\u0915\u0930\u094d\u0937\u0915 \u092c\u0928\u093e\u0928\u093e: \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0910\u0938\u0940 \u091a\u0940\u091c\u093c \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n3. \u0938\u0930\u0932 \u092c\u0928\u093e\u0928\u093e: \u092c\u093e\u0927\u093e\u0913\u0902 \u0915\u094b \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u092a\u0930 \u0918\u091f\u093e\u090f\u0901 (\u091c\u0948\u0938\u0947 \u0915\u0947\u0935\u0932 2 \u092e\u093f\u0928\u091f)\u0964\n4. \u0938\u0902\u0924\u094b\u0937\u091c\u0928\u0915 \u092c\u0928\u093e\u0928\u093e: \u0924\u0941\u0930\u0902\u0924 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0916\u0941\u0926 \u0915\u094b \u0907\u0928\u093e\u092e \u0926\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Negativer News Feed)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Positives Journaling)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Break bad habit (Negativer News Feed)**\n1. Make it invisible: Remove cues from your environment.\n2. Make it unattractive: Highlight the negative consequences.\n3. Make it difficult: Increase friction (e.g. delete apps).\n4. Make it unsatisfying: Create an immediate penalty.\n\n**Build good habit (Positives Journaling)**\n1. Make it obvious: Place cues in plain sight.\n2. Make it attractive: Pair it with an action you want to do.\n3. Make it easy: Reduce friction (e.g. 2-minute rule).\n4. Make it satisfying: Reward yourself immediately."

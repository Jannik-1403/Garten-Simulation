    "prog_noalcohol_d3_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollte Verlangen aufkommen: Kämpfe nicht dagegen an. Beobachte das Gefühl wie eine Welle, die ansteigt und wieder bricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the desire arises, don't fight it. Observe the feeling of a wave rising and breaking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si surge el deseo, no luches contra él. Observe la sensación de una ola subiendo y rompiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le désir surgit, ne le combattez pas. Observez la sensation d'une vague qui monte et se brise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि इच्छा उत्पन्न हो तो उससे लड़ो मत। किसी लहर के उठने और टूटने की अनुभूति का निरीक्षण करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sorge il desiderio, non combatterlo. Osserva la sensazione di un'onda che si alza e si infrange."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欲望が生じても、それと戦わないでください。波が上がったり砕けたりする感覚を観察してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "욕망이 생기면 맞서 싸우지 마십시오. 파도가 일어나고 부서지는 느낌을 관찰해보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het verlangen opkomt, vecht er dan niet tegen. Observeer het gevoel van een golf die opkomt en breekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli pojawi się pragnienie, nie walcz z nim. Obserwuj uczucie wznoszącej się i załamującej fali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o desejo surgir, não lute contra ele. Observe a sensação de uma onda subindo e quebrando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o desejo surgir, não lute contra ele. Observe a sensação de uma onda subindo e quebrando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "If the desire arises, don't fight it. Наблюдайте за ощущением волны, поднимающейся и разбивающейся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arzu ortaya çıkarsa, onunla savaşmayın. Yükselen ve kırılan bir dalga hissini gözlemleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果欲望出现，就不要抗拒它。观察波浪上升和破碎的感觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果慾望出現，就不要抗拒它。觀察波浪上升和破碎的感覺。"
          }
        }
      }
    },

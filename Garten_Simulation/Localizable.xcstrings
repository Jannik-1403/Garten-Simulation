        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज ही अपने पसंदीदा व्यायाम का वजन सबसे छोटी डिस्क (1 किग्रा / 1.25 किग्रा) तक बढ़ाएं।"

            "state": "translated",
            "value": "Duermo muy poco porque juego o salgo hasta las 4 a.m."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dors extrêmement peu parce que je joue ou que je sors jusqu'à 4 heures du matin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

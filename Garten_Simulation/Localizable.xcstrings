    "assessment.mental.profile.getriebener.action": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde deinen Fokus und lerne, Nein zu sagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your focus and learn to say no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra tu enfoque y aprende a decir no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez votre concentration et apprenez à dire non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova la tua concentrazione e impara a dire di no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の焦点を見つけて、ノーと言う方法を学びましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점을 찾고 거절하는 법을 배우십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind uw focus en leer nee zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź swoje skupienie i naucz się mówić nie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre seu foco e aprenda a dizer não."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak noktanızı bulun ve hayır demeyi öğrenin."
          }
        }
      }
    },

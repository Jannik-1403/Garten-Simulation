    "pfad_fit_phase_einstieg_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewöhne deinen Körper an tägliche Bewegung. Kleine Schritte führen weit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get your body used to daily movement. Small steps go a long way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostumbra tu cuerpo al movimiento diario. Los pequeños pasos llevan lejos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitue ton corps à une activité quotidienne. Les petits pas mènent loin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abitua il tuo corpo al movimento quotidiano. Piccoli passi portano lontano."

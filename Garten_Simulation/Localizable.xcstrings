        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я немедленно исключу это из своего рациона и проверю, станет ли мне от этого лучше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemen diyetimden çıkardım ve kendimi daha iyi hissettirip hissettirmediğine baktım."

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экономьте свои деньги вместо того, чтобы тратить их на микротранзакции и азартные игры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

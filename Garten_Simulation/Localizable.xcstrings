    "iap_restore_hint": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " WICHTIG: 'K\u00e4ufe wiederherstellen' funktioniert bei Apple NUR f\u00fcr Einmalk\u00e4ufe (wie die Sonnenbrille). M\u00fcnzen (Consumables) k\u00f6nnen laut Apple-Regeln niemals wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANT: 'Restore Purchases' ONLY works for non-consumables (like the sunglasses). Coins (consumables) can never be restored according to Apple rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Restaurar compras' SOLO funciona para compras no consumibles (como las gafas de sol). Las monedas no se pueden restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANT : 'Restaurer les achats' fonctionne UNIQUEMENT pour les achats non consommables (comme les lunettes). Les pi\u00e8ces ne peuvent pas \u00eatre restaur\u00e9es."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923: Apple \u0915\u0940 '\u0930\u093f\u0938\u094d\u091f\u094b\u0930 \u092a\u0930\u091a\u0947\u091c\u093c' \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u0915\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 (\u091c\u0948\u0938\u0947 \u0927\u0942\u092a \u0915\u093e \u091a\u0936\u094d\u092e\u093e) \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 Apple \u0915\u0947 \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0938\u093f\u0915\u094d\u0915\u0947 (\u0909\u092a\u092d\u094b\u0917\u094d\u092f \u0935\u0938\u094d\u0924\u0941\u090f\u0902) \u0915\u092d\u0940 \u092d\u0940 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Ripristina acquisti' funziona SOLO per articoli non di consumo (come gli occhiali da sole). Le monete non possono essere ripristinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " \u91cd\u8981: \u300c\u8cfc\u5165\u306e\u5fa9\u5143\u300d\u306f\u3001\u975e\u6d88\u8017\u54c1\uff08\u30b5\u30f3\u30b0\u30e9\u30b9\u306a\u3069\uff09\u306b\u306e\u307f\u6a5f\u80fd\u3057\u307e\u3059\u3002\u30b3\u30a4\u30f3\u306f\u5fa9\u5143\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " \uc911\uc694: '\uad6c\ub9e4 \ubcf5\uc6d0'\uc740 \ube44\uc18c\ubaa8\ud488(\uc120\uae00\ub77c\uc2a4 \ub4f1)\uc5d0\ub9cc \uc801\uc6a9\ub429\ub2c8\ub2e4. \ucf54\uc778\uc740 \ubcf5\uc6d0\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " BELANGRIJK: 'Aankopen herstellen' werkt ALLEEN voor niet-verbruiksartikelen (zoals zonnebrillen). Munten kunnen niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " WA\u017bNE: 'Przywr\u00f3\u0107 zakupy' dzia\u0142a TYLKO dla przedmiot\u00f3w jednorazowych (jak okulary). Monet nie mo\u017cna przywr\u00f3ci\u0107."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " IMPORTANTE: 'Restaurar Compras' funciona APENAS para n\u00e3o consum\u00edveis (como \u00f3culos de sol). Moedas nunca podem ser restauradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0410\u0416\u041d\u041e: \u00ab\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u043e\u043a\u0443\u043f\u043a\u0438\u00bb \u0443 Apple \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0422\u041e\u041b\u042c\u041a\u041e \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0440\u0430\u0437\u043e\u0432\u044b\u0445 \u043f\u043e\u043a\u0443\u043f\u043e\u043a (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0447\u043a\u0438 \u043e\u0442 \u0441\u043e\u043b\u043d\u0446\u0430). \u041c\u043e\u043d\u0435\u0442\u044b (\u0440\u0430\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b) \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c Apple \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u044b."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " \u00d6NEML\u0130: 'Sat\u0131n Al\u0131nanlar\u0131 Geri Y\u00fckle' SADECE g\u00fcne\u015f g\u00f6zl\u00fc\u011f\u00fc gibi kal\u0131c\u0131 \u00f6\u011feler i\u00e7in \u00e7al\u0131\u015f\u0131r. Jetonlar geri y\u00fcklenemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " \u91cd\u8981\u63d0\u793a\uff1a\u5728 Apple \u8bbe\u5907\u4e0a\uff0c'\u6062\u590d\u8d2d\u4e70'\u4ec5\u9002\u7528\u4e8e\u4e00\u6b21\u6027\u8d2d\u4e70\uff08\u5982\u592a\u9633\u955c\uff09\u3002\u6839\u636e Apple \u89c4\u5219\uff0c\u91d1\u5e01\uff08\u6d88\u8017\u54c1\uff09\u6c38\u8fdc\u65e0\u6cd5\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u8981\u63d0\u793a\uff1aApple \u7684\u300c\u6062\u5fa9\u8cfc\u8cb7\u300d\u50c5\u9069\u7528\u65bc\u4e00\u6b21\u6027\u8cfc\u8cb7\uff08\u4f8b\u5982\u592a\u967d\u773c\u93e1\uff09\u3002\u6839\u64da\u860b\u679c\u898f\u5b9a\uff0c\u91d1\u5e63\uff08\u6d88\u8017\u54c1\uff09\u6c38\u9060\u7121\u6cd5\u6062\u5fa9\u3002"
          }
        }
      }
    },

            "value": "\u092e\u0948\u0902\u0928\u0947 \u0928\u093f\u092f\u092e \u090f\u0935\u0902 \u0936\u0930\u094d\u0924\u0947\u0902 \u092a\u0922\u093c \u0932\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928\u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u0942\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho letto e accetto le condizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u898f\u7d04\u3092\u8aad\u307f\u3001\u540c\u610f\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc57d\uad00\uc744 \uc77d\uc5c8\uc73c\uba70 \uc774\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de voorwaarden gelezen en ga ermee akkoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczyta\u0142em warunki i zgadzam si\u0119."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Li e concordo com os termos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eartlar\u0131 okudum ve kabul ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5df2\u9605\u8bfb\u5e76\u540c\u610f\u6761\u6b3e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u5df2\u95b1\u8b80\u4e26\u540c\u610f\u689d\u6b3e\u548c\u689d\u4ef6\u3002"
          }
        }
      }
    },
    "onboarding_legal_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du loslegst, bitten wir dich, unsere Bedingungen zu akzeptieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you get started, please accept our terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de empezar, acepta nuestros t\u00e9rminos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de commencer, veuillez accepter nos conditions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0930\u0902\u092d \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947, \u0939\u092e \u0906\u092a\u0938\u0947 \u0939\u092e\u093e\u0930\u0947 \u0928\u093f\u092f\u092e \u0914\u0930 \u0936\u0930\u094d\u0924\u0947\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di iniziare, accetta i nostri termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u59cb\u3081\u308b\u524d\u306b\u3001\u5229\u7528\u898f\u7d04\u306b\u540c\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \uc57d\uad00\uc5d0 \ub3d9\uc758\ud574 \uc8fc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepteer eerst onze voorwaarden voordat u aan de slag gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim zaczniesz, zaakceptuj nasze warunki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de come\u00e7ares, aceita os nossos termos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043d\u0430\u0447\u0430\u0442\u044c, \u043c\u044b \u043f\u0440\u043e\u0441\u0438\u043c \u0432\u0430\u0441 \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u043d\u0430\u0448\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u015flamadan \u00f6nce l\u00fctfen \u015fartlar\u0131m\u0131z\u0131 kabul edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5f00\u59cb\u4e4b\u524d\uff0c\u8bf7\u4f60\u63a5\u53d7\u6211\u4eec\u7684\u6761\u6b3e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u958b\u59cb\u4e4b\u524d\uff0c\u6211\u5011\u8981\u6c42\u60a8\u63a5\u53d7\u6211\u5011\u7684\u689d\u6b3e\u548c\u689d\u4ef6\u3002"
          }
        }
      }
    },

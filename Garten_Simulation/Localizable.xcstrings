    "assessment.finance.profile.verdraenger.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du weißt, dass du es wissen solltest – aber du schaust nicht hin. Das ist keine Faulheit. Das ist finanzielle Angst. Und sie kostet dich jeden Monat bares Geld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You know you should know - but you're not looking. This is not laziness. This is financial fear. And it costs you money every month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabes que deberías saberlo, pero no estás mirando. Esto no es pereza. Este es el miedo financiero. Y te cuesta dinero todos los meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous savez que vous devriez le savoir, mais vous ne cherchez pas. Ce n'est pas de la paresse. C'est une peur financière. Et cela vous coûte de l'argent chaque mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sai che dovresti saperlo, ma non stai guardando. Questa non è pigrizia. Questa è la paura finanziaria. E ti costa soldi ogni mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知るべきだと分かっているのに、探していないのです。これは怠惰ではありません。これは経済的恐怖です。そして毎月お金もかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 알아야 한다는 것을 알지만, 당신은 보고 있지 않습니다. 이것은 게으름이 아닙니다. 이것은 재정적 두려움입니다. 그리고 매달 돈이 듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je weet dat je het moet weten, maar je kijkt niet. Dit is geen luiheid. Dit is financiële angst. En het kost je elke maand geld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiesz, że powinieneś wiedzieć, ale nie patrzysz. To nie jest lenistwo. To strach finansowy. A to kosztuje Cię co miesiąc."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sabe que deveria saber - mas não está olhando. Isso não é preguiça. Este é o medo financeiro. E isso custa dinheiro todo mês."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilmen gerektiğini biliyorsun ama bakmıyorsun. Bu tembellik değil. Bu finansal korkudur. Ve bu size her ay paraya mal olur."
          }
        }
      }
    },
    "assessment.finance.profile.verdraenger.title": {

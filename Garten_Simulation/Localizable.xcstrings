    "plant.kirschbaum.symbolism": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir bewusst Zeit f\u00fcr dich selbst und dein Wohlbefinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consciously take time for yourself and your well-being."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3mate el tiempo conscientemente para ti y tu bienestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez consciemment du temps pour vous et votre bien-\u00eatre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0932\u093f\u090f \u0914\u0930 \u0905\u092a\u0928\u0940 \u092d\u0932\u093e\u0908 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u0938\u092e\u092f \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi consapevolmente del tempo per te stesso e per il tuo benessere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u610f\u8b58\u7684\u306b\u81ea\u5206\u306e\u6642\u9593\u3068\u5e78\u798f\u306e\u305f\u3081\u306b\u6642\u9593\u3092\u53d6\u308a\u307e\u3057\u3087\u3046\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc758\uc2dd\uc801\uc73c\ub85c \uc790\uc2e0\uacfc \uc6f0\ube59\uc744 \uc704\ud55c \uc2dc\uac04\uc744 \uac00\uc9c0\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem bewust tijd voor jezelf en je welzijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015awiadomie po\u015bwi\u0119\u0107 czas dla siebie i swojego dobrego samopoczucia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedique conscientemente um tempo para si e para o seu bem-estar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u043e\u0441\u043e\u0437\u043d\u0430\u043d\u043d\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u0438 \u0441\u0432\u043e\u0435\u0433\u043e \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u0438\u044f."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilin\u00e7li olarak kendinize ve refah\u0131n\u0131za zaman ay\u0131r\u0131n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u610f\u8bc6\u5730\u4e3a\u81ea\u5df1\u548c\u5e78\u798f\u7559\u51fa\u65f6\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u610f\u8b58\u5730\u70ba\u81ea\u5df1\u548c\u81ea\u5df1\u7684\u5e78\u798f\u82b1\u9ede\u6642\u9593\u3002"
          }
        }
      }
    },
    "plant.klee.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleines Gl\u00fcck, t\u00e4glich gefunden \u2013 Dankbarkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small luck, found daily \u2013 Gratitude"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peque\u00f1a suerte, encontrada cada d\u00eda \u2013 Gratitud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petite chance, trouv\u00e9e chaque jour \u2013 Gratitude"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091b\u094b\u091f\u0940 \u0916\u0941\u0936\u093f\u092f\u093e\u0901, \u0930\u094b\u091c\u093c \u092a\u093e\u0908 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u2013 \u0906\u092d\u093e\u0930"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Small luck, found daily \u2013 Gratitude"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bce\u65e5\u898b\u3064\u304b\u308b\u5c0f\u3055\u306a\u5e78\u904b \u2013 \u611f\u8b1d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9e4\uc77c \ubc1c\uacac\ub418\ub294 \uc791\uc740 \ud589\uc6b4 \u2013 \uac10\uc0ac"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein geluk, dagelijks gevonden \u2013 Dankbaarheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma\u0142e szcz\u0119\u015bcie, kt\u00f3re mo\u017cna znale\u017a\u0107 codziennie \u2013 Wdzi\u0119czno\u015b\u0107"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequena sorte, encontrada todos os dias \u2013 Gratid\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u043b\u043e\u0435 \u0441\u0447\u0430\u0441\u0442\u044c\u0435, \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u043e\u0435 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u2014 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her g\u00fcn bulunan k\u00fc\u00e7\u00fck \u015fans \u2013 \u015e\u00fckran"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c0f\u5c0f\u7684\u5e78\u798f\uff0c\u6bcf\u5929\u90fd\u80fd\u627e\u5230 \u2013 \u611f\u6069"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u767c\u73fe\u7684\u5c0f\u5e78\u798f\uff0d\u611f\u6069"
          }
        }
      }
    },

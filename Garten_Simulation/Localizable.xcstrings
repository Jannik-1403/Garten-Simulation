    "onboarding_tutorial_5_text": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenst\u00e4nde lassen Unkraut wachsen, das XP und Fortschritt blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items can cause weeds to grow, hindering XP and progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetos pueden hacer que crezcann malas hierbas, lo que dificulta la XP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objets peuvent faire de l'herbe pousse, ce qui freine l'XP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0907\u091f\u092e \u0916\u0930\u092a\u0924\u0935\u093e\u0930 \u0909\u0917\u0928\u0947 \u0915\u093e \u0915\u093e\u0930\u0923 \u092c\u0928\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u0938\u0947 \u090f\u0915\u094d\u0938\u092a\u0940 \u0914\u0930 \u092a\u094d\u0930\u0917\u0924\u093f \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggetti possono far crescere le erbacce, ostacolando l'XP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30a4\u30c6\u30e0\u306f\u96d1\u8349\u3092\u751f\u9577\u3055\u305b\u3001XP \u3084\u9032\u884c\u3092\u59a8\u3052\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc774\ud15c\uc73c\ub85c \uc778\ud574 \uc7a1\ucd08\uac00 \uc790\ub77c XP\uc640 \uc9c4\ud589\uc744 \ubc29\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items kunnen ervoor zorgen dat onkruid groeit, waardoor XP en voortgang worden belemmerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedmioty mog\u0105 powodowa\u0107 wzrost chwast\u00f3w, utrudniaj\u0105c zdobywanie punkt\u00f3w do\u015bwiadczenia i post\u0119p."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens podem causar ervas daninhas, dificultando o XP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u0440\u0430\u0441\u0442\u0438 \u0441\u043e\u0440\u043d\u044f\u043a\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0442 XP \u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6\u011feler yabani otlar\u0131n b\u00fcy\u00fcmesine neden olarak XP'yi ve ilerlemeyi engelleyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7269\u54c1\u4f1a\u8ba9\u6742\u8349\u751f\u957f\uff0c\u963b\u788d\u7ecf\u9a8c\u503c\u548c\u8fdb\u5ea6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7269\u54c1\u6703\u5c0e\u81f4\u96dc\u8349\u751f\u9577\uff0c\u963b\u7919\u7d93\u9a57\u503c\u548c\u9032\u5ea6\u3002"
          }
        }
      }
    },
    "onboarding_tutorial_5_titel": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {

    "trash.schlaf_killer_koffein.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere Koffein, um abends leichter zur Ruhe zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce caffeine to find it easier to rest in the evening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la cafeína para que te sea más fácil descansar por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduis la caféine pour trouver plus facilement le repos le soir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci la caffeina per trovare più facilmente riposo la sera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕方にリラックスしやすくするために、カフェインを減らしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁에 더 쉽게 쉴 수 있도록 카페인을 줄이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder cafeïne om 's avonds makkelijker tot rust te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz spożycie kofeiny, aby ułatwić sobie zasypianie wieczorem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza a cafeína para facilitar o descanso à noite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşamları dinlenmeyi kolaylaştırmak için kafeini azaltın."
          }
        }
      }
    },
    "trash.schlaf_killer_koffein.impact": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gewohnheit (Zu viel Koffein) kostet dich langfristig Energie, Zeit und Geld. Sie hindert dich daran, dein volles Potenzial auszuschöpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This habit (Zu viel Koffein) costs you energy, time, and money in the long run. It prevents you from reaching your full potential."

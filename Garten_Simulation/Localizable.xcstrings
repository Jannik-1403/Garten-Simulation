    "shop.seeds.desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paket mit 10 magischen Samen. Damit kannst du dir deine eigene, einzigartige Pflanze erschaffen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A packet of 10 magical seeds. Use them to create your own unique plant!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquete de 10 semillas mágicas. ¡Úsalas para crear tu propia planta única!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paquet de 10 graines magiques. Utilisez-les pour créer votre propre plante unique !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pacchetto di 10 semi magici. Usali per creare la tua pianta unica!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10個の魔法の種のパケット。これを使って自分だけのユニークな植物を作りましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10개의 마법 씨앗 패킷입니다. 이것으로 자신만의 독특한 식물을 만들어보세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pakket met 10 magische zaden. Gebruik ze om je eigen unieke plant te creëren!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet 10 magicznych nasion. Użyj ich, aby stworzyć własną unikalną roślinę!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pacote de 10 sementes mágicas. Usa-as para criar a tua própria planta única!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 sihirli tohum paketi. Kendi benzersiz bitkini yaratmak için kullan!"
          }
        }
      }
    },

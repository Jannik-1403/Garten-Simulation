          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga diferentes zonas do jardim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \u0440\u0430\u0437\u043d\u044b\u0435 \u0443\u0447\u0430\u0441\u0442\u043a\u0438 \u0441\u0430\u0434\u0430."

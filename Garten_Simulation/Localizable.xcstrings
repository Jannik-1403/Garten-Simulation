    "weekly_report.feedback.desc.negative": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche war etwas ruhiger. Deine Fokuszeit ist um %@ gesunken. Kopf hoch, n\u00e4chste Woche wird wieder produktiver!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week was a bit quieter. Your focus time decreased by %@. Keep your head up, next week will be more productive!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana estuvo un poco m\u00e1s tranquila. Tu tiempo de enfoque disminuy\u00f3 un %@. \u00a1\u00c1nimo, la pr\u00f3xima semana ser\u00e1 m\u00e1s productiva!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette semaine a \u00e9t\u00e9 un peu plus calme. Votre temps de focus a diminu\u00e9 de %@. Gardez la t\u00eate haute, la semaine prochaine sera plus productive !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0938\u092a\u094d\u0924\u093e\u0939 \u0925\u094b\u0921\u093c\u093e \u0936\u093e\u0902\u0924 \u0930\u0939\u093e\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0915\u0938 \u0938\u092e\u092f%@\u0924\u0915 \u0918\u091f \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u093f\u092e\u094d\u092e\u0924 \u0930\u0916\u0947\u0902, \u0905\u0917\u0932\u093e \u0938\u092a\u094d\u0924\u093e\u0939 \u092b\u093f\u0930 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0909\u0924\u094d\u092a\u093e\u0926\u0915 \u0939\u094b\u0917\u093e!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana \u00e8 stata un po' pi\u00f9 calma. Il tuo tempo di focus \u00e8 diminuito del %@. Non abbatterti, la prossima settimana sar\u00e0 pi\u00f9 produttiva!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u9031\u306f\u5c11\u3057\u843d\u3061\u7740\u3044\u305f\u9031\u3067\u3057\u305f\u3002\u30d5\u30a9\u30fc\u30ab\u30b9\u6642\u9593\u304c %@ \u6e1b\u5c11\u3057\u307e\u3057\u305f\u3002\u6c17\u3092\u53d6\u308a\u76f4\u3057\u3066\u3001\u6765\u9031\u306f\u3082\u3063\u3068\u751f\u7523\u7684\u306b\u3044\u304d\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubc88 \uc8fc\ub294 \uc870\uae08 \uc5ec\uc720\ub85c\uc6b4 \ud55c \uc8fc\uc600\uc2b5\ub2c8\ub2e4. \uc9d1\uc911 \uc2dc\uac04\uc774 %@ \uac10\uc18c\ud588\uc2b5\ub2c8\ub2e4. \ud798\ub0b4\uc138\uc694, \ub2e4\uc74c \uc8fc\ub294 \ub354 \uc0dd\uc0b0\uc801\uc778 \ud55c \uc8fc\uac00 \ub420 \uac83\uc785\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze week was wat rustiger. Je focustijd is met %@ afgenomen. Kop op, volgende week wordt productiever!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tydzie\u0144 by\u0142 nieco spokojniejszy. Tw\u00f3j czas skupienia spad\u0142 o %@. G\u0142owa do g\u00f3ry, przysz\u0142y tydzie\u0144 b\u0119dzie bardziej produktywny!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana foi um pouco mais calma. Seu tempo de foco diminuiu %@. Cabe\u00e7a erguida, a pr\u00f3xima semana ser\u00e1 mais produtiva!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043d\u0435\u0434\u0435\u043b\u044f \u043f\u0440\u043e\u0448\u043b\u0430 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0435\u0435. \u0412\u0430\u0448\u0435 \u0432\u0440\u0435\u043c\u044f \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u043e\u0432\u043a\u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u043b\u043e\u0441\u044c \u043d\u0430%@. \u041d\u0435 \u0443\u043d\u044b\u0432\u0430\u0439\u0442\u0435, \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u043d\u0435\u0434\u0435\u043b\u044f \u0441\u043d\u043e\u0432\u0430 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0439!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta biraz daha sakindi. Odaklanma s\u00fcreniz %@ azald\u0131. Ba\u015f\u0131n\u0131z\u0131 dik tutun, gelecek hafta daha verimli olacak!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5468\u7a0d\u5fae\u5b89\u9759\u4e00\u4e9b\u3002\u60a8\u7684\u4e13\u6ce8\u65f6\u95f4\u51cf\u5c11\u4e86%@\u3002\u52a0\u6cb9\uff0c\u4e0b\u5468\u53c8\u4f1a\u66f4\u6709\u6210\u6548\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u9031\u7a0d\u5fae\u5b89\u975c\u4e00\u9ede\u3002\u60a8\u7684\u5c08\u6ce8\u6642\u9593\u6e1b\u5c11\u4e86%@\u3002\u52a0\u6cb9\uff0c\u4e0b\u9031\u53c8\u6703\u66f4\u6709\u6548\u7387\uff01"
          }
        }
      }
    },
    "weekly_report.feedback.desc.negative_base": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche war etwas ruhiger und deine Fokuszeit ist um %@ gesunken. Aber mach dir keinen Kopf, Erholung ist genauso wichtig. N\u00e4chste Woche greifen wir wieder voll an!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week was a bit quieter and your focus time dropped by %@. But don't worry, recovery is just as important. Next week we'll go full throttle again!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana fue un poco m\u00e1s tranquila y tu tiempo de enfoque disminuy\u00f3 un %@. Pero no te preocupes, la recuperaci\u00f3n es igual de importante. \u00a1La semana que viene volvemos a por todas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette semaine \u00e9tait un peu plus calme et ton temps de concentration a baiss\u00e9 de %@. Mais ne t'inqui\u00e8te pas, la r\u00e9cup\u00e9ration est tout aussi importante. La semaine prochaine, on repart \u00e0 fond !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u092a\u094d\u0924\u093e\u0939 \u0925\u094b\u0921\u093c\u093e \u0936\u093e\u0902\u0924 \u0925\u093e \u0914\u0930 \u0906\u092a\u0915\u093e \u092b\u094b\u0915\u0938 \u0938\u092e\u092f%@\u0924\u0915 \u0917\u093f\u0930 \u0917\u092f\u093e\u0964 \u0932\u0947\u0915\u093f\u0928 \u091a\u093f\u0902\u0924\u093e \u092e\u0924 \u0915\u0930\u0947\u0902, \u0906\u0930\u093e\u092e \u092d\u0940 \u0909\u0924\u0928\u093e \u0939\u0940 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0964 \u0905\u0917\u0932\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 \u0939\u092e \u092b\u093f\u0930 \u092a\u0942\u0930\u0940 \u0924\u093e\u0915\u0924 \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0947\u0902\u0917\u0947!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana \u00e8 stata un po' pi\u00f9 tranquilla e il tuo tempo di concentrazione \u00e8 sceso del %@. Ma non preoccuparti, il recupero \u00e8 altrettanto importante. La settimana prossima ci riprendiamo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u9031\u306f\u5c11\u3057\u843d\u3061\u7740\u3044\u305f\u9031\u3067\u3001\u96c6\u4e2d\u6642\u9593\u304c%@\u6e1b\u5c11\u3057\u307e\u3057\u305f\u3002\u3067\u3082\u5fc3\u914d\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3001\u56de\u5fa9\u3082\u540c\u69d8\u306b\u91cd\u8981\u3067\u3059\u3002\u6765\u9031\u306f\u307e\u305f\u5168\u529b\u3067\u9811\u5f35\u308a\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubc88 \uc8fc\ub294 \uc870\uae08 \uc870\uc6a9\ud588\uace0 \uc9d1\uc911 \uc2dc\uac04\uc774 %@ \uc904\uc5c8\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uac71\uc815 \ub9c8\uc138\uc694, \ud68c\ubcf5\ub3c4 \ub611\uac19\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c \uc8fc\uc5d0\ub294 \ub2e4\uc2dc \uc804\ub825\uc744 \ub2e4\ud574\ubd05\uc2dc\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze week was wat rustiger en je focustijd daalde met %@. Maar maak je geen zorgen, herstel is even belangrijk. Volgende week gaan we er weer vol tegenaan!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tydzie\u0144 by\u0142 nieco spokojniejszy i tw\u00f3j czas skupienia spad\u0142 o %@. Ale nie martw si\u0119, odpoczynek jest r\u00f3wnie wa\u017cny. W przysz\u0142ym tygodniu wracamy do pe\u0142nej mocy!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana foi um pouco mais tranquila e seu tempo de foco caiu %@. Mas n\u00e3o se preocupe, a recupera\u00e7\u00e3o \u00e9 igualmente importante. Na pr\u00f3xima semana voltamos com tudo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043d\u0435\u0434\u0435\u043b\u044f \u0431\u044b\u043b\u0430 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0435\u0435, \u0438 \u0432\u0430\u0448\u0435 \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u043b\u043e\u0441\u044c \u043d\u0430%@. \u041d\u043e \u043d\u0435 \u0432\u043e\u043b\u043d\u0443\u0439\u0442\u0435\u0441\u044c, \u043e\u0442\u0434\u044b\u0445 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 \u0432\u0430\u0436\u0435\u043d. \u041d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u043c\u044b \u0441\u043d\u043e\u0432\u0430 \u0431\u0443\u0434\u0435\u043c \u0430\u0442\u0430\u043a\u043e\u0432\u0430\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta biraz daha sakin ge\u00e7ti ve odaklanma s\u00fcren %@ d\u00fc\u015ft\u00fc. Ama endi\u015felenme, toparlanma da ayn\u0131 derecede \u00f6nemli. Gelecek hafta yeniden tam gaz gidece\u011fiz!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5468\u6bd4\u8f83\u5b89\u9759\uff0c\u4f60\u7684\u4e13\u6ce8\u65f6\u95f4\u4e0b\u964d\u4e86%@\u3002\u4f46\u522b\u62c5\u5fc3\uff0c\u4f11\u606f\u4e5f\u540c\u6837\u91cd\u8981\u3002\u4e0b\u5468\u6211\u4eec\u5c06\u518d\u6b21\u51fa\u51fb\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u9031\u6bd4\u8f03\u5b89\u975c\uff0c\u4f60\u7684\u5c08\u6ce8\u6642\u9593\u4e0b\u964d\u4e86%@\u3002\u4f46\u5225\u64d4\u5fc3\uff0c\u4f11\u606f\u4e5f\u540c\u6a23\u91cd\u8981\u3002\u4e0b\u9031\u6211\u5011\u5c07\u518d\u6b21\u51fa\u64ca\uff01"
          }
        }
      }
    },
    "weekly_report.feedback.desc.negative_with_day": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche war etwas ruhiger. Deine Fokuszeit ist um %@ gesunken. Dein bester Tag war %@. N\u00e4chste Woche greifen wir wieder voll an!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week was a bit quieter. Your focus time decreased by %@. Your best day was %@. Let's attack again next week!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana estuvo un poco m\u00e1s tranquila. Tu tiempo de enfoque disminuy\u00f3 un %@. Tu mejor d\u00eda fue el %@. \u00a1Volveremos con todo la pr\u00f3xima semana!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette semaine a \u00e9t\u00e9 un peu plus calme. Votre temps de focus a diminu\u00e9 de %@. Votre meilleur jour \u00e9tait le %@. On s'y remet \u00e0 fond la semaine prochaine !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u092a\u094d\u0924\u093e\u0939 \u0925\u094b\u0921\u093c\u093e \u0936\u093e\u0902\u0924 \u0925\u093e\u0964 \u0906\u092a\u0915\u093e \u092b\u094b\u0915\u0938 \u0938\u092e\u092f%@\u0924\u0915 \u0918\u091f \u0917\u092f\u093e\u0964 \u0906\u092a\u0915\u093e \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u0926\u093f\u0928%@\u0925\u093e\u0964 \u0905\u0917\u0932\u0947 \u0938\u092a\u094d\u0924\u093e\u0939 \u0939\u092e \u092b\u093f\u0930 \u0938\u0947 \u092a\u0942\u0930\u0940 \u0924\u093e\u0915\u0924 \u0938\u0947 \u0906\u0917\u0947 \u092c\u0922\u093c\u0947\u0902\u0917\u0947!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana \u00e8 stata un po' pi\u00f9 calma. Il tuo tempo di focus \u00e8 diminuito del %@. Il tuo giorno migliore \u00e8 stato %@. Riproviamoci la prossima settimana!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u9031\u306f\u5c11\u3057\u843d\u3061\u7740\u3044\u305f\u9031\u3067\u3057\u305f\u3002\u30d5\u30a9\u30fc\u30ab\u30b9\u6642\u9593\u304c %@ \u6e1b\u5c11\u3057\u307e\u3057\u305f\u3002\u6700\u3082\u826f\u304b\u3063\u305f\u65e5\u306f %@ \u3067\u3059\u3002\u6765\u9031\u307e\u305f\u9811\u5f35\u308a\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubc88 \uc8fc\ub294 \uc870\uae08 \uc5ec\uc720\ub85c\uc6b4 \ud55c \uc8fc\uc600\uc2b5\ub2c8\ub2e4. \uc9d1\uc911 \uc2dc\uac04\uc774 %@ \uac10\uc18c\ud588\uc2b5\ub2c8\ub2e4. \uac00\uc7a5 \uc88b\uc558\ub358 \uc694\uc77c\uc740 %@\uc600\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \uc8fc\uc5d0 \ub2e4\uc2dc \ud798\ucc28\uac8c \ub2ec\ub824\ubd05\uc2dc\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze week was wat rustiger. Je focustijd is met %@ afgenomen. Je beste dag was %@. Volgende week gaan we er weer vol tegenaan!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tydzie\u0144 by\u0142 nieco spokojniejszy. Tw\u00f3j czas skupienia spad\u0142 o %@. Twoim najlepszym dniem by\u0142 %@. W przysz\u0142ym tygodniu wracamy z pe\u0142n\u0105 moc\u0105!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana foi um pouco mais calma. Seu tempo de foco diminuiu %@. Seu melhor dia foi %@. Vamos com tudo na pr\u00f3xima semana!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043d\u0435\u0434\u0435\u043b\u044f \u043f\u0440\u043e\u0448\u043b\u0430 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0435\u0435. \u0412\u0430\u0448\u0435 \u0432\u0440\u0435\u043c\u044f \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u043e\u0432\u043a\u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u043b\u043e\u0441\u044c \u043d\u0430%@. \u0422\u0432\u043e\u0439 \u043b\u0443\u0447\u0448\u0438\u0439 \u0434\u0435\u043d\u044c \u0431\u044b\u043b%@. \u041d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u043c\u044b \u0441\u043d\u043e\u0432\u0430 \u0431\u0443\u0434\u0435\u043c \u0430\u0442\u0430\u043a\u043e\u0432\u0430\u0442\u044c!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta biraz daha sakindi. Odaklanma s\u00fcreniz %@ azald\u0131. En iyi g\u00fcn\u00fcn\u00fcz %@ oldu. Gelecek hafta tekrar tam g\u00fc\u00e7le devam edelim!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5468\u7a0d\u5fae\u5b89\u9759\u4e00\u4e9b\u3002\u60a8\u7684\u4e13\u6ce8\u65f6\u95f4\u51cf\u5c11\u4e86%@\u3002\u4f60\u6700\u597d\u7684\u4e00\u5929\u662f%@\u3002\u4e0b\u5468\u6211\u4eec\u5c06\u518d\u6b21\u51fa\u51fb\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u9031\u7a0d\u5fae\u5b89\u975c\u4e00\u9ede\u3002\u60a8\u7684\u5c08\u6ce8\u6642\u9593\u6e1b\u5c11\u4e86%@\u3002\u4f60\u6700\u597d\u7684\u4e00\u5929\u662f%@\u3002\u4e0b\u9031\u6211\u5011\u5c07\u518d\u6b21\u51fa\u64ca\uff01"
          }
        }
      }
    },
    "weekly_report.feedback.desc.neutral": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine solide, ausgeglichene Woche. Halte deine Gewohnheiten weiter so konstant!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A solid, balanced week. Keep your habits as consistent as they are!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana s\u00f3lida y equilibrada. \u00a1Sigue manteniendo tus h\u00e1bitos tan constantes!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine solide et \u00e9quilibr\u00e9e. Continuez \u00e0 maintenir vos habitudes constantes !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092e\u091c\u092c\u0942\u0924, \u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u0938\u092a\u094d\u0924\u093e\u0939\u0964 \u0905\u092a\u0928\u0940 \u0906\u0926\u0924\u094b\u0902 \u0915\u094b \u0906\u0917\u0947 \u092d\u0940 \u0910\u0938\u0947 \u0939\u0940 \u0938\u094d\u0925\u093f\u0930 \u092c\u0928\u093e\u090f \u0930\u0916\u094b!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana solida ed equilibrata. Mantieni le tue abitudini costanti!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5805\u5b9f\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u4e00\u9031\u9593\u3067\u3057\u305f\u3002\u3053\u306e\u8abf\u5b50\u3067\u7fd2\u6163\u3092\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacac\uace0\ud558\uace0 \uade0\ud615 \uc7a1\ud78c \ud55c \uc8fc\uc600\uc2b5\ub2c8\ub2e4. \uc9c0\uae08\ucc98\ub7fc \uc2b5\uad00\uc744 \uafb8\uc900\ud788 \uc720\uc9c0\ud558\uc138\uc694!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een solide, evenwichtige week. Houd je gewoontes net zo consistent!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Solidny, zr\u00f3wnowa\u017cony tydzie\u0144. Utrzymuj swoje nawyki na sta\u0142ym poziomie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semana s\u00f3lida e equilibrada. Mantenha seus h\u00e1bitos consistentes!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0432\u0435\u0440\u0434\u0430\u044f, \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u043d\u0435\u0434\u0435\u043b\u044f. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0439\u0442\u0435 \u0441\u0432\u043e\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa\u011flam, dengeli bir hafta. Al\u0131\u015fkanl\u0131klar\u0131n\u0131z\u0131 istikrarl\u0131 bir \u015fekilde s\u00fcrd\u00fcrmeye devam edin!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u624e\u5b9e\u3001\u5e73\u8861\u7684\u4e00\u5468\u3002\u4fdd\u6301\u4e60\u60ef\u4e00\u81f4\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d2e\u5be6\u3001\u5e73\u8861\u7684\u4e00\u9031\u3002\u4fdd\u6301\u7fd2\u6163\u4e00\u81f4\uff01"
          }
        }
      }
    },
    "weekly_report.feedback.desc.neutral_base": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst diese Woche sehr konstant und hast deine Zeiten solide gehalten. Konstanz ist der Schl\u00fcssel zum langfristigen Erfolg!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were very consistent this week and solidly maintained your times. Consistency is the key to long-term success!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuiste muy constante esta semana y mantuviste tus tiempos de forma s\u00f3lida. \u00a1La constancia es la clave del \u00e9xito a largo plazo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as \u00e9t\u00e9 tr\u00e8s r\u00e9gulier cette semaine et tu as bien maintenu tes horaires. La r\u00e9gularit\u00e9 est la cl\u00e9 du succ\u00e8s \u00e0 long terme !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u092e \u0907\u0938 \u0939\u092b\u093c\u094d\u0924\u0947 \u092c\u0939\u0941\u0924 \u0938\u094d\u0925\u093f\u0930 \u0930\u0939\u0947 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0938\u092e\u092f \u0915\u094b \u0920\u094b\u0938 \u092c\u0928\u093e\u090f \u0930\u0916\u093e\u0964 \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0938\u092b\u0932\u0924\u093e \u0915\u0940 \u0915\u0941\u0902\u091c\u0940 \u0939\u0948!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato molto costante questa settimana e hai mantenuto solidamente i tuoi orari. La costanza \u00e8 la chiave del successo a lungo termine!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u9031\u306f\u3068\u3066\u3082\u5b89\u5b9a\u3057\u3066\u3044\u3066\u3001\u6642\u9593\u3092\u3057\u3063\u304b\u308a\u7dad\u6301\u3057\u307e\u3057\u305f\u3002\u7d99\u7d9a\u6027\u304c\u9577\u671f\u7684\u306a\u6210\u529f\u306e\u9375\u3067\u3059\uff01"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubc88 \uc8fc \ub9e4\uc6b0 \uc77c\uad00\uc131 \uc788\uac8c \uc2dc\uac04\uc744 \uc798 \uc720\uc9c0\ud588\uc2b5\ub2c8\ub2e4. \uc77c\uad00\uc131\uc774 \uc7a5\uae30\uc801\uc778 \uc131\uacf5\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was deze week zeer consistent en hield je tijden goed bij. Consistentie is de sleutel tot succes op lange termijn!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By\u0142e\u015b bardzo konsekwentny w tym tygodniu i solidnie utrzymywa\u0142e\u015b swoje czasy. Konsekwencja to klucz do d\u0142ugoterminowego sukcesu!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voc\u00ea foi muito consistente esta semana e manteve seus tempos de forma s\u00f3lida. A consist\u00eancia \u00e9 a chave para o sucesso a longo prazo!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u0432\u044b \u0431\u044b\u043b\u0438 \u043e\u0447\u0435\u043d\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b \u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b. \u041f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u2013 \u043a\u043b\u044e\u0447 \u043a \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u043c\u0443 \u0443\u0441\u043f\u0435\u0445\u0443!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta \u00e7ok tutarl\u0131yd\u0131n ve s\u00fcrelerini sa\u011flam bir \u015fekilde korudun. Tutarl\u0131l\u0131k uzun vadeli ba\u015far\u0131n\u0131n anahtar\u0131d\u0131r!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5468\u4f60\u7684\u8868\u73b0\u975e\u5e38\u7a33\u5b9a\uff0c\u5e76\u4e14\u4fdd\u6301\u7a33\u5b9a\u7684\u72b6\u6001\u3002\u4e00\u81f4\u6027\u662f\u957f\u671f\u6210\u529f\u7684\u5173\u952e\uff01"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u9031\u4f60\u7684\u8868\u73fe\u975e\u5e38\u7a69\u5b9a\uff0c\u4e26\u4e14\u4fdd\u6301\u7a69\u5b9a\u7684\u72c0\u614b\u3002\u4e00\u81f4\u6027\u662f\u9577\u671f\u6210\u529f\u7684\u95dc\u9375\uff01"
          }
        }
      }
    },
    "weekly_report.feedback.desc.neutral_with_day": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst diese Woche sehr konstant. Deine Fokuszeit ist stabil geblieben. Dein bester Tag war %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You were very consistent this week. Your focus time remained stable. Your best day was %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuiste muy constante esta semana. Tu tiempo de enfoque se mantuvo estable. Tu mejor d\u00eda fue el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez \u00e9t\u00e9 tr\u00e8s constant cette semaine. Votre temps de focus est rest\u00e9 stable. Votre meilleur jour \u00e9tait le %@."
          }

            "value": "Чего вы хотите достичь на этой сессии?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seansta ne başarmak istiyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想在本次环节中实现什么目标？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您想在本次環節中實現什麼目標？"
          }
        }
      }
    },

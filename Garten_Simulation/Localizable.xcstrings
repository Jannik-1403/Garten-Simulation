            "value": "\u65e0\u610f\u4e49\u5730\u6eda\u52a8"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u610f\u7fa9\u5730\u6efe\u52d5"
          }
        }
      }
    },
    "trash.doomscrolling_handy.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht sich fr\u00f6hlich im Wind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spins happily in the wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira alegremente con el viento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne joyeusement dans le vent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0935\u093e \u092e\u0947\u0902 \u0916\u0941\u0936\u0940-\u0916\u0941\u0936\u0940 \u0918\u0942\u092e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spins happily in the wind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u98a8\u3092\u53d7\u3051\u3066\u697d\u3057\u304f\u56de\u8ee2\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc14\ub78c\uc5d0 \uc990\uac81\uac8c \ud68c\uc804\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait vrolijk in de wind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiruje rado\u015bnie na wietrze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira alegremente com o vento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0441\u0435\u043b\u043e \u043a\u0440\u0443\u0442\u0438\u0442\u0441\u044f \u043d\u0430 \u0432\u0435\u0442\u0440\u0443."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00fczgarda mutlu bir \u015fekilde d\u00f6ner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u98ce\u4e2d\u5feb\u4e50\u5730\u65cb\u8f6c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u98a8\u4e2d\u5feb\u6a02\u5730\u65cb\u8f49\u3002"
          }
        }
      }
    },

    "trash.energy_drink_kiste.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze es durch Wasser + Zitrone – stelle es schon abends bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace it with water + lemon – prepare it the evening before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustitúyelo por agua con limón: prepáralo ya por la noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace-le par de l'eau + citron – prépare-le dès la veille au soir."
          }

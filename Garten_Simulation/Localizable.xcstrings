    "leben.regel1": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gie\u00dfe deine Pflanzen t\u00e4glich um Leben zu behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants daily to keep your lives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Riega tus plantas diariamente para conservar tus vidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrose tes plantes quotidiennement pour garder tes vies"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0940\u0935\u0928 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092a\u094c\u0927\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0926\u093f\u0928 \u092a\u093e\u0928\u0940 \u0926\u0947\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Water your plants daily to keep your lives"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u547d\u3092\u5b88\u308b\u305f\u3081\u306b\u6bce\u65e5\u690d\u7269\u306b\u6c34\u3092\u3042\u3052\u307e\u3057\u3087\u3046"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uba85\uc744 \uc720\uc9c0\ud558\ub824\uba74 \ub9e4\uc77c \uc2dd\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef uw planten dagelijks water om uw leven te behouden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podlewaj ro\u015bliny codziennie, aby zachowa\u0107 \u017cycie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rega as tuas plantas diariamente para manter as vidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u0438\u0432\u0430\u0439 \u0441\u0432\u043e\u0438 \u0440\u0430\u0441\u0442\u0435\u043d\u0438\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0436\u0438\u0437\u043d\u044c"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya\u015fam\u0131n\u0131z\u0131 s\u00fcrd\u00fcrmek i\u00e7in bitkilerinizi g\u00fcnl\u00fck olarak sulay\u0131n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u7ed9\u4f60\u7684\u690d\u7269\u6d47\u6c34\u4ee5\u4fdd\u6301\u751f\u547d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u5929\u7d66\u690d\u7269\u6f86\u6c34\u4ee5\u4fdd\u6301\u751f\u547d"
          }
        }
      }
    },
    "leben.regel2": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stirbt eine Pflanze, verlierst du ein Leben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a plant dies, you lose one life"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si una planta muere, pierdes una vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une plante meurt, tu perds une vie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0926\u093f \u090f\u0915 \u092a\u094c\u0927\u093e \u092e\u0930 \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0906\u092a \u090f\u0915 \u091c\u0940\u0935\u0928 \u0916\u094b \u0926\u0947\u0924\u0947 \u0939\u0948\u0902"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "If a plant dies, you lose one life"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u690d\u7269\u304c\u67af\u308c\u308b\u3068\u547d\u304c\u4e00\u3064\u5931\u308f\u308c\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dd\ubb3c\uc774 \uc8fd\uc73c\uba74 \uc0dd\uba85 \ud558\ub098\ub97c \uc783\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een plant sterft, verlies je \u00e9\u00e9n leven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je\u015bli ro\u015blina obumrze, tracisz jedno \u017cycie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se uma planta morrer, perdes uma vida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

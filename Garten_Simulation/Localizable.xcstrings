    "item.duenger_blitz.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und verdoppelt deine n\u00e4chsten XP-Gewinne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and doubles your next XP gains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sofort aktiv und verdoppelt deine n\u00e4chsten XP-Gewinne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'active imm\u00e9diatement et double tes prochains gains XP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0941\u0930\u0902\u0924 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0947 \u0905\u0917\u0932\u0947 XP \u0932\u093e\u092d \u0915\u094b \u0926\u094b\u0917\u0941\u0928\u093e \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes active immediately and doubles your next XP gains."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3050\u306b\u6709\u52b9\u306b\u306a\u308a\u3001\u6b21\u56de\u7372\u5f97\u3067\u304d\u308b XP \u304c 2 \u500d\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc989\uc2dc \ud65c\uc131\ud654\ub418\uace0 \ub2e4\uc74c XP \ud68d\ub4dd\ub7c9\uc774 \ub450 \ubc30\ub85c \ub298\uc5b4\ub0a9\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt onmiddellijk actief en verdubbelt uw volgende XP-winst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staje si\u0119 aktywny natychmiast i podwaja Twoje kolejne zdobyte PD."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa imediatamente e duplica os teus pr\u00f3ximos ganhos de XP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043d\u0435\u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u0438 \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u043e\u043f\u044b\u0442\u0430."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif hale gelir ve bir sonraki XP kazanc\u0131n\u0131z\u0131 ikiye katlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u751f\u6548\uff0c\u4f7f\u4f60\u63a5\u4e0b\u6765\u7684\u7ecf\u9a8c\u503c\u6536\u76ca\u7ffb\u500d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7acb\u5373\u63a1\u53d6\u884c\u52d5\uff0c\u8b93\u60a8\u7684\u4e0b\u4e00\u6b21 XP \u6536\u76ca\u52a0\u500d\u3002"
          }
        }
      }
    },

        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0902\u0924\u0930\u093f\u0915 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0947\u0902 \u0916\u093f\u0932\u0924\u093e \u0939\u0948 \u2013 \u0928\u094b\u092b\u0948\u092a"

    "assessment.finance.profile.prokrastinator.build": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kennst die Theorie, aber setzt sie nicht um. Automatisiere deine Sparraten und Investments, damit du nicht jedes Mal aktiv entscheiden musst."
          }
        },

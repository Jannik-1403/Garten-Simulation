    "pfad_fehlt_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage an deinem Ziel gearbeitet. Bleib dran!"

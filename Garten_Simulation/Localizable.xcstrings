    "screenTime.strictMode.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt den App Store (um VPN-Downloads zu verhindern), das Löschen von Apps und Account-Änderungen. Gilt dauerhaft, bis der Notfall-Unlock genutzt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks the App Store (to prevent VPN downloads), app deletion, and account changes. Remains active until emergency unlock is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la App Store (para evitar descargas de VPN), la eliminación de aplicaciones y los cambios de cuenta. Permanece activo hasta que se use el desbloqueo de emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille l'App Store (pour empêcher le téléchargement de VPN), la suppression d'applications et les modifications de compte. Reste actif jusqu'au déverrouillage d'urgence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप स्टोर को ब्लॉक करता है (वीपीएन डाउनलोड को रोकने के लिए), ऐप डिलीट और अकाउंट में बदलाव करता है। आपातकालीन अनलॉक का उपयोग होने तक स्थायी रूप से मान्य।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca l'App Store (per impedire i download di VPN), l'eliminazione di app e le modifiche all'account. Rimane attivo fino allo sblocco di emergenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store (VPN ダウンロードを防ぐため)、アプリの削除、アカウントの変更をブロックします。緊急ロック解除が使用されるまで永久に有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store(VPN 다운로드 방지), 앱 삭제 및 계정 변경을 차단합니다. 비상 잠금 해제를 사용할 때까지 영구적으로 유효합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeert de App Store (om VPN-downloads), app-verwijdering en accountwijzigingen te voorkomen. Permanent geldig totdat de noodontgrendeling wordt gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje App Store (aby zapobiec pobieraniu VPN), usuwaniu aplikacji i zmianom konta. Obowiązuje stale do momentu użycia odblokowania awaryjnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia a App Store (para evitar downloads de VPN), exclusão de aplicativos e alterações de conta. Válido permanentemente até que o desbloqueio de emergência seja utilizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia a App Store (para evitar downloads de VPN), exclusão de aplicativos e alterações de conta. Válido permanentemente até que o desbloqueio de emergência seja utilizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует App Store (чтобы предотвратить загрузку VPN), удаление приложений и изменение учетной записи. Действует постоянно, пока не будет использована аварийная разблокировка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store'u (VPN indirmelerini önlemek için), uygulamaların silinmesini ve hesap değişikliklerini engeller. Acil kilit açma kullanılıncaya kadar kalıcı olarak geçerlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止 App Store（以防止 VPN 下载）、应用程序删除和帐户更改。永久有效，直到使用紧急解锁为止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止 App Store（以防止 VPN 下載）、應用程式刪除和帳戶變更。永久有效，直到使用緊急解鎖為止。"
          }
        }
      }
    },

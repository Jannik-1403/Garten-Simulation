    "screenTime.safariFilter.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert nicht jugendfreie Inhalte und Malware systemweit in allen Browsern (Chrome, Edge, Safari etc.) über Cloudflare Family DNS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks adult content and malware system-wide across all browsers (Chrome, Edge, Safari, etc.) via Cloudflare Family DNS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea contenido para adultos y malware en todo el sistema y en todos los navegadores a través de Cloudflare Family DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque le contenu pour adultes et les malwares à l'échelle du système sur tous les navigateurs via Cloudflare Family DNS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउडफ्लेयर फैमिली डीएनएस के माध्यम से सभी ब्राउज़रों में वयस्क सामग्री को ब्लॉक करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca contenuti per adulti e malware a livello di sistema su tutti i browser tramite Cloudflare Family DNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family DNSを使用して、すべてのブラウザでアダルトコンテンツとマルウェアをシステム全体でブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family DNS를 통해 모든 브라우저에서 성인 콘텐츠 및 맬웨어를 시스템 전체에서 차단합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeert inhoud voor volwassenen en malware systeembreed in alle browsers via Cloudflare Family DNS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuje treści dla dorosłych i złośliwe oprogramowanie ogólnosystemowo we wszystkich przeglądarkach przez Cloudflare Family DNS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia conteúdo adulto e malware em todo o sistema, em todos os navegadores, através do Cloudflare Family DNS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia conteúdo adulto e malware em todo o sistema, em todos os navegadores, através do Cloudflare Family DNS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует контент для взрослых и вредоносное ПО во всех браузерах с помощью Cloudflare Family DNS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Family DNS ile tüm tarayıcılarda sistem genelinde yetişkinlere yönelik içeriği ve kötü amaçlı yazılımları engeller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Cloudflare Family DNS 在所有浏览器中全系统拦截成人内容和恶意软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Cloudflare Family DNS 在所有瀏覽器中全系統攔截成人內容和惡意軟體。"
          }
        }
      }
    },

    "pfad_mental_day_7_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast 7 Tage lang bewusst geatmet. Sp\u00fcrst du die Ruhe?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have breathed consciously for 7 days. Do you feel the peace?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has respirado conscientemente durante 7 d\u00edas. \u00bfSientes la paz?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as respir\u00e9 consciemment pendant 7 jours. Sens-tu le calme ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0928\u0947 7 \u0926\u093f\u0928\u094b\u0902 \u0924\u0915 \u0939\u094b\u0936\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u093e\u0902\u0938 \u0932\u0940\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u0936\u093e\u0902\u0924\u093f \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai respirato consapevolmente per 7 giorni. Senti la pace?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3042\u306a\u305f\u306f 7 \u65e5\u9593\u610f\u8b58\u7684\u306b\u547c\u5438\u3057\u307e\u3057\u305f\u3002\u5e73\u548c\u3092\u611f\u3058\u3066\u3044\u307e\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2f9\uc2e0\uc740 7\uc77c \ub3d9\uc548 \uc758\uc2dd\uc801\uc73c\ub85c \ud638\ud761\ud588\uc2b5\ub2c8\ub2e4. \ud3c9\ud654\ub97c \ub290\ub07c\uc2dc\ub098\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt 7 dagen bewust ademgehaald. Voel jij de vrede?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddychasz \u015bwiadomie przez 7 dni. Czy czujesz spok\u00f3j?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiraste conscientemente durante 7 dias. Sentes a paz?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u044b \u0434\u044b\u0448\u0430\u043b \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 7 \u0434\u043d\u0435\u0439. \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u043b\u0438 \u0442\u044b \u043f\u043e\u043a\u043e\u0439?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 g\u00fcn boyunca bilin\u00e7li nefes ald\u0131n\u0131z. Huzuru hissediyor musun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u523b\u610f\u547c\u5438\u4e867\u5929\u3002\u4f60\u611f\u53d7\u5230\u5e73\u9759\u4e86\u5417\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u6709\u610f\u8b58\u5730\u547c\u5438\u4e86 7 \u5929\u3002\u4f60\u611f\u53d7\u5230\u5e73\u975c\u4e86\u55ce\uff1f"
          }
        }
      }
    },

    "stats.score.msg.low": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach weiter so! Dein Garten wird bald wachsen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it up! Your garden will grow soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Sigue as\u00ed! Tu jard\u00edn crecer\u00e1 pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue comme \u00e7a ! Ton jardin va bient\u00f4t pousser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0910\u0938\u0947 \u0939\u0940 \u091c\u093e\u0930\u0940 \u0930\u0916\u094b! \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u092c\u0917\u0940\u091a\u093e \u091c\u0932\u094d\u0926\u0940 \u0939\u0940 \u092c\u0922\u093c \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua cos\u00ec! Il tuo giardino crescer\u00e0 presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u308c\u3092\u7dad\u6301\u3059\u308b\uff01\u3042\u306a\u305f\u306e\u5ead\u306f\u3059\u3050\u306b\u6210\u9577\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacc4\uc18d\ud558\uc138\uc694! \ub2f9\uc2e0\uc758 \uc815\uc6d0\uc740 \uace7 \uc790\ub784 \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga zo door! Uw tuin zal snel groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak trzymaj! Tw\u00f3j ogr\u00f3d wkr\u00f3tce si\u0119 rozro\u015bnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua assim! O teu jardim crescer\u00e1 em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0432 \u0442\u043e\u043c \u0436\u0435 \u0434\u0443\u0445\u0435! \u0422\u0432\u043e\u0439 \u0441\u0430\u0434 \u0441\u043a\u043e\u0440\u043e \u0432\u044b\u0440\u0430\u0441\u0442\u0435\u0442."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynen b\u00f6yle devam! Bah\u00e7eniz yak\u0131nda b\u00fcy\u00fcyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ee7\u7eed\u52aa\u529b\u5427\uff01\u4f60\u7684\u82b1\u56ed\u5f88\u5feb\u5c31\u4f1a\u957f\u5927\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7e7c\u7e8c\u52aa\u529b\uff01\u4f60\u7684\u82b1\u5712\u5f88\u5feb\u5c31\u6703\u9577\u5927\u3002"
          }
        }
      }
    },
    "stats.score.msg.ok": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guter Anfang! Mach weiter so, um mehr zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good start! Keep going to achieve more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Buen comienzo! Sigue as\u00ed para lograr m\u00e1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon d\u00e9but ! Continue comme \u00e7a pour en faire plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u091a\u094d\u091b\u0940 \u0936\u0941\u0930\u0941\u0906\u0924! \u0914\u0930 \u0905\u0927\u093f\u0915 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0940 \u0924\u0930\u0939 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902\u0964"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buon inizio! Continua cos\u00ec per ottenere di pi\u00f9."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u826f\u3044\u30b9\u30bf\u30fc\u30c8\u3067\u3059\uff01\u3055\u3089\u306b\u591a\u304f\u306e\u3053\u3068\u3092\u9054\u6210\u3057\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc88b\uc740 \uc2dc\uc791\uc785\ub2c8\ub2e4! \ub354 \ub9ce\uc740 \uac83\uc744 \uc131\ucde8\ud558\uae30 \uc704\ud574 \uacc4\uc18d \ub178\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed begin! Blijf doorgaan om meer te bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobry pocz\u0105tek! Kontynuuj, aby osi\u0105gn\u0105\u0107 wi\u0119cej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bom come\u00e7o! Continua assim para alcan\u00e7ar mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0425\u043e\u0440\u043e\u0448\u0435\u0435 \u043d\u0430\u0447\u0430\u043b\u043e! \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0432 \u0442\u043e\u043c \u0436\u0435 \u0434\u0443\u0445\u0435, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0438\u0447\u044c \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130yi ba\u015flang\u0131\u00e7! Daha fazlas\u0131n\u0131 ba\u015farmak i\u00e7in yola devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u597d\u7684\u5f00\u59cb\uff01\u7ee7\u7eed\u524d\u8fdb\uff0c\u53d6\u5f97\u66f4\u591a\u6210\u5c31\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u597d\u7684\u958b\u59cb\uff01\u7e7c\u7e8c\u524d\u9032\uff0c\u53d6\u5f97\u66f4\u591a\u6210\u5c31\u3002"
          }
        }
      }
    },

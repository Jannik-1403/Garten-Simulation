        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7a0\uc2dc \ub0ae\uc7a0\uc744 \uc790\uae30\uc5d0 \ub531 \ub9de\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideaal voor een dutje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idealny na ma\u0142\u0105 drzemk\u0119."

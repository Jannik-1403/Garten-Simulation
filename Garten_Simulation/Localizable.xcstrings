    "prog_saving_d7_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blicke auf die Woche zurück. Wo hast du sinnlos Geld verbrannt? Wo warst du diszipliniert?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look back on the week. Where did you burn money senselessly? Where were you disciplined?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire hacia atrás en la semana. ¿Dónde quemaste dinero sin sentido? ¿Dónde fuiste disciplinado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour sur la semaine. Où avez-vous brûlé de l’argent sans raison ? Où avez-vous été discipliné ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह पर नज़र डालें। तुमने बेमतलब पैसा कहाँ जला दिया? आप कहाँ अनुशासित थे?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda indietro alla settimana. Dove hai bruciato soldi insensatamente? Dove sei stato disciplinato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一週間を振り返ってください。どこで無意味にお金を燃やしたのですか？どこで躾けられたんですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 주를 되돌아보세요. 무의미하게 돈을 태운 곳은 어디입니까? 어디서 징계를 받았나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk terug op de week. Waar heb je zinloos geld verbrand? Waar was je gedisciplineerd?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spójrz wstecz na tydzień. Gdzie bezsensownie spaliłeś pieniądze? Gdzie byłeś zdyscyplinowany?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja a semana. Onde você queimou dinheiro sem sentido? Onde você foi disciplinado?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja a semana. Onde você queimou dinheiro sem sentido? Onde você foi disciplinado?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оглянитесь на неделю. Где вы бессмысленно сжигали деньги? Где вас дисциплинировали?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftaya dönüp bakın. Anlamsızca parayı nereye yaktın? Nerede disiplin cezası aldınız?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回顾这一周。哪里无谓地烧钱了？你在哪里受到纪律处分？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回顧這一周。哪裡無謂地燒錢了？你在哪裡受到紀律處分？"
          }
        }
      }
    },

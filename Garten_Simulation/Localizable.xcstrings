    "prog_cooking_d2_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass alle fertigen Saucen (Ketchup, BBQ, Fertigdressing) weg. Mach dein Dressing selbst aus Olivenöl und Essig/Zitrone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave out all ready-made sauces (ketchup, BBQ, ready-made dressing). Make your own dressing from olive oil and vinegar/lemon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omita todas las salsas preparadas (ketchup, BBQ, aderezo preparado). Haz tu propio aderezo con aceite de oliva y vinagre/limón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oubliez toutes les sauces toutes prêtes (ketchup, BBQ, vinaigrette toute prête). Préparez votre propre vinaigrette à partir d'huile d'olive et de vinaigre/citron."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी तैयार सॉस (केचप, बीबीक्यू, तैयार ड्रेसिंग) को छोड़ दें। जैतून के तेल और सिरके/नींबू से अपनी खुद की ड्रेसिंग बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludere tutte le salse già pronte (ketchup, barbecue, condimenti già pronti). Prepara il tuo condimento con olio d'oliva e aceto/limone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既製のソース（ケチャップ、バーベキュー、既製のドレッシング）はすべて残します。オリーブオイルと酢/レモンから独自のドレッシングを作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 만들어진 소스(케첩, 바비큐, 이미 만들어진 드레싱)는 모두 빼세요. 올리브 오일과 식초/레몬으로 드레싱을 직접 만들어보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat alle kant-en-klare sauzen (ketchup, BBQ, kant-en-klare dressing) achterwege. Maak je eigen dressing van olijfolie en azijn/citroen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiń wszystkie gotowe sosy (ketchup, BBQ, gotowy dressing). Zrób własny dressing z oliwy z oliwek i octu/cytryny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe de fora todos os molhos prontos (ketchup, churrasco, molho pronto). Faça seu próprio molho com azeite e vinagre/limão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe de fora todos os molhos prontos (ketchup, churrasco, molho pronto). Faça seu próprio molho com azeite e vinagre/limão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откажитесь от всех готовых соусов (кетчуп, барбекю, готовая заправка). Сделайте свою собственную заправку из оливкового масла и уксуса/лимона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hazır sosları (ketçap, barbekü, hazır sos) dışarıda bırakın. Zeytinyağı ve sirke/limondan kendi sosunuzu hazırlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下所有现成的酱汁（番茄酱、烧烤酱、现成的调料）。用橄榄油和醋/柠檬制作自己的调味品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留下所有現成的醬汁（番茄醬、燒烤醬、現成的調味料）。用橄欖油和醋/檸檬製作自己的調味品。"
          }
        }
      }
    },

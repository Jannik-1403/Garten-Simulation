    "item.gartenschutz.usage": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort aktiv: Dekorationen und Belohnungen spawnen keine neuen Unkräuter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active immediately: decorations and rewards won't spawn new weeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo al instante: sin malas hierbas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif immédiatement : pas de nouvelles mauvaises herbes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo subito: niente nuove erbacce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにアクティブになります: 装飾や報酬によって新しい雑草が発生することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 활성화: 장식과 보상으로 인해 새로운 잡초가 생성되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct actief: decoraties en beloningen zullen geen nieuw onkruid voortbrengen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne natychmiast: dekoracje i nagrody nie powodują powstawania nowych chwastów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo já: sem novas ervas daninhas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen aktif olun: Dekorasyonlar ve ödüller yeni yabani otların ortaya çıkmasına neden olmaz."
          }
        }
      }
    },

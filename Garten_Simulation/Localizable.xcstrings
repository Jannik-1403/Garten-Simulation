    "trash.schlaf_killer_koffein.obj_desc": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viel Platz f\u00fcr alle deine Werkzeuge."

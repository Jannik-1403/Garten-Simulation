        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이템으로 인해 잡초가 자라 XP와 진행을 방해할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items kunnen ervoor zorgen dat onkruid groeit, waardoor XP en voortgang worden belemmerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedmioty mogą powodować wzrost chwastów, utrudniając zdobywanie punktów doświadczenia i postęp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens podem causar ervas daninhas, dificultando o XP."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler yabani otların büyümesine neden olarak XP'yi ve ilerlemeyi engelleyebilir."
          }
        }
      }
    },
